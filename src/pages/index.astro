---
/**
 * 홈 — 카테고리 트리와 앱 카드는 빌드 때 apps.json으로 정적 출력한다(검색엔진 노출·첫 화면 속도·스크립트 차단 환경).
 * 기기별로 달라지는 부분(최근 방문, 최근 방문 강조, 공지)과 검색 필터·모달만 아래 인라인 스크립트가 덧붙인다.
 * 정적 마크업을 다시 그리지 않고 그대로 두고 보강(hydrate)만 한다.
 */
import appsData from '../../public/apps.json';
import Icon from '../components/Icon.astro';

const SITE_TITLE = 'eduin VIVES — 교육 미니앱 모음';
const SITE_DESC = '교육 현장에서 바로 쓸 수 있는 미니 웹 앱 모음. 채점표, AI 검색, 플래시카드, QR, 타이머, 마크다운 에디터 등 다양한 도구를 무료로 사용하세요.';

// 카테고리 이름 앞 이모지는 화면에서 떼고, 같은 자리에 lucide 아이콘을 빌드 때 그린다(apps.json에 lucideIcon이 있으면 그것을 우선)
// @icons book-open globe book-open-text briefcase wrench puzzle message-circle palette ruler folder
const CAT_ICONS = {
  edu: 'book-open', 'edu-sim': 'globe', 'edu-learn': 'book-open-text', 'edu-work': 'briefcase',
  utility: 'wrench', 'util-life': 'wrench', 'util-chrome': 'puzzle', 'util-social': 'message-circle',
  'util-creative': 'palette', 'util-notion': 'ruler',
};
const stripEmoji = (s) => String(s || '').replace(/^[\u{1F000}-\u{1FFFF}\u{2600}-\u{27FF}\u{2B00}-\u{2BFF}\u{FE00}-\u{FE0F}‍\s]+/u, '').trim();
const catIcon = (c) => c.lucideIcon || CAT_ICONS[c.id] || 'folder';

const categories = (appsData.categories || []).map((c) => ({
  ...c,
  label: stripEmoji(c.label),
  icon: catIcon(c),
  subcategories: c.subcategories && c.subcategories.map((s) => ({ ...s, label: stripEmoji(s.label), icon: catIcon(s) })),
}));
// hidden: 비공개 앱 — 페이지 폴더가 src/pages/apps/_<id>/라 빌드되지 않음(주소로도 404)
const apps = (appsData.apps || []).filter((a) => !a.hidden);

const isModalApp = (a) => a.type === 'modal';
const isExternalApp = (a) => !isModalApp(a) && (a.type === 'link' || !!a.external);

/* 섹션 블록 — 예전 런타임 렌더러(render())와 같은 순서·구조
   header: 서브카테고리가 있는 카테고리의 머리말만 / sub: 서브카테고리 / extra: 서브카테고리 미배정 / flat: 서브카테고리 없는 카테고리 */
const blocks = [];
for (const cat of categories) {
  const items = apps.filter((a) => a.category === cat.id);
  if (items.length === 0) continue;
  const subcats = cat.subcategories;
  if (subcats) {
    blocks.push({ type: 'header', id: cat.id, cat: cat.id, label: cat.label, icon: cat.icon, desc: cat.desc, items: [] });
    const subIds = new Set(subcats.map((sc) => sc.id));
    for (const sc of subcats) {
      const scItems = items.filter((a) => a.subcategory === sc.id);
      if (scItems.length) blocks.push({ type: 'sub', id: sc.id, cat: cat.id, label: sc.label, icon: sc.icon, items: scItems });
    }
    const unassigned = items.filter((a) => !a.subcategory || !subIds.has(a.subcategory));
    if (unassigned.length) blocks.push({ type: 'extra', id: null, cat: cat.id, items: unassigned });
  } else {
    blocks.push({ type: 'flat', id: cat.id, cat: cat.id, label: cat.label, icon: cat.icon, desc: cat.desc, items });
  }
}
const sectionIds = new Set(blocks.filter((b) => b.id).map((b) => b.id));
const navCategories = categories
  .filter((cat) => sectionIds.has(cat.id))
  .map((cat) => ({ ...cat, subs: (cat.subcategories || []).filter((sc) => sectionIds.has(sc.id)) }));
// 모바일 가로 칩: 실제 카드가 있는 서브카테고리(또는 서브카테고리 없는 카테고리)
const chipBlocks = blocks.filter((b) => b.type === 'sub' || b.type === 'flat');

/* 스크립트용 데이터 — 검색 색인(제목·설명·키워드·카테고리 이름), 최근 방문 저장, 모달 내용 */
const catLabel = new Map();
const subLabel = new Map();
for (const c of categories) {
  catLabel.set(c.id, c.label);
  for (const s of c.subcategories || []) subLabel.set(s.id, s.label);
}
const clientApps = apps.map((a) => {
  const seo = a.seo || {};
  const o = {
    id: a.id,
    href: a.href,
    title: a.title,
    desc: a.desc,
    emoji: a.emoji,
    category: a.category,
    subcategory: a.subcategory,
    lucideIcon: a.lucideIcon,
    s: [a.title, a.desc, a.badge, seo.title, ...(seo.keywords || []), catLabel.get(a.category), subLabel.get(a.subcategory)]
      .filter(Boolean)
      .join(' ')
      .replace(/eduin vives/gi, ' ')
      .toLowerCase(),
  };
  if (isModalApp(a)) {
    o.modal = { badge: a.badge, modalDesc: a.modalDesc, features: a.features || [], linkLabel: a.linkLabel, external: !!a.external };
  }
  return o;
});
// </script> 등이 JSON 안에서 스크립트를 끊지 않도록 '<'를 이스케이프
const homeJson = JSON.stringify({ apps: clientApps }).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{SITE_TITLE}</title>
  <meta name="description" content={SITE_DESC} />
  <meta property="og:title" content={SITE_TITLE} />
  <meta property="og:description" content={SITE_DESC} />
  <meta property="og:image" content="https://eduin.info/og-default.png" />
  <meta property="og:url" content="https://eduin.info/" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="eduin VIVES" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={SITE_TITLE} />
  <meta name="twitter:description" content={SITE_DESC} />
  <meta name="twitter:image" content="https://eduin.info/og-default.png" />
  <link rel="canonical" href="https://eduin.info/" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="stylesheet" href="/common/hero-theme.css" />
  <script is:inline src="/common/ui.js"></script>
  <script is:inline src="/common/theme.js"></script>
  <script is:inline src="/common/init.js"></script>
  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "eduin VIVES",
    "alternateName": "바이에듀인 바이브스",
    "url": "https://eduin.info",
    "description": "교육 현장에서 바로 쓸 수 있는 미니 웹 앱 모음",
    "publisher": {
      "@type": "Organization",
      "name": "eduin",
      "url": "https://eduin.info"
    }
  }
  </script>
  <style is:global>
    body {
      min-height: 100vh;
      min-height: 100dvh;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(124,106,247,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(124,106,247,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 0;
    }

    /* 화면에는 숨기고 보조기기에는 읽히게 (hero-theme.css에도 같은 유틸리티가 있을 수 있음 — 정의 동일) */
    .visually-hidden {
      position: absolute !important;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }

    /* hidden 속성이 .app-card{display:block} 같은 규칙에 덮이지 않도록 */
    #main [hidden] { display: none !important; }

    @media (prefers-reduced-motion: no-preference) {
      html { scroll-behavior: smooth; }
    }

    .site-header, main { position: relative; z-index: 1; }
    /* 헤더 안의 우상단 버튼(좁은 화면에서 fixed)이 스크롤한 본문 카드 위에 오도록 */
    .site-header { z-index: 2; }

    .site-header {
      padding: 2rem 1.5rem 1rem;
      max-width: 1280px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem 0.75rem;
    }

    .site-brand { flex: 0 0 auto; }

    .logo-group {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .logo-group img {
      width: 32px;
      height: 32px;
    }

    .logo-title {
      margin: 0;
      font-size: 1.4rem;
      font-weight: 700;
      letter-spacing: -0.03em;
    }

    .logo-title span {
      color: var(--primary);
    }

    .logo-sub {
      font-size: 0.8rem;
      color: var(--fg-muted);
      margin-top: 1px;
    }

    main {
      padding: 0 1.5rem 5rem;
      max-width: 1280px;
      margin: 0 auto;
    }

    /* ── 키보드 포커스 표시 ── */
    #main a:focus-visible,
    #main button:focus-visible,
    .modal-box a:focus-visible,
    .modal-box button:focus-visible {
      outline: 3px solid var(--primary);
      outline-offset: 2px;
    }
    .modal-box:focus { outline: none; }

    /* ── 검색(헤더 오른쪽, 좁은 화면은 로고 아래 전체 폭) + (모바일) 카테고리 칩 ── */
    .app-search {
      position: relative;
      flex: 1 1 260px; /* 줄바꿈은 260px 기준으로 판단하고, 남는 폭은 420px까지 채움 */
      max-width: 420px;
      margin: 0 0 0 auto;
    }

    @media (min-width: 768px) {
      .site-header > .top-overlay { position: static; flex: 0 0 auto; }
    }

    @media (max-width: 767.98px) {
      .site-header { padding-bottom: 0.75rem; }
      .app-search { flex: 1 1 100%; max-width: none; }
    }

    .app-search-icon {
      position: absolute;
      left: 0.9rem;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      color: var(--fg-muted);
      pointer-events: none;
    }

    .app-search input {
      width: 100%;
      min-height: 48px;
      padding: 0.7rem 2.75rem 0.7rem 2.6rem;
      border: 1px solid var(--border);
      border-radius: 0.875rem;
      background: var(--input-bg, var(--card-bg));
      color: var(--fg);
      font: inherit;
      font-size: 1rem; /* 16px 미만이면 iOS가 확대함 */
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .app-search input::placeholder { color: var(--fg-muted); }
    .app-search input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(0, 111, 238, 0.25);
    }

    .app-search-kbd {
      position: absolute;
      right: 0.75rem;
      top: 50%;
      transform: translateY(-50%);
      font: 600 0.75rem/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      color: var(--fg-muted);
      border: 1px solid var(--border);
      border-radius: 0.35rem;
      padding: 0.25rem 0.45rem;
      background: var(--bg);
      pointer-events: none;
    }
    .app-search input:focus ~ .app-search-kbd,
    .app-search input:not(:placeholder-shown) ~ .app-search-kbd { display: none; }
    @media (hover: none) {
      .app-search-kbd { display: none; }
    }

    .cat-chips { display: none; }

    .cat-chip {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 1rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--card-bg);
      color: var(--fg);
      font-size: 0.875rem;
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;
      transition: border-color 0.15s, color 0.15s, background 0.15s;
    }
    .cat-chip:hover { border-color: rgba(0, 111, 238, 0.4); }
    .cat-chip.is-active {
      border-color: var(--primary);
      color: var(--primary);
      background: rgba(0, 111, 238, 0.08);
    }

    /* 검색 결과 없음 */
    .search-empty {
      text-align: center;
      padding: 3rem 1rem;
      border: 1px dashed var(--border);
      border-radius: 1rem;
      color: var(--fg-muted);
    }
    .search-empty-title {
      margin: 0 0 0.4rem;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--fg);
    }
    .search-empty-desc { margin: 0 0 1rem; font-size: 0.875rem; }
    .search-empty-btn {
      min-height: 44px;
      padding: 0 1.25rem;
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      background: var(--card-bg);
      color: var(--fg);
      font: inherit;
      font-size: 0.875rem;
      font-weight: 600;
      cursor: pointer;
    }
    .search-empty-btn:hover { border-color: var(--primary); color: var(--primary); }

    /* 검색 중에는 최근 방문·공지를 접어 결과를 위로 */
    body.is-searching .recent-section,
    body.is-searching .notices-section { display: none !important; }

    /* ── 트리 네비 레이아웃 ── */
    .page-layout {
      display: flex;
      gap: 2rem;
      align-items: flex-start;
    }

    /* 사이드바 */
    .tree-sidebar {
      width: 220px;
      flex-shrink: 0;
      position: sticky;
      top: 1.5rem;
    }

    .sidebar-label {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--fg-muted);
      margin-bottom: 0.5rem;
      padding: 0 0.5rem;
    }

    .tree-nav {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .tree-node > .tree-item {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      width: 100%;
      padding: 0.45rem 0.5rem;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      background: none;
      border: none;
      color: var(--fg);
      text-align: left;
      transition: background 0.15s, color 0.15s;
      text-decoration: none;
    }
    .tree-node > .tree-item:hover {
      background: rgba(124,106,247,0.08);
    }
    .tree-node > .tree-item.is-active {
      background: rgba(0,111,238,0.1);
      color: var(--primary);
    }

    .tree-chevron {
      font-size: 0.6rem;
      margin-left: auto;
      transition: transform 0.2s;
      color: var(--fg-muted);
      flex-shrink: 0;
    }
    .tree-node.is-open > .tree-item .tree-chevron { transform: rotate(90deg); }

    /* 서브트리 — 접혔을 때는 visibility로 Tab 이동에서도 빠지게 */
    .subtree {
      list-style: none;
      padding: 0 0 0 1rem;
      margin: 0;
      overflow: hidden;
      max-height: 0;
      visibility: hidden;
      transition: max-height 0.25s ease, visibility 0s linear 0.25s;
    }
    .tree-node.is-open > .subtree {
      max-height: 20rem;
      visibility: visible;
      transition: max-height 0.25s ease;
    }

    .subtree-item {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      width: 100%;
      padding: 0.35rem 0.5rem;
      border-radius: 0.4rem;
      font-size: 0.8rem;
      font-weight: 500;
      cursor: pointer;
      background: none;
      border: none;
      color: var(--fg-muted);
      text-align: left;
      transition: background 0.15s, color 0.15s;
      text-decoration: none;
    }
    .subtree-item:hover { background: rgba(124,106,247,0.06); color: var(--fg); }
    .subtree-item.is-active { color: var(--primary); font-weight: 600; }

    /* 터치 기기(사이드바가 보이는 넓은 태블릿)에서는 누르기 영역 44px */
    @media (pointer: coarse) {
      .tree-node > .tree-item,
      .subtree-item { min-height: 44px; }
    }

    /* 콘텐츠 영역 */
    .content-area {
      flex: 1;
      min-width: 0;
    }

    /* 넓은 화면: 4열 그리드 */
    @media (min-width: 1024px) {
      .content-area .card-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    /* 태블릿·모바일: 사이드바 대신 검색창 아래 가로 칩 */
    @media (max-width: 860px) {
      .page-layout { flex-direction: column; gap: 0.5rem; }
      .tree-sidebar { display: none; }
      .cat-chips {
        display: flex;
        gap: 0.5rem;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scrollbar-width: none;
        margin: 0 -1.5rem;
        padding: 0 1.5rem 0.25rem;
        scroll-padding: 0 1.5rem;
        -webkit-overflow-scrolling: touch;
        margin-bottom: 1rem;
      }
      .cat-chips::-webkit-scrollbar { display: none; }
      /* 오른쪽에 칩이 더 있으면 끝을 흐리게 — 넘겨 볼 수 있다는 신호 */
      .cat-chips.has-more {
        -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent);
        mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent);
      }
    }
    .cat-chip .ic, .tree-item .ic, .subtree-item .ic { flex-shrink: 0; margin-right: 0.35rem; }
    .tree-chevron .ic, .notice-chevron .ic { width: 14px; height: 14px; margin: 0; display: block; }
    .notices-more, .notice-go { gap: 0.25rem; }
    .notices-toggle > .ic { flex-shrink: 0; color: var(--fg-muted); }
    .external-badge .ic { width: 14px; height: 14px; display: block; }
    .category-label .ic { margin-right: 0.35rem; vertical-align: -0.12em; color: var(--fg-muted); }

    /* 카테고리 섹션 */
    .category-section {
      margin-bottom: 2.5rem;
      scroll-margin-top: 3.5rem; /* 우상단 떠 있는 버튼에 머리말이 가리지 않게 */
    }

    .category-header {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border);
    }

    .category-label {
      margin: 0;
      font-size: 1rem;
      font-weight: 700;
    }

    .category-desc {
      font-size: 0.8rem;
      color: var(--fg-muted);
    }

    /* 카드 그리드 */
    .card-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.875rem;
    }

    @media (max-width: 640px) {
      .card-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 400px) {
      .card-grid {
        grid-template-columns: 1fr;
      }
    }

    /* 앱 카드 */
    .app-card {
      display: block;
      text-decoration: none;
      color: inherit;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 1rem;
      padding: 1.25rem;
      transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
      position: relative;
    }

    .app-card:hover {
      border-color: rgba(0, 111, 238, 0.4);
      transform: translateY(-2px);
      box-shadow: 0 8px 32px rgba(0, 111, 238, 0.1);
    }

    .card-emoji {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 12px;
      margin-bottom: 0.75rem;
      transition: all 0.2s ease;
      font-size: 1.25rem;
    }
    .card-emoji svg {
      width: 22px;
      height: 22px;
      stroke-width: 2.2;
    }
    .card-emoji i { font-style: normal; }

    /* 카테고리별 소프트 컬러 배경 블롭 */
    .card-emoji.sub-edu-sim { background: rgba(0, 111, 238, 0.08); color: #006fee; }
    .card-emoji.sub-edu-learn { background: rgba(23, 201, 100, 0.08); color: #17c964; }
    .card-emoji.sub-edu-work { background: rgba(120, 40, 200, 0.08); color: #7828c8; }
    .card-emoji.sub-util-life { background: rgba(245, 165, 36, 0.08); color: #f5a524; }
    .card-emoji.sub-util-chrome { background: rgba(243, 18, 96, 0.08); color: #f31260; }
    .card-emoji.sub-util-social { background: rgba(255, 78, 120, 0.08); color: #ff4e78; }
    .card-emoji.sub-util-creative { background: rgba(0, 183, 222, 0.08); color: #00b7de; }
    .card-emoji.sub-util-notion { background: rgba(100, 116, 139, 0.08); color: #64748b; }
    .card-emoji.sub-default { background: rgba(127, 140, 141, 0.08); color: #7f8c8d; }

    /* 다크모드 대비 향상 */
    [data-theme="dark"] .card-emoji.sub-edu-sim { background: rgba(0, 111, 238, 0.15); color: #338ef7; }
    [data-theme="dark"] .card-emoji.sub-edu-learn { background: rgba(23, 201, 100, 0.15); color: #4ade80; }
    [data-theme="dark"] .card-emoji.sub-edu-work { background: rgba(120, 40, 200, 0.15); color: #c084fc; }
    [data-theme="dark"] .card-emoji.sub-util-life { background: rgba(245, 165, 36, 0.15); color: #fbbf24; }
    [data-theme="dark"] .card-emoji.sub-util-chrome { background: rgba(243, 18, 96, 0.15); color: #f43f5e; }
    [data-theme="dark"] .card-emoji.sub-util-social { background: rgba(255, 78, 120, 0.15); color: #ff4e78; }
    [data-theme="dark"] .card-emoji.sub-util-creative { background: rgba(0, 183, 222, 0.15); color: #38bdf8; }
    [data-theme="dark"] .card-emoji.sub-util-notion { background: rgba(100, 116, 139, 0.15); color: #94a3b8; }
    [data-theme="dark"] .card-emoji.sub-default { background: rgba(127, 140, 141, 0.15); color: #94a3b8; }

    /* 호버 시 네온 글로우 효과 */
    .app-card:hover .card-emoji { transform: scale(1.08); }
    .app-card:hover .card-emoji.sub-edu-sim { box-shadow: 0 4px 12px rgba(0, 111, 238, 0.2); }
    .app-card:hover .card-emoji.sub-edu-learn { box-shadow: 0 4px 12px rgba(23, 201, 100, 0.2); }
    .app-card:hover .card-emoji.sub-edu-work { box-shadow: 0 4px 12px rgba(120, 40, 200, 0.2); }
    .app-card:hover .card-emoji.sub-util-life { box-shadow: 0 4px 12px rgba(245, 165, 36, 0.2); }
    .app-card:hover .card-emoji.sub-util-chrome { box-shadow: 0 4px 12px rgba(243, 18, 96, 0.2); }
    .app-card:hover .card-emoji.sub-util-social { box-shadow: 0 4px 12px rgba(255, 78, 120, 0.2); }
    .app-card:hover .card-emoji.sub-util-creative { box-shadow: 0 4px 12px rgba(0, 183, 222, 0.2); }
    .app-card:hover .card-emoji.sub-util-notion { box-shadow: 0 4px 12px rgba(100, 116, 139, 0.2); }

    .card-title {
      font-weight: 600;
      font-size: 0.95rem;
      margin-bottom: 0.25rem;
    }

    .card-desc {
      font-size: 0.8rem;
      color: var(--fg-muted);
      line-height: 1.4;
    }

    /* 외부 링크 뱃지 */
    .external-badge {
      position: absolute;
      top: 0.625rem;
      right: 0.75rem;
      font-size: 0.7rem;
      color: var(--fg-muted);
      opacity: 0.6;
    }

    @media (prefers-reduced-motion: reduce) {
      .app-card, .card-emoji, .subtree, .notice-body, .modal-backdrop, .modal-box { transition: none !important; }
      .app-card:hover, .app-card:hover .card-emoji { transform: none; }
    }

    footer {
      text-align: center;
      font-size: 0.75rem;
      color: var(--fg-muted);
      padding: 1.5rem;
      border-top: 1px solid var(--border);
    }

    /* 모달 — 닫혔을 때는 visibility로 Tab 이동에서 빠지게 */
    .modal-backdrop {
      position: fixed; inset: 0; z-index: 1000;
      background: rgba(0,0,0,0.45);
      backdrop-filter: blur(4px);
      display: flex; align-items: center; justify-content: center;
      padding: 1rem;
      opacity: 0; pointer-events: none;
      visibility: hidden;
      transition: opacity 0.2s, visibility 0s linear 0.2s;
    }
    .modal-backdrop.open {
      opacity: 1; pointer-events: auto;
      visibility: visible;
      transition: opacity 0.2s;
    }
    .modal-box {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 1.25rem;
      padding: 1.75rem;
      max-width: 420px;
      width: 100%;
      max-height: calc(100vh - 2rem);
      max-height: calc(100dvh - 2rem);
      overflow-y: auto;
      transform: translateY(12px);
      transition: transform 0.2s;
    }
    .modal-backdrop.open .modal-box { transform: translateY(0); }
    .modal-badge {
      display: inline-flex; align-items: center; gap: 5px;
      background: rgba(0,111,238,0.1); border: 1px solid rgba(0,111,238,0.25);
      color: var(--primary); font-size: 10px; font-weight: 700;
      letter-spacing: 0.08em; text-transform: uppercase;
      padding: 3px 9px; border-radius: 99px; margin-bottom: 12px;
    }
    .modal-badge::before { content: ''; width: 6px; height: 6px; flex: none; background: currentColor; border-radius: 1px; transform: rotate(45deg); }
    .modal-title {
      margin: 0 0 8px;
      font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em;
    }
    .modal-desc {
      margin-top: 0;
      font-size: 0.85rem; color: var(--fg-muted); line-height: 1.65; margin-bottom: 16px;
    }
    .modal-features {
      list-style: none; padding: 0; margin: 0 0 20px;
      display: flex; flex-direction: column; gap: 7px;
    }
    .modal-features li {
      font-size: 0.82rem; color: var(--fg-muted);
      display: flex; align-items: flex-start; gap: 7px;
    }
    .modal-features li > .ic { color: var(--primary); flex-shrink: 0; margin-top: 2px; }
    .modal-actions {
      display: flex; gap: 8px; flex-direction: column;
    }
    .modal-btn-primary {
      display: flex; align-items: center; justify-content: center;
      min-height: 44px;
      text-align: center; text-decoration: none;
      background: var(--primary); color: #fff;
      border: none; border-radius: 0.75rem;
      padding: 12px 16px; font-size: 0.9rem; font-weight: 700;
      cursor: pointer; transition: background 0.15s;
    }
    .modal-btn-primary:hover { background: var(--primary-h); }
    .modal-btn-ghost {
      display: block; text-align: center;
      min-height: 44px;
      background: none; color: var(--fg-muted);
      border: 1px solid var(--border); border-radius: 0.75rem;
      padding: 10px 16px; font-size: 0.85rem; font-weight: 500;
      font-family: inherit;
      cursor: pointer; transition: border-color 0.15s;
    }
    .modal-btn-ghost:hover { border-color: var(--fg-muted); }

    /* 모달 타입 카드 — 클릭 커서만 다름 */
    .app-card.modal-card { cursor: pointer; }

    /* 최근 방문: 카드 폭·열 수는 다른 섹션과 동일한 그리드를 따르고,
       화면폭별 열 수에 맞춰 한 행만 보이도록 표시 개수만 조절 */
    @media (max-width: 400px) {
      /* 1열: 1개만 표시 */
      .recent-section .card-grid .app-card:nth-child(n+2) {
        display: none;
      }
    }
    @media (min-width: 401px) and (max-width: 640px) {
      /* 2열: 2개까지 표시 */
      .recent-section .card-grid .app-card:nth-child(n+3) {
        display: none;
      }
    }
    @media (min-width: 641px) and (max-width: 1023px) {
      /* 3열: 3개까지 표시 */
      .recent-section .card-grid .app-card:nth-child(n+4) {
        display: none;
      }
    }

    /* 아래 앱 섹션에서 최근 방문 앱 강조 (채도 낮춤) */
    .app-card.is-recent-visited {
      border-color: rgba(124, 106, 247, 0.6);
      border-width: 2px;
    }
    .app-card.is-recent-visited:hover {
      border-color: rgba(124, 106, 247, 0.8);
    }

    /* 공지사항 — 기본은 한 줄(공지 N건 보기), 최근 30일 안 글이 있을 때만 펼침 */
    .notices-section {
      margin-bottom: 1.5rem;
    }
    .notices-bar {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .notices-toggle {
      flex: 1 1 auto;
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 44px;
      padding: 0.5rem 0.875rem;
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      background: var(--card-bg);
      color: inherit;
      font: inherit;
      text-align: left;
      cursor: pointer;
      transition: border-color 0.15s;
    }
    .notices-toggle:hover:not(:disabled) { border-color: rgba(0, 111, 238, 0.4); }
    .notices-toggle:disabled { cursor: default; }
    .notices-title {
      font-size: 0.875rem;
      font-weight: 700;
      white-space: nowrap;
    }
    .notices-new {
      flex: 0 0 auto;
      font-size: 0.7rem;
      font-weight: 700;
      color: #fff;
      background: var(--primary);
      border-radius: 99px;
      padding: 2px 8px;
    }
    .notices-meta {
      flex: 1 1 auto;
      min-width: 0;
      font-size: 0.78rem;
      color: var(--fg-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .notices-toggle .notice-chevron { margin-left: auto; }
    .notices-section.is-expanded .notices-toggle .notice-chevron { transform: rotate(180deg); }
    .notices-more {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 0.5rem;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--primary);
      text-decoration: none;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .notices-more:hover { text-decoration: underline; }
    .notices-list {
      margin-top: 0.5rem;
      border: 1px solid var(--border);
      border-radius: 1rem;
      background: var(--card-bg);
      overflow: hidden;
    }
    .notice-item { border-bottom: 1px solid var(--border); }
    .notice-item:last-child { border-bottom: none; }
    .notice-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      width: 100%;
      min-height: 44px;
      padding: 0.8rem 1rem;
      background: none;
      border: none;
      cursor: pointer;
      color: inherit;
      font: inherit;
      text-align: left;
      transition: background 0.15s;
    }
    .notice-header:hover { background: rgba(124, 106, 247, 0.06); }
    .notice-item.is-pinned .notice-header { background: rgba(124, 106, 247, 0.05); }
    .notice-item.is-pinned .notice-title { font-weight: 700; }
    /* 펼쳐진 항목 — 흰 배경(텍스트 읽기 영역) */
    .notice-item.is-open { background: var(--bg); }
    .notice-item.is-open .notice-header:hover { background: transparent; }
    .notice-title {
      flex: 1 1 auto;
      min-width: 0;
      font-size: 0.9rem;
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .notice-date {
      flex: 0 0 auto;
      font-size: 0.75rem;
      color: var(--fg-muted);
      font-variant-numeric: tabular-nums;
    }
    .notice-chevron {
      flex: 0 0 auto;
      font-size: 0.7rem;
      color: var(--fg-muted);
      transition: transform 0.2s;
    }
    .notice-item.is-open .notice-chevron { transform: rotate(180deg); }
    .notice-body {
      max-height: 0;
      overflow: hidden;
      padding: 0 1rem;
      visibility: hidden;
      transition: max-height 0.25s ease, padding 0.25s ease, visibility 0s linear 0.25s;
    }
    .notice-item.is-open .notice-body {
      max-height: 30rem;
      padding: 0 1rem 0.9rem;
      visibility: visible;
      transition: max-height 0.25s ease, padding 0.25s ease;
    }
    .notice-summary {
      margin: 0 0 0.7rem;
      font-size: 0.82rem;
      line-height: 1.6;
      color: var(--fg-muted);
    }
    .notice-go {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      text-decoration: none;
      background: transparent;
      color: var(--fg-muted);
      border: 1px solid var(--border);
      padding: 6px 12px;
      border-radius: 0.6rem;
      font-size: 0.78rem;
      font-weight: 600;
      transition: border-color 0.15s, color 0.15s;
    }
    .notice-go:hover { border-color: var(--primary); color: var(--primary); }
    @media (max-width: 480px) {
      .notice-date { display: none; }
      .notices-meta { display: none; }
    }
  </style>
</head>

<body>

  <header class="site-header">
    <div class="site-brand">
      <div class="logo-group">
        <img src="/logo-64.png" alt="" width="32" height="32" />
        <h1 class="logo-title">eduin <span>VIVES</span><span class="visually-hidden"> — 교육 미니앱 모음</span></h1>
      </div>
      <div class="logo-sub" style="margin-left:44px;">바이브 코딩으로 만든 작은 앱 모음</div>
    </div>

    <form class="app-search" id="appSearchForm" role="search" action="/" method="get">
      <label for="appSearch" class="visually-hidden">앱 이름·설명으로 찾기</label>
      <span class="app-search-icon" aria-hidden="true"><Icon name="search" size={18} /></span>
      <input
        id="appSearch"
        name="q"
        type="search"
        placeholder="앱 이름·설명으로 찾기"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
        aria-describedby="appSearchHint"
        aria-controls="appContent"
      />
      <kbd class="app-search-kbd" aria-hidden="true">/</kbd>
      <span id="appSearchHint" class="visually-hidden">/ 키를 누르면 검색창으로 이동하고, Esc 키로 검색어를 지워요.</span>
    </form>

    <!-- 테마 토글 + 공유: 넓은 화면은 헤더 줄 맨 오른쪽, 768px 미만은 우상단에 떠 있음(hero-theme.css 기본) -->
    <div class="top-overlay">
      <button type="button" id="themeToggleBtn" class="overlay-btn" onclick="cycleTheme()" title="화면 모드" aria-label="화면 모드"><Icon name="monitor" /></button>
      <button type="button" id="shareBtn" class="overlay-btn" onclick="shareCurrentPage()" title="이 페이지 공유" aria-label="이 페이지 공유">
        <Icon name="share-2" />
        <span>공유</span>
      </button>
    </div>
  </header>

  <main id="main">
    <nav class="cat-chips" aria-label="카테고리 바로가기">
      {chipBlocks.map((b) => (
        <a class="cat-chip" href={`#section-${b.id}`} data-nav-id={b.id}><Icon name={b.icon} />{b.label}</a>
      ))}
    </nav>

    <p id="searchStatus" class="visually-hidden" role="status" aria-live="polite"></p>

    <section class="notices-section" id="noticesSection" aria-label="공지사항" hidden>
      <div class="notices-bar">
        <button type="button" class="notices-toggle" id="noticesToggle" aria-expanded="false" aria-controls="noticesList" disabled>
          <Icon name="megaphone" />
          <span class="notices-title" id="noticesTitle">공지사항</span>
          <span class="notices-new" id="noticesNew" hidden>새 글</span>
          <span class="notices-meta" id="noticesMeta">에듀인 블로그 소식</span>
          <span class="notice-chevron" aria-hidden="true"><Icon name="chevron-down" /></span>
        </button>
        <a class="notices-more" id="noticesMore" href="https://blog.eduin.info/" target="_blank" rel="noopener noreferrer">전체 공지 보기<Icon name="arrow-right" /></a>
      </div>
      <div class="notices-list" id="noticesList" hidden></div>
    </section>

    <div class="page-layout">
      <nav class="tree-sidebar" aria-label="카테고리">
        <div class="sidebar-label">카테고리</div>
        <ul class="tree-nav">
          {navCategories.map((cat) => (
            <li class:list={['tree-node', cat.subs.length > 0 && 'is-open']} data-cat-id={cat.id}>
              {cat.subs.length > 0 ? (
                <button class="tree-item" type="button" aria-expanded="true" aria-controls={`subtree-${cat.id}`}>
                  <Icon name={cat.icon} />{cat.label}<span class="tree-chevron" aria-hidden="true"><Icon name="chevron-right" /></span>
                </button>
              ) : (
                <a class="tree-item" href={`#section-${cat.id}`}><Icon name={cat.icon} />{cat.label}</a>
              )}
              {cat.subs.length > 0 && (
                <ul class="subtree" id={`subtree-${cat.id}`}>
                  {cat.subs.map((sc) => (
                    <li><a class="subtree-item" href={`#section-${sc.id}`} data-subcat-id={sc.id}><Icon name={sc.icon} />{sc.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <div class="content-area" id="appContent">
        {blocks.map((b) => {
          const Tag = b.type === 'extra' ? 'div' : 'section';
          return (
            <Tag
              class={b.type !== 'extra' ? 'category-section' : undefined}
              id={b.id ? `section-${b.id}` : undefined}
              data-nav-id={b.id || undefined}
              data-block={b.type}
              data-cat={b.cat}
              style={b.type === 'sub' ? 'margin-top:0' : undefined}
            >
              {b.type === 'sub' && (
                <div class="category-header" style="border-bottom-style:dashed; opacity:0.75;">
                  <h3 class="category-label" style="font-size:0.85rem;"><Icon name={b.icon} />{b.label}</h3>
                </div>
              )}
              {(b.type === 'header' || b.type === 'flat') && (
                <div class="category-header">
                  <h2 class="category-label"><Icon name={b.icon} />{b.label}</h2>
                  <span class="category-desc">{b.desc}</span>
                </div>
              )}
              {b.items.length > 0 && (
                <div class="card-grid" id={b.type === 'flat' ? `grid-${b.id}` : undefined}>
                  {b.items.map((app) => {
                    const modal = isModalApp(app);
                    const external = isExternalApp(app);
                    const newTab = external || (modal && !!app.external);
                    return (
                      <a
                        class:list={['app-card', modal && 'modal-card']}
                        href={app.href}
                        data-app-id={app.id}
                        target={newTab ? '_blank' : undefined}
                        rel={newTab ? 'noopener noreferrer' : undefined}
                        aria-haspopup={modal ? 'dialog' : undefined}
                      >
                        {external && <span class="external-badge" aria-hidden="true"><Icon name="arrow-up-right" /></span>}
                        {modal && <span class="external-badge" aria-hidden="true"><Icon name="info" /></span>}
                        <div class={`card-emoji sub-${app.subcategory || 'default'}`} aria-hidden="true">
                          {app.lucideIcon ? <Icon name={app.lucideIcon} /> : app.emoji}
                        </div>
                        <div class="card-title">{app.title}</div>
                        <div class="card-desc">{app.desc}</div>
                        {external && <span class="visually-hidden">(새 창에서 열려요)</span>}
                      </a>
                    );
                  })}
                </div>
              )}
            </Tag>
          );
        })}

        <div class="search-empty" id="searchEmpty" hidden>
          <p class="search-empty-title">찾는 앱이 없어요</p>
          <p class="search-empty-desc">다른 낱말로 찾아보거나 전체 앱을 둘러보세요.</p>
          <button type="button" class="search-empty-btn" id="searchReset">전체 앱 보기</button>
        </div>
      </div>
    </div>
  </main>

  <footer>eduin · 선생님이 바이브 코딩으로 만들었어요</footer>

  <!-- 모달 -->
  <div class="modal-backdrop" id="appModal">
    <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="modalTitle" aria-describedby="modalDesc" tabindex="-1">
      <div class="modal-badge" id="modalBadge"></div>
      <h2 class="modal-title" id="modalTitle"></h2>
      <p class="modal-desc" id="modalDesc"></p>
      <ul class="modal-features" id="modalFeatures"></ul>
      <div class="modal-actions">
        <a id="modalLink" href="#" class="modal-btn-primary" target="_blank" rel="noopener noreferrer"></a>
        <button type="button" class="modal-btn-ghost" id="modalClose">닫기</button>
      </div>
    </div>
  </div>

  <script type="application/json" id="homeData" set:html={homeJson}></script>

  <script is:inline>
  (() => {
    'use strict';

    /* =============================================
       준비: 빌드 때 넣어 둔 앱 데이터 + 정적 마크업 참조
       ============================================= */
    const RECENT_KEY = 'byeduin_recent_apps';
    const NOTICE_CACHE_KEY = 'byeduin_notices_cache';
    const NOTICE_CFG_KEY = 'byeduin_notices_cfg';
    const NOTICE_TTL = 60 * 60 * 1000; // 1시간
    const NOTICE_FRESH_MS = 30 * 24 * 60 * 60 * 1000; // 30일 안 글이 있으면 펼침
    // lucide 스프라이트 아이콘(공용 ui.js) — @icons history pin arrow-right chevron-down check
    const ic = (n) => (window.VUI && window.VUI.icon ? window.VUI.icon(n) : '');

    const store = {
      get(key, fallback) {
        try {
          const v = JSON.parse(localStorage.getItem(key) || 'null');
          return v == null ? fallback : v;
        } catch { return fallback; }
      },
      set(key, value) {
        try { localStorage.setItem(key, JSON.stringify(value)); } catch { /* 저장소 막힘 — 무시 */ }
      },
    };

    let data = { apps: [] };
    try {
      data = JSON.parse(document.getElementById('homeData').textContent || '{}');
    } catch (e) {
      console.error('[home] 앱 데이터 읽기 실패:', e);
    }
    const APPS = Array.isArray(data.apps) ? data.apps : [];
    const APP_BY_ID = new Map(APPS.map((a) => [a.id, a]));

    const content = document.getElementById('appContent');
    const staticCards = Array.from(content.querySelectorAll('.app-card[data-app-id]'));
    const blocks = Array.from(content.querySelectorAll('[data-block]'));
    const chips = Array.from(document.querySelectorAll('.cat-chip'));
    const cardByHref = new Map();
    staticCards.forEach((card) => {
      const app = APP_BY_ID.get(card.dataset.appId);
      if (app && !app.modal && !cardByHref.has(app.href)) cardByHref.set(app.href, card);
    });

    /* =============================================
       최근 방문 (기기별)
       ============================================= */
    function readRecent() {
      const list = store.get(RECENT_KEY, []);
      return Array.isArray(list) ? list.filter((a) => a && typeof a.href === 'string') : [];
    }

    function saveRecentApp(app) {
      const list = readRecent().filter((a) => a.href !== app.href);
      list.unshift({
        href: app.href,
        emoji: app.emoji,
        title: app.title,
        desc: app.desc,
        category: app.category,
        subcategory: app.subcategory,
        lucideIcon: app.lucideIcon,
      });
      store.set(RECENT_KEY, list.slice(0, 10));
    }

    // 정적 카드를 복제해 쓰므로 제목·아이콘이 apps.json 최신값과 항상 같다
    function renderRecentSection(recent) {
      const list = recent.filter((a) => cardByHref.has(a.href)).slice(0, 4);
      if (list.length === 0) return;

      const section = document.createElement('section');
      section.className = 'category-section recent-section';
      section.setAttribute('aria-labelledby', 'recentHeading');
      section.innerHTML = `
        <div class="category-header">
          <h2 class="category-label" id="recentHeading">${ic('history')}홈에서 최근 연 앱</h2>
          <span class="category-desc">이 기기에서 홈 카드로 연 앱</span>
        </div>
        <div class="card-grid" id="grid-recent"></div>
      `;
      const grid = section.querySelector('.card-grid');
      list.forEach((item) => {
        const clone = cardByHref.get(item.href).cloneNode(true);
        clone.classList.remove('is-recent-visited');
        clone.hidden = false;
        grid.appendChild(clone);
      });
      content.prepend(section);
    }

    function markMostRecent(recent) {
      // 가장 최근 방문 앱(1개)만 하이라이트
      const first = recent[0];
      const card = first && cardByHref.get(first.href);
      if (card) card.classList.add('is-recent-visited');
    }

    /* =============================================
       모달 (외부 서비스·확장 프로그램 안내)
       ============================================= */
    const modal = document.getElementById('appModal');
    const modalBox = modal.querySelector('.modal-box');
    let modalReturnFocus = null;

    function openModal(app, opener) {
      const m = app.modal || {};
      document.getElementById('modalBadge').textContent = m.badge || '';

      const titleEl = document.getElementById('modalTitle');
      titleEl.textContent = '';
      // 아이콘은 카드에 빌드 때 그려 둔 것을 복제(런타임 아이콘 라이브러리 없이)
      const cardIcon = opener && opener.querySelector ? opener.querySelector('.card-emoji') : null;
      const icon = cardIcon ? cardIcon.cloneNode(true) : document.createElement('div');
      if (!cardIcon) {
        icon.className = 'card-emoji sub-' + (app.subcategory || 'default');
        icon.innerHTML = app.lucideIcon ? ic(app.lucideIcon) : '';
        if (!app.lucideIcon) icon.textContent = app.emoji || '';
      }
      icon.setAttribute('aria-hidden', 'true');
      icon.style.cssText = 'display:inline-flex; vertical-align:middle; margin-right:8px; margin-bottom:0;';
      const name = document.createElement('span');
      name.style.verticalAlign = 'middle';
      name.textContent = app.title;
      titleEl.append(icon, name);

      document.getElementById('modalDesc').textContent = m.modalDesc || app.desc || '';
      // features는 빌드 때 apps.json에서 온 신뢰된 HTML(링크 포함)
      document.getElementById('modalFeatures').innerHTML = (m.features || []).map((f) => `<li>${ic('check')}<span>${f}</span></li>`).join('');
      const link = document.getElementById('modalLink');
      link.href = app.href;
      link.textContent = m.linkLabel || '바로가기';
      if (m.external) { link.target = '_blank'; link.rel = 'noopener noreferrer'; }
      else { link.removeAttribute('target'); link.removeAttribute('rel'); }

      modalReturnFocus = opener || document.activeElement;
      modal.classList.add('open');
      modalBox.focus({ preventScroll: true });
    }

    function closeModal() {
      if (!modal.classList.contains('open')) return;
      modal.classList.remove('open');
      const back = modalReturnFocus;
      modalReturnFocus = null;
      if (back && document.contains(back) && typeof back.focus === 'function') back.focus({ preventScroll: true });
    }

    function trapModalFocus(e) {
      const items = Array.from(modalBox.querySelectorAll('a[href], button:not([disabled])'));
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;
      if (e.shiftKey && (active === first || active === modalBox)) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && (active === last || !modalBox.contains(active))) { e.preventDefault(); first.focus(); }
    }

    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    document.getElementById('modalClose').addEventListener('click', closeModal);

    /* 카드 클릭: 모달형은 안내창, 나머지는 최근 방문 기록 (복제된 최근 카드 포함 — 위임) */
    document.addEventListener('click', (e) => {
      const card = e.target instanceof Element ? e.target.closest('a.app-card[data-app-id]') : null;
      if (!card) return;
      const app = APP_BY_ID.get(card.dataset.appId);
      if (!app) return;
      if (app.modal) {
        if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey || e.button !== 0) return; // 새 탭 열기 등은 그대로
        e.preventDefault();
        openModal(app, card);
      } else {
        saveRecentApp(app);
      }
    });

    /* =============================================
       검색 (제목·설명·키워드·카테고리 이름, 초성·IME 조합 중 입력 지원)
       ============================================= */
    const form = document.getElementById('appSearchForm');
    const input = document.getElementById('appSearch');
    const statusEl = document.getElementById('searchStatus');
    const emptyEl = document.getElementById('searchEmpty');

    const CHO = 'ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎ';
    // 홑받침 → 같은 소리의 첫소리 (조합 중 '탕'이 곧 '타이'가 되는 경우를 위해)
    const JONG_TO_CHO = { 1: 'ㄱ', 2: 'ㄲ', 4: 'ㄴ', 7: 'ㄷ', 8: 'ㄹ', 16: 'ㅁ', 17: 'ㅂ', 19: 'ㅅ', 20: 'ㅆ', 21: 'ㅇ', 22: 'ㅈ', 23: 'ㅊ', 24: 'ㅋ', 25: 'ㅌ', 26: 'ㅍ', 27: 'ㅎ' };
    const isSyllable = (code) => code >= 0xAC00 && code <= 0xD7A3;
    const choOf = (code) => CHO[Math.floor((code - 0xAC00) / 588)];
    const normalize = (s) => String(s || '').toLowerCase().replace(/\s+/g, ' ').trim();

    function toChoseong(str) {
      let out = '';
      for (const ch of str) {
        const code = ch.charCodeAt(0);
        out += isSyllable(code) ? choOf(code) : ch;
      }
      return out;
    }

    const searchIndex = staticCards.map((card) => {
      const app = APP_BY_ID.get(card.dataset.appId);
      const text = normalize((app && app.s) || card.textContent);
      const compact = text.replace(/\s+/g, '');
      // 초성 검색(ㅌㅇㅁ → 타이머)은 앱 이름에만 — 설명·키워드까지 넣으면 두세 글자로도 너무 많이 걸림
      const titleCompact = normalize((app && app.title) || '').replace(/\s+/g, '');
      return { card, text, compact, cho: toChoseong(titleCompact) };
    });

    function termMatches(entry, term, composingTail) {
      if (entry.text.includes(term) || entry.compact.includes(term)) return true;
      if (/^[ㄱ-ㅎ]+$/.test(term)) return entry.cho.includes(term);
      if (!composingTail) return false;
      const last = term.charCodeAt(term.length - 1);
      if (!isSyllable(last)) return false;
      const jong = (last - 0xAC00) % 28;
      const nextCho = JONG_TO_CHO[jong];
      if (!nextCho) return false;
      const head = term.slice(0, -1) + String.fromCharCode(last - jong);
      let i = entry.compact.indexOf(head);
      while (i !== -1) {
        const next = entry.compact.charCodeAt(i + head.length);
        if (isSyllable(next) && choOf(next) === nextCho) return true;
        i = entry.compact.indexOf(head, i + 1);
      }
      return false;
    }

    let composing = false;
    let announceTimer = 0;
    let urlTimer = 0;

    function announce(text) {
      clearTimeout(announceTimer);
      announceTimer = setTimeout(() => { statusEl.textContent = text; }, 400);
    }

    function syncUrl() {
      clearTimeout(urlTimer);
      urlTimer = setTimeout(() => {
        try {
          const url = new URL(location.href);
          const q = input.value.trim();
          if (q) url.searchParams.set('q', q);
          else url.searchParams.delete('q');
          const next = url.pathname + url.search + url.hash;
          if (next !== location.pathname + location.search + location.hash) history.replaceState(history.state, '', next);
        } catch { /* 무시 */ }
      }, 300);
    }

    function applyFilter(updateUrl = true) {
      const q = normalize(input.value);
      const terms = q ? q.split(' ') : [];
      let count = 0;

      searchIndex.forEach((entry) => {
        const ok = terms.every((t, i) => termMatches(entry, t, composing && i === terms.length - 1));
        entry.card.hidden = !ok;
        if (ok) count++;
      });

      // 카드가 하나도 안 남은 섹션은 숨김, 카테고리 머리말은 그 아래 섹션이 하나라도 있으면 유지
      const visibleCats = new Set();
      blocks.forEach((b) => {
        if (b.dataset.block === 'header') return;
        const any = !!b.querySelector('.app-card:not([hidden])');
        b.hidden = !any;
        if (any) visibleCats.add(b.dataset.cat);
      });
      blocks.forEach((b) => {
        if (b.dataset.block === 'header') b.hidden = !visibleCats.has(b.dataset.cat);
      });
      chips.forEach((chip) => {
        const sec = document.getElementById('section-' + chip.dataset.navId);
        chip.hidden = !sec || sec.hidden;
      });

      const searching = terms.length > 0;
      document.body.classList.toggle('is-searching', searching);
      emptyEl.hidden = !(searching && count === 0);
      announce(searching ? (count > 0 ? `앱 ${count}개를 찾았어요` : '찾는 앱이 없어요') : '');
      if (updateUrl) syncUrl();
      return count;
    }

    function clearSearch() {
      input.value = '';
      composing = false;
      applyFilter();
    }

    input.addEventListener('compositionstart', () => { composing = true; });
    input.addEventListener('compositionend', () => { composing = false; applyFilter(); });
    input.addEventListener('input', (e) => {
      if (typeof e.isComposing === 'boolean') composing = e.isComposing;
      applyFilter();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || e.isComposing) return;
      e.stopPropagation();
      if (input.value) { e.preventDefault(); clearSearch(); }
      else input.blur();
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      composing = false;
      if (applyFilter() > 0 && input.value.trim()) {
        const first = searchIndex.find((entry) => !entry.card.hidden);
        if (first) first.card.focus();
      }
    });
    document.getElementById('searchReset').addEventListener('click', () => {
      clearSearch();
      input.focus();
    });

    /* =============================================
       키보드: / 로 검색, Esc로 모달 닫기, 모달 안 Tab 순환
       ============================================= */
    document.addEventListener('keydown', (e) => {
      const modalOpen = modal.classList.contains('open');
      if (modalOpen) {
        if (e.key === 'Escape') { e.preventDefault(); closeModal(); }
        else if (e.key === 'Tab') trapModalFocus(e);
        return;
      }
      if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey || e.isComposing || e.defaultPrevented) return;
      const t = e.target;
      if (t instanceof Element && t.closest('input, textarea, select, [contenteditable]:not([contenteditable="false"])')) return;
      e.preventDefault();
      input.focus();
      input.select();
    });

    /* =============================================
       카테고리 내비: 트리 접기·펼치기, 스크롤 스파이
       ============================================= */
    document.querySelectorAll('.tree-node > button.tree-item').forEach((btn) => {
      btn.addEventListener('click', () => {
        const open = btn.parentElement.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(open));
      });
    });

    function setActiveNav(id) {
      document.querySelectorAll('.tree-item.is-active, .subtree-item.is-active, .cat-chip.is-active')
        .forEach((el) => el.classList.remove('is-active'));
      const sel = window.CSS && CSS.escape ? CSS.escape(id) : id;
      document.querySelectorAll(`[data-cat-id="${sel}"] > .tree-item, .subtree-item[data-subcat-id="${sel}"], .cat-chip[data-nav-id="${sel}"]`)
        .forEach((el) => el.classList.add('is-active'));
      // 가로 칩 줄: 활성 칩이 가려져 있으면 줄 안에서만 옆으로 넘겨 보이게(페이지는 세로로 움직이지 않음)
      const chip = document.querySelector(`.cat-chip[data-nav-id="${sel}"]`);
      const row = chip && chip.parentElement;
      if (row && row.scrollWidth > row.clientWidth) {
        const r = chip.getBoundingClientRect(), rr = row.getBoundingClientRect();
        const pad = 24;
        if (r.left < rr.left) row.scrollBy({ left: r.left - rr.left - pad, behavior: 'smooth' });
        else if (r.right > rr.right - 40) row.scrollBy({ left: r.right - rr.right + 40 + pad, behavior: 'smooth' });
      }
    }

    // 가로 칩 줄 오른쪽 끝 흐림(더 넘길 칩이 있을 때만)
    function setupChipFade() {
      const row = document.querySelector('.cat-chips');
      if (!row) return;
      const update = () => row.classList.toggle('has-more', row.scrollLeft + row.clientWidth < row.scrollWidth - 4);
      row.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    }

    function setupScrollSpy() {
      if (!('IntersectionObserver' in window)) return;
      const targets = Array.from(content.querySelectorAll('[data-nav-id]'));
      if (!targets.length) return;
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((en) => { if (en.isIntersecting) setActiveNav(en.target.dataset.navId); });
      }, { rootMargin: '-20% 0px -60% 0px' });
      targets.forEach((el) => obs.observe(el));
    }

    /* =============================================
       공지사항 — 비동기. 검색·카드는 기다리지 않음.
       캐시가 있으면 즉시 그리고(오래돼도) 뒤에서 갱신
       ============================================= */
    const notices = {
      section: document.getElementById('noticesSection'),
      toggle: document.getElementById('noticesToggle'),
      title: document.getElementById('noticesTitle'),
      meta: document.getElementById('noticesMeta'),
      badge: document.getElementById('noticesNew'),
      list: document.getElementById('noticesList'),
      more: document.getElementById('noticesMore'),
      count: 0,
      sig: null,
      userToggled: false,
    };
    const DEFAULT_NOTICES_CFG = { mode: 'recent', recentLimit: 5, pinned: [] };
    const isHttpUrl = (u) => typeof u === 'string' && /^https?:\/\//i.test(u);

    function normalizeNoticesCfg(c) {
      c = c || {};
      return {
        mode: ['recent', 'pinned', 'both'].includes(c.mode) ? c.mode : 'recent',
        recentLimit: Math.min(20, Math.max(1, parseInt(c.recentLimit, 10) || 5)),
        pinned: Array.isArray(c.pinned) ? c.pinned.filter((p) => p && p.link) : [],
      };
    }

    async function loadNoticesConfig(fallback) {
      try {
        const res = await fetch('/notices.json', { cache: 'no-cache' });
        if (!res.ok) return fallback;
        return normalizeNoticesCfg(await res.json());
      } catch { return fallback; }
    }

    function buildNoticeItems(cfg, posts) {
      posts = Array.isArray(posts) ? posts : [];
      const wantRecent = cfg.mode === 'recent' || cfg.mode === 'both';
      const wantPinned = (cfg.mode === 'pinned' || cfg.mode === 'both') && cfg.pinned.length > 0;
      // 지정글: 제목·요약 없으면 최신글에서 link 매칭으로 보완
      const byLink = new Map(posts.filter(Boolean).map((p) => [p.link, p]));
      const pinned = wantPinned ? cfg.pinned.map((p) => {
        const hit = byLink.get(p.link);
        return {
          title: p.title || (hit && hit.title) || p.link,
          link: p.link,
          date: p.date || (hit && hit.date) || '',
          summary: p.summary || (hit && hit.summary) || '',
          pinned: true,
        };
      }) : [];
      // both: 최신글에서 지정글과 중복 제거
      const pinnedLinks = new Set(pinned.map((p) => p.link));
      const recent = wantRecent ? posts.slice(0, cfg.recentLimit).filter((p) => p && !pinnedLinks.has(p.link)) : [];
      return [...pinned, ...recent].filter((p) => p && p.title && isHttpUrl(p.link));
    }

    function formatNoticeDate(iso) {
      if (!iso) return '';
      const d = new Date(iso);
      if (Number.isNaN(d.getTime())) return '';
      return d.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' });
    }

    function isFreshNotice(post) {
      const t = new Date(post.date || '').getTime();
      return Number.isFinite(t) && Date.now() - t <= NOTICE_FRESH_MS;
    }

    function updateNoticesLabel() {
      const expanded = notices.toggle.getAttribute('aria-expanded') === 'true';
      notices.title.textContent = expanded ? '공지사항' : `공지 ${notices.count}건 보기`;
      notices.meta.textContent = '에듀인 블로그 소식';
    }

    function setNoticesExpanded(open) {
      notices.toggle.setAttribute('aria-expanded', String(open));
      notices.section.classList.toggle('is-expanded', open);
      notices.list.hidden = !open;
      updateNoticesLabel();
    }

    notices.toggle.addEventListener('click', () => {
      notices.userToggled = true;
      setNoticesExpanded(notices.toggle.getAttribute('aria-expanded') !== 'true');
    });

    let noticeSeq = 0;
    function buildNoticeItem(post) {
      const item = document.createElement('div');
      item.className = 'notice-item' + (post.pinned ? ' is-pinned' : '');
      const bodyId = 'notice-body-' + (++noticeSeq);

      // ── 헤더(클릭 시 아코디언 토글) ──
      const header = document.createElement('button');
      header.type = 'button';
      header.className = 'notice-header';
      header.setAttribute('aria-expanded', 'false');
      header.setAttribute('aria-controls', bodyId);

      const titleEl = document.createElement('span');
      titleEl.className = 'notice-title';
      titleEl.textContent = post.title; // XSS 안전
      if (post.pinned) titleEl.insertAdjacentHTML('afterbegin', ic('pin') + ' ');
      titleEl.title = post.title;

      const dateEl = document.createElement('span');
      dateEl.className = 'notice-date';
      dateEl.textContent = formatNoticeDate(post.date);

      const chev = document.createElement('span');
      chev.className = 'notice-chevron';
      chev.setAttribute('aria-hidden', 'true');
      chev.innerHTML = ic('chevron-down');

      header.append(titleEl, dateEl, chev);

      // ── 본문(펼침 영역): 요약 + 이동 버튼 ──
      const body = document.createElement('div');
      body.className = 'notice-body';
      body.id = bodyId;
      if (post.summary) {
        const p = document.createElement('p');
        p.className = 'notice-summary';
        p.textContent = post.summary; // XSS 안전
        body.appendChild(p);
      }
      const go = document.createElement('a');
      go.className = 'notice-go';
      go.href = post.link; // http(s)만 통과
      go.target = '_blank';
      go.rel = 'noopener noreferrer';
      go.textContent = '글 보러가기';
      go.insertAdjacentHTML('beforeend', ic('arrow-right'));
      body.appendChild(go);

      // ── 아코디언 토글(한 번에 하나만 열림) ──
      header.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');
        notices.list.querySelectorAll('.notice-item.is-open').forEach((el) => {
          el.classList.remove('is-open');
          const h = el.querySelector('.notice-header');
          if (h) h.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          item.classList.add('is-open');
          header.setAttribute('aria-expanded', 'true');
        }
      });

      item.append(header, body);
      return item;
    }

    function renderNotices(items, source) {
      const sig = JSON.stringify([items, source || '']);
      if (sig === notices.sig) return;
      notices.sig = sig;
      if (isHttpUrl(source)) notices.more.href = source;
      if (items.length === 0) { notices.section.hidden = true; return; }

      notices.list.textContent = '';
      items.forEach((post) => notices.list.appendChild(buildNoticeItem(post)));
      notices.count = items.length;
      const fresh = items.some(isFreshNotice);
      notices.badge.hidden = !fresh;
      notices.toggle.disabled = false;
      notices.section.hidden = false;
      if (notices.userToggled) updateNoticesLabel();
      else setNoticesExpanded(fresh);
    }

    async function loadNotices() {
      // 자리를 미리 잡지 않는다 — 0건·실패면 줄이 생겼다 사라지며 카드가 위로 튀므로, 글이 있을 때만 보인다(캐시가 있으면 바로)
      const cachedCfg = normalizeNoticesCfg(store.get(NOTICE_CFG_KEY, DEFAULT_NOTICES_CFG));
      const cached = store.get(NOTICE_CACHE_KEY, null);
      const hasCache = !!(cached && Array.isArray(cached.posts));
      if (hasCache) renderNotices(buildNoticeItems(cachedCfg, cached.posts), cached.source);

      const cfg = await loadNoticesConfig(cachedCfg);
      store.set(NOTICE_CFG_KEY, cfg);
      const wantRecent = cfg.mode === 'recent' || cfg.mode === 'both';

      let posts = hasCache ? cached.posts : [];
      let source = hasCache ? cached.source : '';
      const cacheFresh = hasCache && Date.now() - cached.ts < NOTICE_TTL;
      if (wantRecent && !cacheFresh) {
        try {
          const res = await fetch('/api/notices?limit=' + cfg.recentLimit);
          if (res.ok) {
            const d = await res.json();
            posts = Array.isArray(d.posts) ? d.posts : [];
            source = d.source || '';
            store.set(NOTICE_CACHE_KEY, { ts: Date.now(), posts, source });
          }
        } catch (e) { console.error('[notices] 로드 실패:', e); }
      }
      renderNotices(buildNoticeItems(cfg, posts), source);
    }

    /* =============================================
       시작 — 첫 화면 그리기 전에 동기로 끝나는 것부터
       ============================================= */
    loadNotices(); // 캐시 반영까지는 동기, 나머지는 비동기

    const recent = readRecent();
    renderRecentSection(recent);
    markMostRecent(recent);

    const initialQ = new URLSearchParams(location.search).get('q');
    if (initialQ) {
      input.value = initialQ;
      applyFilter(false);
    }

    setupChipFade();
    requestAnimationFrame(setupScrollSpy);
  })();
  </script>

</body>

</html>
