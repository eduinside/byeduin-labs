---
import AppLayout from '../../../layouts/AppLayout.astro';
// 원문: LOCAL/local-law/docs/terms.md (앱 안 ‘설정 › 이용 안내 · 약관’과 같은 글). 바뀌면 _terms.md 로 다시 복사.
import { Content } from './_terms.md';
---
<AppLayout
  title="G노트 이용 안내 · 약관 — eduin VIVES"
  description="G노트의 이용 안내·약관: 자료는 내 PC 에만, 이 PC 밖으로 나가는 것, 공문 공개 구분에 따른 AI 전송 규칙, 법제처 자료 출처."
  bodyShell="column"
  bodyWidth="medium"
>
  <Fragment slot="head">
    <style is:global>
      .gn-terms { line-height: 1.75; font-size: 0.92rem; }
      .gn-terms h1 { font-size: 1.4rem; }
      .gn-terms h2 { font-size: 1.05rem; margin-top: 1.6em; }
      .gn-terms table { width: 100%; border-collapse: collapse; font-size: 0.86rem; }
      .gn-terms th, .gn-terms td { border-top: 1px solid var(--border); padding: 6px 8px; text-align: left; vertical-align: top; }
      .gn-terms a { color: var(--primary); word-break: break-all; }
    </style>
  </Fragment>
  <main class="app-main wrap">
    <p><a href="/apps/gnote/">← G노트</a></p>
    <article class="hero-card gn-terms" style="padding: 18px 22px;"><Content /></article>
  </main>
</AppLayout>
