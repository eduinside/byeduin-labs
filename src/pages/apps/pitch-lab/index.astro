    <button type="button" class="sk-btn sk-btn--primary" id="btnRetry"><Icon name="rotate-ccw" />다시 하기</button>
    <button type="button" class="sk-btn" id="btnToLive"><Icon name="arrow-left" />자유 탐험으로</button>
  </div>
