---
import AppLayout from '../../../layouts/AppLayout.astro';
---
<AppLayout 
  icons
  title="QR Master — eduin VIVES"
  description="QR 코드 생성, 카메라/이미지 스캔, 단축주소 올인원. 빠르고 간편한 QR 도구."
  image="https://eduin.info/og-images/qr.png"
  bodyShell="column"
  bodyWidth="narrow"
>
  <Fragment slot="head">
    <link rel="manifest" href="/apps/qr/manifest.json">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" is:inline=""></script>
  <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js" is:inline=""></script>
  <style is:global="">
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap');

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding: 48px 1rem 5rem;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(124,106,247,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(124,106,247,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 0;
    }

    .wrap {
      width: 100%;
      max-width: 440px;
      position: relative;
      z-index: 1;
    }

    /* 외부 카드 래퍼 */
    .qr-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 1.5rem;
      overflow: hidden;
    }

    /* 탭 */
    .tabs {
      display: flex;
      border-bottom: 1px solid var(--border);
    }
    .tab-btn {
      flex: 1;
      padding: 1rem;
      font-size: 0.9rem;
      font-weight: 600;
      background: none;
      border: none;
      border-bottom: 2px solid transparent;
      color: var(--fg-muted);
      cursor: pointer;
      transition: color 0.2s, border-color 0.2s;
      min-height: 48px;
      font-family: inherit;
    }
    .tab-btn.active {
      color: var(--primary);
      border-bottom-color: var(--primary);
    }

    /* 카드 바디 */
    .card-body {
      padding: 1.5rem;
      overflow: hidden;
    }

    /* 탭 패널 — 두 패널이 항상 공간을 차지하여 높이 고정 */
    .tab-panels-wrap {
      display: grid;
      grid-template-columns: 1fr;
    }
    .tab-panel {
      grid-area: 1 / 1;
      visibility: hidden;
      pointer-events: none;
      min-width: 0;
      overflow: hidden;
      width: 100%;
    }
    .tab-panel.active {
      visibility: visible;
      pointer-events: auto;
    }

    /* 스캔 입력 그리드 */
    .scan-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.625rem;
      margin-bottom: 1rem;
    }

    .scan-opt {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.375rem;
      padding: 0.875rem 0.5rem;
      background: var(--bg);
      border: 1.5px dashed var(--border);
      border-radius: 0.75rem;
      color: var(--fg-muted);
      cursor: pointer;
      font-size: 0.75rem;
      font-weight: 600;
      min-height: 72px;
      transition: border-color 0.2s, color 0.2s;
      font-family: inherit;
    }
    .scan-opt:hover { border-color: var(--primary); color: var(--primary); }
    .scan-opt svg { width: 22px; height: 22px; }

    /* 카메라 영역 */
    #cameraArea {
      display: none;
      position: relative;
      border-radius: 0.75rem;
      overflow: hidden;
      background: #000;
      margin-bottom: 1rem;
    }
    #reader { width: 100%; height: 240px; display: flex; align-items: center; justify-content: center; }
    #qr-video { width: 100%; height: 100%; object-fit: cover; display: block; }
    .camera-close {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 40px;
      height: 40px;
      background: rgba(255,255,255,0.85);
      border: none;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      z-index: 10;
    }

    /* QR 결과 */
    #genResultArea {
      display: none;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
      margin-top: 1rem;
    }
    #genResultArea.show { display: flex; }

    #qrcode-wrap {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      padding: 1rem;
    }
    #qrcode img, #qrcode canvas { margin: 0 auto; border-radius: 4px; }

    #genResultText {
      font-size: 0.75rem;
      color: var(--fg-muted);
      font-family: monospace;
      word-break: break-all;
      text-align: center;
    }

    /* 스캔 결과 */
    #scanResultArea {
      display: none;
      background: var(--bg);
      border: 1px solid var(--success);
      border-radius: 0.75rem;
      padding: 1rem;
      margin-bottom: 1rem;
    }
    #scanResultArea.show { display: block; }

    .scan-result-header {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--success);
      margin-bottom: 0.5rem;
      position: relative;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .btn-close-scan {
      background: none;
      border: none;
      font-size: 1.2rem;
      cursor: pointer;
      padding: 0;
      min-width: 40px;
      min-height: 40px;
      margin: -10px -10px -10px 0;
      border-radius: 50%;
      font-family: inherit;
      color: var(--fg-muted);
      transition: color 0.2s;
    }

    .btn-close-scan:hover {
      color: var(--fg);
    }

    #scanResultText {
      font-size: 0.85rem;
      font-family: monospace;
      word-break: break-all;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      padding: 0.5rem 0.75rem;
      margin-bottom: 0.625rem;
      user-select: all;
    }

    .scan-actions { display: flex; gap: 0.5rem; }
    .scan-actions a, .scan-actions button {
      font-size: 0.8rem;
      min-height: 40px;
      padding: 0.4rem 0.875rem;
      border-radius: 0.5rem;
      border: none;
      cursor: pointer;
      font-weight: 600;
      font-family: inherit;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
    }
    .btn-copy-scan { background: var(--primary); color: #fff; }
    .btn-open-link { background: var(--card-bg); border: 1px solid var(--border) !important; color: var(--fg); display: none; }
    .btn-open-link.show { display: inline-flex; }

    /* 히스토리 */
    .history-section {
      margin-top: 1.25rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border);
    }
    .history-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
    }
    .history-header span { font-size: 0.85rem; font-weight: 700; }
    .btn-clear { font-size: 0.75rem; color: var(--danger); background: none; border: none; cursor: pointer; font-family: inherit; min-height: 40px; padding: 0 8px; border-radius: 8px; }
    .btn-title-all { font-size: 0.75rem; color: var(--primary); background: none; border: none; cursor: pointer; font-family: inherit; min-height: 40px; padding: 0 8px; border-radius: 8px; }
    .history-header-actions { display: flex; align-items: center; gap: 2px; }

    #historyList { list-style: none; padding: 0; margin: 0; max-height: 180px; overflow-y: auto; display: flex; flex-direction: column; gap: 0.5rem; }

    .history-item {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 0.625rem;
      padding: 0.25rem 0.25rem 0.25rem 0.375rem;
      transition: border-color 0.2s;
    }
    .history-item:hover { border-color: var(--primary); }
    /* 항목 누르기(열기·복사·다시 생성) = 버튼 — 키보드로도 동작 */
    .history-main {
      flex: 1;
      min-width: 0;
      min-height: 44px;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.375rem;
      background: none;
      border: none;
      border-radius: 0.5rem;
      color: inherit;
      font: inherit;
      text-align: left;
      cursor: pointer;
    }
    .title-btn {
      flex-shrink: 0;
      min-height: 32px;
      padding: 0 0.5rem;
      font-size: 0.7rem;
      font-weight: 600;
      font-family: inherit;
      color: var(--primary);
      background: none;
      border: 1px solid var(--border);
      border-radius: 99px;
      cursor: pointer;
      position: relative;
    }
    .title-btn::after { content: ''; position: absolute; inset: -6px -2px; }   /* 누르는 영역 넓히기 */
    .title-btn:disabled { opacity: 0.6; cursor: wait; }
    .title-note { font-size: 0.7rem; color: var(--fg-muted); margin: 0.5rem 0 0; line-height: 1.5; }

    .history-icon {
      width: 28px; height: 28px;
      background: var(--card-bg);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 0.8rem;
    }

    .history-text { flex: 1; min-width: 0; }
    .history-text .main { display: block; font-size: 0.8rem; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0; }
    .history-text .sub  { display: block; font-size: 0.7rem; color: var(--fg-muted); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .history-del {
      background: none;
      border: none;
      color: var(--fg-muted);
      cursor: pointer;
      padding: 4px;
      font-size: 1rem;
      line-height: 1;
      flex-shrink: 0;
      min-width: 40px;
      min-height: 40px;
      border-radius: 50%;
      font-family: inherit;
    }
    .history-del:hover { color: var(--danger); }

    .history-empty { text-align: center; font-size: 0.8rem; color: var(--fg-muted); padding: 1.5rem 0; }

    /* QR 리더 */
    #reader { max-width: 100%; overflow: hidden; }
    #reader img, #reader video { max-width: 100%; height: auto; }

    /* 멀티 스캔 누적 목록 */
    #multiListArea {
      display: none;
      margin-top: 0.75rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--border);
      overflow: hidden;
    }

    /* 유틸 */
    .mt-1 { margin-top: 0.5rem; }
    .mt-2 { margin-top: 0.75rem; }
    .w-full { width: 100%; }
    .hint { font-size: 0.72rem; color: var(--fg-muted); text-align: center; margin-top: 0.375rem; }

  </style>
  <script type="application/ld+json" is:inline="">{"@context":"https://schema.org","@type":"WebApplication","name":"QR Master","description":"QR 코드 생성, 카메라/이미지 스캔, 단축주소 올인원. 빠르고 간편한 QR 도구.","url":"https://eduin.info/apps/qr/","applicationCategory":"EducationApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"KRW"},"isPartOf":{"@type":"WebSite","name":"eduin VIVES","url":"https://eduin.info"}}</script>
  </Fragment>


<div class="wrap">

  <!-- has-lucide-header를 직접 두면 seo-injector가 헤더 재작성을 건너뛴다.
       아이콘이 /apps.json 요청(서비스워커 캐시·오프라인 시 실패 가능)에 좌우되지 않는다. -->
  <div class="app-header has-lucide-header">
    <div class="app-header-icon-blob sub-util-life">
      <i data-lucide="qr-code"></i>
    </div>
    <div class="app-header-text">
      <div class="app-badge">◆ 생활편의</div>
      <h1 class="app-title"><span>QR <span>Master</span></span></h1>
      <p class="app-desc">생성부터 스캔까지 한 번에</p>
    </div>
  </div>

  <div class="qr-card">
  <div class="tabs" role="tablist" aria-label="QR 기능">
    <button type="button" class="tab-btn active" role="tab" aria-selected="true" aria-controls="generateTab" onclick="switchTab('generate')" id="tabBtnGenerate">생성하기</button>
    <button type="button" class="tab-btn" role="tab" aria-selected="false" aria-controls="scanTab" tabindex="-1" onclick="switchTab('scan')" id="tabBtnScan">스캔하기</button>
  </div>

  <div class="card-body">

  <div class="tab-panels-wrap">
    <!-- 생성 탭 -->
    <div id="generateTab" class="tab-panel active" role="tabpanel" aria-labelledby="tabBtnGenerate">
      <label for="urlInput" style="display:block;font-size:0.8rem;font-weight:600;color:var(--fg-muted);margin-bottom:0.4rem;">
        변환할 주소 (URL) 또는 텍스트
      </label>
      <input type="text" id="urlInput" class="hero-input" placeholder="https://example.com" onkeypress="if(event.key==='Enter')generateQR()">
      <button onclick="generateQR()" class="hero-btn w-full mt-2">QR 코드 생성</button>

      <div id="genResultArea">
        <div id="qrcode-wrap"><div id="qrcode"></div></div>
        <div id="genResultText"></div>
        <button onclick="downloadQR()" class="hero-btn hero-btn-ghost w-full" style="font-size:0.9rem;">
          ⬇ 이미지 저장
        </button>
        <button id="btnShortenUrl" onclick="shortenGeneratedUrl()" class="hero-btn hero-btn-ghost w-full mt-1" style="font-size:0.9rem;display:none;">
          🔗 단축 URL 생성
        </button>
      </div>
    </div>

    <!-- 스캔 탭 -->
    <div id="scanTab" class="tab-panel" role="tabpanel" aria-labelledby="tabBtnScan">
      <div class="scan-grid">
        <button type="button" class="scan-opt" onclick="startCamera()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M23 7l-7-5-7 5M23 7v10l-7 5-7-5V7"></path><path d="M16 12l-7-5-7 5"></path>
          </svg>
          카메라
        </button>
        <!-- 숨긴 파일 입력은 키보드로 닿지 않으므로 버튼이 대신 연다 -->
        <button type="button" class="scan-opt" onclick="document.getElementById('qrInputFile').click()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="9" cy="9" r="2"></circle>
            <path d="M21 15l-5-5L5 21"></path>
          </svg>
          파일
        </button>
        <input type="file" id="qrInputFile" accept="image/*" class="hidden" style="display:none" tabindex="-1" aria-hidden="true" onchange="handleFileUpload(this)">
        <button type="button" class="scan-opt" onclick="handleClipboardPaste()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          붙여넣기
        </button>
      </div>
      <p class="hint">Ctrl+V로 이미지를 바로 붙여넣을 수 있습니다</p>

      <div id="cameraArea">
        <div id="reader"></div>
        <button type="button" class="camera-close" onclick="stopCamera()" aria-label="카메라 끄기" title="카메라 끄기">✕</button>
      </div>

      <div id="scanResultArea">
        <div class="scan-result-header">
          <span>✓ 스캔 성공!</span>
          <button type="button" class="btn-close-scan" onclick="closeScanResult()" aria-label="스캔 결과 닫기" title="닫기">✕</button>
        </div>
        <div id="scanResultText"></div>
        <div class="scan-actions">
          <button type="button" class="btn-copy-scan" onclick="copyScanResult()">복사</button>
          <a id="scanResultLink" class="btn-open-link" href="#" target="_blank" rel="noopener">↗ 이동</a>
        </div>
      </div>

      <!-- 멀티 스캔 누적 목록 -->
      <div id="multiListArea">
        <div class="history-header">
          <span id="multiListCount" role="status" aria-live="polite"></span>
          <div class="history-header-actions">
            <button type="button" id="btnTitleAll" onclick="fetchAllTitles()" class="btn-title-all" hidden>제목 모두 가져오기</button>
            <button type="button" onclick="clearMultiScans()" class="btn-clear">지우기</button>
          </div>
        </div>
        <ul id="multiScanList" style="list-style:none;padding:0;margin:0;max-height:220px;overflow-y:auto;display:flex;flex-direction:column;gap:0.5rem;"></ul>
        <p class="title-note" id="titleNote" hidden>ℹ️ ‘제목 가져오기’를 누르면 웹페이지 제목을 읽으려고 그 주소를 eduin 서버로 보내요. 누르지 않으면 주소는 이 기기에만 있어요.</p>
        <button onclick="exportMultiMd()" class="hero-btn w-full mt-2" style="font-size:0.9rem;">
          📄 링크 정리 (MD Editor로)
        </button>
      </div>
    </div>

  </div><!-- /.tab-panels-wrap -->

    <!-- 공통 히스토리 -->
    <div class="history-section">
      <div class="history-header">
        <span>히스토리</span>
        <button type="button" class="btn-clear" onclick="clearHistory()">지우기</button>
      </div>
      <ul id="historyList"></ul>
    </div>
  </div>
  </div><!-- /.qr-card -->

</div>

<!-- 토스트·링크 창은 공용 VUI (/common/ui.js) -->


<script is:inline="">
  // ── Service Worker 등록 (PWA) ──
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/apps/qr/sw.js').catch(() => {});
    });
  }

  // ── jsQR 글로벌 상태 ──
  let isCameraRunning = false;
  let videoElement = null;
  let canvasContext = null;
  let scannerAnimationId = null;
  let lastScannedCodes = new Set();
  let scanResultCloseTimer = null;

  // ── 스캔 목록 상태 ──
  let multiScans = [];

  const QR_TAB_KEY = 'qr-last-tab';

  // 스캔한 내용은 외부 데이터 — http(s) 절대 주소일 때만 링크로 연다(javascript: 등 차단)
  function httpUrl(s) {
    try {
      const u = new URL(String(s).trim());
      return (u.protocol === 'http:' || u.protocol === 'https:') ? u.href : '';
    } catch { return ''; }
  }
  function openScanned(text) {
    const u = httpUrl(text);
    if (!u) { showToast('웹 주소(http/https)만 열 수 있어요.'); return; }
    window.open(u, '_blank', 'noopener');
  }
  // 목록 항목 누르기: 웹 주소는 새 창으로 열고, 그 밖의 글자는 복사
  function activateScanned(text) {
    if (httpUrl(text)) openScanned(text);
    else VUI.copy(text, '복사했어요 ✓').then(ok => { if (!ok) showToast('복사하지 못했어요. 글자를 직접 선택해 복사해 주세요.', 'error'); });
  }

  document.addEventListener('DOMContentLoaded', () => {
    loadHistory();
    document.addEventListener('paste', handlePasteEvent);
    let savedTab = null;
    try { savedTab = localStorage.getItem(QR_TAB_KEY); } catch {}
    if (savedTab === 'scan' || savedTab === 'generate') switchTab(savedTab);
  });

  // ── 탭 전환 ──
  function switchTab(tab) {
    ['generate', 'scan'].forEach(k => {
      document.getElementById(k === 'generate' ? 'generateTab' : 'scanTab').classList.toggle('active', k === tab);
      const b = document.getElementById(k === 'generate' ? 'tabBtnGenerate' : 'tabBtnScan');
      b.classList.toggle('active', k === tab);
      b.setAttribute('aria-selected', k === tab ? 'true' : 'false');
      b.tabIndex = k === tab ? 0 : -1;
    });
    if (tab === 'scan') {
      setTimeout(() => startCamera(), 100);
    } else {
      stopCamera();
    }
    try { localStorage.setItem(QR_TAB_KEY, tab); } catch {}
  }

  // 탭 키보드: ←/→로 탭 이동
  document.querySelector('.tabs').addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    e.preventDefault();
    const next = document.getElementById('tabBtnGenerate').classList.contains('active') ? 'scan' : 'generate';
    switchTab(next);
    document.getElementById(next === 'generate' ? 'tabBtnGenerate' : 'tabBtnScan').focus();
  });

  // ── 토스트 (공용 VUI) ──
  function showToast(msg, type) { VUI.toast(msg, type); }

  /* ---- 생성 ---- */
  function generateQR(text) {
    const val = text || document.getElementById('urlInput').value.trim();
    if (!val) return showToast('내용을 입력해주세요.');
    const container = document.getElementById('qrcode');
    container.innerHTML = '';
    new QRCode(container, { text: val, width: 180, height: 180, colorDark: '#000', colorLight: '#fff', correctLevel: QRCode.CorrectLevel.H });
    document.getElementById('genResultText').textContent = val;
    document.getElementById('genResultArea').classList.add('show');
    if (!text) document.getElementById('urlInput').value = val;
    addToHistory(val, 'generate');
    // 단축은 웹 주소(http/https)만 된다
    document.getElementById('btnShortenUrl').style.display = httpUrl(val) ? '' : 'none';
  }

  function downloadQR() {
    const img = document.querySelector('#qrcode img');
    const cvs = document.querySelector('#qrcode canvas');
    const a = document.createElement('a');
    a.download = `qr_${Date.now()}.png`;
    if (img && img.src) a.href = img.src;
    else if (cvs) a.href = cvs.toDataURL('image/png');
    else return;
    a.click();
  }

  /* ---- 스캔 (jsQR) ---- */
  async function startCamera() {
    if (isCameraRunning) return;
    document.getElementById('cameraArea').style.display = 'block';
    document.getElementById('scanResultArea').classList.remove('show');

    if (typeof window.jsQR === 'undefined') {
      showToast('QR 스캔 라이브러리를 로드할 수 없습니다.');
      document.getElementById('cameraArea').style.display = 'none';
      return;
    }

    if (!videoElement) {
      videoElement = document.createElement('video');
      videoElement.id = 'qr-video';
      videoElement.style.cssText = 'width: 100%; height: 100%; object-fit: cover; display: block;';
      document.getElementById('reader').appendChild(videoElement);
    }

    try {
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: 'environment' }
      });
      videoElement.srcObject = stream;
      videoElement.play();
      isCameraRunning = true;
      lastScannedCodes.clear();
      showToast('카메라가 시작되었습니다.');
      startScanLoop();
    } catch (err) {
      showToast('카메라를 시작할 수 없습니다. 권한을 확인해주세요.', 'error');
      document.getElementById('cameraArea').style.display = 'none';
    }
  }

  function stopCamera() {
    if (scannerAnimationId) {
      cancelAnimationFrame(scannerAnimationId);
      scannerAnimationId = null;
    }

    if (videoElement && videoElement.srcObject) {
      videoElement.srcObject.getTracks().forEach(track => track.stop());
    }

    isCameraRunning = false;
    document.getElementById('cameraArea').style.display = 'none';
    if (videoElement && videoElement.parentNode) {
      videoElement.remove();
      videoElement = null;
      canvasContext = null;
    }
  }

  function startScanLoop() {
    scanFrame();
  }

  function scanMultipleQRs(imageData) {
    const results = [];
    const { data, width, height } = imageData;
    const scanned = new Set();

    // 전체 이미지 스캔
    const result = window.jsQR(data, width, height);
    if (result && result.data && !scanned.has(result.data)) {
      results.push({ rawData: result.data });
      scanned.add(result.data);
    }

    // 그리드로 나누어 추가 스캔 (4개 영역) — 홀수 크기 이미지 대비 정수로 내림
    const halfW = Math.floor(width / 2);
    const halfH = Math.floor(height / 2);
    if (halfW < 16 || halfH < 16) return results;

    const regions = [
      { x: 0, y: 0, w: halfW, h: halfH },
      { x: width - halfW, y: 0, w: halfW, h: halfH },
      { x: 0, y: height - halfH, w: halfW, h: halfH },
      { x: width - halfW, y: height - halfH, w: halfW, h: halfH }
    ];

    regions.forEach(region => {
      try {
        const regionData = new Uint8ClampedArray(region.w * region.h * 4);
        for (let y = 0; y < region.h; y++) {
          for (let x = 0; x < region.w; x++) {
            const srcIdx = ((region.y + y) * width + (region.x + x)) * 4;
            const dstIdx = (y * region.w + x) * 4;
            regionData[dstIdx] = data[srcIdx];
            regionData[dstIdx + 1] = data[srcIdx + 1];
            regionData[dstIdx + 2] = data[srcIdx + 2];
            regionData[dstIdx + 3] = data[srcIdx + 3];
          }
        }

        const r = window.jsQR(regionData, region.w, region.h);
        if (r && r.data && !scanned.has(r.data)) {
          results.push({ rawData: r.data });
          scanned.add(r.data);
        }
      } catch {
        // 영역 하나가 실패해도 나머지 결과는 유지
      }
    });

    return results;
  }

  // 카메라 스캔 비용 줄이기: 긴 변 최대 800px로 줄여서, 약 150ms마다(초당 6~7회)만 인식한다.
  // (예전: 매 프레임 전체 해상도로 5회 인식 → 발열·배터리 소모)
  const CAM_SCAN_MAX = 800;
  const CAM_SCAN_INTERVAL = 150;
  let lastCamScanAt = 0;

  function scanFrame(now) {
    if (!isCameraRunning || !videoElement) return;
    scannerAnimationId = requestAnimationFrame(scanFrame);

    const t = typeof now === 'number' ? now : performance.now();
    if (t - lastCamScanAt < CAM_SCAN_INTERVAL) return;
    lastCamScanAt = t;

    const vw = videoElement.videoWidth, vh = videoElement.videoHeight;
    if (!(vw > 0 && vh > 0)) return;

    if (!canvasContext) {
      const canvas = document.createElement('canvas');
      canvasContext = canvas.getContext('2d', { willReadFrequently: true });
    }
    const scale = Math.min(1, CAM_SCAN_MAX / Math.max(vw, vh));
    const dw = Math.max(1, Math.round(vw * scale));
    const dh = Math.max(1, Math.round(vh * scale));
    const cvs = canvasContext.canvas;
    if (cvs.width !== dw || cvs.height !== dh) { cvs.width = dw; cvs.height = dh; }
    canvasContext.drawImage(videoElement, 0, 0, dw, dh);

    const imageData = canvasContext.getImageData(0, 0, dw, dh);
    const results = scanMultipleQRs(imageData);

    if (results && results.length > 0) {
      onScanSuccess(results, 'camera');
    }
  }

  function handleFileUpload(input) {
    if (!input.files.length) return;
    scanImageFile(input.files[0]);
    input.value = '';
  }

  function scanImageFile(file, tool = 'file') {
    stopCamera();

    if (typeof window.jsQR === 'undefined') {
      showToast('QR 스캔 라이브러리를 로드할 수 없습니다.');
      return;
    }

    switchTab('scan');

    const objectUrl = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      URL.revokeObjectURL(objectUrl);
      const results = scanStillImage(img);

      if (results && results.length > 0) {
        onScanSuccess(results, tool);
      } else {
        showToast('QR 코드를 찾을 수 없습니다. QR이 더 크고 선명하게 보이도록 잘라서 시도해 보세요.');
      }
    };

    img.onerror = () => {
      URL.revokeObjectURL(objectUrl);
      showToast('이미지를 불러올 수 없습니다.');
    };
    img.src = objectUrl;
  }

  // 정지 이미지는 해상도가 너무 크거나 작으면 인식률이 떨어지므로 여러 배율로 재시도
  function scanStillImage(img) {
    const w = img.naturalWidth || img.width;
    const h = img.naturalHeight || img.height;
    if (!w || !h) return [];

    const longest = Math.max(w, h);
    // 작은 이미지는 키워야, 큰 이미지는 줄여야 잡히는 경우가 갈리므로 배율을 넓게 시도.
    const targets = [...new Set([
      Math.min(Math.max(longest, 640), 1000),
      Math.min(Math.max(longest, 960), 1800),
      Math.min(longest, 480),
      longest,
    ])].filter(t => t >= 1);

    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d', { willReadFrequently: true });

    for (const target of targets) {
      const scale = target / longest;
      const dw = Math.max(1, Math.round(w * scale));
      const dh = Math.max(1, Math.round(h * scale));
      // QR은 주변 여백(quiet zone)이 없으면 인식되지 않는다. 딱 맞게 잘린 이미지를 위해 항상 덧댄다.
      const pad = Math.max(8, Math.round(target * 0.06));
      canvas.width = dw + pad * 2;
      canvas.height = dh + pad * 2;
      // jsQR은 알파 채널을 무시한다. 투명 배경 PNG(대부분의 다운로드·복사한 QR)를 그대로 두면
      // 배경이 검게 읽혀 전부 실패하므로 흰 배경에 합성한다.
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.imageSmoothingEnabled = scale < 1;
      ctx.drawImage(img, pad, pad, dw, dh);

      try {
        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const results = scanMultipleQRs(imageData);
        if (results.length > 0) return results;
      } catch {
        // 이 배율에서 실패하면 다음 배율로 계속
      }
    }
    return [];
  }

  function handlePasteEvent(e) {
    if (!e.clipboardData) return;

    // 이미지 처리 (모든 탭에서 이미지는 스캔하기로)
    for (const item of e.clipboardData.items) {
      if (item.type.startsWith('image/')) {
        const file = item.getAsFile();
        if (file) {
          e.preventDefault();
          scanImageFile(file, 'clipboard');
          return;
        }
      }
    }

    // 텍스트 처리
    const text = (e.clipboardData.getData('text/plain') || '').trim();
    if (!text || text.length === 0) return;

    // 입력란에 붙여넣는 중이면 브라우저 기본 동작에 맡김
    const t = e.target;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;

    e.preventDefault();

    // 현재 활성 탭 확인
    const isGenerateTabActive = document.getElementById('tabBtnGenerate').classList.contains('active');

    if (isGenerateTabActive) {
      // 생성하기 탭: 텍스트를 입력 필드에 추가
      document.getElementById('urlInput').value = text;
    } else {
      // 스캔하기 탭: 웹 주소(http/https)면 스캔 목록에 추가, 아니면 무시
      const webUrl = httpUrl(text);
      if (!webUrl) return;
      if (!multiScans.some(item => item.url === text)) {
        multiScans.push({ url: text, desc: '', tool: 'clipboard', scannedAt: new Date().toISOString() });
        addToHistory(text, 'clipboard');
        renderMultiList();   // 제목은 자동으로 가져오지 않음(사용자가 '제목 가져오기'를 누를 때만 서버로 보냄)
        document.getElementById('scanResultText').textContent = text;
        const link = document.getElementById('scanResultLink');
        link.href = webUrl;
        link.classList.add('show');
        document.getElementById('scanResultArea').classList.add('show');
        autoCloseScanResult();
        showToast('✓ 링크가 추가되었습니다.');
      } else {
        showToast('이미 추가된 링크입니다.');
      }
    }
  }

  async function handleClipboardPaste() {
    try {
      const items = await navigator.clipboard.read();
      for (const item of items) {
        const t = item.types.find(t => t.startsWith('image/'));
        if (t) { scanImageFile(new File([await item.getType(t)], 'clip.png', { type: t }), 'clipboard'); return; }
      }
      showToast('클립보드에 이미지가 없습니다.');
    } catch {
      showToast('Ctrl+V (또는 Cmd+V)로 이미지를 붙여넣어 주세요.');
    }
  }

  function onScanSuccess(results, tool = 'camera') {
    if (!results || results.length === 0) return;

    // 같은 결과 내에서의 중복 제거
    const seenInFrame = new Set();
    const uniqueResults = results.filter(r => {
      const key = r.rawData;
      if (seenInFrame.has(key)) return false;
      seenInFrame.add(key);
      return true;
    });

    if (uniqueResults.length === 0) return;

    // 모든 감지된 QR을 자동으로 목록에 추가
    let addedCount = 0;
    let lastAddedCode = null;
    let hasNewCode = false;
    uniqueResults.forEach(result => {
      const code = result.rawData;

      // 빈 코드는 추가하지 않음
      if (!code || !code.trim()) return;

      // 목록에서 중복 확인 (새로운 코드인지 확인)
      const isDuplicate = multiScans.some(item => item.url === code);
      if (isDuplicate) return;

      hasNewCode = true;

      // 목록에 추가
      multiScans.push({ url: code, desc: '', tool, scannedAt: new Date().toISOString() });
      addedCount++;
      lastAddedCode = code;

      // URL이면 히스토리에 추가. 제목은 자동으로 가져오지 않는다(주소를 서버로 보내므로 '제목 가져오기'를 누를 때만)
      try {
        new URL(code);
        addToHistory(code, tool);
      } catch {
        // URL이 아닌 데이터는 히스토리에 추가 안 함
      }
    });

    // 스캔 성공 상자 업데이트 (마지막 감지된 QR) — 내용은 textContent, 링크는 http(s)만
    if (lastAddedCode) {
      document.getElementById('scanResultText').textContent = lastAddedCode;

      const link = document.getElementById('scanResultLink');
      const webUrl = httpUrl(lastAddedCode);
      if (webUrl) {
        link.href = webUrl;
        link.classList.add('show');
      } else {
        link.removeAttribute('href');
        link.classList.remove('show');
      }

      document.getElementById('scanResultArea').classList.add('show');
      autoCloseScanResult();
    }

    renderMultiList();
    if (addedCount > 0) {
      showToast(`✓ ${addedCount}개 QR 코드가 추가되었습니다.`);
    }
  }


  function copyScanResult() {
    const text = document.getElementById('scanResultText').textContent;
    VUI.copy(text, '복사했어요 ✓').then(ok => {
      if (!ok) showToast('복사하지 못했어요. 글자를 직접 선택해 복사해 주세요.', 'error');
    });
  }

  function closeScanResult() {
    clearTimeout(scanResultCloseTimer);
    document.getElementById('scanResultArea').classList.remove('show');
  }

  function autoCloseScanResult() {
    clearTimeout(scanResultCloseTimer);
    scanResultCloseTimer = setTimeout(() => {
      document.getElementById('scanResultArea').classList.remove('show');
    }, 5000); // 5초 후 자동 닫기
  }

  /* ---- Short.io 단축 URL ---- */
  async function shortenGeneratedUrl() {
    const text = document.getElementById('genResultText').textContent;
    if (!text) return;
    const btn = document.getElementById('btnShortenUrl');
    btn.disabled = true;
    btn.textContent = '처리 중...';
    try {
      // 단축(실패하면 원래 주소) → 복사. 복사가 안 되면 링크·QR 창
      const short = await VUI.share.shorten(text);
      const ok = short !== text;
      await VUI.share.copyOrShow(short, {
        title: ok ? '🔗 단축 URL' : '🔗 원래 주소',
        copiedMessage: ok ? '단축 URL을 복사했어요 ✓ ' + short : '단축하지 못해서 원래 주소를 복사했어요.',
        note: ok ? '' : '단축하지 못해서 원래 주소를 보여 드려요.',
      });
    } finally {
      btn.disabled = false;
      btn.textContent = '🔗 단축 URL 생성';
    }
  }

  // ── 스캔 목록 ──
  function renderMultiList() {
    const listArea = document.getElementById('multiListArea');
    const ul = document.getElementById('multiScanList');
    if (!multiScans.length) { listArea.style.display = 'none'; return; }
    listArea.style.display = 'block';
    document.getElementById('multiListCount').textContent = multiScans.length + '개 항목';
    ul.innerHTML = '';
    const webItems = multiScans.filter(it => httpUrl(it.url));
    document.getElementById('titleNote').hidden = !webItems.length;
    document.getElementById('btnTitleAll').hidden = !webItems.some(it => !(it.url in pageTitleCache));

    const toolIcons = {
      'camera': '📷',
      'file': '📁',
      'clipboard': '📋',
      'generate': '✏️'
    };

    // 역순으로 (최근 항목이 맨 위). 스캔 내용은 textContent로만 넣는다.
    for (let idx = multiScans.length - 1; idx >= 0; idx--) {
      const item = multiScans[idx];
      const display = item.url.length > 44 ? item.url.slice(0, 44) + '...' : item.url;
      const isWeb = !!httpUrl(item.url);
      const li = document.createElement('li');
      li.className = 'history-item';

      const mainBtn = document.createElement('button');
      mainBtn.type = 'button';
      mainBtn.className = 'history-main';
      mainBtn.title = isWeb ? '새 창에서 열기' : '복사하기';
      mainBtn.addEventListener('click', () => activateScanned(item.url));
      const icon = document.createElement('span');
      icon.className = 'history-icon';
      icon.setAttribute('aria-hidden', 'true');
      icon.textContent = toolIcons[item.tool] || '📷';
      const textWrap = document.createElement('span');
      textWrap.className = 'history-text';
      const main = document.createElement('span');
      main.className = 'main';
      main.textContent = display;
      textWrap.appendChild(main);
      // 가져온 제목(외부 데이터 — textContent)
      const title = pageTitleCache[item.url];
      if (title) {
        const sub = document.createElement('span');
        sub.className = 'sub';
        sub.textContent = title;
        textWrap.appendChild(sub);
      }
      mainBtn.append(icon, textWrap);
      li.appendChild(mainBtn);

      // 제목 가져오기: 사용자가 누를 때만 주소를 서버로 보낸다
      if (isWeb && !(item.url in pageTitleCache)) {
        const tBtn = document.createElement('button');
        tBtn.type = 'button';
        tBtn.className = 'title-btn';
        tBtn.textContent = '제목 가져오기';
        tBtn.setAttribute('aria-label', '제목 가져오기: ' + display);
        tBtn.addEventListener('click', async () => {
          tBtn.disabled = true;
          tBtn.textContent = '가져오는 중…';
          const t = await fetchPageTitle(item.url);
          if (t === undefined) { tBtn.disabled = false; tBtn.textContent = '제목 가져오기'; return; }
          if (!t) showToast('이 주소에서 제목을 찾지 못했어요.');
          renderMultiList();
        });
        li.appendChild(tBtn);
      }

      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'history-del';
      del.textContent = '✕';
      del.title = '목록에서 지우기';
      del.setAttribute('aria-label', '목록에서 지우기: ' + display);
      del.addEventListener('click', () => deleteMultiScan(idx));
      li.appendChild(del);
      ul.appendChild(li);
    }
  }

  function deleteMultiScan(idx) {
    multiScans.splice(idx, 1);
    renderMultiList();
    // 누른 버튼이 사라졌으니 목록의 첫 버튼(없으면 스캔 탭 버튼)으로 포커스
    const next = document.querySelector('#multiScanList button') || document.getElementById('tabBtnScan');
    if (next) next.focus();
  }

  function clearMultiScans() {
    if (!confirm('멀티 스캔 목록을 모두 삭제하시겠습니까?')) return;
    multiScans = [];
    lastScannedCodes.clear();
    document.getElementById('scanResultArea').classList.remove('show');
    renderMultiList();
  }

  // ── 페이지 제목 (URL → title|null) ──
  // 사용자가 '제목 가져오기'를 눌렀을 때만 서버(/api/get-page-title)로 주소를 보낸다(개인정보 — 점검 8.3).
  // 반환: 제목 문자열 / null(제목 없음) / undefined(요청 실패 — 캐시하지 않아 다시 시도 가능)
  const pageTitleCache = Object.create(null);

  async function fetchPageTitle(url) {
    if (url in pageTitleCache) return pageTitleCache[url];
    try {
      const d = await VUI.apiFetch('/api/get-page-title', { json: { url }, timeout: 15000 });
      pageTitleCache[url] = (d && typeof d.title === 'string' && d.title.trim()) ? d.title.trim().slice(0, 200) : null;
      return pageTitleCache[url];
    } catch (err) {
      showToast(err.message || '제목을 가져오지 못했어요.', 'error');
      return undefined;
    }
  }

  // 목록의 웹 주소 제목을 한꺼번에(차례로) 가져오기
  async function fetchAllTitles() {
    const btn = document.getElementById('btnTitleAll');
    const urls = [...new Set(multiScans.map(it => it.url))].filter(u => httpUrl(u) && !(u in pageTitleCache));
    if (!urls.length) return;
    btn.disabled = true;
    btn.textContent = '가져오는 중…';
    let fail = 0;
    for (const u of urls) {
      const t = await fetchPageTitle(u);
      if (t === undefined) { fail++; break; }   // 한도·연결 오류면 멈춤(토스트는 fetchPageTitle이 띄움)
    }
    btn.disabled = false;
    btn.textContent = '제목 모두 가져오기';
    renderMultiList();
    if (!fail) showToast('제목을 가져왔어요 ✓');
  }

  function exportMultiMd() {
    if (!multiScans.length) return;
    const today = new Date().toISOString().slice(0, 10);
    let md = `# QR 스캔 결과\n> ${today} · ${multiScans.length}개 항목\n\n`;
    multiScans.forEach((item, idx) => {
      const title = pageTitleCache[item.url];
      const linkText = item.desc || title || (item.url.length > 40 ? item.url.slice(0, 40) + '...' : item.url);
      const webUrl = httpUrl(item.url);
      md += webUrl ? `${idx + 1}. [${linkText}](<${webUrl}>)\n` : `${idx + 1}. ${item.url}\n`;
    });

    // md-editor 공유 형식({data, permission}) — UTF-8 base64url(VUI.share.encode)
    const encoded = VUI.share.encode({ data: { content: md, filename: `qr-scan-${today}.md` }, permission: 'clone' });
    location.href = `/apps/md-editor/#share=${encoded}`;
  }

  /* ---- 히스토리 ---- */
  function readHistory() {
    try {
      const h = JSON.parse(localStorage.getItem('qr_history') || '[]');
      return Array.isArray(h) ? h.filter(i => i && typeof i.text === 'string') : [];
    } catch { return []; }
  }
  function writeHistory(h) {
    try { localStorage.setItem('qr_history', JSON.stringify(h)); } catch {}
  }

  function addToHistory(text, tool) {
    let h = readHistory();
    h = h.filter(i => i.text !== text);
    h.unshift({ text, tool, date: new Date().toLocaleDateString() });
    if (h.length > 30) h.pop();
    writeHistory(h);
    renderHistory(h);
  }

  function loadHistory() { renderHistory(readHistory()); }

  function renderHistory(h) {
    const getToolInfo = (tool) => {
      const toolMap = {
        'camera': { icon: '📷', label: '카메라' },
        'file': { icon: '📁', label: '파일' },
        'clipboard': { icon: '📋', label: '붙여넣기' },
        'generate': { icon: '✏️', label: '생성하기' }
      };
      return toolMap[tool] || { icon: '❓', label: String(tool || '') };
    };

    const list = document.getElementById('historyList');
    list.innerHTML = '';
    if (!h.length) {
      list.innerHTML = '<li class="history-empty">기록이 없습니다.</li>';
      return;
    }
    h.forEach(item => {
      const li = document.createElement('li');
      li.className = 'history-item';
      const mainBtn = document.createElement('button');
      mainBtn.type = 'button';
      mainBtn.className = 'history-main';
      // tool에 따라 다른 동작
      if (item.tool === 'generate') {
        mainBtn.title = 'QR 다시 만들기';
        mainBtn.addEventListener('click', () => { switchTab('generate'); generateQR(item.text); });
      } else {
        // camera, file, clipboard: 웹 주소(http/https)는 새 창, 그 밖은 복사
        mainBtn.title = httpUrl(item.text) ? '새 창에서 열기' : '복사하기';
        mainBtn.addEventListener('click', () => activateScanned(item.text));
      }
      const toolInfo = getToolInfo(item.tool);

      // 스캔 내용은 외부 데이터 — innerHTML 대신 textContent
      const icon = document.createElement('span');
      icon.className = 'history-icon';
      icon.setAttribute('aria-hidden', 'true');
      icon.textContent = toolInfo.icon;
      const textWrap = document.createElement('span');
      textWrap.className = 'history-text';
      const main = document.createElement('span');
      main.className = 'main';
      main.textContent = item.text;
      const sub = document.createElement('span');
      sub.className = 'sub';
      sub.textContent = `${toolInfo.label} · ${item.date || ''}`;
      textWrap.append(main, sub);
      mainBtn.append(icon, textWrap);
      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'history-del';
      del.textContent = '✕';
      del.title = '기록 지우기';
      del.setAttribute('aria-label', '기록 지우기: ' + item.text.slice(0, 60));
      del.addEventListener('click', () => deleteHistoryItem(item.text));

      li.append(mainBtn, del);
      list.appendChild(li);
    });
  }

  function deleteHistoryItem(text) {
    const h = readHistory().filter(i => i.text !== text);
    writeHistory(h);
    renderHistory(h);
    const next = document.querySelector('#historyList button');
    if (next) next.focus();
  }

  function clearHistory() {
    if (confirm('기록을 모두 삭제하시겠습니까?')) {
      try { localStorage.removeItem('qr_history'); } catch {}
      renderHistory([]);
    }
  }
</script>



</AppLayout>
