  </Fragment>



<!-- ============ 인트로 스크린 ============ -->
<div id="screenIntro" class="screen active intro-screen">
  <div class="intro-emoji" aria-hidden="true">🌗</div>
  <h1>달의 위상 3D</h1>
  <p class="intro-sub">달의 궤도 공전 시뮬레이션 · 일식과 월식 탐구</p>

  <div class="intro-card">
    <h3>달을 손으로 돌리며 탐험해요!</h3>
    <p>달이 지구 주위를 공전할 때, 태양-지구-달의 각도에 따라 지구에서 보는 달의 모양(위상)이 어떻게 변하는지 3D 궤도 공전 모델로 직접 확인해 봐요!</p>
  </div>

  <button type="button" class="fb-btn fb-btn-primary" id="btnStart">시뮬레이터 들어가기</button>
</div>

<!-- ============ 메인 실험실 스크린 ============ -->
<div id="screenExplore" class="screen explore-screen">
  <div class="explore-layout">
    <!-- 좌측 공전 궤도 영역 -->
    <div class="canvas-zone" id="canvasZone">
      <div class="canvas-header">
        <div class="canvas-title-badge">
          <span class="num" id="canvasBadgeNum">1</span>
          <span id="canvasBadgeLabel">달의 공전과 위상</span>
        </div>
        <div class="orbit-legend"><span aria-hidden="true">↺ </span>북쪽에서 본 모습 · 달은 시계 반대 방향으로 돌아요</div>
      </div>

      <div class="canvas-viewport" id="canvasViewport">
        <!-- 3D 궤도 드래그 캔버스 -->
        <canvas id="orbitCanvas" role="img" aria-label="북쪽(북극 위)에서 내려다본 지구와 달의 공전 궤도. 달은 시계 반대 방향으로 돌아요. 달을 끌어서 옮기거나 오른쪽 '달의 공전 조절' 슬라이더로 조절해요."></canvas>
      </div>

      <!-- 하단 툴바 -->
      <div class="canvas-toolbar" role="group" aria-label="궤도 도구">
        <button type="button" class="tool-btn" id="btnPlayAuto" aria-pressed="false">▶️ 자동 공전</button>
        <button type="button" class="tool-btn" id="btnTiltToggle" aria-pressed="true">📐 궤도 기울기 (5°)</button>
        <button type="button" class="tool-btn" id="btnResetView">🔄 시점 초기화</button>
      </div>
    </div>

    <!-- 우측 제어 사이드바 -->
    <div class="sidebar" id="sidebar">
      <div class="side-head">
        <h2>🌗 달의 위상 3D</h2>
        <div class="side-sub">초등 과학 6학년 「지구와 달의 운동」</div>
      </div>

      <div class="side-body">
        <!-- 모드 탭 -->
        <div class="mode-tabs" id="modeTabs" role="group" aria-label="모드 고르기">
          <button type="button" class="mode-tab active" data-mode="1">
            <span class="em" aria-hidden="true">🌏</span>자유 관찰
          </button>
          <button type="button" class="mode-tab" data-mode="2">
            <span class="em" aria-hidden="true">🏆</span>도전 미션
          </button>
          <button type="button" class="mode-tab" data-mode="3">
            <span class="em" aria-hidden="true">🌌</span>일식·월식
          </button>
        </div>

        <!-- 지구 관측 뷰 (달 모양 렌더링) -->
        <div class="observation-view">
          <canvas id="moonPhaseCanvas" role="img" aria-label="지구에서 본 달 모양: 보름달"></canvas>
          <div class="moon-phase-name" id="moonPhaseName">보름달</div>
          <div class="moon-phase-date" id="moonPhaseDate">음력 15일 경 (망)</div>
        </div>

        <!-- 미션 카드 (모드 2 전용) -->
        <div class="mission-card" id="missionCard" style="display:none;">
          <h3 class="mission-title" id="missionTitle">달의 위상 미션</h3>
          <div class="mission-desc" id="missionDesc">미션 내용을 불러오고 있습니다.</div>
          <div class="mission-nav" id="missionNav"></div>
          <div class="mission-nav" id="eclipseNav" role="group" aria-label="일식·월식 위치" hidden>
            <button type="button" class="fb-btn fb-btn-primary eclipse-btn" data-eclipse="solar">🌞 일식 위치로</button>
            <button type="button" class="fb-btn fb-btn-primary eclipse-btn" data-eclipse="lunar" style="background:#b22222; color:#fff;">🌘 월식 위치로</button>
          </div>
        </div>

        <!-- 상세 관측 정보 패널 -->
        <div class="info-box" id="infoBox">
          <div class="info-row">
            <span class="info-label">남중 시각:</span>
            <span class="info-val" id="infoNoon">밤 12시 (자정)</span>
          </div>
          <div class="info-row">
            <span class="info-label">관측 방향:</span>
            <span class="info-val" id="infoDir">밤새도록 (동 ➔ 남 ➔ 서)</span>
          </div>
          <div class="info-row">
            <span class="info-label">관측 팁:</span>
            <span class="info-val info-tip" id="infoTip">동쪽에서 떠서 남쪽을 지나 서쪽으로 지며 밤새 관찰됩니다.</span>
          </div>
        </div>

        <!-- 접근성 보조 슬라이더 -->
        <div class="slider-control" id="sliderControl">
          <div class="slider-label">
            <label for="moonSlider">달의 공전 조절</label>
            <span id="sliderVal" aria-hidden="true">0°</span>
          </div>
          <input type="range" class="slider-input" id="moonSlider" min="0" max="360" value="0" aria-valuetext="0°, 보름달">
        </div>

        <!-- 피드백 박스 -->
        <div class="feedback-box" id="feedbackBox" role="status" aria-live="polite" style="display:none;"></div>

        <!-- 하단 액션 패널 -->
        <div class="action-panel">
          <button type="button" class="action-btn" id="btnVerify" style="display:none;">🏆 정답 확인</button>
          <button type="button" class="action-btn secondary" id="btnNextScreen" style="display:none;">탐험 완료 →</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ============ 결과 화면 ============ -->
<div id="screenResult" class="screen result-screen">
  <div style="font-size:72px;" aria-hidden="true">🏆</div>
  <h2 style="margin:8px 0; font-size:28px;">달 탐사 완료!</h2>
  <div class="result-stars" id="resultStars"></div>
  <div class="result-summary" id="resultSummary"></div>
  <div class="result-actions">
    <button type="button" class="fb-btn fb-btn-primary" id="btnRetry">다시 시작</button>
    <button type="button" class="fb-btn fb-btn-primary" style="background:var(--mp-card); color:#fff; border:1px solid var(--mp-border);" id="btnBackToHub">자유 관찰로</button>
  </div>
</div>

<script is:inline="">
/* ================================================================
   달의 위상 3D — moon-phase-v2
   ================================================================ */
(function() {
'use strict';

/* ── 달의 위상 데이터 8단계 정의 ── */
const MOON_PHASES = [
  { name: '보름달 (망)', date: '음력 15일 경', noon: '밤 12시 (자정)', dir: '밤새도록 (동 ➔ 남 ➔ 서)', angle: 0, tip: '저녁 동쪽에서 떠서 남쪽을 지나 아침에 서쪽으로 져요.' },
  { name: '기우는 달 (Waning Gibbous)', date: '음력 18~19일 경', noon: '새벽 3시', dir: '밤늦게~새벽 남쪽 하늘', angle: Math.PI / 4, tip: '밤늦게 동쪽에서 떠서 새벽에 남쪽 하늘 높이 보여요. 왼쪽이 더 많이 밝아요.' },
  { name: '하현달 (Third Quarter)', date: '음력 22~23일 경', noon: '아침 6시', dir: '새벽(해 뜰 무렵) 남쪽 하늘', angle: Math.PI / 2, tip: '자정에 동쪽에서 떠서 아침에 남쪽 하늘에서 왼쪽 반이 밝게 보여요.' },
  { name: '그믐달 (Waning Crescent)', date: '음력 26~27일 경', noon: '오전 9시', dir: '새벽 동쪽 하늘', angle: Math.PI * 0.75, tip: '새벽녘 동쪽 하늘 끝에서 가느다랗게 보이다가 금방 해가 떠요.' },
  { name: '그믐/삭 (New Moon)', date: '음력 29~30일 경', noon: '낮 12시', dir: '관측 불가 (태양과 같이 뜸)', angle: Math.PI, tip: '달이 태양과 같은 방향에 있어서 보이지 않아요.' },
  { name: '초승달 (Waxing Crescent)', date: '음력 2~3일 경', noon: '오후 3시', dir: '초저녁 서쪽 하늘', angle: Math.PI * 1.25, tip: '해 질 무렵 서쪽 하늘 낮게 떴다가 바로 서쪽으로 져요.' },
  { name: '상현달 (First Quarter)', date: '음력 7~8일 경', noon: '오후 6시', dir: '초저녁 남쪽 하늘', angle: Math.PI * 1.5, tip: '낮에 떠서 초저녁 남쪽 하늘에 오른쪽 반이 밝은 모습으로 보여요.' },
  { name: '차오르는 달 (Waxing Gibbous)', date: '음력 11~12일 경', noon: '밤 9시', dir: '밤 남동쪽 하늘', angle: Math.PI * 1.75, tip: '남동쪽 하늘에서 거의 둥글어진 밝은 달을 감상할 수 있습니다.' }
];

function getPhaseInfo(angle) {
  // angle을 [0, 2pi] 범위로 클램프
  let a = (angle % (Math.PI * 2) + Math.PI * 2) % (Math.PI * 2);
  
  // 가장 가까운 정의 단계 검색
  let best = MOON_PHASES[0];
  let minDiff = Infinity;
  MOON_PHASES.forEach(p => {
    let diff = Math.abs(a - p.angle);
    if (diff > Math.PI) diff = Math.PI * 2 - diff;
    if (diff < minDiff) {
      minDiff = diff;
      best = p;
    }
  });
  return best;
}

// 두 각도 사이의 가장 짧은 차이(0 ~ π). 0°와 359°도 가깝게 계산한다.
function angDist(a, b) {
  const TWO_PI = Math.PI * 2;
  let d = Math.abs((((a - b) % TWO_PI) + TWO_PI) % TWO_PI);
  if (d > Math.PI) d = TWO_PI - d;
  return d;
}

/* ── 도전 미션 ── */
const MISSIONS = [
  {
    id: 'm1',
    desc: '달을 공전 궤도에서 드래그하여 <strong>보름달 (음력 15일 경)</strong>이 뜨는 위치로 맞춘 뒤 <strong>[정답 확인]</strong>을 눌러 보세요.',
    targetAngle: 0,
    verify: (angle) => angDist(angle, 0) < 0.25 // 15도 내외 오차 허용
  },
  {
    id: 'm2',
    desc: '초저녁 남쪽 하늘에 오른쪽 반이 밝게 뜨는 <strong>상현달 (음력 7~8일 경)</strong> 위치로 달을 움직인 뒤 <strong>[정답 확인]</strong>을 눌러 보세요.',
    targetAngle: Math.PI * 1.5,
    verify: (angle) => angDist(angle, Math.PI * 1.5) < 0.25
  },
  {
    id: 'm3',
    desc: '아침 남쪽 하늘에 왼쪽 반이 밝게 보이는 <strong>하현달 (음력 22~23일 경)</strong> 위치로 달을 맞춘 뒤 <strong>[정답 확인]</strong>을 눌러 보세요.',
    targetAngle: Math.PI * 0.5,
    verify: (angle) => angDist(angle, Math.PI * 0.5) < 0.25
  }
];

/* ── 저장 (미션 완료 기록만, 키·모양 그대로: { missionsCompleted }) ── */
const STORAGE_KEY = 'moon-phase-v2:v1';
const MISSION_IDS = MISSIONS.map(m => m.id);
const store = SimKit.store(STORAGE_KEY, {
  defaults: { missionsCompleted: { m1: false, m2: false, m3: false } },
  validate: (raw) => (raw && typeof raw === 'object'
    ? { missionsCompleted: SimKit.clean.flags(raw.missionsCompleted, MISSION_IDS) }
    : null)
});
function saveState() {
  store.save({ missionsCompleted: state.missionsCompleted });
}
function loadState() {
  state.missionsCompleted = store.load().missionsCompleted;
}

/* ── 공유 링크 읽기 (#share=… 새 형식·예전 URI-JSON 모두) ── */
function parseShareLink() {
  const payload = SimKit.share.read({ version: 1 });
  const a = Number(payload && payload.phaseAngle);
  if (payload && isFinite(a)) {
    state.phaseAngle = ((a % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);
  }
}

/* ── 피드백 상자 (SimKit: role=status, aria-live) ── */
const fb = SimKit.feedback('#feedbackBox', { classes: { ok: 'ok', no: 'no' } });
function showFeedback(msg, type) { fb.show(type === 'ok' ? 'ok' : 'no', msg); }
function hideFeedback() { fb.hide(); }

const screens = SimKit.screens({ focus: true });
let modeTabs = null;
let mc = null;

function syncSlider() {
  const deg = Math.round(state.phaseAngle * 180 / Math.PI) % 360;
  $('#moonSlider').value = deg;
  $('#sliderVal').textContent = `${deg}°`;
  $('#moonSlider').setAttribute('aria-valuetext', `${deg}°, ${getPhaseInfo(state.phaseAngle).name}`);
}

/* ── 앱 상태 ── */
let state = {
  mode: 1, // 1: 자유, 2: 미션, 3: 일식/월식
  missionIdx: 0,
  missionsCompleted: { m1: false, m2: false, m3: false },
  
  phaseAngle: 0, // 0 to 2pi (0 = Full Moon, pi = New Moon)
  autoPlay: false,
  tiltOrbit: true, // 궤도 경사 5도 토글
  
  // 일식/월식 연출 상태
  eclipseType: null, // 'solar', 'lunar', null
  eclipseProgress: 0, // 0 to 1
  
  isDraggingMoon: false
};

const $ = s => document.querySelector(s);
const $$ = s => document.querySelectorAll(s);

/* ══════════════════════════════════════
   Canvas 렌더러 (궤도 3D & 위상)
   ══════════════════════════════════════ */
let orbitCtx, phaseCtx;
let orbitCanvas, phaseCanvas;

function initCanvas() {
  orbitCanvas = $('#orbitCanvas');
  phaseCanvas = $('#moonPhaseCanvas');
  orbitCtx = orbitCanvas.getContext('2d');
  phaseCtx = phaseCanvas.getContext('2d');

  // 위상 캔버스 High DPI 처리 및 크기 고정 (140x140)
  phaseCanvas.width = 140 * window.devicePixelRatio;
  phaseCanvas.height = 140 * window.devicePixelRatio;
  phaseCtx.scale(window.devicePixelRatio, window.devicePixelRatio);

  resizeOrbitCanvas();
  window.addEventListener('resize', resizeOrbitCanvas);

  // 드래그 궤도 조작 등록
  setupDragInteraction();
}

function resizeOrbitCanvas() {
  const rect = orbitCanvas.parentNode.getBoundingClientRect();
  const dpr = window.devicePixelRatio || 1;
  orbitCanvas.width = Math.round(rect.width * dpr);
  orbitCanvas.height = Math.round(rect.height * dpr);
  orbitCanvas.style.width = rect.width + 'px';
  orbitCanvas.style.height = rect.height + 'px';
  orbitCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
  requestRedraw();
}

// 화면 배율: 작은 화면(폰)에서는 궤도를 줄이고, 큰 화면에서는 최대 1.9배까지 키운다
function getScale(cw, ch) {
  return Math.max(0.45, Math.min(cw / 620, ch / 440, 1.9));
}

/* 궤도 그림은 교과서처럼 북쪽(북극 위)에서 내려다본 모습이다. 태양은 화면 왼쪽.
   phaseAngle(θ): 0 = 보름달(태양 반대편, 오른쪽), π = 삭(태양 쪽, 왼쪽). θ가 늘수록 시간이 흐른다.
   북쪽에서 보면 달은 시계 반대 방향으로 돌므로, θ가 늘 때 화면에서 오른쪽 → 위 → 왼쪽 → 아래로 간다.
   그래서 화면 y(아래로 +)는 cy − rY·sinθ. 위(θ=π/2) = 하현달, 아래(θ=3π/2) = 상현달.
   (위상 이름·달 모양·미션 정답은 θ로만 정해지므로 그대로 맞는다) */
function moonScreenPos(cx, cy, k, angle) {
  const rX = 220 * k;
  const rY = (90 + (state.tiltOrbit ? 24 : 0)) * k; // 5° 경사 연출 시 세로로 조금 더 벌어짐
  return { x: cx + rX * Math.cos(angle), y: cy - rY * Math.sin(angle) };
}
// 화면 위치 → θ (moonScreenPos의 역함수)
function screenToAngle(dx, dy) {
  const ratio = 220 / (state.tiltOrbit ? 114 : 90);
  const a = Math.atan2(-dy * ratio, dx);
  return (a + Math.PI * 2) % (Math.PI * 2);
}

/* ── 그리기 예약 (P8: 상태가 바뀔 때만 그린다. 자동 공전 중에만 매 프레임) ── */
let rafId = 0;
function requestRedraw() {
  if (rafId) return;
  rafId = requestAnimationFrame(drawLoop);
}

// 궤도 드래그 설정
function setupDragInteraction() {
  function getEventPos(e) {
    const rect = orbitCanvas.getBoundingClientRect();
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    return {
      x: clientX - rect.left,
      y: clientY - rect.top
    };
  }

  function handleStart(e) {
    const pos = getEventPos(e);
    const center = { x: orbitCanvas.width / (2 * window.devicePixelRatio), y: orbitCanvas.height / (2 * window.devicePixelRatio) };
    
    // 달의 현재 위치 계산 (drawLoop과 동일한 화면 배율 적용)
    const cw = orbitCanvas.width / window.devicePixelRatio;
    const ch = orbitCanvas.height / window.devicePixelRatio;
    const k = getScale(cw, ch);
    const mp = moonScreenPos(center.x, center.y, k, state.phaseAngle); // drawLoop과 같은 위치
    const moonX = mp.x;
    const moonY = mp.y;

    // 클릭 거리가 달 반경 언저리면 드래그 시작 (손가락 터치를 위해 최소 30px)
    const dist = Math.hypot(pos.x - moonX, pos.y - moonY);
    if (dist < Math.max(30, 38 * k)) {
      state.isDraggingMoon = true;
      state.autoPlay = false;
      updatePlayButtonState();
      requestRedraw();
      e.preventDefault();
    }
  }

  function handleMove(e) {
    if (!state.isDraggingMoon) return;
    if (e.cancelable) e.preventDefault(); // 드래그 중 화면 스크롤 방지
    const pos = getEventPos(e);
    const center = { x: orbitCanvas.width / (2 * window.devicePixelRatio), y: orbitCanvas.height / (2 * window.devicePixelRatio) };

    // 마우스의 각도를 계산하여 phaseAngle로 매핑 (타원 세로 보정 + 북쪽에서 본 시계 반대 방향)
    state.phaseAngle = screenToAngle(pos.x - center.x, pos.y - center.y);

    // 슬라이더 동기화
    syncSlider();

    updateUI();
  }

  function handleEnd() {
    if (!state.isDraggingMoon) return;
    state.isDraggingMoon = false;
    requestRedraw();
  }

  orbitCanvas.addEventListener('mousedown', handleStart);
  window.addEventListener('mousemove', handleMove);
  window.addEventListener('mouseup', handleEnd);

  orbitCanvas.addEventListener('touchstart', handleStart, { passive: false });
  window.addEventListener('touchmove', handleMove, { passive: false });
  window.addEventListener('touchend', handleEnd);
}

// 그리기: 상태가 바뀌면 requestRedraw()로 한 번, 자동 공전 중에는 매 프레임
function drawLoop() {
  rafId = 0;
  if (state.autoPlay) {
    state.phaseAngle = (state.phaseAngle + 0.008) % (Math.PI * 2);
    syncSlider();
    updateUI(); // updateUI가 다음 프레임을 예약한다
  }

  // 1. 궤도 캔버스 클리어
  const w = orbitCanvas.width / window.devicePixelRatio;
  const h = orbitCanvas.height / window.devicePixelRatio;
  orbitCtx.clearRect(0, 0, w, h);

  // 시각화 센터 (캔버스 크기에 비례해 궤도 확대·축소)
  const cx = w / 2;
  const cy = h / 2;
  const k = getScale(w, h); // 화면 배율
  const rX = 220 * k;
  const rY = 90 * k;

  // 2. 태양빛 표현 — 왼쪽 화면 밖 태양에서 퍼지는 방사형 광원 + 광선 화살표
  const sunX = -w * 0.18; // 화면 왼쪽 바깥의 가상 태양 위치
  const radGrad = orbitCtx.createRadialGradient(sunX, cy, 0, sunX, cy, cx + w * 0.2);
  radGrad.addColorStop(0, 'rgba(255, 209, 102, 0.28)');
  radGrad.addColorStop(0.55, 'rgba(255, 209, 102, 0.08)');
  radGrad.addColorStop(1, 'rgba(255, 209, 102, 0)');
  orbitCtx.fillStyle = radGrad;
  orbitCtx.fillRect(0, 0, w, h);

  // 광선 화살표 3줄 (태양 → 오른쪽, 지구·달을 향해)
  const rayEndX = cx - rX - 40 * k;
  orbitCtx.strokeStyle = 'rgba(255, 209, 102, 0.55)';
  orbitCtx.fillStyle = 'rgba(255, 209, 102, 0.55)';
  orbitCtx.lineWidth = 2.5;
  [-1, 0, 1].forEach(i => {
    const ry = cy + i * 70 * k;
    orbitCtx.beginPath();
    orbitCtx.moveTo(16, ry);
    orbitCtx.lineTo(rayEndX, ry);
    orbitCtx.stroke();
    // 화살촉
    orbitCtx.beginPath();
    orbitCtx.moveTo(rayEndX + 10, ry);
    orbitCtx.lineTo(rayEndX - 4, ry - 6);
    orbitCtx.lineTo(rayEndX - 4, ry + 6);
    orbitCtx.closePath();
    orbitCtx.fill();
  });

  // 태양 이정표 표시
  orbitCtx.font = `bold ${Math.round(12 * k)}px sans-serif`;
  orbitCtx.fillStyle = '#ffd166';
  orbitCtx.textAlign = 'left';
  orbitCtx.fillText('☀️ 햇빛 방향', 20, cy - 70 * k - 12);

  // 3. 지구 그림자 뿔 표현 (태양 반대편인 오른쪽으로 길게 뻗는 어두운 암영대)
  if (state.mode === 3 && state.eclipseType === 'lunar') {
    orbitCtx.beginPath();
    orbitCtx.moveTo(cx, cy - 25 * k);
    orbitCtx.lineTo(cx + w, cy - 35 * k);
    orbitCtx.lineTo(cx + w, cy + 35 * k);
    orbitCtx.lineTo(cx, cy + 25 * k);
    orbitCtx.fillStyle = 'rgba(231,76,60,0.18)'; // 월식 지구 그림자 강조
    orbitCtx.fill();
  } else {
    const shadowGrad = orbitCtx.createLinearGradient(cx, cy, cx + rX + 60 * k, cy);
    shadowGrad.addColorStop(0, 'rgba(11, 15, 36, 0.45)');
    shadowGrad.addColorStop(1, 'rgba(11, 15, 36, 0)');
    orbitCtx.fillStyle = shadowGrad;
    orbitCtx.fillRect(cx, cy - 25 * k, rX + 60 * k, 50 * k);
  }

  // 4. 공전 궤도선 (3D 타원 표현)
  orbitCtx.beginPath();
  orbitCtx.ellipse(cx, cy, rX, rY, 0, 0, Math.PI * 2);
  orbitCtx.strokeStyle = 'rgba(255,255,255,0.15)'; // 캔버스는 CSS 변수를 못 읽음 (--mp-orbit 값)
  orbitCtx.lineWidth = 3;
  orbitCtx.stroke();

  // 공전 방향 화살표(시계 반대 방향): 궤도 오른쪽 위·왼쪽 아래에 하나씩
  [Math.PI * 0.3, Math.PI * 1.3].forEach(a => {
    const p = { x: cx + rX * Math.cos(a), y: cy - rY * Math.sin(a) };
    // 접선 방향(θ가 늘어나는 쪽): d/dθ (rX cosθ, −rY sinθ) = (−rX sinθ, −rY cosθ)
    const tx = -rX * Math.sin(a), ty = -rY * Math.cos(a);
    const len = Math.hypot(tx, ty) || 1;
    const ux = tx / len, uy = ty / len;
    const s = 9 * k;
    orbitCtx.beginPath();
    orbitCtx.moveTo(p.x + ux * s, p.y + uy * s);
    orbitCtx.lineTo(p.x - ux * s - uy * s * 0.7, p.y - uy * s + ux * s * 0.7);
    orbitCtx.lineTo(p.x - ux * s + uy * s * 0.7, p.y - uy * s - ux * s * 0.7);
    orbitCtx.closePath();
    orbitCtx.fillStyle = 'rgba(255,255,255,0.55)';
    orbitCtx.fill();
  });

  // 5. 중앙 지구 🌍 그리기 (자전 회전 연출)
  orbitCtx.beginPath();
  orbitCtx.arc(cx, cy, 32 * k, 0, Math.PI * 2);
  orbitCtx.fillStyle = '#1e3d59';
  orbitCtx.fill();
  orbitCtx.strokeStyle = '#3a86c8';
  orbitCtx.lineWidth = 2;
  orbitCtx.stroke();

  // 지구 반구 명암 (왼쪽 햇빛 영역은 밝고, 오른쪽 반구는 그늘)
  orbitCtx.beginPath();
  orbitCtx.arc(cx, cy, 32 * k, -Math.PI/2, Math.PI/2);
  orbitCtx.fillStyle = 'rgba(0,0,0,0.5)';
  orbitCtx.fill();

  // 지구 자전 방향 및 아시아대륙 간이 표시
  orbitCtx.fillStyle = '#fff';
  orbitCtx.font = '11px sans-serif';
  orbitCtx.textAlign = 'center';
  orbitCtx.fillText('🌏 지구', cx, cy + 4);

  // 6. 궤도 위 달 🌑 그리기 (햇빛 방향에 맞게 항상 왼쪽 반구만 빛남)
  //    궤도 경사 연출 시 세로 위치가 조금 더 벌어진다(moonScreenPos)
  const mpos = moonScreenPos(cx, cy, k, state.phaseAngle);
  const mx = mpos.x;
  const my = mpos.y;

  // 달 그림자 영역
  orbitCtx.beginPath();
  orbitCtx.arc(mx, my, 13 * k, 0, Math.PI * 2);
  orbitCtx.fillStyle = '#222533';
  orbitCtx.fill();

  // 달 햇빛 반사 반구 (항상 왼쪽 방향이 밝음)
  orbitCtx.beginPath();
  orbitCtx.arc(mx, my, 13 * k, Math.PI / 2, Math.PI * 1.5);
  orbitCtx.fillStyle = '#ffd166';
  orbitCtx.fill();

  // 드래그 링 외곽 원형 가이드
  orbitCtx.beginPath();
  orbitCtx.arc(mx, my, 22 * k, 0, Math.PI * 2);
  orbitCtx.strokeStyle = state.isDraggingMoon ? '#ffd166' : 'rgba(255,255,255,0.2)';
  orbitCtx.lineWidth = 1.5;
  orbitCtx.stroke();

  // 일식/월식 특수 효과 오버레이
  if (state.mode === 3) {
    if (state.eclipseType === 'solar') {
      // 삭 부근에서 일식 불빛 라인 연출
      const distToNew = angDist(state.phaseAngle, Math.PI);
      if (distToNew < 0.1 && !state.tiltOrbit) {
        // 일식 섬광 효과
        orbitCtx.fillStyle = 'rgba(255,209,102,0.15)';
        orbitCtx.fillRect(0, 0, w, h);
      }
    }
  }

  // 7. 실시간 위상 캔버스 렌더링 (지구에서 본 달의 위상)
  drawMoonPhase(phaseCtx, 70, 70, 52, state.phaseAngle);
}

// 지구에서 보는 모양 명암 렌더링 (Volcano 스타일 입체 렌더링)
function drawMoonPhase(ctx, cx, cy, r, theta) {
  ctx.clearRect(0, 0, 140, 140);
  
  // 크레이터 패턴 그리기 헬퍼
  const drawCraters = (alpha) => {
    ctx.fillStyle = `rgba(0, 0, 0, ${alpha})`;
    ctx.beginPath(); ctx.arc(cx - r*0.3, cy - r*0.4, r*0.15, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(cx + r*0.4, cy - r*0.2, r*0.2, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(cx - r*0.1, cy + r*0.3, r*0.25, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(cx + r*0.2, cy + r*0.4, r*0.12, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(cx + r*0.1, cy - r*0.6, r*0.08, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(cx - r*0.4, cy + r*0.1, r*0.1, 0, Math.PI*2); ctx.fill();
  };

  ctx.save();
  // 1. 어두운 배경 구체
  ctx.beginPath();
  ctx.arc(cx, cy, r, 0, Math.PI * 2);
  ctx.clip(); // 전체 달 영역 클리핑
  
  ctx.fillStyle = '#111726';
  ctx.fill();
  drawCraters(0.4); // 어두운 부분 크레이터

  const cos = Math.cos(theta);
  const sin = Math.sin(theta);

  // 2. 일식/월식 시 붉은달 또는 가려지는 특수 렌더링
  if (state.mode === 3 && !state.tiltOrbit) {
    if (state.eclipseType === 'lunar' && angDist(theta, 0) < 0.2) {
      ctx.fillStyle = '#b22222'; // 개기월식 붉은 보름달 (Blood Moon)
      ctx.fill();
      drawCraters(0.3);
      
      // 입체감 오버레이
      const grad = ctx.createRadialGradient(cx - r*0.2, cy - r*0.2, r*0.1, cx, cy, r);
      grad.addColorStop(0, 'rgba(255,255,255,0.1)');
      grad.addColorStop(1, 'rgba(0,0,0,0.6)');
      ctx.fillStyle = grad;
      ctx.fillRect(cx - r, cy - r, r*2, r*2);
      
      ctx.restore();
      return;
    }
    if (state.eclipseType === 'solar' && angDist(theta, Math.PI) < 0.2) {
      // 코로나 섬광 고리 (클리핑 해제 후 그림)
      ctx.restore();
      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, r + 6, 0, Math.PI*2);
      ctx.fillStyle = '#ffffff';
      ctx.shadowBlur = 15;
      ctx.shadowColor = '#ffd166';
      ctx.fill();
      ctx.shadowBlur = 0; // 리셋
      
      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, Math.PI*2);
      ctx.fillStyle = '#030408'; // 검은 구체
      ctx.fill();
      ctx.restore();
      return;
    }
  }

  // 3. 햇빛 부분 그리기 (Terminator)
  ctx.beginPath();
  if (sin >= 0) {
    ctx.arc(cx, cy, r, Math.PI / 2, Math.PI * 1.5);
    const rx = r * cos;
    ctx.ellipse(cx, cy, Math.abs(rx), r, 0, Math.PI * 1.5, Math.PI / 2, cos < 0);
  } else {
    ctx.arc(cx, cy, r, Math.PI * 1.5, Math.PI / 2);
    const rx = r * cos;
    ctx.ellipse(cx, cy, Math.abs(rx), r, 0, Math.PI / 2, Math.PI * 1.5, cos < 0);
  }
  
  ctx.save();
  ctx.clip(); // 밝은 부분 영역 클리핑
  ctx.fillStyle = '#ffe8a1'; // 더 예쁜 달빛 색상
  ctx.fill();
  drawCraters(0.15); // 밝은 부분 크레이터
  ctx.restore();

  // 4. 구형 입체감 셰이딩 (전체 오버레이)
  const sphereGrad = ctx.createRadialGradient(cx - r*0.3, cy - r*0.3, r*0.1, cx, cy, r);
  sphereGrad.addColorStop(0, 'rgba(255,255,255,0.1)');
  sphereGrad.addColorStop(0.6, 'rgba(0,0,0,0)');
  sphereGrad.addColorStop(1, 'rgba(0,0,0,0.7)');
  ctx.fillStyle = sphereGrad;
  ctx.fillRect(cx - r, cy - r, r*2, r*2);

  // 태양광이 오는 방향(왼쪽)에 살짝 글로우 추가
  if (Math.cos(theta) > -0.5) {
     const glowGrad = ctx.createLinearGradient(cx - r, cy, cx, cy);
     glowGrad.addColorStop(0, 'rgba(255,232,161,0.4)');
     glowGrad.addColorStop(1, 'rgba(255,232,161,0)');
     ctx.fillStyle = glowGrad;
     ctx.fillRect(cx - r, cy - r, r, r*2);
  }

  ctx.restore(); // 전체 클리핑 해제
}

/* ══════════════════════════════════════
   인터랙션 및 UI 갱신
   ══════════════════════════════════════ */
function updateUI() {
  const info = getPhaseInfo(state.phaseAngle);
  
  // 텍스트 매핑
  $('#moonPhaseName').textContent = info.name;
  $('#moonPhaseCanvas').setAttribute('aria-label', '지구에서 본 달 모양: ' + info.name);
  $('#moonPhaseDate').textContent = info.date;
  $('#infoNoon').textContent = info.noon;
  $('#infoDir').textContent = info.dir;
  $('#infoTip').innerHTML = info.tip;

  // 일식/월식 시 텍스트 보강
  if (state.mode === 3 && !state.tiltOrbit) {
    if (state.eclipseType === 'solar' && angDist(state.phaseAngle, Math.PI) < 0.1) {
      $('#moonPhaseName').textContent = '🌞 개기일식 (Solar Eclipse)';
      $('#moonPhaseDate').textContent = '일직선 정렬 상태';
      $('#infoTip').innerHTML = '달이 태양을 완전히 가리는 <strong>개기일식</strong> 현상입니다. 주변 하늘이 한낮에도 어두워져요!';
    } else if (state.eclipseType === 'lunar' && angDist(state.phaseAngle, 0) < 0.1) {
      $('#moonPhaseName').textContent = '🌘 개기월식 (Lunar Eclipse)';
      $('#moonPhaseDate').textContent = '지구 그림자 통과 상태';
      $('#infoTip').innerHTML = '지구의 그림자에 달이 완전히 가려져, 태양빛 굴절로 인해 붉게 빛나는 <strong>블러드문(붉은달)</strong>이 나타납니다.';
    }
  }

  // 미션 채점은 [정답 확인] 버튼(verifyMission)에서만 한다.
  // (예전에는 매 프레임 자동 채점이라 자동 공전만 켜도 미션이 저절로 완료됐음)

  requestRedraw();
}

function verifyMission() {
  if (state.mode !== 2 || !mc) return;
  const m = MISSIONS[state.missionIdx];
  if (!m.verify(state.phaseAngle)) {
    mc.fail('아직 아니에요. 지구에서 본 달 모양을 살펴보면서 위치를 다시 맞춰 보세요.');
    return;
  }
  // 지금 동작 유지: 성공하면 즉시 첫 미완료 미션으로 넘어가되 성공 문구는 남긴다
  const nextIdx = MISSIONS.findIndex((ms, i) => i !== state.missionIdx && !mc.isDone(i));
  mc.complete({
    message: nextIdx === -1
      ? '🎉 정답이에요! 미션을 모두 마쳤어요. 아래 [탐험 완료] 버튼을 눌러 보세요.'
      : `🎉 정답이에요! 이제 ${nextIdx + 1}번 미션에 도전해 보세요.`
  });
  if (nextIdx >= 0) mc.go(nextIdx, { keepFeedback: true });
}

function updatePlayButtonState() {
  $('#btnPlayAuto').classList.toggle('active', state.autoPlay);
  $('#btnPlayAuto').setAttribute('aria-pressed', state.autoPlay ? 'true' : 'false');
  $('#btnPlayAuto').textContent = state.autoPlay ? '⏸️ 자동 일시정지' : '▶️ 자동 공전';
  if (state.autoPlay) requestRedraw();
}

function switchMode(modeNum) {
  const prevMode = state.mode;
  state.mode = parseInt(modeNum) || 1;
  state.autoPlay = false;
  state.eclipseType = null;
  updatePlayButtonState();

  // 탭 변경(표시만)
  if (modeTabs) modeTabs.select(state.mode, { silent: true });
  if (prevMode === 2 && state.mode !== 2 && mc) mc.stop();

  const mCard = $('#missionCard');
  const infoBox = $('#infoBox');
  const btnVerify = $('#btnVerify');
  const canvasBadgeNum = $('#canvasBadgeNum');
  const canvasBadgeLabel = $('#canvasBadgeLabel');

  mCard.style.display = 'none';
  infoBox.style.display = 'block';
  btnVerify.style.display = 'none';
  $('#btnNextScreen').style.display = 'none';
  $('#missionNav').hidden = false;
  $('#eclipseNav').hidden = true;
  hideFeedback();

  if (state.mode === 1) {
    canvasBadgeNum.textContent = '🌏';
    canvasBadgeLabel.textContent = '달의 공전과 위상';
  } else if (state.mode === 2) {
    canvasBadgeNum.textContent = '🏆';
    canvasBadgeLabel.textContent = '위상 미션';
    mCard.style.display = 'block';
    btnVerify.style.display = '';
    mc.start(state.missionIdx); // 번호 그리기 → onEnter(setupMissionUI)
  } else if (state.mode === 3) {
    canvasBadgeNum.textContent = '🌌';
    canvasBadgeLabel.textContent = '일식·월식 심화';
    setupEclipseUI();
  }

  updateUI();
}

/* 미션 준비: SimKit 미션 컨트롤러의 onEnter에서 부른다(번호 그리기·문구 숨김은 컨트롤러가 함) */
function setupMissionUI() {
  const m = MISSIONS[state.missionIdx];
  $('#missionTitle').textContent = '달의 위상 미션'; // 일식·월식 모드에서 바뀐 제목 복원
  $('#missionDesc').innerHTML = m.desc;
  updateDoneButton();
  updateUI();
}

function updateDoneButton() {
  const allMissionsDone = MISSION_IDS.every(id => state.missionsCompleted[id] === true);
  $('#btnNextScreen').style.display = state.mode === 2 && allMissionsDone ? 'block' : 'none';
}

function setupEclipseUI() {
  // 일식/월식 심화 모드에서는 5도 경사를 조작하며 개기일식/월식을 체험하도록 안내
  $('#infoBox').style.display = 'none';
  
  const mCard = $('#missionCard');
  mCard.style.display = 'block';
  $('#missionTitle').textContent = '🔭 일식·월식 심화 미션';
  $('#missionDesc').innerHTML = `
    태양-지구-달이 일직선으로 정렬할 때 일어나는 현상입니다.<br><br>
    - <strong>일식:</strong> 달이 태양을 가리는 현상 (달이 '삭'일 때)<br>
    - <strong>월식:</strong> 달이 지구 그림자에 들어가는 현상 (달이 '망'일 때)<br><br>
    💡 <strong>경사선 끄기:</strong> 5도 궤도 경사 켜짐 상태에서는 대개 달이 비껴갑니다. <strong>[궤도 기울기] 버튼을 꺼서 일직선으로 맞춰 보세요!</strong>
  `;

  // 일식/월식 시범 작동 버튼(마크업 #eclipseNav, 미션 번호 상자와 따로)
  $('#missionNav').hidden = true;
  $('#eclipseNav').hidden = false;
}

function runEclipse(type) {
  state.eclipseType = type;
  state.autoPlay = false;
  updatePlayButtonState();
  if (type === 'solar') {
    state.phaseAngle = Math.PI; // 삭 (New Moon)
  } else {
    state.phaseAngle = 0; // 망 (Full Moon)
  }
  syncSlider();
  updateUI();
}

function showResultScreen() {
  state.autoPlay = false;
  updatePlayButtonState();
  showScreen('screenResult');
  SimKit.stars.render('#resultStars', SimKit.stars.grade(mc.doneCount(), [1, 2, 3]));
  let summary = `<strong>달 탐색 완료 보고서</strong><br><br>`;
  summary += `① 보름달 위치 찾기: ${state.missionsCompleted.m1 ? '완료 ✓' : '미완료'}<br>`;
  summary += `② 상현달 위치 찾기: ${state.missionsCompleted.m2 ? '완료 ✓' : '미완료'}<br>`;
  summary += `③ 하현달 위치 찾기: ${state.missionsCompleted.m3 ? '완료 ✓' : '미완료'}<br><br>`;
  summary += `달의 모양이 변하는 진짜 원인은 <strong>지구 주위를 도는 달에 닿는 햇빛의 방향과 우리의 관찰 각도</strong> 때문이에요. 5도 경사선 조작으로 매달 일식/월식이 안 일어나는 물리적 정렬 원인도 함께 마스터했습니다!`;

  $('#resultSummary').innerHTML = summary;
}

/* ── 화면 전환 ── */
function showScreen(id) {
  if (id !== 'screenExplore' && mc) mc.stop();
  screens.show(id);
  if (id === 'screenExplore') resizeOrbitCanvas();
}

/* ── 초기화 및 이벤트 등록 ── */
function init() {
  loadState();
  parseShareLink();
  initCanvas();
  syncSlider();

  // 미션 컨트롤러: 번호 버튼(44px)·이동·문구·완료 기록
  mc = SimKit.missions({
    ids: MISSION_IDS,
    format: 'flags',
    progress: state.missionsCompleted,
    nav: '#missionNav',
    feedback: fb,
    onEnter: (i) => { state.missionIdx = i; setupMissionUI(); },
    onChange: (p) => { state.missionsCompleted = p; saveState(); updateDoneButton(); }
  });

  // 일식·월식 위치 버튼
  $$('#eclipseNav [data-eclipse]').forEach(b => {
    b.addEventListener('click', () => runEclipse(b.dataset.eclipse));
  });

  // 시작
  $('#btnStart').addEventListener('click', () => {
    showScreen('screenExplore');
    resizeOrbitCanvas(); // Fix: resize after display becomes visible
    switchMode(1);
  });

  // 탭 제어
  modeTabs = SimKit.tabs('.mode-tab', { attr: 'mode', initial: '1', onSelect: (v) => switchMode(v) });

  // 슬라이더 조작
  $('#moonSlider').addEventListener('input', (e) => {
    state.phaseAngle = parseFloat(e.target.value) * Math.PI / 180;
    $('#sliderVal').textContent = `${e.target.value}°`;
    e.target.setAttribute('aria-valuetext', `${e.target.value}°, ${getPhaseInfo(state.phaseAngle).name}`);
    state.autoPlay = false;
    updatePlayButtonState();
    updateUI();
  });

  // 자동 공전 재생/일시정지
  $('#btnPlayAuto').addEventListener('click', () => {
    state.autoPlay = !state.autoPlay;
    updatePlayButtonState();
  });

  // 궤도 경사 5도 토글
  $('#btnTiltToggle').addEventListener('click', (e) => {
    state.tiltOrbit = !state.tiltOrbit;
    e.currentTarget.classList.toggle('active', state.tiltOrbit);
    e.currentTarget.setAttribute('aria-pressed', state.tiltOrbit ? 'true' : 'false');
    updateUI();
  });
  $('#btnTiltToggle').classList.add('active'); // 디폴트 ON
  updatePlayButtonState();

  // 시점 초기화
  $('#btnResetView').addEventListener('click', () => {
    state.phaseAngle = 0;
    state.tiltOrbit = true;
    state.autoPlay = false;
    $('#btnTiltToggle').classList.add('active');
    $('#btnTiltToggle').setAttribute('aria-pressed', 'true');
    syncSlider();
    updatePlayButtonState();
    updateUI();
  });

  // 미션 정답 확인
  $('#btnVerify').addEventListener('click', verifyMission);

  // 탐험 완료 결과 화면
  $('#btnNextScreen').addEventListener('click', showResultScreen);

  // 결과 액션
  $('#btnRetry').addEventListener('click', () => {
    mc.reset(); // onChange → missionsCompleted 초기화·저장
    state.missionIdx = 0;
    showScreen('screenExplore');
    switchMode(1);
  });
  $('#btnBackToHub').addEventListener('click', () => {
    showScreen('screenExplore');
    switchMode(1);
  });

  // 첫 그리기 (이후에는 상태가 바뀔 때만 다시 그림)
  requestRedraw();

  // 셸 공유 버튼 → 지금 달 위치 링크(받는 쪽은 parseShareLink에서 복원)
  SimKit.share.bind(() => ({ v: 1, phaseAngle: Math.round(state.phaseAngle * 1000) / 1000 }), {
    title: '달의 위상 3D — 내가 관찰한 달의 위치'
  });
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}

})();
</script>



</AppLayout>
