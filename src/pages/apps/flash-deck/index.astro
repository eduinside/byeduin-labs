function renderHome() {
  showView('home');
  const data = getData();
  const grid = document.getElementById('deck-grid');
  // 덱이 없을 때는 빈 상태 카드의 버튼이 주 동작 — 위쪽 '새 덱' 버튼은 숨김(주 버튼 하나)
  document.getElementById('btn-new-deck').hidden = !data.decks.length;
  if (!data.decks.length) {
    grid.innerHTML = `<div class="deck-empty fd-card">
      <div class="deck-empty-icon">${VUI.icon('layers')}</div>
      <div class="deck-empty-title">아직 덱이 없어요</div>
      덱을 만들고 카드를 넣어 공부해 보세요.<br>AI에게 카드를 만들어 달라고 할 수도 있어요.
      <div class="deck-empty-actions">
        <button class="fd-btn fd-btn-primary" onclick="openNewDeckModal()">${VUI.icon('plus')} 새 덱 만들기</button>
        <button class="fd-btn fd-btn-ghost" onclick="openAiPromptModal()">${VUI.icon('sparkles')} AI로 카드 만들기</button>
      </div>
    </div>`;
    return;
  }
  const deckCards = data.decks.map((deck, i) => {
    const total = deck.cards.length;
    const mastered = deck.cards.filter(c => c.mastered).length;
    const pct = total ? Math.round(mastered / total * 100) : 0;
    const lastStudied = deck.lastStudied
      ? new Date(deck.lastStudied).toLocaleDateString('ko-KR', { month: 'short', day: 'numeric' })
      : '미학습';
    const studyCount = deck.studyCount || 0;
    return `<div class="deck-item" style="animation-delay:${i * 0.05}s" onclick="openDeck('${esc(deck.id)}')">
      <button class="deck-item-del" title="덱 삭제" aria-label="${esc(deck.name)} 덱 삭제" onclick="event.stopPropagation();deleteDeck('${esc(deck.id)}')">
        ${VUI.icon('trash-2')}
      </button>
      <div class="deck-item-emoji" aria-hidden="true">${VUI.icon('layers')}</div>
      <div class="deck-item-name" title="${esc(deck.name)}">${esc(deck.name)}</div>
      <div class="deck-item-meta">카드 ${total}장 · 학습 ${studyCount}회 · 마지막 ${lastStudied}</div>
      <div class="deck-item-progress">
        <div class="fd-progress-bar">
          <div class="fd-progress-fill" style="width:${pct}%"></div>
        </div>
        <div style="font-size:14px;color:var(--fg-muted);margin-top:3px;text-align:right">익힌 카드 ${mastered}/${total}</div>
      </div>
      <div class="deck-item-actions">
        <button class="fd-btn fd-btn-ghost fd-btn-sm" aria-label="${esc(deck.name)} 편집" onclick="event.stopPropagation();openDeck('${esc(deck.id)}')">편집</button>
        <button class="fd-btn fd-btn-primary fd-btn-sm" aria-label="${esc(deck.name)} 학습" onclick="event.stopPropagation();openDeckAndStudy('${esc(deck.id)}')">학습</button>
      </div>
    </div>`;
  });

  const aiCard = `<div class="deck-item deck-item-ai" style="animation-delay:${data.decks.length * 0.05}s" onclick="openAiPromptModal()">
    <div class="deck-item-emoji" aria-hidden="true">${VUI.icon('sparkles')}</div>
    <div class="deck-item-name">AI로 카드 만들기</div>
    <div class="deck-item-meta">Gemini · ChatGPT 프롬프트 예시</div>
    <div style="flex:1"></div>
    <div class="deck-item-actions">
      <button class="fd-btn fd-btn-ghost fd-btn-sm" style="flex:1" onclick="event.stopPropagation();openAiPromptModal()">프롬프트 보기</button>
    </div>
  </div>`;

  grid.innerHTML = deckCards.join('') + aiCard;
}

