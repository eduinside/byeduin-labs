      <div class="card-row-back">${esc(c.back)}</div>
      <div class="card-row-actions">
        <button class="fd-btn-icon fd-btn-move" onclick="moveCard('${esc(c.id)}',-1)" title="위로" aria-label="${esc(c.front)} 위로" ${i === 0 ? 'disabled' : ''}>
          ${VUI.icon('chevron-up')}
        </button>
        <button class="fd-btn-icon fd-btn-move" onclick="moveCard('${esc(c.id)}',1)" title="아래로" aria-label="${esc(c.front)} 아래로" ${i === n - 1 ? 'disabled' : ''}>
          ${VUI.icon('chevron-down')}
