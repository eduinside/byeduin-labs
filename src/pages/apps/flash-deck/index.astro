<script is:inline="">
// ══════════════════════════════════════════════════════
//  STORAGE
// ══════════════════════════════════════════════════════
const STORAGE_KEY = 'vives-flashdeck';

function loadData() {
  return VUI.storage.get(STORAGE_KEY, { decks: [] }, v => v && Array.isArray(v.decks));
}
function saveData(data) {
  VUI.storage.set(STORAGE_KEY, data);   // 용량 초과면 VUI가 오류 토스트를 한 번 보여 줌
}
function getData() { return loadData(); }

// ── 공유/보기 전용 상태 (vives-share 스킬 패턴) ──
let viewOnlyData = null;   // 보기 전용 덱 (메모리 전용, localStorage 저장 안 함)
let _pendingShared = null; // 복제 허용 모달 대기 중인 데이터

function getActiveDeck() {
  if (viewOnlyData) return viewOnlyData;
  const data = getData();
  return data.decks.find(d => d.id === currentDeckId) || null;
}

function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2, 6); }

