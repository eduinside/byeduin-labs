function addSingleCard() {
  if (viewOnlyData) return;
  const front = document.getElementById('inp-front').value.trim();
  const back  = document.getElementById('inp-back').value.trim();
  if (!front && !back) return;
  if (!front || !back) {
    showToast(front ? '뒷면(답)도 적어 주세요.' : '앞면(질문)도 적어 주세요.', 'error');
    document.getElementById(front ? 'inp-back' : 'inp-front').focus();
    return;
  }
  const data = getData();
  const deck = data.decks.find(d => d.id === currentDeckId);
  deck.cards.push({ id: uid(), front, back, mastered: false, passCount: 0, failCount: 0 });
  saveData(data);
  document.getElementById('inp-front').value = '';
  document.getElementById('inp-back').value = '';
  document.getElementById('inp-front').focus();
  renderDeckView();
}

function handleCardInputKey(e) {
  if (e.key === 'Enter' && !e.isComposing) { e.preventDefault(); addSingleCard(); }
}

function deleteCard(cardId) {
  if (viewOnlyData) return;
  const data = getData();
  const deck = data.decks.find(d => d.id === currentDeckId);
  if (!deck) return;
  const idx = deck.cards.findIndex(c => c.id === cardId);
  if (idx < 0) return;
  const [removed] = deck.cards.splice(idx, 1);
  const deckId = deck.id;
  saveData(data);
  renderDeckView();
  showToast(`"${removed.front}" 카드를 지웠어요.`, {
    duration: 7000,
    action: { label: '되돌리기', onClick: () => {
      const d = getData();
      const dk = d.decks.find(x => x.id === deckId);
      if (!dk || dk.cards.some(c => c.id === removed.id)) return;
      dk.cards.splice(Math.min(idx, dk.cards.length), 0, removed);
      saveData(d);
      if (currentView === 'deck' && currentDeckId === deckId) renderDeckView();
      showToast('카드를 되살렸어요.');
    } },
  });
}

function toggleBulk() {
  const toggle = document.getElementById('bulk-toggle');
  const area = document.getElementById('bulk-area');
  const open = area.classList.toggle('open');
  toggle.classList.toggle('open', open);
  toggle.setAttribute('aria-expanded', String(open));
  if (open) document.getElementById('bulk-input').focus();
}

function clearBulk() {
  const ta = document.getElementById('bulk-input');
  const prev = ta.value;
  if (!prev.trim()) return;
  ta.value = '';
  showToast('입력 칸을 비웠어요.', {
    duration: 7000,
    action: { label: '되돌리기', onClick: () => { ta.value = prev; ta.focus(); } },
  });
}

// 일괄 입력 해석: '앞면 :: 뒷면' 한 줄 = 카드 한 장. 형식이 틀리거나 한쪽이 빈 줄은 bad로 모음
function parseBulk(raw) {
  const pairs = [], bad = [];
  raw.split('\n').map(l => l.trim()).filter(Boolean).forEach(l => {
    const sep = l.indexOf('::');
    const front = sep === -1 ? '' : l.slice(0, sep).trim();
    const back  = sep === -1 ? '' : l.slice(sep + 2).trim();
    if (front && back) pairs.push({ front, back }); else bad.push(l);
  });
  return { pairs, bad };
}

async function recommendCardsWithAi() {
  const deck = getActiveDeck();
  if (!deck) { showToast('덱이 선택되지 않았습니다.'); return; }

  const btn = document.getElementById('btn-ai-recommend');
  if (!btn) return;

  const originalContent = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span> 추천 중…';

  try {
    // 시간 제한·오프라인·429·5xx를 한국어 문구로 받음
    const data = await VUI.apiFetch('/api/flash-recommend', { json: { subject: deck.name }, timeout: 45000 });
    if (!data || typeof data.recommendation !== 'string' || !data.recommendation.trim()) {
      throw new Error('AI가 추천을 만들지 못했어요. 잠시 후 다시 해 주세요.');
    }
    const textarea = document.getElementById('bulk-input');
    const prev = textarea.value;
    const count = parseBulk(data.recommendation).pairs.length;
    textarea.value = data.recommendation;
    const msg = count
      ? `AI가 카드 ${count}장을 추천했어요. 살펴보고 '일괄 추가'를 눌러 주세요.`
      : 'AI 추천을 입력 칸에 넣었어요. 형식을 확인해 주세요.';
    if (prev.trim()) {
      // 적어 두었던 내용을 덮어썼으면 되돌릴 수 있게
      showToast(msg, { duration: 8000, action: { label: '되돌리기', onClick: () => { textarea.value = prev; } } });
    } else {
      showToast(msg, count ? 'success' : undefined);
    }
  } catch (e) {
    if (e.code !== 'abort') showToast(e.message || 'AI 추천에 실패했어요.', 'error');
  } finally {
    btn.disabled = false;
    btn.innerHTML = originalContent;
  }
}

async function createDeckWithAiDirectly() {
  // 프롬프트 창을 먼저 닫고(포커스 가두기 겹침 방지) 앱 안 입력 창을 띄움
  closeAiPromptModal();
  const topic = await VUI.prompt('어떤 주제로 카드 덱을 만들까요?\nAI가 카드를 추천해 줘요.', {
    title: 'AI로 직접 만들기', ok: '만들기',
    placeholder: '예) 초등 3학년 영어 단어, 조선의 왕, 우리 몸의 기관',
  });
  if (!topic || !topic.trim()) return;

  const data = getData();
  const newDeck = { id: uid(), name: topic.trim().slice(0, 40), createdAt: Date.now(), lastStudied: null, cards: [] };
  data.decks.push(newDeck);
  saveData(data);

  // 신규 생성된 덱 편집 화면 열기
  openDeck(newDeck.id);

  // 일괄 입력 영역 열기
  const area = document.getElementById('bulk-area');
  const toggle = document.getElementById('bulk-toggle');
  if (area && !area.classList.contains('open')) {
    area.classList.add('open');
    toggle.classList.add('open');
    toggle.setAttribute('aria-expanded', 'true');
  }

  // AI 추천 트리거
  recommendCardsWithAi();
}

function addBulkCards() {
  if (viewOnlyData) return;
  const textarea = document.getElementById('bulk-input');
  if (!textarea.value.trim()) return;
  const { pairs, bad } = parseBulk(textarea.value);
  if (!pairs.length) {
    showToast("형식에 맞는 줄이 없어요.\n한 줄에 '앞면 :: 뒷면'처럼 적어 주세요.", 'error');
    textarea.focus();
    return;
  }

  const data = getData();
  const deck = data.decks.find(d => d.id === currentDeckId);
  if (!deck) return;
  pairs.forEach(p => deck.cards.push({ id: uid(), front: p.front, back: p.back, mastered: false, passCount: 0, failCount: 0 }));
  saveData(data);
  renderDeckView();
  if (bad.length) {
    // 건너뛴 줄은 입력 칸에 남겨 고칠 수 있게
    textarea.value = bad.join('\n');
    showToast(`카드 ${pairs.length}장을 추가했어요. ${bad.length}줄 건너뜀\n('앞면 :: 뒷면' 형식이 아니거나 한쪽이 비어 있어요. 입력 칸에 남겨 두었어요.)`, { duration: 7000 });
    textarea.focus();
  } else {
    textarea.value = '';
    toggleBulk();
    showToast(`카드 ${pairs.length}장을 추가했어요.`, 'success');
  }
}

