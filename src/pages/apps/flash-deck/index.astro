---
import AppLayout from '../../../layouts/AppLayout.astro';
import Icon from '../../../components/Icon.astro';
---
<AppLayout
  sync
  title="플래시 카드 (Flash Deck) — eduin VIVES"
  description="나만의 플래시카드를 만들고 AI로 자동 생성하세요. 링크 공유로 친구와 함께 학습."
  image="https://eduin.info/og-images/flash-deck.png"
  bodyShell="column"
  bodyWidth="medium"
>
  <Fragment slot="head">
    <style is:global="">
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap');

    * { box-sizing: border-box; }

    body {
      min-height: 100vh;
      min-height: 100dvh;
      padding: 56px 1rem 5rem;
      font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", sans-serif;
    }

    body::before {
      content: '';
      position: fixed; inset: 0;
      background-image:
        linear-gradient(rgba(0,111,238,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,111,238,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none; z-index: 0;
    }

    .fd-root { position: relative; z-index: 1; max-width: 720px; margin: 0 auto; }

    /* ── 뷰 전환 ── */
    .fd-view { display: none; }
    .fd-view.active { display: block; }

    /* ── 공통 카드 ── */
    .fd-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 20px;
    }

    .fd-section-title {
      font-size: 14px; font-weight: 700; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--fg-muted); margin-bottom: 16px;
      display: flex; align-items: center; gap: 8px;
    }
    .fd-section-title::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    /* ── 버튼 ── */
    .fd-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      padding: 10px 18px; border-radius: 10px; border: none;
      font-size: 14px; font-weight: 600; cursor: pointer; font-family: inherit;
      transition: all 0.15s; min-height: 44px; white-space: nowrap;
    }
    .fd-btn-primary { background: var(--primary); color: #fff; }
    .fd-btn-primary:hover { background: var(--primary-h); }
    .fd-btn-primary:disabled { opacity: 0.4; cursor: not-allowed; }
    .fd-btn-ghost {
      background: var(--card-bg); color: var(--fg-muted);
      border: 1px solid var(--border);
    }
    .fd-btn-ghost:hover { border-color: var(--primary); color: var(--primary); background: rgba(0,111,238,0.06); }
    .fd-btn-danger { background: rgba(243,18,96,0.1); color: var(--danger); border: 1px solid rgba(243,18,96,0.2); }
    .fd-btn-danger:hover { background: rgba(243,18,96,0.18); }
    .fd-btn-success { background: rgba(23,201,100,0.1); color: var(--success); border: 1px solid rgba(23,201,100,0.25); }
    .fd-btn-success:hover { background: rgba(23,201,100,0.2); }
    .fd-btn-sm { padding: 6px 12px; font-size: 14px; min-height: 44px; border-radius: 8px; }
    .fd-btn-icon {
      width: 44px; height: 44px; padding: 0; border-radius: 8px;
      background: none; border: 1px solid var(--border); color: var(--fg-muted);
      display: inline-flex; align-items: center; justify-content: center;
      cursor: pointer; transition: all 0.15s; font-size: 14px;
    }
    .fd-btn-icon:hover { border-color: var(--danger); color: var(--danger); }
    .fd-btn-icon.fd-btn-move:hover { border-color: var(--primary); color: var(--primary); }
    .fd-btn[hidden] { display: none; }

    /* ── 입력 ── */
    .fd-input {
      width: 100%; background: var(--bg); border: 1px solid var(--border);
      border-radius: 8px; padding: 10px 12px; font-size: 14px;
      color: var(--fg); outline: none; transition: border-color 0.2s;
      font-family: inherit;
    }
    .fd-input:focus { border-color: var(--primary); }
    .fd-textarea {
      width: 100%; background: var(--bg); border: 1px solid var(--border);
      border-radius: 8px; padding: 12px 14px; font-size: 14px;
      color: var(--fg); outline: none; resize: vertical; min-height: 120px;
      font-family: 'JetBrains Mono', monospace; line-height: 1.6;
      transition: border-color 0.2s;
    }
    .fd-textarea:focus { border-color: var(--primary); }
    /* 휴대폰·태블릿: 16px 미만이면 입력할 때 화면이 확대됨 */
    @media (max-width: 768px), (hover: none) {
      .fd-input, .fd-textarea { font-size: 16px; }
    }

    /* ── 진행률 바 ── */
    .fd-progress-bar {
      height: 4px; background: var(--border); border-radius: 99px; overflow: hidden;
    }
    .fd-progress-fill {
      height: 100%; background: var(--primary); border-radius: 99px;
      transition: width 0.4s ease;
    }

    /* ══════════════════════════════════
       홈 뷰
    ══════════════════════════════════ */
    #view-home .home-top {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 20px; gap: 12px;
    }
    .deck-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 12px;
    }
    .deck-item {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 14px; padding: 18px;
      cursor: pointer; transition: border-color 0.2s, transform 0.15s, box-shadow 0.2s;
      display: flex; flex-direction: column; gap: 10px;
      animation: fadeUp 0.25s ease both;
      position: relative;
    }
    .deck-item-del {
      position: absolute; top: 6px; right: 6px;
      width: 44px; height: 44px; border-radius: 8px;
      background: none; border: none; cursor: pointer;
      color: var(--fg-muted); display: flex; align-items: center; justify-content: center;
      opacity: 0; transition: opacity 0.15s, color 0.15s, background 0.15s;
    }
    .deck-item:hover .deck-item-del, .deck-item-del:focus-visible { opacity: 1; }
    /* 마우스를 올릴 수 없는 터치 기기에서는 삭제 버튼을 항상 보임 */
    @media (hover: none) { .deck-item-del { opacity: 0.7; } }
    .deck-item-del:hover { color: var(--danger); background: rgba(243,18,96,0.08); }
    .deck-item:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(0,111,238,0.1);
    }
    .deck-item-emoji { font-size: 28px; line-height: 1; color: var(--primary); display: flex; }
    .deck-item-name {
      font-size: 15px; font-weight: 700; color: var(--fg);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      padding-right: 36px;
    }
    .deck-item-meta { font-size: 14px; color: var(--fg-muted); }
    .deck-item-progress { margin-top: 2px; }
    .deck-item-actions {
      display: flex; gap: 6px; margin-top: 4px;
    }
    .deck-item-actions .fd-btn { flex: 1; }
    /* ── AI 프롬프트 카드 ── */
    .deck-item-ai {
      border-style: dashed;
      border-color: rgba(124,106,247,0.45);
      background: rgba(124,106,247,0.04);
      cursor: pointer;
    }
    .deck-item-ai:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(124,106,247,0.12);
    }
    .deck-item-ai .deck-item-emoji { font-size: 28px; }
    .deck-item-ai .deck-item-name  { color: var(--primary); }

    /* ── AI 프롬프트 모달 ── */
    #ai-prompt-modal .fd-modal { max-width: 540px; }
    .ai-prompt-list { display: flex; flex-direction: column; gap: 10px; margin-top: 12px; }
    .ai-prompt-block {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px 14px;
      position: relative;
    }
    .ai-prompt-block-label {
      font-size: 13px; font-weight: 700; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--fg-muted); margin-bottom: 6px;
      padding-right: 64px;
    }
    .ai-prompt-text {
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px; color: var(--fg);
      white-space: pre-wrap; line-height: 1.6;
    }
    .btn-copy-prompt {
      position: absolute; top: 10px; right: 10px;
      background: none; border: 1px solid var(--border);
      border-radius: 7px; cursor: pointer;
      color: var(--fg-muted); font-size: 14px; padding: 4px 12px; min-height: 44px; min-width: 56px;
      display: inline-flex; align-items: center; gap: 4px;
      font-family: inherit; font-weight: 600; transition: all 0.15s;
    }
    .btn-copy-prompt:hover { border-color: var(--primary); color: var(--primary); }
    .ai-modal-note {
      margin-top: 12px; font-size: 14px; color: var(--fg-muted); line-height: 1.6;
    }

    .deck-empty {
      grid-column: 1 / -1; text-align: center;
      padding: 48px 20px; color: var(--fg-muted); font-size: 14px;
    }
    .deck-empty-icon { display: flex; justify-content: center; margin-bottom: 16px; color: var(--fg-muted); font-size: 48px; }
    .deck-empty-icon .ic { stroke-width: 1.5; opacity: 0.5; }
    .deck-empty-title { font-size: 16px; font-weight: 700; color: var(--fg); margin-bottom: 4px; }
    .deck-empty-actions { margin-top: 20px; display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }

    /* 새 덱 모달 */
    .fd-modal-overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,0.5); z-index: 200;
      align-items: center; justify-content: center; padding: 1rem;
    }
    .fd-modal-overlay.open { display: flex; }
    .fd-modal {
      background: var(--card-bg); border: 1px solid var(--border);
      border-radius: 20px; padding: 28px; width: 100%; max-width: 380px;
      animation: scaleIn 0.2s ease;
      max-height: 90vh; max-height: 90dvh; display: flex; flex-direction: column;
    }
    .fd-modal-body {
      overflow-y: auto;
      flex: 1;
      margin-right: -14px;
      padding-right: 14px;
    }
    .fd-modal-body::-webkit-scrollbar {
      width: 6px;
    }
    .fd-modal-body::-webkit-scrollbar-track {
      background: transparent;
    }
    .fd-modal-body::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 99px;
    }
    .fd-modal-body::-webkit-scrollbar-thumb:hover {
      background: var(--fg-muted);
    }
    .fd-modal-title { font-size: 17px; font-weight: 700; margin: 0 0 16px; }
    .fd-modal-actions { display: flex; gap: 8px; margin-top: 20px; justify-content: flex-end; }

    /* ══════════════════════════════════
       덱 뷰
    ══════════════════════════════════ */
    #view-deck .deck-top {
      display: flex; align-items: center; gap: 12px; margin-bottom: 20px; flex-wrap: wrap;
    }
    .deck-top-title {
      flex: 1; font-size: 18px; font-weight: 700; min-width: 0;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .fd-label {
      font-size: 14px; font-weight: 600; color: var(--fg-muted); margin-bottom: 6px; display: block;
    }
    .fd-input-row { display: flex; gap: 8px; }
    .fd-input-row .fd-input { flex: 1; }

    /* 일괄 입력 토글 */
    .bulk-toggle {
      display: flex; align-items: center; gap: 8px;
      font-size: 14px; font-weight: 600; color: var(--fg-muted);
      cursor: pointer; padding: 8px 0; user-select: none;
      min-height: 44px; background: none; border: none; font-family: inherit;
    }
    .bulk-toggle svg { transition: transform 0.2s; }
    .bulk-toggle.open svg { transform: rotate(180deg); }
    .bulk-area { display: none; margin-top: 10px; }
    .bulk-area.open { display: block; }
    .bulk-hint {
      font-size: 14px; color: var(--fg-muted); margin-bottom: 6px; line-height: 1.5;
    }
    .bulk-hint code {
      font-family: 'JetBrains Mono', monospace; font-size: 13px;
      background: var(--border); padding: 1px 5px; border-radius: 4px; color: var(--fg);
    }

    /* 카드 목록 */
    .card-list { display: flex; flex-direction: column; gap: 8px; margin-top: 16px; }
    .card-row {
      display: grid; grid-template-columns: 1fr 1fr auto;
      gap: 8px; align-items: center;
      background: var(--bg); border: 1px solid var(--border);
      border-radius: 10px; padding: 10px 12px;
      animation: fadeUp 0.2s ease both;
    }
    .card-row-actions { display: flex; gap: 4px; align-items: center; }
    .fd-btn-icon:disabled { opacity: 0.25; cursor: default; pointer-events: none; }
    .card-row-front, .card-row-back {
      font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .card-row-front { font-weight: 600; color: var(--fg); }
    .card-row-back { color: var(--fg-muted); }
    .card-list-empty {
      text-align: center; padding: 24px; font-size: 14px; color: var(--fg-muted);
    }

    /* 학습 옵션 */
    .study-opts {
      display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 0;
    }
    .study-opt {
      display: flex; align-items: center; gap: 6px;
      padding: 6px 14px; min-height: 44px; background: var(--bg);
      border: 1px solid var(--border); border-radius: 8px;
      font-size: 14px; font-weight: 600; color: var(--fg-muted);
      cursor: pointer; transition: all 0.15s; font-family: inherit;
    }
    .study-opt.active { background: rgba(0,111,238,0.1); border-color: var(--primary); color: var(--primary); }

    /* ══════════════════════════════════
       학습 뷰
    ══════════════════════════════════ */
    #view-study .study-top {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 24px; gap: 12px;
    }
    .study-counter {
      font-size: 14px; font-weight: 700; color: var(--fg-muted);
    }
    .study-progress { margin-bottom: 20px; }

    /* 플립 카드 */
    .flip-scene:focus-visible { outline: 3px solid var(--primary); outline-offset: 4px; border-radius: 20px; }
    .flip-scene {
      perspective: 1200px;
      height: 340px;
      margin-bottom: 20px;
      cursor: pointer;
    }
    @media (max-width: 480px) { .flip-scene { height: 260px; } }

    /* 전체화면 모드 — .fd-view.active보다 specificity 높게 */
    .fd-view.study-fullscreen {
      display: flex !important; flex-direction: column;
      position: fixed; inset: 0; z-index: 10000;
      background: var(--bg);
      padding: 20px 24px;
      overflow: hidden;
    }
    .study-fullscreen .study-top  { flex-shrink: 0; margin-bottom: 16px; }
    .study-fullscreen .study-progress { flex-shrink: 0; margin-bottom: 16px; }
    .study-fullscreen .flip-scene {
      flex: 1 1 0; min-height: 0;
      margin-bottom: 16px;
    }
    .study-fullscreen #study-actions { flex-shrink: 0; }
    /* 전자칠판: 화면 크기에 맞춰 글자를 키움(뒤에서도 보이게) */
    .study-fullscreen .flip-face { padding: 56px 40px 52px; }
    .study-fullscreen .flip-face-label,
    .study-fullscreen .flip-face-hint { font-size: clamp(14px, 1.6vw, 20px); }
    .study-fullscreen .flip-text {
      font-size: max(18px, calc(clamp(28px, min(6vw, 10vh), 120px) * var(--len)));
    }
    .study-fullscreen .keyboard-hints { flex-shrink: 0; }

    /* 전체화면 진입 시 고정 오버레이 숨김 */
    body.fd-fullscreen .top-overlay,
    body.fd-fullscreen .top-overlay-left { display: none !important; }

    .btn-fullscreen {
      width: 44px; height: 44px; padding: 0;
      background: var(--card-bg); border: 1px solid var(--border);
      border-radius: 8px; cursor: pointer; color: var(--fg-muted);
      display: inline-flex; align-items: center; justify-content: center;
      transition: all 0.15s; flex-shrink: 0;
    }
    .btn-fullscreen:hover { border-color: var(--primary); color: var(--primary); }

    .flip-card {
      width: 100%; height: 100%;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .flip-card.flipped { transform: rotateY(180deg); }

    .flip-face {
      position: absolute; inset: 0;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 20px;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      /* 위 라벨·아래 안내 자리를 비워 글이 겹치지 않게 */
      padding: 48px 24px 44px;
      user-select: none;
    }
    .flip-face-back { transform: rotateY(180deg); }

    .flip-face-label {
      position: absolute; top: 16px; left: 20px;
      font-size: 14px; font-weight: 700; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--fg-muted);
    }
    .flip-face-hint {
      position: absolute; bottom: 16px;
      font-size: 14px; color: var(--fg-muted);
      display: flex; align-items: center; gap: 4px;
    }
    /* 글이 길면 --len으로 글자를 줄이고(JS), 그래도 넘치면 카드 안에서 스크롤 */
    .flip-text {
      --len: 1;
      font-size: max(15px, calc(clamp(18px, 4vw, 26px) * var(--len)));
      font-weight: 700; text-align: center; color: var(--fg);
      line-height: 1.4; word-break: keep-all; overflow-wrap: anywhere;
      white-space: pre-line;
      width: 100%; max-height: 100%; min-height: 0;
      overflow-y: auto; overscroll-behavior: contain;
    }
    .flip-text.len-m  { --len: 0.85; }
    .flip-text.len-l  { --len: 0.7; }
    .flip-text.len-xl { --len: 0.58; }
    .flip-face-back .flip-text { color: var(--primary); }

    /* 결과 버튼 */
    .study-actions {
      display: flex; gap: 10px;
      opacity: 0; pointer-events: none;
      transition: opacity 0.25s ease, transform 0.25s ease;
      transform: translateY(8px);
    }
    .study-actions.show {
      opacity: 1; pointer-events: auto; transform: translateY(0);
    }
    .study-actions .fd-btn { flex: 1; padding: 14px; font-size: 16px; min-height: 52px; }

    /* 키보드 힌트 */
    .keyboard-hints {
      display: flex; justify-content: center; gap: 16px; margin-top: 16px;
      flex-wrap: wrap;
    }
    .kbd-hint {
      display: flex; align-items: center; gap: 5px;
      font-size: 14px; color: var(--fg-muted);
    }
    /* 터치 기기에는 키보드가 없으니 단축키 안내를 숨김 */
    @media (hover: none) { .keyboard-hints { display: none; } }
    .kbd {
      display: inline-flex; gap: 2px; align-items: center; justify-content: center;
      background: var(--bg); border: 1px solid var(--border);
      border-radius: 5px; padding: 2px 7px; font-size: 13px;
      font-family: 'JetBrains Mono', monospace; color: var(--fg-muted);
      box-shadow: 0 1px 0 var(--border);
    }

    /* ══════════════════════════════════
       결과 뷰
    ══════════════════════════════════ */
    #view-result {
      text-align: center;
    }
    .result-icon { font-size: 56px; margin-bottom: 12px; color: var(--primary); display: flex; justify-content: center; }
    .result-icon .ic { stroke-width: 1.75; }
    .result-title { font-size: 22px; font-weight: 800; margin-bottom: 6px; }
    .result-sub { font-size: 14px; color: var(--fg-muted); margin-bottom: 28px; }

    .result-stats {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 12px; margin-bottom: 28px;
    }
    .result-stat {
      background: var(--card-bg); border: 1px solid var(--border);
      border-radius: 12px; padding: 16px 8px;
    }
    .result-stat-val {
      font-size: 24px; font-weight: 800; margin-bottom: 4px;
    }
    .result-stat-label { font-size: 14px; color: var(--fg-muted); font-weight: 600; }
    .result-stat.pass .result-stat-val { color: var(--success); }
    .result-stat.fail .result-stat-val { color: var(--danger); }

    .result-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

    /* ══════════════════════════════════
       애니메이션
    ══════════════════════════════════ */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes scaleIn {
      from { opacity: 0; transform: scale(0.95); }
      to   { opacity: 1; transform: scale(1); }
    }
    @keyframes popIn {
      0%   { transform: scale(0.9); opacity: 0; }
      60%  { transform: scale(1.04); }
      100% { transform: scale(1); opacity: 1; }
    }
    .result-icon { animation: popIn 0.5s cubic-bezier(0.4,0,0.2,1) both; }

    @keyframes spin { to { transform: rotate(360deg); } }
    .spinner {
      display: inline-block;
      width: 12px;
      height: 12px;
      border: 2px solid currentColor;
      border-top-color: transparent;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
      vertical-align: middle;
      margin-right: 4px;
    }


    /* ── 공유 드롭다운 ── */
    #share-dropdown {
      position: fixed; display: none; flex-direction: column;
      gap: 3px; padding: 6px; border-radius: 10px;
      background: var(--card-bg); border: 1px solid var(--border);
      z-index: 9500; min-width: 150px;
