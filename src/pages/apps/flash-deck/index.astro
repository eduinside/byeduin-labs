async function deleteDeck(id) {
  const deck = getData().decks.find(d => d.id === id);
  if (!deck) return;
  const ok = await VUI.confirm(`"${deck.name}" 덱을 삭제할까요?\n카드 ${deck.cards.length}장이 모두 사라집니다.`,
    { title: '덱 삭제', ok: '삭제', danger: true });
  if (!ok) return;
  const data = getData();   // 확인 창을 띄운 사이 바뀌었을 수 있어 다시 읽음
  data.decks = data.decks.filter(d => d.id !== id);
  saveData(data);
  renderHome();
}

