// ══════════════════════════════════════════════════════
//  학습 뷰
// ══════════════════════════════════════════════════════
let studyQueue = [];
let studyIndex = 0;
let studyResults = { pass: 0, fail: 0 };
let isFlipped = false;

function startStudy() {
  const deck = getActiveDeck();
  if (!deck || !deck.cards.length) return;

  let cards = [...deck.cards];
  if (studyOpt === 'unknown') cards = cards.filter(c => !c.mastered);
  if (!cards.length) { showToast('모르는 카드가 없어요. 전체 카드로 학습할게요.'); cards = [...deck.cards]; }
  if (shuffleOn) cards = cards.sort(() => Math.random() - 0.5);

  studyQueue = cards;
  studyIndex = 0;
  studyResults = { pass: 0, fail: 0 };
  isFlipped = false;  // 이전 세션 상태 초기화

  document.getElementById('study-deck-name').textContent = deck.name;
  showView('study');
  showStudyCard();
}

function showStudyCard() {
  if (studyIndex >= studyQueue.length) { showResult(); return; }
  const card = studyQueue[studyIndex];
  const total = studyQueue.length;

  setFlipText(document.getElementById('flip-front-text'), card.front);
  setFlipText(document.getElementById('flip-back-text'), card.back);
  document.getElementById('study-counter').textContent = `${studyIndex + 1} / ${total}`;
  document.getElementById('study-progress-fill').style.width = `${(studyIndex / total) * 100}%`;

  // 카드 초기화
  const fc = document.getElementById('flip-card');
  fc.style.transition = 'none';
  fc.classList.remove('flipped');
  setTimeout(() => { fc.style.transition = ''; }, 20);
  isFlipped = false;

  document.getElementById('study-actions').classList.remove('show');
  document.getElementById('flip-scene').setAttribute('aria-label', '카드 뒤집기');
  announce(`${studyIndex + 1}번째 카드 (${total}장 중). 앞면: ${card.front}`);
}

// 글이 길수록 글자를 줄임(CSS --len). 그래도 넘치면 카드 안에서 스크롤
function setFlipText(el, text) {
  const n = String(text).length;
  el.textContent = text;
  el.scrollTop = 0;
  el.classList.remove('len-m', 'len-l', 'len-xl');
  if (n > 140) el.classList.add('len-xl');
  else if (n > 60) el.classList.add('len-l');
  else if (n > 20) el.classList.add('len-m');
}

// 스크린리더: 카드 앞면·뒷면을 읽어 줌
function announce(msg) {
  const el = document.getElementById('fd-live');
  if (!el) return;
  el.textContent = '';
  setTimeout(() => { el.textContent = msg; }, 30);
}

function flipCard() {
  if (isFlipped) return;
  document.getElementById('flip-card').classList.add('flipped');
  isFlipped = true;
  document.getElementById('flip-scene').setAttribute('aria-label', '뒤집은 카드');
  const card = studyQueue[studyIndex];
  if (card) announce(`뒷면: ${card.back}. 알면 오른쪽 화살표, 모르면 왼쪽 화살표`);
  setTimeout(() => {
    document.getElementById('study-actions').classList.add('show');
  }, 300);
}

function markCard(pass) {
  if (!isFlipped) return;
  if (!viewOnlyData) {
    const data = getData();
    const deck = data.decks.find(d => d.id === currentDeckId);
    const card = deck.cards.find(c => c.id === studyQueue[studyIndex].id);
    if (card) {
      if (pass) { card.passCount = (card.passCount || 0) + 1; card.mastered = card.passCount >= 2; }
      else       { card.failCount = (card.failCount || 0) + 1; card.mastered = false; }
      deck.lastStudied = Date.now();
      saveData(data);
    }
  }
  if (pass) studyResults.pass++; else studyResults.fail++;
  studyIndex++;
  showStudyCard();
}

function exitStudy() {
  exitFullscreen();
  renderDeckView();
}

function restartStudy() {
  exitFullscreen();
  startStudy();
}

// ── 전체화면 ──
let isFullscreen = false;
function toggleFullscreen() {
  isFullscreen = !isFullscreen;
  _applyFullscreen();
  // 버튼 포커스 해제 → 키보드 단축키 정상 작동
  document.activeElement?.blur();
}
function exitFullscreen() {
  if (!isFullscreen) return;
  isFullscreen = false;
  _applyFullscreen();
}
function _applyFullscreen() {
  const studyEl = document.getElementById('view-study');
  studyEl.classList.toggle('study-fullscreen', isFullscreen);
  document.body.classList.toggle('fd-fullscreen', isFullscreen);
  document.body.style.overflow = isFullscreen ? 'hidden' : '';
  document.getElementById('fs-icon-expand').style.display   = isFullscreen ? 'none' : '';
  document.getElementById('fs-icon-compress').style.display = isFullscreen ? ''     : 'none';
  const fsBtn = document.getElementById('btn-fullscreen');
  fsBtn.setAttribute('aria-pressed', String(isFullscreen));
  fsBtn.setAttribute('aria-label', isFullscreen ? '전체화면 끝내기' : '전체화면');
}

// 키보드 단축키
document.addEventListener('keydown', e => {
  if (currentView !== 'study') return;
  if (e.key === 'Escape') { if (isFullscreen) exitFullscreen(); return; }
  if (e.ctrlKey || e.metaKey || e.altKey) return;
  // 버튼에 포커스가 있을 때 Space·Enter는 그 버튼을 누르게 둠(카드 자체는 뒤집기)
  const t = e.target;
  const onControl = t && t.closest && t.closest('button, a[href], input, textarea, select') ;
  if ((e.key === ' ' || e.key === 'Enter') && onControl) return;
  if (e.key === 'f' || e.key === 'F') { e.preventDefault(); toggleFullscreen(); return; }
  if (e.key === ' ' || e.key === 'ArrowUp' || (e.key === 'Enter' && t && t.id === 'flip-scene')) { e.preventDefault(); flipCard(); }
  else if (e.key === 'ArrowRight') { e.preventDefault(); markCard(true); }
  else if (e.key === 'ArrowLeft')  { e.preventDefault(); markCard(false); }
});

// ══════════════════════════════════════════════════════
//  결과 뷰
// ══════════════════════════════════════════════════════
function showResult() {
  // 전체화면이면 해제 후 결과 화면 표시
  exitFullscreen();

  // 학습 세션 완료 횟수 증가 (보기 전용 모드에서는 저장 안 함)
  if (!viewOnlyData) {
    const data = getData();
    const deck = data.decks.find(d => d.id === currentDeckId);
    if (deck) {
      deck.studyCount = (deck.studyCount || 0) + 1;
      saveData(data);
    }
  }

  const total = studyQueue.length;
  const pass  = studyResults.pass;
  const fail  = studyResults.fail;
  const pct   = total ? Math.round(pass / total * 100) : 0;

  // @icons party-popper smile dumbbell book-open
  let icon, title, sub;
  if (pct === 100) { icon = 'party-popper'; title = '완벽해요!'; sub = '모든 카드를 알았어요.'; }
  else if (pct >= 70) { icon = 'smile'; title = '잘 했어요!'; sub = `${fail}장만 더 복습하면 완벽해요.`; }
  else if (pct >= 40) { icon = 'dumbbell'; title = '조금 더 힘내요!'; sub = '모르는 카드를 다시 복습해 보세요.'; }
  else { icon = 'book-open'; title = '더 연습이 필요해요'; sub = '포기하지 말고 다시 도전해 보세요!'; }

  document.getElementById('result-icon').innerHTML = VUI.icon(icon);
  document.getElementById('result-title').textContent = title;
  document.getElementById('result-sub').textContent = sub;
  document.getElementById('result-stats').innerHTML = `
    <div class="result-stat">
      <div class="result-stat-val">${total}</div>
      <div class="result-stat-label">전체</div>
    </div>
    <div class="result-stat pass">
      <div class="result-stat-val">${pass}</div>
      <div class="result-stat-label">알아요</div>
    </div>
    <div class="result-stat fail">
      <div class="result-stat-val">${fail}</div>
      <div class="result-stat-label">모르겠어요</div>
    </div>`;
  document.getElementById('result-accuracy').textContent = `${pct}%`;
  showView('result');
  announce(`학습 끝. ${title} 전체 ${total}장 중 ${pass}장을 알아요, 정확도 ${pct}%`);
  // 진행률 바 애니메이션
  setTimeout(() => {
    document.getElementById('result-progress-fill').style.width = `${pct}%`;
  }, 100);
}

// ══════════════════════════════════════════════════════
//  유틸
// ══════════════════════════════════════════════════════
function esc(str) {
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ── 페이지 링크 공유 (우상단 공유 버튼) ──
function shareCurrentPage() {
  const url = location.href;
  const copy = () => VUI.share.copyOrShow(url, { title: '플래시 카드 링크' });
  if (navigator.share) {
    navigator.share({ title: '플래시 카드', url }).catch(err => { if (!err || err.name !== 'AbortError') copy(); });
  } else {
    copy();
  }
}

// ── 덱 이름 변경 ──
function _setRenameMode(on) {
  const titleEl    = document.getElementById('deck-view-title');
  const inputEl    = document.getElementById('deck-name-input');
  const renameBtn  = document.getElementById('btn-deck-rename');
  const shareBtn   = document.getElementById('btn-deck-share');
  const studyBtn   = document.getElementById('btn-start-study');
  if (on) {
    titleEl.style.display  = 'none';
    renameBtn.style.display = 'none';
    shareBtn.style.display  = 'none';
    studyBtn.style.display  = 'none';
    inputEl.style.display   = '';
  } else {
    inputEl.style.display   = 'none';
    titleEl.style.display   = '';
    renameBtn.style.display = '';
    shareBtn.style.display  = '';
    studyBtn.style.display  = '';
  }
}

function startRenameDeck() {
  const inputEl = document.getElementById('deck-name-input');
  inputEl.value = document.getElementById('deck-view-title').textContent;
  _setRenameMode(true);
  showToast('변경하면 자동으로 저장됩니다');
  inputEl.select();
  inputEl.focus();
}

function saveDeckName() {
  const inputEl = document.getElementById('deck-name-input');
  const titleEl = document.getElementById('deck-view-title');
  const newName = inputEl.value.trim();
  if (newName && newName !== titleEl.textContent) {
    const data = getData();
    const deck = data.decks.find(d => d.id === currentDeckId);
    if (deck) { deck.name = newName; saveData(data); }
    titleEl.textContent = newName;
  }
  _setRenameMode(false);
}

function handleDeckNameKey(e) {
  if (e.key === 'Enter')  { e.preventDefault(); saveDeckName(); }
  if (e.key === 'Escape') { _setRenameMode(false); }
}

// ── 카드 순서 변경 ──
function moveCard(cardId, direction) {
  if (viewOnlyData) return;
  const data = getData();
  const deck = data.decks.find(d => d.id === currentDeckId);
  if (!deck) return;
  const idx = deck.cards.findIndex(c => c.id === cardId);
  const newIdx = idx + direction;
  if (newIdx < 0 || newIdx >= deck.cards.length) return;
  [deck.cards[idx], deck.cards[newIdx]] = [deck.cards[newIdx], deck.cards[idx]];
  saveData(data);
  renderDeckView();
}

// ── 토스트 (공용 VUI) ──
function showToast(msg, type) { VUI.toast(msg, type); }

// ── 공유 인코딩/디코딩 (vives-share Step 2) ──
// 새 링크: UTF-8 base64url(VUI.share.encode, 한글이 약 3배 짧음).
// 받는 쪽: VUI.share.decode가 새 형식·옛 형식(btoa(encodeURIComponent)·btoa) 모두 읽음
function buildShareURL(deck, permission) {
  const encoded = VUI.share.encode({
    data: { name: deck.name, cards: deck.cards.map(c => ({ front: c.front, back: c.back })) },
    permission,
  });
  return `${location.origin}/apps/flash-deck/#share=${encoded}`;
}

function decodeSharePayload(encoded) {
  const p = VUI.share.decode(encoded, o => o && o.data && Array.isArray(o.data.cards));
  if (!p) return null;
  // 외부 입력: 글자로만 다시 만들고 길이를 제한
  const str = (v, n) => String(v == null ? '' : v).slice(0, n);
  const cards = p.data.cards
    .filter(c => c && typeof c === 'object' && (c.front != null) && (c.back != null))
    .slice(0, 2000)
    .map(c => ({ front: str(c.front, 1000), back: str(c.back, 1000) }))
    .filter(c => c.front.trim() && c.back.trim());
  return {
    permission: p.permission === 'view' ? 'view' : 'clone',
    data: { name: str(p.data.name, 60).trim() || '공유된 덱', cards },
  };
}

// QR 라이브러리: 복사가 안 될 때 보여 주는 링크 창에서 QR을 그림(공유 메뉴를 열 때 미리 받음)
let _qrPromise = null;
function loadQR() {
  if (window.QRCode) return Promise.resolve(true);
  if (_qrPromise) return _qrPromise;
  _qrPromise = new Promise(resolve => {
    const sc = document.createElement('script');
    sc.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
    sc.async = true;
    sc.onload = () => resolve(true);
    sc.onerror = () => { _qrPromise = null; resolve(false); };
    document.head.appendChild(sc);
  });
  return _qrPromise;
}

// ── 공유 드롭다운 토글 (vives-share Step 4) ──
let _shareMenuOpen = false;
function toggleShareMenu(e) {
  if (currentView !== 'deck') { showToast('덱 뷰에서만 공유할 수 있어요.'); return; }
  const deck = getActiveDeck();
  if (!deck || !deck.cards.length) { showToast('카드가 없는 덱은 공유할 수 없어요.'); return; }
  e.stopPropagation();
  const dd = document.getElementById('share-dropdown');
  const rect = e.currentTarget.getBoundingClientRect();
  dd.style.top = (rect.bottom + 6) + 'px';
  dd.style.right = Math.max(8, window.innerWidth - rect.right) + 'px';
  _shareMenuOpen = !_shareMenuOpen;
  dd.classList.toggle('open', _shareMenuOpen);
  document.getElementById('btn-deck-share').setAttribute('aria-expanded', String(_shareMenuOpen));
  if (_shareMenuOpen) {
    loadQR();
    const first = dd.querySelector('.share-opt');
    if (first) first.focus();
    setTimeout(() => document.addEventListener('click', _closeShareMenu, { once: true }), 0);
  }
}
function _closeShareMenu() {
  document.getElementById('share-dropdown').classList.remove('open');
  document.getElementById('btn-deck-share').setAttribute('aria-expanded', 'false');
  _shareMenuOpen = false;
}
document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && _shareMenuOpen) { _closeShareMenu(); document.getElementById('btn-deck-share').focus(); }
});

// ── doShare — 단축 + 복사, 복사가 안 되면 링크·QR 창 (vives-share Step 3) ──
async function doShare(permission) {
  _closeShareMenu();
  const deck = getActiveDeck();
  if (!deck) return;
  const longURL = buildShareURL(deck, permission);
  const btn = document.getElementById('btn-deck-share');
  if (btn) btn.disabled = true;
  try {
    await Promise.race([loadQR(), new Promise(r => setTimeout(r, 1500))]);
    await VUI.share.link(longURL, {
      title: '덱 공유',
      desc: permission === 'view' ? '받는 사람은 저장하지 않고 학습만 할 수 있어요.' : '받는 사람이 자기 덱으로 복제할 수 있어요.',
    });
  } finally { if (btn) btn.disabled = false; }
}

// ── 보기 전용 진입/종료 (vives-share Step 6) ──
function enterViewOnly(data) {
  if (!data) return;
  viewOnlyData = {
    id: '__shared__', name: data.name,
    createdAt: Date.now(), lastStudied: null, studyCount: 0,
    cards: data.cards.map(c => ({ id: uid(), front: c.front, back: c.back, mastered: false, passCount: 0, failCount: 0 }))
  };
  document.body.classList.add('is-view-only');
  shareCloneModal.close();
  _pendingShared = null;
  currentDeckId = '__shared__';
  renderDeckView();
}

function exitViewOnly() {
  viewOnlyData = null;
  document.body.classList.remove('is-view-only');
}

// ── 복제 허용 모달 (vives-share Step 7) ──
function openShareCloneModal(data) {
  _pendingShared = data;
  document.getElementById('share-clone-deck-name').textContent = data.name;
  document.getElementById('share-clone-meta').textContent = `카드 ${data.cards.length}장`;
  shareCloneModal.open();
}

function closeShareCloneModal() {
  shareCloneModal.close();
  _pendingShared = null;
}

function cloneAndOpen() {
  const src = _pendingShared || viewOnlyData;
  if (!src) return;
  exitViewOnly();
  _pendingShared = null;
  shareCloneModal.close();
  const data = getData();
  const copy = {
    id: uid(), name: `[사본] ${src.name}`,
    createdAt: Date.now(), lastStudied: null, studyCount: 0,
    cards: src.cards.map(c => ({ id: uid(), front: c.front, back: c.back, mastered: false, passCount: 0, failCount: 0 }))
  };
  data.decks.push(copy); saveData(data);
  openDeck(copy.id);
  showToast(`"${copy.name}"이 저장되었습니다.`);
}

// ══════════════════════════════════════════════════════
//  INIT (vives-share Step 5)
// ══════════════════════════════════════════════════════
(function init() {
  const hash = location.hash;
  if (hash.startsWith('#share=')) {
    const payload = decodeSharePayload(hash.slice(7));
    history.replaceState(null, '', location.pathname);
    renderHome();
    if (payload && payload.data && Array.isArray(payload.data.cards) && payload.data.cards.length > 0) {
      if (payload.permission === 'view') {
        enterViewOnly(payload.data);
        showToast('보기 전용으로 열립니다');
      } else {
        openShareCloneModal(payload.data);
      }
      return;
    }
    showToast('공유 링크를 읽을 수 없어요. 링크가 잘렸는지 확인해 주세요.', 'error');
    return;
  }
  // 덱이 없으면 홈의 빈 상태 카드가 '새 덱 만들기'·'AI로 카드 만들기'를 안내(창을 자동으로 띄우지 않음)
  renderHome();
})();

// 선택 동기화: 헤더 '동기화' 버튼 + 코드 패널 (코드 연결 시 덱을 기기 간 이어쓰기)
VivesSync.mountDocSync({
  apiUrl: '/api/flash-deck',
  keys: [STORAGE_KEY],
  appName: '카드 덱',
  onApplied: () => { if (currentView === 'home') renderHome(); else if (currentView === 'deck') renderDeckView(); },
});
</script>



