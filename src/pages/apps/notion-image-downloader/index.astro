---
import AppLayout from '../../../layouts/AppLayout.astro';
---
<AppLayout 
  icons
  title="Notion Image DL — eduin VIVES"
  description="Notion 데이터베이스의 이미지를 한 번에 다운로드. 만료된 URL도 자동 처리."
  image="https://eduin.info/og-images/notion-image-downloader.png"
  bodyShell="column"
  bodyWidth="narrow"
>
  <Fragment slot="head">
    <style is:global="">
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap');

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  /* 라이트/다크 양쪽 지원 — hero-theme.css 변수 매핑 */
  :root,
  [data-theme="light"] {
    --surface:  var(--card-bg);
    --surface2: var(--bg-sec);
    --accent:        var(--primary);
    --accent-dim:    rgba(0,111,238,0.1);
    --accent-hover:  var(--primary-h);
    --text:      var(--fg);
    --text-dim:  var(--fg-muted);
    --text-muted:#a1a1aa;
    --success: #17c964;
    --warn:    #f5a524;
    --error:   #f31260;
    --radius:  12px;
  }

  [data-theme="dark"] {
    --surface:  #18181b;
    --surface2: #222228;
    --text-muted: #55556a;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
    background: var(--bg);
    color: var(--text);
  }
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(124,106,247,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(124,106,247,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  .wrap { width: 100%; max-width: 580px; position: relative; z-index: 1; }

  .header { margin-bottom: 40px; }
  .badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--accent-dim); border: 1px solid rgba(124,106,247,0.3);
    color: var(--accent-hover); font-size: 11px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    padding: 4px 10px; border-radius: 99px; margin-bottom: 14px;
  }
  .badge::before { content: '◆'; font-size: 8px; }
  h1 { font-size: 28px; font-weight: 700; line-height: 1.25; letter-spacing: -0.03em; }
  h1 span { color: var(--accent-hover); }
  .desc { margin-top: 10px; font-size: 14px; color: var(--text-dim); line-height: 1.6; }

  .card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 24px; margin-bottom: 16px;
  }
  .card-title {
    font-size: 11px; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--text-muted); margin-bottom: 16px;
    display: flex; align-items: center; gap: 8px;
  }
  .card-title::after { content: ''; flex: 1; height: 1px; background: var(--border); }

  label { display: block; font-size: 13px; font-weight: 500; color: var(--text-dim); margin-bottom: 6px; }
  input[type="text"], input[type="password"] {
    width: 100%; background: var(--bg); border: 1px solid var(--border);
    border-radius: 8px; padding: 12px 14px; font-size: 16px;
    font-family: 'JetBrains Mono', monospace; color: var(--text);
    outline: none; transition: border-color 0.2s; margin-bottom: 14px;
  }
  input:focus { border-color: var(--accent); }
  input::placeholder { color: var(--text-muted); }

  .hint { font-size: 11.5px; color: var(--text-muted); line-height: 1.6; margin-top: -10px; margin-bottom: 14px; }
  .hint a { color: var(--accent); text-decoration: none; }
  .hint a:hover { text-decoration: underline; }

  /* 보안 안내 */
  .security-note {
    display: flex; align-items: flex-start; gap: 10px;
    background: rgba(124,106,247,0.07); border: 1px solid rgba(124,106,247,0.2);
    border-radius: 8px; padding: 12px 14px; margin-bottom: 14px;
    font-size: 12px; color: var(--text-dim); line-height: 1.6;
  }
  .security-note .icon { color: var(--accent); font-size: 14px; flex-shrink: 0; margin-top: 1px; }

  .options { display: flex; gap: 8px; margin-bottom: 4px; }
  .opt-btn {
    flex: 1; padding: 8px; min-height: 44px; background: var(--bg);
    border: 1px solid var(--border); border-radius: 8px;
    color: var(--text-muted); font-size: 14px;
    font-family: 'Noto Sans KR', sans-serif; cursor: pointer;
    transition: all 0.15s; text-align: center;
  }
  .opt-btn.active { background: var(--accent-dim); border-color: var(--accent); color: var(--accent-hover); font-weight: 700; }

  .btn-run {
    width: 100%; padding: 14px; background: var(--accent);
    border: none; border-radius: 10px; color: #fff; font-size: 16px;
    font-weight: 700; font-family: inherit;
    cursor: pointer; transition: background 0.15s, transform 0.1s;
    letter-spacing: -0.01em; min-height: 48px;
  }
  .btn-run:hover { background: var(--accent-hover); }
  .btn-run:active { transform: scale(0.99); }
  .btn-run:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

  .progress-wrap { margin-bottom: 16px; display: none; }
  .progress-bar-bg { height: 4px; background: var(--border); border-radius: 99px; overflow: hidden; margin-bottom: 10px; }
  .progress-bar { height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent-hover)); border-radius: 99px; width: 0%; transition: width 0.3s ease; }
  .progress-text { font-size: 12px; color: var(--text-dim); font-family: 'JetBrains Mono', monospace; }

  .log-wrap { display: none; }
  .log-header { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
  .log-header::after { content: ''; flex: 1; height: 1px; background: var(--border); }
  .log {
    background: var(--bg); border: 1px solid var(--border);
    border-radius: 8px; padding: 12px 14px;
    font-family: 'JetBrains Mono', monospace; font-size: 12px;
    color: var(--text-dim); max-height: 260px; overflow-y: auto; line-height: 1.8;
  }
  .log-item { display: flex; gap: 8px; }
  .log-item.ok .log-icon { color: var(--success); }
  .log-item.skip .log-icon { color: var(--warn); }
  .log-item.err .log-icon { color: var(--error); }
  .log-item.info .log-icon { color: var(--accent); }

  .summary {
    display: none; background: rgba(74,222,128,0.08);
    border: 1px solid rgba(74,222,128,0.25); border-radius: var(--radius);
    padding: 14px 18px; font-size: 13px; color: var(--success);
    text-align: center; font-weight: 600; margin-bottom: 16px;
  }

  .guide {
    background: var(--surface2); border: 1px solid var(--border);
    border-left: 3px solid var(--accent); border-radius: var(--radius);
    padding: 16px 20px; margin-bottom: 16px;
  }
  .guide-title { font-size: 12px; font-weight: 700; color: var(--accent-hover); margin-bottom: 10px; }
  .guide ol { padding-left: 18px; }
  .guide li { font-size: 13px; color: var(--text-dim); line-height: 1.7; margin-bottom: 4px; }
  .guide li code { font-family: 'JetBrains Mono', monospace; font-size: 11.5px; background: var(--border); padding: 1px 5px; border-radius: 4px; color: var(--text); }
  .guide a { color: var(--accent); text-decoration: none; }
  .guide a:hover { text-decoration: underline; }
</style>
  <script type="application/ld+json" is:inline="">{"@context":"https://schema.org","@type":"WebApplication","name":"Notion Image DL","description":"Notion 데이터베이스의 이미지를 한 번에 다운로드. 만료된 URL도 자동 처리.","url":"https://eduin.info/apps/notion-image-downloader/","applicationCategory":"EducationApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"KRW"},"isPartOf":{"@type":"WebSite","name":"eduin VIVES","url":"https://eduin.info"}}</script>
  </Fragment>


<!-- 플로팅 크롬(홈·테마·공유)은 app-shell.js가 주입 -->
<div class="wrap app-main">

  <div class="app-header">
    <div class="app-badge">◆ Notion Tool</div>
    <h1 class="app-title">
  <div class="card-emoji sub-util-notion" style="margin-bottom: 0; transform: scale(1.0);">
        <i data-lucide="download"></i>
      </div>
  <span>이미지 <span>일괄 다운로드</span></span>
</h1>
    <p class="app-desc">노션 DB의 이미지를 JPG / PNG로 변환해 한 번에 저장합니다.</p>
  </div>

  <div class="guide">
    <div class="guide-title">📋 사용 전 준비 (최초 1회)</div>
    <ol>
      <li><a href="https://www.notion.so/profile/integrations" target="_blank">노션 인테그레이션 페이지</a>에서 새 인테그레이션을 만들고 <code>secret_...</code> 토큰을 복사합니다.</li>
      <li>대상 DB 페이지 우측 상단 <code>···</code> → 연결 추가에서 만든 인테그레이션을 연결합니다.</li>
      <li>DB URL에서 ID를 복사합니다. <code>notion.so/.../[여기 32자리]?v=...</code></li>
    </ol>
  </div>

  <div class="card">
    <div class="card-title">설정</div>

    <label for="token">노션 API 토큰</label>
    <input type="password" id="token" placeholder="secret_xxxxxxxxxxxxxxxxxxxx" autocomplete="off" aria-describedby="tokenNote">

    <div class="security-note" id="tokenNote">
      <span class="icon" aria-hidden="true">🔒</span>
      <span>토큰은 브라우저에서 이 서버의 프록시 함수로만 전달되며, 서버에 저장되거나 로그에 기록되지 않습니다.</span>
    </div>

    <label for="dbid">데이터베이스 ID</label>
    <input type="text" id="dbid" placeholder="32자리 영문+숫자" aria-describedby="dbidHint">
    <p class="hint" id="dbidHint">URL에서 <code>?v=</code> 앞의 32자리 문자열</p>

    <label id="fmtLabel">저장 형식</label>
    <div class="options" role="group" aria-labelledby="fmtLabel">
      <button type="button" class="opt-btn active" onclick="setFmt('jpg', this)" aria-pressed="true">JPG</button>
      <button type="button" class="opt-btn" onclick="setFmt('png', this)" aria-pressed="false">PNG</button>
    </div>
  </div>

  <div class="progress-wrap" id="progressWrap">
    <div class="progress-bar-bg"><div class="progress-bar" id="progressBar"></div></div>
    <div class="progress-text" id="progressText" role="status" aria-live="polite">준비 중...</div>
  </div>

  <div class="summary" id="summary" role="status" aria-live="polite"></div>

  <div class="log-wrap" id="logWrap">
    <div class="log-header" id="logLabel">진행 로그</div>
    <div class="log" id="log" role="log" aria-labelledby="logLabel" tabindex="0"></div>
  </div>

  <button type="button" class="btn-run" id="runBtn" onclick="run()">⬇ 이미지 다운로드 시작</button>

</div>
<script is:inline="">
// 토큰은 이 변수에만 머물고, Function 호출 후 응답이 오면 메모리에서 사라짐
let fmt = 'jpg';

function setFmt(f, el) {
  fmt = f;
  document.querySelectorAll('.opt-btn').forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
  el.classList.add('active');
  el.setAttribute('aria-pressed', 'true');
}

function addLog(type, icon, msg) {
  const log = document.getElementById('log');
  const item = document.createElement('div');
  item.className = `log-item ${type}`;
  item.innerHTML = `<span class="log-icon">${icon}</span><span></span>`;
  item.querySelector('span:last-child').textContent = msg;   // 노션 제목·오류문은 텍스트로만 표시
  log.appendChild(item);
  log.scrollTop = log.scrollHeight;
}

function setProgress(cur, total, msg) {
  const pct = total > 0 ? Math.round((cur / total) * 100) : 0;
  document.getElementById('progressBar').style.width = pct + '%';
  document.getElementById('progressText').textContent = msg;
}

// 자체 서버 프록시(/api/notion) 호출 (토큰은 body에 담겨 HTTPS로만 전송)
// 공용 VUI.apiFetch: 시간 제한·오프라인·5xx를 한국어로. 노션 고유 상태(401·404)와 노션 오류문은 따로 안내
async function notionCall(token, path, payload) {
  try {
    return await VUI.apiFetch('/api/notion', { json: { token, path, payload }, timeout: 30000 });
  } catch (e) {
    if (!e.status) throw e;   // 네트워크·시간 초과: 공용 문구 그대로
    const data = e.data;
    const notionMsg = (data && (data.message || data.code)) || null;
    if (e.status === 404) {
      e.message = notionMsg
        ? `DB를 찾을 수 없음: ${notionMsg}`
        : '404 — DB ID가 잘못됐거나 인테그레이션이 DB에 연결되지 않았습니다. (Notion 워크스페이스 → DB → ··· → 연결 추가)';
    } else if (e.status === 401) {
      e.message = '401 — 토큰이 잘못됐거나 만료됐습니다. 인테그레이션 토큰을 다시 확인해 주세요.';
    } else if (notionMsg && e.status !== 429) {
      e.message = `Notion 오류 ${e.status}: ${notionMsg}`;
    }
    throw e;
  }
}

async function getAllPages(token, dbId) {
  const pages = [];
  let cursor = null;
  do {
    const data = await notionCall(token, `/v1/databases/${dbId}/query`, { page_size: 100, ...(cursor ? { start_cursor: cursor } : {}) });
    pages.push(...data.results);
    cursor = data.has_more ? data.next_cursor : null;
  } while (cursor);
  return pages;
}

function getTitle(page) {
  for (const prop of Object.values(page.properties || {})) {
    if (prop.type === 'title' && prop.title?.length) {
      return prop.title[0].plain_text.replace(/[\\/*?:"<>|]/g, '_').trim() || page.id;
    }
  }
  return page.id;
}

function getImageUrlsFromProps(page) {
  const urls = [];
  for (const prop of Object.values(page.properties || {})) {
    if (prop.type === 'files') {
      for (const f of prop.files || []) {
        if (f.type === 'file') urls.push(f.file.url);
        else if (f.type === 'external') urls.push(f.external.url);
      }
    }
  }
  return urls;
}

// 노션은 블록을 한 번에 100개까지만 돌려준다. has_more면 start_cursor로 다음 묶음을 요청한다.
// 단, 서버 프록시(functions/api/notion.js)가 경로 뒤 쿼리(?start_cursor=)를 아직 허용하지 않으면
// 두 번째 요청이 거절되므로, 그때는 앞의 100개만 쓰고 로그로 알린다.
async function getImageUrlsFromBlocks(token, pageId, title) {
  const urls = [];
  let cursor = null, first = true;
  try {
    do {
      const path = `/v1/blocks/${pageId}/children` +
        (cursor ? `?start_cursor=${encodeURIComponent(cursor)}&page_size=100` : '');
      let data;
      try {
        data = await notionCall(token, path);
      } catch (e) {
        if (!first) addLog('skip', '–', `[${title}] 블록이 100개를 넘어 뒤쪽 본문 이미지는 읽지 못했습니다.`);
        break;
      }
      first = false;
      for (const block of data.results || []) {
        if (block.type === 'image') {
          const img = block.image;
          if (img.type === 'file') urls.push(img.file.url);
          else if (img.type === 'external') urls.push(img.external.url);
        }
      }
      cursor = data.has_more && data.next_cursor ? data.next_cursor : null;
    } while (cursor);
  } catch (_) {}
  return urls;
}

async function downloadAsBlob(imgUrl) {
  const r = await VUI.apiFetch(imgUrl, { as: 'response', timeout: 60000 });
  return r.blob();
}

// fillWhite: JPG에는 투명이 없어 투명 PNG가 검은 배경이 되므로 흰색을 먼저 깐다
function blobToCanvas(blob, fillWhite) {
  return new Promise((res, rej) => {
    const img = new Image();
    const url = URL.createObjectURL(blob);
    img.onload = () => {
      const c = document.createElement('canvas');
      c.width = img.naturalWidth; c.height = img.naturalHeight;
      const ctx = c.getContext('2d');
      if (fillWhite) { ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, c.width, c.height); }
      ctx.drawImage(img, 0, 0);
      URL.revokeObjectURL(url);
      res(c);
    };
    img.onerror = (e) => { URL.revokeObjectURL(url); rej(e); };
    img.src = url;
  });
}

function canvasToBlob(canvas, format) {
  return new Promise(res => canvas.toBlob(res, format === 'jpg' ? 'image/jpeg' : 'image/png', 0.92));
}

function triggerDownload(blob, filename) {
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
}

async function run() {
  const token = document.getElementById('token').value.trim();
  const dbId  = document.getElementById('dbid').value.trim().replace(/-/g, '');

  if (!token || !dbId) {
    VUI.toast('토큰과 DB ID를 모두 입력해 주세요.', 'error');
    document.getElementById(token ? 'dbid' : 'token').focus();
    return;
  }

  const btn = document.getElementById('runBtn');
  btn.disabled = true;
  btn.textContent = '처리 중...';

  document.getElementById('progressWrap').style.display = 'block';
  document.getElementById('logWrap').style.display = 'block';
  document.getElementById('summary').style.display = 'none';
  document.getElementById('log').innerHTML = '';

  let saved = 0, skipped = 0, failed = 0;

  try {
    addLog('info', '◆', 'DB 항목 불러오는 중...');
    const pages = await getAllPages(token, dbId);
    addLog('info', '◆', `총 ${pages.length}개 항목 발견`);

    for (let i = 0; i < pages.length; i++) {
      const page  = pages[i];
      const title = getTitle(page);
      setProgress(i + 1, pages.length, `처리 중... ${i + 1} / ${pages.length}`);

      const propUrls  = getImageUrlsFromProps(page);
      const blockUrls = await getImageUrlsFromBlocks(token, page.id, title);
      const allUrls   = [...propUrls, ...blockUrls];

      if (!allUrls.length) {
        addLog('skip', '–', `[${title}] 이미지 없음`);
        skipped++;
        continue;
      }

      for (let j = 0; j < allUrls.length; j++) {
        try {
          const blob   = await downloadAsBlob(allUrls[j]);
          const canvas = await blobToCanvas(blob, fmt === 'jpg');
          const out    = await canvasToBlob(canvas, fmt);
          const fname  = allUrls.length === 1
            ? `${title}.${fmt}`
            : `${title}_${String(j + 1).padStart(3, '0')}.${fmt}`;
          triggerDownload(out, fname);
          addLog('ok', '✓', fname);
          saved++;
          await new Promise(r => setTimeout(r, 300));
        } catch (e) {
          addLog('err', '✗', `[${title}] 이미지 ${j + 1} 실패${e && e.code ? ' — ' + e.message : ''}`);
          failed++;
        }
      }
    }

    const sumEl = document.getElementById('summary');
    sumEl.style.display = 'block';
    sumEl.textContent = `완료! 저장 ${saved}개 · 이미지 없음 ${skipped}개 · 실패 ${failed}개`;

  } catch (e) {
    addLog('err', '✗', `오류: ${e.message}`);
  }

  // 실행 완료 후 토큰 입력란 초기화 (메모리에서 제거)
  document.getElementById('token').value = '';
  btn.disabled = false;
  btn.textContent = '⬇ 이미지 다운로드 시작';
}
</script>




</AppLayout>
