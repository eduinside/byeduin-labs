    #blank.show-none #blank-time { display: none; }
    body.blank-on .top-overlay, body.blank-on .top-overlay-left, body.blank-on .vs-sync-panel, body.blank-on .vs-sync-btn { visibility: hidden !important; }

    /* 로그 */
