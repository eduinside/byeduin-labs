    .set-line { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .set-line > label:first-child { min-width: 7.5em; font-weight: 600; font-size: 0.9rem; }
    .seg { display: inline-flex; flex-wrap: wrap; gap: 4px; }
    .seg label { position: relative; }
    .seg input { position: absolute; opacity: 0; width: 1px; height: 1px; }
    .seg span { display: inline-flex; align-items: center; min-height: 40px; padding: 4px 12px; border-radius: 0.6rem; border: 1px solid var(--border); background: var(--card-bg); font-size: 0.88rem; font-weight: 600; cursor: pointer; }
    .seg input:checked + span { background: var(--primary); color: #fff; border-color: var(--primary); }
    .seg input:focus-visible + span { outline: 2px solid var(--primary); outline-offset: 2px; }
    @media (pointer: coarse) { .seg span { min-height: 44px; } }
    .swatches { display: flex; gap: 8px; }
