---
import AppLayout from '../../../layouts/AppLayout.astro';
import Icon from '../../../components/Icon.astro';

const DESC = "수업 카운트다운, 우리 학교 시정에 맞춘 종소리, 요일별 알람, 화면 가리기, 쉬는 시간 음악까지 교실 시간 관리를 한 화면에서 해요. 시정표 사진을 찍으면 AI가 표로 채워 줘요.";
---
<AppLayout
  sync
  title="스마트 타이머 — eduin VIVES"
  description={DESC}
  image="https://eduin.info/og-images/timer.png"
  bodyShell="column"
  bodyWidth="narrow"
>
  <Fragment slot="head">
  <style is:global="">
    body {
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      align-items: center;
      /* 하단 고정 바 높이(--bar-h, 스크립트가 실제 높이로 맞춤)만큼 아래 여백 — 마지막 요소가 바에 가리지 않게 */
      --bar-h: 76px;
      --bar-gap: calc(20px + env(safe-area-inset-bottom, 0px));
      padding: 48px 1rem calc(var(--bar-h) + var(--bar-gap) + 16px);
      /* 공용 토스트를 아래 고정 바 위로 올림 */
      --vui-toast-bottom: calc(var(--bar-h) + 32px);
      --cd-ok: var(--success);
      --cd-mid: var(--warning);
      --cd-low: var(--danger);
    }
    body.player-open { --vui-toast-bottom: calc(var(--bar-h) + 104px); padding-bottom: calc(var(--bar-h) + var(--bar-gap) + 300px); }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(124,106,247,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(124,106,247,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 0;
    }

    .timer-wrap {
      width: 100%;
      max-width: 560px;
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* 시계 + 시정 안내 */
    .clock-section { text-align: center; margin: 0 0 1rem; width: 100%; }
    #main-clock {
      font-size: clamp(2.4rem, 9vw, 3.8rem);
      font-weight: 700;
      letter-spacing: -0.04em;
      font-variant-numeric: tabular-nums;
      line-height: 1;
    }
    #main-date { font-size: 0.95rem; color: var(--fg-muted); margin-bottom: 0.375rem; }
    .tt-status {
      display: inline-flex; align-items: center; gap: 6px;
      margin-top: 0.6rem; padding: 6px 14px; border-radius: 999px;
      background: color-mix(in srgb, var(--primary) 10%, transparent);
      color: var(--primary); font-weight: 700; font-size: 1rem;
      border: 1px solid color-mix(in srgb, var(--primary) 25%, transparent);
      max-width: 100%; word-break: keep-all;
    }
    .tt-status.muted { background: transparent; color: var(--fg-muted); font-weight: 600; font-size: 0.85rem; border-style: dashed; border-color: var(--border); cursor: pointer; font-family: inherit; min-height: 36px; }
    .tt-status[hidden] { display: none; }
    #next-alarm { font-size: 0.82rem; color: var(--fg-muted); font-weight: 600; margin-top: 0.4rem; min-height: 1.2em; }

    /* 메인 카드 */
    .main-card {
      width: 100%;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 1.5rem;
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      margin-bottom: 0;
    }
    @media (max-width: 420px) { .main-card { padding: 0.875rem; border-radius: 1.1rem; } }

    /* 큰 탭(카운트다운·시정·알람·음악) */
    .main-tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; padding: 4px; background: var(--bg); border: 1px solid var(--border); border-radius: 1rem; margin-bottom: 1rem; }
    .main-tab {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      min-height: 48px; padding: 6px 4px; border: none; border-radius: 0.75rem;
      background: transparent; color: var(--fg-muted); font: inherit; font-size: 0.9rem; font-weight: 700;
      cursor: pointer; word-break: keep-all; transition: background 0.15s, color 0.15s;
    }
    .main-tab:hover { color: var(--fg); }
    .main-tab[aria-selected="true"] { background: var(--primary); color: #fff; }
    @media (max-width: 480px) {
      .main-tab { flex-direction: column; gap: 2px; font-size: 0.78rem; min-height: 54px; }
    }
    .panel[hidden], .timer-wrap [hidden] { display: none !important; }
    .panel { display: flex; flex-direction: column; gap: 1rem; }
    .sec-title { font-size: 0.85rem; font-weight: 700; color: var(--fg-muted); margin: 0; display: flex; align-items: center; gap: 6px; }
    .row-wrap { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .note { font-size: 0.82rem; color: var(--fg-muted); line-height: 1.55; margin: 0; }
    .note .ic { vertical-align: -0.15em; }
    .note.warn { color: var(--fg); background: color-mix(in srgb, var(--warning) 14%, transparent); border: 1px solid color-mix(in srgb, var(--warning) 45%, transparent); padding: 8px 12px; border-radius: 0.75rem; }
    .note.err { color: var(--danger); }
    .field-label { display: block; font-size: 0.85rem; font-weight: 600; color: var(--fg-muted); margin-bottom: 0.375rem; }

    /* ── 카운트다운 ── */
    .preset-row { display: flex; flex-wrap: wrap; gap: 8px; }
    .preset-btn {
      display: inline-flex; flex-direction: column; align-items: flex-start; justify-content: center;
      min-height: 56px; padding: 6px 14px 6px 12px; border-radius: 0.85rem;
      border: 1px solid var(--border); border-left: 5px solid var(--pc, var(--primary));
      background: var(--bg); color: var(--fg); font: inherit; cursor: pointer; text-align: left;
    }
    .preset-btn:hover { border-color: var(--pc, var(--primary)); }
    .preset-btn b { font-size: 0.95rem; }
    .preset-btn small { font-size: 0.78rem; color: var(--fg-muted); display: inline-flex; align-items: center; gap: 4px; }
    .quick-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .quick-btn {
      min-height: 72px; border-radius: 1rem; border: 1px solid var(--border); background: var(--bg); color: var(--fg);
      font: inherit; font-size: 1.35rem; font-weight: 800; cursor: pointer; font-variant-numeric: tabular-nums;
    }
    .quick-btn small { display: block; font-size: 0.75rem; font-weight: 600; color: var(--fg-muted); }
    .quick-btn:hover { border-color: var(--primary); color: var(--primary); }
    .custom-row { display: grid; grid-template-columns: 1fr 1fr 1.4fr; gap: 8px; align-items: end; }
    .custom-row .hero-input { text-align: center; font-size: 1.25rem; font-weight: 700; padding: 0.6rem 0.5rem; min-height: 56px; }
    .custom-row .hero-btn { min-height: 56px; padding: 0.6rem 0.75rem; }

    .cd-stage {
      position: relative; display: flex; flex-direction: column; align-items: center; gap: 0.75rem;
      background: var(--bg); border: 1px solid var(--border); border-radius: 1.25rem; padding: 1rem 0.75rem 1rem;
      container-type: inline-size;
      --cdc: var(--cd-ok);
    }
    .cd-stage[hidden] { display: none; }
    .cd-stage.mid { --cdc: var(--cd-mid); }
    .cd-stage.low { --cdc: var(--cd-low); }
    .cd-label { font-size: 1rem; font-weight: 700; color: var(--fg-muted); min-height: 1.4em; text-align: center; }
    .cd-dial { position: relative; width: 100%; display: grid; place-items: center; }
    .cd-time {
      font-size: clamp(3.5rem, 24cqw, 11rem); font-weight: 800; line-height: 1; letter-spacing: -0.03em;
      font-variant-numeric: tabular-nums; color: var(--cdc); transition: transform 0.2s ease;
      white-space: nowrap;
    }
    .cd-time.final { transform: scale(1.12); }
    .cd-time.ended { font-size: clamp(3rem, 18cqw, 9rem); color: var(--danger); }
    .cd-bar { width: 100%; height: 14px; border-radius: 99px; background: var(--border); overflow: hidden; }
    .cd-bar-fill { height: 100%; width: 100%; background: var(--cdc); border-radius: 99px; transition: width 0.25s linear, background 0.3s; }
    .cd-ring { display: none; }
    .cd-stage.ring .cd-bar { display: none; }
    .cd-stage.ring .cd-dial { width: min(100%, 360px); aspect-ratio: 1; }
    .cd-stage.ring .cd-ring { display: block; position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
    .cd-ring circle { fill: none; stroke-width: 8; }
    .cd-ring .track { stroke: var(--border); }
    .cd-ring .fill { stroke: var(--cdc); stroke-linecap: round; transition: stroke-dashoffset 0.25s linear, stroke 0.3s; }
    .cd-stage.ring .cd-time { font-size: clamp(2.6rem, 16cqw, 6rem); }
    .cd-controls { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
    .cd-controls .hero-btn { min-height: 52px; }
    .cd-stage.flash { animation: cdFlash 0.5s ease-in-out 3; }
    @keyframes cdFlash { 50% { background: var(--danger); } }
    /* 전체화면(또는 전체화면을 못 쓰는 브라우저의 꽉 찬 창) */
    .cd-stage.full {
      position: fixed; inset: 0; z-index: 3000; border-radius: 0; border: none; justify-content: center;
      padding: max(16px, env(safe-area-inset-top)) 16px max(16px, env(safe-area-inset-bottom));
      gap: 3vmin;
    }
    .cd-stage.full .cd-label { font-size: clamp(1.2rem, 4vmin, 2.5rem); }
    .cd-stage.full .cd-time { font-size: 35vmin; }
    .cd-stage.full .cd-time.ended { font-size: 22vmin; }
    .cd-stage.full .cd-bar { width: min(92vw, 1400px); height: 3vmin; min-height: 14px; }
    .cd-stage.full.ring .cd-dial { width: min(80vmin, 92vw); }
    .cd-stage.full.ring .cd-time { font-size: 22vmin; }
    .cd-stage.full .cd-controls .hero-btn { min-height: 60px; font-size: 1.1rem; }
    body.is-fs .top-overlay, body.is-fs .top-overlay-left, body.is-fs .vs-sync-panel { display: none !important; }

    /* ── 시정 ── */
    .tt-list { display: flex; flex-direction: column; gap: 0.625rem; }
    .tt-card { background: var(--bg); border: 1px solid var(--border); border-radius: 1rem; padding: 0.875rem 1rem; display: flex; flex-direction: column; gap: 0.5rem; }
    .tt-card.active { border-color: var(--primary); box-shadow: 0 0 0 1px var(--primary) inset; }
    .tt-card-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .tt-card-head b { font-size: 1.05rem; }
    .badge { display: inline-flex; align-items: center; gap: 4px; font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 99px; background: var(--primary); color: #fff; }
    .tt-card-meta { font-size: 0.82rem; color: var(--fg-muted); }
    .tt-card-actions { display: flex; flex-wrap: wrap; gap: 6px; }
    .tt-editor { display: flex; flex-direction: column; gap: 1rem; }
    .tt-editor[hidden] { display: none; }
    .tt-rows { display: flex; flex-direction: column; gap: 6px; }
    .tt-row {
      /* 시각 칸은 "오전 08:40"+시계 아이콘이 잘리지 않게 고정 폭 */
      display: grid; grid-template-columns: minmax(0, 1fr) 7.8em 7.8em minmax(0, 1fr) 44px;
      gap: 6px; align-items: center; padding: 6px; border-radius: 0.75rem; border: 1px solid transparent;
    }
    .tt-row.head { font-size: 0.78rem; font-weight: 700; color: var(--fg-muted); padding-top: 0; padding-bottom: 0; }
    .tt-row input, .tt-row select {
      width: 100%; min-width: 0; min-height: 44px; padding: 0.4rem 0.5rem; font-size: 1rem; font-family: inherit;
      border: 1px solid var(--border); border-radius: 0.6rem; background: var(--input-bg, var(--bg)); color: var(--fg);
    }
    .tt-row input[type="time"] { padding-inline: 0.3rem; }
    .tt-row.uncertain { background: color-mix(in srgb, var(--warning) 16%, transparent); border-color: var(--warning); }
    .tt-row.err { border-color: var(--danger); background: color-mix(in srgb, var(--danger) 7%, transparent); }
    .tt-row .row-msg { grid-column: 1 / -1; font-size: 0.78rem; color: var(--danger); font-weight: 600; }
    .tt-row.uncertain .row-msg.unc { color: var(--fg); }
    /* 좁은 화면: 1줄 이름·종류·지우기 / 2줄 시작·끝 */
    @media (max-width: 520px) {
      .tt-row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 44px; border-color: var(--border); }
      .tt-row .c-label { grid-column: 1; grid-row: 1; }
      .tt-row .c-kind { grid-column: 2; grid-row: 1; }
      .tt-row .c-del { grid-column: 3; grid-row: 1; }
      .tt-row .c-start { grid-column: 1; grid-row: 2; }
      .tt-row .c-end { grid-column: 2; grid-row: 2; }
      .tt-row .row-msg { grid-row: 3; }
      .tt-row.head { display: none; }
    }
    .tt-chime { display: grid; gap: 8px; }
    .check { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-weight: 600; cursor: pointer; }
    .check input { width: 20px; height: 20px; accent-color: var(--primary); }
    .sel {
      min-height: 44px; padding: 0.4rem 0.6rem; font-size: 1rem; font-family: inherit;
      border: 1px solid var(--border); border-radius: 0.6rem; background: var(--input-bg, var(--bg)); color: var(--fg);
    }
    .editor-foot { display: flex; gap: 8px; position: sticky; bottom: calc(var(--bar-h) + var(--bar-gap) + 4px); background: var(--card-bg); padding: 8px 0; z-index: 2; }
    .editor-foot .hero-btn { flex: 1; }

    /* 요일 고르기 */
    .day-selector { display: flex; gap: 4px; justify-content: space-between; position: relative; max-width: 360px; }
    .day-checkbox { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; pointer-events: none; }
    .day-checkbox:focus-visible + .day-label { outline: 2px solid var(--primary); outline-offset: 2px; }
    .day-label {
      flex: 1 1 0; max-width: 44px; min-width: 36px; aspect-ratio: 1;
      border-radius: 50%; border: 1px solid var(--border);
      display: flex; justify-content: center; align-items: center;
      font-size: 0.85rem; cursor: pointer; transition: background 0.15s, border-color 0.15s; font-weight: 600; background: var(--bg);
    }
    .day-checkbox:checked + .day-label { background: var(--primary); color: #fff; border-color: var(--primary); }

    /* ── 알람 ── */
    .tab-bar {
      display: flex; overflow-x: auto; gap: 6px; padding-bottom: 0.25rem;
      scrollbar-width: none; -webkit-overflow-scrolling: touch;
    }
    .tab-bar::-webkit-scrollbar { display: none; }
    .tab-bar.has-more {
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 36px), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - 36px), transparent);
    }
    .tab-item {
      padding: 6px 14px; border-radius: 9999px; font-size: 0.82rem; font-weight: 600; white-space: nowrap; cursor: pointer;
      background: var(--bg); color: var(--fg-muted); border: 1px solid var(--border); transition: background 0.15s, color 0.15s;
      min-height: 44px; min-width: 44px; justify-content: center; display: flex; align-items: center; font-family: inherit;
    }
    .tab-item.active { background: var(--primary); color: #fff; border-color: var(--primary); }
    .alarm-list { display: flex; flex-direction: column; gap: 0.625rem; }
    .alarm-item {
      background: var(--bg); border: 1px solid var(--border); border-radius: 1rem; padding: 0.875rem 1rem;
      display: flex; justify-content: space-between; align-items: center; gap: 8px; animation: fadeSlide 0.25s ease;
    }
    .alarm-item.bells { border-style: dashed; border-color: color-mix(in srgb, var(--primary) 50%, var(--border)); }
    @keyframes fadeSlide { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
    .alarm-info { min-width: 0; }
    .alarm-info .name { font-size: 0.875rem; color: var(--fg-muted); margin-bottom: 2px; }
    .alarm-info .time { font-size: 1.5rem; font-weight: 700; line-height: 1.2; }
    .alarm-item.bells .time { font-size: 1.1rem; }
    .alarm-info .days { font-size: 0.8rem; color: var(--primary); font-weight: 600; margin-top: 2px; }
    .item-actions { display: flex; gap: 4px; flex: none; }
    .action-btn {
      background: none; border: none; padding: 8px; cursor: pointer; border-radius: 50%; color: var(--fg-muted);
      transition: background 0.15s, color 0.15s; min-width: 44px; min-height: 44px;
      display: flex; align-items: center; justify-content: center;
    }
    .action-btn:hover { background: var(--border); }
    .action-btn.edit:hover { color: var(--primary); }
    .action-btn.delete:hover { color: var(--danger); }
    .action-btn.toggle.on { color: var(--primary); }
    .action-btn:disabled { opacity: 0.35; cursor: default; background: none; }
    .alarm-item.disabled { opacity: 0.5; }
    .alarm-item.disabled .time { text-decoration: line-through; }
    .action-btn .ic { width: 18px; height: 18px; }

    .empty-state {
      text-align: center; color: var(--fg-muted); padding: 2rem 1rem;
      display: flex; flex-direction: column; align-items: center; gap: 0.75rem; font-size: 0.9rem;
    }
    .empty-state .ic { width: 28px; height: 28px; }
    .empty-state p { margin: 0; }

    /* ── 음악 ── */
    .chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .chip {
      min-height: 40px; padding: 6px 12px; border-radius: 99px; border: 1px solid var(--border); background: var(--bg);
      color: var(--fg-muted); font: inherit; font-size: 0.85rem; font-weight: 700; cursor: pointer;
    }
    .chip[aria-pressed="true"] { background: var(--primary); color: #fff; border-color: var(--primary); }
    @media (pointer: coarse) { .chip { min-height: 44px; } }
    .music-list { display: flex; flex-direction: column; gap: 6px; }
    .music-item { display: flex; align-items: center; gap: 8px; background: var(--bg); border: 1px solid var(--border); border-radius: 0.85rem; padding: 6px 6px 6px 12px; }
    .music-item .mi-text { flex: 1; min-width: 0; }
    .music-item .mi-title { font-weight: 700; font-size: 0.92rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .music-item .mi-sub { font-size: 0.78rem; color: var(--fg-muted); }
    .music-item.playing { border-color: var(--primary); }
    .pick-badge { display: inline-flex; align-items: center; gap: 3px; margin-right: 6px; padding: 1px 7px; border-radius: 99px; font-size: 0.72rem; font-weight: 700; vertical-align: 0.08em; color: var(--fg); background: color-mix(in srgb, var(--warning) 22%, transparent); border: 1px solid color-mix(in srgb, var(--warning) 55%, transparent); }
    .pick-badge .ic { width: 0.95em; height: 0.95em; color: var(--warning); }
    /* 가림 화면 중에는 공용 토스트를 숨긴다(끝낼지 묻는 VUI.confirm 창은 .vui-overlay라 그대로 보임) */
    body.blank-on .vui-toast { visibility: hidden !important; }
    .rec-box { background: var(--bg); border: 1px solid var(--border); border-radius: 1rem; padding: 0.875rem 1rem; display: flex; flex-direction: column; gap: 0.6rem; }
    .rec-head { font-weight: 700; display: flex; align-items: center; gap: 6px; }
    .add-music { display: grid; grid-template-columns: 1fr auto; gap: 8px; }
    .add-music .hero-input { min-width: 0; }

    .music-player {
      position: fixed; left: 50%; transform: translateX(-50%);
      bottom: calc(var(--bar-h) + var(--bar-gap) + 8px);
      width: min(calc(100% - 2rem), 420px); z-index: 600;
      background: var(--card-bg); border: 1px solid var(--border); border-radius: 1rem; box-shadow: var(--shadow, 0 8px 24px rgba(0,0,0,.18));
      overflow: hidden;
    }
    .music-player[hidden] { display: none; }
    .mp-head { display: flex; align-items: center; gap: 6px; padding: 4px 4px 4px 12px; }
    .mp-title { flex: 1; min-width: 0; font-weight: 700; font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mp-title .ic { color: var(--primary); }
    .mp-frame { aspect-ratio: 16 / 9; width: 100%; background: #000; }
    .mp-frame iframe { width: 100%; height: 100%; border: 0; display: block; }
    .music-player.collapsed .mp-frame { height: 1px; aspect-ratio: auto; opacity: 0.01; }
    .mp-msg { font-size: 0.8rem; padding: 6px 12px 8px; color: var(--fg-muted); }
    .mp-msg[hidden] { display: none; }

    /* ── 하단 고정 바 ── */
    .control-bar {
      position: fixed;
      bottom: 20px;
      bottom: calc(20px + env(safe-area-inset-bottom, 0px));
      width: calc(100% - 2rem);
      max-width: 560px;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 1.25rem;
      padding: 0.5rem;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 4px;
      z-index: 500;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
    /* 넓은 화면(전자칠판·노트북): 바를 카드 오른쪽 세로 막대로 — 첫 화면의 빠른 시작 버튼을 가리지 않게 */
    @media (min-width: 900px) {
      .control-bar {
        bottom: auto; top: 50%; transform: translateY(-50%);
        left: calc(50% + 280px + 16px); width: 96px; max-width: none;
        grid-template-columns: 1fr; padding: 0.4rem;
