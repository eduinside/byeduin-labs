      chime: { period: 3000, play(ctx, d, t) { [523.25, 659.25, 783.99].forEach((f, i) => voice(ctx, d, f, t + i * 0.5, 2, { attack: 0.1, peak: 0.2 })); } },
      bell: { period: 3600, play(ctx, d, t) {
        [659.25, 523.25, 587.33, 392.0].forEach((f, i) => {
          const s = t + i * 0.75;
          voice(ctx, d, f, s, 2.2, { peak: 0.22, attack: 0.005 });
          voice(ctx, d, f * 2.76, s, 0.8, { peak: 0.05, attack: 0.005 });
