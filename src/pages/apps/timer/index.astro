---
import AppLayout from '../../../layouts/AppLayout.astro';
---
<AppLayout 
  sync
  icons
  title="Smart Timer — eduin VIVES"
  description="수업, 회의, 운동에 딱 맞는 반복 알람 타이머. 구간별 시간 설정과 알림음 커스텀."
  image="https://eduin.info/og-images/timer.png"
  bodyShell="column"
  bodyWidth="narrow"
>
  <Fragment slot="head">
  <style is:global="">
    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 48px 1rem 7rem;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(124,106,247,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(124,106,247,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 0;
    }

    .timer-wrap {
      width: 100%;
      max-width: 500px;
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* 시계 */
    .clock-section {
      text-align: center;
      margin-top: 0;
      margin-bottom: 1.5rem;
    }
    #main-clock {
      font-size: clamp(2.8rem, 10vw, 4.5rem);
      font-weight: 700;
      letter-spacing: -0.04em;
      font-variant-numeric: tabular-nums;
      line-height: 1;
    }
    #main-date {
      font-size: 0.95rem;
      color: var(--fg-muted);
      margin-top: 0.375rem;
    }
    #next-alarm {
      font-size: 0.82rem;
      color: var(--primary);
      font-weight: 600;
      margin-top: 0.5rem;
      min-height: 1.2em;
    }

    /* 메인 카드 */
    .main-card {
      width: 100%;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 1.5rem;
      padding: 1.25rem;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      margin-bottom: 6rem;
    }

    /* 탭 바 */
    .tab-bar {
      display: flex;
      overflow-x: auto;
      gap: 6px;
      padding-bottom: 0.75rem;
      margin-bottom: 0.875rem;
      border-bottom: 1px solid var(--border);
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .tab-bar::-webkit-scrollbar { display: none; }

    .tab-item {
      padding: 6px 14px;
      border-radius: 9999px;
      font-size: 0.82rem;
      font-weight: 600;
      white-space: nowrap;
      cursor: pointer;
      background: var(--bg);
      color: var(--fg-muted);
      border: 1px solid var(--border);
      transition: background 0.15s, color 0.15s;
      min-height: 44px;
      min-width: 44px;
      justify-content: center;
      display: flex;
      align-items: center;
      font-family: inherit;
    }
    .tab-item.active { background: var(--primary); color: #fff; border-color: var(--primary); }

    /* 알람 목록 */
    .alarm-list { flex-grow: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 0.625rem; }

    .alarm-item {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 1rem;
      padding: 0.875rem 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      animation: fadeSlide 0.25s ease;
    }
    @keyframes fadeSlide {
      from { opacity: 0; transform: translateY(4px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .alarm-info .name { font-size: 0.875rem; color: var(--fg-muted); margin-bottom: 2px; }
    .alarm-info .time { font-size: 1.5rem; font-weight: 700; line-height: 1.2; }
    .alarm-info .days { font-size: 0.8rem; color: var(--primary); font-weight: 600; margin-top: 2px; }

    .item-actions { display: flex; gap: 4px; }
    .action-btn {
      background: none;
      border: none;
      padding: 8px;
      cursor: pointer;
      border-radius: 50%;
      color: var(--fg-muted);
      transition: background 0.15s, color 0.15s;
      min-width: 44px;
      min-height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .action-btn:hover { background: var(--border); }
    .action-btn.edit:hover  { color: var(--primary); }
    .action-btn.delete:hover { color: var(--danger); }
    .action-btn.toggle.on { color: var(--primary); }
    .alarm-item.disabled { opacity: 0.5; }
    .alarm-item.disabled .time { text-decoration: line-through; }

    /* 빈 상태 */
    .empty-state {
      text-align: center;
      color: var(--fg-muted);
      padding: 2.5rem 1rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.9rem;
    }

    /* 하단 컨트롤 바 */
    .control-bar {
      position: fixed;
      bottom: 20px;
      width: calc(100% - 2rem);
      max-width: 500px;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 1.25rem;
      padding: 0.5rem;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 4px;
      z-index: 500;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .icon-btn {
      background: none;
      border: none;
      color: var(--fg);
      display: flex;
      flex-direction: column;
      align-items: center;
      cursor: pointer;
      padding: 0.5rem 0;
      border-radius: 0.875rem;
      transition: background 0.15s;
      gap: 3px;
      min-height: 52px;
      font-family: inherit;
    }
    .icon-btn:hover { background: var(--border); }
    .icon-btn span { font-size: 0.75rem; font-weight: 600; color: var(--fg-muted); }

    /* 모달 */
    .modal {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.45);
      backdrop-filter: blur(4px);
      display: none;
      justify-content: center;
      align-items: flex-end;
      z-index: 1000;
      padding: 1rem;
    }
    .modal.open { display: flex; }

    .modal-content {
      background: var(--bg);
      border: 1px solid var(--border);
      width: 100%;
      max-width: 420px;
      border-radius: 1.5rem;
      padding: 1.5rem;
      box-shadow: var(--shadow);
      margin-bottom: env(safe-area-inset-bottom, 0);
    }

    .modal-title { font-size: 1.1rem; font-weight: 700; margin: 0 0 1.25rem; }

    .form-group { margin-bottom: 1rem; }
    .form-label { display: block; font-size: 0.85rem; font-weight: 600; color: var(--fg-muted); margin-bottom: 0.375rem; }

    .day-selector { display: flex; gap: 4px; justify-content: space-between; position: relative; }
    /* 체크박스는 화면에서만 숨김(display:none이면 Tab·Space로 고를 수 없음) */
    .day-checkbox { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; pointer-events: none; }
    .day-checkbox:focus-visible + .day-label { outline: 2px solid var(--primary); outline-offset: 2px; }
    .day-label {
      flex: 1 1 0; max-width: 44px; min-width: 36px; aspect-ratio: 1;
      border-radius: 50%;
      border: 1px solid var(--border);
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 0.85rem;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s;
      font-weight: 600;
      background: var(--bg);
    }
    .day-checkbox:checked + .day-label { background: var(--primary); color: #fff; border-color: var(--primary); }

    .modal-footer { display: flex; gap: 0.5rem; margin-top: 0.25rem; }
    .btn-cancel { background: var(--card-bg); color: var(--fg); border: 1px solid var(--border); border-radius: 0.75rem; padding: 0.75rem 1rem; font-size: 0.9rem; cursor: pointer; flex: 1; font-family: inherit; min-height: 44px; }
    .btn-cancel:hover { border-color: var(--primary); }

    /* 알람 오버레이 */
    #alarm-overlay {
      position: fixed;
      inset: 0;
      background: var(--primary);
      color: #fff;
      display: none;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 2000;
      gap: 0.5rem;
      text-align: center;
      padding: 2rem;
    }
    #alarm-overlay.show { display: flex; }
    #alarm-overlay h1 { font-size: clamp(3rem, 15vw, 5rem); font-weight: 800; margin: 0.5rem 0; }
    #alarm-overlay p  { font-size: 1.2rem; opacity: 0.9; }
    #stop-alarm {
      margin-top: 2rem;
      padding: 1rem 3rem;
      border-radius: 9999px;
      border: 2px solid rgba(255,255,255,0.8);
      background: transparent;
      color: #fff;
      font-size: 1.2rem;
      font-weight: 800;
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
      font-family: inherit;
      min-height: 56px;
    }
    #stop-alarm:hover { background: #fff; color: var(--primary); }

    /* 로그 */
    .log-list { max-height: 220px; overflow-y: auto; margin-bottom: 1rem; }
    .log-item { padding: 0.625rem 0; border-bottom: 1px solid var(--border); font-size: 0.875rem; }
    .log-item .log-name { font-weight: 600; }
    .log-item .log-date { color: var(--fg-muted); font-size: 0.8rem; margin-top: 2px; }
  </style>
  <script type="application/ld+json" is:inline="">{"@context":"https://schema.org","@type":"WebApplication","name":"Smart Timer","description":"수업, 회의, 운동에 딱 맞는 반복 알람 타이머. 구간별 시간 설정과 알림음 커스텀.","url":"https://eduin.info/apps/timer/","applicationCategory":"EducationApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"KRW"},"isPartOf":{"@type":"WebSite","name":"eduin VIVES","url":"https://eduin.info"}}</script>
  </Fragment>



<div class="timer-wrap">

  <div class="app-header" style="width:100%;text-align:left;">
    <div class="app-badge">◆ 업무경감</div>
    <h1 class="app-title">
  <div class="card-emoji sub-edu-work" style="margin-bottom: 0; transform: scale(1.0);">
        <i data-lucide="timer"></i>
      </div>
  <span>Smart <span>Timer</span></span>
</h1>
    <p class="app-desc">반복 알람 스케줄을 직관적으로 관리합니다.</p>
  </div>

  <div class="clock-section">
    <div id="main-date">...</div>
    <div id="main-clock" role="timer" aria-live="off" aria-label="현재 시각">00:00:00</div>
    <div id="next-alarm"></div>
    <div id="timer-live" class="visually-hidden" role="status" aria-live="polite"></div>
  </div>

  <div class="main-card">
    <div class="tab-bar" id="tab-bar" role="group" aria-label="요일별 알람 보기">
      <button class="tab-item active" aria-pressed="true" onclick="setTab('all')">전체</button>
      <button class="tab-item" aria-pressed="false" aria-label="월요일" onclick="setTab(1)">월</button>
      <button class="tab-item" aria-pressed="false" aria-label="화요일" onclick="setTab(2)">화</button>
      <button class="tab-item" aria-pressed="false" aria-label="수요일" onclick="setTab(3)">수</button>
      <button class="tab-item" aria-pressed="false" aria-label="목요일" onclick="setTab(4)">목</button>
      <button class="tab-item" aria-pressed="false" aria-label="금요일" onclick="setTab(5)">금</button>
      <button class="tab-item" aria-pressed="false" aria-label="토요일" onclick="setTab(6)">토</button>
      <button class="tab-item" aria-pressed="false" aria-label="일요일" onclick="setTab(0)">일</button>
    </div>
    <div id="alarm-list" class="alarm-list"></div>
  </div>

  <!-- 하단 컨트롤 바 -->
  <div class="control-bar" role="toolbar" aria-label="타이머 도구">
    <button class="icon-btn" onclick="openAddModal()" aria-label="알람 추가">
      <i data-lucide="plus-circle" aria-hidden="true"></i><span>추가</span>
    </button>
    <button class="icon-btn" onclick="testAlarm()" aria-label="알람 소리 시험">
      <i data-lucide="bell-ring" aria-hidden="true"></i><span>테스트</span>
    </button>
    <button class="icon-btn" onclick="exportAlarms()" aria-label="알람 백업 파일 받기">
      <i data-lucide="download" aria-hidden="true"></i><span>백업</span>
    </button>
    <button class="icon-btn" onclick="triggerImport()" aria-label="백업 파일로 복구">
      <i data-lucide="upload" aria-hidden="true"></i><span>복구</span>
    </button>
    <button class="icon-btn" onclick="openModal('logModal')" aria-label="알람 실행 기록">
      <i data-lucide="history" aria-hidden="true"></i><span>기록</span>
    </button>
  </div>

  <!-- 알람 추가/수정 모달 -->
  <div id="alarmModal" class="modal">
    <div class="modal-content">
      <h2 class="modal-title" id="modalTitle">알람 추가</h2>
      <input type="hidden" id="editId">

      <div class="form-group">
        <label class="form-label" for="alarmName">알람 이름</label>
        <input type="text" id="alarmName" class="hero-input" placeholder="예: 약 먹기, 출근" maxlength="40">
      </div>
      <div class="form-group">
        <label class="form-label" for="alarmTime">시간 설정</label>
        <input type="time" id="alarmTime" class="hero-input">
      </div>
      <div class="form-group">
        <span class="form-label" id="daysLabel">반복 요일</span>
        <div class="day-selector" role="group" aria-labelledby="daysLabel">
          <input type="checkbox" id="d0" class="day-checkbox" value="0" aria-label="일요일"><label for="d0" class="day-label" aria-hidden="true">일</label>
          <input type="checkbox" id="d1" class="day-checkbox" value="1" checked="" aria-label="월요일"><label for="d1" class="day-label" aria-hidden="true">월</label>
          <input type="checkbox" id="d2" class="day-checkbox" value="2" checked="" aria-label="화요일"><label for="d2" class="day-label" aria-hidden="true">화</label>
          <input type="checkbox" id="d3" class="day-checkbox" value="3" checked="" aria-label="수요일"><label for="d3" class="day-label" aria-hidden="true">수</label>
          <input type="checkbox" id="d4" class="day-checkbox" value="4" checked="" aria-label="목요일"><label for="d4" class="day-label" aria-hidden="true">목</label>
          <input type="checkbox" id="d5" class="day-checkbox" value="5" checked="" aria-label="금요일"><label for="d5" class="day-label" aria-hidden="true">금</label>
          <input type="checkbox" id="d6" class="day-checkbox" value="6" aria-label="토요일"><label for="d6" class="day-label" aria-hidden="true">토</label>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn-cancel" onclick="closeModal('alarmModal')">취소</button>
        <button class="hero-btn" style="flex:2" id="saveBtn" onclick="saveAlarm()">저장하기</button>
      </div>
    </div>
  </div>

  <!-- 로그 모달 -->
  <div id="logModal" class="modal">
    <div class="modal-content">
      <h2 class="modal-title">알람 실행 기록</h2>
      <div class="log-list" id="log-list"></div>
      <div class="modal-footer">
        <button class="btn-cancel" onclick="clearLogs()">기록 삭제</button>
        <button class="hero-btn" style="flex:2" onclick="closeModal('logModal')">닫기</button>
      </div>
    </div>
  </div>

  <!-- 알람 오버레이 -->
  <div id="alarm-overlay" role="alertdialog" aria-labelledby="active-alarm-name" aria-describedby="active-alarm-time alarm-overlay-hint">
    <i data-lucide="alarm-clock" style="width:80px;height:80px;" aria-hidden="true"></i>
    <p id="active-alarm-name">알람</p>
    <h1 id="active-alarm-time">00:00</h1>
    <button id="stop-alarm" onclick="stopAlarm()">그만 울리기</button>
    <p id="alarm-overlay-hint" style="font-size:0.95rem;opacity:0.85;margin-top:0.75rem">Esc·Enter로 끌 수 있어요 · 1분이 지나면 저절로 멈춰요</p>
  </div>

  <input type="file" id="importInput" style="display:none" accept=".json" aria-label="백업 파일 고르기" onchange="importAlarms(event)">

</div><!-- /.timer-wrap -->


  <script is:inline="">
    // Web Worker (백그라운드 tick)
    const worker = new Worker(URL.createObjectURL(new Blob([
      'setInterval(()=>postMessage("tick"),1000);'
    ], { type: 'application/javascript' })));

    // 저장값이 깨져 있어도 앱이 멈추지 않도록 안전하게 읽기
    function loadList(key) {
      try {
        const v = JSON.parse(localStorage.getItem(key) || '[]');
        return Array.isArray(v) ? v : [];
      } catch (e) { return []; }
    }
    function saveList(key, value) {
      // VUI.storage: 용량이 꽉 차면 오류 토스트를 한 번 보여 줌
      if (window.VUI) { VUI.storage.set(key, value); return; }
      try { localStorage.setItem(key, JSON.stringify(value)); } catch (e) { console.warn('[timer] 저장 실패:', e); }
    }
    function toast(msg, type) { if (window.VUI) VUI.toast(msg, type); }
    // 스크린리더 알림(화면에는 안 보임)
    function announce(msg) {
      const el = document.getElementById('timer-live');
      if (!el) return;
      el.textContent = '';
      setTimeout(() => { el.textContent = msg; }, 30);
    }
    const LOG_MAX = 200;    // 실행 기록은 최근 200건만 보관
    const RING_MAX_MS = 60 * 1000;   // 알람은 최대 60초 울린 뒤 저절로 멈춤
    let alarms = loadList('alarms');
    let logs   = loadList('alarm_logs');
    let audioCtx, isAlarmPlaying = false, currentTab = 'all', wakeLock = null;
    let ringToken = 0, ringTimer = null, ringingMinuteKey = null;
    const lastFired = {};   // id → 'date H:M' — 같은 분 중복 발동 방지 (런타임 전용, 저장 안 함)
    const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
    const refreshIcons = () => { try { window.lucide?.createIcons(); } catch (e) {} };   // 아이콘 CDN이 막혀도 시계·알람은 계속 동작

    refreshIcons();
    window.addEventListener('load', refreshIcons);   // 아이콘 스크립트가 늦게(defer) 오더라도 다시 그림

    if (window.Notification && Notification.permission !== 'granted') Notification.requestPermission();

    async function requestWakeLock() {
      try {
        if (!('wakeLock' in navigator) || document.visibilityState !== 'visible') return;
        if (wakeLock && !wakeLock.released) return;
        wakeLock = await navigator.wakeLock.request('screen');
        wakeLock.addEventListener('release', () => { wakeLock = null; });
      } catch {}
    }
    requestWakeLock();
    // 탭을 다녀오면 브라우저가 화면 꺼짐 방지를 풀어 버리므로 다시 요청
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') requestWakeLock();
    });

    worker.onmessage = () => {
      const now = new Date();
      document.getElementById('main-clock').textContent =
        now.toLocaleTimeString('ko-KR', { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
      document.getElementById('main-date').textContent =
        now.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' });
      updateNextAlarm(now);
      checkAlarms(now);
    };

    function setTab(tab) {
      currentTab = tab;
      document.querySelectorAll('.tab-item').forEach(el => {
        const match = tab === 'all' ? el.textContent === '전체'
          : el.textContent === ['일','월','화','수','목','금','토'][tab];
        el.classList.toggle('active', match);
        el.setAttribute('aria-pressed', String(match));
      });
      renderAlarms();
    }

    function checkAlarms(now) {
      const h = now.getHours(), m = now.getMinutes(), d = now.getDay();
      const minuteKey = `${now.toDateString()} ${h}:${m}`;   // 초 0을 놓쳐도(틱 지연·스로틀링) 그 분에 한 번은 발동
      // 같은 분에 울리는 중이면 기다림(같은 시각 다중 알람 중첩 방지).
      // 앞 알람을 끄지 않았더라도 다른 시각의 알람은 앞 알람을 멈추고 새로 울림 — 수업 종이 막히지 않게.
      if (isAlarmPlaying && ringingMinuteKey === minuteKey) return;
      for (const a of alarms) {
        if (a.enabled === false || typeof a.time !== 'string' || !Array.isArray(a.days)) continue;
        const [ah, am] = a.time.split(':').map(Number);
        if (ah === h && am === m && a.days.includes(d) && lastFired[a.id] !== minuteKey) {
          lastFired[a.id] = minuteKey;
          if (isAlarmPlaying) stopAlarm();
          triggerAlarm(a, false, minuteKey);
          break;   // 같은 시각 다중 알람은 하나만 — 오버레이·소리 중첩 방지
        }
      }
    }

    function triggerAlarm(alarm, isTest = false, minuteKey = null) {
      if (isAlarmPlaying) stopAlarm();
      isAlarmPlaying = true;
      ringingMinuteKey = isTest ? null : minuteKey;   // 테스트 알람은 실제 알람이 오면 바로 양보
      document.getElementById('active-alarm-time').textContent = alarm.time === 'TEST' ? '시험 알람' : alarm.time;
      document.getElementById('active-alarm-name').textContent = alarm.name;
      document.getElementById('alarm-overlay').classList.add('show');
      // 접근성: 알림 대화상자로 열어 '그만 울리기'에 포커스, Esc로 끄기(VUI.modal)
      if (overlayModal) overlayModal.open();
      if (!isTest) {
        logs.unshift({ name: alarm.name, time: alarm.time, date: new Date().toLocaleString() });
        if (logs.length > LOG_MAX) logs.length = LOG_MAX;
        saveList('alarm_logs', logs);
      }
      playAlarmSound();
      clearTimeout(ringTimer);
      ringTimer = setTimeout(() => {   // 아무도 끄지 않아도 60초 뒤 저절로 멈춤
        stopAlarm();
        announce('알람이 1분 동안 울려서 저절로 멈췄어요.');
      }, RING_MAX_MS);
      if (window.Notification && Notification.permission === 'granted') {
        try {
          const n = new Notification('VIVES Timer', { body: `${alarm.name} (${alarm.time})` });
          n.onclick = () => { window.focus(); stopAlarm(); };
        } catch (e) {}
      }
    }

    function stopAlarm() {
      isAlarmPlaying = false;
      ringingMinuteKey = null;
      ringToken++;
      clearTimeout(ringTimer); ringTimer = null;
      document.getElementById('alarm-overlay').classList.remove('show');
      if (overlayModal) overlayModal.close();
      if (audioCtx) { try { audioCtx.close(); } catch (e) {} audioCtx = null; }
    }

    function playAlarmSound() {
      let ctx;
      try { ctx = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { return; }
      audioCtx = ctx;
      const token = ++ringToken;   // 이 알람의 소리만 이어 가도록 표시 (이전 알람 소리 루프와 겹치지 않음)
      const note = (f, t, d) => {
        const o = ctx.createOscillator(), g = ctx.createGain();
        o.type = 'sine'; o.frequency.setValueAtTime(f, t);
        g.gain.setValueAtTime(0, t);
        g.gain.linearRampToValueAtTime(0.2, t + 0.1);
        g.gain.exponentialRampToValueAtTime(0.001, t + d);
        o.connect(g); g.connect(ctx.destination);
        o.start(t); o.stop(t + d);
      };
      const seq = () => {
        if (!isAlarmPlaying || token !== ringToken || ctx.state === 'closed') return;
        const t = ctx.currentTime;
        note(523.25, t, 2); note(659.25, t + 0.5, 2); note(783.99, t + 1.0, 2);
        setTimeout(seq, 3000);
      };
      seq();
    }

    function testAlarm() {
      if (window.Notification && Notification.permission !== 'granted') Notification.requestPermission();
      triggerAlarm({ name: '테스트 알람', time: 'TEST' }, true);   // 테스트는 실행 기록에 남기지 않음
    }

    function openAddModal() {
      const now = new Date();
      document.getElementById('modalTitle').textContent = '알람 추가';
      document.getElementById('saveBtn').textContent = '저장하기';
      document.getElementById('editId').value = '';
      document.getElementById('alarmName').value = '';
      document.getElementById('alarmTime').value =
        `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;
      openModal('alarmModal');
    }

    function openEditModal(id) {
      const a = alarms.find(x => x.id === id);
      if (!a) return;
      document.getElementById('modalTitle').textContent = '알람 수정';
      document.getElementById('saveBtn').textContent = '수정 완료';
      document.getElementById('editId').value = id;
      document.getElementById('alarmName').value = a.name;
      document.getElementById('alarmTime').value = a.time;
      for (let i = 0; i < 7; i++) document.getElementById(`d${i}`).checked = a.days.includes(i);
      openModal('alarmModal');
    }

    function saveAlarm() {
      const id   = document.getElementById('editId').value;
      const name = document.getElementById('alarmName').value || '알람';
      const time = document.getElementById('alarmTime').value;
      const days = Array.from({length:7}, (_,i) => document.getElementById(`d${i}`).checked ? i : -1).filter(i => i >= 0);
      if (!time) { toast('시간을 선택해 주세요.', 'error'); document.getElementById('alarmTime').focus(); return; }
      if (!days.length) { toast('반복할 요일을 하나 이상 골라 주세요.', 'error'); document.getElementById('d1').focus(); return; }
      if (id) {
        const idx = alarms.findIndex(a => a.id == id);
        alarms[idx] = { ...alarms[idx], name, time, days };
      } else {
        alarms.push({ id: Date.now(), name, time, days, enabled: true });
      }
      saveList('alarms', alarms);
      renderAlarms();
      closeModal('alarmModal');
      toast(id ? '알람을 고쳤어요 ✓' : `${time} 알람을 저장했어요 ✓`, 'success');
    }

    function deleteAlarm(id) {
      const a = alarms.find(x => x.id === id);
      alarms = alarms.filter(a => a.id !== id);
      saveList('alarms', alarms);
      renderAlarms();
      if (a) announce(`${a.name} ${a.time} 알람을 지웠어요.`);
      // 지운 항목 버튼에 있던 키보드 포커스를 목록으로 돌려놓음
      const first = document.querySelector('#alarm-list [data-action]');
      if (first) first.focus(); else document.querySelector('.control-bar .icon-btn')?.focus();
    }

    function toggleAlarm(id) {
      const a = alarms.find(x => x.id === id);
      if (!a) return;
      a.enabled = a.enabled === false;   // 꺼져 있으면(false) 켜고, 그 외(true·미설정)는 끔
      saveList('alarms', alarms);
      renderAlarms();
      announce(`${a.name} ${a.time} 알람을 ${a.enabled ? '켰어요' : '껐어요'}.`);
      // 다시 그린 뒤에도 같은 버튼에 포커스 유지(키보드 사용)
      document.querySelector(`#alarm-list [data-action="toggle"][data-id="${CSS.escape(String(id))}"]`)?.focus();
    }

    function renderAlarms() {
      const list = document.getElementById('alarm-list');
      list.innerHTML = '';
      const filtered = currentTab === 'all' ? alarms : alarms.filter(a => a.days.includes(currentTab));
      if (!filtered.length) {
        list.innerHTML = `<div class="empty-state"><i data-lucide="calendar-x" aria-hidden="true"></i><p>설정된 알람이 없습니다.</p></div>`;
        refreshIcons(); return;
      }
      const dayNames = ['일','월','화','수','목','금','토'];
      filtered.sort((a,b) => a.time.localeCompare(b.time)).forEach(alarm => {
        const dayStr = alarm.days.length === 7 ? '매일' : alarm.days.map(d => dayNames[d]).join(', ');
        const off = alarm.enabled === false;
        const div = document.createElement('div');
        div.className = 'alarm-item' + (off ? ' disabled' : '');
        div.innerHTML = `
          <div class="alarm-info">
            <div class="name">${esc(alarm.name)}</div>
            <div class="time">${esc(alarm.time)}</div>
            <div class="days">${esc(dayStr)}</div>
          </div>
          <div class="item-actions">
            <button class="action-btn toggle ${off ? '' : 'on'}" data-action="toggle" data-id="${esc(alarm.id)}" title="${off ? '알람 켜기' : '알람 끄기'}" aria-label="${esc(alarm.name)} ${esc(alarm.time)} 알람 켜짐" aria-pressed="${off ? 'false' : 'true'}"><i data-lucide="${off ? 'bell-off' : 'bell'}" style="width:16px" aria-hidden="true"></i></button>
            <button class="action-btn edit" data-action="edit" data-id="${esc(alarm.id)}" title="수정" aria-label="${esc(alarm.name)} ${esc(alarm.time)} 알람 수정"><i data-lucide="pencil" style="width:16px" aria-hidden="true"></i></button>
            <button class="action-btn delete" data-action="delete" data-id="${esc(alarm.id)}" title="삭제" aria-label="${esc(alarm.name)} ${esc(alarm.time)} 알람 삭제"><i data-lucide="trash-2" style="width:16px" aria-hidden="true"></i></button>
          </div>`;
        list.appendChild(div);
      });
      refreshIcons();
    }

    function exportAlarms() {
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([JSON.stringify({ alarms, logs })], { type: 'application/json' }));
      a.download = 'timer_backup.json'; a.click();
    }
    function triggerImport() { document.getElementById('importInput').click(); }
    function importAlarms(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = ev => {
        try {
          const data = JSON.parse(ev.target.result);
          if (!data || !Array.isArray(data.alarms)) throw new Error('형식 오류');
          alarms = data.alarms;
          logs = Array.isArray(data.logs) ? data.logs.slice(0, LOG_MAX) : [];
          saveList('alarms', alarms);
          saveList('alarm_logs', logs);   // 복구한 기록도 저장 — 새로고침해도 유지
          renderAlarms();
          toast(`알람 ${alarms.length}개를 불러왔어요 ✓`, 'success');
        } catch (err) {
          toast('백업 파일을 읽을 수 없어요. 이 앱에서 받은 JSON 백업 파일인지 확인해 주세요.', 'error');
        } finally {
          e.target.value = '';   // 같은 파일을 다시 선택해도 onchange가 발동하도록 초기화
        }
      };
      reader.readAsText(file);
    }

    function renderLogs() {
      const c = document.getElementById('log-list');
      if (!logs.length) { c.innerHTML = '<p style="text-align:center;color:var(--fg-muted);padding:1rem">기록이 없습니다.</p>'; return; }
      c.innerHTML = logs.slice(0, 30).map(l => `
        <div class="log-item">
          <div class="log-name">${esc(l.name)} (${esc(l.time)})</div>
          <div class="log-date">${esc(l.date)}</div>
        </div>`).join('');
    }
    function clearLogs() { logs = []; saveList('alarm_logs', logs); renderLogs(); announce('실행 기록을 지웠어요.'); }
    // 모달: VUI가 role=dialog·포커스 가두기·ESC·배경 클릭 닫기·포커스 복귀를 맡음
    const modals = window.VUI ? {
      alarmModal: VUI.modal.bind('#alarmModal', { className: 'open', backdropClose: true, dialog: '#alarmModal .modal-content', initialFocus: '#alarmName' }),
      logModal: VUI.modal.bind('#logModal', { className: 'open', backdropClose: true, dialog: '#logModal .modal-content' }),
    } : {};
    // 알람 화면: 보이기·숨기기는 triggerAlarm/stopAlarm이 하고, VUI는 접근성(포커스·Esc)만
    const overlayModal = window.VUI ? VUI.modal.bind('#alarm-overlay', {
      manual: true, initialFocus: '#stop-alarm', onClose: () => stopAlarm(),
    }) : null;
    function openModal(id) {
      if (id === 'logModal') renderLogs();
      if (modals[id]) modals[id].open(); else document.getElementById(id).classList.add('open');
    }
    function closeModal(id) {
      if (modals[id]) modals[id].close(); else document.getElementById(id).classList.remove('open');
    }
    // 알람 이름·시간 칸에서 Enter = 저장
    ['alarmName', 'alarmTime'].forEach(fid => document.getElementById(fid).addEventListener('keydown', e => {
      if (e.key === 'Enter' && !e.isComposing) { e.preventDefault(); saveAlarm(); }
    }));

    // 다음 알람: 활성 알람 중 지금으로부터 가장 가까운 발동 시점
    function nextAlarmInfo(now) {
      let best = null;
      for (const a of alarms) {
        if (a.enabled === false) continue;
        const [ah, am] = a.time.split(':').map(Number);
        if (Number.isNaN(ah) || !a.days || !a.days.length) continue;
        for (const d of a.days) {
          const when = new Date(now);
          when.setHours(ah, am, 0, 0);
          when.setDate(when.getDate() + ((d - now.getDay() + 7) % 7));
          if (when <= now) when.setDate(when.getDate() + 7);   // 오늘 이미 지났으면 다음 주 같은 요일
          if (!best || when < best.when) best = { alarm: a, when };
        }
      }
      return best;
    }

    function fmtDelta(ms) {
      const totalMin = Math.floor(ms / 60000);
      if (totalMin <= 0) return '곧';
      const days = Math.floor(totalMin / 1440);
      const hours = Math.floor((totalMin % 1440) / 60);
      const mins = totalMin % 60;
      if (days > 0)  return `${days}일 ${hours}시간 후`;
      if (hours > 0) return `${hours}시간 ${mins}분 후`;
      return `${mins}분 후`;
    }

    function updateNextAlarm(now) {
      const el = document.getElementById('next-alarm');
      const next = nextAlarmInfo(now);
      el.textContent = next
        ? `다음 알람 · ${next.alarm.name} ${next.alarm.time} · ${fmtDelta(next.when - now)}`
        : '예정된 알람이 없습니다';
    }

    // 알람 항목 버튼(켜기·끄기·수정·삭제)은 이벤트 위임으로 처리 — inline onclick 제거로 id 주입·XSS 경로 차단
    document.getElementById('alarm-list').addEventListener('click', e => {
      const btn = e.target.closest('[data-action]');
      if (!btn) return;
      const id = Number(btn.dataset.id);
      if (!id) return;
      const action = btn.dataset.action;
      if (action === 'edit') openEditModal(id);
      else if (action === 'delete') deleteAlarm(id);
      else if (action === 'toggle') toggleAlarm(id);
    });

    renderAlarms();

    // 선택 동기화: 헤더 '동기화' 버튼 (알람·기록을 코드 하나로 기기 간 이어쓰기)
    if (window.VivesSync) VivesSync.mountDocSync({
      apiUrl: '/api/timer',
      keys: ['alarms', 'alarm_logs'],
      appName: '알람',
      onApplied: function () {
        alarms = loadList('alarms');
        logs = loadList('alarm_logs');
        renderAlarms();
      },
    });
  </script>



</AppLayout>
