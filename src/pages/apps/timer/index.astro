    }
    #alarm-overlay.show { display: flex; }
    #alarm-overlay > .ic { width: 80px; height: 80px; }
    #alarm-overlay h1 { font-size: clamp(3rem, 15vw, 5rem); font-weight: 800; margin: 0.5rem 0; }
    #alarm-overlay p { font-size: 1.2rem; opacity: 0.9; }
    #stop-alarm {
      margin-top: 2rem; padding: 1rem 3rem; border-radius: 9999px; border: 2px solid rgba(255,255,255,0.8);
      background: transparent; color: #fff; font-size: 1.2rem; font-weight: 800; cursor: pointer;
      transition: background 0.2s, color 0.2s; font-family: inherit; min-height: 56px;
    }
    #stop-alarm:hover { background: #fff; color: var(--primary); }

    /* 가림 화면 — 공용 상단 버튼(9999)까지 덮고, 확인 창(VUI 10000)만 위에 뜬다 */
    #blank {
      position: fixed; inset: 0; z-index: 9999; background: #000; color: #555;
      opacity: 1; transition: opacity 0.6s ease; touch-action: none; user-select: none; -webkit-user-select: none;
      cursor: none; outline: none;
