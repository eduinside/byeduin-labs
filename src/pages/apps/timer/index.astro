      font-size: 0.8rem; font-weight: 600; color: var(--fg-muted); background: var(--card-bg); border: 1px dashed var(--border);
      cursor: pointer; font-family: inherit; min-height: 36px;
    }
    #audio-hint[hidden] { display: none; }

    /* 모달 */
    .modal {
      position: fixed; inset: 0; background: rgba(0,0,0,0.45); backdrop-filter: blur(4px);
