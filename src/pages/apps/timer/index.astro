    /* 설정(timer_settings) */
    const TABS = ['countdown', 'timetable', 'alarms', 'music'];
    const MOODS = { break: '쉬는 시간', focus: '집중', calm: '차분하게', clean: '청소·정리', morning: '아침', lunch: '점심' };
    const SETTINGS_DEFAULT = {
      tab: 'countdown', alarmSound: 'chime', cdSound: 'chime', cdShape: 'bar', cdBeep: true, cdAutoFs: false,
      wakeLock: 'auto', blankShow: 'none', blankSound: true, blankLiftOnBell: true,
      musicAutoStop: true, musicGrade: 'all', musicMood: '',
    };
    const SETTING_ENUMS = {
      tab: TABS, cdShape: ['bar', 'ring'], wakeLock: ['auto', 'on', 'off'], blankShow: ['none', 'small', 'large'],
