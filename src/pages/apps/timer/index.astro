    const soundOk = s => Object.prototype.hasOwnProperty.call(SOUNDS, s);

    /* 오디오는 사용자가 한 번 누른 뒤에야 켤 수 있는 브라우저가 많다.
       첫 누르기 때 오디오를 깨워 두고, 그 전에는 "한 번 눌러 주세요" 띠를 보인다. */
    let audioCtx = null, ringGain = null, ringToken = 0, ringing = null;
