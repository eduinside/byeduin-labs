    .swatches span { display: block; width: 40px; height: 40px; border-radius: 50%; background: var(--sw); border: 3px solid transparent; cursor: pointer; }
    .swatches input:checked + span { border-color: var(--fg); box-shadow: 0 0 0 2px var(--bg) inset; }
    .swatches input:focus-visible + span { outline: 2px solid var(--primary); outline-offset: 2px; }
    .num-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .blank-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }
    .blank-grid .quick-btn { min-height: 60px; font-size: 1.1rem; }
    @media (max-width: 400px) { .blank-grid { grid-template-columns: repeat(3, 1fr); } }

    .pm-list { display: flex; flex-direction: column; gap: 6px; margin-bottom: 1rem; }
    .pm-item { display: flex; align-items: center; gap: 4px; border: 1px solid var(--border); border-left: 5px solid var(--pc, var(--primary)); border-radius: 0.75rem; padding: 4px 4px 4px 10px; background: var(--card-bg); }
    .pm-item .pm-text { flex: 1; min-width: 0; }
