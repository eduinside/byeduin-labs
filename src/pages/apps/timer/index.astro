      beep: { period: 1600, play(ctx, d, t) {
        voice(ctx, d, 880, t, 0.35, { type: 'triangle', peak: 0.16, attack: 0.02 });
        voice(ctx, d, 880, t + 0.5, 0.35, { type: 'triangle', peak: 0.16, attack: 0.02 });
      } },
      marimba: { period: 2600, play(ctx, d, t) {
        [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => {
          const s = t + i * 0.18;
          voice(ctx, d, f, s, 0.9, { peak: 0.24, attack: 0.004 });
          voice(ctx, d, f * 4, s, 0.12, { peak: 0.05, attack: 0.002 });
