      alarmSound: Object.keys(SOUNDS), cdSound: Object.keys(SOUNDS),
    };
    const isObj = v => !!v && typeof v === 'object' && !Array.isArray(v);
    function loadSettings(src) {   // src: 백업 파일의 settings(없으면 저장소에서)
      const raw = isObj(src) ? src : sget('timer_settings', {}, isObj);
      const s = { ...SETTINGS_DEFAULT };
      for (const k of Object.keys(SETTINGS_DEFAULT)) {
        const v = raw[k];
        if (typeof v !== typeof SETTINGS_DEFAULT[k]) continue;
        if (SETTING_ENUMS[k] && !SETTING_ENUMS[k].includes(v)) continue;
        s[k] = v;
      }
      return s;
    }
    let settings = loadSettings();
    function saveSettings() { saveList('timer_settings', settings); }

    /* ═════════════ 2. 시정 데이터 ═════════════ */
    const KINDS = { class: '수업', break: '쉬는 시간', lunch: '점심', morning: '아침 활동', after: '방과 후', etc: '기타' };
    const ROWS_MAX = 24;
    function cleanStr(v, max) { return typeof v === 'string' ? v.replace(/[\u0000-\u001f]/g, ' ').trim().slice(0, max) : ''; }
    // 시정 하나를 엄격하게 검사·정리. 틀린 곳이 있으면 null (공유 링크·파일·저장소 모두 같은 검사)
    function normalizeTT(t, keepId) {
      if (!t || typeof t !== 'object') return null;
      const name = cleanStr(t.name, 30);
      if (!name) return null;
      if (!Array.isArray(t.days)) return null;
      const days = [...new Set(t.days.filter(d => Number.isInteger(d) && d >= 0 && d <= 6))];
      if (!days.length) return null;
      if (!Array.isArray(t.periods) || !t.periods.length || t.periods.length > ROWS_MAX) return null;
      const periods = [];
      for (const p of t.periods) {
        if (!p || typeof p !== 'object') return null;
        const label = cleanStr(p.label, 20);
        if (!label || !HHMM_RE.test(p.start) || !HHMM_RE.test(p.end)) return null;
        if (toMin(p.end) <= toMin(p.start)) return null;
        if (!Object.prototype.hasOwnProperty.call(KINDS, p.kind)) return null;
        const prev = periods[periods.length - 1];
        if (prev && toMin(p.start) < toMin(prev.end)) return null;   // 겹침·순서 오류
        periods.push({ label, start: p.start, end: p.end, kind: p.kind });
      }
      const c = t.chime && typeof t.chime === 'object' ? t.chime : {};
      const before = Number.isInteger(c.before) && c.before >= 0 && c.before <= 10 ? c.before : 0;
      const chime = { atStart: c.atStart !== false, atEnd: c.atEnd !== false, before, sound: soundOk(c.sound) ? c.sound : 'bell' };
      const out = { id: '', name, days: days.sort(), periods, chime, updatedAt: Number.isFinite(t.updatedAt) ? t.updatedAt : Date.now() };
      out.id = keepId && typeof t.id === 'string' && /^[\w-]{1,40}$/.test(t.id) ? t.id : newId('tt');
      return out;
    }
    function loadTimetables() {
      const seen = new Set();
      return loadList('timetables').map(t => normalizeTT(t, true)).filter(t => t && !seen.has(t.id) && seen.add(t.id));
    }
    let timetables = loadTimetables();
    let activeId = sget('timetable_active', '', v => typeof v === 'string');
    const activeTT = () => timetables.find(t => t.id === activeId) || null;
    function todayTT(now) {
      const tt = activeTT();
      return tt && tt.days.includes(now.getDay()) ? tt : null;
    }
    // 시정 종: 수업(class) 구간의 시작·끝·예비 종. 같은 분이면 시작 > 끝 > 예비 순으로 하나만.
    const bellCache = new Map();
    function bellsOf(tt, noCache) {
      const key = tt.id + ':' + tt.updatedAt;
      if (!noCache && bellCache.has(key)) return bellCache.get(key);
      const c = tt.chime, out = [], seen = new Set();
      const add = (min, name, type) => {
        if (min < 0 || min >= 1440) return;
        const time = minToHHMM(min);
        if (seen.has(time)) return;
        seen.add(time);
        out.push({ time, min, name, type });
      };
      const classes = tt.periods.filter(p => p.kind === 'class');
      if (c.atStart) classes.forEach(p => add(toMin(p.start), `${p.label} 시작`, 'start'));
      if (c.atEnd) classes.forEach(p => add(toMin(p.end), `${p.label} 끝`, 'end'));
      if (c.before) classes.forEach(p => add(toMin(p.start) - c.before, `${p.label} ${c.before}분 전`, 'before'));
      out.sort((a, b) => a.min - b.min);
      if (!noCache) bellCache.set(key, out);
      return out;
    }
    // 지금 시정에서 어디쯤인지
    function dayInfo(now) {
      const tt = activeTT();
      if (!tt) return { tt: null };
      if (!tt.days.includes(now.getDay())) return { tt, off: true };
      const sec = now.getHours() * 3600 + now.getMinutes() * 60 + now.getSeconds();
      let cur = null, next = null;
      for (const p of tt.periods) {
        const s = toMin(p.start) * 60, e = toMin(p.end) * 60;
        if (sec >= s && sec < e) cur = p;
        else if (s > sec && !next) next = p;
      }
      return { tt, sec, cur, next, first: tt.periods[0] };
    }
    function fmtLeft(sec) { return sec < 60 ? `${Math.max(1, sec)}초` : `${Math.ceil(sec / 60)}분`; }
    function statusText(info) {
      if (!info.tt) return '';
      if (info.off) return `오늘은 ${josa(info.tt.name, '을/를')} 쓰지 않는 날이에요`;
      const { sec, cur, next } = info;
      if (cur) {
        const endSec = toMin(cur.end) * 60;
        const head = cur.kind === 'class' ? `지금 ${cur.label}` : cur.label;
        if (next && toMin(next.start) * 60 === endSec) return `${head} · ${next.label}까지 ${fmtLeft(endSec - sec)}`;
        return `${head} · 끝까지 ${fmtLeft(endSec - sec)}`;
      }
      if (next) {
        const left = fmtLeft(toMin(next.start) * 60 - sec);
        return sec < toMin(info.first.start) * 60 ? `일과 전 · ${next.label}까지 ${left}` : `${next.label}까지 ${left}`;
      }
      return '오늘 일과가 끝났어요 · 방과 후';
    }
    // 다음 수업 시작 시각(ms). 음악 자동 멈춤·가림 화면 "다음 종까지"에 씀
    function nextClassStartMs(now) {
      const info = dayInfo(now);
      if (!info.tt || info.off) return null;
      const p = info.tt.periods.find(x => x.kind === 'class' && toMin(x.start) * 60 > info.sec);
      if (!p) return null;
      const d = new Date(now); d.setHours(0, toMin(p.start), 0, 0);
      return { at: d.getTime(), label: p.label };
    }
    function nextBellMs(now) {
      const tt = todayTT(now);
      if (!tt) return null;
      const sec = now.getHours() * 3600 + now.getMinutes() * 60 + now.getSeconds();
      let b = bellsOf(tt).find(x => x.min * 60 > sec);
      if (!b) {   // 종을 모두 꺼 둔 시정이면 구간 경계로
        const edges = [];
        tt.periods.forEach(p => { edges.push({ min: toMin(p.start), name: `${p.label} 시작` }); edges.push({ min: toMin(p.end), name: `${p.label} 끝` }); });
        b = edges.sort((x, y) => x.min - y.min).find(x => x.min * 60 > sec);
      }
      if (!b) return null;
      const d = new Date(now); d.setHours(0, b.min, 0, 0);
      return { at: d.getTime(), name: b.name };
    }
  </script>

  <script is:inline="">
    /* ═════════════ 3. 알람(기존 동작·저장 형식 그대로) + 시정 종 ═════════════ */
    const LOG_MAX = 200;    // 실행 기록은 최근 200건만 보관
    const RING_MAX_MS = 60 * 1000;   // 알람은 최대 60초 울린 뒤 저절로 멈춤
    let alarms = loadList('alarms');
    let logs   = loadList('alarm_logs');
    let isAlarmPlaying = false, currentDay = 'all';
    let ringTimer = null, ringingMinuteKey = null;
    const lastFired = {};   // id → 'date H:M' — 같은 분 중복 발동 방지 (런타임 전용, 저장 안 함)

    // 알림 권한은 페이지를 열자마자가 아니라 '추가'·'테스트'를 처음 누를 때 묻는다
    function askNotify() {
      try { if (window.Notification && Notification.permission === 'default') Notification.requestPermission(); } catch (e) {}
    }

    function checkAlarms(now) {
      const h = now.getHours(), m = now.getMinutes(), d = now.getDay();
      const minuteKey = `${now.toDateString()} ${h}:${m}`;   // 초 0을 놓쳐도(틱 지연·스로틀링) 그 분에 한 번은 발동
      // 같은 분에 울리는 중이면 기다림(같은 시각 다중 알람 중첩 방지).
      // 앞 알람을 끄지 않았더라도 다른 시각의 알람은 앞 알람을 멈추고 새로 울림 — 수업 종이 막히지 않게.
      if (isAlarmPlaying && ringingMinuteKey === minuteKey) return;
      const cands = [];
      for (const a of alarms) {
        if (a.enabled === false || typeof a.time !== 'string' || !Array.isArray(a.days)) continue;
        const [ah, am] = a.time.split(':').map(Number);
        if (ah === h && am === m && a.days.includes(d)) cands.push({ key: a.id, alarm: a });
      }
      // 사용 중 시정의 종: 알람 목록에 복사하지 않고 그때그때 계산해 같은 발동 함수로 보낸다
      const tt = todayTT(now);
      if (tt) {
        const hm = pad2(h) + ':' + pad2(m);
        for (const b of bellsOf(tt)) if (b.time === hm) {
          cands.push({ key: `tt:${tt.id}:${b.time}`, alarm: { name: `${b.name} · ${tt.name}`, time: b.time, sound: tt.chime.sound, bell: b.type } });
        }
      }
      for (const c of cands) {
        if (lastFired[c.key] === minuteKey) continue;
        lastFired[c.key] = minuteKey;
        if (isAlarmPlaying) stopAlarm();
        triggerAlarm(c.alarm, false, minuteKey);
        break;   // 같은 시각 다중 알람은 하나만 — 오버레이·소리 중첩 방지
      }
    }

    function triggerAlarm(alarm, isTest = false, minuteKey = null) {
      if (isAlarmPlaying) stopAlarm();
      isAlarmPlaying = true;
      ringingMinuteKey = isTest ? null : minuteKey;   // 테스트 알람은 실제 알람이 오면 바로 양보
      $('active-alarm-time').textContent = alarm.time === 'TEST' ? '시험 알람' : alarm.time;
      $('active-alarm-name').textContent = alarm.name;
      $('alarm-overlay').classList.add('show');
      // 접근성: 알림 대화상자로 열어 '그만 울리기'에 포커스, Esc로 끄기(VUI.modal)
      if (overlayModal) overlayModal.open();
      if (!isTest) {
        logs.unshift({ name: alarm.name, time: alarm.time, date: new Date().toLocaleString() });
        if (logs.length > LOG_MAX) logs.length = LOG_MAX;
        saveList('alarm_logs', logs);
        // 종이 울리면 가림 화면을 바로 걷는다(설정)
        if (typeof blank !== 'undefined' && blank && settings.blankLiftOnBell) liftBlank('bell');
      }
      // 알람이 카운트다운 소리보다 우선: 카운트다운 끝 소리는 끊고(카운트다운 자체는 계속) 알람 소리를 낸다
      startRing(soundOk(alarm.sound) ? alarm.sound : settings.alarmSound, 'alarm');
      clearTimeout(ringTimer);
      ringTimer = setTimeout(() => {   // 아무도 끄지 않아도 60초 뒤 저절로 멈춤
        stopAlarm();
        announce('알람이 1분 동안 울려서 저절로 멈췄어요.');
      }, RING_MAX_MS);
      if (window.Notification && Notification.permission === 'granted') {
        try {
          const n = new Notification('스마트 타이머', { body: `${alarm.name} (${alarm.time})` });
          n.onclick = () => { window.focus(); stopAlarm(); };
        } catch (e) {}
      }
    }

    function stopAlarm() {
      isAlarmPlaying = false;
      ringingMinuteKey = null;
      clearTimeout(ringTimer); ringTimer = null;
      $('alarm-overlay').classList.remove('show');
      if (overlayModal) overlayModal.close();
      // 울리던 알람 소리만 끊는다(오디오는 다음 알람을 위해 깨운 채로 둔다)
      if (ringing === 'alarm') stopRingSound();
    }

    function testAlarm() {
      askNotify();
      unlockAudio();
      triggerAlarm({ name: '테스트 알람', time: 'TEST' }, true);   // 테스트는 실행 기록에 남기지 않음
    }

    function openAddModal() {
      askNotify();
      const now = new Date();
      $('modalTitle').textContent = '알람 추가';
      $('saveBtn').textContent = '저장하기';
      $('editId').value = '';
      $('alarmName').value = '';
      $('alarmTime').value = `${pad2(now.getHours())}:${pad2(now.getMinutes())}`;
      openModal('alarmModal');
    }

    function openEditModal(id) {
      const a = alarms.find(x => x.id === id);
      if (!a) return;
      $('modalTitle').textContent = '알람 수정';
      $('saveBtn').textContent = '수정 완료';
      $('editId').value = id;
      $('alarmName').value = a.name;
      $('alarmTime').value = a.time;
      for (let i = 0; i < 7; i++) $(`d${i}`).checked = a.days.includes(i);
      openModal('alarmModal');
    }

    function saveAlarm() {
      const id   = $('editId').value;
      const name = $('alarmName').value || '알람';
      const time = $('alarmTime').value;
      const days = Array.from({length:7}, (_,i) => $(`d${i}`).checked ? i : -1).filter(i => i >= 0);
      if (!time) { toast('시간을 선택해 주세요.', 'error'); $('alarmTime').focus(); return; }
      if (!days.length) { toast('반복할 요일을 하나 이상 골라 주세요.', 'error'); $('d1').focus(); return; }
      if (id) {
        const idx = alarms.findIndex(a => a.id == id);
        alarms[idx] = { ...alarms[idx], name, time, days };
      } else {
        alarms.push({ id: Date.now(), name, time, days, enabled: true });
      }
      saveList('alarms', alarms);
      renderAlarms();
      closeModal('alarmModal');
      toast(id ? '알람을 고쳤어요' : `${time} 알람을 저장했어요`, 'success');
    }

    function deleteAlarm(id) {
      const idx = alarms.findIndex(x => x.id === id);
      const a = alarms[idx];
      alarms = alarms.filter(a => a.id !== id);
      saveList('alarms', alarms);
      renderAlarms();
      if (a) {
        announce(`${a.name} ${a.time} 알람을 지웠어요.`);
        undoToast(`${a.name} ${a.time} 알람을 지웠어요`, () => {
          if (alarms.some(x => x.id === a.id)) return;
          alarms.splice(Math.min(idx, alarms.length), 0, a);
          saveList('alarms', alarms);
          renderAlarms();
          announce(`${a.name} ${a.time} 알람을 되돌렸어요.`);
        });
      }
      const first = document.querySelector('#alarm-list [data-action]');
      if (first) first.focus();
    }

    function toggleAlarm(id) {
      const a = alarms.find(x => x.id === id);
      if (!a) return;
      a.enabled = a.enabled === false;   // 꺼져 있으면(false) 켜고, 그 외(true·미설정)는 끔
      saveList('alarms', alarms);
      renderAlarms();
      announce(`${a.name} ${a.time} 알람을 ${a.enabled ? '켰어요' : '껐어요'}.`);
      document.querySelector(`#alarm-list [data-action="toggle"][data-id="${CSS.escape(String(id))}"]`)?.focus();
    }

    function setDayTab(day) {
      currentDay = day;
      document.querySelectorAll('#tab-bar .tab-item').forEach(el => {
        const match = el.dataset.day === String(day);
        el.classList.toggle('active', match);
        el.setAttribute('aria-pressed', String(match));
        if (match) showDayTab(el);
      });
      renderAlarms();
    }
    const tabBar = $('tab-bar');
    function showDayTab(el) {
      const r = el.getBoundingClientRect(), rr = tabBar.getBoundingClientRect();
      if (r.left < rr.left) tabBar.scrollBy({ left: r.left - rr.left - 8, behavior: 'smooth' });
      else if (r.right > rr.right - 36) tabBar.scrollBy({ left: r.right - rr.right + 44, behavior: 'smooth' });
    }
    function updateTabFade() { tabBar.classList.toggle('has-more', tabBar.scrollLeft + tabBar.clientWidth < tabBar.scrollWidth - 4); }
    tabBar.addEventListener('scroll', updateTabFade, { passive: true });
    window.addEventListener('resize', updateTabFade);
    tabBar.addEventListener('click', e => {
      const b = e.target.closest('.tab-item');
      if (b) setDayTab(b.dataset.day === 'all' ? 'all' : Number(b.dataset.day));
    });

    function renderAlarms() {
      const list = $('alarm-list');
      list.innerHTML = '';
      // 사용 중 시정의 종은 한 줄로 묶어서 보여 준다
      const tt = activeTT();
      if (tt && (currentDay === 'all' || tt.days.includes(currentDay))) {
        const n = bellsOf(tt).length;
        const div = document.createElement('div');
        div.className = 'alarm-item bells';
        div.innerHTML = `
          <div class="alarm-info">
            <div class="name">${ic('calendar-clock')} 사용 중 시정</div>
            <div class="time">시정 종 ${n}개(${esc(tt.name)})</div>
            <div class="days">${esc(daysText(tt.days))}</div>
          </div>
          <div class="item-actions">
            <button type="button" class="hero-btn hero-btn-ghost hero-btn-sm" data-action="goto-tt">시정 보기</button>
          </div>`;
        list.appendChild(div);
      }
      const filtered = currentDay === 'all' ? alarms.slice() : alarms.filter(a => Array.isArray(a.days) && a.days.includes(currentDay));
      if (!filtered.length) {
        const empty = document.createElement('div');
        empty.className = 'empty-state';
        empty.innerHTML = `${ic('calendar-x')}<p>${currentDay === 'all' ? '아직 알람이 없어요. 위 [알람 추가]를 눌러 만들어 보세요.' : '이 요일에 울리는 알람이 없어요.'}</p>`;
        list.appendChild(empty);
        return;
      }
      filtered.sort((a,b) => String(a.time).localeCompare(String(b.time))).forEach(alarm => {
        const dayStr = Array.isArray(alarm.days) ? (alarm.days.length === 7 ? '매일' : alarm.days.map(d => DAY_NAMES[d]).join(', ')) : '';
        const off = alarm.enabled === false;
        const div = document.createElement('div');
        div.className = 'alarm-item' + (off ? ' disabled' : '');
        div.innerHTML = `
          <div class="alarm-info">
            <div class="name">${esc(alarm.name)}</div>
            <div class="time">${esc(alarm.time)}</div>
            <div class="days">${esc(dayStr)}</div>
          </div>
          <div class="item-actions">
            <button type="button" class="action-btn toggle ${off ? '' : 'on'}" data-action="toggle" data-id="${esc(alarm.id)}" title="${off ? '꺼져 있음 · 눌러서 켜기' : '켜져 있음 · 눌러서 끄기'}" aria-label="${esc(alarm.name)} ${esc(alarm.time)} 알람 켜기" aria-pressed="${off ? 'false' : 'true'}">${ic(off ? 'bell-off' : 'bell')}</button>
            <button type="button" class="action-btn edit" data-action="edit" data-id="${esc(alarm.id)}" title="수정" aria-label="${esc(alarm.name)} ${esc(alarm.time)} 알람 수정">${ic('pencil')}</button>
            <button type="button" class="action-btn delete" data-action="delete" data-id="${esc(alarm.id)}" title="삭제" aria-label="${esc(alarm.name)} ${esc(alarm.time)} 알람 삭제">${ic('trash-2')}</button>
          </div>`;
        list.appendChild(div);
      });
    }
    // 알람 항목 버튼은 이벤트 위임으로 처리 — inline onclick 제거로 id 주입·XSS 경로 차단
    $('alarm-list').addEventListener('click', e => {
      const btn = e.target.closest('[data-action]');
      if (!btn) return;
      const action = btn.dataset.action;
      if (action === 'goto-tt') { setMainTab('timetable', true); return; }
      const id = Number(btn.dataset.id);
      if (!id) return;
      if (action === 'edit') openEditModal(id);
      else if (action === 'delete') deleteAlarm(id);
      else if (action === 'toggle') toggleAlarm(id);
    });

    function renderLogs() {
      const c = $('log-list');
      $('clearLogsBtn').disabled = !logs.length;
      if (!logs.length) { c.innerHTML = '<p style="text-align:center;color:var(--fg-muted);padding:1rem">아직 울린 알람이 없어요.</p>'; return; }
      c.innerHTML = logs.slice(0, 30).map(l => `
        <div class="log-item">
          <div class="log-name">${esc(l.name)} (${esc(l.time)})</div>
          <div class="log-date">${esc(l.date)}</div>
        </div>`).join('');
    }
    function clearLogs() {
      if (!logs.length) return;
      const prev = logs;
      logs = []; saveList('alarm_logs', logs); renderLogs(); announce('최근 기록을 지웠어요.');
      undoToast('최근 기록을 지웠어요', () => { logs = prev; saveList('alarm_logs', logs); renderLogs(); });
    }

    // 모달: VUI가 role=dialog·포커스 가두기·ESC·배경 클릭 닫기·포커스 복귀를 맡음
    const modals = {};
    function bindModal(id, opts) {
      if (window.VUI) modals[id] = VUI.modal.bind('#' + id, Object.assign({ className: 'open', backdropClose: true, dialog: `#${id} .modal-content` }, opts || {}));
    }
    bindModal('alarmModal', { initialFocus: '#alarmName' });
    bindModal('logModal');
    bindModal('presetModal');
    bindModal('presetEditModal', { initialFocus: '#pe-name' });
    bindModal('blankModal');
    bindModal('settingsModal');
    bindModal('aiModal', { onClose: () => abortAi() });
    // 알람 화면: 보이기·숨기기는 triggerAlarm/stopAlarm이 하고, VUI는 접근성(포커스·Esc)만
    const overlayModal = window.VUI ? VUI.modal.bind('#alarm-overlay', {
      manual: true, initialFocus: '#stop-alarm', onClose: () => stopAlarm(),
    }) : null;
    function openModal(id) {
      if (id === 'logModal') renderLogs();
      if (modals[id]) modals[id].open(); else $(id).classList.add('open');
    }
    function closeModal(id) {
      if (modals[id]) modals[id].close(); else $(id).classList.remove('open');
      if (id === 'aiModal') abortAi();
    }
    const isModalOpen = () => !!document.querySelector('.modal.open, .vui-overlay:not([hidden])');
    ['alarmName', 'alarmTime'].forEach(fid => $(fid).addEventListener('keydown', e => {
      if (e.key === 'Enter' && !e.isComposing) { e.preventDefault(); saveAlarm(); }
    }));

    // 다음 알람(시정 종 포함): 지금으로부터 가장 가까운 발동 시점
    function nextAlarmInfo(now) {
      let best = null;
      const consider = (name, time, days) => {
        const [ah, am] = String(time).split(':').map(Number);
        if (Number.isNaN(ah) || Number.isNaN(am) || !days || !days.length) return;
        for (const d of days) {
          const when = new Date(now);
          when.setHours(ah, am, 0, 0);
          when.setDate(when.getDate() + ((d - now.getDay() + 7) % 7));
          if (when <= now) when.setDate(when.getDate() + 7);   // 오늘 이미 지났으면 다음 주 같은 요일
          if (!best || when < best.when) best = { name, time, when };
        }
      };
      for (const a of alarms) if (a.enabled !== false && Array.isArray(a.days)) consider(a.name, a.time, a.days);
      const tt = activeTT();
      if (tt) for (const b of bellsOf(tt)) consider(b.name, b.time, tt.days);
      return best;
    }
    function fmtDelta(ms) {
      const totalMin = Math.floor(ms / 60000);
      if (totalMin <= 0) return '곧';
      const days = Math.floor(totalMin / 1440);
      const hours = Math.floor((totalMin % 1440) / 60);
      const mins = totalMin % 60;
      if (days > 0)  return `${days}일 ${hours}시간 후`;
      if (hours > 0) return `${hours}시간 ${mins}분 후`;
      return `${mins}분 후`;
    }
    let nextCacheMin = -1, nextCacheText = '';
    function updateNextAlarm(now) {
      const minKey = Math.floor(now.getTime() / 60000);
      if (minKey !== nextCacheMin) {   // 1분에 한 번만 다시 계산
        nextCacheMin = minKey;
        const next = nextAlarmInfo(now);
        nextCacheText = next ? `다음 알람 · ${next.name} ${next.time} · ${fmtDelta(next.when - now)}` : '예정된 알람이 없습니다';
      }
      const el = $('next-alarm');
      if (el.textContent !== nextCacheText) el.textContent = nextCacheText;
    }
    function invalidateNext() { nextCacheMin = -1; }

    // 시계 + 시정 안내
    let lastStatus = null;
    function paintClock(now) {
      $('main-clock').textContent = now.toLocaleTimeString('ko-KR', { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
      const ds = now.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' });
      if ($('main-date').textContent !== ds) $('main-date').textContent = ds;
      updateNextAlarm(now);
      const st = $('tt-status');
      const info = dayInfo(now);
      const text = info.tt ? statusText(info) : '';
      const key = info.tt ? 't:' + text : 'none';
      if (key === lastStatus) return;
      lastStatus = key;
      if (info.tt) {
        st.hidden = false;
        st.className = 'tt-status';
        st.removeAttribute('role'); st.removeAttribute('tabindex');
        st.innerHTML = ic('calendar-clock') + '<span>' + esc(text) + '</span>';
      } else {
        // 시정이 없으면 만들어 보라는 작은 안내(누르면 시정 탭)
        st.hidden = false;
        st.className = 'tt-status muted';
        st.setAttribute('role', 'button'); st.setAttribute('tabindex', '0');
        st.innerHTML = ic('calendar-clock') + '<span>시정을 정하면 지금 몇 교시인지 알려 줘요</span>';
      }
    }
    $('tt-status').addEventListener('click', () => { if (!activeTT()) setMainTab('timetable', true); });
    $('tt-status').addEventListener('keydown', e => { if ((e.key === 'Enter' || e.key === ' ') && !activeTT()) { e.preventDefault(); setMainTab('timetable', true); } });
  </script>

  <script is:inline="">
    /* ═════════════ 4. 카운트다운(F1) ═════════════ */
    // timer_countdown: { endAt, total, base, paused, remain, label, sound, ended } — 기기별(동기화 안 함)
    const CD_MAX = 99 * 60 + 59;
    function loadCd() {
      const v = sget('timer_countdown', null, x => !!x && typeof x === 'object' && Number.isFinite(x.endAt) && Number.isFinite(x.total) && x.total > 0);
      if (!v) return null;
      const now = Date.now();
      const out = {
        endAt: v.endAt, total: v.total, base: Number.isFinite(v.base) && v.base > 0 ? v.base : v.total,
        paused: v.paused === true, remain: Number.isFinite(v.remain) ? Math.max(0, v.remain) : 0,
        label: cleanStr(v.label, 30), sound: soundOk(v.sound) ? v.sound : '', ended: v.ended === true,
      };
      // 새로고침 사이에 끝났으면: 10분 안이면 "시간 끝!"만 조용히 보여 주고, 오래됐으면 지운다
      if (!out.paused && out.endAt <= now) {
        if (now - out.endAt > 10 * 60 * 1000) { removeKey('timer_countdown'); return null; }
        out.ended = true;
      }
      return out;
    }
    let cd = loadCd();
    let cdRingTimer = null, lastBeepSec = null, cdLastText = '', cdFlashTimer = null;
    const baseTitle = document.title;
    function saveCd() { if (cd) saveList('timer_countdown', cd); else removeKey('timer_countdown'); }
    const cdRemainMs = (now) => !cd ? 0 : cd.ended ? 0 : Math.max(0, cd.paused ? cd.remain : cd.endAt - now);

    function startCountdown(sec, opts) {
      opts = opts || {};
      sec = Math.round(sec);
      if (!(sec > 0)) { toast('시간을 1초 이상으로 정해 주세요.', 'error'); return; }
      sec = Math.min(sec, CD_MAX);
      unlockAudio();
      stopCdSound();
      cd = { endAt: Date.now() + sec * 1000, total: sec * 1000, base: sec * 1000, paused: false, remain: 0,
             label: cleanStr(opts.label || '', 30), sound: soundOk(opts.sound) ? opts.sound : '', ended: false };
      lastBeepSec = null;
      saveCd();
      renderCd(Date.now(), true);
      if (opts.full) enterCdFull();
      announce(`${cd.label ? cd.label + ' ' : ''}${fmtDur(sec)} 카운트다운을 시작했어요.`);
      syncWake();
    }
    function cdTogglePause() {
      if (!cd || cd.ended) return;
      const now = Date.now();
      if (cd.paused) { cd.endAt = now + cd.remain; cd.paused = false; announce('이어서 가요.'); }
      else { cd.remain = Math.max(0, cd.endAt - now); cd.paused = true; announce('잠깐 멈췄어요.'); }
      saveCd(); renderCd(now, true); syncWake();
    }
    function cdAddMinute() {
      if (!cd) return;
      if (cd.ended) { stopCdSound(); startCountdown(60, { label: cd.label, sound: cd.sound, full: cdFull }); return; }
      if (cd.paused) cd.remain += 60000; else cd.endAt += 60000;
      cd.total += 60000;
      if (cd.total > CD_MAX * 1000) cd.total = CD_MAX * 1000;
      saveCd(); renderCd(Date.now(), true);
      announce('1분 늘렸어요.');
    }
    function cdRestart() {
      if (!cd) return;
      stopCdSound();
      cd.total = cd.base; cd.endAt = Date.now() + cd.base; cd.paused = false; cd.remain = 0; cd.ended = false;
      lastBeepSec = null;
      saveCd(); renderCd(Date.now(), true); syncWake();
      announce('처음부터 다시 시작했어요.');
    }
    function cdStop() {
      stopCdSound();
      cd = null; saveCd();
      exitCdFull();
      renderCd(Date.now(), true);
      document.title = baseTitle;
      syncWake();
      $('cd-start').focus({ preventScroll: true });
    }
    function stopCdSound() {
      clearTimeout(cdRingTimer); cdRingTimer = null;
      if (ringing === 'countdown') stopRingSound();
    }
    function onCdEnd() {
      cd.ended = true; cd.paused = false;
      saveCd();
      const stage = $('cd-stage');
      stage.classList.remove('flash'); void stage.offsetWidth; stage.classList.add('flash');
      clearTimeout(cdFlashTimer); cdFlashTimer = setTimeout(() => stage.classList.remove('flash'), 1600);
      // 알람·시정 종이 울리는 중이면 알람이 이긴다(카운트다운 소리는 내지 않음)
      if (!isAlarmPlaying) {
        startRing(cd.sound || settings.cdSound, 'countdown');
        clearTimeout(cdRingTimer);
        cdRingTimer = setTimeout(() => { stopCdSound(); announce('1분이 지나서 소리를 멈췄어요.'); renderCd(Date.now(), true); }, RING_MAX_MS);
      }
      announce(`${cd.label ? cd.label + ' ' : ''}시간이 끝났어요!`);
      if (document.hidden && window.Notification && Notification.permission === 'granted') {
        try { new Notification('스마트 타이머', { body: `${cd.label || '카운트다운'} 시간 끝!` }); } catch (e) {}
      }
      syncWake();
    }
    const RING_C = 2 * Math.PI * 54;
    $('cd-ring-fill').style.strokeDasharray = String(RING_C);
    function renderCd(now, force) {
      const stage = $('cd-stage'), setup = $('cd-setup');
      if (!cd) {
        if (!stage.hidden) { stage.hidden = true; setup.hidden = false; }
        cdLastText = '';
        return;
      }
      if (stage.hidden) { stage.hidden = false; setup.hidden = true; }
      if (!cd.ended && !cd.paused && cd.endAt <= now) onCdEnd();
      const remain = cdRemainMs(now);
      const secs = Math.ceil(remain / 1000);
      const text = cd.ended ? '시간 끝!' : fmtClock(secs);
      const timeEl = $('cd-time');
      stage.classList.toggle('ring', settings.cdShape === 'ring');
      if (text !== cdLastText || force) {
        cdLastText = text;
        timeEl.textContent = text;
        timeEl.classList.toggle('ended', cd.ended);
        const final = !cd.ended && !cd.paused && secs <= 10;
        timeEl.classList.toggle('final', final);
        $('cd-label').textContent = cd.label + (cd.paused ? (cd.label ? ' · ' : '') + '멈춤' : '');
        document.title = cd.ended ? '시간 끝! · ' + baseTitle : `${text} · ${baseTitle}`;
        // 마지막 10초: 초마다 짧은 소리(설정) — 알람이 울리는 중이면 내지 않음
        if (final && settings.cdBeep && secs > 0 && secs !== lastBeepSec && !isAlarmPlaying) { lastBeepSec = secs; tickBeep(secs <= 3); }
        const pb = $('cd-pause');
        pb.hidden = cd.ended;
        pb.innerHTML = cd.paused ? ic('play') + '<span>이어서</span>' : ic('pause') + '<span>멈춤</span>';
        $('cd-plus').hidden = false;
        $('cd-stop').innerHTML = ic('square') + (cd.ended && ringing === 'countdown' ? '그만 울리기' : '끝내기');
      }
      const frac = cd.total ? Math.min(1, remain / cd.total) : 0;
      stage.classList.toggle('mid', frac < 0.5 && frac >= 0.2);
      stage.classList.toggle('low', frac < 0.2);
      $('cd-bar-fill').style.width = (frac * 100).toFixed(2) + '%';
      $('cd-ring-fill').style.strokeDashoffset = String(RING_C * (1 - frac));
    }

    $('panel-countdown').addEventListener('click', e => {
      const q = e.target.closest('[data-quick]');
      if (q) startCountdown(Number(q.dataset.quick), {});
    });
    function readMinSec(minEl, secEl) {
      const m = Math.max(0, Math.min(999, parseInt(minEl.value, 10) || 0));
      const s = Math.max(0, Math.min(59, parseInt(secEl.value, 10) || 0));
      return m * 60 + s;
    }
    $('cd-start').addEventListener('click', () => startCountdown(readMinSec($('cd-min'), $('cd-sec')), {}));
    ['cd-min', 'cd-sec'].forEach(id => $(id).addEventListener('keydown', e => {
      if (e.key === 'Enter' && !e.isComposing) { e.preventDefault(); $('cd-start').click(); }
    }));
    $('cd-pause').addEventListener('click', cdTogglePause);
    $('cd-plus').addEventListener('click', cdAddMinute);
    $('cd-restart').addEventListener('click', cdRestart);
    $('cd-stop').addEventListener('click', () => {
      if (cd && cd.ended && ringing === 'countdown') { stopCdSound(); renderCd(Date.now(), true); return; }
      cdStop();
    });
    $('cd-full').addEventListener('click', () => (cdFull ? exitCdFull() : enterCdFull()));

    /* 전체화면: 문서 전체를 전체화면으로 하고 카운트다운 칸을 화면 가득 키운다
       (알람·가림 화면·확인 창이 그 위에 보이도록). 전체화면 API가 없으면(iOS) 꽉 찬 창만. */
    let cdFull = false, fsByUs = false;
    const fsEl = () => document.fullscreenElement || document.webkitFullscreenElement || null;
    function requestFs() {
      const el = document.documentElement;
      const fn = el.requestFullscreen || el.webkitRequestFullscreen;
      if (!fn || fsEl()) return false;
      try { const p = fn.call(el); fsByUs = true; if (p && p.catch) p.catch(() => { fsByUs = false; }); return true; } catch (e) { return false; }
    }
    function exitFs() {
      if (!fsEl()) return;
      const fn = document.exitFullscreen || document.webkitExitFullscreen;
      try { const p = fn && fn.call(document); if (p && p.catch) p.catch(() => {}); } catch (e) {}
      fsByUs = false;
    }
    function enterCdFull() {
      if (!cd) return;
      if (settings.tab !== 'countdown') setMainTab('countdown');   // 숨은 탭 안에서는 보이지 않으므로
      cdFull = true;
      $('cd-stage').classList.add('full');
      document.body.classList.add('is-fs');
      requestFs();
      updateFullButtons();
      renderCd(Date.now(), true);
    }
    function exitCdFull() {
      const was = cdFull;
      cdFull = false;
      $('cd-stage').classList.remove('full');
      document.body.classList.remove('is-fs');
      if (was && !blank) exitFs();
      updateFullButtons();
    }
    function updateFullButtons() {
      const b = $('cd-full');
      b.innerHTML = cdFull ? ic('minimize') + '<span>작게</span>' : ic('maximize') + '<span>전체화면</span>';
      b.setAttribute('aria-label', cdFull ? '전체화면 나가기' : '전체화면');
      const bar = $('bar-full');
      const on = cdFull || !!fsEl();
      bar.innerHTML = (on ? ic('minimize') : ic('maximize')) + `<span>${on ? '전체화면 나가기' : '전체화면'}</span>`;
      bar.setAttribute('aria-label', on ? '전체화면 나가기' : '전체화면');
    }
    function onFsChange() {
      // Esc 등으로 브라우저 전체화면이 풀리면 카운트다운 큰 화면도 같이 푼다
      if (!fsEl()) { fsByUs = false; if (cdFull) { cdFull = false; $('cd-stage').classList.remove('full'); document.body.classList.remove('is-fs'); } }
      updateFullButtons();
    }
    document.addEventListener('fullscreenchange', onFsChange);
    document.addEventListener('webkitfullscreenchange', onFsChange);
    $('bar-full').addEventListener('click', () => {
      if (cd) { cdFull ? exitCdFull() : enterCdFull(); return; }
      if (fsEl()) { exitFs(); return; }
      if (!requestFs()) toast('이 브라우저는 전체화면을 지원하지 않아요. 카운트다운을 시작하면 화면 가득 볼 수 있어요.');
    });

    // 키보드: Space 멈춤·이어서 / ↑ 1분 더 / Esc 전체화면 나가기 (입력 칸·창이 열려 있을 땐 무시)
    document.addEventListener('keydown', e => {
      if (blank || e.defaultPrevented || e.ctrlKey || e.metaKey || e.altKey) return;
      const t = e.target;
      if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
      if (isModalOpen() || isAlarmPlaying) return;
      if (!cd || (settings.tab !== 'countdown' && !cdFull)) return;
      if (e.key === ' ' || e.code === 'Space') {
        if (t && t.tagName === 'BUTTON' && !cdFull) return;   // 버튼 위의 Space는 버튼 누르기
        e.preventDefault(); cdTogglePause();
      } else if (e.key === 'ArrowUp') { e.preventDefault(); cdAddMinute(); }
      else if (e.key === 'Escape' && cdFull) { e.preventDefault(); exitCdFull(); }
    });

    /* ═════════════ 5. 자주 쓰는 타이머(F2) ═════════════ */
    const COLORS = { blue: ['#006fee', '파랑'], green: ['#17c964', '초록'], orange: ['#f5a524', '주황'], red: ['#f31260', '빨강'], purple: ['#7828c8', '보라'] };
    const PRESET_MAX = 20;
    const PRESET_DEFAULTS = [
      { name: '생각하기', sec: 180, color: 'blue' }, { name: '짝 활동', sec: 300, color: 'green' },
      { name: '독서', sec: 900, color: 'purple' }, { name: '청소', sec: 600, color: 'orange' },
    ];
    function normalizePreset(p, i) {
      if (!p || typeof p !== 'object') return null;
      const name = cleanStr(p.name, 20);
      const sec = Math.round(Number(p.sec));
      if (!name || !(sec >= 1 && sec <= CD_MAX)) return null;
      return {
        id: typeof p.id === 'string' && /^[\w-]{1,40}$/.test(p.id) ? p.id : newId('p'),
        name, sec, sound: soundOk(p.sound) ? p.sound : '', color: COLORS[p.color] ? p.color : 'blue',
        order: i, blank: p.blank === true,
      };
    }
    function loadPresets() {
      const raw = sget('timer_presets', null, Array.isArray);
      const src = raw || PRESET_DEFAULTS;   // 처음에는 예시 4개(저장은 고칠 때)
      return src.slice(0, PRESET_MAX).map(normalizePreset).filter(Boolean)
        .sort((a, b) => a.order - b.order).map((p, i) => ({ ...p, order: i }));
    }
    let presets = loadPresets();
    function savePresets() { presets.forEach((p, i) => { p.order = i; }); saveList('timer_presets', presets); renderPresets(); }
    function renderPresets() {
      const row = $('preset-row');
      if (!presets.length) {
        row.innerHTML = '<p class="note">자주 쓰는 타이머가 없어요. [고치기]에서 만들어 보세요.</p>';
      } else {
        row.innerHTML = presets.map(p => `<button type="button" class="preset-btn" data-preset="${esc(p.id)}" style="--pc:${COLORS[p.color][0]}">
          <b>${esc(p.name)}</b><small>${p.blank ? ic('eye-off') + '가림 ' : ''}${esc(fmtDur(p.sec))}</small></button>`).join('');
      }
      if (modals.presetModal && modals.presetModal.isOpen()) renderPresetManager();
    }
    function runPreset(id) {
      const p = presets.find(x => x.id === id);
      if (!p) return;
      if (p.blank) { startBlank(p.sec); return; }
      startCountdown(p.sec, { label: p.name, sound: p.sound, full: settings.cdAutoFs });
    }
    $('preset-row').addEventListener('click', e => {
      const b = e.target.closest('[data-preset]');
      if (b) runPreset(b.dataset.preset);
    });
    function renderPresetManager() {
      const list = $('pm-list');
      if (!presets.length) { list.innerHTML = '<p class="note">아직 없어요. [타이머 추가]를 눌러 보세요.</p>'; }
      else list.innerHTML = presets.map((p, i) => `<div class="pm-item" style="--pc:${COLORS[p.color][0]}">
        <div class="pm-text"><b>${esc(p.name)}</b><small>${esc(fmtDur(p.sec))}${p.blank ? ' · ' + ic('eye-off') + '가림 화면' : ''}</small></div>
        <button type="button" class="action-btn" data-pm="up" data-id="${esc(p.id)}" aria-label="${esc(p.name)} 위로" ${i === 0 ? 'disabled' : ''}>${ic('chevron-up')}</button>
        <button type="button" class="action-btn" data-pm="down" data-id="${esc(p.id)}" aria-label="${esc(p.name)} 아래로" ${i === presets.length - 1 ? 'disabled' : ''}>${ic('chevron-down')}</button>
        <button type="button" class="action-btn edit" data-pm="edit" data-id="${esc(p.id)}" aria-label="${esc(p.name)} 고치기">${ic('pencil')}</button>
        <button type="button" class="action-btn delete" data-pm="del" data-id="${esc(p.id)}" aria-label="${esc(p.name)} 지우기">${ic('trash-2')}</button>
      </div>`).join('');
      $('pm-add').disabled = presets.length >= PRESET_MAX;
    }
    $('preset-manage').addEventListener('click', () => { renderPresetManager(); openModal('presetModal'); });
    $('pm-list').addEventListener('click', e => {
      const b = e.target.closest('[data-pm]');
      if (!b || b.disabled) return;
      const idx = presets.findIndex(p => p.id === b.dataset.id);
      if (idx < 0) return;
      const act = b.dataset.pm;
      if (act === 'up' || act === 'down') {
        const j = act === 'up' ? idx - 1 : idx + 1;
        if (j < 0 || j >= presets.length) return;
        [presets[idx], presets[j]] = [presets[j], presets[idx]];
        savePresets();
        const again = document.querySelector(`#pm-list [data-pm="${act}"][data-id="${CSS.escape(presets[j].id)}"]`);
        (again && !again.disabled ? again : document.querySelector(`#pm-list [data-id="${CSS.escape(presets[j].id)}"]`))?.focus();
      } else if (act === 'edit') {
        openPresetEdit(presets[idx]);
      } else if (act === 'del') {
        const p = presets[idx];
        presets.splice(idx, 1);
        savePresets();
        undoToast(`'${p.name}' 타이머를 지웠어요`, () => {
          if (presets.some(x => x.id === p.id) || presets.length >= PRESET_MAX) return;
          presets.splice(Math.min(idx, presets.length), 0, p);
          savePresets();
        });
        $('pm-add').focus();
      }
    });
    $('pe-colors').innerHTML = Object.keys(COLORS).map(k => `<label><input type="radio" name="pe-color" value="${k}" aria-label="${COLORS[k][1]}"><span style="--sw:${COLORS[k][0]}"></span></label>`).join('');
    function openPresetEdit(p) {
      $('pe-title').textContent = p ? '타이머 고치기' : '타이머 추가';
      $('pe-id').value = p ? p.id : '';
      $('pe-name').value = p ? p.name : '';
      $('pe-min').value = p ? Math.floor(p.sec / 60) : 5;
      $('pe-sec').value = p ? p.sec % 60 : 0;
      $('pe-sound').value = p && p.sound ? p.sound : settings.cdSound;
      const color = p ? p.color : Object.keys(COLORS)[presets.length % 5];
      document.querySelectorAll('input[name="pe-color"]').forEach(r => { r.checked = r.value === color; });
      $('pe-blank').checked = !!(p && p.blank);
      openModal('presetEditModal');
    }
    $('pm-add').addEventListener('click', () => openPresetEdit(null));
    $('pe-save').addEventListener('click', () => {
      const name = cleanStr($('pe-name').value, 20);
      const sec = readMinSec($('pe-min'), $('pe-sec'));
      if (!name) { toast('이름을 적어 주세요.', 'error'); $('pe-name').focus(); return; }
      if (!(sec >= 1 && sec <= CD_MAX)) { toast('시간은 1초부터 99분 59초까지 정할 수 있어요.', 'error'); $('pe-min').focus(); return; }
      const colorEl = document.querySelector('input[name="pe-color"]:checked');
      const data = { name, sec, sound: $('pe-sound').value, color: colorEl ? colorEl.value : 'blue', blank: $('pe-blank').checked };
      const id = $('pe-id').value;
      if (id) {
        const p = presets.find(x => x.id === id);
        if (p) Object.assign(p, data);
      } else {
        if (presets.length >= PRESET_MAX) { toast(`자주 쓰는 타이머는 ${PRESET_MAX}개까지예요.`, 'error'); return; }
        presets.push(normalizePreset({ ...data, id: newId('p') }, presets.length));
      }
      savePresets();
      closeModal('presetEditModal');
      toast(id ? '타이머를 고쳤어요' : `'${name}' 타이머를 만들었어요`, 'success');
    });
    $('pe-name').addEventListener('keydown', e => { if (e.key === 'Enter' && !e.isComposing) { e.preventDefault(); $('pe-save').click(); } });
  </script>

  <script is:inline="">
    /* ═════════════ 6. 가림 화면 타이머(F8) ═════════════ */
    // timer_blank: { endAt, total } — 기기별(동기화 안 함). 새로고침해도 남은 시간 동안 다시 가린다.
    const blankEl = $('blank');
    document.body.appendChild(blankEl);   // 맨 끝으로 옮겨 공용 상단 버튼보다 위에 오게
    let blank = sget('timer_blank', null, v => !!v && typeof v === 'object' && Number.isFinite(v.endAt));
    if (blank && blank.endAt <= Date.now()) { blank = null; removeKey('timer_blank'); }
    let blankAsking = false, blankLastTap = 0, blankHideTimer = null, blankFs = false, blankLastText = '';
    function startBlank(sec) {
      sec = Math.round(sec);
      if (!(sec > 0)) { toast('가릴 시간을 1초 이상으로 정해 주세요.', 'error'); return; }
      sec = Math.min(sec, 6 * 3600);
      unlockAudio();
      closeModal('blankModal');
      blank = { endAt: Date.now() + sec * 1000, total: sec * 1000 };
      saveList('timer_blank', blank);
      blankFs = !fsEl() && requestFs();
      showBlank();
      syncWake();
    }
    function showBlank() {
      clearTimeout(blankHideTimer);
      blankEl.classList.remove('lifting', 'show-none', 'show-small', 'show-large');
      blankEl.classList.add('show-' + settings.blankShow);
      blankEl.hidden = false;
      document.body.classList.add('blank-on');
      blankLastText = '';
      renderBlank(Date.now());
      try { blankEl.focus({ preventScroll: true }); } catch (e) {}
    }
    function renderBlank(now) {
      if (!blank) return;
      if (now >= blank.endAt) { liftBlank('time'); return; }
      if (settings.blankShow === 'none') return;
      const t = fmtClock(Math.ceil((blank.endAt - now) / 1000));
      if (t !== blankLastText) { blankLastText = t; $('blank-time').textContent = t; }
    }
    function liftBlank(reason) {
      if (!blank) return;
      blank = null;
      removeKey('timer_blank');
      document.body.classList.remove('blank-on');
      if (reason === 'time' && settings.blankSound && !isAlarmPlaying) playOnce('marimba');
      if (blankFs && fsEl() && !cdFull) exitFs();
      blankFs = false;
      if (reduceMotion()) { blankEl.hidden = true; }
      else {
        blankEl.classList.add('lifting');
        clearTimeout(blankHideTimer);
        blankHideTimer = setTimeout(() => { blankEl.hidden = true; blankEl.classList.remove('lifting'); }, 650);
      }
      announce(reason === 'time' ? '가림 화면이 걷혔어요.' : '가림 화면을 끝냈어요.');
      syncWake();
    }
    async function askEndBlank() {
      if (!blank || blankAsking) return;
      blankAsking = true;
      const ok = await ask('가림 화면을 끝낼까요?', { title: '가림 화면', ok: '끝내기', cancel: '계속 가리기' });
      blankAsking = false;
      if (ok) liftBlank('user');
      else if (blank) { try { blankEl.focus({ preventScroll: true }); } catch (e) {} }
    }
    // 한 번 누르기·Space는 무시(학생이 실수로 건드려도 그대로). 두 번 누르기·Esc만 확인 창.
    blankEl.addEventListener('pointerdown', e => {
      e.preventDefault();
      const t = Date.now();
      if (t - blankLastTap < 450) { blankLastTap = 0; askEndBlank(); }
      else blankLastTap = t;
    });
    blankEl.addEventListener('contextmenu', e => e.preventDefault());
    document.addEventListener('keydown', e => {
      if (!blank || blankAsking) return;
      e.preventDefault();
      e.stopPropagation();
      if (e.key === 'Escape' || e.key === 'Esc') askEndBlank();
    }, true);

    function openBlankModal() {
      const nb = nextBellMs(new Date());
      const btn = $('blank-next');
      if (nb && nb.at - Date.now() > 5000) {
        btn.hidden = false;
        btn.dataset.at = String(nb.at);
        $('blank-next-text').textContent = `다음 종까지 (${fmtDur(Math.round((nb.at - Date.now()) / 1000))} · ${nb.name})`;
      } else btn.hidden = true;
      document.querySelectorAll('input[name="blank-show-m"]').forEach(r => { r.checked = r.value === settings.blankShow; });
      openModal('blankModal');
    }
    $('bar-blank').addEventListener('click', () => {
      if (blank) { showBlank(); return; }
      openBlankModal();
    });
    $('blankModal').addEventListener('click', e => {
      const q = e.target.closest('[data-blank]');
      if (q) startBlank(Number(q.dataset.blank));
    });
    $('blank-next').addEventListener('click', () => {
      const at = Number($('blank-next').dataset.at);
      if (at > Date.now()) startBlank((at - Date.now()) / 1000);
    });
    $('blank-start').addEventListener('click', () => startBlank(readMinSec($('blank-min'), $('blank-sec'))));
    document.querySelectorAll('input[name="blank-show-m"]').forEach(r => r.addEventListener('change', () => {
      settings.blankShow = r.value; saveSettings(); syncSettingsForm();
    }));

    /* ═════════════ 7. 화면 켜 두기(F7) ═════════════ */
    const wakeSupported = 'wakeLock' in navigator;
    let wakeLock = null, wakePending = false, wakeLastTry = 0;
    function wakeDesired() {
      const m = settings.wakeLock;
      if (m === 'off') return false;
      if (m === 'on') return true;
      return !!(blank || (cd && !cd.ended) || todayTT(new Date()));
    }
    async function syncWake() {
      if (wakeSupported) {
        const want = wakeDesired();
        if (want && !wakeLock && !wakePending && document.visibilityState === 'visible' && Date.now() - wakeLastTry > 10000) {
          wakePending = true; wakeLastTry = Date.now();
          try {
            const l = await navigator.wakeLock.request('screen');
            wakeLock = l;
            l.addEventListener('release', () => { if (wakeLock === l) wakeLock = null; renderWake(); });
            if (!wakeDesired()) { wakeLock = null; l.release().catch(() => {}); }
          } catch (e) { /* 배터리 절약 모드 등으로 거절 — 10초 뒤 다시 */ }
          wakePending = false;
        } else if (!want && wakeLock) {
          const l = wakeLock; wakeLock = null;
          try { await l.release(); } catch (e) {}
        }
      }
      renderWake();
    }
    const WAKE_TEXT = { auto: '자동', on: '항상', off: '끔' };
    let wakeLastRender = '';
    function renderWake() {
      const held = !!(wakeLock && !wakeLock.released);
      const key = wakeSupported + settings.wakeLock + held;
      if (key === wakeLastRender) return;
      wakeLastRender = key;
      $('wake-dot').classList.toggle('on', held);
      $('wake-text').textContent = wakeSupported ? WAKE_TEXT[settings.wakeLock] : '지원 안 함';
      $('bar-wake').setAttribute('aria-label', wakeSupported
        ? `화면 켜 두기: ${WAKE_TEXT[settings.wakeLock]}, 지금 ${held ? '켜 두는 중' : '꺼질 수 있음'}. 누르면 바뀌어요`
        : '화면 켜 두기: 이 브라우저는 지원하지 않아요');
      const note = $('set-wake-note');
      if (note) note.textContent = !wakeSupported
        ? '이 브라우저는 화면 켜 두기를 지원하지 않아요. 컴퓨터의 화면 꺼짐 시간을 늘려 주세요.'
        : `자동: 시정을 쓰는 날, 카운트다운·가림 화면 중에만 화면이 꺼지지 않게 해요. 지금: ${held ? '켜 두는 중' : '꺼질 수 있음'}`;
    }
    document.addEventListener('visibilitychange', () => {
      // 탭을 다녀오면 브라우저가 풀어 버리므로 돌아오면 다시 요청
      if (document.visibilityState === 'visible') { wakeLastTry = 0; syncWake(); }
    });
    $('bar-wake').addEventListener('click', () => {
      if (!wakeSupported) { toast('이 브라우저는 화면 켜 두기를 지원하지 않아요. Chrome·Edge·Safari 최신판에서 쓸 수 있어요.'); return; }
      const order = ['auto', 'on', 'off'];
      settings.wakeLock = order[(order.indexOf(settings.wakeLock) + 1) % 3];
      saveSettings();
      wakeLastTry = 0;
      syncWake();
      syncSettingsForm();
      toast({ auto: '화면 켜 두기: 자동 — 시정·카운트다운·가림 화면을 쓸 때만 켜 둬요',
              on: '화면 켜 두기: 항상 — 이 화면을 여는 동안 꺼지지 않아요',
              off: '화면 켜 두기: 끔 — 컴퓨터 설정대로 화면이 꺼져요' }[settings.wakeLock]);
    });

    /* ═════════════ 8. 탭 ═════════════ */
    function setMainTab(tab, focus) {
      if (!TABS.includes(tab)) tab = 'countdown';
      document.querySelectorAll('.main-tab').forEach(b => {
        const on = b.dataset.tab === tab;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        if (on && focus) b.focus();
      });
      TABS.forEach(t => { $('panel-' + t).hidden = t !== tab; });
      if (settings.tab !== tab) { settings.tab = tab; saveSettings(); }
      if (tab === 'alarms') { renderAlarms(); updateTabFade(); }
      if (tab === 'timetable') renderTTList();
      if (tab === 'music') initMusic();
    }
    document.querySelector('.main-tabs').addEventListener('click', e => {
      const b = e.target.closest('.main-tab');
      if (b) setMainTab(b.dataset.tab);
    });
    document.querySelector('.main-tabs').addEventListener('keydown', e => {
      const i = TABS.indexOf(settings.tab);
      let j = -1;
      if (e.key === 'ArrowRight') j = (i + 1) % TABS.length;
      else if (e.key === 'ArrowLeft') j = (i + TABS.length - 1) % TABS.length;
      else if (e.key === 'Home') j = 0;
      else if (e.key === 'End') j = TABS.length - 1;
      if (j >= 0) { e.preventDefault(); setMainTab(TABS[j], true); }
    });

    /* ═════════════ 9. 설정 창 ═════════════ */
    function syncSettingsForm() {
      $('set-alarm-sound').value = settings.alarmSound;
      $('set-cd-sound').value = settings.cdSound;
      $('set-cd-beep').checked = settings.cdBeep;
      $('set-cd-autofs').checked = settings.cdAutoFs;
      $('set-blank-sound').checked = settings.blankSound;
      $('set-blank-bell').checked = settings.blankLiftOnBell;
      $('music-autostop').checked = settings.musicAutoStop;
      $('music-grade').value = settings.musicGrade;
      document.querySelectorAll('input[name="set-shape"]').forEach(r => { r.checked = r.value === settings.cdShape; });
      document.querySelectorAll('input[name="set-wake"]').forEach(r => { r.checked = r.value === settings.wakeLock; });
      document.querySelectorAll('input[name="set-blank-show"]').forEach(r => { r.checked = r.value === settings.blankShow; });
      wakeLastRender = ''; renderWake();
    }
    function bindSetting(id, key, prop) {
      $(id).addEventListener('change', e => { settings[key] = e.target[prop || 'value']; saveSettings(); afterSettingChange(key); });
    }
    bindSetting('set-alarm-sound', 'alarmSound');
    bindSetting('set-cd-sound', 'cdSound');
    bindSetting('set-cd-beep', 'cdBeep', 'checked');
    bindSetting('set-cd-autofs', 'cdAutoFs', 'checked');
    bindSetting('set-blank-sound', 'blankSound', 'checked');
    bindSetting('set-blank-bell', 'blankLiftOnBell', 'checked');
    bindSetting('music-autostop', 'musicAutoStop', 'checked');
    bindSetting('music-grade', 'musicGrade');
    [['set-shape', 'cdShape'], ['set-wake', 'wakeLock'], ['set-blank-show', 'blankShow']].forEach(([name, key]) => {
      document.querySelectorAll(`input[name="${name}"]`).forEach(r => r.addEventListener('change', () => {
        if (!r.checked) return;
        settings[key] = r.value; saveSettings(); afterSettingChange(key);
      }));
    });
    function afterSettingChange(key) {
      if (key === 'cdShape') renderCd(Date.now(), true);
      if (key === 'wakeLock') { wakeLastTry = 0; syncWake(); }
      if (key === 'blankShow' && blank) showBlank();
      if (key === 'musicGrade') renderMusic();
      if (key === 'musicAutoStop' && settings.musicAutoStop && mp.id && !mp.stopAt) {   // 재생 중에 켠 경우
        const nc = nextClassStartMs(new Date());
        if (nc && nc.at - Date.now() < 4 * 3600 * 1000) { mp.stopAt = nc.at; mp.stopLabel = nc.label; }
      }
      syncSettingsForm();
    }
    $('bar-settings').addEventListener('click', () => { syncSettingsForm(); openModal('settingsModal'); });

    /* ═════════════ 10. 파일로 저장·불러오기(v2, v1도 읽음) ═════════════ */
    function exportAll() {
      const data = {
        v: 2, app: 'eduin-timer', savedAt: new Date().toISOString(),
        alarms, alarm_logs: logs, timetables, timetable_active: activeId,
        presets, music_custom: myMusic, settings,
      };
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([JSON.stringify(data)], { type: 'application/json' }));
      const d = new Date();
      a.download = `timer_backup_${d.getFullYear()}${pad2(d.getMonth() + 1)}${pad2(d.getDate())}.json`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 4000);
      toast('백업 파일을 저장했어요', 'success');
    }
    function triggerImport() { $('importInput').click(); }
    function snapshotAll() {
      return { alarms, logs, timetables, activeId, presets, myMusic, settings: { ...settings } };
    }
    function restoreAll(s) {
      alarms = s.alarms; logs = s.logs; timetables = s.timetables; activeId = s.activeId;
      presets = s.presets; myMusic = s.myMusic; settings = { ...s.settings };
      saveList('alarms', alarms); saveList('alarm_logs', logs); saveList('timetables', timetables);
      saveList('timetable_active', activeId); saveList('timer_presets', presets);
      saveList('timer_music_custom', myMusic); saveSettings();
      refreshAll();
    }
    function importAlarms(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = async ev => {
        let data = null;
        e.target.value = '';   // 같은 파일을 다시 선택해도 onchange가 발동하도록 초기화
        try {
          data = JSON.parse(ev.target.result);
          if (!data || typeof data !== 'object' || !Array.isArray(data.alarms)) throw new Error('형식 오류');
        } catch (err) {
          toast('파일을 읽을 수 없어요. 이 앱에서 [파일로 저장]으로 받은 파일인지 확인해 주세요.', 'error');
          return;
        }
        const v2 = data.v === 2;
        const next = snapshotAll();
        next.alarms = data.alarms.filter(a => a && typeof a === 'object');
        const inLogs = v2 ? data.alarm_logs : data.logs;   // v1 파일은 logs
        next.logs = Array.isArray(inLogs) ? inLogs.filter(l => l && typeof l === 'object').slice(0, LOG_MAX) : [];
        if (v2) {
          if (Array.isArray(data.timetables)) {
            const seen = new Set();
            next.timetables = data.timetables.map(t => normalizeTT(t, true)).filter(t => t && !seen.has(t.id) && seen.add(t.id));
          }
          next.activeId = typeof data.timetable_active === 'string' && next.timetables.some(t => t.id === data.timetable_active) ? data.timetable_active : '';
          if (Array.isArray(data.presets)) next.presets = data.presets.slice(0, PRESET_MAX).map(normalizePreset).filter(Boolean);
          if (Array.isArray(data.music_custom)) next.myMusic = data.music_custom.map(normalizeMusic).filter(Boolean).slice(0, MY_MUSIC_MAX);
          if (isObj(data.settings)) next.settings = { ...loadSettings(data.settings), tab: settings.tab };
        }
        const parts = [`알람 ${next.alarms.length}개`];
        if (v2) parts.push(`시정 ${next.timetables.length}개`, `자주 쓰는 타이머 ${next.presets.length}개`);
        const hasNow = alarms.length || (v2 && (timetables.length || myMusic.length));
        // 지금 내용을 통째로 바꾸므로 먼저 묻고, 바꾼 뒤에도 되돌릴 수 있게
        if (hasNow) {
          const ok = await ask(`지금 내용을 파일의 ${parts.join('·')}로 바꿀까요?`, { title: '파일 불러오기', ok: '바꾸기', danger: true });
          if (!ok) return;
        }
        const prev = snapshotAll();
        restoreAll(next);
        const msg = `${parts.join('·')}를 불러왔어요`;
        if (hasNow) undoToast(msg, () => restoreAll(prev));
        else toast(msg, 'success');
      };
      reader.readAsText(file);
    }
  </script>

  <script is:inline="">
    /* ═════════════ 11. 시정 목록·편집(F3) ═════════════ */
    const TT_MAX = 20;
    const CHIME_DEFAULT = { atStart: true, atEnd: true, before: 0, sound: 'bell' };
    const P = (label, start, end, kind) => ({ label, start, end, kind });
    const TEMPLATES = {
      // 초등: 아침 활동 08:40, 1교시 09:00, 40분 수업·10분 쉬는 시간, 2교시 뒤 중간 놀이 20분, 4교시 뒤 점심
      elem: { name: '초등 평일 시정', periods: [
        P('아침 활동', '08:40', '09:00', 'morning'),
        P('1교시', '09:00', '09:40', 'class'), P('쉬는 시간', '09:40', '09:50', 'break'),
        P('2교시', '09:50', '10:30', 'class'), P('중간 놀이', '10:30', '10:50', 'break'),
        P('3교시', '10:50', '11:30', 'class'), P('쉬는 시간', '11:30', '11:40', 'break'),
        P('4교시', '11:40', '12:20', 'class'), P('점심시간', '12:20', '13:10', 'lunch'),
        P('5교시', '13:10', '13:50', 'class'), P('쉬는 시간', '13:50', '14:00', 'break'),
        P('6교시', '14:00', '14:40', 'class'),
      ] },
      // 중학교: 08:50 시작, 45분 수업·10분 쉬는 시간, 점심 12:30~13:20
      middle: { name: '중학교 평일 시정', periods: [
        P('아침 조회', '08:40', '08:50', 'morning'),
        P('1교시', '08:50', '09:35', 'class'), P('쉬는 시간', '09:35', '09:45', 'break'),
        P('2교시', '09:45', '10:30', 'class'), P('쉬는 시간', '10:30', '10:40', 'break'),
        P('3교시', '10:40', '11:25', 'class'), P('쉬는 시간', '11:25', '11:35', 'break'),
        P('4교시', '11:35', '12:20', 'class'), P('쉬는 시간', '12:20', '12:30', 'break'),
        P('점심시간', '12:30', '13:20', 'lunch'),
        P('5교시', '13:20', '14:05', 'class'), P('쉬는 시간', '14:05', '14:15', 'break'),
        P('6교시', '14:15', '15:00', 'class'), P('종례', '15:00', '15:10', 'etc'),
      ] },
    };
    function saveTTs() {
      saveList('timetables', timetables);
      bellCache.clear();
      invalidateNext(); lastStatus = null;
      renderTTList();
      renderAlarms();
      syncWake();
    }
    function setActive(id) {
      activeId = id || '';
      saveList('timetable_active', activeId);   // 빈 문자열 = 사용 안 함(동기화로 다른 기기도 꺼지게)
      invalidateNext(); lastStatus = null;
      paintClock(new Date());
      renderTTList(); renderAlarms(); syncWake();
      if (typeof renderMusic === 'function') renderMusic();
    }
    function renderTTList() {
      const list = $('tt-list');
      if (!timetables.length) {
        list.innerHTML = `<div class="empty-state">${ic('calendar-clock')}<p>아직 저장한 시정이 없어요.<br>[새 시정 만들기]에서 기본 틀을 불러오거나, 시정표 사진으로 만들어 보세요.</p></div>`;
        return;
      }
      list.innerHTML = timetables.map(t => {
        const on = t.id === activeId;
        const nClass = t.periods.filter(p => p.kind === 'class').length;
        const first = t.periods[0], last = t.periods[t.periods.length - 1];
        return `<div class="tt-card${on ? ' active' : ''}">
          <div class="tt-card-head"><b>${esc(t.name)}</b>${on ? `<span class="badge">${ic('check')}사용 중</span>` : ''}</div>
          <div class="tt-card-meta">${esc(daysText(t.days))} · 수업 ${nClass}개 · ${esc(first.start)}~${esc(last.end)} · 종 ${bellsOf(t).length}번</div>
          <div class="tt-card-actions">
            ${on ? `<button type="button" class="hero-btn hero-btn-ghost hero-btn-sm" data-tt="stop" data-id="${esc(t.id)}">${ic('bell-off')}그만 쓰기</button>`
                 : `<button type="button" class="hero-btn hero-btn-ghost hero-btn-sm" data-tt="use" data-id="${esc(t.id)}">${ic('bell')}사용하기</button>`}
            <button type="button" class="hero-btn hero-btn-ghost hero-btn-sm" data-tt="edit" data-id="${esc(t.id)}">${ic('pencil')}고치기</button>
            <button type="button" class="hero-btn hero-btn-ghost hero-btn-sm" data-tt="share" data-id="${esc(t.id)}">${ic('share-2')}공유</button>
            <button type="button" class="hero-btn hero-btn-danger hero-btn-sm hero-btn-icon" data-tt="del" data-id="${esc(t.id)}" aria-label="${esc(t.name)} 지우기">${ic('trash-2')}</button>
          </div>
        </div>`;
      }).join('');
    }
    $('tt-list').addEventListener('click', e => {
      const b = e.target.closest('[data-tt]');
      if (!b) return;
      const t = timetables.find(x => x.id === b.dataset.id);
      if (!t) return;
      const act = b.dataset.tt;
      if (act === 'use') { setActive(t.id); toast(`이제 '${t.name}' 시정대로 종이 울려요`, 'success'); unlockAudio(); }
      else if (act === 'stop') { setActive(''); toast('시정 종을 껐어요'); }
      else if (act === 'edit') openEditor(t);
      else if (act === 'share') shareTT(t);
      else if (act === 'del') {
        const idx = timetables.indexOf(t), wasActive = t.id === activeId;
        timetables.splice(idx, 1);
        if (wasActive) { activeId = ''; saveList('timetable_active', ''); }
        saveTTs(); paintClock(new Date());
        undoToast(`'${t.name}' 시정을 지웠어요`, () => {
          if (timetables.some(x => x.id === t.id)) return;
          timetables.splice(Math.min(idx, timetables.length), 0, t);
          if (wasActive) { activeId = t.id; saveList('timetable_active', activeId); }
          saveTTs(); paintClock(new Date());
        });
      }
    });

    /* 편집기 — 고치는 동안에는 draft에만 쓰고, [저장하기]에서 검사를 통과해야 저장 */
    let draft = null, draftDirty = false;
    function openEditor(t, opts) {
      opts = opts || {};
      if (!t && timetables.length >= TT_MAX) { toast(`시정은 ${TT_MAX}개까지 저장할 수 있어요. 안 쓰는 시정을 지워 주세요.`, 'error'); return; }
      draft = t ? {
        id: t.id || null, name: t.name || '', days: (t.days || [1,2,3,4,5]).slice(),
        periods: (t.periods || []).map(p => ({ label: p.label, start: p.start, end: p.end, kind: p.kind, uncertain: !!p.uncertain })),
        chime: { ...CHIME_DEFAULT, ...(t.chime || {}) },
      } : { id: null, name: '', days: [1,2,3,4,5], periods: [], chime: { ...CHIME_DEFAULT } };
      draftDirty = !!opts.ai;
      if (settings.tab !== 'timetable') setMainTab('timetable');
      $('tt-home').hidden = true;
      $('tt-editor').hidden = false;
      $('tt-editor-title').innerHTML = ic('calendar-clock') + (draft.id ? '시정 고치기' : '새 시정 만들기');
      $('tt-name').value = draft.name;
      for (let i = 0; i < 7; i++) $('ttd' + i).checked = draft.days.includes(i);
      $('tt-at-start').checked = draft.chime.atStart;
      $('tt-at-end').checked = draft.chime.atEnd;
      $('tt-before').value = String([0,1,2,3,5].includes(draft.chime.before) ? draft.chime.before : 0);
      $('tt-sound').value = soundOk(draft.chime.sound) ? draft.chime.sound : 'bell';
      const note = $('tt-ai-note');
      if (opts.ai) {
        const unc = draft.periods.filter(p => p.uncertain).length;
        note.hidden = false;
        note.innerHTML = ic('triangle-alert') + ' 사진에서 읽은 결과예요. 아직 저장되지 않았어요. 사진과 비교해 확인한 뒤 [저장하기]를 눌러 주세요.'
          + (unc ? ` <b>노란 줄 ${unc}개</b>는 AI가 확실하지 않다고 한 칸이에요.` : '')
          + (opts.notes ? `<br>메모: ${esc(opts.notes)}` : '');
      } else note.hidden = true;
      renderRows();
      $('tt-editor').scrollIntoView({ block: 'start', behavior: reduceMotion() ? 'auto' : 'smooth' });
      setTimeout(() => $('tt-name').focus({ preventScroll: true }), 50);
    }
    async function closeEditor(force) {
      if (!force && draftDirty) {
        const ok = await ask('고친 내용을 저장하지 않고 닫을까요?', { title: '시정 편집', ok: '저장 안 하고 닫기', cancel: '계속 고치기', danger: true });
        if (!ok) return;
      }
      draft = null; draftDirty = false;
      $('tt-editor').hidden = true;
      $('tt-home').hidden = false;
      renderTTList();
    }
    const kindOptions = (k) => Object.keys(KINDS).map(x => `<option value="${x}"${x === k ? ' selected' : ''}>${esc(KINDS[x])}</option>`).join('');
    function renderRows() {
      const box = $('tt-rows');
      if (!draft.periods.length) {
        box.innerHTML = `<div class="empty-state" style="padding:1rem">${ic('calendar-clock')}<p>위 [초등 기본 틀]·[중학교 기본 틀]을 누르거나 [구간 추가]로 한 줄씩 넣어 주세요.</p></div>`;
      } else {
        box.innerHTML = draft.periods.map((p, i) => {
          const n = `${i + 1}번째 구간`;
          return `<div class="tt-row${p.uncertain ? ' uncertain' : ''}" data-i="${i}">
            <input class="c-label" data-f="label" maxlength="20" value="${esc(p.label)}" placeholder="예: 1교시" aria-label="${n} 이름">
            <input class="c-start" type="time" data-f="start" value="${esc(p.start)}" aria-label="${n} 시작 시각">
            <input class="c-end" type="time" data-f="end" value="${esc(p.end)}" aria-label="${n} 끝 시각">
            <select class="c-kind" data-f="kind" aria-label="${n} 종류">${kindOptions(p.kind)}</select>
            <button type="button" class="action-btn delete c-del" data-del="${i}" aria-label="${n} 지우기">${ic('trash-2')}</button>
            <div class="row-msg" hidden></div>
          </div>`;
        }).join('');
      }
      validateView();
    }
    function validateDraft() {
      const errs = new Map(), ps = draft.periods;
      ps.forEach((p, i) => {
        const m = [];
        if (!cleanStr(p.label, 20)) m.push('이름을 적어 주세요');
        const okS = HHMM_RE.test(p.start), okE = HHMM_RE.test(p.end);
        if (!okS || !okE) m.push('시각을 넣어 주세요');
        else if (toMin(p.end) <= toMin(p.start)) m.push('끝 시각이 시작보다 늦어야 해요');
        const prev = ps[i - 1];
        if (prev && okS && HHMM_RE.test(prev.end) && toMin(p.start) < toMin(prev.end)) m.push('앞 구간과 겹치거나 순서가 바뀌었어요');
        if (m.length) errs.set(i, m.join(' · '));
      });
      return errs;
    }
    function draftChime() {
      return { atStart: $('tt-at-start').checked, atEnd: $('tt-at-end').checked, before: Number($('tt-before').value) || 0, sound: $('tt-sound').value };
    }
    function validateView() {
      const errs = validateDraft();
      document.querySelectorAll('#tt-rows .tt-row').forEach(row => {
        const i = Number(row.dataset.i), p = draft.periods[i];
        const msg = row.querySelector('.row-msg');
        const err = errs.get(i);
        row.classList.toggle('err', !!err);
        row.classList.toggle('uncertain', !!(p && p.uncertain));
        if (err) { msg.hidden = false; msg.className = 'row-msg'; msg.textContent = err; }
        else if (p && p.uncertain) { msg.hidden = false; msg.className = 'row-msg unc'; msg.textContent = 'AI가 확실하지 않다고 한 줄이에요. 사진과 비교해 주세요.'; }
        else { msg.hidden = true; msg.textContent = ''; }
        row.querySelectorAll('input, select').forEach(el => el.setAttribute('aria-invalid', err ? 'true' : 'false'));
      });
      const box = $('tt-errors');
      if (errs.size) { box.hidden = false; box.textContent = `빨간 줄 ${errs.size}개를 고쳐야 저장할 수 있어요.`; }
      else { box.hidden = true; box.textContent = ''; }
      // 종 개수 미리 보기
      const cnt = $('tt-bell-count');
      if (!errs.size && draft.periods.length) {
        const n = bellsOf({ id: 'draft', updatedAt: 0, periods: draft.periods, chime: draftChime() }, true).length;
        cnt.textContent = n ? `이 시정으로 하루에 종이 ${n}번 울려요(수업 구간 기준).` : '울릴 종이 없어요. 수업 시작·끝 종을 켜 주세요.';
      } else cnt.textContent = '';
      return errs;
    }
    $('tt-rows').addEventListener('input', e => {
      const el = e.target.closest('[data-f]');
      if (!el || !draft) return;
      const i = Number(el.closest('.tt-row').dataset.i);
      const p = draft.periods[i];
      if (!p) return;
      p[el.dataset.f] = el.value;
      p.uncertain = false;   // 직접 고친 줄은 노란 표시를 지운다
      draftDirty = true;
      validateView();
    });
    $('tt-rows').addEventListener('change', e => { if (e.target.matches('select[data-f]')) e.target.dispatchEvent(new Event('input', { bubbles: true })); });
    $('tt-rows').addEventListener('click', e => {
      const b = e.target.closest('[data-del]');
      if (!b || !draft) return;
      const i = Number(b.dataset.del);
      const removed = draft.periods.splice(i, 1)[0];
      if (!removed) return;
      draftDirty = true;
      renderRows();
      const d = draft;
      undoToast(`'${removed.label || '구간'}' 줄을 지웠어요`, () => {
        if (draft !== d) return;
        d.periods.splice(Math.min(i, d.periods.length), 0, removed);
        renderRows();
      });
      (document.querySelector(`#tt-rows [data-del="${Math.min(i, draft.periods.length - 1)}"]`) || $('tt-add-row')).focus();
    });
    ['tt-name', 'tt-at-start', 'tt-at-end', 'tt-before', 'tt-sound'].forEach(id => $(id).addEventListener('change', () => { draftDirty = true; validateView(); }));
    $('tt-name').addEventListener('input', () => { draftDirty = true; });
    for (let i = 0; i < 7; i++) $('ttd' + i).addEventListener('change', () => { draftDirty = true; });
    $('tt-add-row').addEventListener('click', () => {
      if (!draft) return;
      if (draft.periods.length >= ROWS_MAX) { toast(`구간은 ${ROWS_MAX}개까지 넣을 수 있어요.`, 'error'); return; }
      const last = draft.periods[draft.periods.length - 1];
      const start = last && HHMM_RE.test(last.end) ? toMin(last.end) : 9 * 60;
      const nClass = draft.periods.filter(p => p.kind === 'class').length;
      const end = Math.min(start + 40, 23 * 60 + 59);
      draft.periods.push({ label: `${nClass + 1}교시`, start: minToHHMM(start), end: minToHHMM(end), kind: 'class', uncertain: false });
      draftDirty = true;
      renderRows();
      const rows = document.querySelectorAll('#tt-rows .c-label');
      rows[rows.length - 1]?.focus();
    });
    document.querySelectorAll('[data-tpl]').forEach(b => b.addEventListener('click', async () => {
      if (!draft) return;
      const tpl = TEMPLATES[b.dataset.tpl];
      if (draft.periods.length) {
        const ok = await ask(`지금 표 ${draft.periods.length}줄을 '${tpl.name}' 기본 틀로 바꿀까요?`, { title: '기본 틀 불러오기', ok: '바꾸기' });
        if (!ok) return;
      }
      const prev = draft.periods;
      draft.periods = tpl.periods.map(p => ({ ...p, uncertain: false }));
      if (!$('tt-name').value.trim()) $('tt-name').value = tpl.name;
      draftDirty = true;
      renderRows();
      if (prev.length) { const d = draft; undoToast('기본 틀을 불러왔어요', () => { if (draft === d) { d.periods = prev; renderRows(); } }); }
      else toast('기본 틀을 불러왔어요. 우리 학교에 맞게 시각을 고쳐 주세요.', 'success');
    }));
    // 수업 시간 일괄 변경: 첫 시작 시각과 구간 사이 간격(쉬는 시간 길이)은 그대로, 수업 길이만 바꿔 다시 계산
    $('tt-bulk').addEventListener('click', async () => {
      if (!draft || !draft.periods.length) { toast('먼저 표를 채워 주세요.'); return; }
      if (draft.periods.some(p => !HHMM_RE.test(p.start) || !HHMM_RE.test(p.end) || toMin(p.end) <= toMin(p.start))) {
        toast('시각이 비었거나 틀린 줄을 먼저 고쳐 주세요.', 'error'); return;
      }
      const cls = draft.periods.find(p => p.kind === 'class');
      if (!cls) { toast('종류가 "수업"인 줄이 없어요.', 'error'); return; }
      const cur = toMin(cls.end) - toMin(cls.start);
      const input = window.VUI ? await VUI.prompt('수업 한 시간을 몇 분으로 바꿀까요? (예: 단축 수업 35)', { title: '수업 시간 일괄 변경', value: String(cur), ok: '바꾸기', maxLength: 3 }) : null;
      if (input == null) return;
      const n = parseInt(input, 10);
      if (!(n >= 5 && n <= 120)) { toast('5분부터 120분까지 넣을 수 있어요.', 'error'); return; }
      const orig = draft.periods.map(p => ({ ...p }));
      const out = [];
      let cursor = toMin(orig[0].start);
      for (let i = 0; i < orig.length; i++) {
        const o = orig[i];
        if (i > 0) cursor += Math.max(0, toMin(o.start) - toMin(orig[i - 1].end));
        const dur = o.kind === 'class' ? n : toMin(o.end) - toMin(o.start);
        if (cursor + dur >= 24 * 60) { toast('자정을 넘겨서 바꿀 수 없어요.', 'error'); return; }
        out.push({ ...o, start: minToHHMM(cursor), end: minToHHMM(cursor + dur) });
        cursor += dur;
      }
      draft.periods = out;
      draftDirty = true;
      renderRows();
      const d = draft;
      undoToast(`수업을 ${n}분으로 바꿨어요`, () => { if (draft === d) { d.periods = orig; renderRows(); } });
    });
    $('tt-cancel').addEventListener('click', () => closeEditor(false));
    $('tt-save').addEventListener('click', () => {
      if (!draft) return;
      const name = cleanStr($('tt-name').value, 30);
      const days = Array.from({ length: 7 }, (_, i) => $('ttd' + i).checked ? i : -1).filter(i => i >= 0);
      const errs = validateView();
      if (!name) { toast('시정 이름을 적어 주세요.', 'error'); $('tt-name').focus(); return; }
      if (!days.length) { toast('쓰는 요일을 하나 이상 골라 주세요.', 'error'); $('ttd1').focus(); return; }
      if (!draft.periods.length) { toast('구간을 하나 이상 넣어 주세요.', 'error'); $('tt-add-row').focus(); return; }
      if (errs.size) {
        toast('빨간 줄을 고친 뒤 저장할 수 있어요.', 'error');
        const i = errs.keys().next().value;
        document.querySelector(`#tt-rows .tt-row[data-i="${i}"] input`)?.focus();
        return;
      }
      const t = normalizeTT({ id: draft.id, name, days, periods: draft.periods, chime: draftChime(), updatedAt: Date.now() }, true);
      if (!t) { toast('저장하지 못했어요. 표를 다시 확인해 주세요.', 'error'); return; }
      const idx = draft.id ? timetables.findIndex(x => x.id === draft.id) : -1;
      const isNew = idx < 0;
      if (isNew) timetables.push(t); else timetables[idx] = t;
      saveTTs();
      closeEditor(true);
      paintClock(new Date());
      if (isNew && t.id !== activeId && window.VUI) {
        VUI.toast(`'${t.name}' 시정을 저장했어요`, { type: 'success', action: { label: '사용하기', onClick: () => { setActive(t.id); toast(`이제 '${t.name}' 시정대로 종이 울려요`, 'success'); } } });
      } else toast(`'${t.name}' 시정을 저장했어요`, 'success');
    });
    $('tt-new').addEventListener('click', () => openEditor(null));

    /* 시정 공유 링크(#share=) — 같은 학교 선생님이 그대로 가져가기 */
    function shareTT(t) {
      if (!window.VUI) return;
      const payload = { v: 1, t: { name: t.name, days: t.days, periods: t.periods.map(p => ({ label: p.label, start: p.start, end: p.end, kind: p.kind })), chime: t.chime } };
      const url = location.origin + location.pathname + '#share=' + VUI.share.encode(payload);
      VUI.share.link(url, { show: true, title: '시정 공유 링크', desc: `'${t.name}' 시정을 받은 선생님은 링크를 열고 [추가]를 누르면 자기 목록에 넣을 수 있어요.` });
    }
    async function handleShareHash() {
      const m = location.hash.match(/^#share=([A-Za-z0-9_\-%.=]+)$/);
      if (!m || !window.VUI) return;
      const clear = () => { try { history.replaceState(null, '', location.pathname + location.search); } catch (e) {} };
      const v = VUI.share.decode(m[1], x => isObj(x) && x.v === 1 && isObj(x.t));
      const t = v ? normalizeTT({ ...v.t, id: null }, false) : null;
      clear();
      if (!t) { toast('공유 링크의 시정을 읽을 수 없어요. 링크가 잘렸는지 확인해 주세요.', 'error'); return; }
      if (timetables.length >= TT_MAX) { toast(`시정은 ${TT_MAX}개까지 저장할 수 있어요. 안 쓰는 시정을 지운 뒤 다시 열어 주세요.`, 'error'); return; }
      const nClass = t.periods.filter(p => p.kind === 'class').length;
      const ok = await ask(`이 시정을 내 시정 목록에 추가할까요?\n'${t.name}' · ${daysText(t.days)} · 수업 ${nClass}개 · ${t.periods[0].start}~${t.periods[t.periods.length - 1].end}`,
        { title: '공유받은 시정', ok: '추가', cancel: '안 함' });
      if (!ok) return;
      timetables.push(t);
      saveTTs();
      setMainTab('timetable');
      VUI.toast(`'${t.name}' 시정을 추가했어요`, { type: 'success', action: { label: '사용하기', onClick: () => setActive(t.id) } });
    }

    /* ═════════════ 12. 사진으로 시정 만들기(F4) ═════════════ */
    let aiCtrl = null;
    function aiUi(state, err) {
      $('ai-start').hidden = state === 'busy';
      $('ai-progress').hidden = state !== 'busy';
      const e = $('ai-error');
      e.hidden = !err; e.textContent = err || '';
    }
    function abortAi() { if (aiCtrl) { const c = aiCtrl; aiCtrl = null; try { c.abort(); } catch (e) {} } }
    $('tt-ai').addEventListener('click', () => { aiUi('start'); openModal('aiModal'); });
    $('ai-camera').addEventListener('click', () => $('ai-file-camera').click());
    $('ai-gallery').addEventListener('click', () => $('ai-file-pick').click());
    $('ai-manual').addEventListener('click', () => { closeModal('aiModal'); openEditor(null); });
    $('ai-cancel').addEventListener('click', () => { abortAi(); aiUi('start'); });
    ['ai-file-camera', 'ai-file-pick'].forEach(id => $(id).addEventListener('change', e => {
      const f = e.target.files && e.target.files[0];
      e.target.value = '';
      if (f) handleAiFile(f);
    }));
    document.addEventListener('paste', e => {
      if (!modals.aiModal || !modals.aiModal.isOpen() || aiCtrl) return;
      const items = (e.clipboardData && e.clipboardData.items) || [];
      for (const it of items) {
        if (it.kind === 'file' && /^image\//.test(it.type)) { e.preventDefault(); handleAiFile(it.getAsFile()); return; }
      }
      aiUi('start', '붙여 넣은 내용에 이미지가 없어요. 시정표를 캡처해서 복사한 뒤 다시 붙여 넣어 주세요.');
    });
    // 긴 변 1280px·JPEG 0.75로 줄임(사진 방향 정보 반영)
    async function downscale(file) {
      let src = null, cleanup = null;
      if (window.createImageBitmap) {
        try { src = await createImageBitmap(file, { imageOrientation: 'from-image' }); }
        catch (e) { try { src = await createImageBitmap(file); } catch (e2) { src = null; } }
      }
      if (!src) {
        const url = URL.createObjectURL(file);
        cleanup = () => URL.revokeObjectURL(url);
        const img = new Image();
        img.src = url;
        await (img.decode ? img.decode() : new Promise((res, rej) => { img.onload = res; img.onerror = rej; }));
        src = img;
      }
      const w = src.naturalWidth || src.width, h = src.naturalHeight || src.height;
      if (!w || !h) throw new Error('size');
      const scale = Math.min(1, 1280 / Math.max(w, h));
      const cw = Math.max(1, Math.round(w * scale)), ch = Math.max(1, Math.round(h * scale));
      const c = document.createElement('canvas');
      c.width = cw; c.height = ch;
      const g = c.getContext('2d');
      g.fillStyle = '#fff'; g.fillRect(0, 0, cw, ch);   // 투명 PNG도 흰 바탕으로
      g.drawImage(src, 0, 0, cw, ch);
      if (src.close) try { src.close(); } catch (e) {}
      if (cleanup) cleanup();
      return c.toDataURL('image/jpeg', 0.75);
    }
    async function handleAiFile(file) {
      if (!file || !/^image\//.test(file.type || '')) { aiUi('start', '이미지 파일만 넣을 수 있어요(JPG·PNG 등).'); return; }
      if (!window.VUI) return;
      let dataUrl;
      try { dataUrl = await downscale(file); }
      catch (e) { aiUi('start', '사진을 열 수 없어요. 다른 사진으로 해 주세요(HEIC 사진은 JPG로 바꿔 주세요).'); return; }
      const pv = $('ai-preview');
      pv.src = dataUrl; pv.hidden = false;
      aiUi('busy');
      const ctrl = new AbortController();
      aiCtrl = ctrl;
      try {
        const res = await VUI.apiFetch('/api/timer-vision', { json: { image: dataUrl }, timeout: 60000, signal: ctrl.signal });
        if (aiCtrl !== ctrl) return;   // 취소됨
        aiCtrl = null;
        const periods = (res && Array.isArray(res.periods) ? res.periods : []).slice(0, ROWS_MAX).map(p => ({
          label: cleanStr(p && p.label, 20) || '구간',
          start: p && HHMM_RE.test(p.start) ? p.start : '',
          end: p && HHMM_RE.test(p.end) ? p.end : '',
          kind: p && Object.prototype.hasOwnProperty.call(KINDS, p.kind) ? p.kind : 'etc',
          uncertain: !!(p && p.uncertain),
        }));
        if (!periods.length) { aiUi('start', '표를 찾지 못했어요. 더 밝게, 표만 보이게 다시 찍어 주세요. 또는 [직접 입력하기]로 이어 가세요.'); return; }
        pv.hidden = true; pv.removeAttribute('src');
        closeModal('aiModal');
        openEditor({ id: null, name: cleanStr(res.name, 30) || '우리 학교 시정', days: [1,2,3,4,5], periods, chime: CHIME_DEFAULT }, { ai: true, notes: cleanStr(res.notes, 200) });
      } catch (err) {
        if (aiCtrl !== ctrl && err && err.code === 'abort') return;
        aiCtrl = null;
        pv.hidden = true;
        if (err && err.code === 'abort') { aiUi('start'); return; }
        aiUi('start', (err && err.message ? err.message : '사진을 읽지 못했어요.') + ' 다시 해 보거나 [직접 입력하기]로 이어 가세요.');
      }
    }
  </script>

  <script is:inline="">
    /* ═════════════ 13. 쉬는 시간 음악(F5) — 규칙으로만 추천(AI 안 씀) ═════════════ */
    const MY_MUSIC_MAX = 30;
    const YT_ID = /^[A-Za-z0-9_-]{11}$/;
    function parseYouTubeId(s) {
      s = String(s || '').trim();
      if (YT_ID.test(s)) return s;
      let u;
      try { u = new URL(/^https?:\/\//i.test(s) ? s : 'https://' + s); } catch (e) { return null; }
      const host = u.hostname.toLowerCase().replace(/^(www|m|music)\./, '');
      if (host === 'youtu.be') { const id = u.pathname.split('/')[1] || ''; return YT_ID.test(id) ? id : null; }
      if (host === 'youtube.com' || host === 'youtube-nocookie.com') {
        const v = u.searchParams.get('v');
        if (v && YT_ID.test(v)) return v;
        const m = u.pathname.match(/^\/(?:shorts|embed|live|v)\/([A-Za-z0-9_-]{11})(?:[/?#]|$)/);
        if (m) return m[1];
      }
      return null;
    }
    function normalizeMusic(m) {
      if (!isObj(m) || !YT_ID.test(m.id)) return null;
      const o = { id: m.id };
      const t = cleanStr(m.title, 80);
      if (t) o.title = t;
      const sec = Math.round(Number(m.sec));
      if (sec > 0 && sec < 36000) o.sec = sec;
      return o;
    }
    let myMusic = loadList('timer_music_custom').map(normalizeMusic).filter(Boolean).slice(0, MY_MUSIC_MAX);
    let tracks = [], tracksState = 'idle', musicInited = false;
    function normTrack(t) {
      if (!isObj(t) || !YT_ID.test(t.id)) return null;
      const title = cleanStr(t.title, 80);
      const sec = Math.round(Number(t.sec));
      if (!title || !(sec > 0)) return null;
      const mood = Array.isArray(t.mood) ? t.mood.filter(m => Object.prototype.hasOwnProperty.call(MOODS, m)) : [];
      return { id: t.id, title, artist: cleanStr(t.artist, 60), mood, sec, grade: ['all', 'low', 'high'].includes(t.grade) ? t.grade : 'all', pick: t.pick === true };
    }
    async function loadTracks() {
      tracksState = 'loading'; renderMusic();
      try {
        const r = await fetch('/apps/timer/music.json', { cache: 'no-cache' });
        if (!r.ok) throw new Error(String(r.status));
        const j = await r.json();
        const seen = new Set();
        tracks = (isObj(j) && Array.isArray(j.tracks) ? j.tracks : []).map(normTrack).filter(t => t && !seen.has(t.id) && seen.add(t.id));
        tracksState = tracks.length ? 'ok' : 'empty';
      } catch (e) { tracks = []; tracksState = 'empty'; }
      renderMusic();
    }
    function initMusic() {
      if (musicInited) { renderMusic(); return; }
      musicInited = true;
      loadTracks();
      loadYtApi();
    }
    const kindMood = k => ({ break: 'break', lunch: 'lunch', morning: 'morning', class: 'focus' }[k] || 'calm');
    // 지금/다음 쉬는 시간 길이(초)와 그에 맞는 분위기
    function musicWindow(now) {
      const info = dayInfo(now);
      if (!info.tt || info.off) return null;
      const { sec, cur } = info;
      if (cur && cur.kind !== 'class') {
        const nc = info.tt.periods.find(p => p.kind === 'class' && toMin(p.start) * 60 > sec);
        const until = nc ? toMin(nc.start) * 60 - sec : toMin(cur.end) * 60 - sec;
        return { sec: until, mood: kindMood(cur.kind), text: `${cur.label} ${fmtLeft(until)} 남음 · 그 안에 끝나는 곡` };
      }
      const nb = info.tt.periods.find(p => p.kind !== 'class' && toMin(p.start) * 60 >= sec);
      if (nb) {
        const len = (toMin(nb.end) - toMin(nb.start)) * 60;
        return { sec: len, mood: kindMood(nb.kind), text: `다음 ${nb.label}(${fmtDur(len)})에 맞는 곡` };
      }
      return null;
    }
    function recommend(now) {
      const win = musicWindow(now);
      const mood = settings.musicMood || (win ? win.mood : 'break');
      const g = settings.musicGrade;
      let pool = tracks.filter(t => t.mood.includes(mood) && (g === 'all' || t.grade === 'all' || t.grade === g));
      let fits = pool;
      if (win) fits = pool.filter(t => t.sec <= win.sec - 15);   // 종 전에 끝나도록 15초 여유
      // 운영자 추천(pick) 곡 먼저, 같은 조건이면 남은 시간을 가장 잘 채우는 곡부터
      fits = fits.slice().sort((a, b) => (b.pick - a.pick) || (b.sec - a.sec)).slice(0, 8);
      return { win, mood, list: fits, poolCount: pool.length };
    }
    function musicRow(m, kind, i) {
      const playing = mp.id === m.id;
      const title = m.title || '내 음악 ' + (i + 1);
      const sub = [m.artist, m.sec ? fmtClock(m.sec) : ''].filter(Boolean).join(' · ') || 'youtu.be/' + m.id;
      return `<div class="music-item${playing ? ' playing' : ''}">
        <div class="mi-text"><div class="mi-title">${m.pick ? `<span class="pick-badge">${ic('thumbs-up')}추천</span>` : ''}${esc(title)}</div><div class="mi-sub">${esc(sub)}</div></div>
        <button type="button" class="hero-btn ${playing ? '' : 'hero-btn-ghost '}hero-btn-sm" data-play="${esc(m.id)}" data-kind="${kind}" aria-label="${esc(title)} ${playing ? '멈추기' : '재생'}">${ic(playing ? 'square' : 'circle-play')}${playing ? '멈춤' : '재생'}</button>
        ${kind === 'my' ? `<button type="button" class="action-btn delete" data-mydel="${esc(m.id)}" aria-label="${esc(title)} 지우기">${ic('trash-2')}</button>` : ''}
      </div>`;
    }
    let musicLastKey = '', myMusicLastHtml = '';
    function renderMusic(force) {
      if (!musicInited) return;
      const now = new Date();
      const r = recommend(now);
      $('music-grade').value = settings.musicGrade;
      // 분위기 칩
      const chips = [['', '자동' + (r.win && !settings.musicMood ? `(${MOODS[r.win.mood]})` : '')]].concat(Object.keys(MOODS).map(k => [k, MOODS[k]]));
      const chipHtml = chips.map(([k, l]) => `<button type="button" class="chip" data-mood="${k}" aria-pressed="${settings.musicMood === k}">${esc(l)}</button>`).join('');
      if ($('mood-chips').innerHTML !== chipHtml) $('mood-chips').innerHTML = chipHtml;
      $('rec-title').textContent = r.win ? r.win.text : '추천 곡 · 시정을 쓰면 쉬는 시간 길이에 맞춰 골라 줘요';
      let recHtml;
      if (tracksState === 'loading' || tracksState === 'idle') recHtml = '<p class="note">곡 목록을 불러오는 중이에요…</p>';
      else if (tracksState === 'empty') recHtml = `<div class="empty-state" style="padding:1rem">${ic('list-music')}<p>추천 곡 목록을 준비하고 있어요.<br>아래 '내 음악'에 유튜브 주소를 넣어 바로 쓸 수 있어요.</p></div>`;
      else if (!r.list.length) recHtml = `<p class="note">${r.poolCount ? '남은 시간 안에 끝나는 곡이 없어요. 다른 분위기를 골라 보세요.' : '이 분위기·학년에 맞는 곡이 없어요. 다른 분위기를 골라 보세요.'}</p>`;
      else recHtml = r.list.map((t, i) => musicRow(t, 'rec', i)).join('');
      const key = recHtml + '|' + mp.id;
      if (force || key !== musicLastKey) { musicLastKey = key; $('rec-list').innerHTML = recHtml; }
      $('my-music-count').textContent = myMusic.length ? `(${myMusic.length}/${MY_MUSIC_MAX})` : '';
      const myHtml = myMusic.length ? myMusic.map((m, i) => musicRow(m, 'my', i)).join('')
        : '<p class="note">자주 트는 노래가 있으면 유튜브 주소를 넣어 두세요(youtu.be·shorts 주소도 돼요).</p>';
      if (force || myMusicLastHtml !== myHtml) { myMusicLastHtml = myHtml; $('my-music').innerHTML = myHtml; }
      $('music-add').disabled = myMusic.length >= MY_MUSIC_MAX;
      $('music-autostop').checked = settings.musicAutoStop;
    }
    $('mood-chips').addEventListener('click', e => {
      const b = e.target.closest('[data-mood]');
      if (!b) return;
      settings.musicMood = b.dataset.mood;
      saveSettings();
      renderMusic(true);
    });
    $('panel-music').addEventListener('click', e => {
      const p = e.target.closest('[data-play]');
      if (p) {
        const id = p.dataset.play;
        if (mp.id === id) { stopMusic(); return; }
        const m = (p.dataset.kind === 'my' ? myMusic : tracks).find(x => x.id === id);
        if (m) playMusic(m.id, m.title || '내 음악');
        return;
      }
      const d = e.target.closest('[data-mydel]');
      if (d) {
        const idx = myMusic.findIndex(x => x.id === d.dataset.mydel);
        if (idx < 0) return;
        const m = myMusic.splice(idx, 1)[0];
        saveList('timer_music_custom', myMusic);
        renderMusic(true);
        undoToast(`${josa(`'${m.title || '내 음악'}'`, '을/를')} 목록에서 지웠어요`, () => {
          if (myMusic.some(x => x.id === m.id) || myMusic.length >= MY_MUSIC_MAX) return;
          myMusic.splice(Math.min(idx, myMusic.length), 0, m);
          saveList('timer_music_custom', myMusic);
          renderMusic(true);
        });
        $('music-url').focus();
      }
    });
    async function addMyMusic() {
      const input = $('music-url');
      const id = parseYouTubeId(input.value);
      if (!id) { toast('유튜브 영상 주소를 넣어 주세요(예: https://youtu.be/…).', 'error'); input.focus(); return; }
      if (myMusic.some(m => m.id === id)) { toast('이미 목록에 있는 곡이에요.'); return; }
      if (myMusic.length >= MY_MUSIC_MAX) { toast(`내 음악은 ${MY_MUSIC_MAX}곡까지예요.`, 'error'); return; }
      const item = { id };
      myMusic.push(item);
      input.value = '';
      saveList('timer_music_custom', myMusic);
      renderMusic(true);
      toast('내 음악에 넣었어요', 'success');
      // 제목·길이는 되는 대로 채운다(실패해도 그대로 쓸 수 있음)
      if (!window.VUI) return;
      const [info, dur] = await Promise.all([
        VUI.apiFetch('/api/yt-video-info', { json: { videoId: id }, timeout: 8000 }).catch(() => null),
        VUI.apiFetch('/api/yt-duration?ids=' + id, { timeout: 8000 }).catch(() => null),
      ]);
      const cur = myMusic.find(m => m.id === id);
      if (!cur) return;
      const t = info && cleanStr(info.title, 80);
      if (t && t !== 'Unknown Title') cur.title = t;
      const s = dur && dur.durations && Math.round(Number(dur.durations[id]));
      if (s > 0 && s < 36000) cur.sec = s;
      saveList('timer_music_custom', myMusic);
      renderMusic(true);
    }
    $('music-add').addEventListener('click', addMyMusic);
    $('music-url').addEventListener('keydown', e => { if (e.key === 'Enter' && !e.isComposing) { e.preventDefault(); addMyMusic(); } });

    /* 플레이어 — youtube-nocookie 임베드. IFrame API는 음악 탭을 처음 열 때만 불러온다.
       API가 없으면 볼륨 줄이기는 못 하고, 수업 시작 때 iframe을 지워서 멈춘다. */
    let ytApiState = 'idle', ytApiTimer = null;
    let mp = { id: null };
    function showYtBlocked() { $('yt-blocked').hidden = false; }
    function loadYtApi() {
      if (ytApiState !== 'idle') return;
      if (window.YT && window.YT.Player) { ytApiState = 'ready'; return; }
      ytApiState = 'loading';
      const prev = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = function () {
        ytApiState = 'ready';
        clearTimeout(ytApiTimer);
        $('yt-blocked').hidden = true;
        if (typeof prev === 'function') { try { prev(); } catch (e) {} }
        attachPlayer();
      };
      const s = document.createElement('script');
      s.src = 'https://www.youtube.com/iframe_api';
      s.async = true;
      s.onerror = () => { ytApiState = 'failed'; clearTimeout(ytApiTimer); showYtBlocked(); };
      document.head.appendChild(s);
      ytApiTimer = setTimeout(() => { if (ytApiState === 'loading') { ytApiState = 'failed'; showYtBlocked(); } }, 15000);
    }
    function setMpMsg(t) { const el = $('mp-msg'); el.hidden = !t; el.textContent = t || ''; }
    function playMusic(id, title) {
      if (!YT_ID.test(id)) return;
      unlockAudio();
      stopMusic(true);
      const ifr = document.createElement('iframe');
      ifr.id = 'yt-iframe';
      ifr.title = `유튜브 플레이어: ${title}`;
      ifr.allow = 'autoplay; encrypted-media; picture-in-picture';
      ifr.referrerPolicy = 'strict-origin-when-cross-origin';
      ifr.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&enablejsapi=1&playsinline=1&origin=${encodeURIComponent(location.origin)}`;
      $('mp-frame').appendChild(ifr);
      mp = { id, title, player: null, ready: false, ducked: false, vol: 100, stopAt: null, stopLabel: '' };
      if (settings.musicAutoStop) {
        const nc = nextClassStartMs(new Date());
        if (nc && nc.at - Date.now() < 4 * 3600 * 1000) { mp.stopAt = nc.at; mp.stopLabel = nc.label; }
      }
      const pl = $('music-player');
      pl.hidden = false;
      pl.classList.remove('collapsed');
      $('mp-toggle').setAttribute('aria-expanded', 'true');
      $('mp-toggle').setAttribute('aria-label', '플레이어 접기');
      $('mp-toggle').innerHTML = ic('chevron-down');
      document.body.classList.add('player-open');
      $('mp-title').textContent = title;
      setMpMsg(mp.stopAt ? `${mp.stopLabel} 시작(${new Date(mp.stopAt).toTimeString().slice(0, 5)})에 저절로 멈춰요.` : '');
      if (ytApiState === 'idle') loadYtApi();
      attachPlayer();
      const myId = id;
      mp.readyTimer = setTimeout(() => {
        if (mp.id === myId && !mp.ready) setMpMsg('영상이 뜨지 않으면 학교망에서 유튜브가 막혀 있을 수 있어요.');
      }, 12000);
      renderMusic(true);
    }
    function attachPlayer() {
      if (ytApiState !== 'ready' || !mp.id || mp.player || !(window.YT && YT.Player)) return;
      const ifr = $('yt-iframe');
      if (!ifr) return;
      const myId = mp.id;
      try {
        mp.player = new YT.Player(ifr, { events: {
          onReady: () => { if (mp.id === myId) mp.ready = true; },
          onStateChange: (e) => { if (mp.id === myId && e && e.data === 1) mp.ready = true; },
          onError: () => { if (mp.id === myId) setMpMsg('이 영상은 여기서 재생할 수 없어요(퍼가기 금지·삭제된 영상일 수 있어요).'); },
        } });
      } catch (e) { mp.player = null; }
    }
    function stopMusic(quiet) {
      if (mp.player) { try { mp.player.stopVideo(); } catch (e) {} try { mp.player.destroy(); } catch (e) {} }
      clearTimeout(mp.readyTimer);
      $('mp-frame').innerHTML = '';
      mp = { id: null };
      if (!quiet) {
        $('music-player').hidden = true;
        document.body.classList.remove('player-open');
        setMpMsg('');
        renderMusic(true);
      }
    }
    // 다음 수업 30초 전부터 소리를 줄이고, 수업 시작에 멈춤(설정)
    function musicTick(now) {
      if (!mp.id || !mp.stopAt || !settings.musicAutoStop) return;
      const left = mp.stopAt - now;
      if (left <= 0) { stopMusic(); toast('수업이 시작돼서 음악을 멈췄어요'); return; }
      if (left <= 30000) {
        if (!mp.ducked) { mp.ducked = true; setMpMsg(`곧 ${josa(mp.stopLabel, '이/가')} 시작돼서 소리를 줄이고 있어요.`); }
        const vol = Math.max(10, Math.round(10 + 90 * (left / 30000)));
        if (mp.player && mp.ready && vol !== mp.vol) { mp.vol = vol; try { mp.player.setVolume(vol); } catch (e) {} }
      }
    }
    $('mp-close').addEventListener('click', () => stopMusic());
    $('mp-toggle').addEventListener('click', () => {
      const pl = $('music-player');
      const col = pl.classList.toggle('collapsed');
      $('mp-toggle').setAttribute('aria-expanded', String(!col));
      $('mp-toggle').setAttribute('aria-label', col ? '플레이어 펼치기' : '플레이어 접기');
      $('mp-toggle').innerHTML = ic(col ? 'chevron-up' : 'chevron-down');
    });
  </script>

  <script is:inline="">
    /* ═════════════ 14. 시작 + 틱 + 동기화 ═════════════ */
    // 다른 기기에서 동기화로 바뀌었거나 파일을 불러온 뒤 화면 전체를 다시 그림
    function refreshAll() {
      bellCache.clear(); invalidateNext(); lastStatus = null;
      renderAlarms(); renderPresets(); renderTTList();
      if (draft && draft.id && !timetables.some(t => t.id === draft.id)) closeEditor(true);
      syncSettingsForm();
      renderCd(Date.now(), true);
      renderMusic(true);
      setMainTab(settings.tab);
      paintClock(new Date());
      syncWake();
    }

    // Web Worker 틱(백그라운드 탭에서도 느려지지 않게). 0.25초마다 — 카운트다운 숫자가 늦게 바뀌지 않도록
    let lastSec = -1, lastMusicMin = -1;
    function onTick() {
      const nowMs = Date.now(), now = new Date(nowMs);
      const s = Math.floor(nowMs / 1000);
      if (s !== lastSec) {
        lastSec = s;
        paintClock(now);
        checkAlarms(now);
        if (s % 5 === 0) syncWake();
        const mm = Math.floor(s / 30);
        if (settings.tab === 'music' && mm !== lastMusicMin) { lastMusicMin = mm; renderMusic(); }
      }
      if (cd) renderCd(nowMs);
      if (blank) renderBlank(nowMs);
      musicTick(nowMs);
    }
    // 하단 바 실제 높이를 --bar-h로(글자 크기·줄바꿈이 달라도 본문 끝이 가리지 않게)
    (function () {
      const bar = document.querySelector('.control-bar');
      // 넓은 화면에서는 바가 오른쪽 세로 막대라 아래 여백이 필요 없다(CSS의 min-width:900px와 같은 기준)
      const rail = window.matchMedia('(min-width: 900px)');
      const set = () => document.body.style.setProperty('--bar-h', rail.matches ? '0px' : Math.ceil(bar.getBoundingClientRect().height) + 'px');
      set();
      if (window.ResizeObserver) new ResizeObserver(set).observe(bar); else window.addEventListener('resize', set);
      if (rail.addEventListener) rail.addEventListener('change', set);
    })();
    try {
      const worker = new Worker(URL.createObjectURL(new Blob([
        'setInterval(()=>postMessage("tick"),250);'
      ], { type: 'application/javascript' })));
      worker.onmessage = onTick;
    } catch (e) {
      setInterval(onTick, 250);   // Worker를 못 쓰는 환경
    }

    renderPresets();
    renderTTList();
    syncSettingsForm();
    setMainTab(settings.tab);
    renderAlarms();
    paintClock(new Date());   // 첫 1초 동안 빈 시계가 보이지 않게
    renderCd(Date.now(), true);
    updateTabFade();
    updateFullButtons();
    if (blank) showBlank();   // 새로고침 전 가림 화면이 남아 있으면 남은 시간 동안 다시 가린다
    syncWake();
    handleShareHash();

    // 선택 동기화: 헤더 '동기화' 버튼 (코드 하나로 기기 간 이어쓰기)
    // 카운트다운(timer_countdown)·가림 화면(timer_blank)은 기기별이라 동기화하지 않는다.
    if (window.VivesSync) VivesSync.mountDocSync({
      apiUrl: '/api/timer',
      keys: ['alarms', 'alarm_logs', 'timetables', 'timetable_active', 'timer_presets', 'timer_music_custom', 'timer_settings'],
      appName: '타이머',
      onApplied: function () {
        alarms = loadList('alarms');
        logs = loadList('alarm_logs');
        timetables = loadTimetables();
        activeId = sget('timetable_active', '', v => typeof v === 'string');
        presets = loadPresets();
        myMusic = loadList('timer_music_custom').map(normalizeMusic).filter(Boolean).slice(0, MY_MUSIC_MAX);
        const tab = settings.tab;
        settings = loadSettings();
        settings.tab = tab;   // 지금 보고 있는 탭은 그대로
        refreshAll();
      },
    });
  </script>








</AppLayout>
