      wood: { period: 1800, play(ctx, d, t) {
        [0, 0.22, 0.44].forEach((o, i) => {
          const f = i === 2 ? 1100 : 900;
          voice(ctx, d, f, t + o, 0.09, { peak: 0.3, attack: 0.002 });
