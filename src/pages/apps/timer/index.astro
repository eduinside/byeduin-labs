    /* 소리 — Web Audio로 만든 5가지(파일 없음) */
    const SOUNDS = { chime: '차임', bell: '학교 종', beep: '부드러운 삐', marimba: '마림바', wood: '나무 딱딱이' };
    function voice(ctx, dest, f, t, d, o) {
