    .set-group { border-top: 1px solid var(--border); padding-top: 0.875rem; margin-top: 0.875rem; display: flex; flex-direction: column; gap: 6px; }
    .set-group:first-of-type { border-top: none; margin-top: 0; padding-top: 0; }
