    #blank[hidden] { display: none; }
    #blank.lifting { opacity: 0; pointer-events: none; }
    #blank-time { position: absolute; font-variant-numeric: tabular-nums; font-weight: 700; pointer-events: none; }
    #blank.show-small #blank-time { right: 18px; bottom: 14px; font-size: 1rem; color: #3a3a3a; }
