---
import AppLayout from '../../../layouts/AppLayout.astro';
import Icon from '../../../components/Icon.astro';
---
<AppLayout
  title="도형의 이동 — eduin VIVES"
  description="모눈 위 도형을 직접 밀고 뒤집고 돌려 보세요. 초등 수학 4학년 평면도형의 이동을 애니메이션으로 체험하는 무료 학습 시뮬레이션."
  image="https://eduin.info/og-images/shape-move.png"
  bodyShell="immersive"
  theme="light"
  toast="top"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/common/sim-kit.css">
    <script is:inline src="/common/sim-kit.js"></script>
    <style is:global="">
/* ══════════════════════════════════════════════
   shape-move — 도형의 이동 시뮬레이터
   immersive 셸: 앱이 뷰포트 소유 · 밝은 화면 고정
   ══════════════════════════════════════════════ */
:root {
  --sm-grid: #c5cae9;
  --sm-grid-bg: #f5f7ff;
  --sm-shape: #5c6bc0;
  --sm-shape-stroke: #3949ab;
  --sm-ghost: rgba(92, 107, 192, 0.25);
  --sm-ghost-stroke: rgba(57, 73, 171, 0.55);
  --sm-guide: #ff6d00;
  --sm-accent: #00c853;
  --sm-panel: #ffffff;
  --sm-panel-border: #e0e0e0;
  --sm-sidebar-w: 320px;
  --sm-text: #263238;
  --sm-text-muted: #607d8b;
  --sm-btn-bg: #eceff1;
  --sm-btn-hover: #cfd8dc;
  --sm-btn-active: #b0bec5;
  --sm-radius: 18px;
  --sm-danger: #d32f2f;
  --sm-star: #f9a825;
  --sm-ok-fg: #2e7d32;
  --sm-warn-fg: #b33d00;
  --sk-accent: var(--sm-shape-stroke);
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
  background: var(--sm-grid-bg);
  color: var(--sm-text);
  min-height: 100vh;
  overflow: hidden;
  -webkit-tap-highlight-color: transparent;
}

/* ── 화면 전환 ── */
.screen { display: none; }
.screen.active { display: flex; }
.screen [tabindex="-1"]:focus { outline: none; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(18px); }
  to   { opacity: 1; transform: none; }
}
@keyframes popIn {
  from { opacity: 0; transform: scale(0.88); }
  to   { opacity: 1; transform: scale(1); }
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-8px); }
}

/* ══════════ 인트로 (.sk-screen) ══════════ */
.intro-screen {
  text-align: center;
  background:
    radial-gradient(circle at 20% 30%, rgba(92,107,192,0.08) 0, transparent 40%),
    radial-gradient(circle at 80% 70%, rgba(0,200,83,0.06) 0, transparent 35%),
    var(--sm-grid-bg);
}

.intro-art {
  font-size: 80px; line-height: 1; color: var(--sm-shape);
  margin-bottom: 12px;
  animation: float 2.4s ease-in-out infinite;
}

.intro-screen h1 {
  font-size: 32px; font-weight: 800;
  margin-bottom: 6px;
  letter-spacing: -0.02em;
}
.intro-sub {
  font-size: 15px; color: var(--sm-text-muted);
  line-height: 1.7; margin-bottom: 20px;
}
.intro-tag {
  display: inline-block; background: var(--sm-shape-stroke);
  color: #fff; font-size: 14px; font-weight: 700;
  padding: 5px 14px; border-radius: 99px;
  margin-bottom: 18px; letter-spacing: 0.05em;
}
.intro-card {
  background: var(--sm-panel);
  border: 2px dashed var(--sm-shape);
  border-radius: var(--sm-radius);
  padding: 20px 24px;
  max-width: 440px; width: 100%;
  margin-bottom: 24px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.06);
}
.intro-card h3 {
  font-size: 17px; font-weight: 700;
  color: var(--sm-shape-stroke);
  margin-bottom: 10px;
}
.intro-card p {
  font-size: 15px; line-height: 1.7;
  color: var(--sm-text-muted);
}

/* 인트로 미리보기 아이콘 */
.intro-previews {
  display: flex; gap: 28px; justify-content: center;
  margin-bottom: 24px;
}
.intro-preview {
  text-align: center; font-size: 14px; font-weight: 600;
  color: var(--sm-text-muted);
}
.intro-preview .icon {
  width: 60px; height: 60px;
  background: var(--sm-btn-bg); color: var(--sm-shape-stroke);
  border-radius: 16px;
  display: flex; align-items: center; justify-content: center;
  font-size: 28px; margin-bottom: 6px;
}
.big-btn { min-height: 52px; padding: 0 32px; font-size: 17px; }

/* ══════════ 탐험 레이아웃 ══════════ */
.explore-screen {
  width: 100vw; height: 100vh; height: 100dvh;
}

.explore-layout {
  display: grid;
  grid-template-columns: 1fr var(--sm-sidebar-w);
  width: 100%; height: 100%;
}

/* 캔버스 영역: 위 이름표 줄(공용 버튼 줄 + 미션 표시) 자리를 비우고 그 아래에 모눈을 그린다 */
.canvas-zone {
  position: relative;
  display: flex; align-items: center; justify-content: center;
  padding: calc(var(--sk-stage-top) + 44px) 12px 12px;
  background-color: var(--sm-grid-bg);
  background-image:
    radial-gradient(var(--sm-grid) 1.5px, transparent 1.5px),
    radial-gradient(var(--sm-grid) 1.5px, transparent 1.5px);
  background-size: 24px 24px;
  background-position: 0 0, 12px 12px;
  min-width: 0;
  overflow: hidden;
}
.canvas-zone svg.grid-svg {
  width: 100%; height: 100%; max-width: 860px; max-height: 860px;
}

/* 미션 인디케이터(모눈 위가 아니라 비워 둔 윗줄에) */
.mission-indicator {
  position: absolute;
  top: calc(var(--sk-stage-top) - 4px); left: 12px; z-index: 5;
  background: rgba(38,50,56,0.85);
  backdrop-filter: blur(6px);
  color: #fff; border-radius: 14px;
  padding: 6px 14px; min-height: 36px;
  font-size: 14px; font-weight: 600;
  display: flex; align-items: center; gap: 8px;
  border: 1px solid rgba(255,255,255,0.2);
}
.mission-indicator .num {
  background: var(--sm-shape);
  min-width: 26px; height: 26px; border-radius: 50%;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 14px; font-weight: 700;
}
.mission-indicator .stars { color: #ffd54f; font-size: 14px; }

/* 조작판(사이드바) */
.sidebar {
  background: var(--sm-panel);
  border-left: 2px solid var(--sm-panel-border);
  overflow-y: auto;
  display: flex; flex-direction: column;
  box-shadow: -4px 0 24px rgba(0,0,0,0.06);
}

.side-head {
  background: linear-gradient(135deg, var(--sm-shape) 0%, #3949ab 100%);
  color: #fff; padding: 16px 20px 14px;
  position: relative; overflow: hidden; flex-shrink: 0;
}
.side-head::after {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(circle at 80% -20%, rgba(255,255,255,0.15) 0, transparent 55%);
}
.side-head h2 { font-size: 20px; font-weight: 700; position: relative; z-index: 1; display: flex; align-items: center; gap: 8px; }
.side-head .side-sub { font-size: 14px; opacity: 0.9; position: relative; z-index: 1; margin-top: 2px; }

.side-body { padding: 14px 16px 20px; flex: 1; }

/* 도형 선택 — 2칸 격자(글자 14px, 누르는 칸 44px 이상) */
.shape-select {
  display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 14px;
}
.shape-opt {
  min-height: 44px; padding: 6px 8px; border-radius: 10px;
  border: 2px solid var(--sm-panel-border);
  background: var(--sm-btn-bg);
  text-align: center; cursor: pointer;
  font-size: 14px; font-weight: 700;
  font-family: inherit; color: var(--sm-text-muted);
  transition: all 0.15s;
  display: flex; align-items: center; justify-content: center; gap: 6px;
  word-break: keep-all;
}
.shape-opt:disabled { cursor: not-allowed; opacity: 0.55; }
.shape-opt svg { width: 24px; height: 24px; flex-shrink: 0; }
.shape-opt.active {
  border-color: var(--sm-shape);
  background: rgba(92,107,192,0.1);
  color: var(--sm-shape-stroke);
}

/* 컨트롤 그룹 */
.ctrl-group {
  margin-bottom: 14px;
}
.ctrl-group-title {
  font-size: 14px; font-weight: 700;
  color: var(--sm-text-muted);
  margin-bottom: 6px;
}

/* 방향키 십자 배치 */
.dpad {
  display: grid;
  grid-template-columns: 52px 52px 52px;
  grid-template-rows: 52px 52px 52px;
  gap: 4px;
  justify-content: center;
  margin-bottom: 6px;
}
.dpad-btn {
  width: 52px; height: 52px;
  border: 1px solid var(--sm-panel-border);
  background: var(--sm-btn-bg);
  border-radius: 12px;
  font-size: 22px; font-weight: 700;
  cursor: pointer; font-family: inherit;
  color: var(--sm-text);
  display: flex; align-items: center; justify-content: center;
  transition: all 0.1s;
}
.dpad-btn:hover { background: var(--sm-btn-hover); }
.dpad-btn:disabled, .tf-btn:disabled { opacity: 0.45; cursor: not-allowed; }
.dpad-btn:active { background: var(--sm-btn-active); transform: scale(0.92); }
.dpad-center {
  background: none !important; border: none !important;
  font-size: 14px; font-weight: 700; color: var(--sm-text-muted);
  cursor: default;
}

/* 뒤집기·돌리기 버튼(교과서 표현) */
.transform-btns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}
.tf-btn {
  padding: 8px 8px;
  border: 1px solid var(--sm-panel-border);
  background: var(--sm-btn-bg);
  border-radius: 10px;
  font-size: 14px; font-weight: 700; line-height: 1.3;
  cursor: pointer; font-family: inherit;
  color: var(--sm-text);
  display: flex; align-items: center; justify-content: center; gap: 6px;
  transition: all 0.1s;
  min-height: 48px; text-align: left; word-break: keep-all;
}
.tf-btn:hover { background: var(--sm-btn-hover); }
.tf-btn:active { background: var(--sm-btn-active); transform: scale(0.95); }
.tf-btn .ic { flex-shrink: 0; font-size: 18px; color: var(--sm-shape-stroke); }

/* 버튼 줄 */
.action-btns { margin-top: 10px; }
.mission-actions { margin-bottom: 12px; }

/* 미션 패널 (조작판 맨 위: 폰에서도 문제·문구가 조작 버튼보다 먼저 보임) */
.mission-panel {
  background: var(--sm-panel);
  border-radius: var(--sm-radius);
  border: 2px solid var(--sm-panel-border);
  padding: 14px;
  margin-bottom: 10px;
  animation: popIn 0.35s ease;
}
.mission-panel h3 {
  font-size: 15px; font-weight: 700;
  margin-bottom: 8px;
}
.mission-panel small { font-size: 14px; display: inline-block; margin-top: 4px; }
.mission-panel p {
  font-size: 15px; line-height: 1.6;
  color: var(--sm-text-muted);
}

/* 3지선다 (미션 식별) */
.quiz-choices {
  display: flex; flex-direction: column; gap: 8px;
  margin-top: 12px;
}
.quiz-choice {
  min-height: 48px;
  padding: 12px 14px; border-radius: 12px;
  border: 2px solid var(--sm-panel-border);
  background: var(--sm-btn-bg);
  font-size: 15px; font-weight: 700;
  cursor: pointer; font-family: inherit;
  color: var(--sm-text);
  transition: all 0.15s;
  text-align: center;
}
.quiz-choice:hover { border-color: var(--sm-shape); }
.quiz-choice:disabled { cursor: default; }
.quiz-choice.correct { border-color: var(--sm-accent); background: rgba(0,200,83,0.1); color: var(--sm-ok-fg); }
.quiz-choice.wrong { border-color: var(--sm-danger); background: rgba(239,83,80,0.08); color: var(--sm-danger); }
.quiz-choice.correct::after { content: ' ✓'; }
.quiz-choice.wrong::after { content: ' ✗'; }

/* 미션 피드백 */
.m-feedback {
  padding: 12px 14px; border-radius: 12px;
  font-size: 15px; line-height: 1.6;
  margin-top: 10px; text-align: center;
  animation: popIn 0.3s ease;
}
.m-feedback.success { background: rgba(0,200,83,0.1); color: var(--sm-ok-fg); }
.m-feedback.warn { background: rgba(255,109,0,0.1); color: var(--sm-warn-fg); }
.m-feedback.info { background: rgba(92,107,192,0.1); color: var(--sm-shape-stroke); }

/* 미션 진행 바 */
.progress-bar {
  height: 6px; background: var(--sm-btn-bg);
  border-radius: 99px; overflow: hidden;
  margin-bottom: 12px;
}
.progress-fill {
  height: 100%; border-radius: 99px;
  background: linear-gradient(90deg, var(--sm-shape), var(--sm-accent));
  transition: width 0.4s ease;
}

/* 변환 횟수 카운터 */
.move-counter {
  text-align: center; font-size: 14px; font-weight: 600;
  color: var(--sm-text-muted); margin: 0 0 10px;
}

/* ══════════ 결과 화면 (.sk-screen) ══════════ */
.result-screen {
  text-align: center;
  background:
    radial-gradient(circle at 30% 40%, rgba(0,200,83,0.06) 0, transparent 40%),
    radial-gradient(circle at 70% 60%, rgba(92,107,192,0.08) 0, transparent 35%),
    var(--sm-grid-bg);
}
.result-trophy { font-size: 72px; margin-bottom: 8px; color: var(--sm-star); line-height: 1; }
.result-screen h1 { font-size: 28px; font-weight: 800; margin-bottom: 4px; }
.result-screen .score-text { font-size: 18px; color: var(--sm-text-muted); margin-bottom: 16px; }
.result-stars-row { font-size: 28px; margin-bottom: 20px; color: var(--sm-star); }

.result-grid {
  display: grid; grid-template-columns: repeat(5, 1fr);
  gap: 8px; max-width: 400px; width: 100%;
  margin-bottom: 20px;
}
.result-cell {
  background: var(--sm-panel);
  border: 1px solid var(--sm-panel-border);
  border-radius: 10px;
  padding: 8px 4px;
  font-size: 14px; font-weight: 600;
}
.result-cell .num { font-size: 15px; font-weight: 700; }
.result-cell .stars { color: var(--sm-star); font-size: 14px; }

.result-summary-box {
  background: var(--sm-panel);
  border: 1px solid var(--sm-panel-border);
  border-radius: var(--sm-radius);
  padding: 20px 24px;
  max-width: 440px; width: 100%;
  margin-bottom: 20px; text-align: left;
}
.result-summary-box h3 { font-size: 15px; font-weight: 700; margin-bottom: 8px; color: var(--sm-shape-stroke); display: flex; align-items: center; gap: 6px; }
.result-summary-box p { font-size: 15px; line-height: 1.7; color: var(--sm-text-muted); }
.result-summary-box strong { color: var(--sm-ok-fg); }

.result-btns { justify-content: center; max-width: 440px; width: 100%; }

/* ══════════ 반응형 (모바일) ══════════ */
@media (max-width: 800px) {
  body { overflow: auto; }
  .explore-layout {
    display: flex; flex-direction: column;
    height: auto; min-height: 100vh;
  }
  .canvas-zone {
    position: sticky; top: 0; z-index: 40;
    height: 52vh; min-height: 320px; flex-shrink: 0;
    padding: calc(var(--sk-stage-top) + 40px) 8px 8px;
  }
  .sidebar { border-left: none; border-top: 2px solid var(--sm-panel-border); }
  .dpad-btn { width: 48px; height: 48px; }
  .dpad { grid-template-columns: 48px 48px 48px; grid-template-rows: 48px 48px 48px; }
  .intro-screen h1 { font-size: 26px; }
  .intro-art { font-size: 64px; }
  .result-grid { grid-template-columns: repeat(5, 1fr); }
}
</style>
  <script type="application/ld+json" is:inline="">{"@context":"https://schema.org","@type":"WebApplication","name":"도형의 이동","description":"모눈 위 도형을 직접 밀고 뒤집고 돌려 보세요. 초등 수학 4학년 평면도형의 이동을 애니메이션으로 체험하는 무료 학습 시뮬레이션.","url":"https://eduin.info/apps/shape-move/","applicationCategory":"EducationApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"KRW"},"isPartOf":{"@type":"WebSite","name":"eduin VIVES","url":"https://eduin.info"}}</script>
  </Fragment>



<!-- ============ 인트로 ============ -->
<div id="screenIntro" class="screen intro-screen sk-screen active">
  <div class="intro-tag">수학 4학년 · 평면도형의 이동</div>
  <div class="intro-art" aria-hidden="true"><Icon name="shapes" /></div>
  <h1>도형의 이동</h1>
  <p class="intro-sub">모눈 위 도형을 밀고·뒤집고·돌려 보세요</p>

  <div class="intro-previews">
    <div class="intro-preview">
      <div class="icon"><Icon name="move-right" /></div>
      <span>밀기</span>
    </div>
    <div class="intro-preview">
      <div class="icon"><Icon name="flip-horizontal-2" /></div>
      <span>뒤집기</span>
    </div>
    <div class="intro-preview">
      <div class="icon"><Icon name="rotate-cw" /></div>
      <span>돌리기</span>
    </div>
  </div>

  <div class="intro-card">
    <h3>도형을 움직여도 모양과 크기는 그대로일까요?</h3>
    <p>직접 움직여서 확인해 봐요!<br>밀기·뒤집기·돌리기로 도형을 움직이고,<br>모양과 크기가 변하는지 관찰해 보세요.</p>
  </div>

  <button type="button" class="sk-btn sk-btn--primary big-btn" id="btnStart"><Icon name="play" />시작하기</button>
</div>

<!-- ============ 탐험 / 미션 ============ -->
<div id="screenExplore" class="screen explore-screen">
  <div class="explore-layout">
    <!-- 캔버스 -->
    <div class="canvas-zone" id="canvasZone">
      <div class="mission-indicator" id="missionIndicator" style="display:none;">
        <span class="num" id="missionNum">1</span>
        <span id="missionLabel">미션</span>
        <span class="stars" id="missionStarsDisp"></span>
      </div>
      <!-- SVG는 JS가 렌더 -->
    </div>

    <!-- 조작판 -->
    <div class="sidebar" id="sidebar">
      <div class="side-head">
        <h2><Icon name="move" />도형의 이동</h2>
        <div class="side-sub">밀기 · 뒤집기 · 돌리기</div>
      </div>
      <div class="side-body" id="sideBody">
        <!-- 미션 문제·문구(조작 버튼보다 위) -->
        <div id="missionArea"></div>
        <div class="move-counter" id="moveCounter" style="display:none;" aria-live="polite" aria-atomic="true"></div>
        <div class="sk-actions mission-actions" id="missionActions" style="display:none;">
          <button type="button" class="sk-btn sk-btn--sm" id="btnExitMission"><Icon name="arrow-left" />자유 탐험으로</button>
          <button type="button" class="sk-btn sk-btn--sm" id="btnSkip"><Icon name="skip-forward" />건너뛰기</button>
        </div>

        <!-- 도형 선택 -->
        <div class="ctrl-group" id="shapeGroup">
          <div class="ctrl-group-title">도형 고르기</div>
          <div class="shape-select" id="shapeSelect"></div>
        </div>

        <!-- 밀기 (방향 버튼) -->
        <div class="ctrl-group">
          <div class="ctrl-group-title">밀기</div>
          <div class="dpad">
            <div></div>
            <button type="button" class="dpad-btn" data-action="up" aria-label="위쪽으로 한 칸 밀기"><Icon name="arrow-up" /></button>
            <div></div>
            <button type="button" class="dpad-btn" data-action="left" aria-label="왼쪽으로 한 칸 밀기"><Icon name="arrow-left" /></button>
            <div class="dpad-btn dpad-center" aria-hidden="true">밀기</div>
            <button type="button" class="dpad-btn" data-action="right" aria-label="오른쪽으로 한 칸 밀기"><Icon name="arrow-right" /></button>
            <div></div>
            <button type="button" class="dpad-btn" data-action="down" aria-label="아래쪽으로 한 칸 밀기"><Icon name="arrow-down" /></button>
            <div></div>
          </div>
        </div>

        <!-- 뒤집기 (교과서 표현) -->
        <div class="ctrl-group">
          <div class="ctrl-group-title">뒤집기</div>
          <div class="transform-btns">
            <button type="button" class="tf-btn" data-action="flipRight"><Icon name="flip-horizontal-2" />오른쪽으로 뒤집기</button>
            <button type="button" class="tf-btn" data-action="flipLeft"><Icon name="flip-horizontal-2" />왼쪽으로 뒤집기</button>
            <button type="button" class="tf-btn" data-action="flipUp"><Icon name="flip-vertical-2" />위쪽으로 뒤집기</button>
            <button type="button" class="tf-btn" data-action="flipDown"><Icon name="flip-vertical-2" />아래쪽으로 뒤집기</button>
          </div>
        </div>

        <!-- 돌리기 (교과서 표현) -->
        <div class="ctrl-group">
          <div class="ctrl-group-title">돌리기</div>
          <div class="transform-btns">
            <button type="button" class="tf-btn" data-action="rotateCW"><Icon name="rotate-cw" />시계 방향으로 90°만큼 돌리기</button>
            <button type="button" class="tf-btn" data-action="rotateCCW"><Icon name="rotate-ccw" />시계 반대 방향으로 90°만큼 돌리기</button>
          </div>
        </div>

        <!-- 버튼 줄 -->
        <div class="sk-actions action-btns" id="actionBtns">
          <button type="button" class="sk-btn" id="btnReset" data-action="reset"><Icon name="undo-2" />도형 제자리로</button>
          <button type="button" class="sk-btn sk-btn--primary" id="btnMission"><Icon name="trophy" />미션 도전</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ============ 결과 ============ -->
<div id="screenResult" class="screen result-screen sk-screen">
  <div class="result-trophy" aria-hidden="true"><Icon name="trophy" /></div>
  <h1>미션 완료!</h1>
  <div class="score-text" id="resultScoreText"></div>
  <div class="result-stars-row" id="resultStarsRow" aria-hidden="true"></div>
  <div class="result-grid" id="resultGrid" role="list" aria-label="미션별 별"></div>
  <div class="result-summary-box">
    <h3><Icon name="book-open" />배움 정리</h3>
    <p>밀기·뒤집기·돌리기 모두 <strong>모양과 크기는 변하지 않아요.</strong><br><strong>위치·방향만 바뀌어요.</strong></p>
  </div>
  <div class="sk-actions result-btns">
    <button type="button" class="sk-btn sk-btn--primary" id="btnFreeplay"><Icon name="arrow-left" />자유 탐험으로</button>
    <button type="button" class="sk-btn sk-btn--danger" id="btnRetry"><Icon name="refresh-ccw" />처음부터</button>
  </div>
</div>

<script is:inline="">
/* ================================================================
   도형의 이동 — shape-move
   순수 정적 SPA · localStorage만 사용 · 외부 의존성 0
   ================================================================ */
(function() {
'use strict';

const $ = s => document.querySelector(s);
const $$ = s => document.querySelectorAll(s);

/* ── 도형 정의 (비대칭 4종, 정수 좌표) ── */
const SHAPES = {
  'L':     { name: 'ㄴ자',     points: [[0,0],[2,0],[2,1],[1,1],[1,2],[0,2]] },
  'tri':   { name: '직각삼각형', points: [[0,0],[3,0],[0,2]] },
  'trap':  { name: '사다리꼴',  points: [[1,0],[3,0],[4,2],[0,2]] },
  'flag':  { name: '깃발',     points: [[0,0],[3,0],[3,1],[2,1],[1,2],[0,2]] },
};
const SHAPE_IDS = Object.keys(SHAPES);

/* ── 상태 모델 ── */
let state = {
  shapeId: 'L',
  x: 2, y: 2,
  flipX: false, flipY: false,
  rot: 0  // 0, 90, 180, 270
};

let ghostState = null;  // 미션 목표
let missionMode = false;
let currentMission = -1; // -1 = 자유 탐험
let moveCount = 0;
let hintCount = 0;
let missionStars = {};
let animating = false;
let actionQueue = [];
let controlsLocked = false; // 식별 미션·성공 직후: 버튼과 키보드 조작을 함께 막는다
let toastShown = {};  // 관찰 유도 문구 1회성

const STORAGE_KEY = 'shape-move:v1';

/* ── 미션 데이터 ── */
const MISSIONS = [
  // ① 식별 (4개) — 두 그림 보여주고 변환 종류 맞추기
  { type: 'identify', shape: 'L', from: {x:1,y:1,flipX:false,flipY:false,rot:0}, to: {x:4,y:1,flipX:false,flipY:false,rot:0}, answer: 'slide', choices: ['밀기','뒤집기','돌리기'] },
  // ㄴ자는 대각선 대칭이라 좌우 뒤집기 = 90° 돌리기가 되어 정답이 둘 → 비대칭인 직각삼각형으로
  // 2: 세로선(x=4)을 따라 오른쪽으로 뒤집은 자리 / 3: 점(4,3)을 중심으로 시계 방향으로 90°만큼 돌린 자리 / 4: 가로선(y=3)을 따라 아래쪽으로 뒤집은 자리
  { type: 'identify', shape: 'tri', from: {x:1,y:1,flipX:false,flipY:false,rot:0}, to: {x:4,y:1,flipX:true,flipY:false,rot:0}, answer: 'flip', choices: ['밀기','뒤집기','돌리기'], guide: { line: [4, 0.5, 4, 3.5] } },
  { type: 'identify', shape: 'tri', from: {x:1,y:3,flipX:false,flipY:false,rot:0}, to: {x:2,y:0,flipX:false,flipY:false,rot:90}, answer: 'rotate', choices: ['밀기','뒤집기','돌리기'], guide: { point: [4, 3] } },
  { type: 'identify', shape: 'flag', from: {x:1,y:1,flipX:false,flipY:false,rot:0}, to: {x:1,y:3,flipX:false,flipY:true,rot:0}, answer: 'flip', choices: ['밀기','뒤집기','돌리기'], guide: { line: [0.5, 3, 4.5, 3] } },
  // ② 고스트 맞추기 (4개, 1~2회 변환)
  { type: 'ghost', shape: 'L', start: {x:1,y:1,flipX:false,flipY:false,rot:0}, goal: {x:4,y:1,flipX:false,flipY:false,rot:0}, minMoves: 1 },
  { type: 'ghost', shape: 'tri', start: {x:1,y:2,flipX:false,flipY:false,rot:0}, goal: {x:4,y:2,flipX:true,flipY:false,rot:0}, minMoves: 1 }, // 오른쪽으로 뒤집기 1번
  { type: 'ghost', shape: 'L', start: {x:1,y:1,flipX:false,flipY:false,rot:0}, goal: {x:4,y:1,flipX:false,flipY:false,rot:90}, minMoves: 2 },
  { type: 'ghost', shape: 'flag', start: {x:1,y:1,flipX:false,flipY:false,rot:0}, goal: {x:1,y:4,flipX:false,flipY:false,rot:0}, minMoves: 1 },
  // ③ 복합 (2개, 2~3회, 뒤집기+돌리기 조합)
  { type: 'ghost', shape: 'L', start: {x:1,y:1,flipX:false,flipY:false,rot:0}, goal: {x:4,y:1,flipX:true,flipY:false,rot:90}, minMoves: 2 },
  { type: 'ghost', shape: 'flag', start: {x:1,y:1,flipX:false,flipY:false,rot:0}, goal: {x:3,y:3,flipX:true,flipY:false,rot:0}, minMoves: 2 },
];

const MISSION_IDS = MISSIONS.map((_, i) => 'm' + (i + 1));

/* ── 저장/복원 — 키·모양은 예전 그대로 { missions: { m1: 별 0~3 }, freeState } ── */
const store = SimKit.store(STORAGE_KEY, {
  defaults: { missions: {}, freeState: null },
  validate: raw => (raw && typeof raw === 'object') ? {
    missions: SimKit.clean.stars(raw.missions, MISSION_IDS, 3),
    freeState: raw.freeState && typeof raw.freeState === 'object' ? raw.freeState : null,
  } : null,
});
function saveState() {
  store.save({ missions: missionStars, freeState: missionMode ? null : state });
}
function loadState() {
  const saved = store.load();
  missionStars = saved.missions;
  if (saved.freeState) applySavedShape(saved.freeState);
}

/* 저장값·공유 링크에서 온 도형 상태는 허용된 필드만 형식을 맞춰 복사 */
function applySavedShape(src) {
  if (!src || typeof src !== 'object') return;
  const n = (v, d) => (window.VSafe ? VSafe.int(v, 0, GRID, d) : (Number.isInteger(v) ? Math.min(GRID, Math.max(0, v)) : d));
  if (SHAPES.hasOwnProperty(src.shapeId)) state.shapeId = src.shapeId;
  state.x = n(src.x, 2);
  state.y = n(src.y, 2);
  state.flipX = src.flipX === true;
  state.flipY = src.flipY === true;
  state.rot = [0, 90, 180, 270].includes(src.rot) ? src.rot : 0;
  clampState(state.shapeId, state);
}

/* ── 공유 링크 — 예전 btoa 링크와 새 base64url 링크를 모두 읽는다 ── */
function parseShareLink() {
  const payload = SimKit.share.read({ version: 1 });
  if (payload && payload.state) applySavedShape(payload.state);
}

/* ── 화면 전환 ── */
const screens = SimKit.screens({ focus: true });
function showScreen(id) { screens.show(id); }

/* ══════════════════════════════════════
   SVG 렌더링
   ══════════════════════════════════════ */
const GRID = 8;
const CELL = 1; // viewBox 단위

function getTransformedPoints(shape, st) {
  const pts = SHAPES[shape].points.map(p => [p[0], p[1]]);
  // 바운딩 박스 중심
  let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
  pts.forEach(([px,py]) => { minX = Math.min(minX, px); minY = Math.min(minY, py); maxX = Math.max(maxX, px); maxY = Math.max(maxY, py); });
  const cx = (minX + maxX) / 2;
  const cy = (minY + maxY) / 2;

  // 중심 기준 변환
  let transformed = pts.map(([px, py]) => [px - cx, py - cy]);

  // 뒤집기
  if (st.flipX) transformed = transformed.map(([px, py]) => [-px, py]);
  if (st.flipY) transformed = transformed.map(([px, py]) => [px, -py]);

  // 회전
  const rad = st.rot * Math.PI / 180;
  const cosR = Math.round(Math.cos(rad));
  const sinR = Math.round(Math.sin(rad));
  transformed = transformed.map(([px, py]) => [
    px * cosR - py * sinR,
    px * sinR + py * cosR
  ]);

  // 원점 복귀 + 위치 이동
  let tMinX = Infinity, tMinY = Infinity;
  transformed.forEach(([px,py]) => { tMinX = Math.min(tMinX, px); tMinY = Math.min(tMinY, py); });
  return transformed.map(([px, py]) => [px - tMinX + st.x, py - tMinY + st.y]);
}

function getBBox(shape, st) {
  const pts = getTransformedPoints(shape, st);
  let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
  pts.forEach(([px,py]) => { minX = Math.min(minX, px); minY = Math.min(minY, py); maxX = Math.max(maxX, px); maxY = Math.max(maxY, py); });
  return { minX, minY, maxX, maxY, w: maxX - minX, h: maxY - minY };
}

function clampState(shape, st) {
  const bb = getBBox(shape, st);
  if (bb.minX < 0) st.x -= bb.minX;
  if (bb.minY < 0) st.y -= bb.minY;
  if (bb.maxX > GRID) st.x -= (bb.maxX - GRID);
  if (bb.maxY > GRID) st.y -= (bb.maxY - GRID);
  st.x = Math.round(st.x);
  st.y = Math.round(st.y);
}

function renderSVG() {
  const zone = $('#canvasZone');
  // 기존 SVG 제거
  const oldSvg = zone.querySelector('svg.grid-svg');
  if (oldSvg) oldSvg.remove();

  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  svg.setAttribute('class', 'grid-svg');
  svg.setAttribute('role', 'img');
  svg.setAttribute('aria-label', `모눈 위의 파란 ${SHAPES[state.shapeId].name} 도형` + (ghostState ? ' · 점선 도형이 목표예요' : ''));
  svg.setAttribute('viewBox', `-0.5 -0.5 ${GRID + 1} ${GRID + 1}`);

  // 패턴 (모눈)
  const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
  defs.innerHTML = `
    <pattern id="gridPat" width="1" height="1" patternUnits="userSpaceOnUse">
      <rect width="1" height="1" fill="var(--sm-grid-bg)"/>
      <line x1="0" y1="1" x2="1" y2="1" stroke="var(--sm-grid)" stroke-width="0.03"/>
      <line x1="1" y1="0" x2="1" y2="1" stroke="var(--sm-grid)" stroke-width="0.03"/>
    </pattern>`;
  svg.appendChild(defs);

  // 배경
  const bg = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
  bg.setAttribute('x', '0'); bg.setAttribute('y', '0');
  bg.setAttribute('width', GRID); bg.setAttribute('height', GRID);
  bg.setAttribute('fill', 'url(#gridPat)');
  bg.setAttribute('stroke', 'var(--sm-grid)');
  bg.setAttribute('stroke-width', '0.05');
  bg.setAttribute('rx', '0.1');
  svg.appendChild(bg);

  // 외곽선 (두꺼운 테두리)
  const border = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
  border.setAttribute('x', '0'); border.setAttribute('y', '0');
  border.setAttribute('width', GRID); border.setAttribute('height', GRID);
  border.setAttribute('fill', 'none');
  border.setAttribute('stroke', 'var(--sm-grid)');
  border.setAttribute('stroke-width', '0.06');
  border.setAttribute('rx', '0.1');
  svg.appendChild(border);

  // 고스트
  if (ghostState) {
    const gPts = getTransformedPoints(ghostState.shape || state.shapeId, ghostState);
    const ghostPoly = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
    ghostPoly.setAttribute('points', gPts.map(p => p.join(',')).join(' '));
    ghostPoly.setAttribute('fill', 'var(--sm-ghost)');
    ghostPoly.setAttribute('stroke', 'var(--sm-ghost-stroke)');
    ghostPoly.setAttribute('stroke-width', '0.06');
    ghostPoly.setAttribute('stroke-dasharray', '0.15 0.1');
    svg.appendChild(ghostPoly);
  }

  // 식별 미션 안내선: 뒤집은 선(점선) 또는 돌린 중심점
  const mi = missionMode && MISSIONS[currentMission];
  if (mi && mi.type === 'identify' && mi.guide) {
    if (mi.guide.line) {
      const [x1, y1, x2, y2] = mi.guide.line;
      const ln = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      ln.setAttribute('x1', x1); ln.setAttribute('y1', y1); ln.setAttribute('x2', x2); ln.setAttribute('y2', y2);
      ln.setAttribute('stroke', 'var(--sm-guide)'); ln.setAttribute('stroke-width', '0.06');
      ln.setAttribute('stroke-dasharray', '0.2 0.12'); ln.setAttribute('stroke-linecap', 'round');
      svg.appendChild(ln);
    }
    if (mi.guide.point) {
      const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      c.setAttribute('cx', mi.guide.point[0]); c.setAttribute('cy', mi.guide.point[1]); c.setAttribute('r', '0.14');
      c.setAttribute('fill', 'var(--sm-guide)');
      svg.appendChild(c);
    }
  }

  // 도형: 꼭짓점은 처음 모양 그대로 두고 transform(옮기기·돌리기·뒤집기)만 바꾼다 → 움직임이 보인다
  const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
  g.id = 'shapeG';
  const poly = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
  poly.setAttribute('points', centeredPoints(state.shapeId).map(p => p.join(',')).join(' '));
  poly.setAttribute('fill', 'var(--sm-shape)');
  poly.setAttribute('stroke', 'var(--sm-shape-stroke)');
  poly.setAttribute('stroke-width', '0.08');
  poly.setAttribute('stroke-linejoin', 'round');
  poly.id = 'shapePoly';
  g.appendChild(poly);
  svg.appendChild(g);

  zone.insertBefore(svg, zone.firstChild);
  stopTween();
  view = viewFromState(state);
  applyView();
}

/* ── 도형 움직임(애니메이션) ──
   view = { tx, ty, a, sx, sy }: 도형 중심 위치, 돌린 각도(누적), 좌우·상하 뒤집기(±1).
   상태(state)와 같은 모양을 그리되, 각도는 누적하고 뒤집기는 그대로 두어 사이 값이 자연스럽게 이어진다. */
let view = { tx: 0, ty: 0, a: 0, sx: 1, sy: 1 };
function centeredPoints(shape) {
  const pts = SHAPES[shape].points;
  let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
  pts.forEach(([px, py]) => { minX = Math.min(minX, px); minY = Math.min(minY, py); maxX = Math.max(maxX, px); maxY = Math.max(maxY, py); });
  const cx = (minX + maxX) / 2, cy = (minY + maxY) / 2;
  return pts.map(([px, py]) => [px - cx, py - cy]);
}
function centerOf(st) {
  const bb = getBBox(st.shapeId, st);
  return { tx: (bb.minX + bb.maxX) / 2, ty: (bb.minY + bb.maxY) / 2 };
}
function viewFromState(st) {
  const c = centerOf(st);
  return { tx: c.tx, ty: c.ty, a: st.rot, sx: st.flipX ? -1 : 1, sy: st.flipY ? -1 : 1 };
}
/* 버튼 하나를 누른 뒤의 view: 화면 기준 좌우 뒤집기는 도형이 옆으로 누워 있으면(90°·270°) 도형의 위아래 축을 뒤집는다 */
function nextView(prev, action, st) {
  const v = { ...prev, ...centerOf(st) };
  const sideways = ((Math.round(prev.a / 90) % 2) + 2) % 2 === 1;
  if (action === 'rotateCW') v.a = prev.a + 90;
  else if (action === 'rotateCCW') v.a = prev.a - 90;
  else if (['flipX', 'flipRight', 'flipLeft'].includes(action)) { if (sideways) v.sy = -prev.sy; else v.sx = -prev.sx; }
  else if (['flipY', 'flipUp', 'flipDown'].includes(action)) { if (sideways) v.sx = -prev.sx; else v.sy = -prev.sy; }
  return v;
}
function applyView() {
  const g = document.getElementById('shapeG');
  if (!g) return;
  const r = (n) => Math.round(n * 1000) / 1000;
  g.setAttribute('transform', `translate(${r(view.tx)} ${r(view.ty)}) rotate(${r(view.a)}) scale(${r(view.sx)} ${r(view.sy)})`);
}
let tween = null;
const shapeLoop = SimKit.loop((dt) => {
  if (!tween) { shapeLoop.stop(); return; }
  tween.t += dt;
  const k = Math.min(1, tween.t / tween.dur);
  const e = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
  const f = tween.from, to = tween.to;
  view = {
    tx: f.tx + (to.tx - f.tx) * e, ty: f.ty + (to.ty - f.ty) * e,
    a: f.a + (to.a - f.a) * e, sx: f.sx + (to.sx - f.sx) * e, sy: f.sy + (to.sy - f.sy) * e
  };
  applyView();
  if (k >= 1) stopTween();
});
function stopTween() {
  if (!tween) return;
  const t = tween;
  tween = null;
  view = t.to;
  applyView();
  shapeLoop.stop();
  t.done();
}
/* 목표 view까지 0.4초 동안 움직인다(움직임 줄이기 설정이면 바로). 끝나면 resolve */
function animateTo(target) {
  return new Promise(resolve => {
    stopTween();
    if (SimKit.motion.reduced()) { view = target; applyView(); resolve(); return; }
    tween = { from: { ...view }, to: target, t: 0, dur: 0.4, done: resolve };
    shapeLoop.start();
  });
}

/* ══════════════════════════════════════
   변환 함수
   ══════════════════════════════════════ */
function normalizeState(st) {
  // flipX && flipY → rot+180 흡수, flipY=false
  let s = { ...st };
  s.rot = ((s.rot % 360) + 360) % 360;
  if (s.flipX && s.flipY) {
    s.flipX = false;
    s.flipY = false;
    s.rot = (s.rot + 180) % 360;
  }
  return s;
}

/* 화면에 보이는 모양(꼭짓점 집합)으로 비교한다.
   대칭인 도형(ㄴ자는 대각선 대칭, 사다리꼴은 좌우 대칭)은 상태값이 달라도 같은 모양일 수 있음. */
function shapeKey(shape, st) {
  return getTransformedPoints(shape, st)
    .map(([px, py]) => Math.round(px * 2) + ',' + Math.round(py * 2))
    .sort().join(' ');
}
function statesMatch(a, b, shape) {
  const sh = shape || state.shapeId;
  return shapeKey(sh, a) === shapeKey(sh, b);
}

/* 버튼 하나의 결과(순수 함수). 미션 최소 횟수 계산에도 같은 규칙을 쓴다. */
function transformState(shape, st, action) {
  const s = { ...st };
  // 모델은 "뒤집은 뒤 돌리기" 순서라, 90°·270°로 돌아간 상태에서 화면 기준 좌우 뒤집기는
  // 모델의 상하 뒤집기와 같다(반대도 마찬가지).
  const sideways = s.rot === 90 || s.rot === 270;
  switch (action) {
    case 'left':  s.x--; break;
    case 'right': s.x++; break;
    case 'up':    s.y--; break;
    case 'down':  s.y++; break;
    case 'flipX': if (sideways) s.flipY = !s.flipY; else s.flipX = !s.flipX; break;
    case 'flipY': if (sideways) s.flipX = !s.flipX; else s.flipY = !s.flipY; break;
    // 오른쪽·왼쪽으로 뒤집기: 좌우가 바뀌고, 도형 오른쪽(왼쪽) 끝 선을 따라 넘어가 그 옆에 놓인다
    case 'flipRight': case 'flipLeft': {
      const w = getBBox(shape, s).w;
      if (sideways) s.flipY = !s.flipY; else s.flipX = !s.flipX;
      s.x += action === 'flipRight' ? w : -w;
      break;
    }
    // 위쪽·아래쪽으로 뒤집기: 위아래가 바뀌고, 위(아래) 끝 선을 따라 넘어간다
    case 'flipUp': case 'flipDown': {
      const h = getBBox(shape, s).h;
      if (sideways) s.flipX = !s.flipX; else s.flipY = !s.flipY;
      s.y += action === 'flipDown' ? h : -h;
      break;
    }
    case 'rotateCW':  s.rot = (s.rot + 90) % 360; break;
    case 'rotateCCW': s.rot = (s.rot + 270) % 360; break;
  }
  clampState(shape, s);
  return normalizeState(s);
}

/* 시작 → 목표까지 실제 최소 버튼 횟수(밀기 한 칸도 1번). 너비 우선 탐색 */
const ALL_ACTIONS = ['left','right','up','down','flipRight','flipLeft','flipUp','flipDown','rotateCW','rotateCCW'];
function computeMinMoves(m) {
  const start = { ...m.start };
  clampState(m.shape, start);
  const goalKey = shapeKey(m.shape, m.goal);
  const stKey = s => `${s.x},${s.y},${s.flipX},${s.flipY},${s.rot}`;
  let frontier = [normalizeState(start)];
  const seen = new Set([stKey(frontier[0])]);
  for (let depth = 0; depth <= 20; depth++) {
    for (const s of frontier) if (shapeKey(m.shape, s) === goalKey) return depth;
    const next = [];
    for (const s of frontier) {
      for (const a of ALL_ACTIONS) {
        const n = transformState(m.shape, s, a);
        const k = stKey(n);
        if (!seen.has(k)) { seen.add(k); next.push(n); }
      }
    }
    if (!next.length) break;
    frontier = next;
  }
  return m.minMoves;
}

function applyAction(action) {
  if (controlsLocked) return;
  // 성공 뒤 자동 이동을 기다리는 동안: 도형이 또 움직여 두 번 채점되지 않게
  if (missionMode && mc.pending()) return;
  if (animating && actionQueue.length >= 2) return; // 큐 상한
  if (animating) { actionQueue.push(action); return; }

  doAction(action);
}

async function doAction(action) {
  animating = true;

  if (action === 'reset') {
    resetShape();
    animating = false;
    actionQueue = [];
    return;
  }

  const prevView = { ...view };
  state = { ...transformState(state.shapeId, state, action), shapeId: state.shapeId };

  if (missionMode && MISSIONS[currentMission] && MISSIONS[currentMission].type === 'ghost') {
    moveCount++;
    updateMoveCounter();
  }

  // 토스트 (관찰 유도, 1회성)
  showObserveToast(action);

  const visit = mc.token();
  await animateTo(nextView(prevView, action, state));

  // 움직이는 사이에 다른 미션으로 옮겼으면 채점하지 않는다
  const sameVisit = mc.alive(visit);
  if (sameVisit && missionMode && ghostState && MISSIONS[currentMission] && MISSIONS[currentMission].type === 'ghost') {
    checkGhostMission();
  }

  animating = false;
  saveState();
  if (!sameVisit) { actionQueue = []; return; }

  // 큐 처리
  if (actionQueue.length > 0) {
    const next = actionQueue.shift();
    doAction(next);
  }
}

function resetShape() {
  if (missionMode && MISSIONS[currentMission]) {
    const m = MISSIONS[currentMission];
    if (m.type === 'ghost') {
      Object.assign(state, { ...m.start, shapeId: m.shape });
      state.shapeId = m.shape;
    }
  } else {
    state.x = 2; state.y = 2;
    state.flipX = false; state.flipY = false;
    state.rot = 0;
  }
  moveCount = 0;
  hintCount = 0;
  updateMoveCounter();
  renderSVG();
}

function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

/* ── 관찰 유도 토스트 ── */
function showObserveToast(action) {
  let msg = '';
  if (['left','right','up','down'].includes(action) && !toastShown.slide) {
    msg = '위치가 바뀌었어요! 모양은 변했나요?';
    toastShown.slide = true;
  } else if (['flipRight','flipLeft','flipUp','flipDown'].includes(action) && !toastShown.flip) {
    msg = '방향이 바뀌었어요! 칸 수를 세어 보세요!';
    toastShown.flip = true;
  } else if (['rotateCW','rotateCCW'].includes(action) && !toastShown.rotate) {
    msg = '돌렸어요! 모양이 변했나요? 칸 수를 세어 보세요!';
    toastShown.rotate = true;
  }
  if (!msg) return;
  showToast(msg);
}

function showToast(msg) { SimKit.toast(msg); }

/* ── 도형 선택 UI ── */
function renderShapeSelect() {
  const container = $('#shapeSelect');
  container.innerHTML = SHAPE_IDS.map(id => {
    const s = SHAPES[id];
    const pts = s.points.map(p => p.join(',')).join(' ');
    return `<button type="button" class="shape-opt ${id === state.shapeId ? 'active' : ''}" data-shape="${id}" aria-pressed="${id === state.shapeId}"${missionMode ? ' disabled' : ''}>
      <svg viewBox="-0.3 -0.3 4.6 4.6" aria-hidden="true"><polygon points="${pts}" fill="currentColor" fill-opacity="0.35" stroke="currentColor" stroke-width="0.25" stroke-linejoin="round"/></svg>
      <span>${s.name}</span>
    </button>`;
  }).join('');

  container.querySelectorAll('.shape-opt').forEach(btn => {
    btn.addEventListener('click', () => {
      if (animating || missionMode) return;
      state.shapeId = btn.dataset.shape;
      state.x = 2; state.y = 2;
      state.flipX = false; state.flipY = false; state.rot = 0;
      renderShapeSelect();
      renderSVG();
      saveState();
    });
  });
}

/* ══════════════════════════════════════
   미션 시스템 — 이동·자동 넘김·문구 표시는 SimKit 미션 컨트롤러(docs/sim-kit.md)
   ══════════════════════════════════════ */
const mc = SimKit.missions({
  ids: MISSION_IDS,
  format: 'stars',      // 저장 모양 { m1: 0~3 } 그대로(0 = 아직 안 함)
  keepBest: true,       // 고스트 미션은 최고 기록 유지
  feedback: () => document.getElementById('missionFeedback'),
  feedbackOptions: { classes: { ok: 'm-feedback success', no: 'm-feedback warn', warn: 'm-feedback warn', info: 'm-feedback info' } },
  onEnter: i => setupMission(i),
  onFinish: () => showResult(),
  onChange: p => { missionStars = p; saveState(); updateMissionLabel(); },
});

function startMissions() {
  missionMode = true;
  mc.start(); // 첫 미완료 미션부터(다 했으면 1번부터)
}

function setupMission(idx) {
  currentMission = idx;
  moveCount = 0;
  hintCount = 0;
  actionQueue = [];
  const m = MISSIONS[idx];
  const area = $('#missionArea');

  // 미션 인디케이터
  $('#missionIndicator').style.display = '';
  $('#missionNum').textContent = idx + 1;
  updateMissionLabel();

  // 진행 바
  let html = `<div class="progress-bar" role="progressbar" aria-label="미션 진행" aria-valuemin="0" aria-valuemax="${MISSIONS.length}" aria-valuenow="${idx}"><div class="progress-fill" style="width:${((idx) / MISSIONS.length) * 100}%"></div></div>`;

  state.shapeId = m.shape;
  if (m.type === 'identify') {
    // 식별 미션: 두 그림 보여주고 3지선다
    Object.assign(state, m.from);
    clampState(state.shapeId, state);
    ghostState = { ...m.to, shape: m.shape };

    html += `<div class="mission-panel">
      <h3>미션 ${idx + 1}: 어떻게 움직였을까요?</h3>
      <p>파란 도형을 한 번 움직였더니 점선 도형이 되었어요.<br>어떻게 움직였을까요?${m.guide ? '<br><small>주황색 ' + (m.guide.line ? '점선을 따라' : '점을 중심으로') + ' 움직였어요.</small>' : ''}</p>
      <div class="quiz-choices" id="quizChoices">
        ${m.choices.map(c => `<button type="button" class="quiz-choice" data-choice="${c}">${c}</button>`).join('')}
      </div>
      <div id="missionFeedback"></div>
    </div>`;
    area.innerHTML = html;
    area.querySelectorAll('.quiz-choice').forEach(btn => {
      btn.addEventListener('click', () => checkIdentifyAnswer(btn, m));
    });
    disableControls(true); // 식별은 보기 고르기만
  } else {
    // 고스트 맞추기 미션 — 버튼 한 번(한 칸 밀기·한 번 뒤집기·한 번 돌리기)이 1번
    Object.assign(state, { ...m.start });
    clampState(state.shapeId, state);
    ghostState = { ...m.goal, shape: m.shape };

    html += `<div class="mission-panel">
      <h3>미션 ${idx + 1}: 도형을 움직여요</h3>
      <p>파란 도형을 점선 도형에 맞춰 보세요!<br>버튼을 최소 <strong>${computeMinMoves(m)}번</strong> 눌러서 맞출 수 있어요.<br><small>한 칸 밀기, 한 번 뒤집기, 한 번 돌리기가 각각 1번이에요. 처음 자리로 돌아가려면 [도형 제자리로]를 눌러요.</small></p>
      <div id="missionFeedback"></div>
    </div>`;
    area.innerHTML = html;
    disableControls(false);
  }
  updateMoveCounter();
  renderShapeSelect();
  renderSVG();

  // 미션 중: [자유 탐험으로]·[건너뛰기]는 문제 바로 아래, [미션 도전]은 숨김
  $('#missionActions').style.display = '';
  $('#btnMission').style.display = 'none';
  $('#shapeGroup').style.display = 'none'; // 미션 도형은 정해져 있음

  // 자동으로 넘어와 초점을 잃었으면 새 미션 제목으로
  const ae = document.activeElement;
  if (!ae || ae === document.body) {
    const h = area.querySelector('h3');
    if (h) { h.tabIndex = -1; try { h.focus({ preventScroll: true }); } catch (e) { h.focus(); } }
  }
}

function checkIdentifyAnswer(btn, mission) {
  if (mc.pending()) return;
  const answerText = mission.answer === 'slide' ? '밀기' : mission.answer === 'flip' ? '뒤집기' : '돌리기';
  const correct = btn.dataset.choice === answerText;

  $$('.quiz-choice').forEach(b => {
    b.disabled = true;
    if (b.dataset.choice === answerText) b.classList.add('correct');
  });

  if (correct) {
    btn.classList.add('correct');
    mc.complete({ stars: 3, message: `정답! ${btn.dataset.choice}예요! 곧 다음 미션으로 넘어가요.`, advance: 1500, keepBest: false });
  } else {
    btn.classList.add('wrong');
    // 오답도 별 1개로 완료하고 넘어간다(예전 동작 그대로 — 식별 미션은 다시 풀면 덮어씀)
    mc.complete({ stars: 1, tone: 'warn', message: `정답은 "${answerText}"예요! 곧 다음 미션으로 넘어가요.`, advance: 1500, keepBest: false });
  }
}

function checkGhostMission() {
  if (!ghostState || mc.pending()) return;
  const m = MISSIONS[currentMission];
  if (statesMatch(state, m.goal, m.shape)) {
    // 성공!
    const min = computeMinMoves(m);
    let stars = 1;
    if (moveCount <= min) stars = 3;
    else if (moveCount <= min + 1) stars = 2;
    disableControls(true);
    actionQueue = [];
    mc.complete({ stars, message: `성공! ${moveCount}번 만에 맞췄어요! ${SimKit.stars.text(stars, 3)} 곧 다음 미션으로 넘어가요.`, advance: 1800 });
  } else {
    // 3번 어긋나면 힌트(한 번만)
    hintCount++;
    if (hintCount === 3 && mc.feedback) {
      let hint = '';
      if (m.goal.flipX !== (m.start.flipX || false)) hint = '뒤집기가 필요해요!';
      else if (m.goal.rot !== (m.start.rot || 0)) hint = '돌리기가 필요해요!';
      else hint = '밀기로 위치를 맞춰 보세요!';
      mc.feedback.show('info', `힌트: ${hint}`);
    }
  }
}

function updateMissionLabel() {
  if (currentMission < 0) return;
  const stars = missionStars['m' + (currentMission + 1)] || 0;
  $('#missionLabel').textContent = `미션 ${currentMission + 1}/${MISSIONS.length}`;
  $('#missionStarsDisp').textContent = stars > 0 ? '★'.repeat(stars) : '';
  $('#missionStarsDisp').setAttribute('aria-label', stars > 0 ? `별 ${stars}개` : '');
}

function updateMoveCounter() {
  const el = $('#moveCounter');
  if (missionMode && MISSIONS[currentMission] && MISSIONS[currentMission].type === 'ghost') {
    el.style.display = '';
    el.textContent = `누른 횟수: ${moveCount}번`;
  } else {
    el.style.display = 'none';
  }
}

function disableControls(disabled) {
  controlsLocked = disabled;
  $$('.dpad-btn:not(.dpad-center)').forEach(b => b.disabled = disabled);
  $$('.tf-btn').forEach(b => b.disabled = disabled);
}

function exitMissionMode() {
  mc.stop(); // 대기 중인 자동 이동·미션 타이머 취소
  missionMode = false;
  currentMission = -1;
  ghostState = null;
  moveCount = 0;
  actionQueue = [];
  $('#missionArea').innerHTML = '';
  $('#missionIndicator').style.display = 'none';
  $('#moveCounter').style.display = 'none';
  $('#missionActions').style.display = 'none';
  $('#btnMission').style.display = '';
  $('#shapeGroup').style.display = '';
  disableControls(false);
  state.x = 2; state.y = 2;
  state.flipX = false; state.flipY = false; state.rot = 0;
  renderShapeSelect();
  renderSVG();
}

/* ══════════════════════════════════════
   결과 화면
   ══════════════════════════════════════ */
function showResult() {
  missionMode = false;
  ghostState = null;
  currentMission = -1;
  actionQueue = [];
  $('#missionActions').style.display = 'none';
  $('#btnMission').style.display = '';
  $('#shapeGroup').style.display = '';
  showScreen('screenResult');

  const totalStars = mc.totalStars();
  let gridHtml = '';
  for (let i = 0; i < MISSIONS.length; i++) {
    const s = mc.starsOf(i);
    gridHtml += `<div class="result-cell" role="listitem" aria-label="미션 ${i + 1}: ${s > 0 ? '별 ' + s + '개' : '안 함'}">
      <div class="num" aria-hidden="true">${i + 1}</div>
      <div class="stars" aria-hidden="true">${SimKit.stars.text(s, 3, '—')}</div>
    </div>`;
  }

  $('#resultScoreText').textContent = `${totalStars} / ${MISSIONS.length * 3} 점`;
  $('#resultStarsRow').textContent = '★'.repeat(Math.min(totalStars, 30));
  $('#resultGrid').innerHTML = gridHtml;
}

/* ══════════════════════════════════════
   공유 확장
   ══════════════════════════════════════ */
function setupShare() {
  SimKit.share.bind(() => ({
    v: 1,
    state: { shapeId: state.shapeId, x: state.x, y: state.y, flipX: state.flipX, flipY: state.flipY, rot: state.rot },
  }), { title: '도형의 이동 — 내 도형 배치' });
}

/* ══════════════════════════════════════
   키보드 입력
   ══════════════════════════════════════ */
function setupKeyboard() {
  document.addEventListener('keydown', (e) => {
    if (!$('#screenExplore').classList.contains('active')) return;
    if (e.ctrlKey || e.metaKey || e.altKey) return; // Ctrl+R(새로고침) 같은 단축키는 건드리지 않음
    const t = e.target;
    if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
    const keyMap = {
      'ArrowLeft': 'left', 'ArrowRight': 'right',
      'ArrowUp': 'up', 'ArrowDown': 'down',
      'f': 'flipRight', 'g': 'flipDown', 'F': 'flipRight', 'G': 'flipDown',
      'r': 'rotateCW', 'e': 'rotateCCW', 'R': 'rotateCW', 'E': 'rotateCCW',
    };
    const action = keyMap[e.key];
    if (action) {
      e.preventDefault();
      applyAction(action);
    }
  });
}

/* ══════════════════════════════════════
   초기화
   ══════════════════════════════════════ */
function init() {
  loadState();
  mc.setProgress(missionStars);
  parseShareLink();

  // 시작
  $('#btnStart').addEventListener('click', () => {
    showScreen('screenExplore');
    renderShapeSelect();
    renderSVG();
  });

  // 방향키
  $$('.dpad-btn:not(.dpad-center)').forEach(btn => {
    btn.addEventListener('click', () => applyAction(btn.dataset.action));
  });

  // 변환 버튼
  $$('.tf-btn').forEach(btn => {
    btn.addEventListener('click', () => applyAction(btn.dataset.action));
  });

  // 리셋
  $('#btnReset').addEventListener('click', () => {
    if (animating) return;
    resetShape();
  });

  // 미션 도전 / 건너뛰기 / 자유 탐험으로 — 버튼마다 리스너 하나
  $('#btnMission').addEventListener('click', () => startMissions());
  $('#btnSkip').addEventListener('click', () => mc.skip());
  $('#btnExitMission').addEventListener('click', () => {
    exitMissionMode(); // 진행 기록(별)은 그대로
    saveState();
  });

  // 결과 화면
  $('#btnRetry').addEventListener('click', async () => {
    const ok = await VUI.confirm('미션 별 기록을 모두 지우고 처음부터 할까요?', { title: SimKit.LABELS.reset, ok: SimKit.LABELS.reset, danger: true });
    if (!ok) return;
    mc.reset(); // 별 기록 지우기(onChange → 저장)
    showScreen('screenExplore');
    exitMissionMode();
    startMissions();
  });
  $('#btnFreeplay').addEventListener('click', () => {
    showScreen('screenExplore');
    exitMissionMode();
    renderShapeSelect();
  });

  setupKeyboard();
  setupShare();
  renderShapeSelect();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}

})();
</script>



</AppLayout>
