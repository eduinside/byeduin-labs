/* ── 앱 런타임 상태 ── */
let state = {
  mode: 1, // 1: 자유, 2: 미션
  missionIdx: 0,
  missionsCompleted: { m1: false, m2: false, m3: false, m4: false, m5: false, m6: false },
  
  // 격자 위 배치된 선분(세그먼트) 상태 정보
  // key: "x1,y1-x2,y2" (항상 x1<=x2, y1<=y2 정렬)
  // value: { type: 'wire' | 'battery' | 'bulb' | 'switch', switchOpen: true/false }
  segments: new Map(),

  // 선택된 도구: 'select', 'wire', 'eraser', 'battery', 'bulb', 'switch'
  activeTool: 'select',
  selectedPaletteComponent: null, // 팔레트에서 선택한 부품명
  
  // 회로 해석 결과 캐시
  litBulbs: new Set(), // lit된 bulb의 key 집합
  hasShortCircuit: false,
  circuitType: 'unknown', // 'base', 'series_bulb', 'parallel_bulb', 'series_battery', 'unknown'
  bulbBrightness: 2, // 1: 어두움, 2: 보통, 3: 밝음 (가장 밝은 전구 기준)
  bulbLevels: new Map() // 전구별 밝기 단계 (key → 1~3)
};

const STORAGE_KEY = 'circuit-lab:v1';
const MISSION_IDS = MISSIONS.map(m => m.id);

/* ── 유틸 ── */
const $ = s => document.querySelector(s);
const $$ = s => document.querySelectorAll(s);
const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

function segmentsObj() {
  const obj = {};
  state.segments.forEach((v, k) => { obj[k] = v; });
  return obj;
}

/* 저장(키·모양 그대로: { missionsCompleted, lastCircuit }) */
const store = SimKit.store(STORAGE_KEY, {
  defaults: { missionsCompleted: { m1: false, m2: false, m3: false, m4: false, m5: false, m6: false }, lastCircuit: {} },
  validate: (raw) => {
    if (!raw || typeof raw !== 'object') return null;
    return {
      missionsCompleted: SimKit.clean.flags(raw.missionsCompleted, MISSION_IDS),
      lastCircuit: raw.lastCircuit && typeof raw.lastCircuit === 'object' ? raw.lastCircuit : {}
    };
  }
});
function saveState() {
  store.save({ missionsCompleted: state.missionsCompleted, lastCircuit: segmentsObj() });
}

/* 저장값·공유 링크에서 온 회로 검사: 격자 안의 이웃한 두 점을 잇는 선분과 알려진 부품만 남긴다 */
function cleanSegments(obj) {
  const out = new Map();
  if (!obj || typeof obj !== 'object') return out;
  const re = /^(\d),(\d)-(\d),(\d)$/;
  Object.keys(obj).forEach(key => {
    const m = re.exec(key);
    const v = obj[key];
    if (!m || !v || !['wire', 'battery', 'bulb', 'switch'].includes(v.type)) return;
    const [x1, y1, x2, y2] = m.slice(1).map(Number);
    if (x2 >= COLS || y2 >= ROWS) return;
    const neighbor = (x1 === x2 && y2 === y1 + 1) || (y1 === y2 && x2 === x1 + 1);
    if (!neighbor) return;
    const seg = { type: v.type };
    if (v.type === 'switch') seg.switchOpen = v.switchOpen !== false;
    if (v.type === 'battery' && v.flipped === true) seg.flipped = true;
    out.set(key, seg);
  });
  return out;
}

function loadState() {
  const saved = store.load();
  state.missionsCompleted = saved.missionsCompleted;
  state.segments = cleanSegments(saved.lastCircuit);
}

/* 공유 링크 읽기(예전 #share=<URI-JSON> 링크도 읽음). 받은 회로는 cleanSegments로 다시 검사 */
function parseShareLink() {
  const payload = SimKit.share.read({ version: 1 });
  if (payload && payload.circuit) {
    state.segments = cleanSegments(payload.circuit);
    state.mode = 1;
  }
}

/* ── 공용 조각: 화면·피드백·모드 탭·미션 컨트롤러 ── */
const screens = SimKit.screens({ focus: true });
const fb = SimKit.feedback('#feedbackBox', { html: true, classes: { ok: 'ok', no: 'no' } });
let modeTabs = null;
let mc = null;

/* ══════════════════════════════════════
   모드 / 미션 화면 전환 및 셋업
   ══════════════════════════════════════ */
function switchMode(modeNum) {
  const prevMode = state.mode;
  state.mode = parseInt(modeNum) || 1;

  // 탭 활성화(표시만)
  if (modeTabs) modeTabs.select(state.mode, { silent: true });
  if (prevMode === 2 && state.mode !== 2 && mc) mc.stop();

  const missionCard = $('#missionCard');
  const paletteSection = $('#paletteSection');
  const canvasBadgeNum = $('#canvasBadgeNum');
  const canvasBadgeLabel = $('#canvasBadgeLabel');

  missionCard.style.display = 'none';
  paletteSection.style.display = 'flex';
  $('#predictionBox').style.display = 'none';

  if (state.mode === 1) {
    canvasBadgeNum.textContent = '🛠️';
    canvasBadgeLabel.textContent = '자유 실험';
  } else if (state.mode === 2) {
    canvasBadgeNum.textContent = '🏆';
    canvasBadgeLabel.textContent = '도전 미션';
    missionCard.style.display = 'block';
    mc.start(state.missionIdx); // 번호 그리기 → onEnter(setupMissionUI)
  }

  selectTool('select');
  solveCircuit();
  hideFeedback();
}

/* 미션 준비: SimKit 미션 컨트롤러의 onEnter에서만 부른다(번호 그리기·문구 숨김은 컨트롤러가 함).
   성공 처리에서 다시 부르면 미션 6 회로가 합선 상태로 되돌아가므로 부르지 말 것. */
function setupMissionUI() {
  const m = MISSIONS[state.missionIdx];

  $('#missionDesc').innerHTML = m.desc;

  // 특정 미션 예측 박스 표시
  const predBox = $('#predictionBox');
  predBox.style.display = 'none';
  if (m.predQ) {
    predBox.style.display = 'block';
    $('#predTitle').textContent = m.predQ;
    // 예측 선택 버튼 리셋
    $$('.pred-btn').forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
  }

  // 미션 6 (합선) 선택 시 합선된 회로를 꼬마선 형태로 자동 구성해줘서 오개념 안전체험 유도
  if (m.id === 'm6') {
    state.segments.clear();
    // 전지 하나 배치하고 전선으로 바로 합선시킴
    state.segments.set("1,1-2,1", { type: 'battery' });
    state.segments.set("1,1-1,2", { type: 'wire' });
    state.segments.set("2,1-2,2", { type: 'wire' });
    state.segments.set("1,2-2,2", { type: 'wire' }); // 닫힌 무전구 회로
  }

  solveCircuit();
  updateVerifyButtonText();
}

function updateVerifyButtonText() {
  const allMissionsDone = MISSION_IDS.every(id => state.missionsCompleted[id] === true);
  $('#btnNextScreen').style.display = allMissionsDone ? 'block' : 'none';
}

/* ══════════════════════════════════════
   부품 및 도구 선택 제어
   ══════════════════════════════════════ */
function selectTool(toolName) {
  state.activeTool = toolName;
  $$('.tool-btn[data-tool]').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.tool === toolName);
    btn.setAttribute('aria-pressed', btn.dataset.tool === toolName ? 'true' : 'false');
  });

  // 팔레트 부품 비활성화
  $$('.palette-item').forEach(item => {
    item.classList.remove('active');
    item.setAttribute('aria-pressed', 'false');
  });
  state.selectedPaletteComponent = null;
}

function selectPaletteComponent(compName, buttonEl) {
  state.activeTool = 'place';
  state.selectedPaletteComponent = compName;
  
  $$('.tool-btn[data-tool]').forEach(btn => { btn.classList.remove('active'); btn.setAttribute('aria-pressed', 'false'); });
  $$('.palette-item').forEach(item => {
    item.classList.toggle('active', item.dataset.comp === compName);
    item.setAttribute('aria-pressed', item.dataset.comp === compName ? 'true' : 'false');
  });
}

/* ══════════════════════════════════════
   회로판 렌더링 & 클릭 인터랙션
   ══════════════════════════════════════ */
function drawBoard() {
  const svg = $('#canvasSvg');
  // 다시 그려도 키보드 초점이 같은 칸에 남도록
  const focusedKey = document.activeElement && document.activeElement.getAttribute && document.activeElement.getAttribute('data-key');
  svg.innerHTML = '';

  // 1. 격자 꼬마 가이드선 (사용자가 클릭해 부품이나 전선을 배치할 수 있는 세그먼트들)
  // 모든 가로 세그먼트들 렌더링
  for (let y = 0; y < ROWS; y++) {
    for (let x = 0; x < COLS - 1; x++) {
      const key = `${x},${y}-${x+1},${y}`;
      drawSegmentLine(svg, key, nodeCoords(x, y), nodeCoords(x+1, y));
    }
  }

  // 모든 세로 세그먼트들 렌더링
  for (let x = 0; x < COLS; x++) {
    for (let y = 0; y < ROWS - 1; y++) {
      const key = `${x},${y}-${x},${y+1}`;
      drawSegmentLine(svg, key, nodeCoords(x, y), nodeCoords(x, y+1));
    }
  }

  // 2. 격자 노드점 (단자들) 렌더링
  for (let y = 0; y < ROWS; y++) {
    for (let x = 0; x < COLS; x++) {
      const pos = nodeCoords(x, y);
      const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      circle.setAttribute('cx', pos.x);
      circle.setAttribute('cy', pos.y);
      circle.setAttribute('r', '6');
      circle.setAttribute('fill', 'var(--cc-grid-dot)');
      circle.setAttribute('aria-hidden', 'true');
      svg.appendChild(circle);
    }
  }
  if (focusedKey) {
    const again = svg.querySelector(`[data-key="${focusedKey}"]`);
    if (again) again.focus({ preventScroll: true });
  }
}

/* 칸 이름(화면 읽기용): 가로 2줄 3번째 칸: 전구(켜짐) */
function segmentLabel(key) {
  const [a, b] = key.split('-');
  const [x1, y1] = a.split(',').map(Number);
  const [x2] = b.split(',').map(Number);
  const where = x1 !== x2 ? `가로 ${y1 + 1}줄 ${x1 + 1}번째 칸` : `세로 ${x1 + 1}줄 ${y1 + 1}번째 칸`;
  const seg = state.segments.get(key);
  let what = '비어 있음';
  if (seg) {
    if (seg.type === 'wire') what = '전선';
    else if (seg.type === 'battery') what = '전지, (+)극 ' + (x1 !== x2 ? (seg.flipped ? '왼쪽' : '오른쪽') : (seg.flipped ? '위쪽' : '아래쪽'));
    else if (seg.type === 'bulb') what = '전구 ' + (state.litBulbs.has(key) ? '켜짐' : '꺼짐');
    else if (seg.type === 'switch') what = '스위치 ' + (seg.switchOpen ? '열림' : '닫힘');
  }
  return `${where}: ${what}`;
}

// 개별 회로선 및 부품 그리기
function drawSegmentLine(svg, key, pos1, pos2) {
  const seg = state.segments.get(key);
  const group = document.createElementNS('http://www.w3.org/2000/svg', 'g');
  group.style.cursor = 'pointer';
  group.setAttribute('class', 'seg');
  group.setAttribute('data-key', key);
  group.setAttribute('tabindex', '0');
  group.setAttribute('role', 'button');
  group.setAttribute('aria-label', segmentLabel(key));

  // 클릭하여 도구에 맞게 칠하기/지우기/스위치작동
  group.addEventListener('click', (e) => {
    e.stopPropagation();
    handleSegmentClick(key);
  });
  // 키보드: Enter/Space = 누르기
  group.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      handleSegmentClick(key);
    }
  });

  const midX = (pos1.x + pos2.x) / 2;
  const midY = (pos1.y + pos2.y) / 2;

  // 가로 방향인지 확인
  const isHorizontal = pos1.y === pos2.y;

  // 세로 방향일 경우 가로 그리기 결과를 90도 회전시켜 재사용.
  // 전지는 기본이 (+)극 오른쪽/아래쪽, 뒤집으면(flipped) 180도 돌려 (+)극이 왼쪽/위쪽
  const rot = (isHorizontal ? 0 : 90) + (seg && seg.type === 'battery' && seg.flipped ? 180 : 0);
  if (rot) {
    group.setAttribute('transform', `rotate(${rot}, ${midX}, ${midY})`);
  }

  // 가로 기준 로컬 좌표계 설정 (L = 노드 간 실제 거리)
  const L = Math.hypot(pos2.x - pos1.x, pos2.y - pos1.y);
  const lx1 = midX - L / 2;
  const lx2 = midX + L / 2;
  const ly = midY;

  // 키보드 초점 테두리(보일 때만 색이 생김)
  const ring = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
  ring.setAttribute('class', 'seg-focus');
  ring.setAttribute('x', lx1 + 6); ring.setAttribute('y', ly - 18);
  ring.setAttribute('width', L - 12); ring.setAttribute('height', 36);
  ring.setAttribute('rx', 8);
  group.appendChild(ring);

  // 1. Defs에 전구 글로우 그라디언트 주입
  if (!svg.querySelector('#bulb-glow-grad')) {
    let defs = svg.querySelector('defs');
    if (!defs) {
      defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
      svg.insertBefore(defs, svg.firstChild);
    }
    const grad = document.createElementNS('http://www.w3.org/2000/svg', 'radialGradient');
    grad.setAttribute('id', 'bulb-glow-grad');
    grad.innerHTML = `
      <stop offset="0%" stop-color="#ffd166" stop-opacity="1"/>
      <stop offset="35%" stop-color="#ffd166" stop-opacity="0.85"/>
      <stop offset="70%" stop-color="#ff9f43" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#ff9f43" stop-opacity="0"/>
    `;
    defs.appendChild(grad);
  }

  if (!seg) {
    // 빈 영역: 연한 클릭 가이드 점선
    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    line.setAttribute('x1', lx1);
    line.setAttribute('y1', ly);
    line.setAttribute('x2', lx2);
    line.setAttribute('y2', ly);
    line.setAttribute('stroke', 'rgba(255,255,255,0.06)');
    if (document.documentElement.dataset.theme === 'light') {
      line.setAttribute('stroke', 'rgba(0,0,0,0.05)');
    }
    line.setAttribute('stroke-width', '14'); // 클릭 타깃 두껍게
    line.setAttribute('stroke-dasharray', '4 4');
    group.appendChild(line);
  } else if (seg.type === 'wire') {
    // 전선
    const isLit = isWireEnergized(key);
    
    // 외곽 야간 글로우 효과
    const glow = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    glow.setAttribute('x1', lx1);
    glow.setAttribute('y1', ly);
    glow.setAttribute('x2', lx2);
    glow.setAttribute('y2', ly);
    glow.setAttribute('stroke', isLit ? 'var(--cc-wire-on-glow)' : 'var(--cc-wire-glow)');
    glow.setAttribute('stroke-width', '10');
    group.appendChild(glow);

    // 실제 선
    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    line.setAttribute('x1', lx1);
    line.setAttribute('y1', ly);
    line.setAttribute('x2', lx2);
    line.setAttribute('y2', ly);
    line.setAttribute('stroke', isLit ? 'var(--cc-wire-on)' : 'var(--cc-wire)');
    line.setAttribute('stroke-width', '4');
    group.appendChild(line);

    // 전류 흐름 애니메이션 점선 추가
    if (isLit && !state.hasShortCircuit) {
      const flow = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      flow.setAttribute('x1', lx1);
      flow.setAttribute('y1', ly);
      flow.setAttribute('x2', lx2);
      flow.setAttribute('y2', ly);
      flow.setAttribute('stroke', '#fff');
      flow.setAttribute('stroke-width', '4');
      flow.setAttribute('stroke-dasharray', '6 12');
      // 움직임 줄이기 설정이면 흐름 점선을 멈춘 채로 보여 준다(전선 색으로 통전 표시는 그대로)
      if (!reduceMotion) flow.innerHTML = `<animate attributeName="stroke-dashoffset" values="36;0" dur="1.2s" repeatCount="indefinite" />`;
      group.appendChild(flow);
    }

  } else if (seg.type === 'battery') {
    // 전지 🔋 (+: 오른쪽, -: 왼쪽)
    const isLit = isWireEnergized(key);

    // 1. 리드선 연결선
    const w1 = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    w1.setAttribute('x1', lx1); w1.setAttribute('y1', ly);
    w1.setAttribute('x2', midX - 22); w1.setAttribute('y2', ly);
    w1.setAttribute('stroke', isLit ? 'var(--cc-wire-on)' : 'var(--cc-wire)');
    w1.setAttribute('stroke-width', '3');
    group.appendChild(w1);

    const w2 = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    w2.setAttribute('x1', midX + 22); w2.setAttribute('y1', ly);
    w2.setAttribute('x2', lx2); w2.setAttribute('y2', ly);
    w2.setAttribute('stroke', isLit ? 'var(--cc-wire-on)' : 'var(--cc-wire)');
    w2.setAttribute('stroke-width', '3');
    group.appendChild(w2);

    // 2. 전지 본체 (음극: 어두운 회색, 양극: 빨간색)
    const bodyNeg = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
    bodyNeg.setAttribute('x', midX - 22);
    bodyNeg.setAttribute('y', midY - 12);
    bodyNeg.setAttribute('width', 22);
    bodyNeg.setAttribute('height', 24);
    bodyNeg.setAttribute('rx', '2');
    bodyNeg.setAttribute('fill', '#34495e');
    bodyNeg.setAttribute('stroke', isLit ? 'var(--cc-wire-on)' : 'var(--cc-wire)');
    bodyNeg.setAttribute('stroke-width', '1.5');
    group.appendChild(bodyNeg);

    const bodyPos = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
    bodyPos.setAttribute('x', midX);
    bodyPos.setAttribute('y', midY - 12);
    bodyPos.setAttribute('width', 22);
    bodyPos.setAttribute('height', 24);
    bodyPos.setAttribute('rx', '2');
    bodyPos.setAttribute('fill', '#e74c3c');
    bodyPos.setAttribute('stroke', isLit ? 'var(--cc-wire-on)' : 'var(--cc-wire)');
    bodyPos.setAttribute('stroke-width', '1.5');
    group.appendChild(bodyPos);

    // 양극 금속 캡
    const cap = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
    cap.setAttribute('x', midX + 22);
    cap.setAttribute('y', midY - 5);
    cap.setAttribute('width', 3);
    cap.setAttribute('height', 10);
    cap.setAttribute('rx', '1');
    cap.setAttribute('fill', '#bdc3c7');
    group.appendChild(cap);

    // 극 표시 기호 (+, -)
    const labelNeg = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    labelNeg.setAttribute('x', midX - 11);
    labelNeg.setAttribute('y', midY + 4);
    labelNeg.setAttribute('fill', '#fff');
    labelNeg.setAttribute('font-size', '12px');
    labelNeg.setAttribute('font-weight', 'bold');
    labelNeg.setAttribute('text-anchor', 'middle');
    labelNeg.textContent = '-';
    group.appendChild(labelNeg);

    const labelPos = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    labelPos.setAttribute('x', midX + 11);
    labelPos.setAttribute('y', midY + 4);
    labelPos.setAttribute('fill', '#fff');
    labelPos.setAttribute('font-size', '12px');
    labelPos.setAttribute('font-weight', 'bold');
    labelPos.setAttribute('text-anchor', 'middle');
    labelPos.textContent = '+';
    group.appendChild(labelPos);

  } else if (seg.type === 'bulb') {
    // 전구 💡
    const isLit = state.litBulbs.has(key);

    // 점등 시 광량 그라디언트 글로우 효과 (전구마다 실제 흐르는 전류에 따라 밝기 다름)
    if (isLit) {
      const glow = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      glow.setAttribute('cx', midX);
      glow.setAttribute('cy', midY);
      const level = state.bulbLevels.get(key) || state.bulbBrightness;
      const r = level === 3 ? 55 : level === 1 ? 25 : 40;
      glow.setAttribute('r', r);
      glow.setAttribute('fill', 'url(#bulb-glow-grad)');
      group.appendChild(glow);
    }

    // 1. 리드선 연결선
    const w1 = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    w1.setAttribute('x1', lx1); w1.setAttribute('y1', ly);
    w1.setAttribute('x2', midX - 16); w1.setAttribute('y2', ly);
    w1.setAttribute('stroke', isLit ? 'var(--cc-wire-on)' : 'var(--cc-wire)');
    w1.setAttribute('stroke-width', '3');
    group.appendChild(w1);

    const w2 = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    w2.setAttribute('x1', midX + 16); w2.setAttribute('y1', ly);
    w2.setAttribute('x2', lx2); w2.setAttribute('y2', ly);
    w2.setAttribute('stroke', isLit ? 'var(--cc-wire-on)' : 'var(--cc-wire)');
    w2.setAttribute('stroke-width', '3');
    group.appendChild(w2);

    // 2. 소켓 베이스
    const socket = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    socket.setAttribute('cx', midX);
    socket.setAttribute('cy', midY);
    socket.setAttribute('r', '16');
    socket.setAttribute('fill', '#7f8c8d');
    socket.setAttribute('stroke', '#555');
    socket.setAttribute('stroke-width', '1');
    group.appendChild(socket);

    // 3. 유리구
    const bulb = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    bulb.setAttribute('cx', midX);
    bulb.setAttribute('cy', midY - 2);
    bulb.setAttribute('r', '12');
    bulb.setAttribute('fill', isLit ? '#ffd166' : '#bdc3c7');
    bulb.setAttribute('stroke', '#fff');
    bulb.setAttribute('stroke-width', '1.5');
    group.appendChild(bulb);

    // 4. 필라멘트 (M 모양 전선 표현)
    const filament = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    filament.setAttribute('d', `M ${midX - 4} ${midY + 4} L ${midX - 2} ${midY - 1} Q ${midX} ${midY - 4} ${midX + 2} ${midY - 1} L ${midX + 4} ${midY + 4}`);
    filament.setAttribute('fill', 'none');
    filament.setAttribute('stroke', isLit ? '#ffffff' : '#7f8c8d');
    filament.setAttribute('stroke-width', '1.5');
    group.appendChild(filament);

  } else if (seg.type === 'switch') {
    // 스위치 🎚️
    const isLit = isWireEnergized(key);
    const isOpen = seg.switchOpen;

    // 1. 리드선 연결선
    const w1 = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    w1.setAttribute('x1', lx1); w1.setAttribute('y1', ly);
    w1.setAttribute('x2', midX - 20); w1.setAttribute('y2', ly);
    w1.setAttribute('stroke', isLit ? 'var(--cc-wire-on)' : 'var(--cc-wire)');
    w1.setAttribute('stroke-width', '3');
    group.appendChild(w1);

    const w2 = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    w2.setAttribute('x1', midX + 20); w2.setAttribute('y1', ly);
    w2.setAttribute('x2', lx2); w2.setAttribute('y2', ly);
    w2.setAttribute('stroke', isLit ? 'var(--cc-wire-on)' : 'var(--cc-wire)');
    w2.setAttribute('stroke-width', '3');
    group.appendChild(w2);

    // 2. 스위치 베이스 플레이트
    const baseRect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
    baseRect.setAttribute('x', midX - 20);
    baseRect.setAttribute('y', midY - 6);
    baseRect.setAttribute('width', 40);
    baseRect.setAttribute('height', 12);
    baseRect.setAttribute('rx', '2');
    baseRect.setAttribute('fill', '#95a5a6');
    baseRect.setAttribute('stroke', '#7f8c8d');
    baseRect.setAttribute('stroke-width', '1');
    group.appendChild(baseRect);

    // 3. 양쪽 터미널 접점
    const c1 = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    c1.setAttribute('cx', midX - 12); c1.setAttribute('cy', ly); c1.setAttribute('r', '3.5');
    c1.setAttribute('fill', '#d35400');
    group.appendChild(c1);

    const c2 = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    c2.setAttribute('cx', midX + 12); c2.setAttribute('cy', ly); c2.setAttribute('r', '3.5');
    c2.setAttribute('fill', '#d35400');
    group.appendChild(c2);

    // 4. 스위치 나이프 레버
    const lever = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    if (isOpen) {
      // 대각선으로 열린 모양
      lever.setAttribute('x1', midX - 12); lever.setAttribute('y1', ly);
      lever.setAttribute('x2', midX + 8); lever.setAttribute('y2', ly - 14);
    } else {
      // 수평으로 닫힌 모양
      lever.setAttribute('x1', midX - 12); lever.setAttribute('y1', ly);
      lever.setAttribute('x2', midX + 12); lever.setAttribute('y2', ly);
    }
    lever.setAttribute('stroke', '#34495e');
    lever.setAttribute('stroke-width', '4');
    lever.setAttribute('stroke-linecap', 'round');
    group.appendChild(lever);
  }

  svg.appendChild(group);
}


// 전선 통전 여부 판별 (전선 양쪽 노드가 불이 켜진 닫힌 회로에 포함되어 있는지 확인)
function isWireEnergized(key) {
  const [p1, p2] = key.split('-');
  return state.activeRawNodes && state.activeRawNodes.has(p1) && state.activeRawNodes.has(p2);
}

/* ══════════════════════════════════════
   회로 클릭 처리 (부품 배치/지우기/스위치 탭)
   ══════════════════════════════════════ */
function handleSegmentClick(key) {
  if (state.activeTool === 'eraser') {
    state.segments.delete(key);
    solveCircuit();
    saveState();
  } else if (state.activeTool === 'place' && state.selectedPaletteComponent) {
    const comp = state.selectedPaletteComponent;
    if (comp === 'switch') {
      state.segments.set(key, { type: 'switch', switchOpen: true });
    } else {
      state.segments.set(key, { type: comp });
    }
    solveCircuit();
    saveState();
  } else if (state.activeTool === 'wire') {
    state.segments.set(key, { type: 'wire' });
    solveCircuit();
    saveState();
  } else if (state.activeTool === 'select') {
    // 스위치인 경우 탭하여 껐다 켰다 작동
    const seg = state.segments.get(key);
    if (seg && seg.type === 'switch') {
      seg.switchOpen = !seg.switchOpen;
      solveCircuit();
      saveState();
    } else if (seg && seg.type === 'battery') {
      // 전지를 누르면 (+)극·(-)극 방향을 바꾼다
      seg.flipped = !seg.flipped;
      solveCircuit();
      saveState();
    }
  }
}

/* ══════════════════════════════════════
   회로 해석 알고리즘 (그래프 위상 및 닫힌 루프 판정)
   ══════════════════════════════════════ */
function solveCircuit() {
  state.litBulbs.clear();
  state.hasShortCircuit = false;
  state.circuitType = 'unknown';
  state.bulbBrightness = 2;
  state.bulbLevels = new Map();
  state.activeRawNodes = new Set();
  state.activeElectricNodes = new Set();

  // 1. union-find를 이용해 전선 및 닫힌 스위치로 연결된 노드 병합
  const parent = {};
  function find(i) {
    if (!parent[i]) parent[i] = i;
    if (parent[i] === i) return i;
    return parent[i] = find(parent[i]);
  }
  function union(i, j) {
    const rootI = find(i);
    const rootJ = find(j);
    if (rootI !== rootJ) {
      parent[rootI] = rootJ;
    }
  }

  // 전선 및 닫힌 스위치 결합
  state.segments.forEach((seg, key) => {
    const [p1, p2] = key.split('-');
    if (seg.type === 'wire' || (seg.type === 'switch' && !seg.switchOpen)) {
      union(p1, p2);
    }
  });

  // 2. 단락(합선) 여부 및 부품 단자 맵 정리
  // 전지(battery) 단자 양끝이 같은 전위 노드에 속하면 배터리 쇼트
  const activeBatteries = [];
  const activeBulbs = [];

  state.segments.forEach((seg, key) => {
    const [p1, p2] = key.split('-');
    if (seg.type === 'battery') {
      if (find(p1) === find(p2)) {
        state.hasShortCircuit = true; // 전지 합선 발생!
      } else {
        // 기본: (+)극이 p2(오른쪽/아래), flipped면 p1
        const pos = seg.flipped ? find(p1) : find(p2);
        const neg = seg.flipped ? find(p2) : find(p1);
        activeBatteries.push({ key, u: find(p1), v: find(p2), pos, neg });
      }
    } else if (seg.type === 'bulb') {
      if (find(p1) !== find(p2)) {
        activeBulbs.push({ key, u: find(p1), v: find(p2) });
      }
    }
  });


  // 3. 축약 그래프 인접 리스트 생성
  const adj = {};
  function addEdge(u, v, isBulb, key) {
    if (!adj[u]) adj[u] = [];
    adj[u].push({ to: v, isBulb, key });
    if (!adj[v]) adj[v] = [];
    adj[v].push({ to: u, isBulb, key });
  }

  activeBatteries.forEach(b => addEdge(b.u, b.v, false, b.key));
  activeBulbs.forEach(b => addEdge(b.u, b.v, true, b.key));

  // 4. 전구별 전류 계산 (전지의 (+)/(-) 방향을 반영한 마디 전압 해석)
  //    예전에는 "전지가 있는 닫힌 길"만 찾아 극 방향을 무시했기 때문에
  //    서로 반대로 놓은 전지 2개도 '직렬·밝음'으로 판정됐다.
  const circuit = solveNodal(activeBatteries, activeBulbs);
  activeBulbs.forEach(bulb => {
    const ratio = circuit.bulbRatio.get(bulb.key) || 0;
    if (ratio > 0.2) {
      state.litBulbs.add(bulb.key);
      state.bulbLevels.set(bulb.key, ratio >= 1.5 ? 3 : ratio <= 0.7 ? 1 : 2);
    }
  });
  if (circuit.batteryOverload) state.hasShortCircuit = true; // 전지끼리 맞물려 큰 전류가 흐르는 경우

  // 합선 위험 배너 토글
  $('#shortCircuitBanner').style.display = state.hasShortCircuit ? 'block' : 'none';

  // 5. 전력을 공급받는 활성 전기 노드(activeElectricNodes) 및 격자 원 노드(activeRawNodes) 탐색
  if (state.litBulbs.size > 0 && !state.hasShortCircuit) {
    activeBatteries.forEach(bat => {
      const path = [];
      const visited = new Set();
      function findPaths(curr, hasLitBulb) {
        if (curr === bat.v) {
          if (hasLitBulb) {
            path.forEach(n => state.activeElectricNodes.add(n));
            state.activeElectricNodes.add(bat.u);
            state.activeElectricNodes.add(bat.v);
          }
          return;
        }
        visited.add(curr);
        path.push(curr);
        const neighbors = adj[curr] || [];
        neighbors.forEach(edge => {
          if (!visited.has(edge.to)) {
            const isLit = edge.isBulb && state.litBulbs.has(edge.key);
            findPaths(edge.to, hasLitBulb || isLit);
          }
        });
        path.pop();
        visited.delete(curr);
      }
      findPaths(bat.u, false);
    });

    // 활성화된 격자 노드 문자열 모으기
    for (let y = 0; y < ROWS; y++) {
      for (let x = 0; x < COLS; x++) {
        const nodeStr = `${x},${y}`;
        if (state.activeElectricNodes.has(find(nodeStr))) {
          state.activeRawNodes.add(nodeStr);
        }
      }
    }
  }

  // 6. 표준형 분류 및 상대 밝기 연출
  if (state.litBulbs.size > 0 && !state.hasShortCircuit) {
    const M = activeBatteries.length;
    const N = state.litBulbs.size;
    const levels = [...state.bulbLevels.values()];
    const maxLevel = levels.length ? Math.max(...levels) : 2;

    // 회로가 심플한 단일 폐회로(루프)인지 판정
    const isSingleLoop = checkSingleLoop(activeBatteries, activeBulbs);

    if (isSingleLoop) {
      if (M === 1 && N === 1) {
        state.circuitType = 'base';
        state.bulbBrightness = 2; // 보통
      } else if (M === 1 && N > 1) {
        state.circuitType = 'series_bulb';
        state.bulbBrightness = 1; // 전구 직렬: 어두움
      } else if (M > 1 && N === 1 && maxLevel === 3) {
        // 전지 직렬: 모든 전지가 같은 방향일 때만 밝아진다
        state.circuitType = 'series_battery';
        state.bulbBrightness = 3; // 전지 직렬: 밝음
      } else {
        state.bulbBrightness = maxLevel;
      }
    } else {
      // 병렬 여부 검사: 모든 불 켜진 전구가 동일한 전지 전위단 사이에 1:1로 직접 묶여있는 경우
      const isParallel = checkParallel(activeBatteries, activeBulbs);
      if (isParallel) {
        state.circuitType = 'parallel_bulb';
        state.bulbBrightness = 2; // 보통
      } else {
        state.bulbBrightness = maxLevel;
      }
    }
  }

  // 캔버스 다시 그리기
  drawBoard();
  announceCircuit();
}

/* 회로 상태가 바뀌면 화면 읽기 프로그램에 한 번 알림 */
let lastCircuitMsg = '';
function announceCircuit() {
  const el = $('#circuitStatus');
  if (!el) return;
  let msg;
  if (state.hasShortCircuit) msg = '합선 발생! 회로를 고쳐야 해요.';
  else if (state.litBulbs.size > 0) msg = `전구 ${state.litBulbs.size}개가 켜졌어요. 밝기: ${state.bulbBrightness === 3 ? '밝음' : state.bulbBrightness === 1 ? '어두움' : '보통'}.`;
  else msg = '전구가 꺼져 있어요.';
  if (msg !== lastCircuitMsg) { lastCircuitMsg = msg; el.textContent = msg; }
}

/* 마디 전압 해석: 전지 = 1.5V + 작은 내부저항, 전구 = 같은 저항.
   반환값 bulbRatio: 전구 전류 ÷ (전지 1개·전구 1개 회로의 전류). 1이면 기본 밝기 */
function solveNodal(batteries, bulbs) {
  const E = 1.5, R_BULB = 10, R_INT = 0.2;
  const I0 = E / (R_BULB + R_INT);
  const result = { bulbRatio: new Map(), batteryOverload: false };
  const index = new Map();
  const idx = n => { if (!index.has(n)) index.set(n, index.size); return index.get(n); };
  batteries.forEach(b => { idx(b.pos); idx(b.neg); });
  bulbs.forEach(b => { idx(b.u); idx(b.v); });
  const n = index.size;
  if (n === 0 || batteries.length === 0) return result;

  const G = Array.from({ length: n }, () => new Array(n).fill(0));
  const I = new Array(n).fill(0);
  const addG = (a, b, g) => { G[a][a] += g; G[b][b] += g; G[a][b] -= g; G[b][a] -= g; };
  batteries.forEach(b => {
    const pi = idx(b.pos), ni = idx(b.neg);
    addG(pi, ni, 1 / R_INT);           // 노턴 등가: 내부저항 ∥ 전류원
    I[pi] += E / R_INT;
    I[ni] -= E / R_INT;
  });
  bulbs.forEach(b => addG(idx(b.u), idx(b.v), 1 / R_BULB));
  for (let i = 0; i < n; i++) G[i][i] += 1e-9; // 떠 있는 마디가 있어도 풀리도록 아주 작은 누설

  // 가우스 소거 (부분 피벗)
  for (let c = 0; c < n; c++) {
    let piv = c;
    for (let r = c + 1; r < n; r++) if (Math.abs(G[r][c]) > Math.abs(G[piv][c])) piv = r;
    if (Math.abs(G[piv][c]) < 1e-15) continue;
    [G[c], G[piv]] = [G[piv], G[c]];
    [I[c], I[piv]] = [I[piv], I[c]];
    for (let r = 0; r < n; r++) {
      if (r === c) continue;
      const f = G[r][c] / G[c][c];
      if (f === 0) continue;
      for (let k = c; k < n; k++) G[r][k] -= f * G[c][k];
      I[r] -= f * I[c];
    }
  }
  const V = I.map((val, i) => (Math.abs(G[i][i]) < 1e-15 ? 0 : val / G[i][i]));

  bulbs.forEach(b => {
    const cur = Math.abs(V[idx(b.u)] - V[idx(b.v)]) / R_BULB;
    result.bulbRatio.set(b.key, cur / I0);
  });
  batteries.forEach(b => {
    const cur = Math.abs(E - (V[idx(b.pos)] - V[idx(b.neg)])) / R_INT;
    if (cur > 3) result.batteryOverload = true; // 정상 회로의 20배 이상
  });
  return result;
}

// 단일 루프 폐쇄 검사 (모든 노드의 차수가 정확히 2)
function checkSingleLoop(batteries, bulbs) {
  const litBulbs = bulbs.filter(b => state.litBulbs.has(b.key));
  const activeComps = [...batteries, ...litBulbs];
  
  const degree = {};
  activeComps.forEach(c => {
    degree[c.u] = (degree[c.u] || 0) + 1;
    degree[c.v] = (degree[c.v] || 0) + 1;
  });

  const nodes = Object.keys(degree);
  if (nodes.length === 0) return false;
  return nodes.every(n => degree[n] === 2);
}

// 병렬 연결 여부 검사
function checkParallel(batteries, bulbs) {
  if (batteries.length !== 1) return false;
  const bat = batteries[0];
  const litBulbs = bulbs.filter(b => state.litBulbs.has(b.key));
  if (litBulbs.length < 2) return false;

  // 모든 litBulb가 전지의 u와 v 노드를 잇고 있는지 확인
  return litBulbs.every(b => {
    return (b.u === bat.u && b.v === bat.v) || (b.u === bat.v && b.v === bat.u);
  });
}

/* ══════════════════════════════════════
   피드백 알림 및 미션 검증
   ══════════════════════════════════════ */
/* 문구는 앱이 직접 쓴 고정 문구만(html). 표시·aria-live는 SimKit.feedback */
function showFeedback(text, type = 'ok') { fb.show(type, text); }
function hideFeedback() { fb.hide(); }

function verifyCurrentMission() {
  const m = MISSIONS[state.missionIdx];
  if (state.mode === 1) {
    // 자유 탐험 평가
    if (state.hasShortCircuit) {
      showFeedback('❌ 합선 위험! 전선이 전구 없이 직접 연결되었습니다. 전선 위치를 변경하세요.', 'no');
    } else if (state.litBulbs.size > 0) {
      const typeStr = state.circuitType === 'series_bulb' ? '전구 직렬연결' :
                      state.circuitType === 'parallel_bulb' ? '전구 병렬연결' :
                      state.circuitType === 'series_battery' ? '전지 직렬연결' :
                      state.circuitType === 'base' ? '기본 회로(전지 1개·전구 1개)' : '여러 부품이 섞인 회로';
      showFeedback(`🎉 닫힌 회로 완성! 현재 <strong>${typeStr}</strong> 상태입니다. 전구 밝기는 <strong>${state.bulbBrightness === 3 ? '밝음 🌟' : state.bulbBrightness === 1 ? '어두움 💡' : '보통'}</strong>입니다.`, 'ok');
    } else {
      showFeedback('💡 전구에 불이 켜지지 않았어요. 전지의 (+)극 → 전구 → (-)극이 끊김 없이 이어지도록 다시 이어 보세요. 전지가 2개라면 (+)극 방향이 서로 같은지도 확인해요(전지를 누르면 방향이 바뀌어요).', 'no');
    }
  } else if (state.mode === 2) {
    // 도전 미션 검증
    const isOk = m.verify(state);
    if (isOk) {
      // 완료 기록·번호 갱신·저장은 컨트롤러가(onChange). setupMissionUI는 부르지 않음(미션 6 회로 되돌림 방지)
      const next = MISSIONS.findIndex((ms, i) => i !== state.missionIdx && !mc.isDone(i));
      const tail = next === -1 ? ' 미션을 모두 마쳤어요! 아래 [탐험 완료] 버튼을 눌러 보세요.' : ` 위의 ${next + 1}번 버튼을 눌러 다음 미션에 도전해 보세요.`;
      mc.complete({ message: '🎉 미션 성공! 회로를 올바르게 만들었어요.' + tail });
    } else {
      if (m.id === 'm1') {
        mc.fail('❌ 아직 불이 들어오지 않았습니다. 전구 양쪽 단자에 전선의 두 극이 끊김 없이 연결되도록 전선을 배치하세요.');
      } else if (m.id === 'm2') {
        mc.fail('❌ 스위치를 추가해 닫힌 회로를 만드세요. 스위치를 탭하여 흐름이 켜지는지 확인해야 합니다.');
      } else if (m.id === 'm3') {
        mc.fail('❌ 전구 2개가 하나의 루프(직렬)로 이어져 있는지, 그리고 떼어냈을 때 둘 다 꺼질 것이라는 예측(꺼질 것이다)을 골랐는지 확인하세요.');
      } else if (m.id === 'm4') {
        mc.fail('❌ 전구 2개가 갈래길(병렬)로 연결되어 각각 불이 들어오는지, 그리고 예측(켜질 것이다)을 선택했는지 다시 확인해 보세요.');
      } else if (m.id === 'm5') {
        mc.fail('❌ 전지 2개를 한 줄(직렬)로 이어 전구 1개에 연결해 보세요. 두 전지의 (+)극이 같은 방향을 향해야 해요. 전지를 누르면 방향이 바뀌어요.');
      } else if (m.id === 'm6') {
        mc.fail('❌ 합선 위험 경고등을 해제하고, 전구를 포함한 닫힌 회로를 다시 구성해 불을 켜 보세요.');
      }
    }
  }
}

function showResultScreen() {
  showScreen('screenResult');
  SimKit.stars.render('#resultStars', SimKit.stars.grade(mc.doneCount(), [1, 4, 6]));
  let summary = `<strong>회로 공작 완료 보고서</strong><br><br>`;
  summary += `① 닫힌 회로 전구 켜기: ${state.missionsCompleted.m1 ? '완료 ✓' : '미완료'}<br>`;
  summary += `② 스위치 배선 제어: ${state.missionsCompleted.m2 ? '완료 ✓' : '미완료'}<br>`;
  summary += `③ 전구 직렬(어두워짐): ${state.missionsCompleted.m3 ? '완료 ✓' : '미완료'}<br>`;
  summary += `④ 전구 병렬(밝기 유지): ${state.missionsCompleted.m4 ? '완료 ✓' : '미완료'}<br>`;
  summary += `⑤ 전지 직렬(더 밝아짐): ${state.missionsCompleted.m5 ? '완료 ✓' : '미완료'}<br>`;
  summary += `⑥ 합선 안전 조치 완료: ${state.missionsCompleted.m6 ? '완료 ✓' : '미완료'}<br><br>`;
  summary += `전기가 전선을 따라 흐르려면 전지의 두 극이 <strong>끊김 없이 이어져야</strong> 해요. 또한 회로를 안전하게 연결하고 조작하는 힘을 배웠습니다!`;

  $('#resultSummary').innerHTML = summary;
}

/* ── 화면 전환 ── */
function showScreen(id) {
  if (id !== 'screenExplore' && mc) mc.stop();
  screens.show(id);
}

/* ══════════════════════════════════════
   초기화 및 이벤트 바인딩
   ══════════════════════════════════════ */
function init() {
  loadState();
  parseShareLink();

  // 미션 컨트롤러: 번호 버튼(44px)·이동·문구·완료 기록. 성공해도 자동 이동 없음(지금 동작 유지)
  mc = SimKit.missions({
    ids: MISSION_IDS,
    format: 'flags',
    progress: state.missionsCompleted,
    nav: '#missionNav',
    feedback: fb,
    onEnter: (i) => { state.missionIdx = i; setupMissionUI(); },
    onChange: (p) => { state.missionsCompleted = p; saveState(); updateVerifyButtonText(); }
  });

  // 시작 버튼
  $('#btnStart').addEventListener('click', () => {
    showScreen('screenExplore');
    switchMode(1);
  });

  // 탭 클릭
  modeTabs = SimKit.tabs('.mode-tab', { attr: 'mode', initial: '1', onSelect: (v) => switchMode(v) });

  // 툴바 툴 선택
  $$('.tool-btn[data-tool]').forEach(btn => {
    btn.addEventListener('click', () => {
      selectTool(btn.dataset.tool);
    });
  });

  // 부품 팔레트 선택
  $$('.palette-item').forEach(item => {
    item.addEventListener('click', () => {
      selectPaletteComponent(item.dataset.comp, item);
    });
  });

  // 회로 초기화
  $('#btnClearCanvas').addEventListener('click', () => {
    if (confirm('회로판을 처음 상태로 완전히 비울까요?')) {
      state.segments.clear();
      solveCircuit();
      saveState();
      SimKit.toast('회로판을 비웠어요.');
    }
  });

  // 정답 검사
  $('#btnVerify').addEventListener('click', verifyCurrentMission);

  // 결과 화면 이동
  $('#btnNextScreen').addEventListener('click', showResultScreen);

  // 결과 화면 액션
  $('#btnRetry').addEventListener('click', () => {
    mc.reset(); // onChange → missionsCompleted 초기화·저장
    state.missionIdx = 0;
    state.segments.clear();
    saveState();
    showScreen('screenExplore');
    switchMode(1);
  });
  $('#btnBackToHub').addEventListener('click', () => {
    showScreen('screenExplore');
    switchMode(1);
  });

  // 예측 선택 버튼
  $$('.pred-btn').forEach(b => {
    b.setAttribute('aria-pressed', 'false');
    b.addEventListener('click', () => {
      $$('.pred-btn').forEach(btn => { btn.classList.remove('active'); btn.setAttribute('aria-pressed', 'false'); });
      b.classList.add('active');
      b.setAttribute('aria-pressed', 'true');
    });
  });

  // 셸 공유 버튼 → 내 회로 링크(기기 공유 → 복사/링크 창). 받는 쪽은 parseShareLink + cleanSegments
  SimKit.share.bind(() => (state.segments.size ? { v: 1, circuit: segmentsObj() } : null), {
    title: '전기회로 공작소 — 내가 만든 전기 회로',
    emptyMessage: '회로판에 부품을 놓은 다음 공유해 보세요.'
  });
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}

})();
</script>



</AppLayout>
