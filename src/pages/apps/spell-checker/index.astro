---
import AppLayout from '../../../layouts/AppLayout.astro';
import Icon from '../../../components/Icon.astro';
---
<AppLayout
  title="AI 맞춤법 검사 (Spell Checker) — eduin VIVES"
  description="AI가 한국어 맞춤법·문법을 교정하고 수정 이유를 설명합니다. 구글 시트에서도 여러 칸을 한 번에 고칠 수 있습니다."
  image="https://eduin.info/og-images/spell-checker.png"
  bodyShell="column"
  bodyWidth="medium"
>
  <Fragment slot="head">
    <style is:global="">
    body::before {
      content: '';
      position: fixed; inset: 0;
      background-image:
        linear-gradient(rgba(0,111,238,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,111,238,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none; z-index: 0;
    }

    textarea {
      width: 100%;
      min-height: 160px;
      padding: 14px;
      border: 1.5px solid var(--border);
      border-radius: 10px;
      background: var(--bg);
      color: var(--fg);
      font-size: 15px;
      line-height: 1.7;
      resize: vertical;
      outline: none;
      transition: border-color .2s;
      font-family: inherit;
    }
    textarea:focus { border-color: var(--primary); }
    /* iOS는 16px 미만 입력칸에서 화면을 확대하므로 휴대폰·태블릿에서는 16px */
    @media (max-width: 720px), (pointer: coarse) { textarea { font-size: 16px; } }

    .input-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 8px;
    }
    .char-count { font-size: 13px; color: var(--fg-muted); }
    .char-count.warn { color: color-mix(in srgb, var(--warning, #f5a524) 70%, var(--fg)); }

    .btn {
      min-height: 44px;
      padding: 9px 22px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: opacity .15s, border-color .15s, color .15s;
      font-family: inherit;
      display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    }
    .btn-primary { background: var(--primary); color: #fff; border: none; }
    .btn-primary:hover { opacity: .85; }
    .btn-primary:disabled { opacity: .45; cursor: not-allowed; }
    .btn-ghost { background: transparent; border: 1.5px solid var(--border); color: var(--fg-muted); }
    .btn-ghost:hover { border-color: var(--primary); color: var(--primary); }

    .status-row {
      display: none;
      align-items: center;
      gap: 8px;
      margin-top: 16px;
      font-size: 14px;
      color: var(--fg-muted);
    }
    .status-row.show { display: flex; }
    .spinner {
      width: 16px; height: 16px;
      border: 2px solid var(--border);
      border-top-color: var(--primary);
      border-radius: 50%;
      animation: spin .7s linear infinite;
      flex-shrink: 0;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .alert { display: none; margin-top: 14px; padding: 12px 14px; border-radius: 8px; font-size: 14px; }
    .alert.show { display: block; }
    .alert-error {
      background: color-mix(in srgb, var(--danger) 12%, transparent);
      color: color-mix(in srgb, var(--danger) 70%, var(--fg));
      border: 1px solid color-mix(in srgb, var(--danger) 35%, transparent);
    }
    .alert-error .ic { vertical-align: -0.15em; margin-right: 4px; }

    .result-panel { display: none; margin-top: 28px; animation: fadeIn .2s ease; }
    .result-panel.show { display: block; }
    @keyframes fadeIn { from { opacity:0; transform:translateY(5px); } to { opacity:1; transform:none; } }

    .result-meta { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
    .pill { font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 99px; }
    /* 색은 공용 토큰(--success/--danger)에 글자색을 섞어 밝게·어둡게 모두 읽히게 */
    .pill-ok  { background: color-mix(in srgb, var(--success) 16%, transparent); color: color-mix(in srgb, var(--success) 55%, var(--fg)); }
    .pill-err { background: color-mix(in srgb, var(--danger) 14%, transparent); color: color-mix(in srgb, var(--danger) 70%, var(--fg)); }
    .result-note { font-size: 13px; color: var(--fg-muted); }

    .corrected-box {
      padding: 14px;
      border: 1.5px solid var(--border);
      border-radius: 10px;
      background: var(--card-bg, var(--bg));
      font-size: 15px;
      line-height: 1.8;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .corrected-box mark {
      background: color-mix(in srgb, var(--warning, #f5a524) 30%, transparent); color: var(--fg);
      border-radius: 3px; padding: 0 2px;
      text-decoration: underline wavy var(--warning, #f5a524);
    }

    .btn-row { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 8px; }

    .error-list { margin-top: 20px; }
    .error-list-title { font-size: 12px; font-weight: 700; color: var(--fg-muted); margin-bottom: 8px; letter-spacing: .03em; }
    .error-item {
      display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline;
      padding: 9px 12px; border-radius: 8px;
      border: 1px solid var(--border); background: var(--card-bg, var(--bg));
      margin-bottom: 6px; font-size: 13px;
    }
    .err-before { color: color-mix(in srgb, var(--danger) 75%, var(--fg)); text-decoration: line-through; font-weight: 500; }
    .err-arrow  { color: var(--fg-muted); align-self: center; display: inline-flex; }
    .err-after  { color: color-mix(in srgb, var(--success) 55%, var(--fg)); font-weight: 600; }
    .err-reason { color: var(--fg-muted); font-size: 12px; flex: 1; min-width: 100px; }

    .gas-panel {
      margin-top: 32px; padding: 16px;
      border: 1.5px dashed var(--border); border-radius: 10px;
    }
    .gas-panel[hidden] { display: none; }
    .gas-panel-title { font-size: 13px; font-weight: 600; color: var(--fg-muted); margin: 0 0 6px; }
    .gas-panel-desc { font-size: 13px; color: var(--fg-muted); line-height: 1.6; margin: 0 0 12px; }
    .gas-code {
      padding: 12px 14px;
      background: var(--bg); border: 1px solid var(--border); border-radius: 8px;
      font-family: "JetBrains Mono", "Fira Code", "Consolas", monospace;
      font-size: 12px; color: var(--fg);
      white-space: pre; overflow-x: auto;
    }
  </style>
  <script type="application/ld+json" is:inline="">{"@context":"https://schema.org","@type":"WebApplication","name":"AI 맞춤법 검사 (Spell Checker)","description":"AI가 한국어 맞춤법·문법을 교정하고 수정 이유를 설명합니다. 구글 시트에서도 여러 칸을 한 번에 고칠 수 있습니다.","url":"https://eduin.info/apps/spell-checker/","applicationCategory":"EducationApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"KRW"},"isPartOf":{"@type":"WebSite","name":"eduin VIVES","url":"https://eduin.info"}}</script>
  </Fragment>


  <!-- 플로팅 크롬(홈·테마·공유)은 app-shell.js가 주입합니다 -->
  <main class="app-main">
    <div class="app-header">
      <div class="app-badge">AI</div>
      <h1 class="app-title">AI 맞춤법 검사 <span class="app-title-en">Spell Checker</span></h1>
      <p class="app-desc">AI가 한국어 맞춤법·문법을 교정하고 수정 이유를 설명합니다.</p>
    </div>

    <label for="inputText" class="visually-hidden">교정할 텍스트</label>
    <textarea id="inputText" placeholder="교정할 텍스트를 입력하세요 (최대 3000자)…" maxlength="3000" aria-describedby="charCount"></textarea>
    <div class="input-footer">
      <span class="char-count" id="charCount">0 / 3,000</span>
      <button type="button" class="btn btn-primary" id="checkBtn" onclick="runCheck()">검사하기</button>
    </div>

    <div class="status-row" id="loadingRow" role="status" aria-live="polite">
      <span class="spinner" aria-hidden="true"></span><span id="loadingText"></span>
    </div>
    <div class="alert alert-error" id="errorAlert" role="alert"></div>

    <div class="result-panel" id="resultPanel" aria-labelledby="resultPill">
      <div class="result-meta" role="status" aria-live="polite">
        <span class="pill" id="resultPill"></span>
        <span class="result-note" id="resultNote"></span>
      </div>
      <div class="corrected-box" id="correctedBox"></div>
      <div class="btn-row">
        <button type="button" class="btn btn-ghost" id="copyBtn" onclick="copyResult(this)"><Icon name="copy" /> 교정본 복사</button>
        <button type="button" class="btn btn-ghost" id="gasBtn" onclick="toggleGas()" aria-expanded="false" aria-controls="gasPanel"><Icon name="sheet" /> 구글 시트에서 쓰기</button>
      </div>
      <div class="error-list" id="errorList"></div>
    </div>

    <div class="gas-panel" id="gasPanel" hidden="">
      <p class="gas-panel-title">구글 시트에서 쓰기</p>
      <p class="gas-panel-desc">구글 시트의 <b>확장 프로그램 › Apps Script</b>에 아래 코드를 붙여넣고, 고칠 칸을 선택한 뒤 <b>correctSelection</b>을 실행하세요. 빈 칸은 건너뛰고, 한 칸씩 1초 간격으로 검사합니다.</p>
      <div class="gas-code" id="gasCode"></div>
    </div>
  </main>

  <script is:inline="">
    const API_URL = '/api/spell-check';

    const inputText   = document.getElementById('inputText');
    const charCount   = document.getElementById('charCount');
    const checkBtn    = document.getElementById('checkBtn');
    const loadingRow  = document.getElementById('loadingRow');
    const errorAlert  = document.getElementById('errorAlert');
    const resultPanel = document.getElementById('resultPanel');
    const resultPill  = document.getElementById('resultPill');
    const resultNote  = document.getElementById('resultNote');
    const correctedBox= document.getElementById('correctedBox');
    const errorList   = document.getElementById('errorList');
    const gasPanel    = document.getElementById('gasPanel');

    // 쓰던 글은 이 탭(sessionStorage)에 임시 저장 — 새로고침해도 사라지지 않게
    const DRAFT_KEY = 'spell-checker:draft';
    function updateCount() {
      const n = inputText.value.length;
      charCount.textContent = `${n.toLocaleString()} / 3,000`;
      charCount.classList.toggle('warn', n > 2500);
    }
    try {
      const draft = sessionStorage.getItem(DRAFT_KEY);
      if (draft && !inputText.value) { inputText.value = draft.slice(0, 3000); updateCount(); }
    } catch { /* 저장소를 쓸 수 없음 — 임시 저장만 안 됨 */ }
    let draftTimer = null;
    inputText.addEventListener('input', () => {
      updateCount();
      clearTimeout(draftTimer);
      draftTimer = setTimeout(() => {
        try {
          if (inputText.value) sessionStorage.setItem(DRAFT_KEY, inputText.value);
          else sessionStorage.removeItem(DRAFT_KEY);
        } catch { /* 저장 불가 — 무시 */ }
      }, 400);
    });

    async function runCheck() {
      const text = inputText.value.trim();
      if (!text) { inputText.focus(); VUI.toast('교정할 텍스트를 먼저 입력해 주세요.'); return; }
      checkBtn.disabled = true;
      loadingRow.classList.add('show');
      document.getElementById('loadingText').textContent = 'AI가 교정 중입니다…';
      errorAlert.classList.remove('show');
      errorAlert.textContent = '';
      resultPanel.classList.remove('show');
      gasPanel.hidden = true;
      document.getElementById('gasBtn').setAttribute('aria-expanded', 'false');
      try {
        let data;
        try {
          data = await VUI.apiFetch(API_URL, { json: { text }, timeout: 45000 });
        } catch (e) {
          // 400(글자 수 등)은 이 앱에 맞는 안내로, 나머지(시간 초과·429·5xx·오프라인)는 공용 한국어 문구
          throw new Error(e.status === 400 ? koError(e.serverMessage, 400) : e.message);
        }
        // 응답 형식 검사 — 형식이 다르면 영문 런타임 오류 대신 한국어 안내
        if (!data || typeof data.corrected !== 'string') {
          throw new Error('검사 결과를 읽지 못했습니다. 잠시 후 다시 시도해 주세요.');
        }
        const errors = (Array.isArray(data.errors) ? data.errors : [])
          .filter(e => e && typeof e === 'object')
          .map(e => ({ original: String(e.original ?? ''), corrected: String(e.corrected ?? ''), reason: String(e.reason ?? '') }));
        renderResult({ corrected: data.corrected, changed: !!data.changed || errors.length > 0, errors });
      } catch (e) {
        const msg = e && /[가-힣]/.test(e.message || '') ? e.message
          : '검사 중 문제가 생겼습니다. 인터넷 연결을 확인하고 다시 시도해 주세요.';
        errorAlert.innerHTML = VUI.icon('triangle-alert') + esc(msg);
        errorAlert.classList.add('show');
      } finally {
        checkBtn.disabled = false;
        loadingRow.classList.remove('show');
        document.getElementById('loadingText').textContent = '';
      }
    }

    // 서버 오류 메시지가 영문이면 상태 코드별 한국어 안내로 바꾼다
    function koError(msg, status) {
      if (msg && /[가-힣]/.test(msg)) return msg;
      if (status === 429) return '요청이 너무 많습니다. 잠시 후 다시 시도해 주세요.';
      if (status === 400) return '입력 내용을 확인해 주세요. (최대 3000자)';
      return `AI 교정 중 오류가 발생했습니다. 잠시 후 다시 시도해 주세요. (오류 ${status})`;
    }

    function renderResult({ corrected, changed, errors }) {
      if (changed) {
        resultPill.textContent = `${errors.length}건 교정`;
        resultPill.className = 'pill pill-err';
        resultNote.textContent = '교정된 내용이 있습니다.';
      } else {
        resultPill.textContent = '이상 없음';
        resultPill.className = 'pill pill-ok';
        resultNote.textContent = '오류를 발견하지 못했습니다.';
      }
      correctedBox.innerHTML = highlight(corrected, errors);
      errorList.innerHTML = errors.length
        ? `<p class="error-list-title">교정 내역 (${errors.length}건)</p>` +
          errors.map(e => `<div class="error-item">
            <span class="err-before">${esc(e.original)}</span>
            <span class="err-arrow" aria-label="고친 말">${VUI.icon('arrow-right')}</span>
            <span class="err-after">${esc(e.corrected)}</span>
            <span class="err-reason">${esc(e.reason)}</span>
          </div>`).join('')
        : '';
      resultPanel.classList.add('show');
    }

    // 고친 말을 교정 내역 순서대로 찾는다 — 앞에서 찾은 위치 다음부터 찾아야 "의", "되"처럼
    // 흔한 말이 엉뚱한 곳(첫 번째 등장 위치)에 표시되지 않는다.
    function highlight(text, errors) {
      const ranges = [];
      const overlaps = (a, b) => ranges.some(([s, e]) => a < e && b > s);
      let pos = 0;
      errors.forEach(({ corrected: c }) => {
        if (!c) return;
        let idx = text.indexOf(c, pos);
        while (idx !== -1 && overlaps(idx, idx + c.length)) idx = text.indexOf(c, idx + 1);
        if (idx !== -1) { pos = idx + c.length; }
        else {
          // 순서가 어긋난 경우: 앞쪽에서 아직 표시하지 않은 자리를 찾는다
          idx = text.indexOf(c);
          while (idx !== -1 && overlaps(idx, idx + c.length)) idx = text.indexOf(c, idx + 1);
          if (idx === -1) return;
        }
        ranges.push([idx, idx + c.length]);
      });
      ranges.sort((a, b) => a[0] - b[0]);
      let html = '', last = 0;
      ranges.forEach(([s, e]) => {
        html += esc(text.slice(last, s)) + `<mark>${esc(text.slice(s, e))}</mark>`;
        last = e;
      });
      return html + esc(text.slice(last));
    }

    function esc(s) {
      return String(s)
        .replace(/&/g,'&amp;').replace(/</g,'&lt;')
        .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // 버튼은 클릭 시점에 인자로 받는다(Promise 콜백 안에서는 window.event가 비어 있어 표시가 안 뜨던 문제)
    // 복사는 공용 VUI.copy(클립보드 → execCommand 순서로 시도, 성공 시 토스트)
    let copyTimer = null;
    async function copyResult(btn) {
      const text = correctedBox.innerText;
      const ok = await VUI.copy(text, '교정본을 복사했어요');
      if (!ok) {
        VUI.toast('자동 복사가 안 돼요. 교정본을 길게 눌러 직접 복사해 주세요.', 'error');
        const r = document.createRange(); r.selectNodeContents(correctedBox);
        const sel = getSelection(); sel.removeAllRanges(); sel.addRange(r);
        return;
      }
      if (!btn) return;
      btn.innerHTML = VUI.icon('check') + ' 복사됨';
      clearTimeout(copyTimer);
      copyTimer = setTimeout(() => { btn.innerHTML = VUI.icon('copy') + ' 교정본 복사'; }, 1500);
    }

    function toggleGas() {
      gasPanel.hidden = !gasPanel.hidden;
      document.getElementById('gasBtn').setAttribute('aria-expanded', String(!gasPanel.hidden));
    }

    document.getElementById('gasCode').textContent =
`// POST /api/spell-check  →  { original, corrected, changed, errors }
function spellCheck(text) {
  const res = UrlFetchApp.fetch('https://eduin.info/api/spell-check', {
    method: 'POST',
    contentType: 'application/json',
    payload: JSON.stringify({ text }),
    muteHttpExceptions: true,
  });
  const data = JSON.parse(res.getContentText());
  if (data.error) throw new Error(data.error);
  return data;
}

// 선택한 칸을 한 칸씩 교정 (빈 칸·숫자 칸은 건너뜀)
function correctSelection() {
  const range = SpreadsheetApp.getActiveRange();
  const values = range.getValues();
  let first = true;
  for (let r = 0; r < values.length; r++) {
    for (let c = 0; c < values[r].length; c++) {
      const cell = values[r][c];
      if (typeof cell !== 'string' || !cell.trim()) continue;
      if (!first) Utilities.sleep(1000);   // 요청이 몰리지 않게 1초씩 쉬기
      first = false;
      const { changed, corrected } = spellCheck(cell);
      if (changed) range.getCell(r + 1, c + 1).setValue(corrected);
    }
  }
}`;
  </script>



</AppLayout>
