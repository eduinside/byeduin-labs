    <div id="cb-canvas" aria-label="보드: 텍스트는 두 번 누르거나 길게 눌러 고치고, 끌어서 옮겨요">
      <svg id="cb-svg" xmlns="http://www.w3.org/2000/svg"></svg>
    </div>
  </div>

  <!-- 컨텍스트 메뉴 -->
  <div id="cb-ctx">
    <div class="ctx-row" id="ctx-main"></div>
    <div class="ctx-row" id="ctx-colors" style="display:none"></div>
  </div>


  <!-- 공유 링크 모달 -->
  <div id="modal-share" class="modal-bg">
    <div class="modal-box">
      <h2 class="modal-title">공유된 칠판</h2>
      <p id="modal-share-name" class="modal-share-name"></p>
      <p style="font-size:13px;color:var(--fg-muted);margin-bottom:1.2rem;text-align:center">이 칠판을 어떻게 열겠습니까?</p>
      <div class="modal-actions">
        <button class="btn-cancel" onclick="enterViewOnly()">👁 보기 전용</button>
        <button class="btn-confirm" onclick="cloneAndOpen()">복제하기</button>
      </div>
    </div>
  </div>

  <!-- 새 보드 모달 -->
  <div id="modal-new" class="modal-bg">
    <div class="modal-box">
      <h2 class="modal-title">새 보드 만들기</h2>
      <input type="text" id="new-board-name" class="modal-input" placeholder="보드 이름 (선택)" aria-label="보드 이름 (선택)" maxlength="30">
      <div class="modal-type-row">
        <button class="type-btn sel" id="opt-chalk" aria-pressed="true" onclick="selectNewType('chalkboard')">🟩 칠판</button>
        <button class="type-btn" id="opt-white" aria-pressed="false" onclick="selectNewType('whiteboard')">⬜ 화이트보드</button>
      </div>
      <div class="modal-actions">
        <button class="btn-cancel" onclick="closeNewModal()">취소</button>
        <button class="btn-confirm" onclick="createBoard()">만들기</button>
      </div>
    </div>
  </div>

  <script is:inline="">
    /* ══════════════════════════════════════════
       Chalkboard App — complete rewrite
    ══════════════════════════════════════════ */

    const SK = 'vives-chalkboard';
    const SIZES = [32, 48, 64, 80, 96, 120, 160, 200];

    // 보드 타입별 스타일
    const BS = {
      chalkboard: {
        bg: '#1a3323', tb: '#122418',
        border: 'rgba(255,255,255,0.07)',
        btnColor: 'rgba(255,255,255,0.8)',
        nameColor: '#c8ddd0',
        ctxBg: 'rgba(8,18,12,0.88)',
        ctxBorder: 'rgba(255,255,255,0.1)',
        ctxShadow: '0 4px 20px rgba(0,0,0,0.55)',
        tempStroke: 'rgba(255,255,255,0.45)',
        selBorder: 'rgba(255,255,255,0.35)',
        saveDdBg: 'rgba(12,26,18,0.96)',
        saveDdColor: 'rgba(255,255,255,0.85)', saveDdHover: 'rgba(255,255,255,0.1)',
      },
      whiteboard: {
        bg: '#f7f7f4', tb: '#ebebea',
        border: 'rgba(0,0,0,0.07)',
        btnColor: 'rgba(0,0,0,0.6)',
        nameColor: '#444',
        ctxBg: 'rgba(250,250,248,0.95)',
        ctxBorder: 'rgba(0,0,0,0.09)',
        saveDdBg: 'rgba(240,240,238,0.98)',
        saveDdColor: '#222', saveDdHover: 'rgba(0,0,0,0.07)',
        ctxShadow: '0 4px 20px rgba(0,0,0,0.12)',
        tempStroke: 'rgba(0,0,0,0.35)',
        selBorder: 'rgba(0,0,0,0.25)',
      },
    };

    // 4색 팔레트 — 기본색은 보드 타입에 따라 다름
    function getPalette(type) {
      return [type === 'whiteboard' ? '#111111' : '#ffffff', '#ffd60a', '#ff79c6', '#74d7ff'];
    }

    /* ── Data helpers ── */
    const getData = () => {
      try {
        const d = JSON.parse(localStorage.getItem(SK) || '{"boards":[]}');
        if (d && Array.isArray(d.boards)) return d;
      } catch (e) { console.warn('[chalkboard] 저장 데이터를 읽지 못했어요:', e); }
      return { boards: [] };
    };
    const saveData = d => {
      try { localStorage.setItem(SK, JSON.stringify(d)); }
      catch (e) {
        console.warn('[chalkboard] 저장 실패:', e);
        if (typeof showToast === 'function') showToast('저장 공간이 부족해 저장하지 못했어요', 'error');
      }
    };
    const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
    function getBoard() {
      if (viewOnlyBoard) return viewOnlyBoard;
      return getData().boards.find(b => b.id === currentBoardId) || null;
    }
    function saveBoard(b) {
      if (viewOnlyBoard) return;
      const d = getData();
      const i = d.boards.findIndex(x => x.id === b.id);
      if (i >= 0) d.boards[i] = b; else d.boards.push(b);
      saveData(d);
      // 자동저장 펄스 효과
      const dot = document.getElementById('btn-autosave');
      if (dot) {
        dot.classList.add('flash');
        clearTimeout(dot._flashTimer);
        dot._flashTimer = setTimeout(() => dot.classList.remove('flash'), 600);
      }
    }
    function fmtDate(ts) {
      if (!ts) return '';
      return new Date(ts).toLocaleDateString('ko-KR', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    }
    function esc(s) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    /* ── State ── */
    let currentBoardId = null;
    let mode = 'select'; // 'select' | 'add-text' | 'draw-line'
    let selectedId = null;
    let selectedType = null; // 'text' | 'line'
    let colorRowOpen = false;
    let newBoardType = 'chalkboard';
    // 선 긋기 중 보이는 점선(임시 선)
    let tempLine = null;
    // undo history
    let undoStack = [];
    // copy-paste clipboard
    let clipboard = null;
    // view-only share mode
    let viewOnlyBoard = null;
    let _pendingShared = null;
    const UNDO_MAX = 50;

    function pushHistory() {
      const board = getBoard();
      if (!board) return;
      undoStack.push(JSON.parse(JSON.stringify(board.elements)));
      if (undoStack.length > UNDO_MAX) undoStack.shift();
    }

    function undoLast() {
      if (viewOnlyBoard) return;
      if (!undoStack.length) { showToast('더 이상 되돌릴 수 없습니다'); return; }
      const snapshot = undoStack.pop();
      const board = getBoard();
      if (!board) return;
      board.elements = snapshot;
      board.lastEdited = Date.now();
      saveBoard(board);
      deselectAll();
      renderAll();
      showToast('취소했습니다');
    }

    /* ── Views ── */
    function showView(name) {
      document.getElementById('view-home').classList.toggle('active', name === 'home');
      const vb = document.getElementById('view-board');
      if (name === 'board') {
        vb.classList.add('active');
        document.body.classList.add('in-board');
      } else {
        vb.classList.remove('active');
        document.body.classList.remove('in-board');
        document.body.classList.remove('board-white');
      }
    }

    /* ── Home ── */
    function renderHome() {
      const d = getData();
      const el = document.getElementById('board-list');
      if (!d.boards.length) {
        el.innerHTML = '<div class="empty-state"><div class="empty-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg></div><div class="empty-text">보드가 없습니다. 새 보드를 만들어 보세요.</div></div>';
        return;
      }
      el.innerHTML = d.boards.slice().reverse().map(b => {
        const type = (b.type && BS[b.type]) ? b.type : 'chalkboard';
        const s = BS[type];
        const texts = b.elements ? b.elements.filter(e => e.type === 'text') : [];
        const topLeftText = texts.slice().sort((a, b2) => a.y !== b2.y ? a.y - b2.y : a.x - b2.x)[0];
        const thumbContent = topLeftText
          ? `<span class="board-preview-text" style="color:${esc(topLeftText.color)}">${esc(topLeftText.text)}</span>`
          : `<span class="board-preview-text" style="opacity:0.4;color:${type === 'chalkboard' ? '#c8ddd0' : '#888'}">${esc(b.name)}</span>`;
        const typeLabel = type === 'chalkboard' ? '칠판' : '화이트보드';
        return `
        <div class="board-card">
          <div class="board-thumb" style="background:${s.bg}" aria-hidden="true">${thumbContent}</div>
          <div class="board-info-row">
            <div class="board-info">
              <button type="button" class="board-open" onclick="openBoard('${esc(b.id)}')">${esc(b.name)}</button>
              <div class="board-meta">${typeLabel} · ${fmtDate(b.lastEdited)} · 요소 ${(b.elements||[]).filter(e=>e.type).length}개</div>
            </div>
            <button class="board-del" onclick="deleteBoard(event,'${esc(b.id)}')" title="삭제" aria-label="${esc(b.name)} 삭제">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
              </svg>
            </button>
          </div>
        </div>`;
      }).join('');
    }

    /* ── New board modal ── */
    const newModal = VUI.modal.bind('#modal-new', { className: 'active', backdropClose: true, dialog: '#modal-new .modal-box', initialFocus: '#new-board-name' });
    function openNewModal() {
      newBoardType = 'chalkboard';
      document.getElementById('new-board-name').value = '';
      selectNewType('chalkboard');
      newModal.open();
    }
    function closeNewModal() { newModal.close(); }
    function selectNewType(t) {
      newBoardType = t;
      document.getElementById('opt-chalk').classList.toggle('sel', t === 'chalkboard');
      document.getElementById('opt-white').classList.toggle('sel', t === 'whiteboard');
      document.getElementById('opt-chalk').setAttribute('aria-pressed', String(t === 'chalkboard'));
      document.getElementById('opt-white').setAttribute('aria-pressed', String(t === 'whiteboard'));
    }
    function createBoard() {
      const nm = document.getElementById('new-board-name').value.trim() || (newBoardType === 'chalkboard' ? '새 칠판' : '새 화이트보드');
      const board = { id: uid(), name: nm, type: newBoardType, createdAt: Date.now(), lastEdited: Date.now(), elements: [] };
      const d = getData(); d.boards.push(board); saveData(d);
      closeNewModal();
      openBoard(board.id);
    }
    function deleteBoard(e, id) {
      e.stopPropagation();
      if (!confirm('이 보드를 삭제하시겠습니까?')) return;
      const d = getData(); d.boards = d.boards.filter(b => b.id !== id); saveData(d);
      renderHome();
    }

    /* ── Open board ── */
    function openBoard(id) {
      currentBoardId = id;
      undoStack = [];
      mode = 'select'; selectedId = null; selectedType = null;
      colorRowOpen = false;
      const board = getBoard();
      if (!board) { showView('home'); renderHome(); return; }
      if (!board.type || !BS[board.type]) board.type = 'chalkboard'; // 구형 데이터 보정
      showView('board');
      document.body.classList.toggle('is-view-only', !!viewOnlyBoard);
      applyBoardStyle(board);
      document.getElementById('tb-name').value = board.name;
      renderAll();
      updateTbState();
      hideCtx();
    }

    function goHome() {
      viewOnlyBoard = null;
      document.body.classList.remove('is-view-only');
      undoStack = [];
      cancelDraw();
      mode = 'select';
      showView('home');
      renderHome();
    }

    /* ── Board style ── */
    function applyBoardStyle(board) {
      const s = BS[board.type];
      const tb = document.getElementById('cb-tb');
      tb.style.background = s.tb;
      tb.style.borderBottomColor = s.border;
      document.getElementById('cb-canvas').style.background = s.bg;
      document.querySelectorAll('#cb-tb .tb-btn, #btn-back').forEach(b => {
        b.style.color = s.btnColor;
        b.style.borderColor = s.border;
      });
      document.getElementById('tb-name').style.color = s.nameColor;
      document.getElementById('btn-back').style.color = s.btnColor;
      document.getElementById('btn-back').style.borderColor = s.border;
      document.getElementById('type-label').textContent = board.type === 'chalkboard' ? '칠판' : '화이트보드';
      document.body.classList.toggle('board-white', board.type === 'whiteboard');
    }

    /* ── Board type switch ── */
    function switchBoardType() {
      if (viewOnlyBoard) return;
      const board = getBoard(); if (!board) return;
      const oldDef = getPalette(board.type)[0];
      const newType = board.type === 'chalkboard' ? 'whiteboard' : 'chalkboard';
      const newDef = getPalette(newType)[0];
      pushHistory();
      board.elements = board.elements.map(el => ({ ...el, color: el.color === oldDef ? newDef : el.color }));
      board.type = newType; board.lastEdited = Date.now();
      saveBoard(board);
      applyBoardStyle(board);
      renderAll(); hideCtx();
    }

    function renameCurrent(name) {
      if (viewOnlyBoard) return;
      const board = getBoard(); if (!board || !name.trim()) return;
      board.name = name.trim(); board.lastEdited = Date.now();
      saveBoard(board);
    }

    /* ── Render ── */
    function renderAll() { renderLines(); renderTexts(); }

    function renderLines() {
      const svg = document.getElementById('cb-svg');
      svg.querySelectorAll('.cb-line-g').forEach(g => g.remove());
      const board = getBoard(); if (!board) return;
      board.elements.filter(el => el.type === 'line').forEach(buildLineEl);
    }

    function buildLineEl(el) {
      const svg = document.getElementById('cb-svg');
      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      g.setAttribute('class', 'cb-line-g');
      g.dataset.id = el.id;

      // Selection glow
      if (selectedId === el.id) {
        const glow = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        ['x1','y1','x2','y2'].forEach(a => glow.setAttribute(a, el[a]));
        glow.setAttribute('stroke', 'rgba(255,255,255,0.3)');
        glow.setAttribute('stroke-width', '9');
        glow.setAttribute('stroke-linecap', 'round');
        g.appendChild(glow);
      }

      // Hit zone (transparent, wide)
      const hit = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      ['x1','y1','x2','y2'].forEach(a => hit.setAttribute(a, el[a]));
      hit.setAttribute('stroke', 'transparent');
      hit.setAttribute('stroke-width', '22');
      hit.setAttribute('stroke-linecap', 'round');
      hit.style.cursor = selectedId === el.id ? 'grab' : 'pointer';

      // Visible line
      const vis = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      ['x1','y1','x2','y2'].forEach(a => vis.setAttribute(a, el[a]));
      vis.setAttribute('stroke', el.color);
      vis.setAttribute('stroke-width', selectedId === el.id ? '5' : '3');
      vis.setAttribute('stroke-linecap', 'round');

      g.appendChild(hit);
      g.appendChild(vis);
      svg.appendChild(g);

      // 누르기·끌기·두 번 누르기는 캔버스의 포인터 처리(아래 'Pointer 입력')가 맡음
    }

    function renderTexts() {
      const canvas = document.getElementById('cb-canvas');
      canvas.querySelectorAll('.cb-el').forEach(d => d.remove());
      const board = getBoard(); if (!board) return;
      board.elements.filter(el => el.type === 'text').forEach(buildTextEl);
    }

    function buildTextEl(el) {
      const canvas = document.getElementById('cb-canvas');
      const div = document.createElement('div');
      div.className = 'cb-el' + (selectedId === el.id ? ' selected' : '');
      div.dataset.id = el.id;
      div.style.left = el.x + 'px';
      div.style.top = el.y + 'px';
      div.style.fontSize = el.size + 'px';
      div.style.color = el.color;
      if (selectedId === el.id) {
        const board = getBoard();
        div.style.borderColor = BS[board.type].selBorder;
      }
      div.textContent = el.text;
      // 키보드: Tab으로 고르고 Enter(F2)로 편집, Delete로 삭제(아래 전역 키 처리)
      div.tabIndex = 0;
      div.addEventListener('focus', () => {
        if (!gesture && !div.isContentEditable && selectedId !== el.id) selectEl(el.id, 'text');
      });
      div.addEventListener('keydown', e => {
        if (div.isContentEditable || viewOnlyBoard) return;
        if (e.key === 'Enter' || e.key === 'F2') { e.preventDefault(); selectEl(el.id, 'text'); startEdit(el.id); }
      });
      canvas.appendChild(div);
    }

    /* ── Selection ── */
    function selectEl(id, type) {
      selectedId = id; selectedType = type; colorRowOpen = false;
      document.querySelectorAll('.cb-el').forEach(d => {
        const sel = d.dataset.id === id;
        d.classList.toggle('selected', sel);
        if (sel) {
          const board = getBoard();
          d.style.borderColor = board ? BS[board.type].selBorder : 'rgba(255,255,255,0.35)';
        } else {
          d.style.borderColor = 'transparent';
        }
      });
      // Re-render lines to show selection glow
      renderLines();
      showCtx(id, type);
    }

    function deselectAll() {
      selectedId = null; selectedType = null; colorRowOpen = false;
      document.querySelectorAll('.cb-el').forEach(d => {
        d.classList.remove('selected');
        d.style.borderColor = 'transparent';
      });
      renderLines();
      hideCtx();
    }

    /* ── Context menu ── */
    function showCtx(id, type) {
      if (viewOnlyBoard) return;
      const board = getBoard();
      const el = board.elements.find(e => e.id === id);
      if (!el) return;
      const s = BS[board.type];
      const ctx = document.getElementById('cb-ctx');
      ctx.style.background = s.ctxBg;
      ctx.style.borderColor = s.ctxBorder;
      ctx.style.boxShadow = s.ctxShadow;

      const main = document.getElementById('ctx-main');
      const colRow = document.getElementById('ctx-colors');
      main.innerHTML = '';
      colRow.style.display = 'none';
      colRow.innerHTML = '';

      function mkBtn(html, title, cls, fn) {
        const b = document.createElement('button');
        b.className = 'ctx-btn' + (cls ? ' ' + cls : '');
        b.innerHTML = html;
        b.title = title;
        b.setAttribute('aria-label', title);
        b.onclick = e => { e.stopPropagation(); fn(e); };
        return b;
      }

      if (type === 'text') {
        main.appendChild(mkBtn('A⁻', '글자 작게', '', () => changeSize(id, -1)));
        main.appendChild(mkBtn('A⁺', '글자 크게', '', () => changeSize(id, 1)));
      }

      // Color button — dot colored with current element color
      const colBtn = mkBtn('●', '색상', '', () => toggleColorRow(id, type));
      colBtn.setAttribute('aria-expanded', 'false');
      colBtn.style.color = el.color;
      colBtn.style.fontSize = '18px';
      main.appendChild(colBtn);

      if (type === 'text') {
        main.appendChild(mkBtn(
          '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>',
          '편집', '', () => startEdit(id)));
      }

      main.appendChild(mkBtn(
        '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>',
        '삭제', 'ctx-del', () => deleteEl(id)));

      positionCtx(id, type);
      ctx.style.display = 'flex';
    }

    function toggleColorRow(id, type) {
      const colRow = document.getElementById('ctx-colors');
      colorRowOpen = !colorRowOpen;
      const colBtn = document.querySelector('#ctx-main .ctx-btn[title="색상"]');
      if (colBtn) colBtn.setAttribute('aria-expanded', String(colorRowOpen));
      if (!colorRowOpen) { colRow.style.display = 'none'; return; }

      const board = getBoard();
      const el = board.elements.find(e => e.id === id);
      const palette = getPalette(board.type);
      colRow.innerHTML = '';

      const COLOR_NAMES = ['기본색', '노랑', '분홍', '하늘'];
      palette.forEach((color, ci) => {
        const b = document.createElement('button');
        b.className = 'ctx-btn ctx-swatch' + (el.color === color ? ' cur' : '');
        b.dataset.color = color;
        b.setAttribute('aria-label', COLOR_NAMES[ci] || color);
        b.setAttribute('aria-pressed', String(el.color === color));
        b.style.cssText = `background:${color};width:40px;height:40px;border-radius:50%;font-size:0;`;
        // Light swatches need a visible border
        if (color === '#ffffff' || color === '#f7f7f4') b.style.border = '2px solid rgba(150,150,150,0.4)';
        else if (color === '#111111') b.style.border = '2px solid rgba(80,80,80,0.3)';
        b.onclick = e => { e.stopPropagation(); setElColor(id, color); };
        colRow.appendChild(b);
      });

      colRow.style.display = 'flex';
    }

    function positionCtx(id, type) {
      const ctx = document.getElementById('cb-ctx');
      let x, y;
      if (type === 'text') {
        const div = document.querySelector(`.cb-el[data-id="${id}"]`);
        if (!div) return;
        const r = div.getBoundingClientRect();
        x = r.left;
        y = r.top - 56;
        if (y < 60) y = r.bottom + 8;
      } else {
        const board = getBoard();
        const el = board.elements.find(e => e.id === id);
        if (!el) return;
        const cr = document.getElementById('cb-canvas').getBoundingClientRect();
        x = cr.left + (el.x1 + el.x2) / 2 - 40;
        y = cr.top + Math.min(el.y1, el.y2) - 56;
        if (y < 60) y = cr.top + Math.max(el.y1, el.y2) + 12;
      }
      x = Math.max(8, Math.min(x, window.innerWidth - 220));
      ctx.style.left = x + 'px';
      ctx.style.top = y + 'px';
    }

    function hideCtx() {
      document.getElementById('cb-ctx').style.display = 'none';
      colorRowOpen = false;
    }

    /* ── Element operations ── */
    function changeSize(id, delta) {
      const board = getBoard();
      const el = board.elements.find(e => e.id === id);
      if (!el || el.type !== 'text') return;
      let idx = SIZES.indexOf(el.size);
      if (idx < 0) idx = SIZES.findIndex(s => s >= el.size);
      if (idx < 0) idx = 3;
      idx = Math.max(0, Math.min(SIZES.length - 1, idx + delta));
      pushHistory();
      el.size = SIZES[idx];
      board.lastEdited = Date.now();
      saveBoard(board);
      const div = document.querySelector(`.cb-el[data-id="${id}"]`);
      if (div) div.style.fontSize = el.size + 'px';
      // Reposition ctx after size change
      setTimeout(() => positionCtx(id, 'text'), 0);
    }

    function setElColor(id, color) {
      const board = getBoard();
      const el = board.elements.find(e => e.id === id);
      if (!el) return;
      pushHistory();
      el.color = color;
      board.lastEdited = Date.now();
      saveBoard(board);
      if (el.type === 'text') {
        const div = document.querySelector(`.cb-el[data-id="${id}"]`);
        if (div) div.style.color = color;
      } else {
        renderLines();
      }
      // Update color dot and swatches
      // Update main color dot
      document.querySelectorAll('#ctx-main .ctx-btn').forEach(b => {
        if (b.title === '색상') { b.style.color = color; }
      });
      document.querySelectorAll('#ctx-colors .ctx-swatch').forEach(s => {
        s.classList.toggle('cur', s.dataset.color === color);
        s.setAttribute('aria-pressed', String(s.dataset.color === color));
      });
    }

    function deleteEl(id) {
      if (viewOnlyBoard) return;
      const board = getBoard();
      pushHistory();
      board.elements = board.elements.filter(e => e.id !== id);
      board.lastEdited = Date.now();
      saveBoard(board);
      renderAll(); deselectAll();
    }

    /* ── Text editing ── */
    function addText(x, y) {
      if (viewOnlyBoard) return;
      const board = getBoard();
      const el = { id: uid(), type: 'text', x, y, text: '텍스트', color: getPalette(board.type)[0], size: 80 };
      pushHistory();
      board.elements.push(el);
      board.lastEdited = Date.now();
      saveBoard(board);
      buildTextEl(el);
      selectEl(el.id, 'text');
      startEdit(el.id);
    }

    function startEdit(id) {
      hideCtx();
      const div = document.querySelector(`.cb-el[data-id="${id}"]`);
      if (!div) return;
      div.contentEditable = 'true';
      div.style.cursor = 'text';
      div.focus();
      const range = document.createRange();
      range.selectNodeContents(div);
      const sel = window.getSelection();
      sel.removeAllRanges(); sel.addRange(range);

      // 이전 편집에서 남은 핸들러가 있으면 정리
      if (div._editCleanup) div._editCleanup();
      const endFn = () => endEdit(id);
      // 편집이 끝날 때까지 모든 키 입력을 살핌 (한글 조합 중 Enter는 무시)
      const keyFn = e => {
        if (e.isComposing || e.keyCode === 229) return;
        if (e.key === 'Escape') { e.preventDefault(); endEdit(id); }
        else if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); endEdit(id); }
      };
      div.addEventListener('blur', endFn);
      div.addEventListener('keydown', keyFn);
      div._editCleanup = () => {
        div.removeEventListener('blur', endFn);
        div.removeEventListener('keydown', keyFn);
        div._editCleanup = null;
      };
    }

    function endEdit(id) {
      const div = document.querySelector(`.cb-el[data-id="${id}"]`);
      if (!div || div.contentEditable !== 'true') return;
      if (div._editCleanup) div._editCleanup();
      div.contentEditable = 'false';
      div.style.cursor = '';
      const board = getBoard();
      const el = board.elements.find(e => e.id === id);
      if (!el) return;
      const txt = div.innerText.trim();
      if (!txt) { deleteEl(id); return; }
      pushHistory();
      el.text = txt;
      board.lastEdited = Date.now();
      saveBoard(board);
      selectEl(id, 'text');
    }

    /* ── Toolbar modes ── */
    function activateTextMode() {
      mode = mode === 'add-text' ? 'select' : 'add-text';
      if (mode !== 'add-text') cancelDraw();
      updateTbState();
    }
    function activateDrawMode() {
      mode = mode === 'draw-line' ? 'select' : 'draw-line';
      if (mode === 'draw-line') deselectAll();
      else cancelDraw();
      updateTbState();
    }

    function updateTbState() {
      document.getElementById('btn-add-text').classList.toggle('on', mode === 'add-text');
      document.getElementById('btn-draw').classList.toggle('on', mode === 'draw-line');
      document.getElementById('btn-add-text').setAttribute('aria-pressed', String(mode === 'add-text'));
      document.getElementById('btn-draw').setAttribute('aria-pressed', String(mode === 'draw-line'));
      const canvas = document.getElementById('cb-canvas');
      canvas.className = mode === 'add-text' ? 'mode-text' : mode === 'draw-line' ? 'mode-line' : 'mode-select';
      // Visual active state on buttons
      const board = getBoard();
      const s = board ? BS[board.type] : null;
      const activeColor = board && board.type === 'whiteboard' ? 'rgba(0,0,0,0.12)' : 'rgba(255,255,255,0.15)';
      document.getElementById('btn-add-text').style.background = mode === 'add-text' ? activeColor : '';
      document.getElementById('btn-draw').style.background = mode === 'draw-line' ? activeColor : '';
    }

    /* ── Pointer 입력 (마우스·터치·펜 공통) ──
       전자칠판·태블릿에서도 똑같이 동작하도록 mouse* 대신 Pointer Events만 씀.
       - 한 번에 하나의 포인터만 따라감(pointerId). 긋는 중 들어온 두 번째 손가락은 무시
       - 캔버스에 setPointerCapture → 손가락이 요소 밖으로 나가도 끌기가 이어짐
       - 두 번 누르기 = 더블클릭(글자 편집, 선 메뉴), 길게 누르기(0.5초) = 터치용 오른쪽 클릭
       - 펜 압력은 쓰지 않음(선 굵기 일정) */
    const canvas = document.getElementById('cb-canvas');
    const LONG_PRESS_MS = 500;
    let gesture = null;  // 진행 중인 누르기 { pointerId, ptype, kind:'text'|'line'|'draw'|'bg', … }
    let lastTap = null;  // 두 번 누르기 판별 { id, t, x, y }

    function editingEl() {
      const a = document.activeElement;
      return a && a.classList && a.classList.contains('cb-el') && a.isContentEditable ? a : null;
    }
    function closeMenus() { closeMoreMenu(); closeSaveMenu(); closeShareMenu(); }
    function moveSlop(g) { return g.ptype === 'mouse' ? (g.kind === 'line' ? 4 : 5) : 8; }

    canvas.addEventListener('pointerdown', e => {
      // 편집 중인 글자 안: 커서 옮기기·글자 선택은 브라우저 기본 동작 그대로(화상 키보드도 유지)
      const ed = editingEl();
      if (ed && ed.contains(e.target)) return;
      if (gesture) {
        // 긋는·옮기는 중에 닿은 두 번째 손가락·손바닥은 무시
        if (e.pointerId !== gesture.pointerId) e.preventDefault();
        return;
      }
      if (!e.isPrimary || e.button !== 0) return;   // 오른쪽 버튼·펜 지우개 버튼은 contextmenu에서 처리
      closeMenus();
      const textDiv = e.target.closest('.cb-el');
      const lineG = e.target.closest('.cb-line-g');
      const textId = textDiv ? textDiv.dataset.id : null;
      const lineId = lineG ? lineG.dataset.id : null;
      // 터치 뒤 따라오는 mousedown(포커스 이동 → 편집 종료)과 글자 선택·길게 누르기 메뉴를 막음
      e.preventDefault();
      // 다른 곳을 누르면 편집을 마침(blur → endEdit). 이때 요소가 다시 그려질 수 있어 아래에서 id로 다시 찾음
      if (ed) ed.blur();
      const board = getBoard();
      if (!board) return;
      const r = canvas.getBoundingClientRect();
      const g = {
        pointerId: e.pointerId, ptype: e.pointerType || 'mouse',
        sx: e.clientX, sy: e.clientY, px: e.clientX - r.left, py: e.clientY - r.top,
        moved: false, longPress: false, timer: null,
      };
      const div = textId ? canvas.querySelector(`.cb-el[data-id="${textId}"]`) : null;
      const lineEl = lineId ? board.elements.find(x => x.id === lineId) : null;
      if (div) {
        g.kind = 'text'; g.id = textId; g.div = div;
        g.ox = parseInt(div.style.left) || 0; g.oy = parseInt(div.style.top) || 0;
        g.draggable = !viewOnlyBoard;
      } else if (mode === 'draw-line' && !viewOnlyBoard) {
        g.kind = 'draw';
        const svg = document.getElementById('cb-svg');
        if (tempLine) tempLine.remove();
        tempLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        tempLine.id = 'cb-temp-line';
        tempLine.setAttribute('x1', g.px); tempLine.setAttribute('y1', g.py);
        tempLine.setAttribute('x2', g.px); tempLine.setAttribute('y2', g.py);
        tempLine.setAttribute('stroke', BS[board.type].tempStroke);
        tempLine.setAttribute('stroke-width', '3');
        tempLine.setAttribute('stroke-linecap', 'round');
        tempLine.setAttribute('stroke-dasharray', '7 5');
        svg.appendChild(tempLine);
      } else if (lineEl && mode === 'select') {
        g.kind = 'line'; g.id = lineId;
        g.o = { x1: lineEl.x1, y1: lineEl.y1, x2: lineEl.x2, y2: lineEl.y2 };
        g.draggable = !viewOnlyBoard;
      } else {
        g.kind = 'bg';
      }
      // 길게 누르기(터치·펜): 0.5초 동안 거의 움직이지 않으면 선택해 보여 주고, 손을 떼면 편집/메뉴
      if ((g.kind === 'text' || g.kind === 'line') && g.ptype !== 'mouse' && !viewOnlyBoard) {
        g.timer = setTimeout(() => {
          if (gesture !== g || g.moved) return;
          g.longPress = true;
          selectEl(g.id, g.kind);
          if (navigator.vibrate) { try { navigator.vibrate(15); } catch (_) {} }
        }, LONG_PRESS_MS);
      }
      gesture = g;
      try { canvas.setPointerCapture(e.pointerId); } catch (_) {}
    });

    window.addEventListener('pointermove', e => {
      const g = gesture;
      if (!g || e.pointerId !== g.pointerId) return;
      const dx = e.clientX - g.sx, dy = e.clientY - g.sy;
      if (!g.moved && !g.longPress && (Math.abs(dx) > moveSlop(g) || Math.abs(dy) > moveSlop(g))) {
        g.moved = true;
        clearTimeout(g.timer);
        if (g.kind === 'text' || g.kind === 'line') hideCtx();
        if (g.kind === 'text' && g.draggable) g.div.classList.add('dragging');
      }
      if (g.kind === 'draw' && tempLine) {
        const r = canvas.getBoundingClientRect();
        tempLine.setAttribute('x2', e.clientX - r.left);
        tempLine.setAttribute('y2', e.clientY - r.top);
      } else if (g.moved && g.draggable && g.kind === 'text') {
        g.div.style.left = (g.ox + dx) + 'px';
        g.div.style.top = (g.oy + dy) + 'px';
      } else if (g.moved && g.draggable && g.kind === 'line') {
        const lg = document.querySelector(`#cb-svg .cb-line-g[data-id="${g.id}"]`);
        if (lg) lg.querySelectorAll('line').forEach(l => {
          l.setAttribute('x1', g.o.x1 + dx); l.setAttribute('y1', g.o.y1 + dy);
          l.setAttribute('x2', g.o.x2 + dx); l.setAttribute('y2', g.o.y2 + dy);
        });
      }
    });

    function endGesture(g) {
      clearTimeout(g.timer);
      if (gesture === g) gesture = null;
      try { if (canvas.hasPointerCapture(g.pointerId)) canvas.releasePointerCapture(g.pointerId); } catch (_) {}
      if (g.div) g.div.classList.remove('dragging');
    }

    window.addEventListener('pointerup', e => {
      const g = gesture;
      if (!g || e.pointerId !== g.pointerId) return;
      endGesture(g);
      const board = getBoard();
      if (!board) return;
      const dx = e.clientX - g.sx, dy = e.clientY - g.sy;
      if (g.kind === 'draw') {
        const r = canvas.getBoundingClientRect();
        const x2 = Math.max(0, Math.min(e.clientX - r.left, r.width));
        const y2 = Math.max(0, Math.min(e.clientY - r.top, r.height));
        if (tempLine) { tempLine.remove(); tempLine = null; }
        if (Math.hypot(x2 - g.px, y2 - g.py) < 8) return;
        const el = { id: uid(), type: 'line', x1: g.px, y1: g.py, x2, y2, color: getPalette(board.type)[0] };
        pushHistory();
        board.elements.push(el);
        board.lastEdited = Date.now();
        saveBoard(board);
        buildLineEl(el);
        return;
      }
      if (g.kind === 'bg') {
        if (g.moved) return;
        if (mode === 'add-text') {
          addText(g.px - 60, g.py - 30);   // pointerup 안에서 focus → 터치 기기에서도 화상 키보드가 뜸
          mode = 'select'; updateTbState();
        } else if (mode === 'select') {
          deselectAll();
        }
        return;
      }
      if (g.moved && g.draggable) {
        const el = board.elements.find(x => x.id === g.id);
        if (el) {
          pushHistory();
          if (g.kind === 'text') { el.x = g.ox + dx; el.y = g.oy + dy; }
          else { el.x1 = g.o.x1 + dx; el.y1 = g.o.y1 + dy; el.x2 = g.o.x2 + dx; el.y2 = g.o.y2 + dy; }
          board.lastEdited = Date.now();
          saveBoard(board);
        }
        selectEl(g.id, g.kind);
        return;
      }
      if (g.moved) return;
      if (g.longPress) { lastTap = null; secondaryAction(g.id, g.kind); return; }
      // 짧은 시간 안에 같은 요소를 또 누르면 두 번 누르기(마우스는 더블클릭과 같은 동작)
      const now = Date.now();
      const isDouble = lastTap && lastTap.id === g.id &&
        now - lastTap.t < (g.ptype === 'mouse' ? 500 : 450) &&
        Math.hypot(e.clientX - lastTap.x, e.clientY - lastTap.y) < (g.ptype === 'mouse' ? 10 : 30);
      if (isDouble) { lastTap = null; secondaryAction(g.id, g.kind); return; }
      lastTap = { id: g.id, t: now, x: e.clientX, y: e.clientY };
      selectEl(g.id, g.kind);
    });

    window.addEventListener('pointercancel', e => {
      const g = gesture;
      if (!g || e.pointerId !== g.pointerId) return;
      endGesture(g);
      if (g.kind === 'draw') cancelDraw();
      else if (g.kind === 'text' && g.moved) { g.div.style.left = g.ox + 'px'; g.div.style.top = g.oy + 'px'; }
      else if (g.kind === 'line' && g.moved) renderLines();
    });

    // 두 번 누르기·길게 누르기: 글자는 편집, 선은 메뉴
    function secondaryAction(id, kind) {
      selectEl(id, kind);
      if (viewOnlyBoard) return;
      if (kind === 'text') startEdit(id);
      else showCtx(id, 'line');
    }

    // 캔버스 안의 클릭은 위 Pointer 처리가 모두 맡음(바깥 클릭 처리기가 방금 한 선택을 지우지 않게)
    canvas.addEventListener('click', e => e.stopPropagation());
    // 길게 누르기 메뉴(모바일)·오른쪽 클릭: 편집 중인 글자 안에서는 기본 메뉴(붙여넣기 등) 유지
    canvas.addEventListener('contextmenu', e => {
      const ed = editingEl();
      if (ed && ed.contains(e.target)) return;
      e.preventDefault();
      if (gesture) return;   // 터치 길게 누르기는 위에서 처리
      const t = e.target.closest('.cb-el');
      const l = e.target.closest('.cb-line-g');
      if (t) selectEl(t.dataset.id, 'text');
      else if (l && mode === 'select') selectEl(l.dataset.id, 'line');
    });

    function cancelDraw() {
      if (gesture && gesture.kind === 'draw') endGesture(gesture);
      if (tempLine) { tempLine.remove(); tempLine = null; }
    }

    /* ── Save dropdown ── */
    let saveMenuOpen = false;

    let moreMenuOpen = false;
    function toggleMoreMenu(e) {
      e.stopPropagation();
      if (!getBoard()) return;
      moreMenuOpen = !moreMenuOpen;
      const dd = document.getElementById('more-dropdown');
      document.getElementById('btn-more').setAttribute('aria-expanded', String(moreMenuOpen));
      if (!moreMenuOpen) { dd.classList.remove('open'); return; }
      const board = getBoard();
      const s = board ? BS[board.type] : BS.chalkboard;
      dd.style.background = s.saveDdBg;
      dd.style.borderColor = s.ctxBorder;
      dd.style.boxShadow = s.ctxShadow;
      dd.querySelectorAll('.save-opt').forEach(b => {
        b.style.color = s.saveDdColor;
        b.onmouseenter = () => b.style.background = s.saveDdHover;
        b.onmouseleave = () => b.style.background = 'transparent';
      });
      loadQR();
      const btn = document.getElementById('btn-more');
      const r = btn.getBoundingClientRect();
      dd.style.left = Math.max(8, r.right - 170) + 'px';
      dd.style.top = (r.bottom + 4) + 'px';
      dd.classList.add('open');
    }
    function closeMoreMenu() {
      moreMenuOpen = false;
      document.getElementById('btn-more').setAttribute('aria-expanded', 'false');
      document.getElementById('more-dropdown').classList.remove('open');
    }

    function toggleSaveMenu(e) {
      e.stopPropagation();
      saveMenuOpen = !saveMenuOpen;
      const dd = document.getElementById('save-dropdown');
      document.getElementById('btn-save').setAttribute('aria-expanded', String(saveMenuOpen));
      if (!saveMenuOpen) { dd.classList.remove('open'); return; }
      // Style by board type
      const board = getBoard();
      const s = board ? BS[board.type] : BS.chalkboard;
      dd.style.background = s.saveDdBg;
      dd.style.borderColor = s.ctxBorder;
      dd.style.boxShadow = s.ctxShadow;
      dd.querySelectorAll('.save-opt').forEach(b => {
        b.style.color = s.saveDdColor;
        b.onmouseenter = () => b.style.background = s.saveDdHover;
        b.onmouseleave = () => b.style.background = 'transparent';
      });
      // Position below btn-save
      const btn = document.getElementById('btn-save');
      const r = btn.getBoundingClientRect();
      dd.style.left = Math.max(8, r.right - 160) + 'px';
      dd.style.top = (r.bottom + 4) + 'px';
      dd.classList.add('open');
    }

    function closeSaveMenu() {
      saveMenuOpen = false;
      document.getElementById('btn-save').setAttribute('aria-expanded', 'false');
      document.getElementById('save-dropdown').classList.remove('open');
    }

    /* ── Share modal ── */
    // ESC로 닫으면 저장하지 않는 '보기 전용'으로 엶
    const shareModal = VUI.modal.bind('#modal-share', { className: 'active', dialog: '#modal-share .modal-box', onClose: () => enterViewOnly() });
    function openShareModal(board) {
      _pendingShared = board;
      document.getElementById('modal-share-name').textContent = board.name;
      shareModal.open();
    }

    function enterViewOnly() {
      shareModal.close();
      if (!_pendingShared) return;
      viewOnlyBoard = _pendingShared;
      _pendingShared = null;
      history.replaceState(null, '', location.pathname);
      showView('home'); renderHome();
      openBoard('__view_only__');
    }

    function cloneAndOpen() {
      shareModal.close();
      const shared = _pendingShared;
      if (!shared) return;
      _pendingShared = null;
      const board = {
        id: uid(), name: shared.name || '공유된 보드',
        type: BS[shared.type] ? shared.type : 'chalkboard',
        elements: JSON.parse(JSON.stringify(shared.elements)),
        createdAt: Date.now(), lastEdited: Date.now(),
      };
      const d = getData(); d.boards.push(board); saveData(d);
      history.replaceState(null, '', location.pathname);
      showView('home'); renderHome();
      openBoard(board.id);
      showToast('복제했습니다');
    }

    function cloneSharedBoard() {
      const shared = viewOnlyBoard;
      viewOnlyBoard = null;
      const board = {
        id: uid(), name: shared.name || '복제된 보드',
        type: shared.type,
        elements: JSON.parse(JSON.stringify(shared.elements)),
        createdAt: Date.now(), lastEdited: Date.now(),
      };
      const d = getData(); d.boards.push(board); saveData(d);
      undoStack = [];
      document.body.classList.remove('is-view-only');
      openBoard(board.id);
      showToast('복제했습니다');
    }

    /* ── Toast (공용 VUI) ── */
    function showToast(msg, type) { VUI.toast(msg, type); }

    /* ── Share ── */
    function buildShareURL(permission) {
      const board = getBoard();
      if (!board) return null;
      // 새 링크는 UTF-8 base64url(한글이 약 3배 짧음). 옛 링크는 VUI.share.decode가 그대로 읽음
      const encoded = VUI.share.encode({ elements: board.elements, type: board.type, name: board.name, permission });
      return `${location.origin}/apps/chalkboard/#share=${encoded}`;
    }

    let shareMenuOpen = false;

    function toggleShareMenu(e) {
      e.stopPropagation();
      if (!getBoard()) return;
      shareMenuOpen = !shareMenuOpen;
      const dd = document.getElementById('share-dropdown');
      document.getElementById('btn-share').setAttribute('aria-expanded', String(shareMenuOpen));
      if (!shareMenuOpen) { dd.classList.remove('open'); return; }
      loadQR();   // 복사가 안 될 때 보여 줄 QR 라이브러리를 미리 받아 둠
      const board = getBoard();
      const s = board ? BS[board.type] : BS.chalkboard;
      dd.style.background = s.saveDdBg;
      dd.style.borderColor = s.ctxBorder;
      dd.style.boxShadow = s.ctxShadow;
      dd.querySelectorAll('.save-opt').forEach(b => {
        b.style.color = s.saveDdColor;
        b.onmouseenter = () => b.style.background = s.saveDdHover;
        b.onmouseleave = () => b.style.background = 'transparent';
      });
      const btn = document.getElementById('btn-share');
      const r = btn.getBoundingClientRect();
      dd.style.left = Math.max(8, r.right - 160) + 'px';
      dd.style.top = (r.bottom + 4) + 'px';
      dd.classList.add('open');
    }

    function closeShareMenu() {
      shareMenuOpen = false;
      document.getElementById('btn-share').setAttribute('aria-expanded', 'false');
      document.getElementById('share-dropdown').classList.remove('open');
    }

    // QR 라이브러리: 복사가 안 될 때 보여 주는 링크 창에서 QR을 그림(공유 메뉴를 열 때 미리 받음)
    let _qrPromise = null;
    function loadQR() {
      if (window.QRCode) return Promise.resolve(true);
      if (_qrPromise) return _qrPromise;
      _qrPromise = new Promise(resolve => {
        const sc = document.createElement('script');
        sc.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
        sc.async = true;
        sc.onload = () => resolve(true);
        sc.onerror = () => { _qrPromise = null; resolve(false); };
        document.head.appendChild(sc);
      });
      return _qrPromise;
    }

    async function doShare(permission) {
      closeShareMenu();
      const btn = document.getElementById('btn-share');
      btn.disabled = true;
      try {
        const longURL = buildShareURL(permission);
        if (!longURL) return;
        await Promise.race([loadQR(), new Promise(r => setTimeout(r, 1500))]);
        // 단축 → 복사. 복사가 안 되면 링크·QR 창을 보여 줌
        await VUI.share.link(longURL, {
          title: '🔗 칠판 공유',
          desc: permission === 'view' ? '받는 사람은 보기만 할 수 있어요.' : '받는 사람이 자기 보드로 복제할 수 있어요.',
        });
      } finally { btn.disabled = false; }
    }

    function doSaveTxt() {
      closeSaveMenu();
      const board = getBoard(); if (!board) return;
      let content = `[${board.type === 'chalkboard' ? '칠판' : '화이트보드'}] ${board.name}\n${'='.repeat(40)}\n\n`;
      board.elements.filter(e => e.type === 'text').forEach(el => { content += el.text + '\n'; });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([content], { type: 'text/plain;charset=utf-8' }));
      a.download = board.name.replace(/[^\w가-힣]/g, '_') + '.txt';
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    }

    function doSaveJpg() {
      closeSaveMenu();
      const board = getBoard(); if (!board) return;
      const s = BS[board.type];
      const canvasEl = document.getElementById('cb-canvas');
      const W = canvasEl.offsetWidth, H = canvasEl.offsetHeight;
      const c = document.createElement('canvas');
      c.width = W; c.height = H;
      const ctx = c.getContext('2d');

      // Background
      ctx.fillStyle = s.bg;
      ctx.fillRect(0, 0, W, H);

      // Lines (drawn before text so text appears on top)
      board.elements.filter(e => e.type === 'line').forEach(el => {
        ctx.beginPath();
        ctx.moveTo(el.x1, el.y1);
        ctx.lineTo(el.x2, el.y2);
        ctx.strokeStyle = el.color;
        ctx.lineWidth = 3;
        ctx.lineCap = 'round';
        ctx.stroke();
      });

      // Text
      board.elements.filter(e => e.type === 'text').forEach(el => {
        ctx.font = `700 ${el.size}px -apple-system, BlinkMacSystemFont, Pretendard, sans-serif`;
        ctx.fillStyle = el.color;
        ctx.textBaseline = 'top';
        // el.x/y is the top-left of the div; +6/+4 is the div's padding
        (el.text || '').split('\n').forEach((line, i) => {
          ctx.fillText(line, el.x + 6, el.y + 4 + i * el.size * 1.2);
        });
      });

      const a = document.createElement('a');
      a.href = c.toDataURL('image/jpeg', 0.92);
      a.download = board.name.replace(/[^\w가-힣]/g, '_') + '.jpg';
      a.click();
    }

    /* ── Outside click closes ctx + save menu ── */
    document.addEventListener('click', e => {
      // Close more dropdown
      if (moreMenuOpen && !e.target.closest('#more-dropdown') && !e.target.closest('#btn-more')) {
        closeMoreMenu();
      }
      // Close save dropdown
      if (saveMenuOpen && !e.target.closest('#save-dropdown') && !e.target.closest('#btn-save')) {
        closeSaveMenu();
      }
      // Close share dropdown
      if (shareMenuOpen && !e.target.closest('#share-dropdown') && !e.target.closest('#btn-share')) {
        closeShareMenu();
      }
      // Close context menu
      if (document.getElementById('cb-ctx').style.display === 'none') return;
      if (!e.target.closest('#cb-ctx') && !e.target.closest('.cb-el') && !e.target.closest('.cb-line-g')) {
        hideCtx();
        deselectAll();
      }
    });

    /* ── Keyboard ── */
    document.addEventListener('keydown', e => {
      if (document.activeElement.contentEditable === 'true') return;
      if (document.activeElement.tagName === 'INPUT') return;
      if (!document.getElementById('view-board').classList.contains('active')) return;
      if (e.key === 'Escape') {
        if (moreMenuOpen || saveMenuOpen || shareMenuOpen) closeMenus();
        else if (mode !== 'select') { mode = 'select'; cancelDraw(); updateTbState(); }
        else deselectAll();
      }
      // 보기 전용 보드에서는 삭제·되돌리기·복사·붙여넣기를 막음
      if (viewOnlyBoard) return;
      if ((e.key === 'Delete' || e.key === 'Backspace') && selectedId) {
        deleteEl(selectedId);
      }
      if ((e.key === 'z' || e.key === 'Z') && (e.ctrlKey || e.metaKey)) {
        e.preventDefault();
        undoLast();
      }
      if ((e.key === 'c' || e.key === 'C') && (e.ctrlKey || e.metaKey) && selectedId) {
        e.preventDefault();
        const board = getBoard();
        const el = board.elements.find(e2 => e2.id === selectedId);
        if (el) { clipboard = JSON.parse(JSON.stringify(el)); showToast('복사했습니다'); }
      }
      if ((e.key === 'v' || e.key === 'V') && (e.ctrlKey || e.metaKey) && clipboard) {
        e.preventDefault();
        const board = getBoard();
        const el = JSON.parse(JSON.stringify(clipboard));
        el.id = uid();
        if (el.type === 'text') { el.x += 20; el.y += 20; }
        else { el.x1 += 20; el.y1 += 20; el.x2 += 20; el.y2 += 20; }
        pushHistory();
        board.elements.push(el);
        board.lastEdited = Date.now();
        saveBoard(board);
        if (el.type === 'text') buildTextEl(el); else buildLineEl(el);
        selectEl(el.id, el.type);
        showToast('붙여넣었습니다');
      }
    });

    /* ── Modal keyboard ── */
    document.getElementById('new-board-name').addEventListener('keydown', e => {
      // preventDefault: 모달이 닫히며 포커스가 '새 보드' 버튼으로 돌아간 뒤 Enter가 그 버튼을 다시 누르지 않게
      if (e.key === 'Enter' && !e.isComposing) { e.preventDefault(); createBoard(); }
    });

    // 공유 링크로 받은 요소는 외부 입력: 모양이 맞는 것만, 숫자·문자열로 다시 만듦
    function sanitizeElements(list) {
      const num = v => (typeof v === 'number' && isFinite(v) ? Math.max(-5000, Math.min(20000, v)) : 0);
      const col = v => (typeof v === 'string' && /^(#[0-9a-fA-F]{3,8}|[a-z]{3,20}|rgba?\([\d.,\s%]+\))$/.test(v) ? v : '#ffffff');
      const out = [];
      (Array.isArray(list) ? list : []).slice(0, 2000).forEach(e => {
        if (!e || typeof e !== 'object') return;
        const id = typeof e.id === 'string' && e.id.length <= 40 ? e.id : uid();
        if (e.type === 'text') {
          out.push({ id, type: 'text', x: num(e.x), y: num(e.y), text: String(e.text == null ? '' : e.text).slice(0, 5000),
            color: col(e.color), size: SIZES.includes(e.size) ? e.size : (num(e.size) > 0 ? Math.min(400, num(e.size)) : 80) });
        } else if (e.type === 'line') {
          out.push({ id, type: 'line', x1: num(e.x1), y1: num(e.y1), x2: num(e.x2), y2: num(e.y2), color: col(e.color) });
        }
      });
      return out;
    }

    /* ── Init ── */
    (function init() {
      const hash = location.hash;
      if (hash.startsWith('#share=')) {
        const encoded = hash.slice(7);
        try {
          // 새 형식(UTF-8 base64url)과 옛 형식(btoa(encodeURIComponent)) 모두 읽음
          const shared = VUI.share.decode(encoded, o => o && Array.isArray(o.elements) && typeof o.type === 'string');
          if (shared) {
            const boardData = {
              name: typeof shared.name === 'string' && shared.name.trim() ? shared.name.slice(0, 60) : '공유된 보드',
              type: BS[shared.type] ? shared.type : 'chalkboard',
              elements: sanitizeElements(shared.elements),
            };
            history.replaceState(null, '', location.pathname);
            showView('home'); renderHome();
            if (shared.permission === 'view') {
              viewOnlyBoard = boardData;
              openBoard('__view_only__');
              showToast('보기 전용으로 열립니다');
            } else {
              openShareModal(boardData);
            }
            return;
          }
        } catch {}
        showToast('공유 링크를 읽을 수 없습니다.');
      }
      showView('home');
      renderHome();

      // 선택 동기화: 헤더 '동기화' 버튼 (보드를 코드 하나로 기기 간 이어쓰기)
      if (window.VivesSync) VivesSync.mountDocSync({
        apiUrl: '/api/chalkboard',
        keys: ['vives-chalkboard'],
        appName: '칠판·화이트보드',
        onApplied: function () {
          renderHome();
          if (currentBoardId && document.body.classList.contains('in-board')) openBoard(currentBoardId);
        },
      });
    })();
  </script>



</AppLayout>
