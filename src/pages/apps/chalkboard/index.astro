---
import AppLayout from '../../../layouts/AppLayout.astro';
import Icon from '../../../components/Icon.astro';
---
<AppLayout
  sync
  title="칠판 (Chalkboard) — eduin VIVES"
  description="분필 느낌의 디지털 칠판으로 아이디어를 자유롭게 기록. 수업 판서, 브레인스토밍에 최적화."
  image="https://eduin.info/og-images/chalkboard.png"
  bodyShell="gallery"
  bodyWidth="medium"
>
  <Fragment slot="head">
    <style is:global="">
    *, *::before, *::after { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, 'Pretendard', sans-serif;
      min-height: 100vh;
      min-height: 100dvh;
    }

    body::before {
      content: '';
      position: fixed; inset: 0;
      background-image:
        linear-gradient(rgba(124,106,247,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(124,106,247,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none; z-index: 0;
    }
    body.in-board::before { display: none; }

    /* Hide home/share overlays inside board */
    body.in-board .top-overlay,
    body.in-board .top-overlay-left { display: none !important; }

    /* ── Views ── */
    .cb-view { display: none; }
    .cb-view.active { display: block; }

    #view-board {
      position: fixed; inset: 0;
      display: none; flex-direction: column;
      overflow: hidden; z-index: 500;
    }
    #view-board.active { display: flex; }

    /* ── Toolbar ── */
    #cb-tb {
      height: 52px;
      display: flex; align-items: center; gap: 6px;
      padding: 0 14px;
      border-bottom: 1px solid transparent;
      flex-shrink: 0; z-index: 100;
    }

    .tb-btn {
      height: 40px; min-width: 40px; padding: 0 14px;
      border-radius: 8px;
      border: 1px solid transparent;
      cursor: pointer; font-size: 13px; font-weight: 600;
      font-family: inherit;
      display: flex; align-items: center; gap: 6px;
      transition: background 0.15s;
      white-space: nowrap; background: transparent;
    }
    .tb-btn.on { opacity: 1 !important; }
    .tb-btn .ic { width: 15px; height: 15px; flex-shrink: 0; }
    .tb-btn .tb-caret { width: 11px; height: 11px; opacity: 0.6; }

    .tb-sep { flex: 1; }

    /* 자동 저장 표시(내보내기 메뉴와 별개) */
    .tb-status {
      font-size: 12px; font-weight: 600; white-space: nowrap;
      opacity: 0.55; transition: opacity 0.3s;
      display: inline-flex; align-items: center; gap: 4px; padding: 0 4px;
    }
    .tb-status .ic { width: 13px; height: 13px; }
    .tb-status.flash { opacity: 0.95; }
    .is-view-only .tb-status { display: none; }
    /* 칠판·화이트보드 전환 버튼의 현재 상태 색 점 */
    .type-dot {
      width: 12px; height: 12px; border-radius: 3px; flex-shrink: 0;
      border: 1px solid rgba(127,127,127,0.6);
    }

    #tb-name {
      background: transparent;
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 6px;
      font-size: 14px; font-weight: 600;
      font-family: inherit;
      padding: 4px 10px;
      max-width: 200px;
      cursor: text;
      transition: border-color 0.15s, background 0.15s;
    }
    #tb-name:hover { border-color: rgba(255,255,255,0.35); }
    #tb-name:focus { outline: none; border-color: rgba(255,255,255,0.55); background: rgba(255,255,255,0.06); }
    body.board-white #tb-name { border-color: rgba(0,0,0,0.18); }
    body.board-white #tb-name:hover { border-color: rgba(0,0,0,0.3); }
    body.board-white #tb-name:focus { border-color: rgba(0,0,0,0.45); background: rgba(0,0,0,0.04); }

    /* 내보내기 드롭다운 */
    #save-dropdown {
      position: fixed;
      display: none;
      flex-direction: column;
      gap: 3px;
      padding: 6px;
      border-radius: 10px;
      border: 1px solid transparent;
      z-index: 9500;
      min-width: 150px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.45);
    }
    #save-dropdown.open { display: flex; }
    #share-dropdown { position: fixed; display: none; flex-direction: column; gap: 3px; padding: 6px; border-radius: 10px; border: 1px solid transparent; z-index: 9500; min-width: 150px; box-shadow: 0 4px 20px rgba(0,0,0,0.45); }
    #share-dropdown.open { display: flex; }
    .save-opt {
      min-height: 44px; padding: 0 12px;
      border-radius: 7px; border: none;
      cursor: pointer; font-size: 13px; font-weight: 600;
      font-family: inherit;
      display: flex; align-items: center; gap: 8px;
      text-align: left; background: transparent;
      transition: background 0.15s;
    }

    #btn-back {
      width: 40px; height: 40px; flex-shrink: 0;
      border-radius: 8px; border: 1px solid transparent;
      background: transparent; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: background 0.15s;
    }

    /* ── Canvas ── */
    #cb-canvas {
      flex: 1; position: relative; overflow: hidden;
      /* 전자칠판·태블릿: 그리는 면에서만 스크롤·확대 제스처를 끄고 펜·손가락 입력을 직접 받음 */
      touch-action: none;
      user-select: none; -webkit-user-select: none;
      -webkit-touch-callout: none;
    }
    #cb-canvas.mode-text { cursor: text; }
    #cb-canvas.mode-line { cursor: crosshair; }
    #cb-canvas.mode-select { cursor: default; }

    /* 보드 내용(선·글자)을 담는 면. '화면에 맞추기' 때 transform으로 줄여 보여 줌(저장 좌표는 그대로) */
    #cb-stage {
      position: absolute; left: 0; top: 0;
      width: 100%; height: 100%;
      transform-origin: 0 0;
    }

    /* SVG overlay for lines */
    #cb-svg {
      position: absolute; left: 0; top: 0;
      width: 100%; height: 100%;
      z-index: 1; overflow: visible;
    }

    /* 빈 보드 사용법 안내 */
    #cb-empty-hint {
      position: absolute; inset: 0; z-index: 0;
      display: none; align-items: center; justify-content: center;
      padding: 24px; pointer-events: none; text-align: center;
    }
    #cb-empty-hint.show { display: flex; }
    #cb-empty-hint ul {
      margin: 0; padding: 0; list-style: none;
      display: flex; flex-direction: column; gap: 10px;
      font-size: 15px; font-weight: 600; line-height: 1.5;
      opacity: 0.55; word-break: keep-all;
    }
    #cb-empty-hint li { display: flex; align-items: center; justify-content: center; gap: 8px; }
    #cb-empty-hint .ic { width: 18px; height: 18px; flex-shrink: 0; }

    /* ── Text elements ── */
    .cb-el {
      position: absolute; z-index: 2;
      cursor: grab; user-select: none;
      font-weight: 700; line-height: 1.2;
      white-space: pre-wrap; word-break: break-word;
      padding: 4px 6px; border-radius: 4px;
      outline: none; border: 2px solid transparent;
      transition: border-color 0.15s;
    }
    .cb-el:active { cursor: grabbing; }
    .cb-el.selected { border-color: rgba(255,255,255,0.35); }
    .cb-el[contenteditable="true"] { cursor: text; user-select: text; -webkit-user-select: text; caret-color: currentColor; }
    .cb-el.dragging { cursor: grabbing; }

    /* ── Context menu ── */
    #cb-ctx {
      position: fixed; z-index: 9000;
      display: none; flex-direction: column; gap: 4px;
      padding: 6px; border-radius: 12px;
      border: 1px solid transparent;
    }

    .ctx-row {
      display: flex; gap: 4px; align-items: center;
    }

    .ctx-btn {
      width: 40px; height: 40px; border-radius: 8px;
      border: 1px solid rgba(255,255,255,0.15);
      cursor: pointer; font-size: 13px; font-weight: 700;
      font-family: inherit; background: rgba(0,0,0,0.3); color: #fff;
      display: flex; align-items: center; justify-content: center;
      transition: background 0.15s; flex-shrink: 0;
    }
    .ctx-btn:hover { background: rgba(255,255,255,0.2); }
    .ctx-btn .ic { width: 17px; height: 17px; }
    .ctx-dot { width: 16px; height: 16px; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 1px rgba(127,127,127,0.5); }
    .ctx-btn.ctx-del { color: #ff7070; }
    .ctx-btn.ctx-del:hover { background: rgba(255,80,80,0.2); }
    .ctx-swatch { border: 2px solid transparent; }
    .ctx-swatch.cur {
      outline: 2px solid rgba(255,255,255,0.85);
      outline-offset: 2px;
    }

    /* Whiteboard context menu overrides */
    body.board-white .ctx-btn {
      background: rgba(0,0,0,0.07);
      color: #222;
      border-color: rgba(0,0,0,0.13);
    }
    body.board-white .ctx-btn:hover { background: rgba(0,0,0,0.14); }
    body.board-white .ctx-btn.ctx-del { color: #d93025; }
    body.board-white .ctx-btn.ctx-del:hover { background: rgba(217,48,37,0.1); }
    body.board-white .ctx-swatch.cur { outline-color: rgba(0,0,0,0.6); }
    body.board-white .cb-el.selected { border-color: rgba(0,0,0,0.25) !important; }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Home view ── */
    #view-home { position: relative; z-index: 1; }
    .cb-home-wrap {
      max-width: 860px; margin: 0 auto;
      padding: 68px 20px 80px;
    }
    .cb-section-title {
      font-size: 11px; font-weight: 700; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--fg-muted);
      display: flex; align-items: center; gap: 8px; flex: 1; margin: 0;
    }
    .cb-section-title::after { content: ''; flex: 1; height: 1px; background: var(--border); }
    .home-top {
      display: flex; align-items: center; justify-content: space-between;
      gap: 12px; margin-bottom: 20px;
    }
    .btn-new {
      height: 44px; padding: 0 16px; border-radius: 10px;
      background: var(--primary); color: #fff; border: none;
      cursor: pointer; font-size: 13px; font-weight: 600;
      font-family: inherit; display: flex; align-items: center; gap: 6px;
      transition: background 0.15s; white-space: nowrap; flex-shrink: 0;
    }
    .btn-new:hover { background: var(--primary-h); }

    /* 카드 그리드 (Flash Deck 스타일) */
    .board-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
      gap: 12px;
    }
    .board-card {
      position: relative;
      background: var(--card-bg); border: 1px solid var(--border);
      border-radius: 14px; overflow: hidden;
      cursor: pointer; transition: border-color 0.2s, transform 0.15s, box-shadow 0.2s;
      display: flex; flex-direction: column;
      animation: fadeUp 0.22s ease both;
    }
    .board-card:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(0,111,238,0.1);
    }

    /* 썸네일 영역 — 보드 배경색 + 미리보기 텍스트 */
    .board-thumb {
      height: 88px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      padding: 10px 14px; overflow: hidden;
      position: relative;
    }
    .board-thumb-placeholder {
      font-size: 28px; opacity: 0.35;
    }
    .board-preview-text {
      font-size: 20px; font-weight: 700; line-height: 1.25;
      text-align: center; max-width: 100%;
      overflow: hidden; display: -webkit-box;
      -webkit-line-clamp: 2; -webkit-box-orient: vertical;
      word-break: break-all;
    }

    /* 카드 하단 정보 */
    .board-info-row {
      padding: 12px 14px; display: flex;
      align-items: center; gap: 8px; flex: 1;
    }
    .board-info { flex: 1; min-width: 0; }
    .board-name { font-size: 14px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    /* 카드 전체를 덮는 열기 버튼(키보드·스크린리더용 실제 버튼) */
    .board-open {
      all: unset; display: block; max-width: 100%;
      font-size: 14px; font-weight: 700; color: var(--fg);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: pointer;
    }
    .board-open::after { content: ''; position: absolute; inset: 0; border-radius: 14px; }
    .board-open:focus-visible::after { outline: 2px solid var(--primary); outline-offset: -2px; }
    .board-meta { font-size: 11px; color: var(--fg-muted); margin-top: 3px; }
    .board-del {
      position: relative; z-index: 1;
      width: 40px; height: 40px; border: none; background: none;
      cursor: pointer; color: var(--fg-muted); border-radius: 8px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      transition: color 0.15s, background 0.15s;
    }
    .board-del:hover { color: var(--danger); background: rgba(255,0,0,0.06); }

    .empty-state { grid-column: 1/-1; text-align: center; padding: 60px 0; color: var(--fg-muted); }
    .empty-icon { display: flex; justify-content: center; margin-bottom: 16px; color: var(--fg-muted); }
    .empty-icon svg { width: 48px; height: 48px; stroke: currentColor; stroke-width: 1.5; fill: none; opacity: 0.5; }
    .empty-text { font-size: 14px; }

    /* ── Modal ── */
    .modal-bg {
      position: fixed; inset: 0; z-index: 8000;
      background: rgba(0,0,0,0.45); backdrop-filter: blur(4px);
      display: none; align-items: center; justify-content: center;
    }
    .modal-bg.active { display: flex; }
    .modal-box {
      background: var(--card-bg); border: 1px solid var(--border);
      border-radius: 16px; padding: 24px; width: min(90vw, 380px);
    }
    .modal-title { font-size: 16px; font-weight: 700; margin: 0 0 16px; }
    .modal-input {
      width: 100%; background: var(--bg); border: 1px solid var(--border);
      border-radius: 8px; padding: 10px 14px; font-size: 15px;
      color: var(--fg); outline: none; font-family: inherit; margin-bottom: 12px;
    }
    .modal-input:focus { border-color: var(--primary); }
    @media (max-width: 600px) { .modal-input { font-size: 16px; } }
    .modal-type-row { display: flex; gap: 8px; margin-bottom: 16px; }
    .type-btn {
      flex: 1; padding: 10px; min-height: 44px; border-radius: 10px;
      border: 2px solid var(--border); cursor: pointer;
      text-align: center; font-size: 13px; font-weight: 600;
      font-family: inherit; background: var(--bg); color: var(--fg-muted);
      transition: all 0.15s;
    }
    .type-btn.sel { border-color: var(--primary); background: rgba(0,111,238,0.08); color: var(--primary); }
    .type-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; }
    .modal-actions { display: flex; gap: 8px; }
    .btn-cancel {
      flex: 1; padding: 10px; min-height: 44px; border-radius: 8px;
      border: 1px solid var(--border); background: var(--bg);
      color: var(--fg-muted); cursor: pointer; font-size: 14px;
      font-weight: 600; font-family: inherit;
    }
    .btn-cancel, .btn-confirm { display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
    .btn-confirm {
      flex: 2; padding: 10px; min-height: 44px; border-radius: 8px;
      border: none; background: var(--primary); color: #fff;
      cursor: pointer; font-size: 14px; font-weight: 600;
      font-family: inherit;
    }
    /* ── Mobile more menu ── */
    #btn-more { display: none; }
    #more-dropdown {
      position: fixed; display: none; flex-direction: column;
      gap: 3px; padding: 6px; border-radius: 10px;
      border: 1px solid transparent; z-index: 9500;
      min-width: 160px; box-shadow: 0 4px 20px rgba(0,0,0,0.45);
    }
    #more-dropdown.open { display: flex; }
    .more-sep { height: 1px; background: currentColor; opacity: 0.12; margin: 3px 4px; }
    .more-note { font-size: 12px; opacity: 0.6; padding: 6px 12px 4px; display: flex; align-items: center; gap: 6px; }
    .more-note .ic { width: 13px; height: 13px; }
    #more-type { display: none; }
    /* 중간 폭: 텍스트·선·되돌리기·맞추기는 아이콘만(칠판/화이트보드 상태 글자는 유지) */
    @media (max-width: 900px) {
      #btn-add-text .tb-label, #btn-draw .tb-label, #btn-undo .tb-label, #btn-fit .tb-label { display: none; }
      #btn-add-text, #btn-draw, #btn-undo, #btn-fit { padding: 0 8px; justify-content: center; }
      #autosave-status { display: none; }
      #tb-name { flex: 1 1 auto; min-width: 0; width: 100%; }
    }
    @media (max-width: 600px) {
      #btn-save, #btn-share { display: none !important; }
      #btn-more { display: flex; }
      /* 좁은 화면: 칠판/화이트보드 전환은 더보기 메뉴로(글자로 상태·동작을 보여 줌) */
      #btn-type { display: none !important; }
      #more-type { display: flex; }
      #btn-more { padding: 0 10px; justify-content: center; }
      /* 좁은 화면: 툴바가 가로로 넘치지 않게 이름 칸이 남는 폭만 씀 */
      #cb-tb { padding: 0 8px; gap: 4px; }
      #tb-name { flex: 1 1 auto; min-width: 0; width: 100%; font-size: 16px; }
      .tb-sep { display: none; }
      .is-view-only #btn-add-text, .is-view-only #btn-draw,
      .is-view-only #btn-undo, .is-view-only #btn-more { display: none !important; }
      #btn-view-badge { padding: 0 8px; flex-shrink: 0; }
      #btn-clone { padding: 0 10px; flex-shrink: 0; }
    }
    /* 터치 기기: 누르는 영역 44px */
    @media (pointer: coarse) {
      #cb-tb { height: 56px; }
      .tb-btn, #btn-back { height: 44px; min-width: 44px; }
      #btn-back { width: 44px; }
      .ctx-btn { width: 44px; height: 44px; }
      .ctx-swatch { width: 44px !important; height: 44px !important; }
      .board-del { width: 44px; height: 44px; }
    }

    /* ── View-only mode ── */
    .is-view-only #btn-type,
    .is-view-only #btn-add-text,
    .is-view-only #btn-draw,
    .is-view-only #btn-undo,
    .is-view-only #btn-save,
    .is-view-only #btn-share,
    .is-view-only #btn-more,
    .is-view-only #tb-name { opacity: 0.3; pointer-events: none; }
    #btn-view-badge {
      display: none; align-items: center; gap: 4px;
      height: 40px;
      font-size: 12px; font-weight: 700; letter-spacing: 0.06em;
      padding: 0 10px; border-radius: 6px; border: 1px solid currentColor;
      opacity: 0.7; white-space: nowrap;
    }
    .is-view-only #btn-view-badge { display: flex; }
    #btn-clone { display: none; }
    .is-view-only #btn-clone { display: flex; }
    /* Share-mode modal name */
    .modal-share-name {
      font-size: 15px; font-weight: 700; color: var(--fg);
      margin: -0.5rem 0 1rem; text-align: center;
    }

  </style>
  <script type="application/ld+json" is:inline="">{"@context":"https://schema.org","@type":"WebApplication","name":"Chalkboard","description":"분필 느낌의 디지털 칠판으로 아이디어를 자유롭게 기록. 수업 판서, 브레인스토밍에 최적화.","url":"https://eduin.info/apps/chalkboard/","applicationCategory":"EducationApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"KRW"},"isPartOf":{"@type":"WebSite","name":"eduin VIVES","url":"https://eduin.info"}}</script>
  </Fragment>




  <!-- 홈 뷰 -->
  <div id="view-home" class="cb-view active">
    <div class="cb-home-wrap">
      <div class="app-header">
        <div class="app-badge">학습지원</div>
        <h1 class="app-title">칠판 <span class="app-title-en">Chalkboard</span></h1>
        <p class="app-desc">칠판 &amp; 화이트보드 메모 앱</p>
      </div>
      <div class="home-top">
        <div class="cb-section-title">내 보드</div>
        <button class="btn-new" onclick="openNewModal()">
          <Icon name="plus" />
          새 보드
        </button>
      </div>
      <div id="board-list" class="board-list"></div>
    </div>
  </div>

  <!-- 보드 뷰 -->
  <div id="view-board">
    <div id="cb-tb">
      <!-- 왼쪽: 닫기 + 보드 이름 -->
      <button id="btn-back" onclick="goHome()" aria-label="보드 목록으로">
        <Icon name="x" size={18} />
      </button>
      <input id="tb-name" type="text" spellcheck="false" autocomplete="off" aria-label="보드 이름" onchange="renameCurrent(this.value)">
      <div class="tb-sep"></div>
      <span id="autosave-status" class="tb-status"><Icon name="check" />자동 저장됨</span>
      <!-- 오른쪽: 기능 버튼들 -->
      <button id="btn-type" class="tb-btn" onclick="switchBoardType()" aria-label="지금 칠판 — 눌러서 화이트보드로 바꾸기">
        <span class="type-dot" id="type-dot" aria-hidden="true"></span>
        <span id="type-label">칠판</span>
      </button>
      <button id="btn-add-text" class="tb-btn" onclick="activateTextMode()" aria-label="텍스트 추가" aria-pressed="false">
        <Icon name="type" />
        <span class="tb-label">텍스트</span>
      </button>
      <button id="btn-draw" class="tb-btn" onclick="activateDrawMode()" aria-label="선 긋기" aria-pressed="false">
        <Icon name="slash" />
        <span class="tb-label">선</span>
      </button>
      <button id="btn-undo" class="tb-btn" onclick="undoLast()" aria-label="되돌리기 (Ctrl+Z)">
        <Icon name="undo-2" />
        <span class="tb-label">되돌리기</span>
      </button>
      <button id="btn-fit" class="tb-btn" onclick="toggleFit()" aria-label="화면에 맞추기: 보드의 모든 내용이 보이게 줄여 보기" aria-pressed="false">
        <Icon name="scan" />
        <span class="tb-label">화면에 맞추기</span>
      </button>
      <button id="btn-save" class="tb-btn" onclick="toggleSaveMenu(event)" aria-haspopup="true" aria-expanded="false" aria-controls="save-dropdown">
        <Icon name="download" />
        내보내기
        <Icon name="chevron-down" class="tb-caret" />
      </button>
      <span id="btn-view-badge"><Icon name="eye" /> 보기 전용</span>
      <button id="btn-clone" class="tb-btn" onclick="cloneSharedBoard()">
        <Icon name="copy" />
        복제하기
      </button>
      <button id="btn-more" class="tb-btn" onclick="toggleMoreMenu(event)" aria-label="더보기" aria-haspopup="true" aria-expanded="false" aria-controls="more-dropdown">
        <Icon name="ellipsis" size={18} />
      </button>
      <button id="btn-share" class="tb-btn" onclick="toggleShareMenu(event)" aria-haspopup="true" aria-expanded="false" aria-controls="share-dropdown">
        <Icon name="share-2" />
        공유
        <Icon name="chevron-down" class="tb-caret" />
      </button>
    </div>

  <!-- 공유 드롭다운 -->
  <div id="share-dropdown">
    <button class="save-opt" onclick="doShare('view')">
      <Icon name="eye" />
      보기 전용
    </button>
    <button class="save-opt" onclick="doShare('clone')">
      <Icon name="copy" />
      복제 허용
    </button>
  </div>

  <!-- 더보기 드롭다운 (모바일) -->
  <div id="more-dropdown">
    <button class="save-opt" id="more-type" onclick="closeMoreMenu(); switchBoardType()">
      <span class="type-dot" id="more-type-dot" aria-hidden="true"></span>
      <span id="more-type-label">화이트보드로 바꾸기</span>
    </button>
    <button class="save-opt" onclick="closeMoreMenu(); doSaveTxt()">
      <Icon name="file-text" />
      내보내기 - 글자만 (TXT)
    </button>
    <button class="save-opt" onclick="closeMoreMenu(); doSaveJpg()">
      <Icon name="image" />
      내보내기 - 그림 (JPG)
    </button>
    <div class="more-sep"></div>
    <button class="save-opt" onclick="closeMoreMenu(); doShare('view')">
      <Icon name="eye" />
      공유 - 보기 전용
    </button>
    <button class="save-opt" onclick="closeMoreMenu(); doShare('clone')">
      <Icon name="copy" />
      공유 - 복제 허용
    </button>
    <div class="more-note"><Icon name="check" />보드는 자동 저장돼요</div>
  </div>

  <!-- 내보내기 드롭다운 -->
  <div id="save-dropdown">
    <button class="save-opt" onclick="doSaveTxt()">
      <Icon name="file-text" />
      글자만 (TXT)
    </button>
    <button class="save-opt" onclick="doSaveJpg()">
      <Icon name="image" />
      그림 (JPG)
    </button>
  </div>

    <div id="cb-canvas" aria-label="보드: 글자는 두 번 누르거나 길게 눌러 고치고, 끌어서 옮겨요">
      <div id="cb-empty-hint" aria-hidden="true">
        <ul>
          <li><Icon name="type" />‘텍스트’를 누른 뒤 보드를 누르면 글자가 생겨요</li>
          <li><Icon name="slash" />‘선’을 누른 뒤 보드에서 끌면 선이 그어져요</li>
          <li><Icon name="pencil" />글자를 두 번 누르거나 길게 누르면 고칠 수 있어요</li>
          <li><Icon name="palette" />한 번 누르면 크기·색·지우기 메뉴가 나와요</li>
        </ul>
      </div>
      <div id="cb-stage">
        <svg id="cb-svg" xmlns="http://www.w3.org/2000/svg"></svg>
      </div>
    </div>
  </div>

  <!-- 컨텍스트 메뉴 -->
  <div id="cb-ctx">
    <div class="ctx-row" id="ctx-main"></div>
    <div class="ctx-row" id="ctx-colors" style="display:none"></div>
  </div>


  <!-- 공유 링크 모달 -->
  <div id="modal-share" class="modal-bg">
    <div class="modal-box">
      <h2 class="modal-title">공유된 칠판</h2>
      <p id="modal-share-name" class="modal-share-name"></p>
      <p style="font-size:13px;color:var(--fg-muted);margin-bottom:1.2rem;text-align:center">이 칠판을 어떻게 열까요? 보기 전용은 저장되지 않고, 복제하면 내 보드 목록에 저장돼요.</p>
      <div class="modal-actions">
        <button class="btn-cancel" onclick="enterViewOnly()"><Icon name="eye" /> 보기 전용</button>
        <button class="btn-confirm" onclick="cloneAndOpen()">복제하기</button>
      </div>
    </div>
  </div>

  <!-- 새 보드 모달 -->
  <div id="modal-new" class="modal-bg">
    <div class="modal-box">
      <h2 class="modal-title">새 보드 만들기</h2>
      <input type="text" id="new-board-name" class="modal-input" placeholder="보드 이름 (선택)" aria-label="보드 이름 (선택)" maxlength="30">
      <div class="modal-type-row">
        <button class="type-btn sel" id="opt-chalk" aria-pressed="true" onclick="selectNewType('chalkboard')"><span class="type-dot" style="background:#1a3323" aria-hidden="true"></span>칠판</button>
        <button class="type-btn" id="opt-white" aria-pressed="false" onclick="selectNewType('whiteboard')"><span class="type-dot" style="background:#f7f7f4" aria-hidden="true"></span>화이트보드</button>
      </div>
      <div class="modal-actions">
        <button class="btn-cancel" onclick="closeNewModal()">취소</button>
        <button class="btn-confirm" onclick="createBoard()">만들기</button>
      </div>
    </div>
  </div>

  <script is:inline="">
    /* ══════════════════════════════════════════
       Chalkboard App — complete rewrite
    ══════════════════════════════════════════ */

    const SK = 'vives-chalkboard';
    const SIZES = [32, 48, 64, 80, 96, 120, 160, 200];

    // 보드 타입별 스타일
    const BS = {
      chalkboard: {
        bg: '#1a3323', tb: '#122418',
        border: 'rgba(255,255,255,0.07)',
        btnColor: 'rgba(255,255,255,0.8)',
        nameColor: '#c8ddd0',
        ctxBg: 'rgba(8,18,12,0.88)',
        ctxBorder: 'rgba(255,255,255,0.1)',
        ctxShadow: '0 4px 20px rgba(0,0,0,0.55)',
        tempStroke: 'rgba(255,255,255,0.45)',
        selBorder: 'rgba(255,255,255,0.35)',
        selGlow: 'rgba(255,255,255,0.3)',
        saveDdBg: 'rgba(12,26,18,0.96)',
        saveDdColor: 'rgba(255,255,255,0.85)', saveDdHover: 'rgba(255,255,255,0.1)',
      },
      whiteboard: {
        bg: '#f7f7f4', tb: '#ebebea',
        border: 'rgba(0,0,0,0.07)',
        btnColor: 'rgba(0,0,0,0.6)',
        nameColor: '#444',
        ctxBg: 'rgba(250,250,248,0.95)',
        ctxBorder: 'rgba(0,0,0,0.09)',
        saveDdBg: 'rgba(240,240,238,0.98)',
        saveDdColor: '#222', saveDdHover: 'rgba(0,0,0,0.07)',
        ctxShadow: '0 4px 20px rgba(0,0,0,0.12)',
        tempStroke: 'rgba(0,0,0,0.35)',
        selBorder: 'rgba(0,0,0,0.25)',
        selGlow: 'rgba(0,111,238,0.35)',   // 화이트보드: 흰 빛은 안 보여 파란 빛으로
      },
    };

    // 4색 팔레트 — 기본색은 보드 타입에 따라 다름
    function getPalette(type) {
      return [type === 'whiteboard' ? '#111111' : '#ffffff', '#ffd60a', '#ff79c6', '#74d7ff'];
    }

    /* ── Data helpers ── */
    const getData = () => {
      try {
        const d = JSON.parse(localStorage.getItem(SK) || '{"boards":[]}');
        if (d && Array.isArray(d.boards)) return d;
      } catch (e) { console.warn('[chalkboard] 저장 데이터를 읽지 못했어요:', e); }
      return { boards: [] };
    };
    const saveData = d => {
      try { localStorage.setItem(SK, JSON.stringify(d)); }
      catch (e) {
        console.warn('[chalkboard] 저장 실패:', e);
        if (typeof showToast === 'function') showToast('저장 공간이 부족해 저장하지 못했어요', 'error');
      }
    };
    const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
    function getBoard() {
      if (viewOnlyBoard) return viewOnlyBoard;
      return getData().boards.find(b => b.id === currentBoardId) || null;
    }
    function saveBoard(b) {
      if (viewOnlyBoard) return;
      const d = getData();
      const i = d.boards.findIndex(x => x.id === b.id);
      if (i >= 0) d.boards[i] = b; else d.boards.push(b);
      saveData(d);
      // '자동 저장됨' 표시를 잠깐 진하게
      const st = document.getElementById('autosave-status');
      if (st) {
        st.classList.add('flash');
        clearTimeout(st._flashTimer);
        st._flashTimer = setTimeout(() => st.classList.remove('flash'), 900);
      }
      updateEmptyHint();
    }
    function fmtDate(ts) {
      if (!ts) return '';
      return new Date(ts).toLocaleDateString('ko-KR', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    }
    function esc(s) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    /* ── State ── */
    let currentBoardId = null;
    let mode = 'select'; // 'select' | 'add-text' | 'draw-line'
    let selectedId = null;
    let selectedType = null; // 'text' | 'line'
    let colorRowOpen = false;
    let newBoardType = 'chalkboard';
    // 선 긋기 중 보이는 점선(임시 선)
    let tempLine = null;
    // undo history
    let undoStack = [];
    // copy-paste clipboard
    let clipboard = null;
    // view-only share mode
    let viewOnlyBoard = null;
    let _pendingShared = null;
    const UNDO_MAX = 50;

    function pushHistory() {
      const board = getBoard();
      if (!board) return;
      undoStack.push(JSON.parse(JSON.stringify(board.elements)));
      if (undoStack.length > UNDO_MAX) undoStack.shift();
    }

    function undoLast() {
      if (viewOnlyBoard) return;
      if (!undoStack.length) { showToast('더 이상 되돌릴 수 없어요'); return; }
      const snapshot = undoStack.pop();
      const board = getBoard();
      if (!board) return;
      board.elements = snapshot;
      board.lastEdited = Date.now();
      saveBoard(board);
      deselectAll();
      renderAll();
      showToast('되돌렸어요');
    }

    /* ── Views ── */
    function showView(name) {
      document.getElementById('view-home').classList.toggle('active', name === 'home');
      const vb = document.getElementById('view-board');
      if (name === 'board') {
        vb.classList.add('active');
        document.body.classList.add('in-board');
      } else {
        vb.classList.remove('active');
        document.body.classList.remove('in-board');
        document.body.classList.remove('board-white');
      }
    }

    /* ── Home ── */
    function renderHome() {
      const d = getData();
      const el = document.getElementById('board-list');
      if (!d.boards.length) {
        el.innerHTML = '<div class="empty-state"><div class="empty-icon">' + VUI.icon('pencil-line') + '</div><div class="empty-text">아직 보드가 없어요. 위의 ‘새 보드’를 눌러 만들어 보세요.</div></div>';
        return;
      }
      el.innerHTML = d.boards.slice().reverse().map(b => {
        const type = (b.type && BS[b.type]) ? b.type : 'chalkboard';
        const s = BS[type];
        const texts = b.elements ? b.elements.filter(e => e.type === 'text') : [];
        const topLeftText = texts.slice().sort((a, b2) => a.y !== b2.y ? a.y - b2.y : a.x - b2.x)[0];
        const thumbContent = topLeftText
          ? `<span class="board-preview-text" style="color:${esc(topLeftText.color)}">${esc(topLeftText.text)}</span>`
          : `<span class="board-preview-text" style="opacity:0.4;color:${type === 'chalkboard' ? '#c8ddd0' : '#888'}">${esc(b.name)}</span>`;
        const typeLabel = type === 'chalkboard' ? '칠판' : '화이트보드';
        return `
        <div class="board-card">
          <div class="board-thumb" style="background:${s.bg}" aria-hidden="true">${thumbContent}</div>
          <div class="board-info-row">
            <div class="board-info">
              <button type="button" class="board-open" onclick="openBoard('${esc(b.id)}')">${esc(b.name)}</button>
              <div class="board-meta">${typeLabel} · ${fmtDate(b.lastEdited)} · 요소 ${(b.elements||[]).filter(e=>e.type).length}개</div>
            </div>
            <button class="board-del" onclick="deleteBoard(event,'${esc(b.id)}')" aria-label="${esc(b.name)} 삭제">${VUI.icon('trash-2')}</button>
          </div>
        </div>`;
      }).join('');
    }

    /* ── New board modal ── */
    const newModal = VUI.modal.bind('#modal-new', { className: 'active', backdropClose: true, dialog: '#modal-new .modal-box', initialFocus: '#new-board-name' });
    function openNewModal() {
      newBoardType = 'chalkboard';
      document.getElementById('new-board-name').value = '';
      selectNewType('chalkboard');
      newModal.open();
    }
    function closeNewModal() { newModal.close(); }
    function selectNewType(t) {
      newBoardType = t;
      document.getElementById('opt-chalk').classList.toggle('sel', t === 'chalkboard');
      document.getElementById('opt-white').classList.toggle('sel', t === 'whiteboard');
      document.getElementById('opt-chalk').setAttribute('aria-pressed', String(t === 'chalkboard'));
      document.getElementById('opt-white').setAttribute('aria-pressed', String(t === 'whiteboard'));
    }
    function createBoard() {
      const nm = document.getElementById('new-board-name').value.trim() || (newBoardType === 'chalkboard' ? '새 칠판' : '새 화이트보드');
      const board = { id: uid(), name: nm, type: newBoardType, createdAt: Date.now(), lastEdited: Date.now(), elements: [] };
      const d = getData(); d.boards.push(board); saveData(d);
      closeNewModal();
      openBoard(board.id);
    }
    async function deleteBoard(e, id) {
      e.stopPropagation();
      const target = getData().boards.find(b => b.id === id);
      const ok = await VUI.confirm(
        target ? `‘${target.name}’ 보드를 지울까요? 지운 보드는 되살릴 수 없어요.` : '이 보드를 지울까요?',
        { title: '보드 삭제', ok: '삭제', danger: true });
      if (!ok) return;
      const d = getData(); d.boards = d.boards.filter(b => b.id !== id); saveData(d);
      renderHome();
      showToast('보드를 지웠어요');
    }

    /* ── Open board ── */
    function openBoard(id) {
      currentBoardId = id;
      undoStack = [];
      mode = 'select'; selectedId = null; selectedType = null;
      colorRowOpen = false;
      const board = getBoard();
      if (!board) { showView('home'); renderHome(); return; }
      if (!board.type || !BS[board.type]) board.type = 'chalkboard'; // 구형 데이터 보정
      showView('board');
      document.body.classList.toggle('is-view-only', !!viewOnlyBoard);
      applyBoardStyle(board);
      document.getElementById('tb-name').value = board.name;
      resetView();
      renderAll();
      updateTbState();
      hideCtx();
      updateEmptyHint();
      // 큰 화면(전자칠판)에서 만든 보드가 이 화면을 넘치면 처음부터 모두 보이게 줄여 보여 줌
      if (contentOverflows()) fitView(true);
    }

    function goHome() {
      viewOnlyBoard = null;
      document.body.classList.remove('is-view-only');
      undoStack = [];
      cancelDraw();
      mode = 'select';
      resetView();
      showView('home');
      renderHome();
    }

    /* ── Board style ── */
    function applyBoardStyle(board) {
      const s = BS[board.type];
      const tb = document.getElementById('cb-tb');
      tb.style.background = s.tb;
      tb.style.borderBottomColor = s.border;
      document.getElementById('cb-canvas').style.background = s.bg;
      document.querySelectorAll('#cb-tb .tb-btn, #btn-back').forEach(b => {
        b.style.color = s.btnColor;
        b.style.borderColor = s.border;
      });
      document.getElementById('tb-name').style.color = s.nameColor;
      document.getElementById('autosave-status').style.color = s.btnColor;
      document.getElementById('btn-view-badge').style.color = s.btnColor;
      document.getElementById('btn-back').style.color = s.btnColor;
      document.getElementById('btn-back').style.borderColor = s.border;
      // 지금 상태(칠판/화이트보드)는 버튼 글자·색 점으로, 누르면 바뀌는 것은 aria-label·더보기 메뉴 글자로
      const isChalk = board.type === 'chalkboard';
      const other = isChalk ? '화이트보드' : '칠판';
      document.getElementById('type-label').textContent = isChalk ? '칠판' : '화이트보드';
      document.getElementById('btn-type').setAttribute('aria-label', `지금 ${isChalk ? '칠판' : '화이트보드'} — 눌러서 ${other}로 바꾸기`);
      document.getElementById('type-dot').style.background = s.bg;
      document.getElementById('more-type-label').textContent = `${other}로 바꾸기`;
      document.getElementById('more-type-dot').style.background = BS[isChalk ? 'whiteboard' : 'chalkboard'].bg;
      document.getElementById('cb-empty-hint').style.color = s.nameColor;
      document.body.classList.toggle('board-white', board.type === 'whiteboard');
    }

    /* ── Board type switch ── */
    function switchBoardType() {
      if (viewOnlyBoard) return;
      const board = getBoard(); if (!board) return;
      const oldDef = getPalette(board.type)[0];
      const newType = board.type === 'chalkboard' ? 'whiteboard' : 'chalkboard';
      const newDef = getPalette(newType)[0];
      pushHistory();
      board.elements = board.elements.map(el => ({ ...el, color: el.color === oldDef ? newDef : el.color }));
      board.type = newType; board.lastEdited = Date.now();
      saveBoard(board);
      applyBoardStyle(board);
      renderAll(); hideCtx();
    }

    function renameCurrent(name) {
      if (viewOnlyBoard) return;
      const board = getBoard(); if (!board || !name.trim()) return;
      board.name = name.trim(); board.lastEdited = Date.now();
      saveBoard(board);
    }

    /* ── Render ── */
    function renderAll() { renderLines(); renderTexts(); }

    function renderLines() {
      const svg = document.getElementById('cb-svg');
      svg.querySelectorAll('.cb-line-g').forEach(g => g.remove());
      const board = getBoard(); if (!board) return;
      board.elements.filter(el => el.type === 'line').forEach(buildLineEl);
    }

    function buildLineEl(el) {
      const svg = document.getElementById('cb-svg');
      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      g.setAttribute('class', 'cb-line-g');
      g.dataset.id = el.id;

      // Selection glow
      if (selectedId === el.id) {
        const glow = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        ['x1','y1','x2','y2'].forEach(a => glow.setAttribute(a, el[a]));
        const gb = getBoard();
        glow.setAttribute('stroke', (gb && BS[gb.type] ? BS[gb.type] : BS.chalkboard).selGlow);
        glow.setAttribute('stroke-width', '9');
        glow.setAttribute('stroke-linecap', 'round');
        g.appendChild(glow);
      }

      // Hit zone (transparent, wide)
      const hit = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      ['x1','y1','x2','y2'].forEach(a => hit.setAttribute(a, el[a]));
      hit.setAttribute('stroke', 'transparent');
      hit.setAttribute('stroke-width', String(22 / view.s));   // 줄여 볼 때도 누르기 쉬운 폭 유지
      hit.setAttribute('stroke-linecap', 'round');
      hit.style.cursor = selectedId === el.id ? 'grab' : 'pointer';

      // Visible line
      const vis = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      ['x1','y1','x2','y2'].forEach(a => vis.setAttribute(a, el[a]));
      vis.setAttribute('stroke', el.color);
      vis.setAttribute('stroke-width', selectedId === el.id ? '5' : '3');
      vis.setAttribute('stroke-linecap', 'round');

      g.appendChild(hit);
      g.appendChild(vis);
      svg.appendChild(g);

      // 누르기·끌기·두 번 누르기는 캔버스의 포인터 처리(아래 'Pointer 입력')가 맡음
    }

    function renderTexts() {
      const canvas = document.getElementById('cb-canvas');
      canvas.querySelectorAll('.cb-el').forEach(d => d.remove());
      const board = getBoard(); if (!board) return;
      board.elements.filter(el => el.type === 'text').forEach(buildTextEl);
    }

    function buildTextEl(el) {
      const stage = document.getElementById('cb-stage');
      const div = document.createElement('div');
      div.className = 'cb-el' + (selectedId === el.id ? ' selected' : '');
      div.dataset.id = el.id;
      div.style.left = el.x + 'px';
      div.style.top = el.y + 'px';
      div.style.fontSize = el.size + 'px';
      div.style.color = el.color;
      if (selectedId === el.id) {
        const board = getBoard();
        div.style.borderColor = BS[board.type].selBorder;
      }
      div.textContent = el.text;
      // 키보드: Tab으로 고르고 Enter(F2)로 편집, Delete로 삭제(아래 전역 키 처리)
      div.tabIndex = 0;
      div.addEventListener('focus', () => {
        if (!gesture && !div.isContentEditable && selectedId !== el.id) selectEl(el.id, 'text');
      });
      div.addEventListener('keydown', e => {
        if (div.isContentEditable || viewOnlyBoard) return;
        if (e.key === 'Enter' || e.key === 'F2') { e.preventDefault(); selectEl(el.id, 'text'); startEdit(el.id); }
      });
      stage.appendChild(div);
    }

    /* ── Selection ── */
    function selectEl(id, type) {
      selectedId = id; selectedType = type; colorRowOpen = false;
      document.querySelectorAll('.cb-el').forEach(d => {
        const sel = d.dataset.id === id;
        d.classList.toggle('selected', sel);
        if (sel) {
          const board = getBoard();
          d.style.borderColor = board ? BS[board.type].selBorder : 'rgba(255,255,255,0.35)';
        } else {
          d.style.borderColor = 'transparent';
        }
      });
      // Re-render lines to show selection glow
      renderLines();
      showCtx(id, type);
    }

    function deselectAll() {
      selectedId = null; selectedType = null; colorRowOpen = false;
      document.querySelectorAll('.cb-el').forEach(d => {
        d.classList.remove('selected');
        d.style.borderColor = 'transparent';
      });
      renderLines();
      hideCtx();
    }

    /* ── Context menu ── */
    function showCtx(id, type) {
      if (viewOnlyBoard) return;
      const board = getBoard();
      const el = board.elements.find(e => e.id === id);
      if (!el) return;
      const s = BS[board.type];
      const ctx = document.getElementById('cb-ctx');
      ctx.style.background = s.ctxBg;
      ctx.style.borderColor = s.ctxBorder;
      ctx.style.boxShadow = s.ctxShadow;

      const main = document.getElementById('ctx-main');
      const colRow = document.getElementById('ctx-colors');
      main.innerHTML = '';
      colRow.style.display = 'none';
      colRow.innerHTML = '';

      function mkBtn(html, title, cls, fn) {
        const b = document.createElement('button');
        b.className = 'ctx-btn' + (cls ? ' ' + cls : '');
        b.innerHTML = html;
        b.title = title;
        b.setAttribute('aria-label', title);
        b.onclick = e => { e.stopPropagation(); fn(e); };
        return b;
      }

      if (type === 'text') {
        main.appendChild(mkBtn(VUI.icon('a-arrow-down'), '글자 작게', '', () => changeSize(id, -1)));
        main.appendChild(mkBtn(VUI.icon('a-arrow-up'), '글자 크게', '', () => changeSize(id, 1)));
      }

      // Color button — dot colored with current element color
      const colBtn = mkBtn('<span class="ctx-dot" aria-hidden="true"></span>', '색상', '', () => toggleColorRow(id, type));
      colBtn.setAttribute('aria-expanded', 'false');
      colBtn.style.color = el.color;
      main.appendChild(colBtn);

      if (type === 'text') {
        main.appendChild(mkBtn(
          VUI.icon('pencil'),
          '편집', '', () => startEdit(id)));
      }

      main.appendChild(mkBtn(
        VUI.icon('trash-2'),
        '삭제', 'ctx-del', () => deleteEl(id, true)));

      ctx.style.display = 'flex';
      positionCtx(id, type);   // 보이게 한 뒤 크기를 재서 화면 안에 둠
    }

    function toggleColorRow(id, type) {
      const colRow = document.getElementById('ctx-colors');
      colorRowOpen = !colorRowOpen;
      const colBtn = document.querySelector('#ctx-main .ctx-btn[title="색상"]');
      if (colBtn) colBtn.setAttribute('aria-expanded', String(colorRowOpen));
      if (!colorRowOpen) { colRow.style.display = 'none'; return; }

      const board = getBoard();
      const el = board.elements.find(e => e.id === id);
      const palette = getPalette(board.type);
      colRow.innerHTML = '';

      const COLOR_NAMES = ['기본색', '노랑', '분홍', '하늘'];
      palette.forEach((color, ci) => {
        const b = document.createElement('button');
        b.className = 'ctx-btn ctx-swatch' + (el.color === color ? ' cur' : '');
        b.dataset.color = color;
        b.setAttribute('aria-label', COLOR_NAMES[ci] || color);
        b.setAttribute('aria-pressed', String(el.color === color));
        b.style.cssText = `background:${color};width:40px;height:40px;border-radius:50%;font-size:0;`;
        // Light swatches need a visible border
        if (color === '#ffffff' || color === '#f7f7f4') b.style.border = '2px solid rgba(150,150,150,0.4)';
        else if (color === '#111111') b.style.border = '2px solid rgba(80,80,80,0.3)';
        b.onclick = e => { e.stopPropagation(); setElColor(id, color); };
        colRow.appendChild(b);
      });

      colRow.style.display = 'flex';
      positionCtx(id, type);   // 색 줄이 생기며 커진 메뉴가 화면 밖으로 나가지 않게
    }

    function positionCtx(id, type) {
      const ctx = document.getElementById('cb-ctx');
      let x, y;
      if (type === 'text') {
        const div = document.querySelector(`.cb-el[data-id="${id}"]`);
        if (!div) return;
        const r = div.getBoundingClientRect();
        x = r.left;
        y = r.top - 56;
        if (y < 60) y = r.bottom + 8;
      } else {
        const board = getBoard();
        const el = board.elements.find(e => e.id === id);
        if (!el) return;
        // 보드 좌표 → 화면 좌표('화면에 맞추기'로 줄였을 때도 맞게)
        const cr = document.getElementById('cb-canvas').getBoundingClientRect();
        const sx = v => cr.left + view.tx + v * view.s;
        const sy = v => cr.top + view.ty + v * view.s;
        x = (sx(el.x1) + sx(el.x2)) / 2 - 40;
        y = sy(Math.min(el.y1, el.y2)) - 56;
        if (y < 60) y = sy(Math.max(el.y1, el.y2)) + 12;
      }
      // 메뉴 실제 크기로 화면(가로·세로) 안에 가둠
      const w = ctx.offsetWidth || 220, h = ctx.offsetHeight || 56;
      const vw = window.innerWidth, vh = window.innerHeight;
      x = Math.max(8, Math.min(x, vw - w - 8));
      y = Math.max(8, Math.min(y, vh - h - 8));
      ctx.style.left = x + 'px';
      ctx.style.top = y + 'px';
    }

    function hideCtx() {
      document.getElementById('cb-ctx').style.display = 'none';
      colorRowOpen = false;
    }

    /* ── Element operations ── */
    function changeSize(id, delta) {
      const board = getBoard();
      const el = board.elements.find(e => e.id === id);
      if (!el || el.type !== 'text') return;
      let idx = SIZES.indexOf(el.size);
      if (idx < 0) idx = SIZES.findIndex(s => s >= el.size);
      if (idx < 0) idx = 3;
      idx = Math.max(0, Math.min(SIZES.length - 1, idx + delta));
      pushHistory();
      el.size = SIZES[idx];
      board.lastEdited = Date.now();
      saveBoard(board);
      const div = document.querySelector(`.cb-el[data-id="${id}"]`);
      if (div) div.style.fontSize = el.size + 'px';
      // Reposition ctx after size change
      setTimeout(() => positionCtx(id, 'text'), 0);
    }

    function setElColor(id, color) {
      const board = getBoard();
      const el = board.elements.find(e => e.id === id);
      if (!el) return;
      pushHistory();
      el.color = color;
      board.lastEdited = Date.now();
      saveBoard(board);
      if (el.type === 'text') {
        const div = document.querySelector(`.cb-el[data-id="${id}"]`);
        if (div) div.style.color = color;
      } else {
        renderLines();
      }
      // Update color dot and swatches
      // Update main color dot
      document.querySelectorAll('#ctx-main .ctx-btn').forEach(b => {
        if (b.title === '색상') { b.style.color = color; }
      });
      document.querySelectorAll('#ctx-colors .ctx-swatch').forEach(s => {
        s.classList.toggle('cur', s.dataset.color === color);
        s.setAttribute('aria-pressed', String(s.dataset.color === color));
      });
    }

    // notify: 메뉴·Delete 키로 지웠을 때 '되돌리기' 버튼이 있는 알림을 띄움
    function deleteEl(id, notify) {
      if (viewOnlyBoard) return;
      const board = getBoard();
      pushHistory();
      board.elements = board.elements.filter(e => e.id !== id);
      board.lastEdited = Date.now();
      saveBoard(board);
      renderAll(); deselectAll();
      if (notify) VUI.toast('지웠어요', { duration: 6000, action: { label: '되돌리기', onClick: undoLast } });
    }

    /* ── Text editing ── */
    // 새 글자 크기: 화면 크기에 비례(전자칠판 80px, 휴대폰 32px 정도). 줄여 보는 중이면 보이는 크기 기준
    function defaultTextSize() {
      const r = document.getElementById('cb-canvas').getBoundingClientRect();
      const target = Math.max(SIZES[0], Math.min(80, Math.min(r.width, r.height) * 0.08)) / view.s;
      let size = SIZES[0];
      SIZES.forEach(v => { if (v <= target) size = v; });
      return size;
    }
    function addText(x, y) {
      if (viewOnlyBoard) return;
      const board = getBoard();
      const size = defaultTextSize();
      // 누른 곳이 글자 첫머리 가운데쯤 오게
      const el = { id: uid(), type: 'text', x: Math.round(x - size * 0.75), y: Math.round(y - size * 0.4), text: '텍스트', color: getPalette(board.type)[0], size };
      pushHistory();
      board.elements.push(el);
      board.lastEdited = Date.now();
      saveBoard(board);
      buildTextEl(el);
      selectEl(el.id, 'text');
      startEdit(el.id);
    }

    function startEdit(id) {
      hideCtx();
      const div = document.querySelector(`.cb-el[data-id="${id}"]`);
      if (!div) return;
      div.contentEditable = 'true';
      div.style.cursor = 'text';
      div.focus();
      const range = document.createRange();
      range.selectNodeContents(div);
      const sel = window.getSelection();
      sel.removeAllRanges(); sel.addRange(range);

      // 이전 편집에서 남은 핸들러가 있으면 정리
      if (div._editCleanup) div._editCleanup();
      const endFn = () => endEdit(id);
      // 편집이 끝날 때까지 모든 키 입력을 살핌 (한글 조합 중 Enter는 무시)
      const keyFn = e => {
        if (e.isComposing || e.keyCode === 229) return;
        if (e.key === 'Escape') { e.preventDefault(); endEdit(id); }
        else if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); endEdit(id); }
      };
      div.addEventListener('blur', endFn);
      div.addEventListener('keydown', keyFn);
      div._editCleanup = () => {
        div.removeEventListener('blur', endFn);
        div.removeEventListener('keydown', keyFn);
        div._editCleanup = null;
      };
    }

    function endEdit(id) {
      const div = document.querySelector(`.cb-el[data-id="${id}"]`);
      if (!div || div.contentEditable !== 'true') return;
      if (div._editCleanup) div._editCleanup();
      div.contentEditable = 'false';
      div.style.cursor = '';
      const board = getBoard();
      const el = board.elements.find(e => e.id === id);
      if (!el) return;
      const txt = div.innerText.trim();
      if (!txt) { deleteEl(id); return; }   // 글자를 모두 지우면 요소도 지움(알림 없음)
      pushHistory();
      el.text = txt;
      board.lastEdited = Date.now();
      saveBoard(board);
      selectEl(id, 'text');
    }

    /* ── Toolbar modes ── */
    // 버튼 설명(예전 title)을 터치 기기에서도 보이게: 모드를 처음 켤 때 한 번 알려 줌
    const modeHintShown = {};
    function modeHint(m, msg) {
      if (modeHintShown[m]) return;
      modeHintShown[m] = true;
      showToast(msg);
    }
    function activateTextMode() {
      mode = mode === 'add-text' ? 'select' : 'add-text';
      if (mode !== 'add-text') cancelDraw();
      else modeHint('add-text', '보드에서 글자를 넣을 곳을 누르세요');
      updateTbState();
    }
    function activateDrawMode() {
      mode = mode === 'draw-line' ? 'select' : 'draw-line';
      if (mode === 'draw-line') { deselectAll(); modeHint('draw-line', '보드에서 끌어서 선을 그으세요'); }
      else cancelDraw();
      updateTbState();
    }

    function updateTbState() {
      document.getElementById('btn-add-text').classList.toggle('on', mode === 'add-text');
      document.getElementById('btn-draw').classList.toggle('on', mode === 'draw-line');
      document.getElementById('btn-add-text').setAttribute('aria-pressed', String(mode === 'add-text'));
      document.getElementById('btn-draw').setAttribute('aria-pressed', String(mode === 'draw-line'));
      const canvas = document.getElementById('cb-canvas');
      canvas.className = mode === 'add-text' ? 'mode-text' : mode === 'draw-line' ? 'mode-line' : 'mode-select';
      // Visual active state on buttons
      const board = getBoard();
      const s = board ? BS[board.type] : null;
      const activeColor = board && board.type === 'whiteboard' ? 'rgba(0,0,0,0.12)' : 'rgba(255,255,255,0.15)';
      document.getElementById('btn-add-text').style.background = mode === 'add-text' ? activeColor : '';
      document.getElementById('btn-draw').style.background = mode === 'draw-line' ? activeColor : '';
      const fitBtn = document.getElementById('btn-fit');
      fitBtn.style.background = view.fitted ? activeColor : '';
      fitBtn.setAttribute('aria-pressed', String(view.fitted));
    }

    /* ── 화면에 맞추기 ──
       요소는 절대 px 좌표로 저장되어 있어(형식 유지), 큰 화면에서 만든 보드를 작은 화면에서 열면 잘림.
       저장 좌표는 그대로 두고 #cb-stage에 transform(translate+scale)만 걸어 모두 보이게 줄여 보여 줌.
       포인터 좌표는 toBoard()로 보드 좌표로 바꿔 쓰므로 줄인 상태에서도 쓰기·옮기기·편집이 그대로 됨. */
    const view = { s: 1, tx: 0, ty: 0, fitted: false };
    const FIT_PAD = 16;

    function toBoard(clientX, clientY) {
      const r = canvas.getBoundingClientRect();
      return { x: (clientX - r.left - view.tx) / view.s, y: (clientY - r.top - view.ty) / view.s };
    }

    // 모든 요소를 감싸는 사각형(보드 좌표). 글자는 실제 그려진 크기로 잼
    function contentBBox() {
      const board = getBoard();
      if (!board || !board.elements.length) return null;
      let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
      const add = (ax, ay, bx, by) => { x0 = Math.min(x0, ax); y0 = Math.min(y0, ay); x1 = Math.max(x1, bx); y1 = Math.max(y1, by); };
      board.elements.forEach(el => {
        if (el.type === 'line') {
          add(Math.min(el.x1, el.x2) - 4, Math.min(el.y1, el.y2) - 4, Math.max(el.x1, el.x2) + 4, Math.max(el.y1, el.y2) + 4);
        } else if (el.type === 'text') {
          const div = canvas.querySelector(`.cb-el[data-id="${el.id}"]`);
          const w = div ? div.offsetWidth : el.size * 4, h = div ? div.offsetHeight : el.size * 1.3;
          add(el.x, el.y, el.x + w, el.y + h);
        }
      });
      return isFinite(x0) ? { x0, y0, x1, y1 } : null;
    }

    function contentOverflows() {
      const b = contentBBox();
      if (!b) return false;
      const W = canvas.clientWidth, H = canvas.clientHeight;
      return b.x0 < 0 || b.y0 < 0 || b.x1 > W || b.y1 > H;
    }

    function applyView() {
      const stage = document.getElementById('cb-stage');
      const svg = document.getElementById('cb-svg');
      const W = canvas.clientWidth, H = canvas.clientHeight;
      if (!view.fitted) {
        stage.style.transform = '';
        stage.style.width = ''; stage.style.height = '';
        svg.style.left = ''; svg.style.top = ''; svg.style.width = ''; svg.style.height = '';
        svg.removeAttribute('viewBox');
      } else {
        stage.style.transform = `translate(${view.tx}px, ${view.ty}px) scale(${view.s})`;
        // 선 SVG는 보이는 영역 전체(보드 좌표)를 덮게 → 줄인 상태에서도 어디서나 선을 긋고 고를 수 있음
        const vx = -view.tx / view.s, vy = -view.ty / view.s, vw = W / view.s, vh = H / view.s;
        svg.style.left = vx + 'px'; svg.style.top = vy + 'px';
        svg.style.width = vw + 'px'; svg.style.height = vh + 'px';
        svg.setAttribute('viewBox', `${vx} ${vy} ${vw} ${vh}`);
      }
      updateTbState();
      renderLines();   // 선을 누르는 폭을 배율에 맞춤
    }

    function resetView() {
      view.s = 1; view.tx = 0; view.ty = 0; view.fitted = false;
      applyView();
    }

    // quiet: 보드를 열 때 자동으로 맞출 때는 알림만 짧게
    function fitView(quiet) {
      if (!getBoard()) return;
      hideCtx();
      const W = canvas.clientWidth, H = canvas.clientHeight;
      const stage = document.getElementById('cb-stage');
      // 글자 줄바꿈 폭(= 면의 폭)을 먼저 정함: 화면 폭과 요소 시작점 중 큰 쪽(작은 화면에서 글자가 한 글자씩 꺾이지 않게)
      const board = getBoard();
      let wrapW = W;
      board.elements.forEach(el => {
        if (el.type === 'text') wrapW = Math.max(wrapW, el.x + 320);
        else if (el.type === 'line') wrapW = Math.max(wrapW, el.x1, el.x2);
      });
      view.fitted = true;
      stage.style.width = Math.ceil(wrapW) + 'px';
      const b = contentBBox();
      if (!b) { resetView(); return; }
      const bw = Math.max(1, b.x1 - b.x0), bh = Math.max(1, b.y1 - b.y0);
      const s = Math.min(1, (W - FIT_PAD * 2) / bw, (H - FIT_PAD * 2) / bh);
      view.s = Math.max(0.05, s);
      // 내용이 화면보다 작으면 원래 자리 그대로, 크면 가운데에
      view.tx = bw * view.s <= W - FIT_PAD * 2 && b.x0 >= 0 && b.x1 <= W ? 0 : (W - bw * view.s) / 2 - b.x0 * view.s;
      view.ty = bh * view.s <= H - FIT_PAD * 2 && b.y0 >= 0 && b.y1 <= H ? 0 : (H - bh * view.s) / 2 - b.y0 * view.s;
      stage.style.height = Math.ceil(Math.max(H / view.s, b.y1)) + 'px';
      applyView();
      if (quiet) showToast(`큰 보드라 화면에 맞춰 ${Math.round(view.s * 100)}%로 보여요`);
    }

    function toggleFit() {
      if (!getBoard()) return;
      if (view.fitted) { resetView(); renderAll(); return; }
      if (!contentOverflows()) { showToast('모든 내용이 이미 화면에 보여요'); return; }
      fitView(false);
    }

    // 맞춘 상태에서 창 크기가 바뀌면(화면 회전 등) 다시 맞춤
    let _fitResizeTimer = null;
    window.addEventListener('resize', () => {
      if (!view.fitted) return;
      clearTimeout(_fitResizeTimer);
      _fitResizeTimer = setTimeout(() => { if (view.fitted && getBoard()) fitView(false); }, 200);
    });

    function updateEmptyHint() {
      const board = getBoard();
      const show = !!board && !viewOnlyBoard && !board.elements.length;
      document.getElementById('cb-empty-hint').classList.toggle('show', show);
    }

    /* ── Pointer 입력 (마우스·터치·펜 공통) ──
       전자칠판·태블릿에서도 똑같이 동작하도록 mouse* 대신 Pointer Events만 씀.
       - 한 번에 하나의 포인터만 따라감(pointerId). 긋는 중 들어온 두 번째 손가락은 무시
       - 캔버스에 setPointerCapture → 손가락이 요소 밖으로 나가도 끌기가 이어짐
       - 두 번 누르기 = 더블클릭(글자 편집, 선 메뉴), 길게 누르기(0.5초) = 터치용 오른쪽 클릭
       - 펜 압력은 쓰지 않음(선 굵기 일정) */
    const canvas = document.getElementById('cb-canvas');
    const LONG_PRESS_MS = 500;
    let gesture = null;  // 진행 중인 누르기 { pointerId, ptype, kind:'text'|'line'|'draw'|'bg', … }
    let lastTap = null;  // 두 번 누르기 판별 { id, t, x, y }

    function editingEl() {
      const a = document.activeElement;
      return a && a.classList && a.classList.contains('cb-el') && a.isContentEditable ? a : null;
    }
    function closeMenus() { closeMoreMenu(); closeSaveMenu(); closeShareMenu(); }
    function moveSlop(g) { return g.ptype === 'mouse' ? (g.kind === 'line' ? 4 : 5) : 8; }

    canvas.addEventListener('pointerdown', e => {
      // 편집 중인 글자 안: 커서 옮기기·글자 선택은 브라우저 기본 동작 그대로(화상 키보드도 유지)
      const ed = editingEl();
      if (ed && ed.contains(e.target)) return;
      if (gesture) {
        // 긋는·옮기는 중에 닿은 두 번째 손가락·손바닥은 무시
        if (e.pointerId !== gesture.pointerId) e.preventDefault();
        return;
      }
      if (!e.isPrimary || e.button !== 0) return;   // 오른쪽 버튼·펜 지우개 버튼은 contextmenu에서 처리
      closeMenus();
      const textDiv = e.target.closest('.cb-el');
      const lineG = e.target.closest('.cb-line-g');
      const textId = textDiv ? textDiv.dataset.id : null;
      const lineId = lineG ? lineG.dataset.id : null;
      // 터치 뒤 따라오는 mousedown(포커스 이동 → 편집 종료)과 글자 선택·길게 누르기 메뉴를 막음
      e.preventDefault();
      // 다른 곳을 누르면 편집을 마침(blur → endEdit). 이때 요소가 다시 그려질 수 있어 아래에서 id로 다시 찾음
      if (ed) ed.blur();
      const board = getBoard();
      if (!board) return;
      const bp = toBoard(e.clientX, e.clientY);   // 보드 좌표(화면에 맞춰 줄인 상태 포함)
      const g = {
        pointerId: e.pointerId, ptype: e.pointerType || 'mouse',
        sx: e.clientX, sy: e.clientY, px: bp.x, py: bp.y,
        moved: false, longPress: false, timer: null,
      };
      const div = textId ? canvas.querySelector(`.cb-el[data-id="${textId}"]`) : null;
      const lineEl = lineId ? board.elements.find(x => x.id === lineId) : null;
      if (div) {
        g.kind = 'text'; g.id = textId; g.div = div;
        g.ox = parseInt(div.style.left) || 0; g.oy = parseInt(div.style.top) || 0;
        g.draggable = !viewOnlyBoard;
      } else if (mode === 'draw-line' && !viewOnlyBoard) {
        g.kind = 'draw';
        const svg = document.getElementById('cb-svg');
        if (tempLine) tempLine.remove();
        tempLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        tempLine.id = 'cb-temp-line';
        tempLine.setAttribute('x1', g.px); tempLine.setAttribute('y1', g.py);
        tempLine.setAttribute('x2', g.px); tempLine.setAttribute('y2', g.py);
        tempLine.setAttribute('stroke', BS[board.type].tempStroke);
        tempLine.setAttribute('stroke-width', '3');
        tempLine.setAttribute('stroke-linecap', 'round');
        tempLine.setAttribute('stroke-dasharray', '7 5');
        svg.appendChild(tempLine);
      } else if (lineEl && mode === 'select') {
        g.kind = 'line'; g.id = lineId;
        g.o = { x1: lineEl.x1, y1: lineEl.y1, x2: lineEl.x2, y2: lineEl.y2 };
        g.draggable = !viewOnlyBoard;
      } else {
        g.kind = 'bg';
      }
      // 길게 누르기(터치·펜): 0.5초 동안 거의 움직이지 않으면 선택해 보여 주고, 손을 떼면 편집/메뉴
      if ((g.kind === 'text' || g.kind === 'line') && g.ptype !== 'mouse' && !viewOnlyBoard) {
        g.timer = setTimeout(() => {
          if (gesture !== g || g.moved) return;
          g.longPress = true;
          selectEl(g.id, g.kind);
          if (navigator.vibrate) { try { navigator.vibrate(15); } catch (_) {} }
        }, LONG_PRESS_MS);
      }
      gesture = g;
      try { canvas.setPointerCapture(e.pointerId); } catch (_) {}
    });

    window.addEventListener('pointermove', e => {
      const g = gesture;
      if (!g || e.pointerId !== g.pointerId) return;
      const dx = e.clientX - g.sx, dy = e.clientY - g.sy;
      const bdx = dx / view.s, bdy = dy / view.s;   // 끈 거리(보드 좌표)
      if (!g.moved && !g.longPress && (Math.abs(dx) > moveSlop(g) || Math.abs(dy) > moveSlop(g))) {
        g.moved = true;
        clearTimeout(g.timer);
        if (g.kind === 'text' || g.kind === 'line') hideCtx();
        if (g.kind === 'text' && g.draggable) g.div.classList.add('dragging');
      }
      if (g.kind === 'draw' && tempLine) {
        const p = toBoard(e.clientX, e.clientY);
        tempLine.setAttribute('x2', p.x);
        tempLine.setAttribute('y2', p.y);
      } else if (g.moved && g.draggable && g.kind === 'text') {
        g.div.style.left = (g.ox + bdx) + 'px';
        g.div.style.top = (g.oy + bdy) + 'px';
      } else if (g.moved && g.draggable && g.kind === 'line') {
        const lg = document.querySelector(`#cb-svg .cb-line-g[data-id="${g.id}"]`);
        if (lg) lg.querySelectorAll('line').forEach(l => {
          l.setAttribute('x1', g.o.x1 + bdx); l.setAttribute('y1', g.o.y1 + bdy);
          l.setAttribute('x2', g.o.x2 + bdx); l.setAttribute('y2', g.o.y2 + bdy);
        });
      }
    });

    function endGesture(g) {
      clearTimeout(g.timer);
      if (gesture === g) gesture = null;
      try { if (canvas.hasPointerCapture(g.pointerId)) canvas.releasePointerCapture(g.pointerId); } catch (_) {}
      if (g.div) g.div.classList.remove('dragging');
    }

    window.addEventListener('pointerup', e => {
      const g = gesture;
      if (!g || e.pointerId !== g.pointerId) return;
      endGesture(g);
      const board = getBoard();
      if (!board) return;
      const dx = (e.clientX - g.sx) / view.s, dy = (e.clientY - g.sy) / view.s;   // 보드 좌표
      if (g.kind === 'draw') {
        // 끝점은 보이는 영역 안으로(보드 좌표)
        const r = canvas.getBoundingClientRect();
        const p = toBoard(Math.max(r.left, Math.min(e.clientX, r.right)), Math.max(r.top, Math.min(e.clientY, r.bottom)));
        const x2 = Math.round(p.x), y2 = Math.round(p.y);
        if (tempLine) { tempLine.remove(); tempLine = null; }
        if (Math.hypot(x2 - g.px, y2 - g.py) * view.s < 8) return;
        const el = { id: uid(), type: 'line', x1: Math.round(g.px), y1: Math.round(g.py), x2, y2, color: getPalette(board.type)[0] };
        pushHistory();
        board.elements.push(el);
        board.lastEdited = Date.now();
        saveBoard(board);
        buildLineEl(el);
        return;
      }
      if (g.kind === 'bg') {
        if (g.moved) return;
        if (mode === 'add-text') {
          addText(g.px, g.py);   // pointerup 안에서 focus → 터치 기기에서도 화상 키보드가 뜸
          mode = 'select'; updateTbState();
        } else if (mode === 'select') {
          deselectAll();
        }
        return;
      }
      if (g.moved && g.draggable) {
        const el = board.elements.find(x => x.id === g.id);
        if (el) {
          pushHistory();
          const rx = Math.round(dx), ry = Math.round(dy);
          if (g.kind === 'text') { el.x = g.ox + rx; el.y = g.oy + ry; g.div.style.left = el.x + 'px'; g.div.style.top = el.y + 'px'; }
          else { el.x1 = g.o.x1 + rx; el.y1 = g.o.y1 + ry; el.x2 = g.o.x2 + rx; el.y2 = g.o.y2 + ry; }
          board.lastEdited = Date.now();
          saveBoard(board);
        }
        selectEl(g.id, g.kind);
        return;
      }
      if (g.moved) return;
      if (g.longPress) { lastTap = null; secondaryAction(g.id, g.kind); return; }
      // 짧은 시간 안에 같은 요소를 또 누르면 두 번 누르기(마우스는 더블클릭과 같은 동작)
      const now = Date.now();
      const isDouble = lastTap && lastTap.id === g.id &&
        now - lastTap.t < (g.ptype === 'mouse' ? 500 : 450) &&
        Math.hypot(e.clientX - lastTap.x, e.clientY - lastTap.y) < (g.ptype === 'mouse' ? 10 : 30);
      if (isDouble) { lastTap = null; secondaryAction(g.id, g.kind); return; }
      lastTap = { id: g.id, t: now, x: e.clientX, y: e.clientY };
      selectEl(g.id, g.kind);
    });

    window.addEventListener('pointercancel', e => {
      const g = gesture;
      if (!g || e.pointerId !== g.pointerId) return;
      endGesture(g);
      if (g.kind === 'draw') cancelDraw();
      else if (g.kind === 'text' && g.moved) { g.div.style.left = g.ox + 'px'; g.div.style.top = g.oy + 'px'; }
      else if (g.kind === 'line' && g.moved) renderLines();
    });

    // 두 번 누르기·길게 누르기: 글자는 편집, 선은 메뉴
    function secondaryAction(id, kind) {
      selectEl(id, kind);
      if (viewOnlyBoard) return;
      if (kind === 'text') startEdit(id);
      else showCtx(id, 'line');
    }

    // 캔버스 안의 클릭은 위 Pointer 처리가 모두 맡음(바깥 클릭 처리기가 방금 한 선택을 지우지 않게)
    canvas.addEventListener('click', e => e.stopPropagation());
    // 길게 누르기 메뉴(모바일)·오른쪽 클릭: 편집 중인 글자 안에서는 기본 메뉴(붙여넣기 등) 유지
    canvas.addEventListener('contextmenu', e => {
      const ed = editingEl();
      if (ed && ed.contains(e.target)) return;
      e.preventDefault();
      if (gesture) return;   // 터치 길게 누르기는 위에서 처리
      const t = e.target.closest('.cb-el');
      const l = e.target.closest('.cb-line-g');
      if (t) selectEl(t.dataset.id, 'text');
      else if (l && mode === 'select') selectEl(l.dataset.id, 'line');
    });

    function cancelDraw() {
      if (gesture && gesture.kind === 'draw') endGesture(gesture);
      if (tempLine) { tempLine.remove(); tempLine = null; }
    }

    /* ── Save dropdown ── */
    let saveMenuOpen = false;

    let moreMenuOpen = false;
    function toggleMoreMenu(e) {
      e.stopPropagation();
      if (!getBoard()) return;
      moreMenuOpen = !moreMenuOpen;
      const dd = document.getElementById('more-dropdown');
      document.getElementById('btn-more').setAttribute('aria-expanded', String(moreMenuOpen));
      if (!moreMenuOpen) { dd.classList.remove('open'); return; }
      const board = getBoard();
      const s = board ? BS[board.type] : BS.chalkboard;
      dd.style.background = s.saveDdBg;
      dd.style.borderColor = s.ctxBorder;
      dd.style.boxShadow = s.ctxShadow;
      dd.querySelectorAll('.save-opt').forEach(b => {
        b.style.color = s.saveDdColor;
        b.onmouseenter = () => b.style.background = s.saveDdHover;
        b.onmouseleave = () => b.style.background = 'transparent';
      });
      dd.style.color = s.saveDdColor;   // '자동 저장돼요' 안내 글자색
      loadQR();
      const btn = document.getElementById('btn-more');
      const r = btn.getBoundingClientRect();
      dd.style.left = Math.max(8, r.right - 170) + 'px';
      dd.style.top = (r.bottom + 4) + 'px';
      dd.classList.add('open');
    }
    function closeMoreMenu() {
      moreMenuOpen = false;
      document.getElementById('btn-more').setAttribute('aria-expanded', 'false');
      document.getElementById('more-dropdown').classList.remove('open');
    }

    function toggleSaveMenu(e) {
      e.stopPropagation();
      saveMenuOpen = !saveMenuOpen;
      const dd = document.getElementById('save-dropdown');
      document.getElementById('btn-save').setAttribute('aria-expanded', String(saveMenuOpen));
      if (!saveMenuOpen) { dd.classList.remove('open'); return; }
      // Style by board type
      const board = getBoard();
      const s = board ? BS[board.type] : BS.chalkboard;
      dd.style.background = s.saveDdBg;
      dd.style.borderColor = s.ctxBorder;
      dd.style.boxShadow = s.ctxShadow;
      dd.querySelectorAll('.save-opt').forEach(b => {
        b.style.color = s.saveDdColor;
        b.onmouseenter = () => b.style.background = s.saveDdHover;
        b.onmouseleave = () => b.style.background = 'transparent';
      });
      // Position below btn-save
      const btn = document.getElementById('btn-save');
      const r = btn.getBoundingClientRect();
      dd.style.left = Math.max(8, r.right - 160) + 'px';
      dd.style.top = (r.bottom + 4) + 'px';
      dd.classList.add('open');
    }

    function closeSaveMenu() {
      saveMenuOpen = false;
      document.getElementById('btn-save').setAttribute('aria-expanded', 'false');
      document.getElementById('save-dropdown').classList.remove('open');
    }

    /* ── Share modal ── */
    // ESC로 닫으면 저장하지 않는 '보기 전용'으로 엶
    const shareModal = VUI.modal.bind('#modal-share', { className: 'active', dialog: '#modal-share .modal-box', onClose: () => enterViewOnly() });
    function openShareModal(board) {
      _pendingShared = board;
      document.getElementById('modal-share-name').textContent = board.name;
      shareModal.open();
    }

    function enterViewOnly() {
      shareModal.close();
      if (!_pendingShared) return;
      viewOnlyBoard = _pendingShared;
      _pendingShared = null;
      history.replaceState(null, '', location.pathname);
      showView('home'); renderHome();
      openBoard('__view_only__');
    }

    function cloneAndOpen() {
      shareModal.close();
      const shared = _pendingShared;
      if (!shared) return;
      _pendingShared = null;
      const board = {
        id: uid(), name: shared.name || '공유된 보드',
        type: BS[shared.type] ? shared.type : 'chalkboard',
        elements: JSON.parse(JSON.stringify(shared.elements)),
        createdAt: Date.now(), lastEdited: Date.now(),
      };
      const d = getData(); d.boards.push(board); saveData(d);
      history.replaceState(null, '', location.pathname);
      showView('home'); renderHome();
      openBoard(board.id);
      showToast('복제했어요. 내 보드 목록에 저장돼요');
    }

    function cloneSharedBoard() {
      const shared = viewOnlyBoard;
      viewOnlyBoard = null;
      const board = {
        id: uid(), name: shared.name || '복제된 보드',
        type: shared.type,
        elements: JSON.parse(JSON.stringify(shared.elements)),
        createdAt: Date.now(), lastEdited: Date.now(),
      };
      const d = getData(); d.boards.push(board); saveData(d);
      undoStack = [];
      document.body.classList.remove('is-view-only');
      openBoard(board.id);
      showToast('복제했어요. 내 보드 목록에 저장돼요');
    }

    /* ── Toast (공용 VUI) ── */
    function showToast(msg, type) { VUI.toast(msg, type); }

    /* ── Share ── */
    function buildShareURL(permission) {
      const board = getBoard();
      if (!board) return null;
      // 새 링크는 UTF-8 base64url(한글이 약 3배 짧음). 옛 링크는 VUI.share.decode가 그대로 읽음
      const encoded = VUI.share.encode({ elements: board.elements, type: board.type, name: board.name, permission });
      return `${location.origin}/apps/chalkboard/#share=${encoded}`;
    }

    let shareMenuOpen = false;

    function toggleShareMenu(e) {
      e.stopPropagation();
      if (!getBoard()) return;
      shareMenuOpen = !shareMenuOpen;
      const dd = document.getElementById('share-dropdown');
      document.getElementById('btn-share').setAttribute('aria-expanded', String(shareMenuOpen));
      if (!shareMenuOpen) { dd.classList.remove('open'); return; }
      loadQR();   // 복사가 안 될 때 보여 줄 QR 라이브러리를 미리 받아 둠
      const board = getBoard();
      const s = board ? BS[board.type] : BS.chalkboard;
      dd.style.background = s.saveDdBg;
      dd.style.borderColor = s.ctxBorder;
      dd.style.boxShadow = s.ctxShadow;
      dd.querySelectorAll('.save-opt').forEach(b => {
        b.style.color = s.saveDdColor;
        b.onmouseenter = () => b.style.background = s.saveDdHover;
        b.onmouseleave = () => b.style.background = 'transparent';
      });
      const btn = document.getElementById('btn-share');
      const r = btn.getBoundingClientRect();
      dd.style.left = Math.max(8, r.right - 160) + 'px';
      dd.style.top = (r.bottom + 4) + 'px';
      dd.classList.add('open');
    }

    function closeShareMenu() {
      shareMenuOpen = false;
      document.getElementById('btn-share').setAttribute('aria-expanded', 'false');
      document.getElementById('share-dropdown').classList.remove('open');
    }

    // QR 라이브러리: 복사가 안 될 때 보여 주는 링크 창에서 QR을 그림(공유 메뉴를 열 때 미리 받음)
    let _qrPromise = null;
    function loadQR() {
      if (window.QRCode) return Promise.resolve(true);
      if (_qrPromise) return _qrPromise;
      _qrPromise = new Promise(resolve => {
        const sc = document.createElement('script');
        sc.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
        sc.async = true;
        sc.onload = () => resolve(true);
        sc.onerror = () => { _qrPromise = null; resolve(false); };
        document.head.appendChild(sc);
      });
      return _qrPromise;
    }

    async function doShare(permission) {
      closeShareMenu();
      const btn = document.getElementById('btn-share');
      btn.disabled = true;
      try {
        const longURL = buildShareURL(permission);
        if (!longURL) return;
        await Promise.race([loadQR(), new Promise(r => setTimeout(r, 1500))]);
        // 단축 → 복사. 복사가 안 되면 링크·QR 창을 보여 줌
        await VUI.share.link(longURL, {
          title: '칠판 공유',
          desc: permission === 'view' ? '받는 사람은 보기만 할 수 있어요.' : '받는 사람이 자기 보드로 복제할 수 있어요.',
        });
      } finally { btn.disabled = false; }
    }

    function doSaveTxt() {
      closeSaveMenu();
      const board = getBoard(); if (!board) return;
      let content = `[${board.type === 'chalkboard' ? '칠판' : '화이트보드'}] ${board.name}\n${'='.repeat(40)}\n\n`;
      board.elements.filter(e => e.type === 'text').forEach(el => { content += el.text + '\n'; });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([content], { type: 'text/plain;charset=utf-8' }));
      a.download = board.name.replace(/[^\w가-힣]/g, '_') + '.txt';
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    }

    // 화면의 .cb-el처럼(white-space: pre-wrap, word-break: break-word) 주어진 폭에서 줄을 나눔.
    // 띄어쓰기 뒤와 한글·한자 등(아스키가 아닌 글자) 사이에서 끊고, 끊을 곳이 없으면 글자 단위로 끊음
    function wrapCanvasText(ctx, text, maxW) {
      const out = [];
      String(text || '').split('\n').forEach(para => {
        let line = '';
        let brk = -1;   // line 안에서 끊어도 되는 위치(그 앞까지가 한 줄)
        for (const ch of Array.from(para)) {
          const test = line + ch;
          if (line && ch !== ' ' && ctx.measureText(test).width > maxW + 0.5) {
            const cut = brk > 0 ? brk : line.length;
            out.push(line.slice(0, cut).replace(/ +$/, ''));
            line = line.slice(cut) + ch;
            brk = -1;
          } else {
            line = test;
          }
          if (ch === ' ' || ch.charCodeAt(0) > 0x7f) brk = line.length;
        }
        out.push(line);
      });
      return out;
    }

    function doSaveJpg() {
      closeSaveMenu();
      const board = getBoard(); if (!board) return;
      const s = BS[board.type];
      // 내보낼 범위: 모든 요소를 감싸는 사각형 + 지금 보이는 영역(보드 좌표). 화면 밖 요소도 잘리지 않게
      const W = canvas.clientWidth, H = canvas.clientHeight;
      const vx = -view.tx / view.s, vy = -view.ty / view.s;
      let x0 = vx, y0 = vy, x1 = vx + W / view.s, y1 = vy + H / view.s;
      const b = contentBBox();
      if (b) {
        x0 = Math.min(x0, b.x0 - FIT_PAD); y0 = Math.min(y0, b.y0 - FIT_PAD);
        x1 = Math.max(x1, b.x1 + FIT_PAD); y1 = Math.max(y1, b.y1 + FIT_PAD);
      }
      const RW = Math.ceil(x1 - x0), RH = Math.ceil(y1 - y0);
      // 기기 캔버스 한도(iOS 약 1,670만 화소, 한 변 8192px) 안으로 줄임
      const k = Math.min(1, 8192 / RW, 8192 / RH, Math.sqrt(16000000 / (RW * RH)));
      const c = document.createElement('canvas');
      c.width = Math.max(1, Math.floor(RW * k)); c.height = Math.max(1, Math.floor(RH * k));
      const ctx = c.getContext('2d');
      ctx.scale(k, k);
      ctx.translate(-x0, -y0);

      // Background
      ctx.fillStyle = s.bg;
      ctx.fillRect(x0, y0, RW, RH);

      // Lines (drawn before text so text appears on top)
      board.elements.filter(e => e.type === 'line').forEach(el => {
        ctx.beginPath();
        ctx.moveTo(el.x1, el.y1);
        ctx.lineTo(el.x2, el.y2);
        ctx.strokeStyle = el.color;
        ctx.lineWidth = 3;
        ctx.lineCap = 'round';
        ctx.stroke();
      });

      // Text — 화면에 그려진 글자 상자의 폭으로 줄을 나눠 화면과 같게
      board.elements.filter(e => e.type === 'text').forEach(el => {
        const div = canvas.querySelector(`.cb-el[data-id="${el.id}"]`);
        const family = div ? getComputedStyle(div).fontFamily : '-apple-system, BlinkMacSystemFont, Pretendard, sans-serif';
        ctx.font = `700 ${el.size}px ${family}`;
        ctx.fillStyle = el.color;
        ctx.textBaseline = 'top';
        // .cb-el: 테두리 2px + 안쪽 여백 4px 6px, 줄 높이 1.2
        const maxW = div ? div.clientWidth - 12 : Infinity;
        const lh = el.size * 1.2;
        wrapCanvasText(ctx, el.text, maxW).forEach((line, i) => {
          ctx.fillText(line, el.x + 8, el.y + 6 + i * lh + (lh - el.size) / 2);
        });
      });

      const a = document.createElement('a');
      a.href = c.toDataURL('image/jpeg', 0.92);
      a.download = board.name.replace(/[^\w가-힣]/g, '_') + '.jpg';
      a.click();
    }

    /* ── Outside click closes ctx + save menu ── */
    document.addEventListener('click', e => {
      // Close more dropdown
      if (moreMenuOpen && !e.target.closest('#more-dropdown') && !e.target.closest('#btn-more')) {
        closeMoreMenu();
      }
      // Close save dropdown
      if (saveMenuOpen && !e.target.closest('#save-dropdown') && !e.target.closest('#btn-save')) {
        closeSaveMenu();
      }
      // Close share dropdown
      if (shareMenuOpen && !e.target.closest('#share-dropdown') && !e.target.closest('#btn-share')) {
        closeShareMenu();
      }
      // Close context menu
      if (document.getElementById('cb-ctx').style.display === 'none') return;
      if (!e.target.closest('#cb-ctx') && !e.target.closest('.cb-el') && !e.target.closest('.cb-line-g')) {
        hideCtx();
        deselectAll();
      }
    });

    /* ── Keyboard ── */
    document.addEventListener('keydown', e => {
      if (document.activeElement.contentEditable === 'true') return;
      if (document.activeElement.tagName === 'INPUT') return;
      if (!document.getElementById('view-board').classList.contains('active')) return;
      if (e.key === 'Escape') {
        if (moreMenuOpen || saveMenuOpen || shareMenuOpen) closeMenus();
        else if (mode !== 'select') { mode = 'select'; cancelDraw(); updateTbState(); }
        else deselectAll();
      }
      // 보기 전용 보드에서는 삭제·되돌리기·복사·붙여넣기를 막음
      if (viewOnlyBoard) return;
      if ((e.key === 'Delete' || e.key === 'Backspace') && selectedId) {
        deleteEl(selectedId, true);
      }
      if ((e.key === 'z' || e.key === 'Z') && (e.ctrlKey || e.metaKey)) {
        e.preventDefault();
        undoLast();
      }
      if ((e.key === 'c' || e.key === 'C') && (e.ctrlKey || e.metaKey) && selectedId) {
        e.preventDefault();
        const board = getBoard();
        const el = board.elements.find(e2 => e2.id === selectedId);
        if (el) { clipboard = JSON.parse(JSON.stringify(el)); showToast('복사했어요'); }
      }
      if ((e.key === 'v' || e.key === 'V') && (e.ctrlKey || e.metaKey) && clipboard) {
        e.preventDefault();
        const board = getBoard();
        const el = JSON.parse(JSON.stringify(clipboard));
        el.id = uid();
        if (el.type === 'text') { el.x += 20; el.y += 20; }
        else { el.x1 += 20; el.y1 += 20; el.x2 += 20; el.y2 += 20; }
        pushHistory();
        board.elements.push(el);
        board.lastEdited = Date.now();
        saveBoard(board);
        if (el.type === 'text') buildTextEl(el); else buildLineEl(el);
        selectEl(el.id, el.type);
        showToast('붙여넣었어요');
      }
    });

    /* ── Modal keyboard ── */
    document.getElementById('new-board-name').addEventListener('keydown', e => {
      // preventDefault: 모달이 닫히며 포커스가 '새 보드' 버튼으로 돌아간 뒤 Enter가 그 버튼을 다시 누르지 않게
      if (e.key === 'Enter' && !e.isComposing) { e.preventDefault(); createBoard(); }
    });

    // 공유 링크로 받은 요소는 외부 입력: 모양이 맞는 것만, 숫자·문자열로 다시 만듦
    function sanitizeElements(list) {
      const num = v => (typeof v === 'number' && isFinite(v) ? Math.max(-5000, Math.min(20000, v)) : 0);
      const col = v => (typeof v === 'string' && /^(#[0-9a-fA-F]{3,8}|[a-z]{3,20}|rgba?\([\d.,\s%]+\))$/.test(v) ? v : '#ffffff');
      const out = [];
      (Array.isArray(list) ? list : []).slice(0, 2000).forEach(e => {
        if (!e || typeof e !== 'object') return;
        const id = typeof e.id === 'string' && e.id.length <= 40 ? e.id : uid();
        if (e.type === 'text') {
          out.push({ id, type: 'text', x: num(e.x), y: num(e.y), text: String(e.text == null ? '' : e.text).slice(0, 5000),
            color: col(e.color), size: SIZES.includes(e.size) ? e.size : (num(e.size) > 0 ? Math.min(400, num(e.size)) : 80) });
        } else if (e.type === 'line') {
          out.push({ id, type: 'line', x1: num(e.x1), y1: num(e.y1), x2: num(e.x2), y2: num(e.y2), color: col(e.color) });
        }
      });
      return out;
    }

    /* ── Init ── */
    (function init() {
      const hash = location.hash;
      if (hash.startsWith('#share=')) {
        const encoded = hash.slice(7);
        try {
          // 새 형식(UTF-8 base64url)과 옛 형식(btoa(encodeURIComponent)) 모두 읽음
          const shared = VUI.share.decode(encoded, o => o && Array.isArray(o.elements) && typeof o.type === 'string');
          if (shared) {
            const boardData = {
              name: typeof shared.name === 'string' && shared.name.trim() ? shared.name.slice(0, 60) : '공유된 보드',
              type: BS[shared.type] ? shared.type : 'chalkboard',
              elements: sanitizeElements(shared.elements),
            };
            history.replaceState(null, '', location.pathname);
            showView('home'); renderHome();
            if (shared.permission === 'view') {
              viewOnlyBoard = boardData;
              openBoard('__view_only__');
              showToast('보기 전용으로 열었어요. 고친 내용은 저장되지 않아요');
            } else {
              openShareModal(boardData);
            }
            return;
          }
        } catch {}
        showToast('공유 링크를 읽을 수 없어요', 'error');
      }
      showView('home');
      renderHome();

      // 선택 동기화: 헤더 '동기화' 버튼 (보드를 코드 하나로 기기 간 이어쓰기)
      if (window.VivesSync) VivesSync.mountDocSync({
        apiUrl: '/api/chalkboard',
        keys: ['vives-chalkboard'],
        appName: '칠판·화이트보드',
        onApplied: function () {
          renderHome();
          if (currentBoardId && document.body.classList.contains('in-board')) openBoard(currentBoardId);
        },
      });
    })();
  </script>



</AppLayout>
