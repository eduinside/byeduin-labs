---
import AppLayout from '../../../layouts/AppLayout.astro';
---
<AppLayout 
  title="화산 탐험대 — eduin VIVES"
  description="세계의 산 11곳(화산 7곳, 화산이 아닌 산 4곳)을 3D 위성지도로 직접 탐험해요. 백두산·한라산·후지산 등을 관찰하고 화산인지 맞혀 보세요."
  image="https://eduin.info/og-images/volcano.png"
  bodyShell="immersive"
  theme="light"
  toast="top"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
  <link href="https://fonts.googleapis.com/css2?family=Jua&amp;family=Gowun+Dodum&amp;display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/4.7.1/maplibre-gl.min.css" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/4.7.1/maplibre-gl.min.js" crossorigin="anonymous" defer is:inline=""></script>
  <link rel="stylesheet" href="/common/sim-kit.css">
  <script is:inline src="/common/sim-kit.js"></script>
  <style is:global="">
:root{
  --lava:#ff5a36;
  --lava-deep:#d63a17;
  --magma:#ffb347;
  --rock:#2b2420;
  --ash:#6b5d52;
  --cream:#fdf6ec;
  --paper:#fffdf8;
  --leaf:#3d9970;
  --leaf-deep:#2c7a54;
  --shadow:0 8px 24px rgba(43,36,32,.12);
  --radius:22px;
  --side-w:400px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  font-family:'Gowun Dodum',sans-serif;
  background:var(--cream);
  color:var(--rock);
  min-height:100vh;
  background-image:
    radial-gradient(circle at 15% 20%, rgba(255,179,71,.12) 0, transparent 30%),
    radial-gradient(circle at 85% 70%, rgba(255,90,54,.08) 0, transparent 35%);
}
body.exploring{overflow:hidden}
h1,h2,h3{font-family:'Jua',sans-serif;font-weight:400}

/* ===== 인트로 ===== */
.wrap{max-width:560px;margin:0 auto;padding:20px 16px 60px}
.intro{text-align:center;animation:fadeUp .6s ease both}
.sk-screen .wrap{width:100%;padding:0 0 24px}
.intro .volcano-art{font-size:84px;line-height:1;animation:bounce 2.4s ease-in-out infinite}
.intro h1{font-size:34px;margin:14px 0 6px;color:var(--lava-deep)}
.intro .sub{font-size:16px;color:var(--ash);margin-bottom:22px;line-height:1.7}
.lesson-tag{
  display:inline-block;background:var(--rock);color:var(--magma);
  font-size:13px;padding:6px 16px;border-radius:99px;margin-bottom:18px
}
.mission-card{
  background:var(--paper);border:3px dashed var(--magma);border-radius:var(--radius);
  padding:20px 22px;text-align:left;margin:0 auto 26px;box-shadow:var(--shadow)
}
.mission-card h3{color:var(--lava-deep);font-size:19px;margin-bottom:10px}
.mission-card li{margin:8px 0 8px 20px;line-height:1.6;font-size:15px}
.mission-card b{color:var(--lava-deep)}

/* ===== 버튼: 규약 v2 .sk-btn (sim-kit.css). 앱 강조색만 용암색으로 ===== */
:root{ --sk-accent:#c2410c; --sk-ring:rgba(194,65,12,.28); }
.sk-btn{font-family:'Jua',sans-serif;font-weight:400}

/* ===== 탐험 레이아웃: 지도 + 조작판(넓은 화면에서는 옆, 좁은 화면에서는 아래) ===== */
.explore{
  display:grid;grid-template-columns:1fr var(--side-w);
  width:100vw;height:100vh;height:100dvh;
  animation:fadeUp .4s ease both
}
.map-zone{position:relative;background:#0c1420;min-width:0}
#map{width:100%;height:100%}
/* 위 이름표·안내 칩: 셸 버튼 줄(--sk-stage-top) 아래 왼쪽에 위아래로 쌓는다(좁은 화면에서 서로 겹치지 않게).
   오른쪽은 지도 확대·축소 버튼 자리(약 50px)를 비워 둔다 */
.map-top{
  position:absolute;top:var(--sk-stage-top);left:14px;right:64px;z-index:5;
  display:flex;flex-direction:column;align-items:flex-start;gap:6px;pointer-events:none
}
.viewer-title{
  background:rgba(20,14,10,.72);backdrop-filter:blur(6px);
  color:#fff;border-radius:14px;padding:9px 16px;max-width:100%;
  font-family:'Jua';font-size:19px;display:flex;align-items:center;gap:9px;
  border:1px solid rgba(255,255,255,.25)
}
.viewer-title .num{
  background:var(--lava);width:26px;height:26px;border-radius:50%;flex:none;
  display:inline-flex;align-items:center;justify-content:center;font-size:14px
}
/* 지도 확대·축소·방향 버튼: 오른쪽 위, 셸의 홈·공유 버튼 줄 아래 */
.map-zone .maplibregl-ctrl-top-right{top:var(--sk-stage-top)}
.cam-bar{
  position:absolute;bottom:40px;left:50%;transform:translateX(-50%);z-index:5;
  display:flex;gap:8px;width:max-content;max-width:calc(100% - 20px)
}
.cam-bar .sk-btn{background:rgba(255,255,255,.94);box-shadow:0 2px 10px rgba(0,0,0,.3);white-space:nowrap}
.cam-bar .sk-btn.active{background:var(--sk-accent);color:var(--sk-accent-fg)}
.map-loading{
  position:absolute;inset:0;z-index:6;display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:10px;
  background:#0c1420;color:#ffd9a8;font-family:'Jua';font-size:16px;
  transition:opacity .5s;pointer-events:none
}
.map-loading.hide{opacity:0}
.map-loading .spin{font-size:40px;line-height:1;animation:spin 1.6s linear infinite}
/* 7초 뒤 JS가 .gone을 붙여 숨긴다(키프레임으로 숨기면 '움직임 줄이기' 설정에서 바로 사라짐) */
.hint-chip{
  background:rgba(255,255,255,.92);color:var(--rock);
  font-size:14px;border-radius:99px;padding:7px 13px;max-width:100%;
  display:inline-flex;align-items:center;gap:6px;
  transition:opacity .6s ease, visibility .6s;
}
.hint-chip.gone{opacity:0;visibility:hidden}
/* 지도 사진(타일)을 계속 못 불러올 때 안내 — 퀴즈는 그대로 할 수 있다 */
.map-notice{
  position:absolute;inset:0;z-index:7;display:flex;align-items:center;justify-content:center;
  padding:20px;background:rgba(12,20,32,.82);
}
.map-notice-card{
  max-width:420px;text-align:center;color:#ffe9cc;background:rgba(20,14,10,.9);
  border:2px solid var(--magma);border-radius:18px;padding:18px 18px 16px;
}
.map-notice-card .big-ic{font-size:40px;line-height:1}
.map-notice-card p{font-size:15px;line-height:1.7;margin:8px 0 14px}
.map-notice-btns{justify-content:center}
.map-notice-btns > .sk-btn{flex:0 1 auto}

/* ===== 사이드바 ===== */
.side{
  background:var(--paper);border-left:3px solid var(--rock);
  overflow-y:auto;display:flex;flex-direction:column;
  box-shadow:-8px 0 24px rgba(43,36,32,.15)
}
.side-head{
  background:linear-gradient(135deg,#5d4037 0%,#3e2723 100%);
  color:#fff;padding:20px 22px 16px;position:relative;overflow:hidden;flex-shrink:0
}
.side-head::after{
  content:'';position:absolute;inset:0;
  background:radial-gradient(circle at 80% -20%, rgba(255,179,71,.35) 0, transparent 55%)
}
.side-head .flag{font-size:14px;opacity:.85;position:relative;z-index:1}
.side-head h2{font-size:27px;margin:3px 0 2px;position:relative;z-index:1}
.side-head .height{font-size:14px;opacity:.8;position:relative;z-index:1}
.side-body{padding:18px 20px 26px;flex:1}
.progress-zone{margin-bottom:16px}
.progress-track{height:12px;background:#eadfce;border-radius:99px;overflow:hidden}
.progress-fill{
  height:100%;border-radius:99px;min-width:12px;
  background:linear-gradient(90deg,var(--magma),var(--lava));
  transition:width .5s cubic-bezier(.6,0,.3,1.4)
}
.progress-label{display:flex;justify-content:space-between;font-size:14px;color:var(--ash);margin-top:5px}

.observe-box{
  background:#fff7e8;border:2px solid var(--magma);border-radius:16px;
  padding:14px 16px;margin-bottom:14px
}
.observe-box h3{font-size:16px;color:#b06a00;margin-bottom:6px;display:flex;align-items:center;gap:6px}
.observe-box p{font-size:15px;line-height:1.7}
.tip-box{
  background:#eef4fb;border:2px solid #9cc0e8;border-radius:16px;
  padding:12px 15px;margin-bottom:14px;font-size:14.5px;line-height:1.65;color:#2c5685
}
.tip-box b{color:#1f4f8c}
.earth-link{
  display:block;text-align:center;font-size:14px;color:var(--ash);
  text-decoration:underline;margin-top:10px;padding:10px 4px
}

.quiz-zone{margin-top:6px}
.quiz-q{text-align:center;font-family:'Jua';font-size:19px;margin-bottom:12px}
.quiz-btns{display:flex;flex-direction:column;gap:10px}
.quiz-btn{
  font-family:'Jua';font-size:17px;padding:15px 8px;border-radius:18px;
  border:3px solid;cursor:pointer;background:#fff;transition:transform .12s;
  -webkit-tap-highlight-color:transparent
}
.quiz-btn:active{transform:scale(.97)}
.quiz-btn.yes{border-color:var(--lava);color:var(--lava-deep)}
.quiz-btn.no{border-color:var(--leaf);color:var(--leaf-deep)}

.reveal{animation:popIn .45s cubic-bezier(.5,0,.3,1.5) both}
.reveal-banner{
  text-align:center;border-radius:18px;padding:12px;font-family:'Jua';font-size:18px;margin-bottom:11px
}
.reveal-banner.correct{background:#e3f5ea;color:var(--leaf-deep);border:2px solid var(--leaf)}
.reveal-banner.wrong{background:#fdeaea;color:#c0392b;border:2px solid #e74c3c}
.answer-chip{display:flex;align-items:center;gap:10px;border-radius:16px;padding:12px 14px;margin-bottom:11px}
.answer-chip.is-volcano{background:linear-gradient(135deg,#ffe8e0,#ffd9c4);border:2px solid var(--lava)}
.answer-chip.not-volcano{background:linear-gradient(135deg,#e6f4ec,#d8eede);border:2px solid var(--leaf)}
.answer-chip .icon{font-size:26px}
.answer-chip .label{font-family:'Jua';font-size:16.5px}
.answer-chip.is-volcano .label{color:var(--lava-deep)}
.answer-chip.not-volcano .label{color:var(--leaf-deep)}
.explain{font-size:14.5px;line-height:1.75;background:#f7f2e9;border-radius:14px;padding:13px 15px}
.explain b{color:var(--lava-deep)}
.next-zone{text-align:center;margin-top:16px}
.reveal-banner .ic{vertical-align:-0.15em}
.observe-box h3 .ic,.tip-box .ic{flex:none}
.earth-link .ic{vertical-align:-0.15em}
.summary-box h3{display:flex;align-items:center;gap:6px}

/* ===== 결과 (사이드바 안) ===== */
.result{text-align:center;animation:fadeUp .5s ease both}
.result h1{font-size:26px;color:var(--lava-deep);margin:6px 0 2px}
.result .score{font-family:'Jua';font-size:19px;color:var(--ash);margin-bottom:16px}
.sort-cols{display:flex;gap:10px;text-align:left;margin-bottom:14px}
.sort-col{flex:1;border-radius:16px;padding:12px}
.sort-col.vol{background:linear-gradient(160deg,#fff0e8,#ffe2d2)}
.sort-col.non{background:linear-gradient(160deg,#eaf6ef,#dcefe2)}
.sort-col h3{font-size:14.5px;margin-bottom:8px;text-align:center}
.sort-col.vol h3{color:var(--lava-deep)}
.sort-col.non h3{color:var(--leaf-deep)}
.sort-col ul{list-style:none}
.sort-col li{margin-bottom:5px}
.sort-col li button{
  display:block;width:100%;text-align:left;font-family:inherit;color:var(--rock);
  background:rgba(255,255,255,.78);border:none;border-radius:9px;padding:8px 8px;min-height:40px;
  font-size:14px;cursor:pointer;transition:transform .1s
}
.sort-col li button:hover{transform:translateX(2px)}
.revisit-hint{font-size:14px;color:var(--ash);margin-bottom:14px}
.summary-box{
  background:var(--rock);color:#f5ead8;border-radius:18px;
  padding:16px 18px;text-align:left;margin-bottom:18px
}
.summary-box h3{color:var(--magma);font-size:16px;margin-bottom:8px}
.summary-box p{font-size:14.5px;line-height:1.8}
.summary-box b{color:#ffcf8a}

@keyframes fadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
@keyframes popIn{from{opacity:0;transform:scale(.85)}to{opacity:1;transform:scale(1)}}
@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes fadeOutLater{0%,70%{opacity:1}100%{opacity:0;visibility:hidden}}
@media (prefers-reduced-motion: reduce){
  .intro,.explore,.reveal,.result{animation:none}
  .progress-fill{transition:none}
}

/* ===== 태블릿·모바일: 지도 위 / 패널 아래 ===== */
@media (max-width:900px){
  body.exploring{overflow:auto}
  .explore{display:flex;flex-direction:column;height:auto;min-height:100vh}
  .map-zone{position:sticky;top:0;z-index:40;height:48vh;min-height:300px;flex-shrink:0}
  .side{border-left:none;border-top:3px solid var(--rock)}
  .quiz-btns{flex-direction:row}
  .quiz-btn{flex:1;font-size:15.5px}
  .intro h1{font-size:28px}
  .viewer-title{font-size:16px;padding:8px 13px}
  .map-top{left:10px}
  .cam-bar{flex-wrap:wrap;justify-content:center}
}
</style>
