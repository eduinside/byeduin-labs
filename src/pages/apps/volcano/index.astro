/* ============ 상태 ============ */
let idx = 0;
let answers = [];
let map = null;
let orbiting = false;
let mapFailed = false;
let isRevisitMode = false;
const app = document.getElementById('app');
// 지도에 걸린 타이머·rAF는 한곳에 모아 화면을 다시 그릴 때 한 번에 정리(SimKit.timers)
const mapTimers = SimKit.timers();
let tileErrors = 0, tileOk = 0, mapNoticeShown = false;
const icon = (name, opts) => SimKit.icon(name, opts);
// 움직임 줄이기 설정이면 지도 이동 애니메이션 없이 바로 옮긴다(maplibre의 essential:true가 이 설정을 무시하지 않게)
const reducedMotion = () => SimKit.motion.reduced();
const dur = ms => reducedMotion() ? 0 : ms;
// 한 바퀴 돌기: 프레임 수가 아니라 경과 시간 기준(초당 7.2°, 예전 60Hz에서 프레임당 0.12°와 같은 빠르기)
const ORBIT_DEG_PER_SEC = 7.2;
const orbitLoop = SimKit.loop(dt => {
  if(!orbiting || !map){ orbitLoop.stop(); return; }
  map.setBearing(map.getBearing() + ORBIT_DEG_PER_SEC * dt);
});
// 위 이름표·아래 카메라 버튼 줄에 산이 가려지지 않게 지도 가운데를 보이는 칸 안으로
function camPadding(){
  const zone = document.querySelector('.map-zone');
  const top = document.querySelector('.map-top');
  const bar = document.querySelector('.cam-bar');
  if(!zone) return { top:0, bottom:0, left:0, right:0 };
  const z = zone.getBoundingClientRect();
  let pt = top ? Math.max(0, top.getBoundingClientRect().bottom - z.top) : 0;
  let pb = bar ? Math.max(0, z.bottom - bar.getBoundingClientRect().top) : 0;
  // 지도 높이의 절반 넘게 비우지 않는다(낮은 화면)
  const cap = z.height * 0.25;
  return { top: Math.min(pt, cap), bottom: Math.min(pb, cap), left: 0, right: 0 };
}

// 결과 화면에서는 idx가 MOUNTAINS.length라 현재 산이 없다
function curMountain(){ return MOUNTAINS[idx] || null; }
// 받침 유무로 은/는 고르기(한글로 끝나지 않으면 '은(는)')
function eunNeun(word){ return SimKit.josa.pick(word, '은/는'); }

function earthUrl(m){
  return `https://earth.google.com/web/@${m.lat},${m.lng},1500a,30000d,35y,0h,60t,0r`;
}

/* ============ 3D 지도 ============ */
function mapFallback(msg){
  const zone = document.querySelector('.map-zone');
  if(!zone) return;
  zone.innerHTML = `
    <div style="height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;
                text-align:center;color:#ffd9a8;padding:20px">
      <div style="font-size:46px;line-height:1;margin-bottom:10px">${icon('satellite')}</div>
      <p style="font-size:15px;line-height:1.7;margin-bottom:16px">
        이 기기/환경에서는 내장 3D 지도를 열 수 없어요.<br>
        <span style="opacity:.75;font-size:13px">(${msg})</span><br>
        대신 구글 어스로 탐험을 계속할 수 있어요!
      </p>
      <button class="sk-btn sk-btn--primary"
        onclick="window.open(earthUrl(curMountain() || MOUNTAINS[0]),'_blank','noopener')">${icon('globe')} 구글 어스로 이 산 보기</button>
    </div>`;
  mapFailed = true;
}

/* 지도 사진(타일)을 계속 못 불러오면: 안내를 띄우고 퀴즈는 그대로 하게 한다 */
function showMapNotice(){
  if(mapNoticeShown || mapFailed) return;
  const zone = document.querySelector('.map-zone');
  if(!zone) return;
  mapNoticeShown = true;
  document.getElementById('mapLoading')?.classList.add('hide');
  const box = document.createElement('div');
  box.className = 'map-notice';
  box.id = 'mapNotice';
  box.setAttribute('role', 'status');
  box.innerHTML = `
    <div class="map-notice-card">
      <div class="big-ic" aria-hidden="true">${icon('satellite')}</div>
      <p><b>지도 사진을 불러오지 못하고 있어요.</b><br>인터넷이 느리거나 학교에서 막혀 있을 수 있어요.<br>설명을 읽고 퀴즈는 그대로 풀 수 있어요!</p>
      <div class="sk-actions map-notice-btns">
        <button type="button" class="sk-btn sk-btn--primary" data-act="retry">${icon('rotate-ccw')} 다시 불러오기</button>
        <button type="button" class="sk-btn" data-act="earth">${icon('globe')} 구글 어스로 보기</button>
        <button type="button" class="sk-btn" data-act="close">${icon('x')} 닫기</button>
      </div>
    </div>`;
  box.addEventListener('click', e => {
    const b = e.target.closest('[data-act]');
    if(!b) return;
    const act = b.getAttribute('data-act');
    if(act === 'earth'){ window.open(earthUrl(curMountain() || MOUNTAINS[0]), '_blank', 'noopener'); return; }
    box.remove();
    if(act === 'retry'){
      mapNoticeShown = false;
      document.getElementById('mapLoading')?.classList.remove('hide');
      buildMap();
    }
  });
  zone.appendChild(box);
}

function buildMap(){
  mapTimers.reset();
  orbiting = false;
  orbitLoop.stop();
  tileErrors = 0; tileOk = 0;
  if(map){
    try{ map.remove(); }catch(e){}
    map = null;
  }
  if(typeof maplibregl === 'undefined'){
    mapFallback('지도 라이브러리 로딩 실패 - 인터넷 연결 또는 차단 정책 확인');
    return;
  }
  try{
    map = new maplibregl.Map({
      container:'map',
      center:[(curMountain() || MOUNTAINS[0]).lng, (curMountain() || MOUNTAINS[0]).lat],
      zoom:3, pitch:0, bearing:0,
      attributionControl:{compact:true},
      maxPitch:80,
      style:{
        version:8,
        sources:{
          sat:{
            type:'raster', tileSize:256, maxzoom:18,
            attribution:'위성영상 © Esri · 지형 © Mapzen/AWS',
            tiles:['https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}']
          },
          dem:{
            type:'raster-dem', tileSize:256, maxzoom:13, encoding:'terrarium',
            tiles:['https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png']
          },
          demShade:{
            type:'raster-dem', tileSize:256, maxzoom:13, encoding:'terrarium',
            tiles:['https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png']
          }
        },
        layers:[
          {id:'sat', type:'raster', source:'sat'},
          {id:'shade', type:'hillshade', source:'demShade',
           paint:{'hillshade-exaggeration':0.35,'hillshade-shadow-color':'#1a120c'}}
        ]
      }
    });
    // 오른쪽 위(셸 버튼 줄 아래, CSS) — 아래쪽 카메라 버튼 줄이 두 줄이 되어도 겹치지 않게
    map.addControl(new maplibregl.NavigationControl({visualizePitch:true}), 'top-right');
    map.on('load', ()=>{
      map.setTerrain({source:'dem', exaggeration:1.4});
      try{ map.setSky({ 'sky-color':'#79b3e6','horizon-color':'#fdebd0','fog-color':'#e8ddca','sky-horizon-blend':.6 }); }catch(e){}
      document.getElementById('mapLoading')?.classList.add('hide');
      // 로드가 늦어도 1번 산이 아니라 지금 보고 있는 산으로(결과 화면이면 세계 전체)
      const m = curMountain();
      if(m) flyToMountain(m); else map.easeTo({zoom:2.2, pitch:0, duration:dur(1500)});
      // 한참 지나도 사진 타일이 하나도 안 왔으면 안내
      mapTimers.timeout(() => { if(tileOk === 0) showMapNotice(); }, 15000);
    });
    map.on('sourcedata', e => { if(e && e.tile && e.tile.state === 'loaded') tileOk++; });
    map.on('error', e => {
      console.warn('map tile error', e?.error?.message||e);
      tileErrors++;
      if(tileErrors >= 6 && tileOk === 0) showMapNotice();
    });
    ['mousedown','touchstart','wheel'].forEach(ev => map.on(ev, stopOrbit));
  }catch(err){
    console.error('지도 초기화 실패:', err);
    mapFallback(err && err.message ? err.message : 'WebGL 미지원 가능성');
  }
}

function flyToMountain(m){
  if(mapFailed || !map) return;
  if(!m){ stopOrbit(); map.easeTo({zoom:2.2, pitch:0, bearing:0, duration:dur(1500)}); return; }
  stopOrbit();
  const cam = { center:[m.lng, m.lat], zoom:m.zoom, pitch:65, bearing:20, padding:camPadding() };
  if(reducedMotion()) map.jumpTo(cam);
  else map.flyTo(Object.assign(cam, { duration:4500 }));
}
function camTilt(){ if(mapFailed||!map)return; stopOrbit(); const m = curMountain(); map.easeTo({pitch:65, zoom:m ? m.zoom : map.getZoom(), duration:dur(1200)}); }
function camTop(){ if(mapFailed||!map)return; stopOrbit(); const m = curMountain(); map.easeTo({pitch:0, bearing:0, zoom:m ? m.zoom+0.4 : 2.2, duration:dur(1200)}); }
// 한 바퀴는 학생이 눌러서 켜는 관찰 기능이라 움직임 줄이기 설정에서도 켤 수 있다(누르면 멈춤)
function toggleOrbit(){
  if(mapFailed||!map)return;
  orbiting = !orbiting;
  document.getElementById('orbitBtn')?.classList.toggle('active', orbiting);
  document.getElementById('orbitBtn')?.setAttribute('aria-pressed', String(orbiting));
  if(orbiting){
    if(map.getPitch() < 30) map.easeTo({pitch:65, duration:dur(800)});
    orbitLoop.start();
  } else orbitLoop.stop();
}
function stopOrbit(){
  if(!orbiting) return;
  orbiting = false;
  orbitLoop.stop();
  document.getElementById('orbitBtn')?.classList.remove('active');
  document.getElementById('orbitBtn')?.setAttribute('aria-pressed', 'false');
}

/* ============ 화면 ============ */
function renderIntro(){
  mapTimers.reset();
  orbiting = false;
  orbitLoop.stop();
  document.body.classList.remove('exploring');
  app.innerHTML = `
  <div class="sk-screen">
    <div class="wrap intro">
      <div class="volcano-art" aria-hidden="true">🌋</div>
      <h1>화산 탐험대</h1>
      <div class="lesson-tag">화산과 화산이 아닌 산은 무엇이 다를까요?</div>
      <p class="sub">화산은 직접 가 보기 어려워요.<br>이 앱 안에서 바로 <b>3D 지도</b>를 움직이며<br>세계의 산 11개를 탐험해 봐요!</p>
      <div class="mission-card">
        <h3>${icon('compass')} 탐험 방법</h3>
        <ol>
          <li>지도를 <b>마우스나 손가락으로 끌면</b> 움직여요. <b>마우스 오른쪽 버튼으로 끌거나 두 손가락</b>으로 돌리고 기울일 수 있어요.</li>
          <li><b>한 바퀴</b>, <b>위에서 보기</b> 버튼으로 산을 구석구석 관찰해요.</li>
          <li>조작판의 안내를 읽고, <b>화산인지 아닌지</b> 맞혀 봐요!</li>
        </ol>
      </div>
      <button class="sk-btn sk-btn--primary" onclick="start()">${icon('rocket')} 탐험 시작</button>
    </div>
  </div>`;
}

function renderExplore(){
  document.body.classList.add('exploring');
  app.innerHTML = `
  <div class="explore">
    <div class="map-zone">
      <div id="map"></div>
      <div class="map-top">
        <div class="viewer-title" id="viewerTitle"></div>
        <div class="hint-chip" id="hintChip">${icon('hand')} 지도를 끌어서 직접 둘러보세요!</div>
      </div>
      <div class="map-loading" id="mapLoading"><div class="spin">${icon('globe')}</div>3D 지형을 불러오는 중...</div>
      <div class="cam-bar sk-actions" role="group" aria-label="지도 보는 방법">
        <button class="sk-btn sk-btn--sm" onclick="flyToMountain(curMountain())" title="현재 산으로 돌아가기">${icon('locate-fixed')} 돌아가기</button>
        <button class="sk-btn sk-btn--sm" id="orbitBtn" onclick="toggleOrbit()" aria-pressed="false">${icon('rotate-cw')} 한 바퀴</button>
        <button class="sk-btn sk-btn--sm" onclick="camTop()">${icon('circle-arrow-down')} 위에서 보기</button>
        <button class="sk-btn sk-btn--sm" onclick="camTilt()">${icon('mountain')} 3D 보기</button>
      </div>
    </div>
    <aside class="side">
      <div class="side-head" id="sideHead"></div>
      <div class="side-body" id="sideBody"></div>
    </aside>
  </div>`;
  mapNoticeShown = false;
  buildMap();
  renderPanel();
  mapTimers.timeout(() => document.getElementById('hintChip')?.classList.add('gone'), 7000);
}

function renderPanel(){
  const m = MOUNTAINS[idx];
  const vt = document.getElementById('viewerTitle');
  if(vt) vt.innerHTML = `<span class="num">${idx+1}</span> ${m.emoji} ${m.name}`;
  document.getElementById('sideHead').innerHTML = `
    <div class="flag">${m.country}</div>
    <h2>${m.emoji} ${m.name}</h2>
    <div class="height">높이 ${m.height} · ${idx+1}번째 산</div>`;

  let actionHtml = `
    <div class="observe-box">
      <h3>${icon('search')} 관찰 포인트</h3>
      <p>${m.observe}</p>
    </div>
    <div class="tip-box">${icon('lightbulb')} <b>탐험 팁</b> · ${m.tip}</div>`;

  if (isRevisitMode) {
    actionHtml += `
      <div class="reveal" style="margin-top:20px;">
        <div class="answer-chip ${m.isVolcano?'is-volcano':'not-volcano'}" style="margin-bottom:12px;">
          <span class="icon">${m.isVolcano?'🌋':'⛰️'}</span>
          <span class="label">${m.name}${eunNeun(m.name)} ${m.isVolcano?'화산이에요!':'화산이 아니에요!'}</span>
        </div>
        <div class="explain" style="margin-bottom:16px;">${m.explain}</div>
        <a class="earth-link" href="${earthUrl(m)}" target="_blank" rel="noopener" style="margin-bottom:14px; display:block;">더 실감나게 보고 싶다면? 구글 어스로 열기 ${icon('external-link')}</a>
        <button class="sk-btn sk-btn--primary sk-btn--block" onclick="backToResult()">${icon('award')} 결과 화면으로 돌아가기</button>
      </div>`;
  } else {
    actionHtml = `
      <div class="progress-zone">
        <div class="progress-track"><div class="progress-fill" style="width:${idx/MOUNTAINS.length*100}%"></div></div>
        <div class="progress-label"><span>탐험 진행 중</span><span>${idx+1} / ${MOUNTAINS.length}</span></div>
      </div>` + actionHtml + `
      <div class="quiz-zone" id="quiz" aria-live="polite">
        <div class="quiz-q">충분히 관찰했나요?<br>이 산은 화산일까요?</div>
        <div class="quiz-btns">
          <button class="quiz-btn yes" onclick="answer(true)">🌋 화산이에요!</button>
          <button class="quiz-btn no" onclick="answer(false)">⛰️ 화산이 아니에요!</button>
        </div>
      </div>
      <a class="earth-link" href="${earthUrl(m)}" target="_blank" rel="noopener">더 실감나게 보고 싶다면? 구글 어스로 열기 ${icon('external-link')}</a>`;
  }

  document.getElementById('sideBody').innerHTML = actionHtml;
  document.querySelector('.side')?.scrollTo({top:0});
}

function answer(guess){
  const m = MOUNTAINS[idx];
  const correct = guess === m.isVolcano;
  answers[idx] = {correct};
  document.getElementById('quiz').innerHTML = `
  <div class="reveal">
    <div class="reveal-banner ${correct?'correct':'wrong'}" id="revealBanner" tabindex="-1">
      ${correct ? icon('party-popper') + ' 딩동댕! 정답이에요!'
                 : icon('circle-alert') + ' 아쉬워요! 정답은 <b>' + (m.isVolcano ? '화산' : '화산이 아닌 산') + '</b>이에요'}
    </div>
    <div class="answer-chip ${m.isVolcano?'is-volcano':'not-volcano'}">
      <span class="icon">${m.isVolcano?'🌋':'⛰️'}</span>
      <span class="label">${m.name}${eunNeun(m.name)} ${m.isVolcano?'화산이에요!':'화산이 아니에요!'}</span>
    </div>
    <div class="explain">${m.explain}</div>
    <div class="next-zone">
      <button class="sk-btn sk-btn--primary" onclick="next()">
        ${idx === MOUNTAINS.length-1 ? icon('award') + ' 탐험 ' + SimKit.LABELS.result : '다음 산으로 ' + icon('arrow-right')}
      </button>
    </div>
  </div>`;
  // 누른 버튼이 사라졌으니 결과 문구로 초점을 옮긴다(키보드·화면 읽기)
  const banner = document.getElementById('revealBanner');
  banner?.focus({preventScroll:true});
  // 폰(지도가 위에 붙은 배치)에서 결과 문구가 가려져 있으면 보이는 곳으로(규약 v2)
  if(banner) SimKit.reveal(banner);
}
function focusSideHead(){
  const h = document.querySelector('#sideHead h2');
  if(h){ h.tabIndex = -1; h.focus({preventScroll:true}); }
}

function next(){
  idx++;
  if(idx >= MOUNTAINS.length){ renderResult(); focusSideHead(); return; }
  renderPanel();
  flyToMountain(MOUNTAINS[idx]);
  focusSideHead();
}

function renderResult(){
  isRevisitMode = false;
  stopOrbit();
  if(map && !mapFailed){ map.easeTo({zoom:2.2, pitch:0, duration:dur(3000)}); }
  const vt = document.getElementById('viewerTitle');
  if(vt) vt.innerHTML = `${icon('award')} 탐험 완료!`;
  const score = answers.filter(a=>a&&a.correct).length;
  const vol = MOUNTAINS.map((m,i)=>({m,i})).filter(x=>x.m.isVolcano);
  const non = MOUNTAINS.map((m,i)=>({m,i})).filter(x=>!x.m.isVolcano);
  const li = x => `<li><button type="button" onclick="revisit(${x.i})">${x.m.emoji} ${x.m.name}</button></li>`;
  document.getElementById('sideHead').innerHTML = `
    <div class="flag">세계 화산 탐험</div>
    <h2>${icon('award')} 탐험 완료!</h2>
    <div class="height">${MOUNTAINS.length}개 산을 모두 방문했어요</div>`;
  document.getElementById('sideBody').innerHTML = `
  <div class="result">
    <div class="score">${MOUNTAINS.length}개 중 ${score}개 맞혔어요</div>
    <div class="sort-cols">
      <div class="sort-col vol"><h3>🌋 화산 (${vol.length})</h3><ul>${vol.map(li).join('')}</ul></div>
      <div class="sort-col non"><h3>⛰️ 화산이 아닌 산 (${non.length})</h3><ul>${non.map(li).join('')}</ul></div>
    </div>
    <p class="revisit-hint">산 이름을 누르면 3D 지도로 다시 가 볼 수 있어요</p>
    <div class="summary-box">
      <h3>${icon('book-open')} 오늘의 배움 정리</h3>
      <p>화산은 <b>마그마가 분출하여 만들어진 산</b>이에요.
      그래서 산꼭대기에 <b>분화구</b>가 있고, 분화구에 물이 고여 <b>호수</b>가 되기도 해요(백두산 천지, 한라산 백록담).
      화산이 아닌 산은 분화구가 없고, 땅이 솟아오르거나 깎여서 만들어졌어요.</p>
    </div>
    <button class="sk-btn sk-btn--danger" onclick="restartAll()">${icon('refresh-ccw')} ${SimKit.LABELS.reset} 다시 탐험</button>
  </div>`;
  document.querySelector('.side')?.scrollTo({top:0});
}

function revisit(i){
  isRevisitMode = true;
  idx = i;
  renderPanel();
  flyToMountain(MOUNTAINS[i]);
  focusSideHead();
}

function backToResult() {
  renderResult();
  focusSideHead();
}

// 맞힌 기록을 지우고 1번 산부터(확인 창 필수 — 규약 v2)
function restartAll(){
  const ask = window.VUI && VUI.confirm
    ? VUI.confirm('맞힌 기록을 지우고 1번 산부터 다시 탐험할까요?', { ok: SimKit.LABELS.reset, danger: true })
    : Promise.resolve(true);
  ask.then(ok => { if(ok) start(); });
}
function start(){
  isRevisitMode = false;
  idx=0;
  answers=[];
  renderExplore();
}

renderIntro();
</script>



</AppLayout>
