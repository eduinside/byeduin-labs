// ── 스테퍼 ──
function mkStep(field, delta) {
  const cfg = { count:{min:1,max:300,step:1}, ratio:{min:0,max:100,step:5}, areaCount:{min:1,max:12,step:1} };
  const c = cfg[field]; if (!c) return;
  const cur = field === 'areaCount' ? mk.areaCount : mk[field];
  mkSetField(field, clamp(cur + delta * c.step, c.min, c.max));
}
function mkStepAward(field, delta) {
  mk.awardRange[field] = clamp(mk.awardRange[field] + delta * 5, 0, 100);
  document.getElementById(`mk-${field}-inp`).value = mk.awardRange[field];
  document.getElementById(`mk-${field}-val`).textContent = mk.awardRange[field];
}
function mkSetField(field, raw) {
  const val = +raw;
  if (field === 'count') {
    mk.count = val;
    while (mk.rows.length < val) mk.rows.push({ name: `참가자${mk.rows.length + 1}`, scores: mk.areas.map(() => null) });
    mk.rows = mk.rows.slice(0, val);
    renderMkSettings(); renderMkTable();
  } else if (field === 'areaCount') {
    mk.areaCount = val;
    while (mk.areas.length < val) mk.areas.push({ name: `영역${mk.areas.length + 1}`, max: 20 });
    mk.areas = mk.areas.slice(0, val);
    mk.rows.forEach(r => {
      while (r.scores.length < val) r.scores.push(null);
      r.scores = r.scores.slice(0, val);
    });
    renderMkSettings(); renderMkTable();
  } else if (field === 'ratio') {
    mk.ratio = val;
    document.getElementById('mk-ratio-inp').value = val;
    document.getElementById('mk-ratio-val').textContent = val;
    mkUpdateRanksAwards();
    mkUpdateInfoBadge();
  }
  mkSaveLocal();
}

function mkUpdateInfoBadge() {
  const el = document.getElementById('mk-info-badge');
  if (el) {
    const awardN = Math.round(mk.rows.length * mk.ratio / 100);
    el.textContent = `총 ${mk.rows.length}명 · 시상 ${awardN}명`;
  }
}

function mkUpdateMaxTotal() {
  const el = document.getElementById('mk-maxtotal');
  if (el) el.textContent = mk.areas.reduce((s, a) => s + a.max, 0);
}
function mkOnAreaName(i, v)  { mk.areas[i].name = v; renderMkTableHead(); mkSaveLocal(); }
function mkOnAreaMax(i, inp) {
  mk.areas[i].max = clamp(+inp.value, 1, 200);
  inp.value = mk.areas[i].max;
  mkUpdateMaxTotal(); renderMkTableHead(); mkSaveLocal();
}
function mkAreaMaxStep(i, delta) {
  mk.areas[i].max = clamp(mk.areas[i].max + delta * 5, 1, 200);
  document.getElementById(`mk-amax-inp-${i}`).value = mk.areas[i].max;
  mkUpdateMaxTotal(); renderMkTableHead(); mkSaveLocal();
}

