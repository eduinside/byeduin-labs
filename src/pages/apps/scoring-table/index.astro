---
import AppLayout from '../../../layouts/AppLayout.astro';
---
<AppLayout 
  title="채점표 — eduin VIVES"
  description="온라인 채점 양식을 만들고 링크 하나로 공유하세요. 공동 채점, 실시간 결과 수합, xlsx 다운로드까지 한 번에."
  image="https://eduin.info/og-images/scoring-table.png"
  bodyShell="column"
  bodyWidth="wide"
  bodyPrint={true}
>
  <Fragment slot="head">
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js" is:inline=""></script>
  <style is:global="">
    * { box-sizing: border-box; }
    body {
      min-height: 100vh;
      padding: 56px 1rem 5rem;
      font-family: -apple-system, BlinkMacSystemFont, 'Pretendard', 'Inter', 'Segoe UI', sans-serif;
    }
    body::before {
      content: '';
      position: fixed; inset: 0;
      background-image:
        linear-gradient(rgba(0,111,238,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,111,238,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none; z-index: 0;
    }
    .wrap { max-width: 960px; margin: 0 auto; position: relative; z-index: 1; }

    /* ── Tabs (file-tools 패턴) ── */
    .tabs { display:flex; gap:.25rem; border-bottom:1px solid var(--border); margin-bottom:1.25rem; }
    .tab-btn {
      padding:.6rem 1.1rem; font-size:.85rem; font-weight:600;
      background:none; border:none; border-bottom:2px solid transparent;
      color:var(--fg-muted); cursor:pointer; font-family:inherit;
      transition:color 0.15s, border-color 0.15s;
    }
    .tab-btn.active { color:var(--primary); border-bottom-color:var(--primary); }
    .tab-btn:hover  { color:var(--fg); }
    .panel { display:none; }
    .panel.active { display:block; }

    /* ── Card ── */
    .st-card {
      background:var(--card-bg); border:1px solid var(--border);
      border-radius:14px; padding:18px 20px; margin-bottom:12px;
    }

    /* ── Section title ── */
    .st-sec {
      font-size:11px; font-weight:700; letter-spacing:.12em;
      text-transform:uppercase; color:var(--fg-muted); margin-bottom:12px;
      display:flex; align-items:center; gap:8px;
    }
    .st-sec::after { content:''; flex:1; height:1px; background:var(--border); }

    /* ── Stepper ── */
    .stepper { display:inline-flex; align-items:center; border:1px solid var(--border); border-radius:8px; overflow:hidden; }
    .stp-btn {
      width:30px; height:32px; background:var(--card-bg); border:none;
      cursor:pointer; font-size:17px; color:var(--fg-muted); font-family:inherit;
      display:flex; align-items:center; justify-content:center; flex-shrink:0;
      transition:background .12s, color .12s; line-height:1;
    }
    .stp-btn:hover { background:rgba(0,111,238,0.08); color:var(--primary); }
    .stp-inp {
      width:52px; height:32px; border:none;
      border-left:1px solid var(--border); border-right:1px solid var(--border);
      text-align:center; font-size:13px; font-weight:700;
      background:var(--bg); color:var(--fg); font-family:inherit; outline:none;
      -moz-appearance:textfield;
    }
    .stp-inp::-webkit-outer-spin-button,
    .stp-inp::-webkit-inner-spin-button { -webkit-appearance:none; }

    /* ── Settings layout ── */
    .settings-row { display:flex; flex-wrap:wrap; gap:16px; align-items:flex-end; margin-bottom:16px; }
    .sf { display:flex; flex-direction:column; gap:6px; }
    .sf-label { font-size:11px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--fg-muted); }
    .area-rows { display:flex; flex-direction:column; gap:8px; margin-top:4px; }
    .area-row { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
    .area-idx { font-size:11px; font-weight:700; color:var(--fg-muted); min-width:44px; }

    /* ── Award range ── */
    .award-toggle-row {
      display:flex; align-items:center; gap:12px; flex-wrap:wrap;
      padding:12px 0 0; border-top:1px solid var(--border); margin-top:4px;
    }
    .award-toggle-label { display:flex; align-items:center; gap:6px; font-size:12px; font-weight:600; color:var(--fg-muted); cursor:pointer; }
    .award-range-row { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
    .award-range-row.disabled { opacity:.35; pointer-events:none; }

    /* ── Buttons ── */
    .st-btn {
      display:inline-flex; align-items:center; justify-content:center; gap:6px;
      padding:9px 16px; border-radius:9px; border:none;
      font-size:13px; font-weight:600; cursor:pointer; font-family:inherit;
      transition:all .15s; min-height:38px; white-space:nowrap;
    }
    .st-btn:disabled { opacity:.4; cursor:not-allowed; }
    .st-btn-primary { background:var(--primary); color:#fff; }
    .st-btn-primary:hover:not(:disabled) { background:var(--primary-h); }
    .st-btn-ghost { background:var(--card-bg); color:var(--fg-muted); border:1px solid var(--border); }
    .st-btn-ghost:hover { border-color:var(--primary); color:var(--primary); }
    .st-btn-ghost.on { border-color:var(--primary); color:var(--primary); background:rgba(0,111,238,.08); }
    .st-btn-danger { background:rgba(243,18,96,.1); color:var(--danger); border:1px solid rgba(243,18,96,.2); }
    .st-btn-danger:hover { background:rgba(243,18,96,.18); }
    .st-btn-sm { padding:5px 11px; font-size:12px; min-height:30px; border-radius:7px; }
    .act-row { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }

    /* ── Input ── */
    .st-input {
      background:var(--bg); border:1px solid var(--border); border-radius:8px;
      padding:8px 12px; font-size:13px; color:var(--fg); outline:none;
      font-family:inherit; transition:border-color .2s;
    }
    .st-input:focus { border-color:var(--primary); }

    /* ── Table ── */
    .tbl-header { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; margin-bottom:10px; }
    .grid-wrap { overflow-x:auto; overflow-y:auto; max-height:480px; border:1px solid var(--border); border-radius:10px; }
    .st-grid { border-collapse:collapse; width:100%; font-size:13px; }
    .st-grid th, .st-grid td { border:1px solid var(--border); padding:6px 10px; text-align:center; white-space:nowrap; }
    .st-grid th {
      background:var(--bg-sec); font-weight:700; font-size:11px;
      letter-spacing:.04em; text-transform:uppercase; color:var(--fg-muted);
      position:sticky; top:0; z-index:2;
    }
    /* 총점/합계 헤더 — 불투명 배경(스크롤 시 본문 비침 방지) */
    .st-grid th.total-th {
      background:linear-gradient(0deg, rgba(0,111,238,.10), rgba(0,111,238,.10)), var(--bg-sec);
      color:var(--primary);
    }
    .st-grid td.name-td { text-align:left; font-weight:600; min-width:80px; }
    .st-grid td.score-td { min-width:64px; }
    .st-grid td.total-td { font-weight:700; background:rgba(0,111,238,.04) !important; }
    .st-grid td.rank-td  { font-size:12px; font-weight:700; color:var(--fg-muted); min-width:40px; }
    .st-grid td.award-td { min-width:40px; }
    .st-grid tr.award-row td { background:rgba(0,111,238,.07); }
    .st-grid tr.award-row td.total-td { background:rgba(0,111,238,.13) !important; }
    /* contenteditable */
    .st-grid td[contenteditable=true] { cursor:text; }
    .st-grid td[contenteditable=true]:hover { background:rgba(0,111,238,.03) !important; }
    .st-grid td[contenteditable=true]:focus { outline:2px solid var(--primary); outline-offset:-1px; background:rgba(0,111,238,.07) !important; }
    /* number input */
    .score-num {
      width:56px; text-align:center; background:transparent;
      border:none; outline:none; font-size:13px; font-weight:600;
      color:var(--fg); font-family:inherit; padding:0;
    }
    .score-num:focus { color:var(--primary); }
    .st-grid td:has(.score-num) { padding:3px 6px; }

    /* ── Progress ── */
    .prog-wrap { margin:8px 0; }
    .prog-bar { height:4px; background:var(--border); border-radius:99px; overflow:hidden; }
    .prog-fill { height:100%; background:var(--primary); border-radius:99px; transition:width .3s; }
    .prog-label { font-size:11px; color:var(--fg-muted); text-align:right; margin-top:3px; }

    /* ── Chips ── */
    .chip-list { display:flex; flex-wrap:wrap; gap:6px; margin:8px 0; min-height:28px; }
    .chip {
      display:inline-flex; align-items:center; gap:5px;
      background:rgba(0,111,238,.08); border:1px solid rgba(0,111,238,.2);
      color:var(--primary); border-radius:99px; padding:4px 10px;
      font-size:12px; font-weight:600;
    }
    .chip-del { background:none; border:none; cursor:pointer; color:var(--primary); font-size:15px; line-height:1; padding:0; opacity:.55; }
    .chip-del:hover { opacity:1; }

    /* ── Signature ── */
    .sig-section { margin-top:24px; padding-top:16px; border-top:1px dashed var(--border); }
    .sig-title { font-size:11px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--fg-muted); margin-bottom:12px; }
    .sig-rows { display:flex; flex-direction:column; gap:14px; }
    .sig-row { display:flex; align-items:center; gap:24px; flex-wrap:wrap; }
    .sig-field { display:flex; align-items:center; gap:8px; }
    .sig-lbl { font-size:12px; font-weight:600; color:var(--fg-muted); white-space:nowrap; }
    .sig-name { font-size:12px; font-weight:700; color:var(--fg); min-width:60px; }
    .sig-line { display:inline-block; width:110px; height:1px; border-bottom:1px solid var(--fg-muted); }

    /* ── Detail toggle ── */
    .detail-toggle {
      display:flex; align-items:center; gap:8px;
      font-size:12px; font-weight:600; color:var(--fg-muted);
      cursor:pointer; padding:8px 0; background:none; border:none;
      font-family:inherit; user-select:none;
    }
    .detail-toggle svg { transition:transform .2s; }
    .detail-toggle.open svg { transform:rotate(180deg); }
    .detail-body { display:none; }
    .detail-body.open { display:block; }

    /* ── Empty / info ── */
    .empty { text-align:center; padding:40px 16px; color:var(--fg-muted); font-size:13px; }
    .empty-ico { font-size:36px; margin-bottom:10px; }
    .info-badge {
      display:inline-flex; align-items:center; gap:5px;
      background:rgba(0,111,238,.08); border:1px solid rgba(0,111,238,.2);
      color:var(--primary); border-radius:99px; padding:3px 10px;
      font-size:11px; font-weight:700;
    }

    /* ── Toast ── */
    #st-toast {
      position:fixed; bottom:2rem; left:50%;
      transform:translateX(-50%) translateY(1rem);
      background:var(--fg); color:var(--bg);
      padding:10px 18px; border-radius:10px;
      font-size:13px; font-weight:600; opacity:0; pointer-events:none;
      transition:opacity .2s, transform .2s; z-index:9999; white-space:nowrap;
    }
    #st-toast.show { opacity:1; transform:translateX(-50%) translateY(0); }

    /* ── Print ── */
    @media print {
      .no-print { display:none !important; }
      body { padding:0; background:#fff; }
      body::before { display:none; }
      .wrap { max-width:none; padding:16px; }
      .app-header { margin-bottom:10px; }
      .panel { display:block !important; }
      #panel-score, #panel-collect { display:none !important; }
      body[data-print=score]  #panel-make, body[data-print=score]  #panel-collect { display:none !important; }
      body[data-print=score]  #panel-score { display:block !important; }
      body[data-print=collect] #panel-make, body[data-print=collect] #panel-score { display:none !important; }
      body[data-print=collect] #panel-collect { display:block !important; }
      .settings-card { display:none !important; }
      .tbl-header .act-row, .mk-btn-row, .sc-btn-row, .cl-btn-row { display:none !important; }
      .grid-wrap { overflow:visible; border:none; border-radius:0; max-height:none; }
      .st-grid th, .st-grid td { border-color:#888; font-size:11px; padding:4px 8px; }
      .st-grid th { background:#efefef !important; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
      .st-grid tr.award-row td { background:#dbeafe !important; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
      .st-grid tr.award-row td.total-td { background:#bfdbfe !important; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
      .sig-section { margin-top:20px; border-top:1px solid #aaa; }
      .sig-line { border-bottom-color:#333; }
      .detail-body { display:block !important; }
    }

    @media (max-width:600px) {
      .settings-row { gap:12px; }
    }
  </style>
  <link rel="canonical" href="https://eduin.info/apps/scoring-table/">
  <script type="application/ld+json" is:inline="">{"@context":"https://schema.org","@type":"WebApplication","name":"채점표","description":"온라인 채점 양식을 만들고 링크 하나로 공유하세요. 공동 채점, 실시간 결과 수합, xlsx 다운로드까지 한 번에.","url":"https://eduin.info/apps/scoring-table/","applicationCategory":"EducationApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"KRW"},"isPartOf":{"@type":"WebSite","name":"eduin VIVES","url":"https://eduin.info"}}</script>
  </Fragment>




<div class="wrap">
  <header class="app-header">
    <span class="app-badge">◆ 업무경감</span>
    <h1 class="app-title">
  <div class="card-emoji sub-edu-work" style="margin-bottom: 0; transform: scale(1.0);">
        <i data-lucide="award"></i>
      </div>
  <span>채점표</span>
</h1>
    <p class="app-desc">대회·발표 채점 양식 배포, 공동 채점, 결과 수합 — 서버 없이 링크 하나로</p>
  </header>

  <div class="tabs no-print">
    <button class="tab-btn active" data-tab="make" onclick="switchTab('make')">📋 표 만들기</button>
    <button class="tab-btn" data-tab="score" onclick="switchTab('score')">✏️ 채점하기</button>
    <button class="tab-btn" data-tab="collect" onclick="switchTab('collect')">📊 수합하기</button>
  </div>

  <!-- ═══════════════════════════════════════
       탭 1: 표 만들기
  ═══════════════════════════════════════ -->
  <section class="panel active" id="panel-make">
    <div class="st-card settings-card no-print" id="mk-settings-card">
      <!-- renderMkSettings() 로 채움 -->
    </div>
    <div id="mk-table-wrap">
      <!-- renderMkTable() 로 채움 -->
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       탭 2: 채점하기
  ═══════════════════════════════════════ -->
  <section class="panel" id="panel-score">
    <div class="st-card no-print" id="sc-setup-card">
      <div class="st-sec">채점 정보</div>
      <div class="settings-row" style="align-items:flex-start">
        <div class="sf">
          <label class="sf-label" for="sc-scorer">채점자 이름</label>
          <input id="sc-scorer" class="st-input" type="text" placeholder="예) 김선생님, 이선생님, 박선생님" style="width:200px">
        </div>
        <div class="sf" style="flex:1;min-width:240px">
          <label class="sf-label" for="sc-form-url">채점 양식 링크</label>
          <div style="display:flex;gap:8px">
            <input id="sc-form-url" class="st-input" type="text" placeholder="양식 공유 링크를 붙여넣으세요" style="flex:1">
            <button class="st-btn st-btn-primary" onclick="scLoadFromInput()">불러오기</button>
          </div>
          <span style="font-size:11px;color:var(--fg-muted);margin-top:4px">링크를 직접 열면 자동으로 불러옵니다</span>
        </div>
      </div>
      <div style="margin-top:16px;padding:14px 16px;background:rgba(0,111,238,.05);border:1px solid rgba(0,111,238,.15);border-radius:10px;font-size:12.5px;line-height:1.7;color:var(--fg-muted)">
        <strong style="color:var(--fg)">이 탭은 채점자용입니다.</strong><br>
        ① 주최자가 <b>표 만들기</b> 탭에서 만든 <b>채점 양식 링크</b>를 받아 엽니다.<br>
        ② <b>채점자 이름</b>을 입력하고 참가자별 점수를 매깁니다. (규칙에 따른 자동배점도 가능)<br>
        ③ 입력이 끝나면 <b>수합자에게 공유</b> 버튼으로 결과 링크를 만들어 전달하거나, 엑셀로 내려받습니다.<br>
        <span style="display:inline-block;margin-top:6px">아직 양식이 없다면, 위 입력란에 받은 링크를 붙여넣고 <b>불러오기</b>를 눌러주세요.</span>
      </div>
    </div>
    <div id="sc-content-wrap" style="display:none">
      <!-- renderScTable() 로 채움 -->
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       탭 3: 수합하기
  ═══════════════════════════════════════ -->
  <section class="panel" id="panel-collect">
    <div class="st-card no-print" id="cl-input-card">
      <div class="st-sec">채점 결과 링크 수집</div>
      <div style="display:flex;gap:8px;align-items:flex-start">
        <textarea id="cl-url-input" class="st-input" style="flex:1;min-height:96px;resize:vertical;line-height:1.6" placeholder="채점자들이 보낸 결과 링크를 붙여넣으세요.
줄바꿈·쉼표로 여러 개 입력 가능.

예) https://go.eduin.info/Ab3xZ"></textarea>
        <div style="display:flex;flex-direction:column;gap:6px;flex-shrink:0">
          <button class="st-btn st-btn-primary" id="cl-merge-btn" onclick="clMergeFromInput()">🧩 합치기</button>
          <button class="st-btn st-btn-danger st-btn-sm" onclick="clClearAll()">초기화</button>
          <span id="cl-merge-status" style="font-size:12px;color:var(--fg-muted);text-align:center"></span>
        </div>
      </div>
      <div class="chip-list" id="cl-chip-list" style="margin-top:10px"></div>
      <div style="font-size:11px;color:var(--fg-muted)">동일한 채점자명 링크는 덮어씁니다 · 단축주소·공유링크 모두 지원</div>
    </div>
    <div id="cl-result-wrap" style="display:none">
      <!-- renderClTable() 로 채움 -->
    </div>
  </section>
</div>

<div id="st-toast"></div>

<script is:inline="">
// ════════════════════════════════════════════════════════
//  유틸
// ════════════════════════════════════════════════════════
const clamp = (v, a, b) => Math.min(b, Math.max(a, +v || 0));
function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2, 5); }
function today() { return new Date().toISOString().slice(0, 10); }
function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function rowTotal(row) { return (row.scores || []).reduce((s, v) => s + (v ?? 0), 0); }
function shuffle(arr) {
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

let _toastTimer;
function showToast(msg) {
  const el = document.getElementById('st-toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(_toastTimer);
  _toastTimer = setTimeout(() => el.classList.remove('show'), 2800);
}

// ════════════════════════════════════════════════════════
//  탭 전환
// ════════════════════════════════════════════════════════
let currentTab = 'make';
function switchTab(id) {
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === id));
  document.querySelectorAll('.panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + id));
  currentTab = id;
}

// ════════════════════════════════════════════════════════
//  공유 URL 인코딩/디코딩 (vives-share 패턴)
// ════════════════════════════════════════════════════════
function buildShareURL(data, permission) {
  const payload = JSON.stringify({ data, permission });
  const encoded = btoa(encodeURIComponent(payload))
    .replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
  return `${location.origin}/scoring-table/#share=${encoded}`;
}

function decodeSharePayload(encoded) {
  const attempts = [
    // 현재 인코딩: btoa(encodeURIComponent(payload)) + base64url
    () => JSON.parse(decodeURIComponent(atob(padB64(encoded.replace(/-/g,'+').replace(/_/g,'/'))))),
    // 구버전 호환: btoa(payload) + base64url (encodeURIComponent 없음)
    () => JSON.parse(atob(padB64(encoded.replace(/-/g,'+').replace(/_/g,'/'))))
  ];
  for (const fn of attempts) {
    try {
      const p = fn();
      if (p && p.data && p.permission) return p;
    } catch {}
  }
  return null;
}
function padB64(s) { return s + '='.repeat((4 - s.length % 4) % 4); }

async function doShare(data, permission) {
  const longURL = buildShareURL(data, permission);
  try {
    const res = await fetch('/api/shorten', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url: longURL }),
    });
    const j = await res.json();
    if (!res.ok || !j.shortURL) { console.error('[shorten] failed:', res.status, j); throw new Error((j && j.error) || 'shorten failed'); }
    await navigator.clipboard.writeText(j.shortURL);
    showToast('링크가 복사되었습니다 ✓');
  } catch {
    try {
      await navigator.clipboard.writeText(longURL);
      showToast('링크가 복사되었습니다 (단축 미적용)');
    } catch { showToast('공유에 실패했습니다.'); }
  }
}

// ════════════════════════════════════════════════════════
//  점수 분배 알고리즘
// ════════════════════════════════════════════════════════
function distributeScore(target, areas) {
  const n = areas.length;
  if (!n) return [];
  const maxT = areas.reduce((s, a) => s + a.max, 0);
  target = clamp(target, 0, maxT);
  const base = areas.map(a => Math.floor(target * a.max / maxT));
  let rem = target - base.reduce((s, v) => s + v, 0);
  shuffle([...Array(n).keys()]).forEach(i => {
    if (rem <= 0) return;
    const room = areas[i].max - base[i];
    const add = Math.min(room, rem);
    base[i] += add; rem -= add;
  });
  return base;
}

function generateScores(rows, areas, ratio, awardRange) {
  if (!rows.length || !areas.length) return;
  const maxT = areas.reduce((s, a) => s + a.max, 0);
  const awardN = Math.round(rows.length * ratio / 100);
  let totals;

  if (awardRange.enabled && awardN > 0 && maxT > 0) {
    const aMin = Math.round(maxT * awardRange.min / 100);
    const aMax = Math.min(maxT, Math.round(maxT * awardRange.max / 100));
    const lo = Math.min(aMin, aMax), hi = Math.max(aMin, aMax);
    const awardTotals = Array.from({ length: awardN }, () =>
      lo + Math.round(Math.random() * (hi - lo)));
    const otherTotals = Array.from({ length: rows.length - awardN }, () =>
      Math.round(Math.random() * Math.max(0, lo - 1)));
    totals = shuffle([...awardTotals, ...otherTotals]);
  } else {
    totals = Array.from({ length: rows.length }, () => Math.round(Math.random() * maxT));
  }

  rows.forEach((row, i) => { row.scores = distributeScore(totals[i], areas); });
}

// ════════════════════════════════════════════════════════
//  순위/시상 계산
// ════════════════════════════════════════════════════════
function computeRanksAwards(rows, ratio) {
  const awardN = Math.round(rows.length * ratio / 100);
  const sorted = [...rows].sort((a, b) => rowTotal(b) - rowTotal(a));
  const rankMap = new Map();
  let rank = 1, prev = -1, prevRank = 1;
  sorted.forEach((r, i) => {
    const t = rowTotal(r);
    if (t !== prev) { prevRank = rank; }
    rankMap.set(r, prevRank);
    prev = t; rank++;
  });
  const awardSet = new Set(sorted.slice(0, awardN));
  return { rankMap, awardSet };
}

