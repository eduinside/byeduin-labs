// ── 표 렌더 ──
function renderMkTable() {
  const el = document.getElementById('mk-table-wrap');
  const { rows, areas, ratio, sortMode } = mk;
  if (!rows.length) { el.innerHTML = ''; return; }

  const { rankMap, awardSet } = computeRanksAwards(rows, ratio);
  const awardN = Math.round(rows.length * ratio / 100);

  const sorted = [...rows].sort((a, b) =>
    sortMode === 'name' ? a.name.localeCompare(b.name, 'ko')
    : sortMode === 'asc' ? rowTotal(a) - rowTotal(b)
    : rowTotal(b) - rowTotal(a));
  const sortLabel = sortMode === 'name' ? '이름순 ⇅' : sortMode === 'asc' ? '낮은순 ↑' : '높은순 ↓';

  const thead = `<thead><tr>
    <th class="rank-td">순위</th>
    <th style="text-align:left;min-width:80px">이름</th>
    ${areas.map(a => `<th class="area-th">${esc(a.name)}<br><span style="font-weight:400;font-size:10px;color:var(--fg-muted)">(${a.max}점)</span></th>`).join('')}
    <th class="total-th">총점</th>
    <th class="award-td">시상</th>
  </tr></thead>`;

  const tbody = `<tbody id="mk-tbody">${sorted.map(row => {
    const rIdx = rows.indexOf(row);
    const total = rowTotal(row);
    const isAward = awardSet.has(row);
    return `<tr data-ridx="${rIdx}" class="${isAward ? 'award-row' : ''}">
      <td class="rank-td">${rankMap.get(row) ?? ''}</td>
      <td class="name-td" contenteditable="true" role="textbox" aria-label="참가자 이름" data-ridx="${rIdx}" data-field="name"
        oninput="mkOnNameEdit(${rIdx},this.textContent)"
        onblur="mkNameBlur(${rIdx},this)">${esc(row.name)}</td>
      ${areas.map((a, ai) => {
        const v = row.scores[ai];
        return `<td class="score-td" contenteditable="true" role="textbox" inputmode="numeric" aria-label="${esc(a.name)} 점수(만점 ${a.max})"
          data-ridx="${rIdx}" data-ai="${ai}" data-max="${a.max}"
          oninput="mkOnScoreEdit(this)"
          onblur="mkScoreBlur(this)">${v != null ? v : ''}</td>`;
      }).join('')}
      <td class="total-td">${total}</td>
      <td class="award-td">${isAward ? '🏅' : ''}</td>
    </tr>`;
  }).join('')}</tbody>`;

  el.innerHTML = `
    ${mk.title ? `<h2 style="font-size:1.05rem;font-weight:800;margin:0 0 10px;text-align:center">${esc(mk.title)}</h2>` : ''}
    <div class="tbl-header no-print">
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <span style="font-size:13px;font-weight:700">채점 결과</span>
        <span class="info-badge" id="mk-info-badge">총 ${rows.length}명 · 시상 ${awardN}명</span>
        <button class="st-btn st-btn-ghost st-btn-sm on" onclick="mkCycleSort()">${sortLabel}</button>
      </div>
      <div class="act-row mk-btn-row">
        <button class="st-btn st-btn-ghost st-btn-sm" onclick="mkRandom()">🎲 점수 랜덤</button>
        <button class="st-btn st-btn-ghost st-btn-sm" onclick="mkShareForm()">🔗 양식 공유</button>
        <button class="st-btn st-btn-ghost st-btn-sm" onclick="mkExportXlsx()">📥 xlsx</button>
        <button class="st-btn st-btn-ghost st-btn-sm" onclick="mkSaveLocal(true)">💾 임시저장</button>
      </div>
    </div>
    <div class="grid-wrap"><table class="st-grid">${thead}${tbody}</table></div>
  `;
}

function renderMkTableHead() {
  // 헤더 영역명·만점만 업데이트 (전체 재렌더 대신)
  renderMkTable();
}

function mkCycleSort() {
  mk.sortMode = mk.sortMode === 'desc' ? 'asc' : mk.sortMode === 'asc' ? 'name' : 'desc';
  renderMkTable();
}

function mkRandom() {
  const hasScore = mk.rows.some(r => r.scores.some(s => s != null));
  if (hasScore && !confirm('지금 입력된 점수를 모두 무작위 점수로 바꿀까요?\n(되돌릴 수 없어요)')) return;
  generateScores(mk.rows, mk.areas, mk.ratio, mk.awardRange);
  renderMkTable();
  mkSaveLocal();
}

// contenteditable 핸들러
function mkOnScoreEdit(el) {
  const rIdx = +el.dataset.ridx;
  const ai   = +el.dataset.ai;
  const max  = +el.dataset.max;
  const raw  = el.textContent.trim();
  const val  = raw === '' ? null : clamp(parseInt(raw, 10) || 0, 0, max);
  mk.rows[rIdx].scores[ai] = val;
  // total 업데이트
  const tr = el.closest('tr');
  tr.querySelector('.total-td').textContent = rowTotal(mk.rows[rIdx]);
  mkUpdateRanksAwards();
}
function mkScoreBlur(el) {
  const rIdx = +el.dataset.ridx;
  const ai   = +el.dataset.ai;
  const max  = +el.dataset.max;
  const raw  = el.textContent.trim();
  const val  = raw === '' ? null : clamp(parseInt(raw, 10) || 0, 0, max);
  mk.rows[rIdx].scores[ai] = val;
  el.textContent = val != null ? val : '';
  const tr = el.closest('tr');
  tr.querySelector('.total-td').textContent = rowTotal(mk.rows[rIdx]);
  mkUpdateRanksAwards();
  mkSaveLocal();
}
function mkOnNameEdit(rIdx, text) { mk.rows[rIdx].name = text; }
function mkNameBlur(rIdx, el) { mk.rows[rIdx].name = el.textContent.trim(); el.textContent = mk.rows[rIdx].name; mkSaveLocal(); }

function mkUpdateRanksAwards() {
  const { rankMap, awardSet } = computeRanksAwards(mk.rows, mk.ratio);
  document.querySelectorAll('#mk-tbody tr').forEach(tr => {
    const rIdx = +tr.dataset.ridx;
    const row  = mk.rows[rIdx];
    if (!row) return;
    tr.querySelector('.rank-td').textContent = rankMap.get(row) ?? '';
    const isAward = awardSet.has(row);
    tr.querySelector('.award-td').textContent = isAward ? '🏅' : '';
    tr.classList.toggle('award-row', isAward);
  });
}

// 양식 공유 — 제목·이름 목록·시상 규칙 포함 (점수는 비움)
function mkShareForm() {
  const data = {
    title: mk.title,
    ratio: mk.ratio,
    areas: mk.areas.map(a => [a.name, a.max]),
    names: mk.rows.map(r => r.name),
    award: [mk.awardRange.enabled, mk.awardRange.min, mk.awardRange.max],
  };
  doShare(data, 'form');
}

// 임시저장 (localStorage)
function mkSaveLocal(notify) {
  try {
    localStorage.setItem(MK_KEY, JSON.stringify({
      title: mk.title, count: mk.count, ratio: mk.ratio,
      areaCount: mk.areaCount, areas: mk.areas, rows: mk.rows,
      awardRange: mk.awardRange, sortMode: mk.sortMode,
    }));
    if (notify) showToast('표 만들기 내용을 임시저장했습니다 💾');
  } catch {}
}
function mkLoadLocal() {
  try {
    const d = JSON.parse(localStorage.getItem(MK_KEY));
    if (!d || !Array.isArray(d.areas) || !Array.isArray(d.rows)) return false;
    mk.title = d.title || '';
    mk.count = d.count ?? d.rows.length;
    mk.ratio = d.ratio ?? 20;
    mk.areaCount = d.areaCount ?? d.areas.length;
    mk.areas = d.areas;
    mk.rows = d.rows;
    mk.awardRange = d.awardRange || { enabled: false, min: 80, max: 100 };
    mk.sortMode = d.sortMode || 'desc';
    return true;
  } catch { return false; }
}

// xlsx 내보내기
function mkExportXlsx() {
  if (typeof XLSX === 'undefined') { showToast('SheetJS 로딩 중...'); return; }
  const { rows, areas, ratio } = mk;
  if (!rows.length) { showToast('표가 비어 있습니다.'); return; }
  const { rankMap, awardSet } = computeRanksAwards(rows, ratio);
  const sorted = [...rows].sort((a, b) => rowTotal(b) - rowTotal(a));
  const header = ['순위', '이름', ...areas.map(a => `${a.name}(${a.max}점)`), '총점', '시상'];
  const data = sorted.map(row => [
    rankMap.get(row), row.name,
    ...row.scores.map(s => s ?? ''),
    rowTotal(row), awardSet.has(row) ? '★' : ''
  ]);
  const ws = XLSX.utils.aoa_to_sheet([header, ...data]);
  ws['!cols'] = [{ wch:5 }, { wch:14 }, ...areas.map(() => ({ wch:10 })), { wch:8 }, { wch:6 }];
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, '채점 결과');
  XLSX.writeFile(wb, `채점표_${today()}.xlsx`);
  showToast('xlsx 내려받기 완료');
}

// ════════════════════════════════════════════════════════
//  ── 탭 2: 채점하기 ──
// ════════════════════════════════════════════════════════
const sc = { title: '', scorer: '', areas: [], rows: [], ratio: 20,
  awardRange: { enabled: true, min: 80, max: 100 }, loaded: false };
const SC_KEY = 'vives-scoring-draft';

async function scLoadFromInput() {
  const url = document.getElementById('sc-form-url').value.trim();

  // 직접 공유 링크
  if (url.includes('#share=')) {
    const payload = decodeSharePayload(url.split('#share=')[1]);
    if (!payload || payload.permission !== 'form') { showToast('양식 링크를 읽을 수 없습니다.', 'error'); return; }
    scApplyForm(payload.data);
    return;
  }

  // 단축 URL → 서버에서 원본 URL 조회
  if (/^https?:\/\//.test(url)) {
    showToast('링크를 불러오는 중…');
    let resolved = '';
    try { resolved = await resolveShortURL(url); }
    catch (err) { showToast(err.message || '링크를 불러올 수 없습니다.', 'error'); return; }
    if (resolved.includes('#share=')) {
      const payload = decodeSharePayload(resolved.split('#share=')[1]);
      if (!payload || payload.permission !== 'form') { showToast('양식 링크를 읽을 수 없습니다.', 'error'); return; }
      scApplyForm(payload.data);
      return;
    }
    showToast('링크를 불러올 수 없습니다.', 'error');
    return;
  }

  showToast('올바른 양식 링크가 아닙니다.');
}

function scApplyForm(data) {
  // 공유 양식은 외부 데이터 — 디코드 직후 형식·범위를 맞춘다
  data = (data && typeof data === 'object') ? data : {};
  const areas = normAreas(data.areas);
  if (!areas.length) { showToast('양식에 채점 영역이 없어요.'); return; }
  sc.title  = sStr(data.title, 100);
  sc.areas  = areas;
  sc.ratio  = sInt(data.ratio, 0, 100, 20);
  if (Array.isArray(data.award)) sc.awardRange = { enabled: !!data.award[0], min: sInt(data.award[1], 0, 100, 80), max: sInt(data.award[2], 0, 100, 100) };
  sc.rows   = (Array.isArray(data.names) ? data.names.slice(0, 300) : []).map(name => ({ name: sStr(name, 40), scores: sc.areas.map(() => null) }));
  // 기존 초안 복구
  const draft = scLoadDraft();
  if (draft && draft.scorerName && Array.isArray(draft.rows) &&
      JSON.stringify(normAreas(draft.areas)) === JSON.stringify(sc.areas) &&
      JSON.stringify(draft.rows.map(r => r && r.name)) === JSON.stringify(sc.rows.map(r => r.name))) {
    sc.scorer = sStr(draft.scorerName, 40);
    sc.rows   = normRows(draft.rows, sc.areas, true);
    document.getElementById('sc-scorer').value = sc.scorer;
    showToast('이전 채점 내용을 복구했습니다');
  }
  sc.loaded = true;
  renderScTable();
}

function scLoadDraft() {
  try { return JSON.parse(localStorage.getItem(SC_KEY)); } catch { return null; }
}
function scSaveDraft(notify) {
  try {
    localStorage.setItem(SC_KEY, JSON.stringify({
      scorerName: sc.scorer, title: sc.title, ratio: sc.ratio,
      awardRange: sc.awardRange, areas: sc.areas, rows: sc.rows,
    }));
    if (notify === true) showToast('채점 내용을 임시저장했습니다 💾');
  } catch {
    if (notify === true) showToast('저장 공간이 부족해 임시저장하지 못했어요.');
  }
}
function scClearAll() {
  if (!confirm('채점 내용을 초기화할까요?')) return;
  try { localStorage.removeItem(SC_KEY); } catch {}
  sc.loaded = false; sc.rows = []; sc.scorer = '';
  document.getElementById('sc-content-wrap').style.display = 'none';
  document.getElementById('sc-setup-card').style.display = '';
  document.getElementById('sc-scorer').value = '';
  document.getElementById('sc-form-url').value = '';
  showToast('초기화되었습니다.');
}

function scUpdateProgress() {
  const total = sc.rows.length;
  const done  = sc.rows.filter(r => r.scores.every(s => s != null)).length;
  const pct   = total ? Math.round(done / total * 100) : 0;
  const fill  = document.getElementById('sc-prog-fill');
  const lbl   = document.getElementById('sc-prog-label');
  if (fill)  fill.style.width  = pct + '%';
  if (lbl)   lbl.textContent   = `${done} / ${total} 명 입력 완료`;
}

function renderScTable() {
  document.getElementById('sc-setup-card').style.display = 'none';
  const wrap = document.getElementById('sc-content-wrap');
  wrap.style.display = '';
  sc.scorer = document.getElementById('sc-scorer').value.trim() || sc.scorer;

  const thead = `<thead><tr>
    <th style="text-align:left;min-width:80px">이름</th>
    ${sc.areas.map(a => `<th class="area-th">${esc(a.name)}<br><span style="font-weight:400;font-size:10px;color:var(--fg-muted)">(${a.max}점)</span></th>`).join('')}
    <th class="total-th">총점</th>
  </tr></thead>`;

  const tbody = `<tbody>${sc.rows.map((row, ri) => `
    <tr data-ri="${ri}">
      <td class="name-td">${esc(row.name)}</td>
      ${sc.areas.map((a, ai) => `
        <td style="padding:3px 6px">
          <input class="score-num" type="number" min="0" max="${a.max}"
            value="${row.scores[ai] != null ? row.scores[ai] : ''}"
            placeholder="0" data-ri="${ri}" data-ai="${ai}" aria-label="${esc(row.name)} ${esc(a.name)} 점수(만점 ${a.max})"
            oninput="scOnInput(this)" onblur="scOnBlur(this)">
        </td>
      `).join('')}
      <td class="total-td" id="sc-total-${ri}">${rowTotal(row)}</td>
    </tr>`).join('')}</tbody>`;

  wrap.innerHTML = `
    ${sc.title ? `<h2 style="font-size:1.05rem;font-weight:800;margin:0 0 10px;text-align:center">${esc(sc.title)}</h2>` : ''}
    <div class="st-card no-print" style="padding:12px 20px">
      <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
        <label class="sf-label" for="sc-scorer-inline" style="margin:0">채점자</label>
        <input id="sc-scorer-inline" class="st-input" type="text" placeholder="채점자 이름" value="${esc(sc.scorer)}"
          style="width:160px" oninput="sc.scorer=this.value;scSaveDraft()">
        <span class="info-badge">${sc.rows.length}명 · ${sc.areas.length}개 영역</span>
      </div>
      <div class="prog-wrap">
        <div class="prog-bar"><div class="prog-fill" id="sc-prog-fill" style="width:0%"></div></div>
        <div class="prog-label" id="sc-prog-label">0 / ${sc.rows.length} 명 입력 완료</div>
      </div>
    </div>
    <div class="grid-wrap"><table class="st-grid">${thead}${tbody}</table></div>
    <div class="act-row sc-btn-row no-print" style="margin-top:12px;gap:8px">
      <button class="st-btn st-btn-primary" onclick="scSubmit()">🔗 수합자에게 공유</button>
      <button class="st-btn st-btn-ghost" onclick="scExportXlsx()">📥 xlsx</button>
      <button class="st-btn st-btn-ghost" onclick="scAutoFill()">🎲 규칙에 따른 자동배점</button>
      <button class="st-btn st-btn-ghost" onclick="scSaveDraft(true)">💾 임시저장</button>
      <button class="st-btn st-btn-danger st-btn-sm" onclick="scClearAll()">초기화</button>
    </div>
  `;
  scUpdateProgress();
}

function scAutoFill() {
  if (!sc.rows.length) return;
  const hasScore = sc.rows.some(r => r.scores.some(s => s != null));
  if (hasScore && !confirm('지금 입력한 점수를 모두 자동배점 점수로 바꿀까요?\n(되돌릴 수 없어요)')) return;
  generateScores(sc.rows, sc.areas, sc.ratio, sc.awardRange);
  renderScTable();
  scSaveDraft();
  showToast('규칙에 따라 점수를 자동배점했습니다');
}

function scOnInput(inp) {
  const ri = +inp.dataset.ri, ai = +inp.dataset.ai;
  const max = sc.areas[ai].max;
  const raw = inp.value.trim();
  const val = raw === '' ? null : clamp(parseInt(raw, 10) || 0, 0, max);
  sc.rows[ri].scores[ai] = val;
  document.getElementById(`sc-total-${ri}`).textContent = rowTotal(sc.rows[ri]);
  scUpdateProgress();
  scSaveDraft();
}
function scOnBlur(inp) {
  const ri = +inp.dataset.ri, ai = +inp.dataset.ai;
  const max = sc.areas[ai].max;
  const raw = inp.value.trim();
  const val = raw === '' ? null : clamp(parseInt(raw, 10) || 0, 0, max);
  sc.rows[ri].scores[ai] = val;
  inp.value = val != null ? val : '';
  document.getElementById(`sc-total-${ri}`).textContent = rowTotal(sc.rows[ri]);
  scSaveDraft();
}

async function scSubmit() {
  const inline = document.getElementById('sc-scorer-inline');
  if (inline) sc.scorer = inline.value.trim();
  if (!sc.scorer) { showToast('채점자 이름을 입력해 주세요.'); return; }
  const hasEmpty = sc.rows.some(r => r.scores.some(s => s == null));
  if (hasEmpty && !confirm('미입력 칸이 있습니다. 계속 진행할까요?')) return;
  const data = {
    scorer: sc.scorer,
    ratio:  sc.ratio,
    areas:  sc.areas.map(a => [a.name, a.max]),
    rows:   sc.rows.map(r => [r.name, r.scores.map(s => s ?? 0)]),
  };
  await doShare(data, 'result');
}

function scExportXlsx() {
  if (typeof XLSX === 'undefined') { showToast('SheetJS 로딩 중...'); return; }
  if (!sc.rows.length) { showToast('채점 내용이 없습니다.'); return; }
  const header = ['이름', ...sc.areas.map(a => `${a.name}(${a.max}점)`), '총점'];
  const data   = sc.rows.map(r => [r.name, ...r.scores.map(s => s ?? ''), rowTotal(r)]);
  const ws = XLSX.utils.aoa_to_sheet([header, ...data]);
  ws['!cols'] = [{ wch:14 }, ...sc.areas.map(() => ({ wch:10 })), { wch:8 }];
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, `채점_${sc.scorer || '결과'}`);
  XLSX.writeFile(wb, `채점_${sc.scorer || '결과'}_${today()}.xlsx`);
  showToast('xlsx 내려받기 완료');
}

// ════════════════════════════════════════════════════════
//  ── 탭 3: 수합하기 ──
// ════════════════════════════════════════════════════════
const cl = { results: [], aggregateBy: 'avg', sortMode: 'desc' };
const CL_KEY = 'vives-scoring-collect';

// 한 줄 → 결과 payload 디코드 (단축주소는 서버에서 역추적)
async function clResolveLine(line) {
  if (line.includes('#share=')) {
    return decodeSharePayload(line.split('#share=')[1]);
  }
  if (/^https?:\/\//.test(line)) {
    try {
      const resolved = await resolveShortURL(line);
      if (resolved.includes('#share=')) return decodeSharePayload(resolved.split('#share=')[1]);
    } catch { /* 한 줄 실패는 '실패 n건'으로 묶어서 알림 */ }
  }
  return null;
}

async function clMergeFromInput() {
  const text = document.getElementById('cl-url-input').value;
  const lines = [...new Set(text.split(/[\n\r,]+/).map(s => s.trim()).filter(Boolean))];
  if (!lines.length) { showToast('링크를 입력해 주세요.'); return; }

  const btn = document.getElementById('cl-merge-btn');
  const status = document.getElementById('cl-merge-status');
  btn.disabled = true;
  let ok = 0, fail = 0;
  for (let i = 0; i < lines.length; i++) {
    if (status) status.textContent = `처리 중… ${i + 1}/${lines.length}`;
    const payload = await clResolveLine(lines[i]);
    if (payload && payload.permission === 'result') { clAddResult(payload.data, true); ok++; }
    else fail++;
  }
  btn.disabled = false;
  if (status) status.textContent = '';
  renderClChips();
  renderClTable();
  clSaveLocal();
  if (ok) {
    document.getElementById('cl-url-input').value = '';
    showToast(`✓ ${ok}명 수합 완료${fail ? ` (실패 ${fail}건)` : ''}`);
  } else {
    showToast('읽을 수 있는 결과 링크가 없습니다.', 'error');
  }
}

function clSaveLocal(notify) {
  try {
    localStorage.setItem(CL_KEY, JSON.stringify({
      results: cl.results, aggregateBy: cl.aggregateBy, sortMode: cl.sortMode,
    }));
    if (notify) showToast('수합 내용을 임시저장했습니다 💾');
  } catch {}
}
function clLoadLocal() {
  try {
    const d = JSON.parse(localStorage.getItem(CL_KEY));
    if (!d || !Array.isArray(d.results) || !d.results.length) return false;
    // 예전에 결과 링크에서 그대로 저장된 값일 수 있어 다시 검증
    cl.results = d.results.slice(0, 100).map(normResult);
    cl.aggregateBy = d.aggregateBy || 'avg';
    cl.sortMode = d.sortMode || (d.sortAsc ? 'asc' : 'desc'); // 구버전 호환
    return true;
  } catch { return false; }
}

function clClearAll() {
  if (cl.results.length && !confirm('수합 내용을 초기화할까요?')) return;
  cl.results = [];
  cl.aggregateBy = 'avg';
  cl.sortMode = 'desc';
  try { localStorage.removeItem(CL_KEY); } catch {}
  renderClChips();
  renderClTable();
  showToast('초기화되었습니다.');
}

// 결과 링크·저장본 → 검증된 결과 항목 (점수는 영역 만점 범위의 정수)
function normResult(data) {
  data = (data && typeof data === 'object') ? data : {};
  const areas = normAreas(data.areas);
  const entry = {
    scorer: sStr(typeof data.scorer === 'string' ? data.scorer.trim() : data.scorer, 40) || '알 수 없음',
    ratio:  sInt(data.ratio, 0, 100, 20),
    areas,
    rows:   normRows(data.rows, areas, false),
  };
  if (data._ov && typeof data._ov === 'object') {
    entry._ov = {};
    Object.keys(data._ov).slice(0, 600).forEach(k => {
      const v = data._ov[k];
      if (v != null) entry._ov[sStr(k, 60)] = sInt(v, 0, 100000, 0);
    });
  }
  return entry;
}

function clAddResult(data, silent) {
  const entry = normResult(data);
  const scorer = entry.scorer;
  // 동일 채점자 덮어쓰기
  const idx = cl.results.findIndex(r => r.scorer === scorer);
  if (idx >= 0) cl.results[idx] = entry; else cl.results.push(entry);
  if (!silent) {
    renderClChips();
    renderClTable();
    clSaveLocal();
    showToast(`${scorer} 채점 결과 추가됨`);
  }
}

function clRemoveResult(idx) {
  if (!cl.results[idx]) return;
  cl.results.splice(idx, 1);
  renderClChips();
  renderClTable();
  clSaveLocal();
}

// 채점자 이름은 외부 데이터 — 인라인 onclick 대신 data-idx + 이벤트 위임
function renderClChips() {
  const el = document.getElementById('cl-chip-list');
  el.innerHTML = cl.results.map((r, i) =>
    `<span class="chip">${esc(r.scorer)}
      <button type="button" class="chip-del" data-idx="${i}" title="제거" aria-label="${esc(r.scorer)} 결과 제거">×</button>
    </span>`
  ).join('');
}
document.getElementById('cl-chip-list').addEventListener('click', (e) => {
  const btn = e.target.closest('.chip-del[data-idx]');
  if (btn) clRemoveResult(+btn.dataset.idx);
});

// 종합 집계 계산
function clAggregate() {
  if (!cl.results.length) return { names:[], scorerList:[], aggRows:[], ratio:20 };
  const ratio = cl.results[0].ratio;
  const scorerList = cl.results.map(r => r.scorer);
  // 동명이인 구분: 한 채점표 안에서 같은 이름의 k번째 사람을 같은 참가자로 본다.
  // 키는 첫 번째는 이름 그대로(예전 저장본 호환), 두 번째부터 이름+구분자+번호. 화면에는 "이름 (2)".
  const SEP = '\u0001';
  const rowKeys = r => {
    const seen = {};
    return r.rows.map(row => {
      const k = seen[row.name] = (seen[row.name] || 0) + 1;
      return k === 1 ? row.name : row.name + SEP + k;
    });
  };
  // 전체 참가자 합집합 (순서 보존)
  const nameSet = new Map();   // key → 표시 이름
  const scoreMap = new Map();  // key → { scorer: total }
  cl.results.forEach(r => {
    const keys = rowKeys(r);
    r.rows.forEach((row, i) => {
      const key = keys[i];
      if (!nameSet.has(key)) {
        const n = key.split(SEP)[1];
        nameSet.set(key, n ? `${row.name} (${n})` : row.name);
      }
      if (!scoreMap.has(key)) scoreMap.set(key, {});
      const ov = r._ov && r._ov[key];
      scoreMap.get(key)[r.scorer] = ov != null ? ov : row.scores.reduce((s, v) => s + (v ?? 0), 0);
    });
  });
  const names = [...nameSet.values()];

  const aggRows = [...nameSet.entries()].map(([key, name]) => {
    const byScorer = scoreMap.get(key) || {};
    const vals = scorerList.map(s => byScorer[s] != null ? byScorer[s] : null);
    const filled = vals.filter(v => v != null);
    const sum = filled.reduce((s, v) => s + v, 0);
    const avg = filled.length ? sum / filled.length : 0;
    return { key, name, vals, sum, avg };
  });

  return { names, scorerList, aggRows, ratio };
}

function renderClTable() {
  const wrap = document.getElementById('cl-result-wrap');
  if (!cl.results.length) { wrap.style.display = 'none'; return; }
  wrap.style.display = '';

  const { scorerList, aggRows, ratio } = clAggregate();
  const awardN = Math.round(aggRows.length * ratio / 100);

  // 집계 기준에 따라 정렬
  const getSortVal = r => cl.aggregateBy === 'sum' ? r.sum : r.avg;
  // 석차 비교값: 화면에 보이는 값(평균은 소수 첫째 자리) 기준으로 동점 판단
  const rankVal = r => cl.aggregateBy === 'sum' ? r.sum : Math.round(r.avg * 10) / 10;
  const sorted = [...aggRows].sort((a, b) =>
    cl.sortMode === 'name' ? a.name.localeCompare(b.name, 'ko')
    : cl.sortMode === 'asc' ? getSortVal(a) - getSortVal(b)
    : getSortVal(b) - getSortVal(a));

  // 석차 계산 (동점은 같은 석차)
  const rankSorted = [...aggRows].sort((a, b) => getSortVal(b) - getSortVal(a));
  const ranks = tieRanks(rankSorted.map(rankVal));
  const rankMap = new Map();
  rankSorted.forEach((r, i) => rankMap.set(r.key, ranks[i]));
  const awardNames = new Set(rankSorted.slice(0, awardN).map(r => r.key));

  const thead = `<thead><tr>
    <th class="rank-td">순위</th>
    <th style="text-align:left;min-width:80px">이름</th>
    ${scorerList.map(s => `<th style="min-width:80px">${esc(s)}</th>`).join('')}
    <th class="total-th">합계</th>
    <th style="min-width:64px">평균</th>
    <th class="award-td">시상</th>
  </tr></thead>`;

  const tbody = `<tbody id="cl-tbody">${sorted.map(row => {
    const isAward = awardNames.has(row.key);
    return `<tr data-name="${esc(row.key)}" class="${isAward ? 'award-row' : ''}">
      <td class="rank-td">${rankMap.get(row.key) ?? ''}</td>
      <td class="name-td">${esc(row.name)}</td>
      ${row.vals.map((v, si) => `<td class="score-td cl-score-cell"
        contenteditable="true" role="textbox" inputmode="numeric" aria-label="${esc(row.name)} 점수" data-name="${esc(row.key)}" data-si="${si}"
        oninput="clOnScoreEdit(this)" onblur="clOnScoreBlur(this)">${v != null ? v : '-'}</td>`).join('')}
      <td class="total-td">${row.sum}</td>
      <td>${row.avg.toFixed(1)}</td>
      <td class="award-td">${isAward ? '🏅' : ''}</td>
    </tr>`;
  }).join('')}</tbody>`;

  wrap.innerHTML = `
    <div class="tbl-header no-print">
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <span style="font-size:13px;font-weight:700">종합 결과</span>
        <span class="info-badge">채점자 ${scorerList.length}명 · 참가자 ${aggRows.length}명 · 시상 ${awardN}명</span>
        <button class="st-btn st-btn-ghost st-btn-sm ${cl.aggregateBy==='avg'?'on':''}" onclick="clSetAggregate('avg')">평균 기준</button>
        <button class="st-btn st-btn-ghost st-btn-sm ${cl.aggregateBy==='sum'?'on':''}" onclick="clSetAggregate('sum')">합계 기준</button>
        <button class="st-btn st-btn-ghost st-btn-sm ${cl.sortMode!=='name'?'on':''}" onclick="clCycleSort()">
          ${ cl.sortMode === 'name' ? '이름순 ⇅' : cl.sortMode === 'asc' ? '낮은순 ↑' : '높은순 ↓' }
        </button>
      </div>
      <div class="act-row cl-btn-row">
        <button class="st-btn st-btn-ghost st-btn-sm" onclick="clExportXlsx()">📥 xlsx</button>
        <button class="st-btn st-btn-ghost st-btn-sm" onclick="clSaveLocal(true)">💾 임시저장</button>
      </div>
    </div>
    <div class="grid-wrap"><table class="st-grid">${thead}${tbody}</table></div>

    <!-- 채점자별 상세 -->
    <div class="detail-section" id="cl-detail-section">
      <button type="button" class="detail-toggle no-print" id="cl-detail-toggle" aria-expanded="false" aria-controls="cl-detail-body" onclick="clToggleDetail()">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        채점자별 상세
      </button>
      <div class="detail-body" id="cl-detail-body">
        ${clBuildDetailTables()}
      </div>
    </div>
  `;
}

function clBuildDetailTables() {
  return cl.results.map(r => {
    const thead = `<thead><tr>
      <th style="text-align:left">이름</th>
      ${r.areas.map(a => `<th>${esc(a.name)}<br><span style="font-weight:400;font-size:10px">(${a.max}점)</span></th>`).join('')}
      <th>총점</th>
    </tr></thead>`;
    const sorted = [...r.rows].sort((a, b) => rowTotal(b) - rowTotal(a));
    const tbody = `<tbody>${sorted.map(row => `<tr>
      <td class="name-td">${esc(row.name)}</td>
      ${row.scores.map(s => `<td class="score-td">${s}</td>`).join('')}
      <td class="total-td">${rowTotal(row)}</td>
    </tr>`).join('')}</tbody>`;
    return `<div style="margin-bottom:20px">
      <div class="detail-scorer-name" style="font-size:12px;font-weight:700;color:var(--fg-muted);margin:10px 0 6px">
        ◆ ${esc(r.scorer)}
      </div>
      <div class="grid-wrap"><table class="st-grid">${thead}${tbody}</table></div>
    </div>`;
  }).join('');
}

function clToggleDetail() {
  const toggle = document.getElementById('cl-detail-toggle');
  const body   = document.getElementById('cl-detail-body');
  if (!toggle || !body) return;
  const open = body.classList.toggle('open');
  toggle.classList.toggle('open', open);
  toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
}

function clSetAggregate(mode) { cl.aggregateBy = mode; renderClTable(); clSaveLocal(); }
function clCycleSort() {
  cl.sortMode = cl.sortMode === 'desc' ? 'asc' : cl.sortMode === 'asc' ? 'name' : 'desc';
  renderClTable(); clSaveLocal();
}

// contenteditable 핸들러 — DOM 기반으로 in-place 업데이트
function clOnScoreEdit(el) {
  // 입력 중에는 행 합계/평균만 실시간 갱신
  _clRefreshRowTotals(el.closest('tr'));
  clUpdateAllRanksAwards();
}
function clOnScoreBlur(el) {
  const raw = el.textContent.trim();
  const val = (raw === '-' || raw === '') ? null : Math.max(0, parseInt(raw, 10) || 0);
  el.textContent = val != null ? val : '-';
  // 편집 총점을 해당 채점자의 오버라이드로 저장 (상세표 per-영역 점수는 보존)
  const name = el.dataset.name;
  const scorer = clAggregate().scorerList[+el.dataset.si];
  const result = cl.results.find(r => r.scorer === scorer);
  if (result) {
    result._ov = result._ov || {};
    if (val == null) delete result._ov[name]; else result._ov[name] = val;
  }
  _clRefreshRowTotals(el.closest('tr'));
  clUpdateAllRanksAwards();
  clSaveLocal();
}

function _clRefreshRowTotals(tr) {
  if (!tr) return;
  const vals = [...tr.querySelectorAll('.cl-score-cell')].map(td => {
    const t = td.textContent.trim();
    return (t === '-' || t === '') ? null : (parseInt(t, 10) || 0);
  });
  const filled = vals.filter(v => v != null);
  const sum = filled.reduce((s, v) => s + v, 0);
  const avg = filled.length ? sum / filled.length : 0;
  // 합계: 뒤에서 3번째 td, 평균: 2번째, 시상: 1번째
  const tds = tr.querySelectorAll('td');
  const n = tds.length;
  tds[n - 3].textContent = sum;
  tds[n - 2].textContent = avg.toFixed(1);
}

function clUpdateAllRanksAwards() {
  const tbody = document.getElementById('cl-tbody');
  if (!tbody) return;
  const { ratio } = clAggregate();
  const trs = [...tbody.querySelectorAll('tr')];
  const rowData = trs.map(tr => {
    const tds = tr.querySelectorAll('td');
    const n = tds.length;
    const sum = parseFloat(tds[n - 3].textContent) || 0;
    const avg = parseFloat(tds[n - 2].textContent) || 0;
    return { tr, val: cl.aggregateBy === 'sum' ? sum : avg };
  });
  const sorted = [...rowData].sort((a, b) => b.val - a.val);
  const awardN = Math.round(trs.length * ratio / 100);
  const ranks = tieRanks(sorted.map(d => d.val));   // 동점은 같은 석차
  sorted.forEach(({ tr }, i) => {
    const rank = ranks[i];
    const isAward = i < awardN;
    tr.querySelector('.rank-td').textContent = rank;
    tr.querySelector('.award-td').textContent = isAward ? '🏅' : '';
    tr.classList.toggle('award-row', isAward);
  });
}

function clExportXlsx() {
  if (typeof XLSX === 'undefined') { showToast('SheetJS 로딩 중...'); return; }
  if (!cl.results.length) { showToast('수집된 결과가 없습니다.'); return; }
  const wb = XLSX.utils.book_new();
  const { scorerList, aggRows, ratio } = clAggregate();
  const getSortVal = r => cl.aggregateBy === 'sum' ? r.sum : r.avg;
  // 석차 비교값: 화면에 보이는 값(평균은 소수 첫째 자리) 기준으로 동점 판단
  const rankVal = r => cl.aggregateBy === 'sum' ? r.sum : Math.round(r.avg * 10) / 10;
  const sorted = [...aggRows].sort((a, b) => getSortVal(b) - getSortVal(a));
  const awardN = Math.round(aggRows.length * ratio / 100);
  const awardNames = new Set(sorted.slice(0, awardN).map(r => r.key));
  const ranks = tieRanks(sorted.map(rankVal));
  const rankMap = new Map(sorted.map((r, i) => [r.key, ranks[i]]));

  // 시트1: 종합
  const header1 = ['순위', '이름', ...scorerList, '합계', '평균', '시상'];
  const data1   = sorted.map(r => [
    rankMap.get(r.key), r.name,
    ...r.vals.map(v => v != null ? v : ''),
    r.sum, r.avg.toFixed(1), awardNames.has(r.key) ? '★' : ''
  ]);
  const ws1 = XLSX.utils.aoa_to_sheet([header1, ...data1]);
  ws1['!cols'] = [{ wch:5 }, { wch:14 }, ...scorerList.map(() => ({ wch:10 })), { wch:8 }, { wch:8 }, { wch:5 }];
  XLSX.utils.book_append_sheet(wb, ws1, '종합 결과');

  // 시트2~: 채점자별 (시트 이름에 못 쓰는 글자 치환, 31자 제한·중복 방지)
  const usedSheets = new Set(['종합 결과']);
  cl.results.forEach(r => {
    const h = ['이름', ...r.areas.map(a => `${a.name}(${a.max}점)`), '총점'];
    const d = [...r.rows].sort((a, b) => rowTotal(b) - rowTotal(a))
      .map(row => [row.name, ...row.scores.map(s => s ?? ''), rowTotal(row)]);
    const ws = XLSX.utils.aoa_to_sheet([h, ...d]);
    ws['!cols'] = [{ wch:14 }, ...r.areas.map(() => ({ wch:10 })), { wch:8 }];
    let sheet = (r.scorer.replace(/[:\\\/?*\[\]]/g, '_').slice(0, 28) || '채점자');
    for (let n = 2; usedSheets.has(sheet); n++) sheet = sheet.slice(0, 28) + '_' + n;
    usedSheets.add(sheet);
    XLSX.utils.book_append_sheet(wb, ws, sheet);
  });

  XLSX.writeFile(wb, `채점표_수합_${today()}.xlsx`);
  showToast('xlsx 내려받기 완료');
}

// ════════════════════════════════════════════════════════
//  INIT
// ════════════════════════════════════════════════════════
// 탭 2 임시저장 복구
function scInitRestore() {
  const d = scLoadDraft();
  if (d && Array.isArray(d.areas) && d.areas.length && Array.isArray(d.rows) && d.rows.length) {
    // 초안은 예전에 공유 양식에서 온 값이라 다시 검증
    sc.title = sStr(d.title, 100);
    sc.scorer = sStr(d.scorerName, 40);
    sc.ratio = sInt(d.ratio, 0, 100, 20);
    const ar = d.awardRange;
    if (ar && typeof ar === 'object') sc.awardRange = { enabled: !!ar.enabled, min: sInt(ar.min, 0, 100, 80), max: sInt(ar.max, 0, 100, 100) };
    sc.areas = normAreas(d.areas);
    sc.rows = normRows(d.rows, sc.areas, true);
    sc.loaded = true;
    renderScTable();
    return true;
  }
  return false;
}

(function init() {
  // 탭 1 — 임시저장 복구 또는 기본값
  if (!mkLoadLocal()) mkInit();
  renderMkSettings();
  renderMkTable();

  // 탭 2 — 임시저장 복구
  scInitRestore();

  // 탭 3 — 임시저장 복구
  if (clLoadLocal()) { renderClChips(); renderClTable(); }

  const hash = location.hash;
  if (hash.startsWith('#share=')) {
    const payload = decodeSharePayload(hash.slice(7));
    history.replaceState(null, '', location.pathname);
    if (payload) {
      if (payload.permission === 'form') {
        switchTab('score');
        scApplyForm(payload.data);
        showToast('채점 양식을 불러왔습니다');
        return;
      }
      if (payload.permission === 'result') {
        switchTab('collect');
        clAddResult(payload.data);
        return;
      }
    }
    showToast('공유 링크를 읽을 수 없습니다.');
  }
})();
</script>



