}

function renderPanel() {
  const m = LANDMARKS[idx];
  const vt = document.getElementById('viewerTitle');
  if (vt) vt.innerHTML = `<span class="num">${idx + 1}</span> ${m.emoji} ${m.name}`;

  // 국기 이미지(flagcdn) + 헤더 렌더링 — Windows Chrome 국기 이모지 미지원 대응
  document.getElementById('sideHead').innerHTML = `
    <button type="button" class="side-home-btn" onclick="exitExplore()" title="처음 화면으로">${icon('house')} 처음 화면</button>
    <div class="flag">
      ${flagMarkup(flagEmojiToCode(m.countryFlag), m.countryName, 'sm')}
      <span>${m.countryName} (수도: ${m.capital})</span>
    </div>
    <h2>${m.emoji} ${m.name}</h2>
    <div class="height">인사말: <strong>"${m.greeting}"</strong> · ${idx + 1}번째 나라</div>
  `;

  const isStamped = stamps.includes(m.id);

  // 진행 막대는 모은 도장 수(지금 몇 번째 나라인지와 따로)
  let bodyHtml = `
    <div class="progress-zone">
      <div class="progress-track" role="progressbar" aria-label="모은 도장" aria-valuemin="0" aria-valuemax="${LANDMARKS.length}" aria-valuenow="${stamps.length}"><div class="progress-fill" style="width:${stamps.length / LANDMARKS.length * 100}%"></div></div>
      <div class="progress-label"><span>모은 도장 ${stamps.length} / ${LANDMARKS.length}</span><span>${idx + 1}번째 나라</span></div>
    </div>

    <div class="observe-box">
      <h3>${icon('search')} 관찰 포인트</h3>
      <p>${m.observe}</p>
    </div>

    <!-- 문화 도감 카드 -->
    <div class="culture-card">
      <button class="culture-speak-btn" onclick="speakCulture('${m.id}')" id="speakBtn" title="설명 읽어주기" aria-label="${m.countryName} 문화 소개 소리로 읽어주기">${icon('volume-2')}</button>
      <div class="culture-title">${icon('globe')} ${m.countryName}의 대표 문화 소개</div>
      <div class="culture-grid">
        <div class="culture-item">
          <span class="icon" aria-hidden="true">${icon('utensils')}</span>
          <span class="label">대표 음식</span>
          <span class="name">${m.food}</span>
        </div>
        <div class="culture-item">
          <span class="icon" aria-hidden="true">${icon('shirt')}</span>
          <span class="label">대표 옷</span>
          <span class="name">${m.clothes}</span>
        </div>
        <div class="culture-item">
          <span class="icon" aria-hidden="true">${icon('house')}</span>
          <span class="label">대표 집</span>
          <span class="name">${m.house}</span>
        </div>
      </div>
    </div>

    <div class="quiz-zone" id="quiz" aria-live="polite">
  `;

  if (isStamped) {
    bodyHtml += `
      <div class="reveal">
        <div class="reveal-banner correct">${icon('party-popper')} 이미 도장을 쾅 모았어요!</div>
        <div class="passport-stamp-zone">
          <div class="passport-stamp stamped">${icon('plane')} 탐험인증</div>
        </div>
        <div class="explain">${m.explain}</div>
        <div class="next-zone">${nextBtnHtml()}</div>
      </div>
    `;
  } else {
    bodyHtml += `
      <div class="quiz-q">${m.quiz.q}</div>
      <div class="quiz-btns">
        ${shuffleArr(m.quiz.choices).map(c => `
          <button type="button" class="quiz-btn" onclick="submitAnswer('${c}')">${c}</button>
        `).join('')}
      </div>
    `;
  }

  bodyHtml += `
    </div>

