  app.innerHTML = `
  <div class="research-wrap">
    <div class="research-top">
      <h1>${icon('notebook-pen')} 나라 조사하기</h1>
      <button type="button" class="back-link" onclick="history.replaceState(null,'',location.pathname); appModeReset();">${icon('house')} 처음 화면</button>
    </div>
    <div class="extlink-notice">${icon('link')} <span>조사 링크는 유튜브·네이버 등 외부 사이트로 연결돼요. 선생님·부모님과 함께 살펴보세요.</span></div>

    <div class="howto-card">
      <h3>${icon('list-ordered')} 조사하는 순서</h3>
      <div class="howto-steps">
        <div class="howto-step"><span class="step-num">1</span><br>조사할 나라<br>고르기</div>
        <div class="howto-step"><span class="step-num">2</span><br>7가지 항목<br>살펴보기</div>
        <div class="howto-step"><span class="step-num">3</span><br>조사 링크로<br>더 알아보기</div>
        <div class="howto-step"><span class="step-num">4</span><br>공책이나 학습지에<br>정리하기</div>
      </div>
    </div>

    <div class="continent-tabs">
      ${CONTINENTS.map(ct => {
        const n = ct.id === 'all' ? COUNTRIES.length : COUNTRIES.filter(c => c.continent === ct.id).length;
        return `<button type="button" class="continent-tab ${continentFilter === ct.id ? 'active' : ''}" aria-pressed="${continentFilter === ct.id}" onclick="setContinent('${ct.id}')">${ct.name}<span class="cnt" aria-label="(${n}개 나라)">${n}</span></button>`;
      }).join('')}
    </div>

    <div class="country-grid">
      ${list.map(c => {
        const done = checkedCount(c.id);
        const contName = CONTINENTS.find(ct => ct.id === c.continent)?.name || '';
        return `
        <button type="button" class="country-card" onclick="location.hash='#research/${c.id}'">
          ${flagImg(c)}
          <div class="country-name">${c.nameKo}</div>
          <div class="country-sub">${contName} · 수도 ${c.capital.name}</div>
          <div class="country-progress ${done ? '' : 'zero'}">${done ? `${icon('check')} 조사 ${done} / ${SECTION_KEYS.length}` : `조사 전 · 0 / ${SECTION_KEYS.length}`}</div>
        </button>`;
      }).join('')}
    </div>
  </div>`;
