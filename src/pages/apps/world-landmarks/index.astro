        <ol>
          <li>여섯 대륙 <b>27개 나라</b> 중에서 조사할 나라를 골라요.</li>
          <li>국기·위치·수도·인사말·음식·자랑거리·문화 <strong>7가지 항목</strong>을 살펴봐요.</li>
          <li>조사 링크로 더 알아보고, 알게 된 것을 <b>공책이나 학습지에 정리</b>하세요!</li>
        </ol>
      </div>

      <button class="btn btn-primary" onclick="goResearch()">${icon('notebook-pen')} 나라 조사하기</button>
    </div>
  </div>
  </div>`;
}

function renderExplore() {
  document.body.classList.add('exploring');
  app.innerHTML = `
  <div class="explore">
    <div class="map-zone">
      <div id="map"></div>
      <div class="map-top">
        <div class="viewer-title" id="viewerTitle"></div>
        <div class="hint-chip" id="hintChip">${icon('hand')} 지도를 끌거나 돌려서 랜드마크를 살펴보세요!</div>
      </div>
      <div class="map-loading" id="mapLoading"><div class="spin">${icon('globe')}</div>3D 지도 불러오는 중...</div>
      <div class="cam-bar sk-actions" role="group" aria-label="지도 보는 방법">
        <button type="button" class="sk-btn sk-btn--sm" onclick="camReturn()" title="랜드마크로 시점 돌아가기">${icon('locate-fixed')} 제자리로</button>
        <button type="button" class="sk-btn sk-btn--sm" id="orbitBtn" onclick="toggleOrbit()" aria-pressed="false">${icon('rotate-cw')} 한 바퀴</button>
        <button type="button" class="sk-btn sk-btn--sm" onclick="camTop()">${icon('circle-arrow-down')} 위에서 보기</button>
        <button type="button" class="sk-btn sk-btn--sm" onclick="camTilt()">${icon('mountain')} 3D 보기</button>
      </div>
    </div>
    <aside class="side">
      <div class="side-head" id="sideHead"></div>
      <div class="side-body" id="sideBody"></div>
    </aside>
  </div>`;

  mapNoticeShown = false;
