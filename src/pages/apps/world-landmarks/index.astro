    <div style="margin-top:20px; border-top:1px dashed var(--border); padding-top:14px;">
      <h4 style="font-size:14px; font-weight:800; color:var(--navy); opacity:0.8; display:flex; align-items:center; gap:6px;">${icon('stamp')} 내 여권 도장 (${stamps.length} / ${LANDMARKS.length})</h4>
