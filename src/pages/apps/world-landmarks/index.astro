}

window.appModeReset = function() {
  appMode = 'intro';
  renderIntro();
};

/* ── 조사 모드: 나라 상세 ── */
function sectionBox(c, key, title, inner, chips) {
  const on = (researchChecks[c.id] || []).includes(key);
  return `
  <section class="report-section ${on ? 'checked' : ''}" id="sec-${key}">
    <div class="report-section-head">
      <h3>${title}</h3>
      <button type="button" class="check-btn ${on ? 'on' : ''}" aria-pressed="${on}" onclick="toggleCheck('${c.id}','${key}')">${checkBtnHtml(on)}</button>
    </div>
    ${inner}
    ${chips && chips.length ? `<div class="link-chips">${chips.join('')}</div>` : ''}
  </section>`;
}

// @icons square-check square
function checkBtnHtml(on) { return icon(on ? 'square-check' : 'square') + ' 조사했어요'; }

function itemCards(items) {
  return `<div class="item-cards">${items.map(i => `
    <div class="item-card">
      <div class="item-title">${i.emoji} ${i.name}</div>
      <div class="item-desc">${i.desc}</div>
    </div>`).join('')}</div>`;
}

function renderResearchDetail(c) {
  document.body.classList.remove('exploring');
  const done = checkedCount(c.id);
  const contName = CONTINENTS.find(ct => ct.id === c.continent)?.name || '';
  const i = COUNTRIES.indexOf(c);
  const prev = COUNTRIES[(i - 1 + COUNTRIES.length) % COUNTRIES.length];
  const next = COUNTRIES[(i + 1) % COUNTRIES.length];
  const landmark = c.landmarkId ? LANDMARKS.findIndex(l => l.id === c.landmarkId) : -1;

  app.innerHTML = `
  <div class="research-wrap">
    <div class="research-top">
      <button type="button" class="back-link" onclick="location.hash='#research'">${icon('arrow-left')} 나라 목록</button>
    </div>

    <div class="country-head">
      ${flagImg(c, true)}
      <h1>${c.nameKo}</h1>
      <div class="head-sub">${contName} · 수도 ${c.capital.name}</div>
      ${landmark >= 0 ? `<button type="button" class="explore-link" onclick="exploreFromResearch(${landmark})">${icon('plane-takeoff')} 탐험 모드에서 3D로 보기</button>` : ''}
    </div>

    <div class="research-progress">
      <div class="progress-track"><div class="progress-fill" id="rProgressFill" style="width:${done / SECTION_KEYS.length * 100}%"></div></div>
      <div class="progress-label"><span>조사 진행</span><span id="rProgressNum">${done} / ${SECTION_KEYS.length}</span></div>
    </div>

    ${sectionBox(c, 'flag', icon('flag') + ' 국기', `
      <div class="report-flag-row">
        ${flagImg(c, true)}
        <p class="section-desc">${c.flag.meaning}</p>
      </div>`,
      [chipNi(`${c.nameKo} 국기 의미`, '국기 의미 사진'), chipNv(`${c.nameKo} 국기`, '국기 검색')])}

    ${sectionBox(c, 'location', icon('map-pin') + ' 위치', `
      <p class="section-desc">${c.location.desc}</p>
      <div class="mini-map-box" id="miniMap-${c.id}"><div class="mini-map-loading">지도 불러오는 중...</div></div>
      <div class="map-credit">지도: SVG Maps · CC BY 4.0</div>`,
      [chipNv(`${c.nameKo} 위치 지도`, '위치 지도'), chipNi(`${c.nameKo} 지도`, '지도 사진')])}

    ${sectionBox(c, 'capital', icon('landmark') + ' 수도', `
      <p class="section-desc"><strong>${c.capital.name}</strong> — ${c.capital.desc}</p>`,
      [chipYt(`${c.capital.name} 여행`, `${c.capital.name} 여행 영상`), chipNi(c.capital.name, `${c.capital.name} 사진`)])}

    ${sectionBox(c, 'greeting', icon('hand') + ' 인사말', `
      <div class="greeting-line">
        <span class="greeting-word">"${c.greeting.text}"</span>
        <button class="greeting-speak" id="greetSpeakBtn" onclick="speakGreeting('${c.id}')" title="인사말 읽어주기" aria-label="인사말 소리로 읽어주기">${icon('volume-2')}</button>
      </div>
      <p class="section-desc">한글 발음: ${c.greeting.korean}</p>`,
      [chipYt(`${c.nameKo} 인사말 배우기`, '인사말 배우기 영상')])}

    ${sectionBox(c, 'food', icon('utensils') + ' 대표 음식', itemCards(c.foods),
      [chipYt(`${c.nameKo} 음식`, `${c.nameKo} 음식 영상`)].concat(c.foods.map(f => chipNi(f.name, `${f.name} 사진`))))}

    ${sectionBox(c, 'pride', icon('trophy') + ' 자랑거리', itemCards(c.prides),
      c.prides.map(p => chipYt(p.name, `${p.name} 영상`)).concat(c.prides.map(p => chipNi(p.name, `${p.name} 사진`))))}

    ${sectionBox(c, 'culture', icon('drama') + ' 문화', itemCards(c.cultures),
