.mini-map-box {
  margin-top: 8px; border-radius: 14px; overflow: hidden; background: #cfe3f0;
  border: 1px solid var(--border); min-height: 120px;
}
.mini-map-loading, .mini-map-fail {
  display: flex; align-items: center; justify-content: center; min-height: 160px;
  font-size: 13.5px; color: var(--navy); opacity: .6; padding: 16px; text-align: center;
}
.mini-map { width: 100%; height: auto; display: block; }
.mini-map path { fill: #e6dcc6; stroke: #c2b291; stroke-width: .35; }
.mini-map path.hl { fill: var(--gold); stroke: var(--gold-deep); stroke-width: .6; }
.map-credit { font-size: 12px; opacity: .6; margin-top: 4px; text-align: right; }

/* 조사 링크 칩 */
.link-chips { display: flex; gap: 7px; flex-wrap: wrap; margin-top: 10px; }
.link-chip {
  display: inline-flex; align-items: center; gap: 5px; font-size: 14px; font-weight: 700; min-height: 44px;
  color: var(--navy); background: var(--cream); border: 1.5px solid var(--border);
  border-radius: 99px; padding: 7px 13px; text-decoration: none; transition: transform .12s, border-color .15s;
