// 다음 나라 / 마지막이면 결과 보기 — 정보판의 주 버튼(.sk-btn--primary)
function nextBtnHtml() {
  return idx === LANDMARKS.length - 1
    ? `<button type="button" class="sk-btn sk-btn--primary" onclick="next()">${icon('award')} 탐험 수료식 보기</button>`
    : `<button type="button" class="sk-btn sk-btn--primary" onclick="next()">다음 나라로 ${icon('arrow-right')}</button>`;
}

/* ── TTS 문화 리딩 기능 ── */
window.speakCulture = function(landmarkId) {
  const m = LANDMARKS.find(l => l.id === landmarkId);
  if (!m) return;
  if (!SimKit.speak.supported()) {
    SimKit.toast('이 브라우저는 읽어주기 기능을 쓸 수 없어요.');
    return;
  }

  const btn = document.getElementById('speakBtn');
  if (btn) btn.classList.add('speaking');

  // 이름 뒤 이모지만 떼고 읽는다(예: "미트 파이 🥩" → "미트 파이"). 공백 기준으로 자르면 "미트"만 남음
  const plain = s => String(s).replace(/[\p{Extended_Pictographic}\u{FE0F}\u{200D}]/gu, '').trim();
  const text = `이곳은 ${m.countryName}의 ${m.name}입니다. 수도는 ${m.capital}이고, 인사말은 ${plain(m.greeting)}입니다. ${m.countryName}의 대표적인 음식은 ${plain(m.food)}이고, 대표 옷은 ${plain(m.clothes)}입니다. 대표적인 집은 ${plain(m.house)}입니다.`;

  SimKit.speak(text, { rate: 1.0, onend: () => { if (btn) btn.classList.remove('speaking'); } });
};

/* ── 퀴즈 답변 처리 ── */
window.submitAnswer = function(answer) {
  const m = LANDMARKS[idx];
  const correct = answer === m.quiz.ans;

  const quizZone = document.getElementById('quiz');
  if (!quizZone) return;

  if (correct) {
    if (!stamps.includes(m.id)) {
      stamps.push(m.id);
      saveState();
    }

    quizZone.innerHTML = `
      <div class="reveal">
        <div class="reveal-banner correct" id="revealBanner" tabindex="-1">${icon('party-popper')} 정답입니다! 여권 도장을 쾅 모았어요!</div>
        <div class="passport-stamp-zone">
          <div class="passport-stamp" id="pStamp">${icon('plane')} 탐험인증</div>
        </div>
        <div class="explain">${m.explain}</div>
        <div class="next-zone">${nextBtnHtml()}</div>
      </div>
    `;

    setTimeout(() => {
      document.getElementById('pStamp')?.classList.add('stamped');
    }, 100);

    // 도장 그리드·진행 막대 갱신
    const grid = document.querySelector('.passport-grid');
    if (grid) grid.innerHTML = passportSlotsHtml();
    const fill = document.querySelector('.progress-zone .progress-fill');
    if (fill) fill.style.width = (stamps.length / LANDMARKS.length * 100) + '%';
    const track = document.querySelector('.progress-zone .progress-track');
    if (track) track.setAttribute('aria-valuenow', String(stamps.length));
    const lbl = document.querySelector('.progress-zone .progress-label span');
    if (lbl) lbl.textContent = `모은 도장 ${stamps.length} / ${LANDMARKS.length}`;
    document.getElementById('revealBanner')?.focus({ preventScroll: true });
    SimKit.reveal(document.getElementById('revealBanner'));

  } else {
    quizZone.innerHTML = `
      <div class="reveal">
        <div class="reveal-banner wrong" id="revealBanner" tabindex="-1">${icon('circle-x')} 아쉬워요! 다른 답을 골라볼까요?</div>
        <div class="explain">나라 이름 아래의 수도·인사말과 ‘대표 문화 소개’ 카드(음식·옷·집)를 다시 읽어 보고 도전해 보세요.</div>
        <div class="next-zone">
          <button type="button" class="sk-btn" onclick="retryQuiz()">${icon('rotate-ccw')} ${SimKit.LABELS.retry}</button>
        </div>
      </div>
    `;
    document.getElementById('revealBanner')?.focus({ preventScroll: true });
    SimKit.reveal(document.getElementById('revealBanner'));
  }
};

// 오답 뒤 "다시 풀기" — renderPanel은 IIFE 안 함수라 인라인 onclick에서 바로 부를 수 없다
window.retryQuiz = function() {
  renderPanel();
  document.querySelector('#quiz .quiz-btn')?.focus({ preventScroll: true });
};

window.next = function() {
  idx++;
  if (idx >= LANDMARKS.length) {
    renderResult();
  } else {
    renderPanel();
    flyToLandmark(LANDMARKS[idx]);
  }
  focusSideHead();
};

window.goToIndex = function(i) {
  idx = i;
  renderPanel();
  flyToLandmark(LANDMARKS[idx]);
  focusSideHead();
};

function renderResult() {
  stopOrbit();
  if (map && !mapFailed) {
    map.easeTo({ zoom: 2.2, pitch: 0, duration: dur(3000) });
  }

  const vt = document.getElementById('viewerTitle');
  if (vt) vt.innerHTML = `${icon('trophy')} 세계 탐험 완료!`;

  const totalScore = stamps.length;
  const total = LANDMARKS.length;
  const complete = totalScore >= total;
  const missing = LANDMARKS.filter(lm => !stamps.includes(lm.id));

  document.getElementById('sideHead').innerHTML = `
    <div class="flag">${icon('globe')} 세계 탐험대</div>
    <h2>${icon('trophy')} 탐험 수료식</h2>
    <div class="height">${complete ? `${total}개 나라 여권 스탬프 완성!` : `여권 스탬프 ${totalScore} / ${total}개`}</div>
  `;

  document.getElementById('sideBody').innerHTML = `
    <div class="result">
      ${complete ? `
      <div class="certificate-box">
        <div class="certificate-title">${icon('award')} 세계 탐험 챔피언</div>
        <div class="certificate-stamp">🌏</div>
        <div class="certificate-text">
          위 어린이는 3D 지도를 활용하여 경복궁, 에펠탑, 피라미드 등 세계 랜드마크 ${total}곳을 성실히 탐험하고, 나라마다 다른 국기, 수도, 의상, 음식, 집의 다양성을 훌륭히 공부하였으므로 이 세계 탐험 인증서를 수여합니다.
        </div>
      </div>` : `
      <div class="certificate-box">
        <div class="certificate-title">${icon('plane')} 거의 다 왔어요!</div>
        <div class="certificate-text">
          도장을 <b>${totalScore}개</b> 모았어요. 아직 <b>${missing.length}개</b> 나라의 도장이 남았어요.<br>
          ${missing.map(lm => `${lm.emoji} ${lm.name}`).join(', ')}<br>
          아래에서 골라 퀴즈를 풀면 인증서를 받을 수 있어요!
        </div>
      </div>`}

      <div class="observe-box" style="text-align:left;">
        <h3 style="color:var(--gold-deep)">${icon('book-open')} 배움 정리</h3>
        <p style="font-size:14.5px; line-height:1.75;">
          세계 여러 나라 사람들은 각자의 환경과 역사에 따라 서로 다른 <strong>국기, 음식, 옷, 집</strong>을 가지고 살아가요.<br>
          우리와 다른 모습들은 이상하거나 틀린 것이 아니라, <strong>서로 다르고 고유한 문화적 특징</strong>이랍니다!
        </p>
      </div>

      <h4 style="text-align:left; font-size:14px; margin-bottom:8px; opacity:0.85; display:flex; align-items:center; gap:6px;">${icon('map')} 랜드마크 다시 보기</h4>
      <ul class="revisit-list">
        ${LANDMARKS.map((lm, i) => `
          <li><button type="button" class="revisit-item" onclick="goToIndex(${i})">
            ${lm.emoji} ${lm.name}${stamps.includes(lm.id) ? '' : '<span class="todo">도장 받으러 가기</span>'}
          </button></li>
        `).join('')}
      </ul>

      <button type="button" class="sk-btn sk-btn--danger sk-btn--block" onclick="resetExplore()">${icon('refresh-ccw')} ${SimKit.LABELS.reset}</button>
    </div>
  `;
}

// 처음부터: 모은 도장을 모두 지우고 첫 나라로(확인 창 필수 — 시뮬레이션 공통 규약 v2)
window.resetExplore = async function() {
  const ok = await VUI.confirm('모은 여권 도장을 모두 지우고 첫 나라부터 다시 시작할까요?', { title: SimKit.LABELS.reset, ok: '도장 지우고 다시 시작', danger: true });
  if (!ok) return;
  stamps = [];
  idx = 0;
  saveState();
  renderPanel();
  flyToLandmark(LANDMARKS[0]);
  focusSideHead();
};

window.start = function() {
  if (location.hash) history.replaceState(null, '', location.pathname + location.search);
  appMode = 'explore';
  stamps = [];
  idx = 0;
  loadState();
  renderExplore();
};

// 탐험 모드 → 처음 화면. 도장(stamps)은 저장돼 있어 다시 들어오면 이어서 진행된다.
window.exitExplore = function() {
  stopOrbit();
  orbitLoop.stop();
  mapTimers.reset();
  SimKit.speak.cancel();
  if (map) { try { map.remove(); } catch (e) {} map = null; }
  mapFailed = false;
  appMode = 'intro';
  renderIntro();
  window.scrollTo({ top: 0 });
};

const STORAGE_KEY = 'world-landmarks:v1';
// 저장 키·모양은 예전 그대로 { stamps: [랜드마크 id…] }. 모르는 id는 버린다
const stampStore = SimKit.store(STORAGE_KEY, {
  defaults: { stamps: [] },
  validate: raw => (raw && typeof raw === 'object') ? { stamps: SimKit.clean.list(raw.stamps, LANDMARKS.map(l => l.id)) } : null,
});

function saveState() {
  stampStore.save({ stamps });
}

function loadState() {
  stamps = stampStore.load().stamps;
}

/* ════════════════════════════════════════════════════════════════
   조사 보고서 모드 (docs/world-landmarks-research-mode-plan.md)
   ════════════════════════════════════════════════════════════════ */
const COUNTRIES = window.WL_COUNTRIES || [];
const CONTINENTS = [
  { id: 'all', name: '전체' },
  { id: 'asia', name: '아시아' },
  { id: 'europe', name: '유럽' },
  { id: 'africa', name: '아프리카' },
  { id: 'namerica', name: '북아메리카' },
  { id: 'samerica', name: '남아메리카' },
  { id: 'oceania', name: '오세아니아' }
];
const SECTION_KEYS = ['flag', 'location', 'capital', 'greeting', 'food', 'pride', 'culture'];
const RESEARCH_KEY = 'world-landmarks:research:v1';

let appMode = 'intro';
let continentFilter = 'all';
let researchChecks = {};

// 저장 키·모양은 예전 그대로 { checks: { 나라 id: ['flag', …] } }
const researchStore = SimKit.store(RESEARCH_KEY, {
  defaults: { checks: {} },
  validate: raw => {
    if (!raw || typeof raw !== 'object') return null;
    const checks = {};
    const src = raw.checks && typeof raw.checks === 'object' ? raw.checks : {};
    Object.keys(src).forEach(k => { if (Array.isArray(src[k])) checks[k] = SimKit.clean.list(src[k], SECTION_KEYS); });
    return { checks };
  },
});
function loadResearch() {
  researchChecks = researchStore.load().checks;
}
function saveResearch() {
  researchStore.save({ checks: researchChecks });
}
function checkedCount(cid) {
  return (researchChecks[cid] || []).filter(k => SECTION_KEYS.includes(k)).length;
}

/* ── 외부 조사 링크 ── */
function ytUrl(q) { return 'https://www.youtube.com/results?search_query=' + encodeURIComponent(q); }
function nvUrl(q) { return 'https://search.naver.com/search.naver?query=' + encodeURIComponent(q); }
function niUrl(q) { return 'https://search.naver.com/search.naver?where=image&query=' + encodeURIComponent(q); }
function chip(url, label, cls) {
  return `<a class="link-chip ${cls || ''}" href="${url}" target="_blank" rel="noopener">${label}</a>`;
}
function chipYt(q, label) { return chip(ytUrl(q), icon('play') + ' ' + (label || q), 'yt'); }
function chipNv(q, label) { return chip(nvUrl(q), icon('search') + ' ' + (label || q), ''); }
function chipNi(q, label) { return chip(niUrl(q), icon('image') + ' ' + (label || q), ''); }

/* ── 국기 이미지 (flagcdn + 이모지 폴백) ──
   code: ISO 3166-1 alpha-2 소문자 · Windows Chrome은 국기 이모지를 렌더링 못 해
   flagcdn PNG를 1순위로, 실패 시에만 이모지로 폴백 */
function flagEmoji(code) {
  return code.toUpperCase().replace(/./g, ch => String.fromCodePoint(127397 + ch.charCodeAt(0)));
}
/* 국기 이모지(🇰🇷) → ISO alpha-2 코드(kr) */
function flagEmojiToCode(emoji) {
  return [...emoji].map(ch => ch.codePointAt(0))
    .filter(cp => cp >= 127462 && cp <= 127487)
    .map(cp => String.fromCharCode(cp - 127462 + 97)).join('');
}
function flagMarkup(code, name, size) {
  const dim = size === 'lg' ? [120, 80] : size === 'sm' ? [30, 20] : [72, 48];
  const cls = size === 'lg' ? 'flag-lg' : size === 'sm' ? 'flag-sm' : '';
  return `<img class="flag-img ${cls}" src="https://flagcdn.com/w160/${code}.png"
    alt="${name} 국기" loading="lazy" width="${dim[0]}" height="${dim[1]}"
    onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'flag-fallback flag-${size || 'md'}',textContent:'${flagEmoji(code)}'}))">`;
}
function flagImg(c, large) { return flagMarkup(c.id, c.nameKo, large ? 'lg' : 'md'); }

/* ── 위치 지도: 실제 세계지도 SVG(@svg-maps/world · CC BY 4.0)를 불러와
   해당 국가 path를 하이라이트하고 중심에 마커를 찍는다 ── */
let worldMapPromise = null;
function loadWorldMap() {
  if (!worldMapPromise) {
    worldMapPromise = fetch('/apps/world-landmarks/world-map.svg')
      .then(r => { if (!r.ok) throw new Error('map ' + r.status); return r.text(); });
  }
  return worldMapPromise;
}
function injectMiniMap(c) {
  const box = document.getElementById('miniMap-' + c.id);
  if (!box) return;
  loadWorldMap().then(txt => {
    if (!document.getElementById('miniMap-' + c.id)) return; // 화면이 이미 바뀌었으면 중단
    box.innerHTML = txt;
    const svg = box.querySelector('svg');
    if (!svg) return;
    svg.classList.add('mini-map');
    svg.setAttribute('role', 'img');
    svg.setAttribute('aria-label', c.nameKo + '의 위치를 표시한 세계지도');
    const NS = 'http://www.w3.org/2000/svg';
    const path = svg.querySelector('#' + (window.CSS && CSS.escape ? CSS.escape(c.id) : c.id));
    if (path) {
      path.classList.add('hl');
      try {
        const b = path.getBBox();
        const cx = b.x + b.width / 2, cy = b.y + b.height / 2;
        const ring = document.createElementNS(NS, 'circle');
        ring.setAttribute('cx', cx); ring.setAttribute('cy', cy); ring.setAttribute('r', 8);
        ring.setAttribute('fill', 'none'); ring.setAttribute('stroke', 'var(--stamp-red)'); ring.setAttribute('stroke-width', 2);
        const anim = document.createElementNS(NS, 'animate');
        anim.setAttribute('attributeName', 'r'); anim.setAttribute('values', '6;12;6');
        anim.setAttribute('dur', '1.6s'); anim.setAttribute('repeatCount', 'indefinite');
        ring.appendChild(anim);
        const dot = document.createElementNS(NS, 'circle');
        dot.setAttribute('cx', cx); dot.setAttribute('cy', cy); dot.setAttribute('r', 3.5);
        dot.setAttribute('fill', 'var(--stamp-red)'); dot.setAttribute('stroke', '#fff'); dot.setAttribute('stroke-width', 1);
        svg.appendChild(ring); svg.appendChild(dot);
      } catch (e) {}
    }
  }).catch(() => {
    if (box) box.innerHTML = '<p class="mini-map-fail">지도를 불러오지 못했어요. 아래 검색 링크로 위치를 찾아보세요.</p>';
  });
}

/* ── 라우팅: #research / #research/{id} ── */
window.goResearch = function() { location.hash = '#research'; };

function route() {
  const h = location.hash;
  if (h.startsWith('#research')) {
    appMode = 'research';
    const cid = h.split('/')[1];
    const c = COUNTRIES.find(x => x.id === cid);
    if (c) renderResearchDetail(c); else renderResearchList();
    return;
  }
  if (appMode !== 'explore') { appMode = 'intro'; renderIntro(); }
}
window.addEventListener('hashchange', route);

window.setContinent = function(id) {
  continentFilter = id;
  renderResearchList();
};

/* ── 조사 모드: 나라 목록 ── */
