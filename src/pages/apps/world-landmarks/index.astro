};

window.start = function() {
  if (location.hash) history.replaceState(null, '', location.pathname + location.search);
  appMode = 'explore';
  stamps = [];
  idx = 0;
  loadState();
  renderExplore();
};

const STORAGE_KEY = 'world-landmarks:v1';

function saveState() {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify({ stamps }));
  } catch (e) {}
}

function loadState() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return;
    const saved = JSON.parse(raw);
    if (saved.stamps) stamps = saved.stamps;
  } catch (e) {}
}

/* ════════════════════════════════════════════════════════════════
   조사 보고서 모드 (docs/world-landmarks-research-mode-plan.md)
   ════════════════════════════════════════════════════════════════ */
const COUNTRIES = window.WL_COUNTRIES || [];
const CONTINENTS = [
  { id: 'all', name: '전체' },
  { id: 'asia', name: '아시아' },
  { id: 'europe', name: '유럽' },
  { id: 'africa', name: '아프리카' },
  { id: 'namerica', name: '북아메리카' },
  { id: 'samerica', name: '남아메리카' },
  { id: 'oceania', name: '오세아니아' }
];
const SECTION_KEYS = ['flag', 'location', 'capital', 'greeting', 'food', 'pride', 'culture'];
const RESEARCH_KEY = 'world-landmarks:research:v1';

let appMode = 'intro';
let continentFilter = 'all';
let researchChecks = {};

function loadResearch() {
  try {
    const saved = JSON.parse(localStorage.getItem(RESEARCH_KEY) || '{}');
    if (saved.checks) researchChecks = saved.checks;
  } catch (e) {}
}
function saveResearch() {
  try { localStorage.setItem(RESEARCH_KEY, JSON.stringify({ checks: researchChecks })); } catch (e) {}
}
function checkedCount(cid) {
  return (researchChecks[cid] || []).filter(k => SECTION_KEYS.includes(k)).length;
}

/* ── 외부 조사 링크 ── */
function ytUrl(q) { return 'https://www.youtube.com/results?search_query=' + encodeURIComponent(q); }
function nvUrl(q) { return 'https://search.naver.com/search.naver?query=' + encodeURIComponent(q); }
function niUrl(q) { return 'https://search.naver.com/search.naver?where=image&query=' + encodeURIComponent(q); }
function chip(url, label, cls) {
  return `<a class="link-chip ${cls || ''}" href="${url}" target="_blank" rel="noopener">${label}</a>`;
}
function chipYt(q, label) { return chip(ytUrl(q), '▶️ ' + (label || q), 'yt'); }
function chipNv(q, label) { return chip(nvUrl(q), '🟢 ' + (label || q), ''); }
function chipNi(q, label) { return chip(niUrl(q), '🖼️ ' + (label || q), ''); }

/* ── 국기 이미지 (flagcdn + 이모지 폴백) ──
   code: ISO 3166-1 alpha-2 소문자 · Windows Chrome은 국기 이모지를 렌더링 못 해
   flagcdn PNG를 1순위로, 실패 시에만 이모지로 폴백 */
function flagEmoji(code) {
  return code.toUpperCase().replace(/./g, ch => String.fromCodePoint(127397 + ch.charCodeAt(0)));
}
/* 국기 이모지(🇰🇷) → ISO alpha-2 코드(kr) */
function flagEmojiToCode(emoji) {
  return [...emoji].map(ch => ch.codePointAt(0))
    .filter(cp => cp >= 127462 && cp <= 127487)
    .map(cp => String.fromCharCode(cp - 127462 + 97)).join('');
}
function flagMarkup(code, name, size) {
  const dim = size === 'lg' ? [120, 80] : size === 'sm' ? [30, 20] : [72, 48];
  const cls = size === 'lg' ? 'flag-lg' : size === 'sm' ? 'flag-sm' : '';
  return `<img class="flag-img ${cls}" src="https://flagcdn.com/w160/${code}.png"
    alt="${name} 국기" loading="lazy" width="${dim[0]}" height="${dim[1]}"
    onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'flag-fallback flag-${size || 'md'}',textContent:'${flagEmoji(code)}'}))">`;
}
function flagImg(c, large) { return flagMarkup(c.id, c.nameKo, large ? 'lg' : 'md'); }

/* ── 위치 지도: 실제 세계지도 SVG(@svg-maps/world · CC BY 4.0)를 불러와
   해당 국가 path를 하이라이트하고 중심에 마커를 찍는다 ── */
let worldMapPromise = null;
function loadWorldMap() {
  if (!worldMapPromise) {
    worldMapPromise = fetch('/apps/world-landmarks/world-map.svg')
      .then(r => { if (!r.ok) throw new Error('map ' + r.status); return r.text(); });
  }
  return worldMapPromise;
}
function injectMiniMap(c) {
  const box = document.getElementById('miniMap-' + c.id);
  if (!box) return;
  loadWorldMap().then(txt => {
    if (!document.getElementById('miniMap-' + c.id)) return; // 화면이 이미 바뀌었으면 중단
    box.innerHTML = txt;
    const svg = box.querySelector('svg');
    if (!svg) return;
    svg.classList.add('mini-map');
    svg.setAttribute('role', 'img');
    svg.setAttribute('aria-label', c.nameKo + '의 위치를 표시한 세계지도');
    const NS = 'http://www.w3.org/2000/svg';
    const path = svg.querySelector('#' + (window.CSS && CSS.escape ? CSS.escape(c.id) : c.id));
    if (path) {
      path.classList.add('hl');
      try {
        const b = path.getBBox();
        const cx = b.x + b.width / 2, cy = b.y + b.height / 2;
        const ring = document.createElementNS(NS, 'circle');
        ring.setAttribute('cx', cx); ring.setAttribute('cy', cy); ring.setAttribute('r', 8);
        ring.setAttribute('fill', 'none'); ring.setAttribute('stroke', 'var(--stamp-red)'); ring.setAttribute('stroke-width', 2);
        const anim = document.createElementNS(NS, 'animate');
        anim.setAttribute('attributeName', 'r'); anim.setAttribute('values', '6;12;6');
        anim.setAttribute('dur', '1.6s'); anim.setAttribute('repeatCount', 'indefinite');
        ring.appendChild(anim);
        const dot = document.createElementNS(NS, 'circle');
        dot.setAttribute('cx', cx); dot.setAttribute('cy', cy); dot.setAttribute('r', 3.5);
        dot.setAttribute('fill', 'var(--stamp-red)'); dot.setAttribute('stroke', '#fff'); dot.setAttribute('stroke-width', 1);
        svg.appendChild(ring); svg.appendChild(dot);
      } catch (e) {}
    }
  }).catch(() => {
    if (box) box.innerHTML = '<p class="mini-map-fail">🗺️ 지도를 불러오지 못했어요. 아래 검색 링크로 위치를 찾아보세요.</p>';
  });
}

/* ── 라우팅: #research / #research/{id} ── */
window.goResearch = function() { location.hash = '#research'; };

function route() {
  const h = location.hash;
  if (h.startsWith('#research')) {
    appMode = 'research';
    const cid = h.split('/')[1];
    const c = COUNTRIES.find(x => x.id === cid);
    if (c) renderResearchDetail(c); else renderResearchList();
    return;
  }
  if (appMode !== 'explore') { appMode = 'intro'; renderIntro(); }
}
window.addEventListener('hashchange', route);

window.setContinent = function(id) {
  continentFilter = id;
  renderResearchList();
};

/* ── 조사 모드: 나라 목록 ── */
function renderResearchList() {
  document.body.classList.remove('exploring');
  const list = continentFilter === 'all'
    ? COUNTRIES
    : COUNTRIES.filter(c => c.continent === continentFilter);

  app.innerHTML = `
  <div class="research-wrap">
    <div class="research-top">
      <h1>📝 조사 보고서 만들기</h1>
      <button class="back-link" onclick="history.replaceState(null,'',location.pathname); appModeReset();">🏠 처음으로</button>
    </div>
    <div class="extlink-notice">🔗 조사 링크는 유튜브·네이버 등 외부 사이트로 연결돼요. 선생님·부모님과 함께 살펴보세요.</div>

    <div class="howto-card">
      <h3>📋 보고서 쓰는 순서</h3>
      <div class="howto-steps">
        <div class="howto-step"><span class="step-num">1</span><br>조사할 나라<br>고르기</div>
        <div class="howto-step"><span class="step-num">2</span><br>7가지 항목<br>살펴보기</div>
        <div class="howto-step"><span class="step-num">3</span><br>조사 링크로<br>더 알아보기</div>
        <div class="howto-step"><span class="step-num">4</span><br>내 보고서에<br>정리하기</div>
      </div>
    </div>

    <div class="continent-tabs">
      ${CONTINENTS.map(ct => {
        const n = ct.id === 'all' ? COUNTRIES.length : COUNTRIES.filter(c => c.continent === ct.id).length;
        return `<button class="continent-tab ${continentFilter === ct.id ? 'active' : ''}" onclick="setContinent('${ct.id}')">${ct.name}<span class="cnt">${n}</span></button>`;
      }).join('')}
    </div>

    <div class="country-grid">
      ${list.map(c => {
        const done = checkedCount(c.id);
        const contName = CONTINENTS.find(ct => ct.id === c.continent)?.name || '';
        return `
        <div class="country-card" onclick="location.hash='#research/${c.id}'" role="button" tabindex="0"
             onkeydown="if(event.key==='Enter')location.hash='#research/${c.id}'">
          ${flagImg(c)}
          <div class="country-name">${c.nameKo}</div>
          <div class="country-sub">${contName} · 수도 ${c.capital.name}</div>
          <div class="country-progress ${done ? '' : 'zero'}">${done ? `✅ 조사 ${done} / ${SECTION_KEYS.length}` : `조사 전 · 0 / ${SECTION_KEYS.length}`}</div>
        </div>`;
      }).join('')}
    </div>
  </div>`;
  window.scrollTo({ top: 0 });
}

window.appModeReset = function() {
  appMode = 'intro';
  renderIntro();
};

/* ── 조사 모드: 나라 상세 ── */
function sectionBox(c, key, title, inner, chips) {
  const on = (researchChecks[c.id] || []).includes(key);
  return `
  <section class="report-section ${on ? 'checked' : ''}" id="sec-${key}">
    <div class="report-section-head">
      <h3>${title}</h3>
      <button class="check-btn ${on ? 'on' : ''}" onclick="toggleCheck('${c.id}','${key}')">${on ? '✅ 조사했어요' : '⬜ 조사했어요'}</button>
    </div>
    ${inner}
    ${chips && chips.length ? `<div class="link-chips">${chips.join('')}</div>` : ''}
  </section>`;
}

function itemCards(items) {
  return `<div class="item-cards">${items.map(i => `
    <div class="item-card">
      <div class="item-title">${i.emoji} ${i.name}</div>
      <div class="item-desc">${i.desc}</div>
    </div>`).join('')}</div>`;
}

function renderResearchDetail(c) {
  document.body.classList.remove('exploring');
  const done = checkedCount(c.id);
  const contName = CONTINENTS.find(ct => ct.id === c.continent)?.name || '';
  const i = COUNTRIES.indexOf(c);
  const prev = COUNTRIES[(i - 1 + COUNTRIES.length) % COUNTRIES.length];
  const next = COUNTRIES[(i + 1) % COUNTRIES.length];
  const landmark = c.landmarkId ? LANDMARKS.findIndex(l => l.id === c.landmarkId) : -1;

  app.innerHTML = `
  <div class="research-wrap">
    <div class="research-top">
      <button class="back-link" onclick="location.hash='#research'">← 나라 목록</button>
    </div>

    <div class="country-head">
      ${flagImg(c, true)}
      <h1>${c.nameKo}</h1>
      <div class="head-sub">${contName} · 수도 ${c.capital.name}</div>
      ${landmark >= 0 ? `<button class="explore-link" onclick="exploreFromResearch(${landmark})">🛫 탐험 모드에서 3D로 보기</button>` : ''}
    </div>

    <div class="research-progress">
      <div class="progress-track"><div class="progress-fill" id="rProgressFill" style="width:${done / SECTION_KEYS.length * 100}%"></div></div>
      <div class="progress-label"><span>조사 진행</span><span id="rProgressNum">${done} / ${SECTION_KEYS.length}</span></div>
    </div>

    ${sectionBox(c, 'flag', '🏳️ 국기', `
      <div class="report-flag-row">
        ${flagImg(c, true)}
        <p class="section-desc">${c.flag.meaning}</p>
      </div>`,
      [chipNi(`${c.nameKo} 국기 의미`, '국기 의미 사진'), chipNv(`${c.nameKo} 국기`, '국기 검색')])}

    ${sectionBox(c, 'location', '📍 위치', `
      <p class="section-desc">${c.location.desc}</p>
      <div class="mini-map-box" id="miniMap-${c.id}"><div class="mini-map-loading">🗺️ 지도 불러오는 중...</div></div>
      <div class="map-credit">지도: SVG Maps · CC BY 4.0</div>`,
      [chipNv(`${c.nameKo} 위치 지도`, '위치 지도'), chipNi(`${c.nameKo} 지도`, '지도 사진')])}

    ${sectionBox(c, 'capital', '🏛️ 수도', `
      <p class="section-desc"><strong>${c.capital.name}</strong> — ${c.capital.desc}</p>`,
      [chipYt(`${c.capital.name} 여행`, `${c.capital.name} 여행 영상`), chipNi(c.capital.name, `${c.capital.name} 사진`)])}

    ${sectionBox(c, 'greeting', '👋 인사말', `
      <div class="greeting-line">
        <span class="greeting-word">"${c.greeting.text}"</span>
        <button class="greeting-speak" id="greetSpeakBtn" onclick="speakGreeting('${c.id}')" title="인사말 읽어주기">🔊</button>
      </div>
      <p class="section-desc">한글 발음: ${c.greeting.korean}</p>`,
      [chipYt(`${c.nameKo} 인사말 배우기`, '인사말 배우기 영상')])}

    ${sectionBox(c, 'food', '🍲 대표 음식', itemCards(c.foods),
      [chipYt(`${c.nameKo} 음식`, `${c.nameKo} 음식 영상`)].concat(c.foods.map(f => chipNi(f.name, `${f.name} 사진`))))}

    ${sectionBox(c, 'pride', '🏆 자랑거리', itemCards(c.prides),
      c.prides.map(p => chipYt(p.name, `${p.name} 영상`)).concat(c.prides.map(p => chipNi(p.name, `${p.name} 사진`))))}

    ${sectionBox(c, 'culture', '🎎 문화', itemCards(c.cultures),
      [chipYt(`${c.nameKo} 전통 문화`, '전통 문화 영상')].concat(c.cultures.map(cu => chipNi(cu.name, `${cu.name} 사진`))))}

    <div class="detail-nav">
      <button class="btn btn-ghost" onclick="location.hash='#research/${prev.id}'">← ${prev.nameKo}</button>
      <button class="btn btn-ghost" onclick="location.hash='#research'">목록</button>
      <button class="btn btn-ghost" onclick="location.hash='#research/${next.id}'">${next.nameKo} →</button>
    </div>
  </div>`;
  window.scrollTo({ top: 0 });
  injectMiniMap(c);
}

/* ── 조사 체크 토글 ── */
window.toggleCheck = function(cid, key) {
  const arr = researchChecks[cid] || (researchChecks[cid] = []);
  const at = arr.indexOf(key);
  if (at >= 0) arr.splice(at, 1); else arr.push(key);
  saveResearch();

  const sec = document.getElementById('sec-' + key);
  if (sec) {
    const on = arr.includes(key);
    sec.classList.toggle('checked', on);
    const btn = sec.querySelector('.check-btn');
    if (btn) { btn.classList.toggle('on', on); btn.textContent = on ? '✅ 조사했어요' : '⬜ 조사했어요'; }
  }
  const done = checkedCount(cid);
  const fill = document.getElementById('rProgressFill');
  const num = document.getElementById('rProgressNum');
  if (fill) fill.style.width = (done / SECTION_KEYS.length * 100) + '%';
  if (num) num.textContent = `${done} / ${SECTION_KEYS.length}`;
};

/* ── 인사말 TTS ── */
window.speakGreeting = function(cid) {
  const c = COUNTRIES.find(x => x.id === cid);
  if (!c) return;
  if (!('speechSynthesis' in window)) {
    alert('이 브라우저는 음성 합성(TTS) 기능을 지원하지 않습니다.');
    return;
  }
  window.speechSynthesis.cancel();
  const btn = document.getElementById('greetSpeakBtn');
  if (btn) btn.classList.add('speaking');
  const u = new SpeechSynthesisUtterance(`${c.nameKo}의 인사말은, ${c.greeting.korean}, 입니다.`);
  u.lang = 'ko-KR';
  u.onend = () => { if (btn) btn.classList.remove('speaking'); };
  window.speechSynthesis.speak(u);
};

/* ── 조사 모드 → 탐험 모드 연결 ── */
window.exploreFromResearch = function(landmarkIdx) {
  history.replaceState(null, '', location.pathname + location.search);
  appMode = 'explore';
  stamps = [];
  loadState();
  idx = landmarkIdx;
  renderExplore();
};

loadResearch();
route();

window.shareCurrentPage = function() {
  const payload = JSON.stringify({ v: 1, stamps });
  const url = location.origin + location.pathname + '#share=' + encodeURIComponent(payload);
  if (navigator.share) {
    navigator.share({ title: '세계 탐험대 — 내 여권 스탬프', url });
  } else if (navigator.clipboard) {
    navigator.clipboard.writeText(url);
    alert('공유 링크가 클립보드에 복사되었습니다.');
  }
};

})();
</script>



