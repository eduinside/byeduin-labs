}
.link-chip:hover { border-color: var(--gold); transform: translateY(-1px); }
.link-chip:active { transform: scale(.95); }
.link-chip.yt { border-color: #e8b3b3; }
.link-chip.yt:hover { border-color: #cc0000; }

/* 상세 하단 이동 */
.detail-nav { display: flex; gap: 10px; margin-top: 18px; }
.detail-nav .btn { flex: 1; font-size: 15px; padding: 13px 10px; min-width: 0; }
.btn-ghost { background: var(--paper); color: var(--navy); border: 2px solid var(--border); box-shadow: none; }

@media (max-width: 640px) {
  .country-grid { grid-template-columns: repeat(2, 1fr); }
  .howto-steps { grid-template-columns: repeat(2, 1fr); }
  .item-cards { grid-template-columns: 1fr; }
  .research-top h1 { font-size: 22px; }
}
@media (max-width: 380px) {
  .country-grid { grid-template-columns: 1fr; }
}

/* ── 태블릿·모바일 반응형: 지도 위 / 정보판 아래 ── */
@media (max-width: 900px) {
  body.exploring { overflow: auto; }
  .explore { display: flex; flex-direction: column; height: auto; min-height: 100vh; min-height: 100dvh; }
  .map-zone { position: sticky; top: 0; z-index: 40; height: 48vh; height: 48dvh; min-height: 300px; flex-shrink: 0; }
  .side { border-left: none; border-top: 3px solid var(--navy); }
  .quiz-btns { flex-direction: row; flex-wrap: wrap; }
  .quiz-btn { flex: 1; font-size: 15px; padding: 12px 4px; min-width: 100px; }
  .intro h1 { font-size: 28px; }
  .viewer-title { font-size: 16px; padding: 8px 13px; }
  .map-top { left: 10px; }
  .cam-bar { flex-wrap: wrap; justify-content: center; }
}
/* 휴대폰 가로(낮은 화면): 지도가 화면 대부분을 덮지 않게 높이 절반까지, 고정(sticky)하지 않고 함께 스크롤 */
@media (max-width: 900px) and (orientation: landscape) {
  .map-zone { position: relative; height: 50vh; height: 50dvh; min-height: 0; max-height: 50dvh; }
  .map-top { gap: 4px; }
  .viewer-title { font-size: 15px; padding: 6px 11px; }
  .hint-chip { display: none; }
  .cam-bar { bottom: 10px; flex-wrap: nowrap; }
}
