/* ── 조사 체크 토글 ── */
window.toggleCheck = function(cid, key) {
  const arr = researchChecks[cid] || (researchChecks[cid] = []);
  const at = arr.indexOf(key);
  if (at >= 0) arr.splice(at, 1); else arr.push(key);
  saveResearch();

  const sec = document.getElementById('sec-' + key);
  if (sec) {
    const on = arr.includes(key);
    sec.classList.toggle('checked', on);
    const btn = sec.querySelector('.check-btn');
    if (btn) { btn.classList.toggle('on', on); btn.setAttribute('aria-pressed', String(on)); btn.innerHTML = checkBtnHtml(on); }
  }
  const done = checkedCount(cid);
  const fill = document.getElementById('rProgressFill');
  const num = document.getElementById('rProgressNum');
  if (fill) fill.style.width = (done / SECTION_KEYS.length * 100) + '%';
  if (num) num.textContent = `${done} / ${SECTION_KEYS.length}`;
};

/* ── 인사말 TTS ── */
window.speakGreeting = function(cid) {
  const c = COUNTRIES.find(x => x.id === cid);
  if (!c) return;
  if (!SimKit.speak.supported()) {
    SimKit.toast('이 브라우저는 읽어주기 기능을 쓸 수 없어요.');
    return;
  }
  const btn = document.getElementById('greetSpeakBtn');
  if (btn) btn.classList.add('speaking');
  SimKit.speak(`${c.nameKo}의 인사말은, ${c.greeting.korean}, 입니다.`, { onend: () => { if (btn) btn.classList.remove('speaking'); } });
};

/* ── 조사 모드 → 탐험 모드 연결 ── */
window.exploreFromResearch = function(landmarkIdx) {
  history.replaceState(null, '', location.pathname + location.search);
  appMode = 'explore';
  stamps = [];
  loadState();
  idx = landmarkIdx;
  renderExplore();
};

loadResearch();
route();

// 예전 '#share=' 스탬프 링크는 받는 쪽에서 읽지 않아 제거했다. 공유 버튼은 셸 기본 동작(현재 주소 공유)을 쓴다.

})();
