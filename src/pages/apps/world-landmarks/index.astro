/* ── 런타임 변수 ── */
let idx = 0;
let stamps = [];
let map = null;
let orbiting = false;
let mapFailed = false;
const app = document.getElementById('app');
// 지도에 걸린 타이머·rAF는 한곳에 모아 탐험을 나갈 때 한 번에 정리(SimKit.timers)
const mapTimers = SimKit.timers();
let tileErrors = 0, tileOk = 0, mapNoticeShown = false;
const icon = (name, opts) => SimKit.icon(name, opts);
// 움직임 줄이기 설정이면 지도 이동 애니메이션 없이 바로 옮긴다
const dur = ms => SimKit.motion.reduced() ? 0 : ms;
// 한 바퀴 돌기: 프레임 수가 아니라 경과 시간 기준(초당 7.2°, 예전 60Hz에서 프레임당 0.12°와 같은 빠르기 — 120Hz 전자칠판에서도 같은 속도)
const ORBIT_DEG_PER_SEC = 7.2;
const orbitLoop = SimKit.loop(dt => {
  if (!orbiting || !map) { orbitLoop.stop(); return; }
  map.setBearing(map.getBearing() + ORBIT_DEG_PER_SEC * dt);
});
// 지도를 못 쓰는 까닭: 'lib'(지도 도구를 못 받음 — 인터넷·학교망 차단) / 'webgl'(기기가 3D 지도를 못 그림)
let mapFailReason = '';
function mapFailText() {
  return mapFailReason === 'lib'
    ? '3D 지도 도구를 불러오지 못했어요. 인터넷이 느리거나 학교에서 지도 사이트가 막혀 있을 수 있어요. 새로고침해 보거나, 나라 정보를 읽고 퀴즈를 풀어 도장을 모으세요!'
    : '이 기기(브라우저)는 3D 지도를 보여 줄 수 없어요. 나라 정보를 읽고 퀴즈를 풀어 도장을 모으세요!';
}

/* 여권 도장 칸(버튼) — 누르면 그 나라로 이동 */
function passportSlotsHtml() {
  return LANDMARKS.map((lm, i) => {
    const hasS = stamps.includes(lm.id);
    return `
      <button type="button" class="passport-slot ${hasS ? 'done' : ''} ${i === idx ? 'current' : ''}" onclick="goToIndex(${i})"
        title="${lm.name}" aria-label="${i + 1}. ${lm.name}${hasS ? ' (도장 받음)' : ''}"${i === idx ? ' aria-current="step"' : ''}>
        ${hasS ? icon('check', 'slot-check') : ''}
        <span class="${hasS ? 'slot-emoji-done' : 'slot-emoji-pending'}" aria-hidden="true">${lm.emoji}</span>
        <span class="passport-slot-label" aria-hidden="true">${lm.name.length > 4 ? lm.name.slice(0,4)+'…' : lm.name}</span>
      </button>`;
  }).join('');
}
function focusSideHead() {
  const h = document.querySelector('#sideHead h2');
  if (h) { h.tabIndex = -1; h.focus({ preventScroll: true }); }
}

/* 지도 사진(타일)을 계속 못 불러오면: 안내를 띄우고 퀴즈·도장은 그대로 하게 한다 */
function showMapNotice() {
  if (mapNoticeShown || mapFailed) return;
  const zone = document.querySelector('.map-zone');
  if (!zone) return;
  mapNoticeShown = true;
  document.getElementById('mapLoading')?.classList.add('hide');
  const box = document.createElement('div');
  box.className = 'map-notice';
  box.id = 'mapNotice';
  box.setAttribute('role', 'status');
  box.innerHTML = `
    <div class="map-notice-card">
      <div class="map-notice-icon" aria-hidden="true">${icon('satellite')}</div>
      <p><b>지도 사진을 불러오지 못하고 있어요.</b><br>인터넷이 느리거나 학교에서 막혀 있을 수 있어요.<br>문화 카드를 읽고 퀴즈는 그대로 풀 수 있어요!</p>
      <div class="map-notice-btns">
        <button type="button" class="btn btn-primary" data-act="retry">${icon('refresh-cw')} 다시 불러오기</button>
        <button type="button" class="btn btn-ghost-dark" data-act="earth">${icon('globe')} 구글 어스로 보기</button>
        <button type="button" class="btn btn-ghost-dark" data-act="close">닫기</button>
      </div>
    </div>`;
  box.addEventListener('click', e => {
    const b = e.target.closest('[data-act]');
    if (!b) return;
    const act = b.getAttribute('data-act');
    if (act === 'earth') { window.open(getGoogleEarthUrl(curLandmark() || LANDMARKS[0]), '_blank', 'noopener'); return; }
    box.remove();
    if (act === 'retry') {
      mapNoticeShown = false;
      document.getElementById('mapLoading')?.classList.remove('hide');
      buildMap();
    }
  });
  zone.appendChild(box);
}

function shuffleArr(arr) {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
  return a;
}

function getGoogleEarthUrl(m) {
  return `https://earth.google.com/web/@${m.lat},${m.lng},1500a,30000d,35y,0h,60t,0r`;
}

/* ── 3D 지도 셋업 ── */
// reason: 'lib'(지도 도구를 못 받음) | 'webgl'(기기가 3D 지도를 못 그림)
function mapFallback(reason) {
  mapFailed = true;
  mapFailReason = reason;
  const zone = document.querySelector('.map-zone');
  if (!zone) return;
  const m = LANDMARKS[idx] || LANDMARKS[0];
  zone.innerHTML = fallbackViewHtml(m);
}
function fallbackViewHtml(m) {
  return `
    <div class="card-fallback-view" role="status">
      <div class="fallback-landmark-emoji" aria-hidden="true">${m.emoji}</div>
      <div class="fallback-landmark-name">${m.name} (${m.countryName})</div>
      <div class="fallback-landmark-desc">${mapFailText()}</div>
      <a class="earth-link" href="${getGoogleEarthUrl(m)}" target="_blank" rel="noopener" style="margin-top:20px; color:var(--gold); text-decoration:underline; display:inline-flex; align-items:center; gap:6px;">${icon('globe')} 구글 어스에서 열기 ${icon('external-link')}</a>
    </div>
  `;
}

function buildMap() {
  mapTimers.reset();
  orbiting = false;
  tileErrors = 0; tileOk = 0;
  if (map) { try { map.remove(); } catch (e) {} map = null; }
  if (typeof maplibregl === 'undefined') {
    mapFallback('lib');
    return;
  }
  try {
    map = new maplibregl.Map({
      container: 'map',
      center: [LANDMARKS[idx].lng, LANDMARKS[idx].lat],
      zoom: 3, pitch: 0, bearing: 0,
      attributionControl: { compact: true },
      maxPitch: 80,
      style: {
        version: 8,
        sources: {
          sat: {
            type: 'raster', tileSize: 256, maxzoom: 18,
            attribution: '위성영상 © Esri · 지형 © Mapzen/AWS',
            tiles: ['https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}']
          },
          dem: {
            type: 'raster-dem', tileSize: 256, maxzoom: 13, encoding: 'terrarium',
            tiles: ['https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png']
          },
          demShade: {
            type: 'raster-dem', tileSize: 256, maxzoom: 13, encoding: 'terrarium',
            tiles: ['https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png']
          }
        },
        layers: [
          { id: 'sat', type: 'raster', source: 'sat' },
          { id: 'shade', type: 'hillshade', source: 'demShade',
            paint: { 'hillshade-exaggeration': 0.35, 'hillshade-shadow-color': '#101721' } }
        ]
      }
    });

    // 확대·축소 버튼은 오른쪽 위(아래 카메라 버튼 줄과 겹치지 않게)
    map.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), 'top-right');

    let mapLoaded = false;
    const hideLoading = () => {
      if (mapLoaded) return;
      mapLoaded = true;
      document.getElementById('mapLoading')?.classList.add('hide');
      // 로드가 늦어도 지금 보고 있는 곳 기준(결과 화면이면 세계 전체)
      const m = curLandmark();
      if (m) flyToLandmark(m);
      else if (map) map.easeTo({ zoom: 2.2, pitch: 0, duration: dur(1500) });
    };

    map.on('load', () => {
      map.setTerrain({ source: 'dem', exaggeration: 1.4 });
      try {
        map.setSky({ 'sky-color': '#79b3e6', 'horizon-color': '#fdebd0', 'fog-color': '#e8ddca', 'sky-horizon-blend': .6 });
      } catch (e) {}
      map.once('idle', hideLoading);
      mapTimers.timeout(hideLoading, 2500);
      // 한참 지나도 사진 타일이 하나도 안 왔으면 안내
      mapTimers.timeout(() => { if (tileOk === 0) showMapNotice(); }, 15000);
    });

    map.on('sourcedata', e => { if (e && e.tile && e.tile.state === 'loaded') tileOk++; });
    map.on('error', e => {
      console.warn('map tile error', e?.error?.message || e);
      tileErrors++;
      if (tileErrors >= 6 && tileOk === 0) showMapNotice();
    });
    ['mousedown', 'touchstart', 'wheel'].forEach(ev => map.on(ev, stopOrbit));
  } catch (err) {
    console.error('지도 초기화 실패:', err);
    mapFallback('webgl');
  }
}

function flyToLandmark(m) {
  if (mapFailed || !map) {
    const zone = document.querySelector('.map-zone');
    if (zone) zone.innerHTML = fallbackViewHtml(m);
    return;
  }
  stopOrbit();
  map.flyTo({ center: [m.lng, m.lat], zoom: m.zoom, pitch: 65, bearing: 20, duration: dur(4500), essential: true });
}

/* ── 카메라 컨트롤 (window 노출) ── */
// 결과 화면에서는 idx가 LANDMARKS.length라 현재 랜드마크가 없다 → 세계 전체 보기 기준으로 동작
function curLandmark() { return LANDMARKS[idx] || null; }
window.camReturn = function() {
  if (mapFailed || !map) return;
  stopOrbit();
  const m = curLandmark();
  if (m) flyToLandmark(m);
  else map.easeTo({ zoom: 2.2, pitch: 0, bearing: 0, duration: dur(1500) });
};
window.camTop = function() {
  if (mapFailed || !map) return;
  stopOrbit();
  const m = curLandmark();
  map.easeTo({ pitch: 0, bearing: 0, zoom: m ? m.zoom + 0.4 : 2.2, duration: dur(1200) });
};
window.camTilt = function() {
  if (mapFailed || !map) return;
  stopOrbit();
  const m = curLandmark();
  map.easeTo({ pitch: 65, zoom: m ? m.zoom : map.getZoom(), duration: dur(1200) });
};
window.toggleOrbit = function() {
  if (mapFailed || !map) return;
  orbiting = !orbiting;
  document.getElementById('orbitBtn')?.classList.toggle('active', orbiting);
  document.getElementById('orbitBtn')?.setAttribute('aria-pressed', String(orbiting));
  if (orbiting) {
    if (map.getPitch() < 30) map.easeTo({ pitch: 65, duration: dur(800) });
    orbitLoop.start();
  } else {
    orbitLoop.stop();
  }
};

function stopOrbit() {
  orbitLoop.stop();
  if (!orbiting) return;
  orbiting = false;
  document.getElementById('orbitBtn')?.classList.remove('active');
  document.getElementById('orbitBtn')?.setAttribute('aria-pressed', 'false');
}

/* ── 화면 렌더링 ── */
