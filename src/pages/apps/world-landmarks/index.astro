/* ── 런타임 변수 ── */
let idx = 0;
let stamps = [];
let map = null;
let orbiting = false;
let mapFailed = false;
const app = document.getElementById('app');

function getGoogleEarthUrl(m) {
  return `https://earth.google.com/web/@${m.lat},${m.lng},1500a,30000d,35y,0h,60t,0r`;
}

/* ── 3D 지도 셋업 ── */
function mapFallback(msg) {
  mapFailed = true;
  const zone = document.querySelector('.map-zone');
  if (!zone) return;
  const m = LANDMARKS[idx];
  zone.innerHTML = `
    <div class="card-fallback-view">
      <div class="fallback-landmark-emoji">${m.emoji}</div>
      <div class="fallback-landmark-name">${m.name} (${m.countryName})</div>
      <div class="fallback-landmark-desc">🛰️ 3D 지도를 지원하지 않는 기기입니다. 대신 문화 정보를 바탕으로 탐험해봐요!</div>
      <a class="earth-link" href="${getGoogleEarthUrl(m)}" target="_blank" rel="noopener" style="margin-top:20px; color:var(--gold); text-decoration:underline;">🌍 구글 어스 앱으로 열기 ↗</a>
    </div>
  `;
}

function buildMap() {
  if (typeof maplibregl === 'undefined') {
    mapFallback('지도 라이브러리 로드 실패');
    return;
  }
  try {
    map = new maplibregl.Map({
      container: 'map',
      center: [LANDMARKS[idx].lng, LANDMARKS[idx].lat],
      zoom: 3, pitch: 0, bearing: 0,
      attributionControl: { compact: true },
      maxPitch: 80,
      style: {
        version: 8,
        sources: {
          sat: {
            type: 'raster', tileSize: 256, maxzoom: 18,
            attribution: '위성영상 © Esri · 지형 © Mapzen/AWS',
            tiles: ['https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}']
          },
          dem: {
            type: 'raster-dem', tileSize: 256, maxzoom: 13, encoding: 'terrarium',
            tiles: ['https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png']
          },
          demShade: {
            type: 'raster-dem', tileSize: 256, maxzoom: 13, encoding: 'terrarium',
            tiles: ['https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png']
          }
        },
        layers: [
          { id: 'sat', type: 'raster', source: 'sat' },
          { id: 'shade', type: 'hillshade', source: 'demShade',
            paint: { 'hillshade-exaggeration': 0.35, 'hillshade-shadow-color': '#101721' } }
        ]
      }
    });

    map.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), 'bottom-left');

    let mapLoaded = false;
    const hideLoading = () => {
      if (mapLoaded) return;
      mapLoaded = true;
      document.getElementById('mapLoading')?.classList.add('hide');
      flyToLandmark(LANDMARKS[idx]);
    };

    map.on('load', () => {
      map.setTerrain({ source: 'dem', exaggeration: 1.4 });
      try {
        map.setSky({ 'sky-color': '#79b3e6', 'horizon-color': '#fdebd0', 'fog-color': '#e8ddca', 'sky-horizon-blend': .6 });
      } catch (e) {}
      map.once('idle', hideLoading);
      setTimeout(hideLoading, 2500);
    });

    map.on('error', e => console.warn('map tile error', e?.error?.message || e));
    ['mousedown', 'touchstart', 'wheel'].forEach(ev => map.on(ev, stopOrbit));
  } catch (err) {
    console.error('지도 초기화 실패:', err);
    mapFallback('WebGL 미지원 가능성');
  }
}

function flyToLandmark(m) {
  if (mapFailed || !map) {
    const zone = document.querySelector('.map-zone');
    if (zone) {
      zone.innerHTML = `
        <div class="card-fallback-view">
          <div class="fallback-landmark-emoji">${m.emoji}</div>
          <div class="fallback-landmark-name">${m.name} (${m.countryName})</div>
          <div class="fallback-landmark-desc">지도가 지원되지 않는 기기입니다. 이 랜드마크의 퀴즈를 풀어 도장을 모으세요!</div>
          <a class="earth-link" href="${getGoogleEarthUrl(m)}" target="_blank" rel="noopener" style="margin-top:20px; color:var(--gold); text-decoration:underline;">🌍 구글 어스 앱으로 열기 ↗</a>
        </div>
      `;
    }
    return;
  }
  stopOrbit();
  map.flyTo({ center: [m.lng, m.lat], zoom: m.zoom, pitch: 65, bearing: 20, duration: 4500, essential: true });
}

/* ── 카메라 컨트롤 (window 노출) ── */
window.camReturn = function() {
  if (mapFailed || !map) return;
  stopOrbit();
  flyToLandmark(LANDMARKS[idx]);
};
window.camTop = function() {
  if (mapFailed || !map) return;
  stopOrbit();
  map.easeTo({ pitch: 0, bearing: 0, zoom: LANDMARKS[idx].zoom + 0.4, duration: 1200 });
};
window.camTilt = function() {
  if (mapFailed || !map) return;
  stopOrbit();
  map.easeTo({ pitch: 65, zoom: LANDMARKS[idx].zoom, duration: 1200 });
};
window.toggleOrbit = function() {
  if (mapFailed || !map) return;
  orbiting = !orbiting;
  document.getElementById('orbitBtn')?.classList.toggle('active', orbiting);
  if (orbiting) {
    if (map.getPitch() < 30) map.easeTo({ pitch: 65, duration: 800 });
    orbitFrame();
  }
};

function orbitFrame() {
  if (!orbiting) return;
  map.setBearing(map.getBearing() + 0.12);
  requestAnimationFrame(orbitFrame);
}
function stopOrbit() {
  if (!orbiting) return;
  orbiting = false;
  document.getElementById('orbitBtn')?.classList.remove('active');
}

