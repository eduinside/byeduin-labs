/* ── TTS 문화 리딩 기능 ── */
window.speakCulture = function(landmarkId) {
  const m = LANDMARKS.find(l => l.id === landmarkId);
  if (!m) return;
  if (!('speechSynthesis' in window)) {
    alert('이 브라우저는 음성 합성(TTS) 기능을 지원하지 않습니다.');
    return;
  }
  window.speechSynthesis.cancel();

  const btn = document.getElementById('speakBtn');
  if (btn) btn.classList.add('speaking');

  const text = `이곳은 ${m.countryName}의 ${m.name}입니다. 수도는 ${m.capital}이고, 인사말은 ${m.greeting}입니다. ${m.countryName}의 대표적인 음식은 ${m.food.split(' ')[0]}이고, 전통 옷은 ${m.clothes.split(' ')[0]}입니다. 대표적인 집은 ${m.house.split(' ')[0]}입니다.`;

  const utterance = new SpeechSynthesisUtterance(text);
  utterance.lang = 'ko-KR';
  utterance.rate = 1.0;
  utterance.onend = () => { if (btn) btn.classList.remove('speaking'); };
  window.speechSynthesis.speak(utterance);
};

/* ── 퀴즈 답변 처리 ── */
window.submitAnswer = function(answer) {
  const m = LANDMARKS[idx];
  const correct = answer === m.quiz.ans;

  const quizZone = document.getElementById('quiz');
  if (!quizZone) return;

  if (correct) {
    if (!stamps.includes(m.id)) {
      stamps.push(m.id);
      saveState();
    }

    quizZone.innerHTML = `
      <div class="reveal">
        <div class="reveal-banner correct">🎉 정답입니다! 여권 도장을 쾅 모았어요!</div>
        <div class="passport-stamp-zone">
          <div class="passport-stamp" id="pStamp">✈️ 탐험인증</div>
        </div>
        <div class="explain">${m.explain}</div>
        <div class="next-zone">
          <button class="btn btn-primary" onclick="next()">
            ${idx === LANDMARKS.length - 1 ? '탐험 수료식 가기 🏁' : '다음 나라로! ✈️'}
          </button>
        </div>
      </div>
    `;

    setTimeout(() => {
      document.getElementById('pStamp')?.classList.add('stamped');
    }, 100);

    // 스탬프 그리드 갱신
    const grid = document.querySelector('.passport-grid');
    if (grid) {
      grid.innerHTML = LANDMARKS.map((lm, i) => {
        const hasS = stamps.includes(lm.id);
        return `
          <div class="passport-slot ${hasS ? 'done' : ''}" onclick="goToIndex(${i})" title="${lm.name}">
            ${hasS
              ? `<span class="slot-emoji-done">${lm.emoji}</span>`
              : `<span class="slot-emoji-pending">${lm.emoji}</span>`
            }
            <span class="passport-slot-label">${lm.name.length > 4 ? lm.name.slice(0,4)+'…' : lm.name}</span>
          </div>
        `;
      }).join('');
    }

  } else {
    quizZone.innerHTML = `
      <div class="reveal">
        <div class="reveal-banner wrong">🤔 아쉬워요! 다른 답을 골라볼까요?</div>
