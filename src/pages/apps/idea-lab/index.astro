---
import AppLayout from '../../../layouts/AppLayout.astro';
---
<AppLayout 
  title="발명 아이디어 공작소 — eduin VIVES"
  description="합치기·나누기·크기 바꾸기·재료 바꾸기 4가지 발명 마법으로 아이디어를 떠올리고, AI 코치의 질문으로 다듬어 이름 짓고 그림까지 완성하는 초등 저학년 창의 발명 학습 앱."
  image="https://eduin.info/og-images/idea-lab.png"
  bodyShell="immersive"
>
  <Fragment slot="head">
    <script is:inline src="/common/sim-kit.js"></script>
    <style is:global="">
    :root {
      --il-accent: #f59e0b;
      --il-accent-h: #d97706;
      --il-accent-fg: #1c1207;
      --il-warm-bg: rgba(245, 158, 11, 0.1);
      --il-warm-border: rgba(245, 158, 11, 0.35);
    }

    [hidden] { display: none !important; }

    .screen { display: none; }
    .screen.active { display: block; animation: ilFadeIn .25s ease; }
    @keyframes ilFadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

    /* ── immersive 전체화면 셸 (chance-lab 패턴) ── */
    @keyframes ilFadeUp { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
    @keyframes ilFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
    .il-intro-screen {
      flex-direction: column; align-items: center; justify-content: center;
      min-height: 100vh; padding: 24px; text-align: center; animation: ilFadeUp 0.6s ease;
      background:
        radial-gradient(circle at 20% 30%, rgba(245,158,11,0.10) 0, transparent 40%),
        radial-gradient(circle at 80% 70%, rgba(245,158,11,0.06) 0, transparent 35%),
        var(--bg);
    }
    .il-intro-screen.active { display: flex; }
    .intro-tag {
      display: inline-block; background: var(--il-accent);
      color: #fff; font-size: 14px; font-weight: 700;
      padding: 5px 14px; border-radius: 99px;
      margin-bottom: 18px; letter-spacing: 0.05em;
    }
    .intro-emoji { font-size: 80px; line-height: 1; margin-bottom: 12px; animation: ilFloat 2.4s ease-in-out infinite; }
    .il-intro-screen h1 { font-size: 32px; font-weight: 800; margin-bottom: 6px; }
    .intro-sub { font-size: 15px; color: var(--fg-muted); line-height: 1.7; margin-bottom: 20px; }
    .intro-card {
      background: var(--card-bg); border: 2px dashed var(--il-accent); border-radius: 16px;
      padding: 20px 24px; max-width: 440px; width: 100%; margin-bottom: 24px;
    }
    .intro-card h3 { font-size: 17px; font-weight: 800; margin-bottom: 8px; }
    .intro-card p { font-size: 14px; line-height: 1.7; color: var(--fg-muted); }
    .il-intro-start { max-width: 320px; }

    .il-work {
      display: none;
      grid-template-columns: 1fr 400px;
      width: 100%; height: 100vh;
    }
    body.il-in-work .il-work { display: grid; }
    .il-stage {
      position: relative; display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 16px;
      padding: 48px 32px; min-width: 0; overflow: hidden;
      background:
        radial-gradient(circle at 30% 25%, rgba(245,158,11,0.08) 0, transparent 45%),
        radial-gradient(circle at 75% 75%, rgba(245,158,11,0.05) 0, transparent 40%),
        var(--bg);
    }
    .il-stage-emoji { font-size: clamp(72px, 16vw, 140px); line-height: 1.15; animation: ilFloat 3s ease-in-out infinite; text-align: center; }
    .il-stage-title { font-size: clamp(18px, 2.4vw, 26px); font-weight: 800; text-align: center; word-break: keep-all; }
    .il-stage-chips { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
    .il-stage-chips .il-magic-chip { background: var(--card-bg); }
    .il-stage-art { width: min(60%, 380px); border-radius: 1rem; overflow: hidden; box-shadow: 0 12px 40px rgba(0,0,0,0.18); }
    .il-stage-art img { display: block; width: 100%; height: auto; }
    .il-side {
      background: var(--card-bg); border-left: 2px solid var(--border);
      overflow-y: auto; display: flex; flex-direction: column;
      box-shadow: -4px 0 24px rgba(0,0,0,0.06);
    }
    .il-side-head {
      background: linear-gradient(135deg, var(--il-accent) 0%, var(--il-accent-h) 100%);
      color: #fff; padding: 16px 20px 14px; flex-shrink: 0;
    }
    .il-side-head h2 { font-size: 17px; font-weight: 800; margin: 0; }
    .il-side-sub { font-size: 14px; opacity: 0.85; margin-top: 2px; }
    .il-side-body { padding: 16px; flex: 1; }
    @media (max-width: 800px) {
      .il-work { grid-template-columns: 1fr; grid-template-rows: auto 1fr; height: auto; min-height: 100vh; }
      .il-stage { position: sticky; top: 0; z-index: 40; min-height: 220px; height: 34vh; padding: 48px 16px 16px; }
      .il-stage-emoji { font-size: 64px; }
      .il-side { border-left: none; border-top: 2px solid var(--border); }
    }

    .il-actions { display: flex; align-items: center; }
    .il-count-badge {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 16px; height: 16px; padding: 0 4px; border-radius: 999px;
      background: var(--il-accent); color: #fff; font-size: 10px; font-weight: 800; margin-left: 4px;
    }

    /* ── 진행 표시 ── */
    .il-progress { display: flex; gap: 6px; justify-content: center; margin-bottom: 18px; }
    .il-dot { width: 8px; height: 8px; border-radius: 999px; background: var(--border); transition: background .2s, transform .2s; }
    .il-dot.done { background: var(--il-accent); }
    .il-dot.now { background: var(--il-accent); transform: scale(1.4); }

    .il-step-label { text-align: center; font-size: 14px; color: var(--fg-muted); font-weight: 700; margin-bottom: 6px; }

    /* ── 버튼 ── */
    .il-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      background: var(--il-accent); color: var(--il-accent-fg); border: none; border-radius: .9rem;
      padding: .85rem 1.6rem; font-size: 1rem; font-weight: 800; cursor: pointer;
      min-height: 48px; font-family: inherit; transition: background .15s, transform .1s;
      width: 100%;
    }
    .il-btn:hover { background: var(--il-accent-h); }
    .il-btn:active { transform: scale(.98); }
    .il-btn:disabled { opacity: .45; cursor: not-allowed; transform: none; }
    .il-btn-ghost {
      background: var(--card-bg); color: var(--fg); border: 1px solid var(--border);
    }
    .il-btn-ghost:hover { border-color: var(--il-accent); color: var(--il-accent-h); }
    .il-btn-row { display: flex; gap: 10px; margin-top: 18px; }
    .il-btn-row .il-btn { width: auto; flex: 1; }

    .il-tts-btn {
      display: inline-flex; align-items: center; justify-content: center;
      width: 44px; height: 44px; min-height: 44px; border-radius: 999px;
      background: var(--card-bg); border: 1px solid var(--border); color: var(--fg-muted);
      cursor: pointer; font-size: 16px; flex-shrink: 0;
    }
    .il-tts-btn:hover { border-color: var(--il-accent); color: var(--il-accent-h); }

    /* ── 카드 공통 ── */
    .il-card {
      background: var(--card-bg); border: 1px solid var(--border); border-radius: 1.1rem;
      padding: 20px; margin-bottom: 16px;
    }
    .il-headline { font-size: 20px; font-weight: 800; margin: 0 0 6px; line-height: 1.35; }
    .il-sub { font-size: 14px; color: var(--fg-muted); margin: 0 0 18px; line-height: 1.6; }

    /* ── 인트로 ── */
    .il-intro-hero { text-align: center; padding: 20px 10px 8px; }
    .il-intro-emoji { font-size: 56px; margin-bottom: 10px; }
    .il-magic-legend { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin: 18px 0; }
    .il-magic-chip {
      display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-radius: .8rem;
      background: var(--bg-sec); border: 1px solid var(--border); font-size: 14px; font-weight: 700;
    }
    .il-magic-chip .em { font-size: 20px; }

    /* ── 탐험(사례) 카드 ── */
    .il-explore-card { text-align: center; }
    .il-explore-emoji { font-size: 64px; margin-bottom: 6px; }
    .il-explore-title { font-size: 19px; font-weight: 800; margin-bottom: 4px; }
    .il-explore-q { font-size: 14px; color: var(--fg-muted); margin-bottom: 16px; }
    .il-magic-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .il-magic-btn {
      display: flex; flex-direction: column; align-items: center; gap: 4px;
      padding: 14px 8px; border-radius: .9rem; border: 2px solid var(--border);
      background: var(--bg-sec); cursor: pointer; font-weight: 700; font-size: 15px;
      min-height: 64px; font-family: inherit; color: var(--fg); transition: border-color .15s, transform .1s;
    }
    .il-magic-btn .em { font-size: 24px; }
    .il-magic-btn:hover { border-color: var(--il-accent); }
    .il-magic-btn:active { transform: scale(.97); }
    .il-magic-btn.selected { border-color: var(--il-accent); background: var(--il-warm-bg); }
    .il-magic-btn.correct { border-color: var(--success); background: rgba(23,201,100,.12); }
    .il-magic-btn.wrong { border-color: var(--danger); background: rgba(243,18,96,.1); }
    .il-magic-btn:disabled { cursor: default; }
    .il-feedback { margin-top: 14px; font-size: 14px; font-weight: 700; min-height: 20px; }
    .il-feedback.ok { color: var(--success); }
    .il-feedback.no { color: var(--danger); }

    /* ── 물건 팔레트 ── */
    .il-section-title { font-size: 15px; font-weight: 800; margin: 22px 0 10px; display: flex; align-items: center; gap: 6px; }
    .il-item-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .il-item-btn {
      display: flex; flex-direction: column; align-items: center; gap: 4px;
      padding: 10px 4px; border-radius: .8rem; border: 2px solid var(--border);
      background: var(--bg-sec); cursor: pointer; min-height: 64px; color: var(--fg);
      font-size: 14px; font-weight: 700; font-family: inherit; word-break: keep-all; transition: border-color .15s, transform .1s;
    }
    .il-item-btn .em { font-size: 24px; }
    .il-item-btn:hover { border-color: var(--il-accent); }
    .il-item-btn:active { transform: scale(.96); }
    .il-item-btn.selected { border-color: var(--il-accent); background: var(--il-warm-bg); }
    @media (max-width: 480px) { .il-item-grid { grid-template-columns: repeat(4, 1fr); } }

    .il-custom-row { display: flex; gap: 8px; margin-top: 10px; }
    .il-custom-row .hero-input { flex: 1; }

    /* ── 코치 질문 ── */
    .il-question-row { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 16px; }
    .il-question-text { font-size: 18px; font-weight: 800; line-height: 1.4; flex: 1; }
    .il-choice-list { display: flex; flex-direction: column; gap: 8px; }
    .il-choice-btn {
      display: flex; align-items: center; gap: 10px; text-align: left;
      padding: 12px 14px; border-radius: .8rem; border: 2px solid var(--border);
      background: var(--bg-sec); cursor: pointer; font-size: 15px; font-weight: 700;
      min-height: 48px; color: var(--fg); transition: border-color .15s, transform .1s;
    }
    .il-choice-btn:hover { border-color: var(--il-accent); }
    .il-choice-btn:active { transform: scale(.98); }
    .il-choice-btn.picked { border-color: var(--il-accent); background: var(--il-warm-bg); }
    .il-offline-note {
      font-size: 14px; color: var(--fg-muted); background: var(--bg-sec); border-radius: .6rem;
      padding: 6px 10px; margin-bottom: 12px; display: inline-block;
    }

    /* ── 로딩 ── */
    .il-loading { text-align: center; padding: 40px 10px; }
    .il-spinner {
      width: 46px; height: 46px; border-radius: 999px; margin: 0 auto 16px;
      border: 5px solid var(--border); border-top-color: var(--il-accent);
      animation: ilSpin 0.9s linear infinite;
    }
    @keyframes ilSpin { to { transform: rotate(360deg); } }
    .il-loading-text { font-size: 15px; font-weight: 700; color: var(--fg); }
    .il-loading-sub { font-size: 14px; color: var(--fg-muted); margin-top: 6px; }

    /* ── 완성 카드 ── */
    .il-final-card {
      background: linear-gradient(160deg, var(--il-warm-bg), var(--card-bg) 55%);
      border: 1px solid var(--il-warm-border); border-radius: 1.3rem; padding: 26px 20px; text-align: center;
    }
    .il-final-badges { display: flex; gap: 6px; justify-content: center; flex-wrap: wrap; margin-bottom: 10px; }
    .il-final-badge {
      font-size: 13px; font-weight: 800; padding: 4px 10px; border-radius: 999px;
      background: var(--il-accent); color: var(--il-accent-fg);
    }
    .il-final-name { font-size: 24px; font-weight: 900; margin: 6px 0 12px; }
    .il-final-art { width: 100%; max-width: 320px; margin: 0 auto 14px; border-radius: 1rem; overflow: hidden; background: var(--bg-sec); }
    .il-final-art img { display: block; width: 100%; height: auto; }
    .il-emoji-art {
      display: flex; align-items: center; justify-content: center; gap: 12px;
      font-size: 64px; padding: 30px 10px;
    }
    .il-final-summary { font-size: 15px; line-height: 1.7; color: var(--fg); text-align: left; background: var(--bg-sec); border-radius: .8rem; padding: 14px 16px; }
    .il-final-details {
      margin-top: 16px; padding: 16px; border: 1px solid var(--border); border-radius: 0.8rem;
      background: var(--bg-sec); font-size: 14px; text-align: left; display: flex; flex-direction: column; gap: 8px;
    }
    .il-detail-row { display: flex; justify-content: space-between; gap: 10px; line-height: 1.4; }
    .il-detail-row strong { color: var(--fg-muted); flex-shrink: 0; }
    .il-detail-row span { color: var(--fg); text-align: right; word-break: keep-all; font-weight: 700; }

    /* ── 작품집 ── */
    .il-collection-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    @media (max-width: 480px) { .il-collection-grid { grid-template-columns: 1fr; } }
    .il-work-card { cursor: pointer; text-align: center; padding: 16px 10px; width: 100%; font-family: inherit; color: var(--fg); display: block; }
    .il-work-card:hover { border-color: var(--il-accent); }
    .il-work-emoji { font-size: 34px; margin-bottom: 6px; }
    .il-work-name { font-size: 14px; font-weight: 800; margin-bottom: 2px; }
    .il-work-date { font-size: 13px; color: var(--fg-muted); }
    .il-empty { text-align: center; padding: 40px 10px; color: var(--fg-muted); font-size: 14px; }

    .il-privacy-note { font-size: 14px; color: var(--fg-muted); text-align: center; margin: 10px 0 0; }
    .il-attempt-note { font-size: 14px; color: var(--fg-muted); text-align: center; margin-top: 8px; }
    .il-answers { text-align: left; font-size: 14px; color: var(--il-accent-h); font-weight: 600; }
  </style>
  <script type="application/ld+json" is:inline="">{"@context":"https://schema.org","@type":"WebApplication","name":"발명 아이디어 공작소","description":"합치기·나누기·크기 바꾸기·재료 바꾸기 4가지 발명 마법으로 아이디어를 떠올리고, AI 코치의 질문으로 다듬어 이름 짓고 그림까지 완성하는 초등 저학년 창의 발명 학습 앱.","url":"https://eduin.info/apps/idea-lab/","applicationCategory":"EducationApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"KRW"},"isPartOf":{"@type":"WebSite","name":"eduin VIVES","url":"https://eduin.info"}}</script>
  </Fragment>


  <!-- 플로팅 크롬(홈·테마·공유)은 app-shell.js가 주입합니다 -->
  <div class="app-actions il-actions">
    <button class="overlay-btn" onclick="showScreen('collection')" title="내 작품집">
      📂 <span>내 작품집</span><span id="ilCollectionCount" class="il-count-badge" hidden="">0</span>
    </button>
  </div>

  <!-- 0. 인트로 (전체화면) -->
  <section class="screen active il-intro-screen" id="scr-intro">
    <div class="intro-tag">통합교과 1~2학년 · 발명 · AI</div>
    <div class="intro-emoji" aria-hidden="true">🧙‍♀️</div>
    <h1>발명 아이디어 공작소</h1>
    <p class="intro-sub">4가지 발명 마법 · AI 코치와 발명품 만들기</p>

    <div class="intro-card">
      <h3>발명가는 마법사예요!</h3>
      <p>4가지 발명 마법을 배우고, AI 코치와 함께<br>나만의 발명품을 만들어 봐요.</p>
      <div class="il-magic-legend">
        <div class="il-magic-chip"><span class="em">🧲</span>합치기</div>
        <div class="il-magic-chip"><span class="em">✂️</span>나누기</div>
        <div class="il-magic-chip"><span class="em">🔍</span>크기 바꾸기</div>
        <div class="il-magic-chip"><span class="em">🧱</span>재료 바꾸기</div>
      </div>
    </div>

    <button class="il-btn il-intro-start" onclick="startExplore()">발명 마법 배우러 가기 →</button>
    <p class="il-privacy-note">내 이름·친구 이름은 쓰지 않아요 🙂</p>
  </section>

  <!-- 작업 화면: 좌측 무대 + 우측 사이드바 -->
  <div class="il-work" id="ilWork">
    <div class="il-stage" id="ilStage">
      <div class="il-stage-emoji" id="stageEmoji" aria-hidden="true">💡</div>
      <div class="il-stage-title" id="stageTitle">발명 공작소</div>
      <div class="il-stage-chips" id="stageChips"></div>
      <div class="il-stage-art" id="stageArt" hidden=""></div>
    </div>

    <div class="il-side">
      <div class="il-side-head">
        <h2>💡 발명 아이디어 공작소</h2>
        <div class="il-side-sub">4가지 발명 마법 · AI 코치</div>
      </div>
      <div class="il-side-body">

    <!-- 1. 발명의 비밀 탐험 -->
    <section class="screen" id="scr-explore">
      <div class="il-progress" id="exploreProgress" role="img"></div>
      <div class="il-card il-explore-card">
        <div class="il-explore-emoji" id="exploreEmoji"></div>
        <div class="il-explore-title" id="exploreTitle"></div>
        <div class="il-explore-q">이 발명품은 어떤 마법을 썼을까요?</div>
        <div class="il-magic-grid" id="exploreMagicGrid"></div>
        <div class="il-feedback" id="exploreFeedback" role="status" aria-live="polite"></div>
      </div>
      <button class="il-btn" id="exploreNextBtn" onclick="goNextExplore()" hidden="">다음 →</button>
    </section>

    <!-- 2. 내 발명 만들기 -->
    <section class="screen" id="scr-build">
      <div class="il-card">
        <p class="il-headline">내 발명품을 만들어 봐요</p>
        <p class="il-sub">물건을 고르고, 발명 마법 카드를 골라보세요.</p>

        <div class="il-section-title" id="itemTitle">1️⃣ 물건 고르기</div>
        <div class="il-item-grid" id="itemGrid" role="group" aria-labelledby="itemTitle"></div>
        <div class="il-custom-row">
          <input class="hero-input" id="itemCustomInput" placeholder="또는 직접 써 보기 (최대 20자)" maxlength="20" aria-label="물건 이름 직접 쓰기 (최대 20자)">
        </div>

        <div class="il-section-title" id="magicTitle">2️⃣ 발명 마법 카드 고르기 (최대 2개)</div>
        <div class="il-magic-grid" id="magicPickGrid" role="group" aria-labelledby="magicTitle"></div>

        <div id="item2Wrap" hidden="">
          <div class="il-section-title" id="item2Title">3️⃣ 무엇과 합칠까요?</div>
          <div class="il-item-grid" id="item2Grid" role="group" aria-labelledby="item2Title"></div>
          <div class="il-custom-row">
            <input class="hero-input" id="item2CustomInput" placeholder="또는 직접 써 보기 (최대 20자)" maxlength="20" aria-label="합칠 물건 이름 직접 쓰기 (최대 20자)">
          </div>
        </div>

        <button class="il-btn" style="margin-top:20px" onclick="goToCoach()">AI 코치와 궁리하러 가기 →</button>
      </div>
    </section>

    <!-- 3. AI 코치와 궁리 -->
    <section class="screen" id="scr-coach">
      <div class="il-progress" id="coachProgress" role="img"></div>
      <div class="il-card" id="coachCard">
        <div class="il-loading" id="coachLoading" role="status">
          <div class="il-spinner"></div>
          <div class="il-loading-text">코치 선생님이 질문을 생각하고 있어요…</div>
        </div>
        <div id="coachBody" hidden="">
          <div id="coachOfflineNote"></div>
          <div class="il-question-row">
            <div class="il-question-text" id="coachQuestion" tabindex="-1"></div>
            <button class="il-tts-btn" id="coachTtsBtn" onclick="ttsSpeak(getEl('coachQuestion').textContent)" title="질문 읽어주기" aria-label="질문 소리로 읽어주기">🔊</button>
          </div>
          <div class="il-choice-list" id="coachChoices"></div>
          <div class="il-custom-row" style="margin-top:10px">
            <input class="hero-input" id="coachCustomInput" placeholder="또는 직접 써 보기 (최대 100자)" maxlength="100" aria-label="내 생각 직접 쓰기 (최대 100자)">
            <button class="il-btn" style="width:auto;flex:0 0 auto;padding:.75rem 1.1rem" onclick="submitCoachCustom()">확인</button>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. 이름 짓기 -->
    <section class="screen" id="scr-name">
      <div class="il-card" id="nameCard">
        <div class="il-loading" id="nameLoading" role="status">
          <div class="il-spinner"></div>
          <div class="il-loading-text">발명품 이름을 생각하고 있어요…</div>
        </div>
        <div id="nameBody" hidden="">
          <p class="il-headline" id="nameHeadline" tabindex="-1">이름을 지어줘요!</p>
          <p class="il-final-summary" id="nameSummaryPreview" style="margin-bottom:16px"></p>
          <div id="coachOfflineNote2"></div>
          <div class="il-choice-list" id="nameChoices"></div>
          <div class="il-custom-row" style="margin-top:10px">
            <input class="hero-input" id="nameCustomInput" placeholder="또는 내가 직접 짓기 (최대 20자)" maxlength="20" aria-label="발명품 이름 직접 짓기 (최대 20자)">
            <button class="il-btn" style="width:auto;flex:0 0 auto;padding:.75rem 1.1rem" onclick="submitCustomName()">이 이름!</button>
          </div>
          <div class="il-feedback no" id="nameError" role="status" aria-live="polite"></div>
        </div>
      </div>
    </section>

    <!-- 5. 그림 그리기 -->
    <section class="screen" id="scr-draw">
      <div class="il-card">
        <div class="il-loading" id="drawLoading" role="status">
          <div class="il-spinner"></div>
          <div class="il-loading-text">그림을 그리고 있어요…</div>
          <div class="il-loading-sub">10~20초 정도 걸려요. 조금만 기다려 주세요 🎨</div>
        </div>
        <div id="drawBody" hidden="" style="text-align:center">
          <div class="il-final-art" id="drawArtWrap"></div>
          <div class="il-btn-row">
            <button class="il-btn il-btn-ghost" id="drawRegenBtn" onclick="startDraw(true)">🔄 다시 그리기</button>
            <button class="il-btn" onclick="goToCompleted()">완성! →</button>
          </div>
          <p class="il-attempt-note" id="drawAttemptNote" aria-live="polite"></p>
        </div>
      </div>
    </section>

    <!-- 6. 발명 카드 완성 -->
    <section class="screen" id="scr-card">
      <div class="il-final-card" id="finalCardRoot"></div>
      <div class="il-btn-row">
        <button class="il-btn il-btn-ghost" onclick="shareWork()">🔗 공유하기</button>
        <button class="il-btn" onclick="startOver()">✨ 새 발명품 만들기</button>
      </div>
    </section>

    <!-- 7. 공유받은 카드 -->
    <section class="screen" id="scr-shared">
      <div class="il-final-card" id="sharedCardRoot"></div>
      <div class="il-btn-row">
        <button class="il-btn il-btn-ghost" onclick="regenSharedImage()">🔄 그림 다시 그리기</button>
        <button class="il-btn" onclick="cloneSharedToCollection()">📂 내 작품집에 저장</button>
      </div>
      <button class="il-btn il-btn-ghost" style="margin-top:10px" onclick="startOver()">✨ 나도 발명해보기</button>
    </section>

    <!-- 8. 내 작품집 -->
    <section class="screen" id="scr-collection">
      <p class="il-headline" style="margin-bottom:14px">📂 내 작품집</p>
      <div id="collectionGrid" class="il-collection-grid"></div>
      <div class="il-empty" id="collectionEmpty" hidden="">아직 만든 발명품이 없어요.<br>지금 첫 발명품을 만들어 볼까요?</div>
      <button class="il-btn il-btn-ghost" style="margin-top:16px" onclick="showScreen('intro')">← 처음으로</button>
    </section>

      </div><!-- /.il-side-body -->
    </div><!-- /.il-side -->
  </div><!-- /.il-work -->


  <script is:inline="">
    /* ══════════════════════ 상수 · 데이터 ══════════════════════ */
    const LS_KEY = 'idea-lab:v1';
    const COACH_TOTAL = 3;
    const IMAGE_MAX_REGEN = 2;
    const DRAW_TIMEOUT_MS = 26000;

    const MAGICS = [
      { key: 'combine', label: '합치기', em: '🧲' },
      { key: 'split', label: '나누기', em: '✂️' },
      { key: 'resize', label: '크기 바꾸기', em: '🔍' },
      { key: 'material', label: '재료 바꾸기', em: '🧱' },
    ];
    const MAGIC_BY_KEY = Object.fromEntries(MAGICS.map(m => [m.key, m]));

    const ITEMS = [
      { em: '☂️', label: '우산' }, { em: '🎒', label: '가방' }, { em: '✏️', label: '연필' }, { em: '🥤', label: '컵' },
      { em: '👟', label: '신발' }, { em: '🪑', label: '의자' }, { em: '⌚', label: '시계' }, { em: '👓', label: '안경' },
      { em: '🧢', label: '모자' }, { em: '🧦', label: '양말' }, { em: '🚲', label: '자전거' }, { em: '🪥', label: '칫솔' },
      { em: '📚', label: '책' }, { em: '🧤', label: '장갑' }, { em: '🥪', label: '도시락' }, { em: '🖍️', label: '크레파스' },
    ];

    const EXPLORE_EXAMPLES = [
      { title: '지우개 달린 연필', em: '✏️', magic: 'combine' },
      { title: '바퀴 달린 여행가방', em: '🧳', magic: 'combine' },
      { title: '접는 우산', em: '☂️', magic: 'resize' },
      { title: '씨 없는 수박', em: '🍉', magic: 'split' },
      { title: '종이 빨대', em: '🥤', magic: 'material' },
      { title: '미니 선풍기(손풍기)', em: '🌀', magic: 'resize' },
    ];

    const OFFLINE_BANK = {
      combine: [
        { choices: ['비 오는 날', '학교 갈 때', '여행 갈 때'] },
        { choices: ['나 같은 어린이', '우리 가족', '선생님'] },
        { choices: ['손이 자유로워요', '가지고 다니기 편해요', '안 잃어버려요'] },
      ],
      split: [
        { choices: ['무거운 부분', '필요 없는 부분', '불편한 부분'] },
        { choices: ['안 써서예요', '무거워서예요', '불편해서예요'] },
        { choices: ['더 가벼워요', '더 간단해요', '더 빨라요'] },
      ],
      resize: [
        { choices: ['가지고 다닐 때', '숨겨야 할 때', '친구랑 나눠 쓸 때'] },
        { choices: ['주머니에', '필통에', '가방에'] },
        { choices: ['친구랑', '동생이랑', '가족이랑'] },
      ],
      material: [
        { choices: ['더 가벼운 재료', '더 튼튼한 재료', '자연을 지키는 재료'] },
        { choices: ['안 무거워서요', '안 부서져서요', '환경에 좋아서요'] },
        { choices: ['더 오래 써요', '더 안전해요', '더 재미있어요'] },
      ],
    };
    const OFFLINE_QUESTIONS = {
      combine: ['{things}{을를} 합치면 언제 좋을까요?', '누가 제일 좋아할까요?', '어떤 점이 제일 편해질까요?'],
      split:   ['{things}에서 어떤 부분을 빼면 좋을까요?', '왜 그 부분이 필요 없을까요?', '그러면 무엇이 더 좋아질까요?'],
      resize:  ['{things} 크기를 바꾸면 언제 편할까요?', '어디에 넣고 다니면 좋을까요?', '누구랑 같이 쓰면 좋을까요?'],
      material:['{things}의 재료를 무엇으로 바꾸면 좋을까요?', '왜 그 재료가 좋을까요?', '새 재료면 뭐가 달라질까요?'],
    };

    // 오프라인/클라이언트 방어용 금칙어(1차, 서버 검열은 API에서 매번 강제됨)
    const LOCAL_BAD_PATTERNS = [
      /씨\s*발|시\s*발|씨\s*팔|ㅅ\s*ㅂ|ㅆ\s*ㅂ/i, /개\s*새\s*끼|개\s*색\s*끼/i, /병\s*신|븅\s*신|ㅂ\s*ㅅ/i,
      /좆|존\s*나|조\s*낸/i, /지\s*랄|ㅈ\s*ㄹ/i, /미친\s*놈|미친\s*년/i, /fuck|shit|bitch|asshole/i,
    ];
    // 오탐 방지: "다시 발명", "씨 발아" 같은 보통 말은 검사 전에 지운다(lookbehind는 구형 사파리에서 문법 오류라 쓰지 않음)
    const LOCAL_SAFE_PHRASES = /다\s*시\s*발|시\s*발(?=[견명표전달생사송])|씨\s*발(?=[아육])/g;
    function localBadHit(t) {
      const s = String(t == null ? '' : t).replace(LOCAL_SAFE_PHRASES, '');
      return LOCAL_BAD_PATTERNS.some(re => re.test(s));
    }

    /* ══════════════════════ 상태 ══════════════════════ */
    const state = {
      exploreIdx: 0,
      exploreAnswered: false,
      build: { item: '', itemEmoji: '💡', item2: '', item2Emoji: '💡', magics: [] },
      workId: null,
      coach: { step: 1, answers: [] },
      summary: '',
      finalName: '',
      image: { b64: null, attempts: 0, failed: false },
      shared: null, // 공유받은 데이터
    };

    /* ══════════════════════ 유틸 ══════════════════════ */
    function getEl(id) { return document.getElementById(id); }
    function uid() { return (crypto.randomUUID ? crypto.randomUUID() : 'w-' + Date.now() + '-' + Math.random().toString(36).slice(2)); }
    function escHtml(s) {
      if (window.VSafe) return VSafe.esc(s);
      return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    // 받침 유무로 조사만 고르기(SimKit.josa). 한글·숫자로 끝나지 않으면 "을(를)"처럼 둘 다
    function josa(word, withB, withoutB) {
      return SimKit.josa.pick(String(word || ''), withB + '/' + withoutB);
    }
    // 그림(base64 PNG)은 문자열로 HTML에 끼우지 않고 img.src로만 넣는다
    function isB64Png(b64) { return typeof b64 === 'string' && b64.length > 0 && /^[A-Za-z0-9+/]+={0,2}$/.test(b64); }
    function makeArtImg(b64, alt) {
      const img = document.createElement('img');
      img.src = 'data:image/png;base64,' + b64;
      img.alt = alt || '';
      return img;
    }
    function timeoutSignal(ms) {
      if (window.AbortSignal && typeof AbortSignal.timeout === 'function') return AbortSignal.timeout(ms);
      const c = new AbortController();
      setTimeout(() => c.abort(), ms);
      return c.signal;
    }
    // 실패 이유별 안내(429는 '오프라인'이 아니라 '사용자가 많음')
    function fallbackNoteText(err, what) {
      if (err && err.status === 429) return `⏳ 지금 쓰는 친구가 많아요. 준비된 ${what} 계속할게요`;
      if (err && (err.name === 'TimeoutError' || err.name === 'AbortError')) return `⏱️ 응답이 늦어서 준비된 ${what} 계속할게요`;
      if (err && err.status) return `🛠️ 코치 선생님이 잠깐 쉬고 있어요. 준비된 ${what} 계속할게요`;
      return `📴 인터넷 연결이 불안정해서 준비된 ${what} 계속할게요`;
    }
    function noteSpan(text) {
      const span = document.createElement('span');
      span.className = 'il-offline-note';
      span.textContent = text;
      return span;
    }
    function showToast(msg) { SimKit.toast(msg); }
    let currentScreenId = 'intro';
    function showScreen(id) {
      document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
      const target = getEl('scr-' + id);
      if (target) target.classList.add('active');
      currentScreenId = id;
      document.body.classList.toggle('il-in-work', id !== 'intro');
      const side = document.querySelector('.il-side');
      if (side) side.scrollTop = 0;
      window.scrollTo({ top: 0, behavior: 'smooth' });
      if (id === 'collection') renderCollection();
      updateStage(id);
    }

    /* ── 좌측 무대: 현재 단계·상태를 큰 그림으로 보여준다 ── */
    function updateStage(id) {
      const emojiEl = getEl('stageEmoji'), titleEl = getEl('stageTitle'),
            chipsEl = getEl('stageChips'), artEl = getEl('stageArt');
      if (!emojiEl) return;
      const b = state.build;
      const magicChips = (b.magics || []).map(k => {
        const m = MAGIC_BY_KEY[k];
        return m ? `<div class="il-magic-chip"><span class="em">${m.em}</span>${m.label}</div>` : '';
      }).join('');
      const thingsEmoji = b.item ? (b.item2 ? `${b.itemEmoji}＋${b.item2Emoji}` : b.itemEmoji) : '💡';
      const thingsLabel = b.item ? (b.item2 ? `${b.item} + ${b.item2}` : b.item) : '';
      let emoji = '💡', title = '발명 공작소', chips = '', artB64 = null;

      if (id === 'explore') {
        const ex = EXPLORE_EXAMPLES[state.exploreIdx];
        if (ex) { emoji = ex.em; title = ex.title; }
        chips = state.exploreAnswered && ex ? (() => { const m = MAGIC_BY_KEY[ex.magic]; return m ? `<div class="il-magic-chip"><span class="em">${m.em}</span>${m.label}</div>` : ''; })() : '';
      } else if (id === 'build') {
        emoji = thingsEmoji; title = thingsLabel || '물건을 골라 보세요'; chips = magicChips;
      } else if (id === 'coach') {
        emoji = thingsEmoji; title = thingsLabel; chips = magicChips;
      } else if (id === 'name' || id === 'draw' || id === 'card') {
        emoji = thingsEmoji; title = state.finalName || thingsLabel; chips = magicChips;
        if (state.image && state.image.b64) artB64 = state.image.b64;
      } else if (id === 'shared') {
        emoji = '🎁'; title = (state.shared && state.shared.name) || '공유받은 발명품';
        if (state.shared && state.shared.b64) artB64 = state.shared.b64;
      } else if (id === 'collection') {
        emoji = '📂'; title = '내 작품집';
      }

      titleEl.textContent = title;
      chipsEl.innerHTML = chips;
      if (isB64Png(artB64)) {
        artEl.innerHTML = '';
        artEl.appendChild(makeArtImg(artB64, ''));
        artEl.hidden = false; emojiEl.hidden = true;
      } else {
        artEl.hidden = true; artEl.innerHTML = '';
        emojiEl.hidden = false; emojiEl.textContent = emoji;
      }
    }
    // 사이드바 조작(선택·입력) 후 무대를 상태와 동기화
    document.addEventListener('click', () => setTimeout(() => updateStage(currentScreenId), 0));
    document.addEventListener('input', () => setTimeout(() => updateStage(currentScreenId), 0));
    function ttsSpeak(text) { SimKit.speak(text); }
    // TTS 미지원 브라우저는 버튼 자동 숨김
    if (!SimKit.speak.supported()) {
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.il-tts-btn').forEach(b => b.hidden = true);
      });
    }

    const TEXT_TIMEOUT_MS = 15000;
    async function callIdeaLab(action, payload, timeoutMs) {
      const res = await fetch('/api/idea-lab', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, ...payload }),
        signal: timeoutSignal(timeoutMs || TEXT_TIMEOUT_MS),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        const err = new Error(data.error || '요청 실패');
        err.flagged = !!data.flagged;
        err.status = res.status;
        throw err;
      }
      return data;
    }

    /* ══════════════════════ localStorage ══════════════════════ */
    function loadStore() {
      try {
        const raw = localStorage.getItem(LS_KEY);
        if (raw) {
          const s = JSON.parse(raw);
          if (s && Array.isArray(s.works)) return s;
        }
      } catch {}
      return { works: [], settings: {} };
    }
    // 성공하면 true. 용량 초과 등으로 실패해도 예외를 밖으로 던지지 않는다
    function saveStore(store) {
      try { localStorage.setItem(LS_KEY, JSON.stringify(store)); return true; }
      catch (e) { return false; }
    }
    // 그림(base64)이 커서 저장 공간이 모자라면 그림만 빼고 저장한다. 화면의 그림은 그대로 둔다
    // 돌려주는 값: 'full'(그대로 저장) | 'slim'(그림 빼고 저장) | false(저장 못 함)
    const SLIM_SAVED_MSG = '저장 공간이 꽉 차서 그림은 빼고 작품집에 저장했어요. 오래된 작품을 지우면 그림도 저장돼요.';
    function upsertWork(work) {
      const store = loadStore();
      const idx = store.works.findIndex(w => w.id === work.id);
      if (idx >= 0) store.works[idx] = work; else store.works.unshift(work);
      let result = saveStore(store) ? 'full' : false;
      if (!result && work.b64) {
        store.works[idx >= 0 ? idx : 0] = { ...work, b64: null };
        if (saveStore(store)) result = 'slim';
      }
      if (!result) showToast('저장 공간이 꽉 차서 작품집에 저장하지 못했어요. 오래된 작품을 지워 주세요.');
      updateCollectionBadge();
      return result;
    }
    function deleteWork(id) {
      const store = loadStore();
      store.works = store.works.filter(w => w.id !== id);
      saveStore(store);
      renderCollection();
      updateCollectionBadge();
    }
    function updateCollectionBadge() {
      const n = loadStore().works.length;
      const badge = getEl('ilCollectionCount');
      badge.textContent = n;
      badge.hidden = n === 0;
    }

    /* ══════════════════════ 인트로 ══════════════════════ */
    function startExplore() {
      state.exploreIdx = 0;
      renderExploreCard();
      showScreen('explore');
    }

    /* ══════════════════════ 1. 탐험(사례) ══════════════════════ */
    function renderExploreProgress() {
      const wrap = getEl('exploreProgress');
      wrap.setAttribute('aria-label', `발명품 ${EXPLORE_EXAMPLES.length}개 중 ${state.exploreIdx + 1}번째`);
      wrap.innerHTML = EXPLORE_EXAMPLES.map((_, i) =>
        `<span class="il-dot ${i < state.exploreIdx ? 'done' : ''} ${i === state.exploreIdx ? 'now' : ''}"></span>`
      ).join('');
    }
    function renderExploreCard() {
      renderExploreProgress();
      const ex = EXPLORE_EXAMPLES[state.exploreIdx];
      getEl('exploreEmoji').textContent = ex.em;
      getEl('exploreTitle').textContent = ex.title;
      getEl('exploreFeedback').textContent = '';
      getEl('exploreFeedback').className = 'il-feedback';
      getEl('exploreNextBtn').hidden = true;
      state.exploreAnswered = false;
      const grid = getEl('exploreMagicGrid');
      grid.innerHTML = MAGICS.map(m =>
        `<button type="button" class="il-magic-btn" data-key="${m.key}" onclick="answerExplore('${m.key}')">
          <span class="em" aria-hidden="true">${m.em}</span>${m.label}
        </button>`
      ).join('');
    }
    function answerExplore(key) {
      if (state.exploreAnswered) return;
      state.exploreAnswered = true;
      const ex = EXPLORE_EXAMPLES[state.exploreIdx];
      const grid = getEl('exploreMagicGrid');
      grid.querySelectorAll('.il-magic-btn').forEach(btn => {
        btn.disabled = true;
        if (btn.dataset.key === ex.magic) btn.classList.add('correct');
        else if (btn.dataset.key === key) btn.classList.add('wrong');
      });
      const fb = getEl('exploreFeedback');
      if (key === ex.magic) {
        fb.textContent = '정답이에요! 멋져요 🎉';
        fb.className = 'il-feedback ok';
      } else {
        fb.textContent = `아쉬워요! 정답은 "${MAGIC_BY_KEY[ex.magic].label}"이었어요.`;
        fb.className = 'il-feedback no';
      }
      getEl('exploreNextBtn').hidden = false;
      getEl('exploreNextBtn').textContent = state.exploreIdx < EXPLORE_EXAMPLES.length - 1 ? '다음 →' : '내 발명 만들러 가기 →';
      // 누른 버튼이 잠겼으니 "다음" 버튼으로 초점을 옮긴다
      getEl('exploreNextBtn').focus({ preventScroll: true });
    }
    function goNextExplore() {
      if (state.exploreIdx < EXPLORE_EXAMPLES.length - 1) {
        state.exploreIdx++;
        renderExploreCard();
      } else {
        setupBuildScreen();
        showScreen('build');
      }
    }

    /* ══════════════════════ 2. 내 발명 만들기 ══════════════════════ */
    function itemButtonsHtml(gridSelectedLabel) {
      return ITEMS.map(it =>
        `<button type="button" class="il-item-btn ${it.label === gridSelectedLabel ? 'selected' : ''}" data-label="${escHtml(it.label)}" data-em="${it.em}" aria-pressed="${it.label === gridSelectedLabel}">
          <span class="em" aria-hidden="true">${it.em}</span>${it.label}
        </button>`
      ).join('');
    }
    function setupBuildScreen() {
      state.build = { item: '', itemEmoji: '💡', item2: '', item2Emoji: '💡', magics: [] };
      getEl('itemCustomInput').value = '';
      getEl('item2CustomInput').value = '';
      renderItemGrid();
      renderMagicPickGrid();
      renderItem2Grid();
      getEl('item2Wrap').hidden = true;
    }
    function renderItemGrid() {
      const grid = getEl('itemGrid');
      grid.innerHTML = itemButtonsHtml(state.build.item);
      grid.querySelectorAll('.il-item-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          state.build.item = btn.dataset.label;
          state.build.itemEmoji = btn.dataset.em;
          getEl('itemCustomInput').value = '';
          renderItemGrid();
          refocus(grid, '.il-item-btn', 'label', btn.dataset.label);
        });
      });
    }
    function renderItem2Grid() {
      const grid = getEl('item2Grid');
      grid.innerHTML = ITEMS.filter(it => it.label !== state.build.item).map(it =>
        `<button type="button" class="il-item-btn ${it.label === state.build.item2 ? 'selected' : ''}" data-label="${escHtml(it.label)}" data-em="${it.em}" aria-pressed="${it.label === state.build.item2}">
          <span class="em" aria-hidden="true">${it.em}</span>${it.label}
        </button>`
      ).join('');
      grid.querySelectorAll('.il-item-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          state.build.item2 = btn.dataset.label;
          state.build.item2Emoji = btn.dataset.em;
          getEl('item2CustomInput').value = '';
          renderItem2Grid();
          refocus(grid, '.il-item-btn', 'label', btn.dataset.label);
        });
      });
    }
    getEl('itemCustomInput').addEventListener('input', (e) => {
      const v = e.target.value.trim();
      if (v) { state.build.item = v; state.build.itemEmoji = '💡'; renderItemGrid(); }
    });
    getEl('item2CustomInput').addEventListener('input', (e) => {
      const v = e.target.value.trim();
      if (v) { state.build.item2 = v; state.build.item2Emoji = '💡'; renderItem2Grid(); }
    });
    function renderMagicPickGrid() {
      const grid = getEl('magicPickGrid');
      grid.innerHTML = MAGICS.map(m =>
        `<button type="button" class="il-magic-btn ${state.build.magics.includes(m.key) ? 'selected' : ''}" data-key="${m.key}" aria-pressed="${state.build.magics.includes(m.key)}">
          <span class="em" aria-hidden="true">${m.em}</span>${m.label}
        </button>`
      ).join('');
      grid.querySelectorAll('.il-magic-btn').forEach(btn => {
        btn.addEventListener('click', () => { toggleMagic(btn.dataset.key); refocus(grid, '.il-magic-btn', 'key', btn.dataset.key); });
      });
    }
    // 버튼 묶음을 다시 그린 뒤 키보드 초점을 같은 버튼에 돌려놓는다
    function refocus(grid, sel, attr, val) {
      const b = Array.from(grid.querySelectorAll(sel)).find(x => x.dataset[attr] === val);
      if (b) b.focus({ preventScroll: true });
    }
    function toggleMagic(key) {
      const i = state.build.magics.indexOf(key);
      if (i >= 0) {
        state.build.magics.splice(i, 1);
      } else {
        if (state.build.magics.length >= 2) { showToast('마법은 최대 2개까지 고를 수 있어요.'); return; }
        state.build.magics.push(key);
      }
      renderMagicPickGrid();
      getEl('item2Wrap').hidden = !state.build.magics.includes('combine');
    }
    function goToCoach() {
      if (localBadHit(state.build.item) || localBadHit(state.build.item2)) {
        showToast('다른 말로 표현해볼까요?'); return;
      }
      if (!state.build.item) { showToast('물건을 먼저 골라주세요!'); return; }
      if (!state.build.magics.length) { showToast('발명 마법 카드를 골라주세요!'); return; }
      if (state.build.magics.includes('combine') && !state.build.item2) { showToast('무엇과 합칠지 골라주세요!'); return; }
      state.workId = uid();
      state.coach = { step: 1, answers: [] };
      state.refineFlags = 0;
      state.summary = '';
      state.finalName = '';
      state.image = { b64: null, attempts: 0, failed: false, note: '' };
      showScreen('coach');
      fetchCoachStep();
    }

    /* ══════════════════════ 3. AI 코치와 궁리 ══════════════════════ */
    function thingsLabel() {
      return state.build.magics.includes('combine') && state.build.item2
        ? `${state.build.item}${josa(state.build.item, '과', '와')} ${state.build.item2}`
        : state.build.item;
    }
    function magicLabelText() {
      return state.build.magics.map(k => MAGIC_BY_KEY[k].label).join(' + ');
    }
    function renderCoachProgress() {
      const wrap = getEl('coachProgress');
      wrap.setAttribute('aria-label', `질문 ${COACH_TOTAL}개 중 ${state.coach.step}번째`);
      wrap.innerHTML = Array.from({ length: COACH_TOTAL }).map((_, i) =>
        `<span class="il-dot ${i < state.coach.step - 1 ? 'done' : ''} ${i === state.coach.step - 1 ? 'now' : ''}"></span>`
      ).join('');
    }
    function getOfflineChoices(item, magicKey, step) {
      const base = OFFLINE_BANK[magicKey][step - 1].choices;
      // 특정 물건별 오프라인 보정
      if (item.includes('도시락') || item.includes('샌드위치') || item.includes('밥')) {
        if (magicKey === 'material') {
          if (step === 1) return ['가벼운 나무', '말랑한 실리콘', '안전한 스테인리스'];
          if (step === 2) return ['안 깨져서요', '위생적이어서요', '친환경적이어서요'];
          if (step === 3) return ['더 오래 써요', '더 안전해요', '더 맛있어져요'];
        }
        if (magicKey === 'combine') {
          if (step === 1) return ['소풍 갈 때', '아침 먹을 때', '여행 갈 때'];
          if (step === 2) return ['가족들', '친구들', '나 같은 어린이'];
          if (step === 3) return ['먹기 편해져요', '따뜻하게 보관돼요', '안 쏟아져요'];
        }
      }
      if (item.includes('우산') || item.includes('비')) {
        if (magicKey === 'material') {
          if (step === 1) return ['비닐 대신 종이', '자외선 차단 천', '투명한 유리섬유'];
          if (step === 2) return ['환경에 좋아서요', '안 다치고 안전해서요', '햇빛도 막아줘서요'];
          if (step === 3) return ['더 안심돼요', '더 가벼워요', '더 세련돼요'];
        }
      }
      if (item.includes('연필') || item.includes('필통') || item.includes('볼펜') || item.includes('크레파스')) {
        if (magicKey === 'material') {
          if (step === 1) return ['튼튼한 메탈', '말랑한 고무', '친환경 재활용지'];
          if (step === 2) return ['손이 안 아파서요', '오래 쓸 수 있어서요', '자연을 보호해서요'];
          if (step === 3) return ['더 공부가 잘돼요', '더 안전해요', '더 뿌듯해요'];
        }
      }
      if (item.includes('컵') || item.includes('텀블러') || item.includes('물병')) {
        if (magicKey === 'material') {
          if (step === 1) return ['단단한 도자기', '가벼운 대나무', '깨지지 않는 유리'];
          if (step === 2) return ['안전해서요', '환경에 좋아서요', '예뻐 보여서요'];
          if (step === 3) return ['더 위생적이에요', '가방에 쏙 들어가요', '더 맛있어져요'];
        }
      }
      // 일반적인 물건 카테고리별 재료 보완
      if (magicKey === 'material' && step === 1) {
        return ['가벼운 플라스틱', '튼튼한 나무', '부드러운 실리콘'];
      }
      if (magicKey === 'material' && step === 2) {
        return ['가벼워서요', '안 부서져서요', '환경에 좋아서요'];
      }
      if (magicKey === 'material' && step === 3) {
        return ['더 가벼워져요', '더 튼튼해져요', '더 안전해져요'];
      }
      return base;
    }
    // 서버가 "쓰면 안 되는 말"로 판단했을 때: 방금 낸 답을 빼고 입력칸에 돌려줘 고쳐 쓰게 한다.
    // (예전에는 걸린 답이 answers에 남은 채 계속 다시 보내져 빠져나올 수 없었음)
    function showFlaggedNote(editText, itemProblem) {
      const box = getEl('coachOfflineNote');
      box.innerHTML = '';
      const div = document.createElement('div');
      div.className = 'il-feedback no';
      div.style.marginBottom = '10px';
      div.textContent = itemProblem
        ? '물건 이름에 쓰기 어려운 말이 있대요. 물건을 다시 골라 볼까요?'
        : '이 답에 쓰기 어려운 말이 있대요. 아래 칸에서 고쳐 쓰거나 다른 답을 골라 볼까요?';
      if (itemProblem) {
        const back = document.createElement('button');
        back.type = 'button';
        back.className = 'il-btn il-btn-ghost';
        back.style.marginTop = '8px';
        back.textContent = '← 물건 다시 고르기';
        back.addEventListener('click', () => { setupBuildScreen(); showScreen('build'); });
        div.appendChild(document.createElement('br'));
        div.appendChild(back);
      }
      box.appendChild(div);
      if (editText) getEl('coachCustomInput').value = editText;
      getEl('coachLoading').hidden = true;
      getEl('coachBody').hidden = false;
      renderCoachProgress();
    }
    function restartCoach(msg) {
      state.coach = { step: 1, answers: [] };
      state.summary = '';
      state.refineFlags = 0;
      showScreen('coach');
      if (msg) showToast(msg);
      fetchCoachStep();
    }
    async function fetchCoachStep() {
      renderCoachProgress();
      getEl('coachLoading').hidden = false;
      getEl('coachLoading').querySelector('.il-loading-text').textContent = '코치 선생님이 질문을 생각하고 있어요…';
      getEl('coachBody').hidden = true;
      getEl('coachOfflineNote').innerHTML = '';
      let attempt = 0;
      let lastErr = null;
      while (attempt < 2) {
        try {
          const data = await callIdeaLab('coach', {
            item: state.build.item,
            item2: state.build.magics.includes('combine') ? state.build.item2 : undefined,
            magic: state.build.magics.join(','),
            step: state.coach.step,
            answers: state.coach.answers,
          });
          renderCoachQuestion(data.question, data.choices, false);
          return;
        } catch (e) {
          if (e.flagged) {
            showToast('표현을 다시 써볼까요?');
            if (state.coach.step > 1 && state.coach.answers.length) {
              // 바로 전 단계까지는 통과했으므로 방금 낸 답이 원인 → 그 답만 되돌림
              const last = state.coach.answers.pop();
              state.coach.step--;
              showFlaggedNote(last, false);
            } else {
              showFlaggedNote('', true);
            }
            return;
          }
          lastErr = e;
          if (e.status === 429) break; // 요청이 몰릴 때는 곧바로 다시 보내지 않음
          attempt++;
        }
      }
      // 준비된 질문 뱅크로 대체
      const magicKey = state.build.magics[0];
      const qTpl = OFFLINE_QUESTIONS[magicKey][state.coach.step - 1];
      const tl = thingsLabel();
      const q = qTpl.replace('{things}', tl).replace('{을를}', josa(tl, '을', '를'));
      const choices = getOfflineChoices(state.build.item, magicKey, state.coach.step);
      const note = getEl('coachOfflineNote');
      note.innerHTML = '';
      note.appendChild(noteSpan(fallbackNoteText(lastErr, '질문으로')));
      renderCoachQuestion(q, choices, true);
    }
    function renderCoachQuestion(question, choices, isOffline) {
      getEl('coachLoading').hidden = true;
      getEl('coachBody').hidden = false;
      getEl('coachQuestion').textContent = question;
      getEl('coachCustomInput').value = '';
      const list = getEl('coachChoices');
      list.innerHTML = choices.map(c => `<button type="button" class="il-choice-btn">${escHtml(c)}</button>`).join('');
      list.querySelectorAll('.il-choice-btn').forEach((btn, i) => {
        btn.addEventListener('click', () => pickCoachAnswer(choices[i]));
      });
      // 새 질문이 나오면 질문으로 초점을 옮겨 읽게 한다(앞 버튼은 사라짐)
      getEl('coachQuestion').focus({ preventScroll: true });
    }
    function pickCoachAnswer(text) {
      state.coach.answers.push(text);
      advanceCoach();
    }
    function submitCoachCustom() {
      const v = getEl('coachCustomInput').value.trim();
      if (!v) { showToast('답을 써 주세요.'); return; }
      if (localBadHit(v)) { showToast('다른 말로 표현해볼까요?'); return; }
      state.coach.answers.push(v.slice(0, 100));
      advanceCoach();
    }
    function advanceCoach() {
      if (state.coach.step < COACH_TOTAL) {
        state.coach.step++;
        fetchCoachStep();
      } else {
        finalizeAnswers();
      }
    }
    async function finalizeAnswers() {
      getEl('coachLoading').hidden = false;
      getEl('coachBody').hidden = true;
      getEl('coachLoading').querySelector('.il-loading-text').textContent = '생각을 정리하고 있어요…';
      renderCoachProgress();
      let attempt = 0;
      while (attempt < 2) {
        try {
          const data = await callIdeaLab('refine', {
            item: state.build.item,
            item2: state.build.magics.includes('combine') ? state.build.item2 : undefined,
            magic: state.build.magics.join(','),
            answers: state.coach.answers,
          });
          state.summary = data.summary;
          goToName();
          return;
        } catch (e) {
          if (e.flagged) {
            showToast('표현을 다시 써볼까요?');
            state.refineFlags = (state.refineFlags || 0) + 1;
            if (state.refineFlags >= 2) { restartCoach('생각을 처음부터 다시 골라 볼까요?'); return; }
            // 마지막 답을 되돌려 고쳐 쓰게 한다(같은 답을 계속 다시 보내지 않도록)
            const last = state.coach.answers.pop();
            showFlaggedNote(last, false);
            return;
          }
          if (e.status === 429) break;
          attempt++;
        }
      }
      // 준비된 정리문
      const tl = thingsLabel();
      state.summary = `${tl}${josa(tl, '을', '를')} ${magicLabelText()} 마법으로 바꿔봤어요! ${state.coach.answers.join(', ')}. 정말 멋진 발명품이에요!`;
      goToName();
    }

    /* ══════════════════════ 4. 이름 짓기 ══════════════════════ */
    function goToName() {
      showScreen('name');
      getEl('nameLoading').hidden = false;
      getEl('nameBody').hidden = true;
      getEl('nameLoading').querySelector('.il-loading-text').textContent = '발명품 이름을 생각하고 있어요…';
      getEl('nameSummaryPreview').textContent = state.summary;
      getEl('nameError').textContent = '';
      getEl('coachOfflineNote2').innerHTML = '';
      fetchNameCandidates();
    }
    async function fetchNameCandidates() {
      let attempt = 0;
      let lastNameErr = null;
      while (attempt < 2) {
        try {
          const data = await callIdeaLab('name', { summary: state.summary });
          renderNameChoices(data.names);
          return;
        } catch (e) {
          // 정리문이 걸렸으면 코치 화면이 로딩 상태로 멈춰 있으므로 처음부터 다시 고르게 한다
          if (e.flagged) { restartCoach('생각을 처음부터 다시 골라 볼까요?'); return; }
          lastNameErr = e;
          if (e.status === 429) break;
          attempt++;
        }
      }
      const note2 = getEl('coachOfflineNote2');
      note2.innerHTML = '';
      note2.appendChild(noteSpan(fallbackNoteText(lastNameErr, '이름 후보로')));
      const base = state.build.magics.includes('combine') && state.build.item2 ? `${state.build.item}${state.build.item2}` : state.build.item;
      renderNameChoices([`${base} 친구`, `슈퍼 ${base}`, `${base} ${magicLabelText().split(' ')[0]}`]);
    }
    function renderNameChoices(names) {
      getEl('nameLoading').hidden = true;
      getEl('nameBody').hidden = false;
      const list = getEl('nameChoices');
      list.innerHTML = names.map(n => `<button type="button" class="il-choice-btn">${escHtml(n)}</button>`).join('');
      list.querySelectorAll('.il-choice-btn').forEach((btn, i) => {
        btn.addEventListener('click', () => { state.finalName = names[i]; goToDraw(); });
      });
      getEl('nameHeadline').focus({ preventScroll: true });
    }
    async function submitCustomName() {
      const v = getEl('nameCustomInput').value.trim();
      if (!v) { showToast('이름을 써 주세요.'); return; }
      if (localBadHit(v)) { getEl('nameError').textContent = '다른 이름으로 지어볼까요?'; return; }
      getEl('nameError').textContent = '';
      try {
        const data = await callIdeaLab('name', { summary: state.summary, customName: v.slice(0, 20) });
        if (data.customNameOk === false) { getEl('nameError').textContent = '다른 이름으로 지어볼까요?'; return; }
      } catch (e) {
        if (e.flagged) { getEl('nameError').textContent = '다른 이름으로 지어볼까요?'; return; }
        // 네트워크 실패 시엔 로컬 필터만 통과했으면 진행(오프라인 완주 보장)
      }
      state.finalName = v.slice(0, 20);
      goToDraw();
    }

    /* ══════════════════════ 5. 그림 그리기 ══════════════════════ */
    function goToDraw() {
      showScreen('draw');
      startDraw(false);
    }
    function saveWorkAutomatically() {
      const work = {
        id: state.workId,
        item: state.build.item, itemEmoji: state.build.itemEmoji,
        item2: state.build.magics.includes('combine') ? state.build.item2 : '',
        item2Emoji: state.build.magics.includes('combine') ? state.build.item2Emoji : '',
        magic: state.build.magics,
        answers: state.coach.answers,
        summary: state.summary,
        name: state.finalName,
        b64: state.image.b64,
        createdAt: new Date().toISOString(),
      };
      if (upsertWork(work) === 'slim') showToast(SLIM_SAVED_MSG);
    }
    async function startDraw(isRegen) {
      if (isRegen) {
        if (state.image.attempts >= IMAGE_MAX_REGEN) { showToast('다시 그리기는 여기까지예요!'); return; }
        state.image.attempts++;
      }
      getEl('drawLoading').hidden = false;
      getEl('drawBody').hidden = true;
      getEl('drawLoading').querySelector('.il-loading-text').textContent = '그림을 그리고 있어요…';

      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), DRAW_TIMEOUT_MS);
      let drawErr = null;
      try {
        const res = await fetch('/api/idea-lab', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'image', summary: state.summary }),
          signal: controller.signal,
        });
        const data = await res.json().catch(() => ({}));
        clearTimeout(timer);
        if (!res.ok || !isB64Png(data.b64)) {
          const err = new Error(data.error || '이미지 생성 실패');
          err.status = res.status;
          throw err;
        }
        state.image.b64 = data.b64;
        state.image.failed = false;
        state.image.note = '';
      } catch (e) {
        clearTimeout(timer);
        drawErr = e;
      }
      if (drawErr) {
        const busy = drawErr.status === 429;
        if (state.image.b64) {
          // 다시 그리기가 실패해도 먼저 그린 그림은 그대로 둔다
          state.image.failed = false;
          state.image.note = busy ? '지금 그림 그리는 친구가 많아서 새 그림을 못 그렸어요. 먼저 그린 그림을 그대로 둘게요.'
                                  : '새 그림을 그리지 못했어요. 먼저 그린 그림을 그대로 둘게요.';
        } else {
          state.image.failed = true;
          state.image.note = busy ? '지금 그림 그리는 친구가 많아서 이모지 카드로 완성했어요. 잠시 뒤 다시 그려 보세요.'
                                  : '그림 생성이 어려워 이모지 카드로 완성했어요.';
        }
      }
      // 화면 표시는 저장 성공 여부와 상관없이 먼저(저장 용량 초과가 그림을 지우지 않도록)
      renderDrawResult();
      saveWorkAutomatically();
    }
    function renderDrawResult() {
      getEl('drawLoading').hidden = true;
      getEl('drawBody').hidden = false;
      const wrap = getEl('drawArtWrap');
      if (isB64Png(state.image.b64)) {
        wrap.innerHTML = '';
        wrap.appendChild(makeArtImg(state.image.b64, state.finalName + ' 그림'));
      } else {
        wrap.innerHTML = emojiArtHtml();
      }
      const remain = IMAGE_MAX_REGEN - state.image.attempts;
      getEl('drawRegenBtn').disabled = remain <= 0;
      const remainText = remain > 0 ? `다시 그리기 ${remain}번 더 가능해요.` : '다시 그리기를 모두 사용했어요.';
      getEl('drawAttemptNote').textContent = state.image.note
        ? (state.image.failed ? state.image.note : state.image.note + ' ' + remainText)
        : remainText;
    }
    function emojiArtHtml() {
      const combine = state.build.magics.includes('combine') && state.build.item2;
      return `<div class="il-emoji-art">${state.build.itemEmoji}${combine ? '<span>+</span>' + state.build.item2Emoji : ''}</div>`;
    }

    /* ══════════════════════ 6. 발명 카드 완성 ══════════════════════ */
    function goToCompleted() {
      const work = {
        id: state.workId,
        item: state.build.item, itemEmoji: state.build.itemEmoji,
        item2: state.build.magics.includes('combine') ? state.build.item2 : '',
        item2Emoji: state.build.magics.includes('combine') ? state.build.item2Emoji : '',
        magic: state.build.magics,
        answers: state.coach.answers,
        summary: state.summary,
        name: state.finalName,
        b64: state.image.b64,
        createdAt: new Date().toISOString(),
      };
      const saved = upsertWork(work);
      renderFinalCard(getEl('finalCardRoot'), work, state.image.b64, {});
      showScreen('card');
      if (saved === 'full') showToast('내 작품집에 저장되었어요! 📂');
      else if (saved === 'slim') showToast(SLIM_SAVED_MSG);
    }
    function badgesHtml(magicKeys) {
      return `<div class="il-final-badges">${magicKeys.map(k => `<span class="il-final-badge">${MAGIC_BY_KEY[k].em} ${MAGIC_BY_KEY[k].label}</span>`).join('')}</div>`;
    }
    function renderFinalCard(root, work, b64, opts) {
      const combine = work.item2;
      const hasArt = isB64Png(b64);
      const art = hasArt
        ? `<div class="il-final-art" data-il-art></div>`
        : `<div class="il-final-art">${combine ? `<div class="il-emoji-art">${work.itemEmoji}<span>+</span>${work.item2Emoji}</div>` : `<div class="il-emoji-art">${work.itemEmoji}</div>`}</div>`;
      const magicKeys = (Array.isArray(work.magic) ? work.magic : []).filter(k => Object.prototype.hasOwnProperty.call(MAGIC_BY_KEY, k));
      work = { ...work, magic: magicKeys };

      const magicNames = work.magic.map(k => MAGIC_BY_KEY[k] ? MAGIC_BY_KEY[k].label : k).join(', ');
      
      root.innerHTML = `
        ${badgesHtml(work.magic)}
        <div class="il-final-name">${escHtml(work.name || '이름 없는 발명품')}</div>
        ${art}
        <div class="il-final-summary">${escHtml(work.summary)}</div>
        <div class="il-final-details">
          <div class="il-detail-row">
            <strong>원래 물건</strong>
            <span>${work.itemEmoji || '💡'} ${escHtml(work.item)}${combine ? ` + ${work.item2Emoji || '💡'} ${escHtml(work.item2)}` : ''}</span>
          </div>
          <div class="il-detail-row">
            <strong>발상 기법</strong>
            <span>${escHtml(magicNames)}</span>
          </div>
          ${work.answers && work.answers.length ? `
          <div class="il-detail-row" style="flex-direction: column; align-items: flex-start; gap: 4px;">
            <strong>내가 고른 생각들</strong>
            <span class="il-answers">
              ${work.answers.map((a, idx) => `${idx + 1}. ${escHtml(a)}`).join('<br>')}
            </span>
          </div>
          ` : ''}
        </div>
      `;
      if (hasArt) {
        const artEl = root.querySelector('[data-il-art]');
        if (artEl) artEl.appendChild(makeArtImg(b64, (work.name || '발명품') + ' 그림'));
      }
    }

    /* ══════════════════════ 공유 ══════════════════════ */
    // 공유 인코딩은 SimKit.share와 같은 형식(btoa(encodeURIComponent(JSON)) → base64url). 예전 링크도 그대로 읽힘
    function b64urlEncode(obj) { return SimKit.share.encode(obj); }
    function b64urlDecode(encoded) { return SimKit.share.decode(encoded); }
    function buildShareURL() {
      const store = loadStore();
      const work = store.works.find(w => w.id === state.workId);
      if (!work) return null;
      const payload = { v: 1, item: work.item, item2: work.item2, magic: work.magic, summary: work.summary, name: work.name };
      const encoded = b64urlEncode(payload);
      return `${location.origin}/apps/idea-lab/#share=${encoded}`;
    }
    // 단축(실패하면 긴 주소 그대로) → 복사, 복사가 막히면 링크 창(QR 포함)으로 보여 준다(VUI)
    async function shareWork() {
      const longURL = buildShareURL();
      if (!longURL) { showToast('공유할 발명품이 없어요.'); return; }
      await SimKit.share.send(longURL, { shorten: true, native: false, title: '🔗 발명 아이디어 공작소', copiedMessage: '링크를 복사했어요 ✓' });
    }
    // 공유 링크(#share=)로 들어온 값은 믿지 않는다: 허용한 글자 필드만 길이를 잘라 복사, 그림(b64)은 받지 않음
    function sanitizeShared(d) {
      if (!d || typeof d !== 'object' || d.v !== 1) return null;
      const str = (v, max) => (typeof v === 'string' ? v : '').slice(0, max).trim();
      const item = str(d.item, 20);
      if (!item) return null;
      return {
        v: 1,
        item,
        item2: str(d.item2, 20),
        magic: Array.isArray(d.magic) ? d.magic.filter(k => typeof k === 'string' && Object.prototype.hasOwnProperty.call(MAGIC_BY_KEY, k)).slice(0, 2) : [],
        summary: str(d.summary, 500),
        name: str(d.name, 40),
      };
    }
    function emojiFor(label) {
      const hit = ITEMS.find(it => it.label === label);
      return hit ? hit.em : '💡';
    }
    function renderSharedCard() {
      const s = state.shared;
      const work = { item: s.item, itemEmoji: emojiFor(s.item), item2: s.item2 || '', item2Emoji: emojiFor(s.item2), magic: s.magic || [], summary: s.summary, name: s.name };
      renderFinalCard(getEl('sharedCardRoot'), work, null, {});
      showScreen('shared');
    }
    async function regenSharedImage() {
      const root = getEl('sharedCardRoot');
      const artWrap = root.querySelector('.il-final-art');
      if (artWrap) artWrap.innerHTML = '<div class="il-loading" style="padding:16px"><div class="il-spinner" style="width:32px;height:32px;margin-bottom:8px"></div><div class="il-loading-sub">그림을 그리고 있어요…</div></div>';
      try {
        const data = await callIdeaLab('image', { summary: state.shared.summary }, DRAW_TIMEOUT_MS);
        renderFinalCard(getEl('sharedCardRoot'), { ...state.shared, itemEmoji: emojiFor(state.shared.item), item2Emoji: emojiFor(state.shared.item2) }, data.b64, {});
      } catch {
        showToast('그림 생성에 실패했어요.');
        renderFinalCard(getEl('sharedCardRoot'), { ...state.shared, itemEmoji: emojiFor(state.shared.item), item2Emoji: emojiFor(state.shared.item2) }, null, {});
      }
    }
    function cloneSharedToCollection() {
      const s = state.shared;
      const work = {
        id: uid(), item: s.item, itemEmoji: emojiFor(s.item), item2: s.item2 || '', item2Emoji: emojiFor(s.item2),
        magic: s.magic || [], answers: [], summary: s.summary, name: s.name, createdAt: new Date().toISOString(),
      };
      if (upsertWork(work)) showToast('내 작품집에 저장했어요!');
    }

    /* ══════════════════════ 7. 작품집 ══════════════════════ */
    function renderCollection() {
      const store = loadStore();
      const grid = getEl('collectionGrid');
      const empty = getEl('collectionEmpty');
      if (!store.works.length) { grid.innerHTML = ''; empty.hidden = false; return; }
      empty.hidden = true;
      grid.innerHTML = store.works.map(w => `
        <button type="button" class="il-card il-work-card" data-id="${escHtml(w.id)}">
          <div class="il-work-emoji" aria-hidden="true">${escHtml(w.itemEmoji || '💡')}${w.item2 ? ' + ' + escHtml(w.item2Emoji || '💡') : ''}</div>
          <div class="il-work-name">${escHtml(w.name || '이름 없음')}</div>
          <div class="il-work-date">${escHtml(new Date(w.createdAt).toLocaleDateString())}</div>
        </button>
      `).join('');
      grid.querySelectorAll('.il-work-card').forEach(card => {
        card.addEventListener('click', () => viewWorkCard(card.dataset.id));
      });
    }
    function viewWorkCard(id) {
      const store = loadStore();
      const work = store.works.find(w => w.id === id);
      if (!work) return;
      state.workId = id;
      renderFinalCard(getEl('finalCardRoot'), work, work.b64, {});
      const root = getEl('finalCardRoot');
      const btnRow = document.createElement('div');
      btnRow.className = 'il-btn-row';
      btnRow.innerHTML = `
        <button class="il-btn il-btn-ghost" id="collRedraw">🔄 그림 다시 그리기</button>
        <button class="il-btn il-btn-ghost" id="collDelete" style="background:var(--danger);color:#fff">🗑 삭제</button>
      `;
      root.appendChild(btnRow);
      getEl('collRedraw').addEventListener('click', async () => {
        const artWrap = root.querySelector('.il-final-art');
        artWrap.innerHTML = '<div class="il-loading" style="padding:16px"><div class="il-spinner" style="width:32px;height:32px;margin-bottom:8px"></div><div class="il-loading-sub">그림을 그리고 있어요…</div></div>';
        try {
          const data = await callIdeaLab('image', { summary: work.summary }, DRAW_TIMEOUT_MS);
          work.b64 = data.b64;
          if (upsertWork(work) === 'slim') showToast(SLIM_SAVED_MSG);
          renderFinalCard(root, work, data.b64, {});
          root.appendChild(btnRow);
        } catch { showToast('그림 생성에 실패했어요.'); renderFinalCard(root, work, work.b64, {}); root.appendChild(btnRow); }
      });
      getEl('collDelete').addEventListener('click', () => {
        if (confirm('이 발명품을 삭제할까요?')) { deleteWork(id); showScreen('collection'); }
      });
      showScreen('card');
    }

    /* ══════════════════════ 처음으로 ══════════════════════ */
    function startOver() {
      state.shared = null;
      setupBuildScreen();
      showScreen('build');
    }

    /* ══════════════════════ 초기화 ══════════════════════ */
    (function init() {
      updateCollectionBadge();
      const hash = location.hash;
      if (hash.startsWith('#share=')) {
        try {
          const data = sanitizeShared(b64urlDecode(hash.slice(7)) || null);
          if (data) {
            history.replaceState(null, '', location.pathname);
            state.shared = data;
            renderSharedCard();
            return;
          }
        } catch {}
        showToast('공유 링크를 읽을 수 없습니다.');
      }
    })();
  </script>



</AppLayout>
