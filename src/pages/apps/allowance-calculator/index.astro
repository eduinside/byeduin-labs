---
import AppLayout from '../../../layouts/AppLayout.astro';
import Icon from '../../../components/Icon.astro';
---
<AppLayout
  title="기타소득 세금 계산기 — eduin VIVES"
  description="기타소득 수당의 세전 원금과 세후 금액을 자동으로 역산/계산합니다. 8.8% 세율 및 125,000원 과세최저한 완벽 적용."
  image="https://eduin.info/og-images/allowance-calculator.png"
  bodyShell="column"
  bodyWidth="narrow"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&amp;family=Noto+Sans+KR:wght@400;500;700&amp;display=swap" rel="stylesheet">
  <style is:global="">
    body { margin: 0; }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(0, 111, 238, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 111, 238, 0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 0;
    }

    /* 앱 전용 스타일 — 폭·정렬·패딩은 셸(.app-main, data-width=narrow)이 담당 */
    .calculator-layout {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    
    .input-group {
      position: relative;
      margin-bottom: 8px;
    }
    
    .large-input {
      /* 360px 폭에서도 큰 금액이 잘리지 않게 화면 폭에 맞춰 줄인다(최소 22px) */
      font-size: clamp(22px, 7.5vw, 32px);
      font-weight: 700;
      text-align: right;
      padding: 16px 20px;
      padding-right: 50px;
      height: auto;
      font-family: 'JetBrains Mono', -apple-system, BlinkMacSystemFont, 'Pretendard', sans-serif;
    }
    
    .input-unit {
      position: absolute;
      right: 20px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 20px;
      font-weight: 700;
      color: var(--fg-muted);
    }
    
    /* 세전/세후 세그먼트 컨트롤 */
    .segment-control {
      display: flex;
      background: var(--bg-sec);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 4px;
      gap: 4px;
      margin-bottom: 16px;
    }
    
    .segment-btn {
      flex: 1;
      border: none;
      background: none;
      color: var(--fg-muted);
      padding: 10px;
      min-height: 44px;
      font-size: 14px;
      font-weight: 600;
      border-radius: 7px;
      cursor: pointer;
      transition: all 0.15s;
    }
    
    .segment-btn.active {
      background: var(--card-bg);
      color: var(--primary);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }
    
    /* 자동 판별 배지 및 안내 */
    .badge-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 20px;
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 500;
    }
    
    .badge-bar.auto-active {
      background: rgba(0, 111, 238, 0.06);
      border: 1px dashed rgba(0, 111, 238, 0.3);
      color: var(--primary);
    }
    
    .badge-bar.manual-active {
      background: var(--bg-sec);
      border: 1px dashed var(--border);
      color: var(--fg);
    }
    /* 자동 판별을 다른 기준으로 바로 고치는 버튼(배지 안) */
    .badge-switch {
      min-height: 36px;
      padding: 4px 12px;
      border-radius: 8px;
      border: 1px solid currentColor;
      background: var(--card-bg);
      color: inherit;
      font: inherit;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }
    @media (pointer: coarse) { .badge-switch { min-height: 44px; } }
    .badge-main { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; flex: 1 1 200px; }
    
    .pill-badge {
      padding: 2px 8px;
      border-radius: 99px;
      font-size: 11px;
      font-weight: 700;
      white-space: nowrap;
    }
    
    .pill-badge.blue {
      background: var(--primary);
      color: #ffffff;
    }
    
    .pill-badge.gray {
      background: var(--fg-muted);
      color: #ffffff;
    }
    
    /* 결과 카드 보드 */
    .result-board {
      background: var(--bg-sec);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    
    .result-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    
    .result-label {
      font-size: 13px;
      color: var(--fg-muted);
      font-weight: 500;
    }
    
    .result-value {
      font-size: 16px;
      font-weight: 600;
      font-family: 'JetBrains Mono', -apple-system, BlinkMacSystemFont, 'Pretendard', sans-serif;
    }
    
    .result-value.highlight {
      font-size: 24px;
      font-weight: 700;
      color: var(--fg);
    }
    
    .result-value.primary-highlight {
      font-size: 24px;
      font-weight: 700;
      color: var(--primary);
    }
    
    .result-value .unit {
      font-size: 14px;
      font-weight: 500;
      color: var(--fg-muted);
      margin-left: 3px;
      font-family: -apple-system, BlinkMacSystemFont, 'Pretendard', sans-serif;
    }
    
    .result-value.primary-highlight .unit {
      font-size: 15px;
      font-weight: 600;
      color: rgba(0, 111, 238, 0.8);
    }
    
    .tax-detail {
      font-size: 11px;
      color: var(--fg-muted);
      margin-top: -8px;
      text-align: right;
    }
    
    .info-box {
      font-size: 12px;
      color: var(--fg-muted);
      line-height: 1.5;
      padding: 12px 14px;
      background: var(--bg-sec);
      border-left: 3px solid var(--border);
      border-radius: 0 8px 8px 0;
    }
    
    .info-box.tax-exempt {
      border-left-color: var(--success);
      background: rgba(23, 201, 100, 0.08);
      color: #146c34;   /* 연녹 배경 위 대비 4.5:1 이상 */
    }
    [data-theme="dark"] .info-box.tax-exempt { color: #5ee39a; }
    @media (prefers-color-scheme: dark) { :root:not([data-theme]) .info-box.tax-exempt { color: #5ee39a; } }
    .info-box .ic { vertical-align: -0.15em; margin-right: 2px; }
    .history-main-text .ic { vertical-align: -0.15em; }
    
    /* 최근 내역 */
    .history-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }
    
    .history-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-height: 240px;
      overflow-y: auto;
    }
    
    .history-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 6px;
      padding: 4px 6px 4px 4px;
      border: 1px solid var(--border);
      background: var(--card-bg);
      border-radius: 8px;
      font-size: 13px;
      transition: all 0.15s;
    }

    .history-item:hover {
      border-color: var(--primary);
      transform: translateY(-1px);
    }

    /* 내역 불러오기 = 버튼(키보드로도 누를 수 있게) */
    .history-info {
      flex: 1;
      min-width: 0;
      min-height: 44px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 2px;
      padding: 6px 10px;
      border: 0;
      background: none;
      color: inherit;
      font: inherit;
      text-align: left;
      cursor: pointer;
      border-radius: 6px;
    }

    .history-main-text {
      font-weight: 600;
      font-family: 'JetBrains Mono', monospace;
    }
    
    .history-sub-text {
      font-size: 11px;
      color: var(--fg-muted);
    }
    
    .delete-btn {
      background: none;
      border: none;
      color: var(--danger);
      cursor: pointer;
      font-size: 13px;
      min-height: 44px;
      min-width: 44px;
      padding: 4px 10px;
      border-radius: 6px;
      transition: background 0.12s;
      font-family: inherit;
    }
    
    .delete-btn:hover {
      background: rgba(243, 18, 96, 0.08);
    }
    
    .empty-history {
      text-align: center;
      padding: 30px;
      color: var(--fg-muted);
      font-size: 13px;
    }

    .calc-actions { display: flex; gap: 8px; margin-top: 20px; flex-wrap: wrap; }
    .calc-actions .hero-btn { flex: 1 1 180px; min-height: 44px; }
    .hero-btn.ghost-btn { background: var(--card-bg); color: var(--primary); border: 1px solid var(--primary); }
    .history-header .fd-label { display: inline-flex; align-items: center; gap: 6px; }
  </style>
  <script type="application/ld+json" is:inline="">{"@context":"https://schema.org","@type":"WebApplication","name":"기타소득 세금 계산기","description":"기타소득 수당의 세전 원금과 세후 금액을 자동으로 역산/계산합니다. 8.8% 세율 및 125,000원 과세최저한 완벽 적용.","url":"https://eduin.info/apps/allowance-calculator/","applicationCategory":"EducationApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"KRW"},"isPartOf":{"@type":"WebSite","name":"eduin VIVES","url":"https://eduin.info"}}</script>
  </Fragment>



  <!-- 플로팅 크롬(홈·테마·공유)은 app-shell.js가 주입 -->

  <!-- 계산기 레이아웃 -->
  <main class="app-main calculator-layout">
    
    <header class="app-header">
      <span class="app-badge">업무경감</span>
      <h1 class="app-title">기타소득 세금 계산기 <span class="app-title-en">Allowance Calculator</span></h1>
      <p class="app-desc">세전 원금과 세후 실수령액 및 기타소득 세금(8.8%)을 한 번에 자동 판별하고 계산합니다.</p>
    </header>

    <!-- 메인 계산 카드 -->
    <div class="fd-card" style="padding: 24px;">
      
      <!-- 금액 입력 -->
      <div class="input-group">
        <input type="text" id="amountInput" class="hero-input large-input" placeholder="0" autocomplete="off" inputmode="numeric" aria-label="금액(원)">
        <span class="input-unit" aria-hidden="true">원</span>
      </div>

      <!-- 모드 세그먼트 컨트롤 -->
      <div class="segment-control" role="group" aria-label="계산 기준">
        <button type="button" id="btnAuto" class="segment-btn active" aria-pressed="true" onclick="setMode('auto')">자동 판별</button>
        <button type="button" id="btnPreTax" class="segment-btn" aria-pressed="false" onclick="setMode('preTax')">세전 기준</button>
        <button type="button" id="btnPostTax" class="segment-btn" aria-pressed="false" onclick="setMode('postTax')">세후 기준</button>
      </div>

      <!-- 상태 표시 바 -->
      <div id="badgeBar" class="badge-bar auto-active">
        <span class="badge-main">
          <span id="badgeText">금액을 입력하면 자동으로 판별합니다.</span>
          <button type="button" id="badgeSwitch" class="badge-switch" hidden></button>
        </span>
        <span id="badgeLabel" class="pill-badge blue">자동</span>
      </div>

      <!-- 계산 결과 디스플레이 -->
      <div class="result-board">
        <div class="result-row">
          <span class="result-label">세전 금액 (수당 원금)</span>
          <span id="valPreTax" class="result-value highlight">0 원</span>
        </div>
        <div class="result-row">
          <span class="result-label">공제 세금 (8.8%)</span>
          <span id="valTax" class="result-value">0 원</span>
        </div>
        <div id="taxDetail" class="tax-detail" style="display: none;">
          (기타소득세 8%: <span id="valTaxIncome">0</span>원 + 지방소득세 0.8%: <span id="valTaxLocal">0</span>원)
        </div>
        <hr style="border: 0; border-top: 1px solid var(--border); margin: 4px 0;">
        <div class="result-row">
          <span class="result-label" style="font-weight: 600;">세후 실수령액</span>
          <span id="valPostTax" class="result-value primary-highlight">0 원</span>
        </div>
      </div>

      <!-- 과세 최저한 안내 박스 -->
      <div id="infoBox" class="info-box" style="margin-top: 16px;">
        <Icon name="lightbulb" /> <b>기타소득 과세최저한</b>: 세전 금액이 125,000원 이하인 경우 세금이 부과되지 않으므로 세전과 세후 금액이 동일합니다.
      </div>
      
      <!-- 저장 · 링크 공유 -->
      <div class="calc-actions">
        <button type="button" class="hero-btn" onclick="saveCurrentCalculation()">
          <Icon name="save" /> 계산 내역 저장하기
        </button>
        <button type="button" class="hero-btn ghost-btn" onclick="shareCalculation()">
          <Icon name="link" /> 이 계산 링크로 공유
        </button>
      </div>

    </div>

    <!-- 최근 내역 카드 -->
    <div class="fd-card" style="padding: 20px;">
      <div class="history-header">
        <h3 class="fd-label" style="font-size: 14px; margin: 0;"><Icon name="history" /> 최근 계산 내역</h3>
        <button type="button" id="clearAllBtn" class="hero-btn hero-btn-danger hero-btn-sm" onclick="clearAllHistory()"><Icon name="trash-2" /> 전체 삭제</button>
      </div>
      <div id="historyList" class="history-list">
        <!-- 최근 내역 동적 삽입 -->
      </div>
    </div>

  </main>

  <!-- 토스트는 공용 VUI.toast (public/common/ui.js) -->

  <script is:inline="">
    // 상태 변수
    let currentMode = 'auto'; // 'auto' | 'preTax' | 'postTax'
    let calculatedData = {
      preTax: 0,
      tax: 0,
      postTax: 0,
      taxIncome: 0,
      taxLocal: 0,
      isTaxExempt: true,
      judgedAs: 'preTax'
    };

    // 로컬스토리지 키
    const STORAGE_KEY = 'vives-allowance-history';

    // DOM Elements
    const amountInput = document.getElementById('amountInput');
    const btnAuto = document.getElementById('btnAuto');
    const btnPreTax = document.getElementById('btnPreTax');
    const btnPostTax = document.getElementById('btnPostTax');
    const badgeBar = document.getElementById('badgeBar');
    const badgeText = document.getElementById('badgeText');
    const badgeLabel = document.getElementById('badgeLabel');
    const valPreTax = document.getElementById('valPreTax');
    const valTax = document.getElementById('valTax');
    const valPostTax = document.getElementById('valPostTax');
    const taxDetail = document.getElementById('taxDetail');
    const valTaxIncome = document.getElementById('valTaxIncome');
    const valTaxLocal = document.getElementById('valTaxLocal');
    const infoBox = document.getElementById('infoBox');
    const historyList = document.getElementById('historyList');

    // 초기화
    window.addEventListener('DOMContentLoaded', () => {
      // 콤마 및 입력 감지 바인딩
      amountInput.addEventListener('input', () => { clearShareHash(); handleInput(); });
      
      // 로컬스토리지 불러오기
      renderHistory();

      // 해시 데이터가 있는 경우 공유된 값 로드
      loadSharedHash();
    });

    // 입력 처리
    function handleInput() {
      // 숫자 외 문자 제거
      let val = amountInput.value.replace(/[^0-9]/g, '').slice(0, 11);   // 최대 999억 원(정밀도 보호)
      if (val === '') {
        amountInput.value = '';
        resetCalculations();
        return;
      }
      
      const num = parseInt(val, 10);
      amountInput.value = formatNumber(num);
      
      calculate(num);
    }

    // 천단위 콤마 포맷
    function formatNumber(num) {
      return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    }

    // 모드 변경 (keepHash: 공유 링크를 읽는 중이면 주소의 #share=를 지우지 않음)
    function setMode(mode, keepHash) {
      currentMode = mode;
      if (!keepHash) clearShareHash();

      // 세그먼트 버튼 활성화 처리
      const active = { auto: btnAuto, preTax: btnPreTax, postTax: btnPostTax }[mode];
      [btnAuto, btnPreTax, btnPostTax].forEach(btn => {
        btn.classList.toggle('active', btn === active);
        btn.setAttribute('aria-pressed', btn === active ? 'true' : 'false');
      });

      // 입력된 값이 있다면 재계산
      const rawVal = amountInput.value.replace(/[^0-9]/g, '');
      if (rawVal !== '') {
        calculate(parseInt(rawVal, 10));
      }
    }

    // 정방향 계산: 세전 → 세금·실수령액 (125,000원 이하 면세, 세금은 단계마다 10원 미만 절사)
    function computeFromPreTax(preTax) {
      if (preTax <= 125000) {
        return { preTax, taxIncome: 0, taxLocal: 0, tax: 0, postTax: preTax, isTaxExempt: true };
      }
      // 소득세 10원 미만 절사
      const taxIncome = Math.floor((preTax * 0.08) / 10) * 10;
      // 지방소득세 10원 미만 절사
      const taxLocal = Math.floor((taxIncome * 0.1) / 10) * 10;
      const tax = taxIncome + taxLocal;
      // 실수령액 = 세전 − 세금. 세금만 10원 미만 절사하고 실수령액은 다시 자르지 않는다(세전 − 세금 = 실수령이 항상 맞게)
      const postTax = preTax - tax;
      return { preTax, taxIncome, taxLocal, tax, postTax, isTaxExempt: false };
    }

    // 역산: 세후(실수령액) → 세전. 추정값 주변 후보를 정방향 계산으로 하나씩 확인해
    // 세후가 정확히 같아지는 세전(10원 단위 우선, 그중 가장 작은 값)을 고른다.
    // 정확히 맞는 세전이 없으면 가장 가까운 값을 고르고 exact=false.
    function findPreTaxForPostTax(target) {
      if (target <= 125000) return Object.assign(computeFromPreTax(target), { exact: true });
      const est = Math.floor(target / 0.912);
      let best = null, bestDiff = Infinity;
      for (let x = Math.max(125001, est - 60); x <= est + 60; x++) {
        const r = computeFromPreTax(x);
        const d = Math.abs(r.postTax - target);
        if (d === 0) {
          if (!best || bestDiff !== 0 || (x % 10 === 0 && best.preTax % 10 !== 0)) { best = r; bestDiff = 0; }
        } else if (d < bestDiff) {
          best = r; bestDiff = d;
        }
      }
      return Object.assign(best, { exact: bestDiff === 0 });
    }

    // 계산 및 판별 핵심 로직
    function calculate(num) {
      if (!num || num <= 0) {
        resetCalculations();
        return;
      }

      let modeToUse = currentMode;
      let judgedAs = '';

      // 1. 자동 판별 적용인 경우
      if (currentMode === 'auto') {
        // 천원 단위 미만이 0이 아니면 세후로 판단, 0이면 세전으로 판단
        if (num % 1000 !== 0) {
          modeToUse = 'postTax';
          judgedAs = 'postTax';
        } else {
          modeToUse = 'preTax';
          judgedAs = 'preTax';
        }
      }

      let preTax = 0;
      let tax = 0;
      let postTax = 0;
      let taxIncome = 0;
      let taxLocal = 0;
      let isTaxExempt = false;

      // 2. 세전 기준 계산 (정방향 — 검증된 계산식 그대로)
      let r;
      let inexact = false;
      if (modeToUse === 'preTax') {
        r = computeFromPreTax(num);
      }
      // 3. 세후 기준 계산 (역산) — 정방향 계산으로 세후가 정확히 같아지는 세전을 찾는다
      else {
        r = findPreTaxForPostTax(num);
        inexact = !r.exact;
      }
      ({ preTax, tax, postTax, taxIncome, taxLocal, isTaxExempt } = r);

      // 상태 저장
      calculatedData = {
        preTax,
        tax,
        postTax,
        taxIncome,
        taxLocal,
        isTaxExempt,
        judgedAs: judgedAs || modeToUse,
        inexact,
        requestedPost: modeToUse === 'postTax' ? num : null
      };

      // UI 업데이트
      updateUI();
    }

    // UI 동적 갱신
    function updateUI() {
      // 1. 값 표시
      valPreTax.innerHTML = `${formatNumber(calculatedData.preTax)} <span class="unit">원</span>`;
      valTax.innerHTML = `${formatNumber(calculatedData.tax)} <span class="unit">원</span>`;
      valPostTax.innerHTML = `${formatNumber(calculatedData.postTax)} <span class="unit">원</span>`;

      // 2. 세부 세금 내역 표시
      if (calculatedData.tax > 0) {
        valTaxIncome.textContent = formatNumber(calculatedData.taxIncome);
        valTaxLocal.textContent = formatNumber(calculatedData.taxLocal);
        taxDetail.style.display = 'block';
      } else {
        taxDetail.style.display = 'none';
      }

      // 3. 상태 바 텍스트 및 배지 처리
      badgeBar.className = 'badge-bar';
      if (currentMode === 'auto') {
        badgeBar.classList.add('auto-active');
        badgeLabel.className = 'pill-badge blue';
        badgeLabel.textContent = '자동';
        // 자동 판별이 틀렸을 때(예: 천 원 단위로 딱 떨어지는 세후 금액) 바로 다른 기준으로 고칠 수 있게
        if (calculatedData.judgedAs === 'preTax') {
          badgeText.innerHTML = `천 원 단위 아래가 0이라 <b>세전 금액(원금)</b>으로 계산했어요.`;
          showBadgeSwitch('세후로 다시 계산', 'postTax');
        } else {
          badgeText.innerHTML = `천 원 단위 아래 숫자가 있어 <b>세후 금액(실수령액)</b>으로 계산했어요.`;
          showBadgeSwitch('세전으로 다시 계산', 'preTax');
        }
      } else {
        badgeBar.classList.add('manual-active');
        badgeLabel.className = 'pill-badge gray';
        badgeLabel.textContent = '직접 선택';
        showBadgeSwitch('', null);
        if (currentMode === 'preTax') {
          badgeText.textContent = '입력한 금액을 세전 금액으로 계산했어요.';
        } else {
          badgeText.textContent = '입력한 금액을 세후 금액(실수령액)으로 계산했어요.';
        }
      }

      // 4. 과세최저한 안내 박스 강조
      if (calculatedData.isTaxExempt) {
        infoBox.className = 'info-box tax-exempt';
        infoBox.innerHTML = VUI.icon('circle-check') + ' <b>세금 미공제 대상</b>: 세전 수당이 125,000원 이하이므로 세금이 0원 처리되었습니다.';
      } else {
        infoBox.className = 'info-box';
        infoBox.innerHTML = VUI.icon('lightbulb') + ' <b>기타소득 과세최저한</b>: 세전 수당이 125,000원을 초과하여 8.8%의 원천징수 세금(기타소득세 8% + 지방소득세 0.8%)이 공제되었습니다.';
      }
      // 역산으로 정확히 만들 수 없는 세후 금액이면 안내
      if (calculatedData.inexact) {
        infoBox.innerHTML += '<br>' + VUI.icon('triangle-alert') + ' 입력한 세후 금액이 정확히 나오는 세전 금액이 없어 가장 가까운 실수령액(' +
          formatNumber(calculatedData.postTax) + '원)으로 계산했어요.';
      }
    }

    // 배지 안 "세후로/세전으로 다시 계산" 버튼 (mode가 null이면 숨김)
    function showBadgeSwitch(label, mode) {
      const b = document.getElementById('badgeSwitch');
      if (!b) return;
      b.hidden = !mode;
      b.textContent = label;
      b.onclick = mode ? () => setMode(mode) : null;
    }

    function resetCalculations() {
      valPreTax.innerHTML = `0 <span class="unit">원</span>`;
      valTax.innerHTML = `0 <span class="unit">원</span>`;
      valPostTax.innerHTML = `0 <span class="unit">원</span>`;
      taxDetail.style.display = 'none';
      
      badgeBar.className = 'badge-bar auto-active';
      badgeLabel.className = 'pill-badge blue';
      badgeLabel.textContent = '자동';
      badgeText.textContent = '금액을 입력하면 자동으로 판별합니다.';
      showBadgeSwitch('', null);

      infoBox.className = 'info-box';
      infoBox.innerHTML = VUI.icon('lightbulb') + ' <b>기타소득 과세최저한</b>: 세전 금액이 125,000원 이하인 경우 세금이 부과되지 않으므로 세전과 세후 금액이 동일합니다.';
      
      calculatedData = {
        preTax: 0,
        tax: 0,
        postTax: 0,
        taxIncome: 0,
        taxLocal: 0,
        isTaxExempt: true,
        judgedAs: 'preTax'
      };
    }

    // 로컬스토리지 저장
    function saveCurrentCalculation() {
      const rawVal = amountInput.value.replace(/[^0-9]/g, '');
      if (rawVal === '' || calculatedData.preTax === 0) {
        showToast('먼저 올바른 금액을 입력해 주세요.');
        return;
      }

      const history = getHistory();
      
      // 중복 계산 내역 검출 및 최신화
      const newEntry = {
        id: Date.now(),
        amount: parseInt(rawVal, 10),
        mode: currentMode,
        preTax: calculatedData.preTax,
        tax: calculatedData.tax,
        postTax: calculatedData.postTax,
        date: new Date().toLocaleString('ko-KR', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })
      };

      // 동일한 금액 계산 내역이 있으면 기존 데이터 제거 후 맨 위로 올림
      const filtered = history.filter(item => !(item.preTax === newEntry.preTax && item.postTax === newEntry.postTax));
      filtered.unshift(newEntry);
      
      // 최대 20개 저장
      if (filtered.length > 20) {
        filtered.pop();
      }

      if (!setHistory(filtered)) return;
      renderHistory();
      showToast('계산 내역이 저장되었습니다.');
    }

    // 최근 내역 렌더링 (클릭은 addEventListener — 인라인 onclick 사용 안 함)
    function renderHistory() {
      const history = getHistory();
      if (history.length === 0) {
        historyList.innerHTML = '<div class="empty-history">최근 계산한 내역이 없습니다.</div>';
        return;
      }

      historyList.innerHTML = '';
      history.forEach(item => {
        const div = document.createElement('div');
        div.className = 'history-item';

        div.innerHTML = `
          <button type="button" class="history-info" aria-label="이 계산 다시 불러오기: 세전 ${formatNumber(item.preTax)}원">
            <span class="history-main-text">세전: ${formatNumber(item.preTax)}원 ${VUI.icon('arrow-right')} 실수령: ${formatNumber(item.postTax)}원</span>
            <span class="history-sub-text">세금: ${formatNumber(item.tax)}원 (${escText(item.date)})</span>
          </button>
          <button type="button" class="delete-btn" aria-label="세전 ${formatNumber(item.preTax)}원 내역 삭제">삭제</button>
        `;
        div.querySelector('.history-info').addEventListener('click', () => loadHistoryItem(item));
        div.querySelector('.delete-btn').addEventListener('click', (e) => deleteHistoryItem(e, item.id));
        historyList.appendChild(div);
      });
    }

    // 히스토리 항목 로드 — 저장할 때 입력한 금액·모드 그대로 다시 계산해야 같은 결과가 나온다
    // (예전: 세전 금액을 저장된 모드로 다시 넣어 세후·자동 모드에서 다른 계산이 나옴)
    function loadHistoryItem(item) {
      const useInput = item.amount > 0 && ['auto', 'preTax', 'postTax'].includes(item.mode);
      const amount = useInput ? item.amount : item.preTax;
      setMode(useInput ? item.mode : 'preTax');
      amountInput.value = formatNumber(amount);
      calculate(amount);
      showToast('이전 계산 내역을 불러왔습니다.');
    }

    // 히스토리 아이템 삭제
    function deleteHistoryItem(e, id) {
      e.stopPropagation(); // 부모 클릭(로드) 이벤트 전파 방지
      const history = getHistory();
      const filtered = history.filter(item => item.id !== id);
      setHistory(filtered);
      renderHistory();
      // 누른 삭제 버튼이 사라졌으니 포커스를 목록 첫 항목(없으면 금액 입력칸)으로
      const next = historyList.querySelector('button') || amountInput;
      next.focus();
      VUI.toast('내역을 삭제했어요.', { action: { label: '되돌리기', onClick: () => { setHistory(history); renderHistory(); } } });
    }

    // 히스토리 전체 삭제 (확인 창)
    async function clearAllHistory() {
      if (getHistory().length === 0) { showToast('지울 내역이 없어요.'); return; }
      const ok = await VUI.confirm('최근 계산 내역을 모두 지울까요?', { title: '전체 삭제', ok: '모두 지우기', danger: true });
      if (!ok) return;
      try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
      renderHistory();
      showToast('모든 내역을 지웠어요.');
    }

    // 금액 검증: 정수, 1원 ~ 999억 원
    const MAX_AMOUNT = 99999999999;
    function toAmount(v) {
      const n = window.VSafe ? VSafe.int(v, 0, MAX_AMOUNT, 0) : Math.min(MAX_AMOUNT, Math.max(0, Math.trunc(Number(v)) || 0));
      return n > 0 ? n : 0;
    }
    function escText(s) {
      if (window.VSafe) return VSafe.esc(s);
      return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    // 히스토리 가져오기 헬퍼 — 값이 깨져 있어도 앱이 멈추지 않게
    function getHistory() {
      let data = [];
      try { data = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); } catch (e) { data = []; }
      if (!Array.isArray(data)) return [];
      return data.filter(i => i && typeof i === 'object').map(i => ({
        id: Number.isFinite(Number(i.id)) ? Number(i.id) : 0,
        amount: toAmount(i.amount),
        mode: ['auto', 'preTax', 'postTax'].includes(i.mode) ? i.mode : 'preTax',
        preTax: toAmount(i.preTax),
        tax: toAmount(i.tax),
        postTax: toAmount(i.postTax),
        date: typeof i.date === 'string' ? i.date.slice(0, 40) : '',
      }));
    }
    function setHistory(list) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
        return true;
      } catch (e) {
        showToast('저장 공간이 부족해 내역을 저장하지 못했어요.', 'error');
        return false;
      }
    }

    // 공유 링크 읽기 — #share=<VUI.share.encode({amount, mode})>.
    // 예전 형식(#<btoa(encodeURIComponent(json))>)도 VUI.share.decode가 읽는다.
    // 해시의 금액·모드는 외부 값이므로 정수·범위·허용 모드만 통과
    function loadSharedHash() {
      if (!window.location.hash || window.location.hash.length < 2) return;
      const decoded = VUI.share.decode(window.location.hash, o => o && typeof o === 'object' && toAmount(o.amount) > 0);
      if (!decoded) {
        showToast('공유 링크를 읽을 수 없어요.', 'error');
        return;
      }
      const amount = toAmount(decoded.amount);
      const mode = ['auto', 'preTax', 'postTax'].includes(decoded.mode) ? decoded.mode : 'auto';
      setMode(mode, true);
      amountInput.value = formatNumber(amount);
      calculate(amount);
      showToast('공유받은 계산을 불러왔어요.');
    }

    // 금액·기준을 바꾸면 주소의 공유 해시는 더 이상 화면과 같지 않으므로 지운다
    function clearShareHash() {
      if (window.location.hash) history.replaceState(null, '', location.pathname + location.search);
    }

    // 토스트 (공용 VUI)
    function showToast(msg, type) { VUI.toast(msg, type); }

    // 공유할 내용: 입력한 금액 + 계산 기준만 (결과는 받는 쪽에서 다시 계산)
    function buildSharePayload() {
      const rawVal = amountInput.value.replace(/[^0-9]/g, '');
      if (rawVal === '' || calculatedData.preTax === 0) return null;
      return { amount: toAmount(rawVal), mode: currentMode };
    }

    // 이 계산 링크로 공유 — 링크가 짧아 단축 없이 복사(안 되면 링크·QR 창)
    function shareCalculation() {
      const payload = buildSharePayload();
      if (!payload || !payload.amount) {
        showToast('먼저 올바른 금액을 입력해 주세요.');
        return;
      }
      const hash = '#share=' + VUI.share.encode(payload);
      history.replaceState(null, '', location.pathname + location.search + hash);   // 상단 공유 버튼도 같은 링크를 쓰게
      VUI.share.copyOrShow(location.origin + location.pathname + hash, {
        title: '계산 공유',
        desc: '링크를 연 사람도 같은 금액·기준으로 계산한 결과를 볼 수 있어요.',
      });
    }
  </script>



</AppLayout>
