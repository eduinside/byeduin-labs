/* ── 앱 런타임 상태 ── */
let state = {
  mode: 1, // 1: 먹이그물, 2: 피라미드, 3: 평형
  missionIdx: 0,
  missionsCompleted: { m1_1: false, m1_2: false, m1_3: false, m2_1: false, m2_2: false, m3_1: false },
  
  // 모드 1 상태
  placedNodes: {}, // id: { x, y }
  edges: [], // [[fromId, toId]...]
  
  // 드래그/연결 도구 상태
  connectMode: false,
  eraserMode: false,
  activeConnectSource: null,

  // 시나리오 시뮬레이션 상태
  activeScenario: 'A',
  simulationStep: 0,
  simulationInterval: null,
  predictions: { grasshopper: null, rice: null },
  pendingPyramidId: null, // 탭으로 피라미드에 놓을 카드(드래그가 안 되는 터치 기기용)
  pendingClassifyId: null // 분류 미션: 누른 카드(다음에 누른 상자로 들어감)
};

/* ── 유틸 ── */
const $ = s => document.querySelector(s);
const $$ = s => document.querySelectorAll(s);

/* ── 저장 / 불러오기 (키·모양 그대로: { missionsCompleted, placedNodes, edges }) ── */
const STORAGE_KEY = 'eco-web:v1';
const MISSION_IDS = { 1: ['m1_1', 'm1_2', 'm1_3'], 2: ['m2_1', 'm2_2'], 3: ['m3_1'] };
const ALL_MISSION_IDS = [...MISSION_IDS[1], ...MISSION_IDS[2], ...MISSION_IDS[3]];
const store = SimKit.store(STORAGE_KEY, {
  defaults: { missionsCompleted: {}, placedNodes: {}, edges: [] },
  validate: (raw) => {
    if (!raw || typeof raw !== 'object') return null;
    return {
      missionsCompleted: SimKit.clean.flags(raw.missionsCompleted, ALL_MISSION_IDS),
      placedNodes: cleanPlacedNodes(raw.placedNodes),
      edges: cleanEdges(raw.edges)
    };
  }
});
function saveState() {
  store.save({
    missionsCompleted: state.missionsCompleted,
    placedNodes: state.placedNodes,
    edges: state.edges
  });
}
function loadState() {
  const saved = store.load();
  state.missionsCompleted = SimKit.clean.flags(saved.missionsCompleted, ALL_MISSION_IDS);
  state.placedNodes = saved.placedNodes;
  state.edges = saved.edges;
}

/* 저장값·공유 링크에서 온 값 검사: 아는 생물 id와 올바른 먹이 관계만 남긴다 */
function cleanPlacedNodes(obj) {
  const out = {};
  if (!obj || typeof obj !== 'object') return out;
  Object.keys(obj).forEach(id => {
    const p = obj[id];
    if (!SPECIES_BY_ID[id] || !p) return;
    const x = Number(p.x), y = Number(p.y);
    if (isFinite(x) && isFinite(y)) out[id] = { x: Math.max(0, Math.min(4000, x)), y: Math.max(0, Math.min(4000, y)) };
  });
  return out;
}
function cleanEdges(arr) {
  if (!Array.isArray(arr)) return [];
  const seen = new Set();
  return arr.filter(e => {
    if (!Array.isArray(e) || e.length !== 2) return false;
    const key = `${e[0]}->${e[1]}`;
    if (!RELATION_MAP.has(key) || seen.has(key)) return false;
    seen.add(key);
    return true;
  }).map(e => [e[0], e[1]]);
}

/* ── 공유 링크 ── */
/* 예전 #share=<URI-JSON> 링크도 읽음. 받은 값은 cleanEdges·cleanPlacedNodes로 다시 검사 */
function parseShareLink() {
  const payload = SimKit.share.read({ version: 1 });
  if (payload && payload.edges) {
    state.edges = cleanEdges(payload.edges);
    state.placedNodes = cleanPlacedNodes(payload.placedNodes);
    state.mode = 1;
  }
}

/* ── 공용 조각: 화면·피드백·모드 탭·미션 컨트롤러(모드별 3개, 번호 상자는 함께 씀) ── */
const screens = SimKit.screens({ focus: true });
const fb = SimKit.feedback('#feedbackBox', { html: true, classes: { ok: 'ok', no: 'no' } });
let modeTabs = null;
const mcs = {};

/* ══════════════════════════════════════
   모드 / 미션 화면 전환 및 셋업
   ══════════════════════════════════════ */
function stopSimulation() {
  if (state.simulationInterval) {
    // 실험 인터벌은 모드 3 미션 타이머(mcs[3].every)로 걸려 미션·모드를 옮기면 자동으로 멈춘다
    if (mcs[3]) mcs[3].timers.clear(state.simulationInterval);
    state.simulationInterval = null;
  }
}

function selectScenario(key) {
  state.activeScenario = key;
  $$('.scenario-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.sc === key);
    b.setAttribute('aria-pressed', b.dataset.sc === key ? 'true' : 'false');
  });
}

/* 모드 바꾸기: 이전 모드 컨트롤러를 멈추고 새 모드의 1번 미션으로(지금 동작 유지) */
function switchMode(modeNum) {
  const newMode = parseInt(modeNum) || 1;
  if (mcs[state.mode] && state.mode !== newMode) mcs[state.mode].stop();
  state.mode = newMode;
  if (modeTabs) modeTabs.select(state.mode, { silent: true });
  mcs[state.mode].go(0); // → onEnter → buildModeView()
}

/* 미션 화면 짓기: 컨트롤러 onEnter에서만 부른다(번호 그리기·문구 숨김·타이머 정리는 컨트롤러가 함).
   성공 처리에서 다시 부르면 퀴즈·예측 선택이 지워지므로 부르지 말 것 */
function buildModeView() {
  stopSimulation();
  state.pendingPyramidId = null;
  state.pendingClassifyId = null;
  // 왼쪽 위 이름표를 지금 모드에 맞게
  $('#canvasBadgeNum').textContent = String(state.mode);
  $('#canvasBadgeLabel').textContent = { 1: '먹이그물 공방', 2: '생태 피라미드', 3: '평형 실험실' }[state.mode] || '';

  // 미션 및 컨트롤 세팅
  setupMissionUI();
  resetTemporaryModes();
  renderPalette();

  // 모드별 캔버스 컴포넌트 토글
  const placedCont = $('#placedNodesContainer');
  const classifyZones = $('#classifyZones');
  const pyramidZone = $('#pyramidZone');
  const scenarioZone = $('#scenarioZone');
  const canvasToolbar = $('#canvasToolbar');

  // 기본 청소
  placedCont.style.display = 'none';
  classifyZones.style.display = 'none';
  pyramidZone.style.display = 'none';
  scenarioZone.style.display = 'none';
  canvasToolbar.style.display = 'none';
  $('#canvasSvg').style.display = 'none';
  $('#predictionBox').style.display = 'none';
  $('#scenarioSelector').style.display = 'none';
  $('#paletteSection').style.display = 'flex';

  if (state.mode === 1) {
    placedCont.style.display = 'block';
    canvasToolbar.style.display = 'flex';
    $('#canvasSvg').style.display = 'block';
    
    // 미션 1-3일 때만 분류 상자 표시
    const curMission = getActiveMission();
    if (curMission && curMission.id === 'm1_3') {
      classifyZones.style.display = 'grid';
      canvasToolbar.style.display = 'none'; // 분류 미션 시 도구바 숨김
    }
    
    renderPlacedNodes();
    redrawConnections();
  } else if (state.mode === 2) {
    pyramidZone.style.display = 'flex';
    const curMission = getActiveMission();
    if (curMission && curMission.id === 'm2_2') {
      // 퀴즈 미션인 경우 피라미드를 숨기고 퀴즈 전용 박스를 노출
      pyramidZone.style.display = 'none';
      $('#paletteSection').style.display = 'none';
    }
    renderPyramidSlots();
  } else if (state.mode === 3) {
    scenarioZone.style.display = 'flex';
    $('#paletteSection').style.display = 'none';
    $('#scenarioSelector').style.display = 'block';
    
    const curMission = getActiveMission();
    if (curMission && curMission.id === 'm3_1') {
      $('#predictionBox').style.display = 'block';
      selectScenario('B'); // 미션은 '개구리 전멸' 시나리오로 채점한다
    }
    renderScenarioVisual();
  }
}

function getActiveMission() {
  const mList = MISSIONS['m' + state.mode];
  return mList ? mList[state.missionIdx] : null;
}

function setupMissionUI() {
  const mList = MISSIONS['m' + state.mode];
  if (!mList) return;

  const curMission = getActiveMission();
  if (curMission) {
    $('#missionDescription').innerHTML = curMission.desc;
    
    // 만약 피라미드 퀴즈라면 퀴즈 UI 주입
    if (curMission.id === 'm2_2') {
      $('#missionDescription').innerHTML += `
        <div class="m3-choices" role="group" aria-label="알맞은 설명 고르기">
          <button type="button" class="m3-choice" data-val="1" aria-pressed="false">1번</button>
          <button type="button" class="m3-choice" data-val="2" aria-pressed="false">2번</button>
          <button type="button" class="m3-choice" data-val="3" aria-pressed="false">3번</button>
        </div>
      `;
      $$('.m3-choice').forEach(b => {
        b.addEventListener('click', () => {
          $$('.m3-choice').forEach(btn => { btn.classList.remove('selected'); btn.setAttribute('aria-pressed', 'false'); });
          b.classList.add('selected');
          b.setAttribute('aria-pressed', 'true');
        });
      });
    }
  }

  // 다음 스크린 버튼 제어
  updateVerifyButtonText();
}

function updateVerifyButtonText() {
  const allMissionsDone = ALL_MISSION_IDS.every(id => state.missionsCompleted[id] === true);
  if (allMissionsDone) {
    $('#btnNextScreen').style.display = 'block';
  } else {
    $('#btnNextScreen').style.display = 'none';
  }
}

function resetTemporaryModes() {
  state.connectMode = false;
  state.eraserMode = false;
  state.activeConnectSource = null;
  setToolPressed();
}

function setToolPressed() {
  $('#btnConnectMode').classList.toggle('active', state.connectMode);
  $('#btnConnectMode').setAttribute('aria-pressed', state.connectMode ? 'true' : 'false');
  $('#btnEraserMode').classList.toggle('active', state.eraserMode);
  $('#btnEraserMode').setAttribute('aria-pressed', state.eraserMode ? 'true' : 'false');
}

/* ══════════════════════════════════════
   모드 1: 먹이그물 공방 구현 (드래그, 연결)
   ══════════════════════════════════════ */
function renderPalette() {
  const grid = $('#paletteGrid');
  grid.innerHTML = '';
  SPECIES.forEach(sp => {
    // 생산자, 분해자, 소비자에 따라 필터링 할 수도 있지만 팔레트에 모두 표시
    // 캔버스 배치 여부는 먹이그물(모드 1)에서만 의미가 있다. 피라미드에서는 언제든 꺼내 쓸 수 있음
    const isPlaced = state.mode === 1 && !!state.placedNodes[sp.id];
    
    // 미션 1-3 (분류 미션) 시, 캔버스에 없는 물건만 팔레트에 노출
    const picked = state.mode === 2 && state.pendingPyramidId === sp.id;
    const card = document.createElement('button');
    card.type = 'button';
    card.className = `palette-item ${isPlaced ? 'placed' : ''} ${picked ? 'picked' : ''}`;
    card.dataset.id = sp.id;
    card.innerHTML = `<span style="font-size:24px;" aria-hidden="true">${sp.emoji}</span><span>${sp.name}</span>`;
    if (state.mode === 2) card.setAttribute('aria-pressed', picked ? 'true' : 'false');
    else if (isPlaced) card.setAttribute('aria-label', `${sp.name} (판에 놓음)`);
    
    // 드래그 지원
    card.draggable = !isPlaced;
    card.addEventListener('dragstart', (e) => {
      e.dataTransfer.setData('text/plain', sp.id);
    });

    // 클릭 시 바로 배치하는 대체 수단도 함께 제공 (접근성)
    card.addEventListener('click', () => {
      if (state.mode === 2) {
        // 터치 기기용: 카드를 누른 뒤 피라미드 층을 누르면 그 층에 놓인다
        state.pendingPyramidId = state.pendingPyramidId === sp.id ? null : sp.id;
        renderPalette();
        focusPaletteItem(sp.id);
        if (state.pendingPyramidId) showToast(`${josa(sp.name, '을', '를')} 놓을 피라미드 층을 눌러 주세요.`);
        return;
      }
      if (!isPlaced) {
        placeNodeToCanvas(sp.id);
        focusPaletteItem(sp.id);
        showToast(`${josa(sp.name, '을', '를')} 판에 놓았어요.`);
      }
    });

    grid.appendChild(card);
  });
}

function focusPaletteItem(id) {
  const el = document.querySelector(`#paletteGrid .palette-item[data-id="${id}"]`);
  if (el) el.focus({ preventScroll: true });
}

// 캔버스에 노드 임의 배치 (클릭 배치 시)
function placeNodeToCanvas(id) {
  const view = $('#canvasViewport');
  const w = view.clientWidth;
  const h = view.clientHeight;
  const x = Math.max(20, Math.min(w - 100, Math.random() * (w - 120) + 10));
  const y = Math.max(80, Math.min(h - 120, Math.random() * (h - 180) + 70));
  state.placedNodes[id] = { x, y };
  renderPalette();
  renderPlacedNodes();
  saveState();
}

function renderPlacedNodes() {
  const container = $('#placedNodesContainer');
  // 다시 그려도 키보드 초점이 같은 카드에 남도록
  const ae = document.activeElement;
  const focusedId = ae && ae.classList && ae.classList.contains('node-card') && container.contains(ae) ? ae.dataset.id : null;
  container.innerHTML = '';

  const curMission = getActiveMission();
  const isClassifyMode = curMission && curMission.id === 'm1_3';

  // 빈 캔버스 안내 (카드가 하나도 없을 때만 표시)
  if (!isClassifyMode && Object.keys(state.placedNodes).length === 0) {
    const hint = document.createElement('div');
    hint.id = 'canvasEmptyHint';
    hint.style.cssText = 'position:absolute; left:50%; top:45%; transform:translate(-50%,-50%);'
      + 'width:min(70%,420px); padding:36px 28px; border:2px dashed var(--eco-accent);'
      + 'border-radius:20px; text-align:center; color:var(--fg-muted); pointer-events:none; opacity:0.75;';
    hint.innerHTML = '<div style="font-size:40px; margin-bottom:12px;">🌱</div>'
      + '<div style="font-size:15px; font-weight:700; line-height:1.6;">오른쪽 생물 카드를 이곳으로<br>끌어다 놓아 보세요</div>'
      + '<div style="font-size:14px; margin-top:8px;">카드를 놓은 뒤 <b>연결 모드</b>로 먹이 관계 화살표를 이어요</div>';
    container.appendChild(hint);
  }

  // 만약 분류 미션인데 placedNodes가 비어 있다면 초기화 (기본 배치)
  if (isClassifyMode && Object.keys(state.placedNodes).length === 0) {
    // 화면 상단에 벼, 메뚜기, 개구리, 매, 버섯 등을 드래그할 수 있게 팔레트 형식 대신 캔버스 탑에 배치
    const initialClassificationItems = ['rice', 'clover', 'grasshopper', 'rabbit', 'frog', 'hawk', 'mushroom'];
    initialClassificationItems.forEach((id, i) => {
      // 이미 분류 상자에 들어간 카드는 다시 만들지 않는다(중복 방지)
      if (document.querySelector(`.classify-box .node-card[data-id="${id}"]`)) return;
      state.placedNodes[id] = { x: 30 + i * 90, y: 80 };
    });
  }

  Object.entries(state.placedNodes).forEach(([id, pos]) => {
    const sp = SPECIES_BY_ID[id];
    const card = document.createElement('div');
    const isSel = state.activeConnectSource === id || state.pendingClassifyId === id;
    card.className = `node-card ${isSel ? 'selected' : ''}`;
    card.dataset.id = id;
    card.style.left = `${pos.x}px`;
    card.style.top = `${pos.y}px`;
    // 키보드: Tab으로 고르고 Enter(연결·분류), 방향키(옮기기)
    card.setAttribute('tabindex', '0');
    card.setAttribute('role', 'button');
    card.setAttribute('aria-label', `${sp.name} (${roleLabelOf(sp)})${isSel ? ', 골랐음' : ''}`);

    // 역할 색상 표시 도트
    let dotColor = 'var(--role-producer)';
    if (sp.role === 'consumer-1') dotColor = 'var(--role-consumer-1)';
    if (sp.role === 'consumer-2') dotColor = 'var(--role-consumer-2)';
    if (sp.role === 'consumer-3') dotColor = 'var(--role-consumer-3)';
    if (sp.role === 'decomposer') dotColor = 'var(--role-decomposer)';
    card.innerHTML = `
      <div class="node-role-dot" style="background:${dotColor}" aria-hidden="true"></div>
      <div class="node-emoji" aria-hidden="true">${sp.emoji}</div>
      <div class="node-name">${sp.name}</div>
    `;

    // Pointer 드래그 이벤트 바인딩 (조금만 움직이면 '누르기'로 본다)
    let isDragging = false;
    let moved = false;
    let startX, startY;
    let origX, origY;

    card.addEventListener('pointerdown', (e) => {
      if (state.connectMode) {
        // 연결 로직
        handleConnectTap(id);
        return;
      }
      if (state.eraserMode) {
        // 노드 제거는 하지 않고 노드 연결만 지움
        return;
      }

      isDragging = true;
      moved = false;
      card.setPointerCapture(e.pointerId);
      startX = e.clientX;
      startY = e.clientY;
      origX = parseInt(card.style.left) || 0;
      origY = parseInt(card.style.top) || 0;
    });

    card.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (!moved) {
        if (Math.hypot(dx, dy) < 6) return; // 아직 누르기
        moved = true;
        // 분류 상자 안의 카드를 끌기 시작하면 상자에서 꺼내 자유 영역으로 옮긴 뒤 계속 끌 수 있게 한다
        if (card.parentElement && card.parentElement.classList.contains('classify-box')) {
          const vr = viewport.getBoundingClientRect();
          const cr = card.getBoundingClientRect();
          origX = Math.max(0, cr.left - vr.left);
          origY = Math.max(0, cr.top - vr.top);
          card.style.position = '';
          card.style.left = `${origX}px`;
          card.style.top = `${origY}px`;
          $('#placedNodesContainer').appendChild(card);
          state.placedNodes[id] = { x: origX, y: origY };
        }
      }
      const view = $('#canvasViewport');
      const newX = Math.max(0, Math.min(view.clientWidth - 84, origX + dx));
      const newY = Math.max(0, Math.min(view.clientHeight - 106, origY + dy));
      
      card.style.left = `${newX}px`;
      card.style.top = `${newY}px`;
      state.placedNodes[id] = { x: newX, y: newY };
      
      // 실시간으로 연결 선 다시 그리기
      if (!isClassifyMode) {
        redrawConnections();
      }
    });

    card.addEventListener('pointerup', (e) => {
      if (!isDragging) return;
      isDragging = false;
      try { card.releasePointerCapture(e.pointerId); } catch (err) { /* 이미 해제됨 */ }
      if (!moved) {
        // 누르기(끌지 않음): 분류 미션에서는 카드 고르기 → 다음에 누른 상자로 들어감
        if (isClassifyMode) selectClassifyCard(id);
        return;
      }
      saveState();

      // 분류 미션일 때 박스 안으로 들어갔는지 판정
      if (isClassifyMode) {
        checkClassificationDrop(card);
      }
    });
    card.addEventListener('pointercancel', () => { isDragging = false; });
    // 상자 안 카드의 클릭이 상자 클릭(카드 넣기)으로 번지지 않게
    card.addEventListener('click', (e) => e.stopPropagation());

    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (state.connectMode) handleConnectTap(id);
        else if (isClassifyMode) selectClassifyCard(id);
        else if (state.eraserMode) showToast('선 지우기: Tab으로 지울 화살표를 고른 뒤 Enter를 눌러요.');
        else showToast('🔗 [연결 모드]를 켠 다음, 먹히는 생물 → 먹는 생물 순서로 카드를 눌러요.');
        return;
      }
      const step = e.shiftKey ? 40 : 10;
      const d = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] }[e.key];
      if (!d || card.parentElement !== container) return;
      e.preventDefault();
      const view = $('#canvasViewport');
      const p = state.placedNodes[id] || { x: 0, y: 0 };
      const nx = Math.max(0, Math.min(view.clientWidth - 84, p.x + d[0]));
      const ny = Math.max(0, Math.min(view.clientHeight - 106, p.y + d[1]));
      state.placedNodes[id] = { x: nx, y: ny };
      card.style.left = `${nx}px`;
      card.style.top = `${ny}px`;
      if (!isClassifyMode) redrawConnections();
      saveState();
    });

    container.appendChild(card);
  });
  if (focusedId) {
    const again = container.querySelector(`.node-card[data-id="${focusedId}"]`);
    if (again) again.focus({ preventScroll: true });
  }
}

/* ── 분류 미션: 누르기·키보드로 카드 옮기기 ── */
function selectClassifyCard(id) {
  state.pendingClassifyId = state.pendingClassifyId === id ? null : id;
  $$('#canvasViewport .node-card').forEach(c => {
    const on = c.dataset.id === state.pendingClassifyId;
    c.classList.toggle('selected', on);
    const sp = SPECIES_BY_ID[c.dataset.id];
    if (sp) c.setAttribute('aria-label', `${sp.name} (${roleLabelOf(sp)})${on ? ', 골랐음' : ''}`);
  });
  if (state.pendingClassifyId) showToast(`${josa(SPECIES_BY_ID[id].name, '을', '를')} 넣을 상자를 눌러 주세요.`);
}
function moveCardToClassifyBox(id, box) {
  const card = document.querySelector(`#canvasViewport .node-card[data-id="${id}"]`);
  if (!card || !box) return;
  box.appendChild(card);
  card.style.position = 'static';
  delete state.placedNodes[id];
  state.pendingClassifyId = null;
  card.classList.remove('selected');
  const sp = SPECIES_BY_ID[id];
  card.setAttribute('aria-label', `${sp.name} (${roleLabelOf(sp)})`);
  renderPalette();
  showToast(`${josa(sp.name, '을', '를')} ${box.getAttribute('aria-label') || '상자'}에 넣었어요.`);
}

// HTML5 드래그앤드롭 수신 (팔레트 ➔ 캔버스)
const viewport = $('#canvasViewport');
viewport.addEventListener('dragover', (e) => {
  e.preventDefault();
});
viewport.addEventListener('drop', (e) => {
  e.preventDefault();
  const id = e.dataTransfer.getData('text/plain');
  if (id && SPECIES_BY_ID[id] && !state.placedNodes[id]) {
    const rect = viewport.getBoundingClientRect();
    const x = Math.max(0, Math.min(rect.width - 84, e.clientX - rect.left - 42));
    const y = Math.max(0, Math.min(rect.height - 106, e.clientY - rect.top - 53));
    state.placedNodes[id] = { x, y };
    renderPalette();
    renderPlacedNodes();
    redrawConnections();
    saveState();
  }
});

/* ── 분류 상자 드롭 확인 ── */
function checkClassificationDrop(cardEl) {
  const rect = cardEl.getBoundingClientRect();
  const cardCenterX = rect.left + rect.width / 2;
  const cardCenterY = rect.top + rect.height / 2;

  const boxes = $$('.classify-box');
  let droppedBox = null;

  boxes.forEach(box => {
    const boxRect = box.getBoundingClientRect();
    if (
      cardCenterX >= boxRect.left && cardCenterX <= boxRect.right &&
      cardCenterY >= boxRect.top && cardCenterY <= boxRect.bottom
    ) {
      droppedBox = box;
    }
  });

  if (droppedBox) {
    // 해당 박스로 DOM 이동시킴
    // absolute 위치 대신 flex 자식으로 넣거나, 상자 안에 노드를 append
    droppedBox.appendChild(cardEl);
    cardEl.style.position = 'static'; // static으로 변경하여 박스 레이아웃 정렬
    // placedNodes에서 제거하여 일반 드래그 대상에서 제외하거나 좌표를 정량화
    delete state.placedNodes[cardEl.dataset.id];
  } else {
    // 캔버스 자유 영역으로 복귀
    if (!state.placedNodes[cardEl.dataset.id]) {
      // 만약 분류함에 들어갔다가 다시 나온 거라면
      const viewportRect = viewport.getBoundingClientRect();
      const x = Math.max(20, cardCenterX - viewportRect.left - 42);
      const y = Math.max(80, cardCenterY - viewportRect.top - 53);
      state.placedNodes[cardEl.dataset.id] = { x, y };
      renderPlacedNodes();
    }
  }
  renderPalette();
}

/* ── 연결 선 드로잉 및 처리 ── */
function handleConnectTap(id) {
  if (!state.activeConnectSource) {
    state.activeConnectSource = id;
    showToast('선택한 생물에서 먹이를 먹는 대상(포식자)을 클릭하세요.');
    renderPlacedNodes();
  } else {
    const source = state.activeConnectSource;
    state.activeConnectSource = null;
    renderPlacedNodes();

    if (source === id) return; // 자신과 연결 불가

    // 방향 확인: 먹힘(source) ➔ 먹음(id)
    // 에너지는 먹히는 것 -> 먹는 것
    const key = `${source}->${id}`;
    const reverseKey = `${id}->${source}`;

    // 반대 방향 연결 시도 필터
    if (RELATION_MAP.has(reverseKey)) {
      showToast('⚠️ 화살표 방향 오류! 에너지는 먹히는 생물 ➔ 먹는 생물로 흘러가므로 방향이 반대여야 합니다.', 'no');
      triggerNodeShake(id);
      return;
    }

    // 유효 관계 검사(아래)
    if (!RELATION_MAP.has(key)) {
      showToast(`⚠️ ${josa(SPECIES_BY_ID[source].name, '과', '와')} ${josa(SPECIES_BY_ID[id].name, '은', '는')} 직접 먹고 먹히는 관계가 아니에요.`, 'no');
      triggerNodeShake(id);
      return;
    }

    // 이미 존재 검사
    const alreadyExists = state.edges.some(e => e[0] === source && e[1] === id);
    if (alreadyExists) {
      showToast('이미 연결되어 있습니다.');
      return;
    }

    // 통과: 화살표 추가
    state.edges.push([source, id]);
    redrawConnections();
    saveState();
    showToast(`✓ ${SPECIES_BY_ID[source].name} ➔ ${SPECIES_BY_ID[id].name} 화살표를 이었어요.`);
  }
}

function triggerNodeShake(id) {
  const card = document.querySelector(`.node-card[data-id="${id}"]`);
  if (card) {
    card.classList.add('pyramid-shake');
    setTimeout(() => card.classList.remove('pyramid-shake'), 500);
  }
}

function redrawConnections() {
  const g = $('#svgConnections');
  g.innerHTML = '';

  state.edges.forEach(([fromId, toId], idx) => {
    const fromPos = state.placedNodes[fromId];
    const toPos = state.placedNodes[toId];

    if (!fromPos || !toPos) return;

    // 카드의 중심 좌표
    const x1 = fromPos.x + 42;
    const y1 = fromPos.y + 53;
    const x2 = toPos.x + 42;
    const y2 = toPos.y + 53;

    // 선 그리기
    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    line.setAttribute('x1', x1);
    line.setAttribute('y1', y1);
    line.setAttribute('x2', x2);
    line.setAttribute('y2', y2);
    line.setAttribute('stroke', 'var(--fg-muted)');
    line.setAttribute('stroke-width', '3');
    line.setAttribute('marker-end', 'url(#arrow)');
    line.style.pointerEvents = 'none';

    // 지우개 모드용 굵은 투명 선(손가락으로도 누르기 쉽게)
    const hit = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    hit.setAttribute('x1', x1);
    hit.setAttribute('y1', y1);
    hit.setAttribute('x2', x2);
    hit.setAttribute('y2', y2);
    hit.setAttribute('stroke', 'transparent');
    hit.setAttribute('stroke-width', '18');
    hit.setAttribute('class', 'edge-hit');
    hit.style.cursor = state.eraserMode ? 'pointer' : 'default';
    hit.style.pointerEvents = state.eraserMode ? 'stroke' : 'none';
    if (state.eraserMode) {
      // 키보드: 선 지우기 모드에서만 Tab으로 화살표를 고르고 Enter로 지움
      hit.setAttribute('tabindex', '0');
      hit.setAttribute('role', 'button');
      hit.setAttribute('aria-label', `${SPECIES_BY_ID[fromId].name} ➔ ${SPECIES_BY_ID[toId].name} 화살표 지우기`);
    }

    // 지우개 모드 지원
    const eraseThis = () => {
      if (!state.eraserMode) return;
      state.edges.splice(idx, 1);
      redrawConnections();
      saveState();
      showToast(`${SPECIES_BY_ID[fromId].name} ➔ ${SPECIES_BY_ID[toId].name} 화살표를 지웠어요.`);
    };
    hit.addEventListener('click', (e) => {
      e.stopPropagation();
      eraseThis();
    });
    hit.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      e.preventDefault();
      eraseThis();
      const nextHit = document.querySelector('#svgConnections .edge-hit[tabindex="0"]');
      (nextHit || $('#btnEraserMode')).focus();
    });

    g.appendChild(line);
    g.appendChild(hit);
  });
}

/* ══════════════════════════════════════
   모드 2: 피라미드 쌓기 구현
   ══════════════════════════════════════ */
function renderPyramidSlots() {
  const tiers = $$('.pyramid-tier-slots');
  tiers.forEach(tier => {
    tier.innerHTML = '';
    if (tier.dataset.bound) return; // 리스너는 한 번만 (모드를 바꿀 때마다 중복 등록되던 문제)
    tier.dataset.bound = '1';

    // 탭 대체 조작: 팔레트에서 고른 카드를 이 층에 놓기
    tier.parentElement.addEventListener('click', () => {
      if (!state.pendingPyramidId) {
        showToast('먼저 오른쪽 팔레트에서 생물 카드를 하나 누른 다음 층을 눌러 주세요.');
        return;
      }
      const id = state.pendingPyramidId;
      state.pendingPyramidId = null;
      dropCardToPyramidTier(id, parseInt(tier.dataset.level));
      renderPalette();
    });
    
    // HTML5 dragover/drop 바인딩
    tier.addEventListener('dragover', (e) => {
      e.preventDefault();
      tier.parentElement.classList.add('drag-over');
    });
    tier.addEventListener('dragleave', () => {
      tier.parentElement.classList.remove('drag-over');
    });
    tier.addEventListener('drop', (e) => {
      e.preventDefault();
      tier.parentElement.classList.remove('drag-over');
      const id = e.dataTransfer.getData('text/plain');
      if (id && SPECIES_BY_ID[id]) {
        dropCardToPyramidTier(id, parseInt(tier.dataset.level));
      }
    });
  });

  // 배치 완료된 카드들 렌더링
  // 피라미드에 배치된 카드 목록은 state.pyramid.layerOf 형태로 동적 확인
  // 여기서는 영양 등급 분류에 맞게 카드를 렌더링
  SPECIES.forEach(sp => {
    // 퀴즈/피라미드 미션 진행 생물만 (벼, 토끼, 개구리, 매)
    const allowed = ['rice', 'rabbit', 'frog', 'hawk'];
    if (!allowed.includes(sp.id)) return;

    // 만약 피라미드에 들어가지 않았다면 팔레트에만 남아있게 됨
    // tier DOM을 찾아서 자식으로 넣어줌
  });
}

function dropCardToPyramidTier(id, targetLevel) {
  const sp = SPECIES_BY_ID[id];
  const container = document.querySelector(`.pyramid-tier-slots[data-level="${targetLevel}"]`);
  
  // 이미 존재하는지 확인
  const existing = container.querySelector(`.node-card[data-id="${id}"]`);
  if (existing) return;
  // 같은 생물은 피라미드에 한 곳에만 (다른 층에 있던 카드는 옮긴다)
  $$(`.pyramid-tier-slots .node-card[data-id="${id}"]`).forEach(c => c.remove());

  // 오개념 경고 체크: 위 층에 아래 층보다 많은 '종류'(카드 수)가 쌓일 때.
  // 이 판은 층마다 놓은 생물 종류 수만 센다(개체 수·에너지양은 비교하지 않음).
  // 배치 후의 각 층 카드 수 계산
  const tempCounts = [0, 0, 0, 0];
  const tiers = $$('.pyramid-tier-slots');
  tiers.forEach(t => {
    const lvl = parseInt(t.dataset.level);
    let count = t.querySelectorAll('.node-card').length;
    if (lvl === targetLevel) count++; // 가상 증가
    tempCounts[lvl] = count;
  });

  // 위 층의 종류 수가 바로 아래 층보다 많으면 경고
  let violates = false;
  for (let i = 0; i < 3; i++) {
    if (tempCounts[i] > 0 && tempCounts[i+1] > tempCounts[i]) {
      violates = true;
      break;
    }
  }

  if (violates) {
    showToast('⚠️ 위 층에 놓은 생물 종류가 아래 층보다 많아요! 여기서는 층마다 놓은 생물의 종류 수를 비교해요. 생태 피라미드는 보통 위로 갈수록 좁아져요.', 'no');
    // 흔들림 연출
    const py = $('#pyramidContainer');
    py.classList.add('pyramid-shake');
    setTimeout(() => py.classList.remove('pyramid-shake'), 500);
  }

  // 카드 DOM 생성 후 티어에 주입 (버튼: 누르면 빼기)
  const card = document.createElement('button');
  card.type = 'button';
  card.className = 'node-card';
  card.dataset.id = id;
  card.draggable = true;
  card.setAttribute('aria-label', `${sp.name} 피라미드에서 빼기`);
  card.addEventListener('dragstart', (e) => {
    e.dataTransfer.setData('text/plain', id);
    // 드래그 시 티어에서 일단 뗌
    setTimeout(() => card.remove(), 0);
  });

  // 피라미드에 놓인 카드를 누르면 빼낼 수 있다(드래그가 안 되는 기기용)
  card.title = '누르면 피라미드에서 빼요';
  card.addEventListener('click', (e) => {
    if (state.pendingPyramidId) return; // 다른 카드를 놓는 중이면 층 클릭으로 처리(전파 유지)
    e.stopPropagation();
    card.remove();
    showToast(`${josa(sp.name, '을', '를')} 피라미드에서 뺐어요.`);
  });

  card.innerHTML = `
    <div class="node-emoji" aria-hidden="true">${sp.emoji}</div>
    <div class="node-name">${sp.name}</div>
  `;
  container.appendChild(card);
  const tierEl = container.parentElement;
  showToast(`${josa(sp.name, '을', '를')} ${tierEl && tierEl.getAttribute('aria-label') || '층'}에 놓았어요.`);
}

/* ══════════════════════════════════════
   모드 3: 평형 시뮬레이션 구현 (예측 ➔ 확인)
   ══════════════════════════════════════ */
function renderScenarioVisual() {
  const grid = $('#scGrid');
  grid.innerHTML = '';
  
  // 시뮬레이션 대표 4종 (벼, 메뚜기, 개구리, 매)
  const list = [
    { id: 'rice', name: '벼', emoji: '🌾', role: '생산자' },
    { id: 'grasshopper', name: '메뚜기', emoji: '🦗', role: '1차 소비자' },
    { id: 'frog', name: '개구리', emoji: '🐸', role: '2차 소비자' },
    { id: 'hawk', name: '매', emoji: '🦅', role: '최종 소비자' }
  ];

  list.forEach(sp => {
    const card = document.createElement('div');
    card.className = 'sc-card';
    card.id = `scCard_${sp.id}`;
    card.innerHTML = `
      <div class="sc-emoji">${sp.emoji}</div>
      <div class="sc-info">
        <div class="sc-name">${sp.name}</div>
        <div class="sc-role">${sp.role}</div>
      </div>
      <div class="sc-delta-badge" id="scBadge_${sp.id}" style="display:none;"></div>
    `;
    grid.appendChild(card);
  });
}

function startScenarioSimulation() {
  const scKey = state.activeScenario;
  const sc = SCENARIOS[scKey];
  if (!sc) return;

  // 인터벌 리셋
  stopSimulation();
  state.simulationStep = 0;

  // 피드백 초기화
  showFeedback('👀 실험 관찰 중...', 'ok');

  runSimulationStep();
  // 미션에 묶인 인터벌: 미션·모드를 옮기면 자동으로 멈춘다
  state.simulationInterval = mcs[3].every(() => {
    state.simulationStep++;
    if (state.simulationStep >= sc.steps.length) {
      stopSimulation();
      finishScenarioSimulation();
    } else {
      runSimulationStep();
    }
  }, 4500);
}

function runSimulationStep() {
  const scKey = state.activeScenario;
  const sc = SCENARIOS[scKey];
  const step = sc.steps[state.simulationStep];

  // 지문 표시
  showFeedback(`<strong>[단계 ${state.simulationStep + 1}]</strong> ${step.text}`, 'ok');

  // 개체 수 증감 배지 연출
  Object.entries(step.deltas).forEach(([spId, delta]) => {
    const card = $(`#scCard_${spId}`);
    const badge = $(`#scBadge_${spId}`);
    if (!card || !badge) return;

    card.className = 'sc-card';
    badge.style.display = 'none';

    if (delta === 'up') {
      card.classList.add('delta-up');
      badge.style.display = 'flex';
      badge.className = 'sc-delta-badge up';
      badge.textContent = '▲';
    } else if (delta === 'down') {
      card.classList.add('delta-down');
      badge.style.display = 'flex';
      badge.className = 'sc-delta-badge down';
      badge.textContent = '▼';
    } else if (delta === 'flat') {
      badge.style.display = 'flex';
      badge.className = 'sc-delta-badge';
      badge.style.background = 'var(--eco-accent)';
      badge.textContent = '✓'; // 평형 회복 표시
    }
  });
}

function finishScenarioSimulation() {
  const curMission = getActiveMission();
  if (curMission && curMission.id === 'm3_1' && state.activeScenario !== 'B') {
    showFeedback('🍀 실험 관찰 완료! 미션 채점은 <strong>🐸 개구리 전멸 시나리오</strong>로 실험했을 때만 해요. 시나리오를 바꿔 다시 실험해 보세요.', 'no');
  } else if (curMission && curMission.id === 'm3_1') {
    // 미션 완료 판정
    // 사용자가 메뚜기(up), 벼(down) 예측했는지 비교
    const grassVal = document.querySelector('.prediction-btns[data-sp="grasshopper"] .pred-btn.active')?.dataset.val;
    const riceVal = document.querySelector('.prediction-btns[data-sp="rice"] .pred-btn.active')?.dataset.val;

    if (grassVal === 'up' && riceVal === 'down') {
      // 완료 기록·번호·저장은 컨트롤러가(onChange). setupMissionUI는 부르지 않음(예측 선택 유지)
      mcs[3].complete({ message: '🎉 정답입니다! 예측이 정확히 맞았어요. 개구리가 사라지면 메뚜기가 늘어나고 결국 벼가 줄어들게 됩니다. 이후 시간이 흐르며 생태계는 다시 균형을 찾으려 조율됩니다.' });
    } else {
      mcs[3].fail('❌ 예측 결과가 빗나갔어요. 개구리(천적)가 사라지면 메뚜기(먹이)는 늘어나고(▲), 메뚜기가 많아져 벼는 줄어들게(▼) 됩니다. 다시 예측하고 도전해 보세요!');
    }
  } else {
    showFeedback('🍀 실험 관찰 완료! 생물이 일시적으로 증감해도 결국 시간이 흐르며 평형(균형) 상태로 안정화됩니다.', 'ok');
  }
}

/* ══════════════════════════════════════
   피드백 및 결과 관리
   ══════════════════════════════════════ */
/* 문구는 앱이 직접 쓴 고정 문구만(html). 표시·aria-live는 SimKit.feedback */
function showFeedback(text, type = 'ok') { fb.show(type, text); }
function hideFeedback() { fb.hide(); }

function verifyCurrentMission() {
  const curMission = getActiveMission();
  if (!curMission) return;

  if (state.mode === 1) {
    const isOk = curMission.verify(state.placedNodes, state.edges);
    if (isOk) {
      mcs[1].complete({ message: '🎉 미션 성공! 완벽하게 생물들의 먹고 먹히는 관계를 파악하고 연결했어요.' });
    } else {
      mcs[1].fail('❌ 아직 조건에 맞지 않습니다. 화살표 방향(먹히는 생물 ➔ 먹는 생물)과 관계가 제대로 이어졌는지 다시 한번 확인해 보세요.');
    }
  } else if (state.mode === 2) {
    const isOk = curMission.verify();
    if (isOk) {
      mcs[2].complete({ message: '🎉 미션 성공! 영양 단계를 올바르게 배치하여 생태 피라미드를 정교하게 쌓았습니다.' });
    } else {
      mcs[2].fail('❌ 분류가 잘못되었거나 문제를 풀지 않았습니다. 아래 단계가 가장 많고 위로 갈수록 좁아지는 생태피라미드의 구조에 맞게 다시 배치하세요.');
    }
  } else if (state.mode === 3) {
    // 평형 시나리오는 실험 재생 후에 자동 판정
    if (curMission.id === 'm3_1') {
      const g = $('.prediction-btns[data-sp="grasshopper"] .pred-btn.active');
      const r = $('.prediction-btns[data-sp="rice"] .pred-btn.active');
      if (!g || !r) {
        showFeedback('먼저 메뚜기와 벼가 어떻게 변할지 ▲/▼/― 중에서 골라 예측해 주세요.', 'no');
        return;
      }
    }
    startScenarioSimulation();
  }
}

function showResultScreen() {
  stopSimulation();
  showScreen('screenResult');
  const score = ALL_MISSION_IDS.filter(id => state.missionsCompleted[id] === true).length;
  SimKit.stars.render('#resultStars', SimKit.stars.grade(score, [1, 4, 6]));
  let summary = `<strong>생태계 탐험 완료 보고서</strong><br><br>`;
  summary += `① 먹이그물 사슬 잇기: ${state.missionsCompleted.m1_1 ? '성공 ✓' : '미완료'}<br>`;
  summary += `② 참새의 먹이그물 완성: ${state.missionsCompleted.m1_2 ? '성공 ✓' : '미완료'}<br>`;
  summary += `③ 생산자·소비자 분류: ${state.missionsCompleted.m1_3 ? '성공 ✓' : '미완료'}<br>`;
  summary += `④ 생태 피라미드 완공: ${state.missionsCompleted.m2_1 ? '성공 ✓' : '미완료'}<br>`;
  summary += `⑤ 피라미드 퀴즈 해결: ${state.missionsCompleted.m2_2 ? '성공 ✓' : '미완료'}<br>`;
  summary += `⑥ 평형 연쇄 변화 예측: ${state.missionsCompleted.m3_1 ? '성공 ✓' : '미완료'}<br><br>`;
  summary += `숲속 생태계는 그물망처럼 얽혀 있어 <strong>어느 한 생물만 변해도 모두 영향을 받으며</strong>, 결국 시간이 지나면 <strong>다시 스스로 평형(균형)</strong>을 회복한다는 위대한 법칙을 배웠습니다!`;

  $('#resultSummary').innerHTML = summary;
}

/* ── 화면 전환 ── */
function showScreen(id) {
  if (id !== 'screenExplore' && mcs[state.mode]) mcs[state.mode].stop();
  screens.show(id);
}

/* ══════════════════════════════════════
   초기화 및 이벤트 연결
   ══════════════════════════════════════ */
function init() {
  loadState();
  parseShareLink();

  // 모드별 미션 컨트롤러 3개. 진행 기록은 한 객체(state.missionsCompleted)를 함께 쓴다.
  // 성공해도 자동 이동 없음(지금 동작 유지). 번호 상자 #missionNav는 지금 모드의 컨트롤러가 그린다.
  [1, 2, 3].forEach(mode => {
    mcs[mode] = SimKit.missions({
      ids: MISSION_IDS[mode],
      format: 'flags',
      progress: state.missionsCompleted,
      nav: '#missionNav',
      feedback: fb,
      onEnter: (i) => { state.missionIdx = i; buildModeView(); },
      onChange: (p) => { Object.assign(state.missionsCompleted, p); saveState(); updateVerifyButtonText(); }
    });
  });

  // 분류 상자: 고른 카드를 넣기(누르기·키보드 대체 조작)
  $$('.classify-box').forEach(box => {
    box.addEventListener('click', () => {
      if (!state.pendingClassifyId) {
        showToast('먼저 카드를 하나 누른 다음 상자를 눌러 주세요.');
        return;
      }
      moveCardToClassifyBox(state.pendingClassifyId, box);
    });
  });

  // 시작 버튼
  $('#btnStart').addEventListener('click', () => {
    showScreen('screenExplore');
    switchMode(1); // 먹이그물부터 시작
  });

  // 모드 탭 이동 (모드를 옮기면 컨트롤러가 진행 중인 실험 타이머도 멈춘다)
  modeTabs = SimKit.tabs('.mode-tab', { attr: 'mode', initial: '1', onSelect: (v) => switchMode(v) });

  // 연결 / 지우개 / 초기화 도구
  $('#btnConnectMode').addEventListener('click', () => {
    state.eraserMode = false;
    state.connectMode = !state.connectMode;
    state.activeConnectSource = null;
    setToolPressed();
    renderPlacedNodes();
    redrawConnections();
    if (state.connectMode) showToast('🔗 먹히는 생물 → 먹는 생물 순서로 카드를 눌러 화살표를 이어요.');
  });
  $('#btnEraserMode').addEventListener('click', () => {
    state.connectMode = false;
    state.eraserMode = !state.eraserMode;
    state.activeConnectSource = null;
    setToolPressed();
    renderPlacedNodes();
    redrawConnections();
    if (state.eraserMode) showToast('✂️ 지울 화살표를 눌러요. (키보드: Tab으로 고르고 Enter)');
  });
  $('#btnClearCanvas').addEventListener('click', () => {
    if (confirm('캔버스를 처음 상태로 초기화할까요?')) {
      state.placedNodes = {};
      state.edges = [];
      $$('.classify-box .node-card').forEach(c => c.remove());
      renderPalette();
      renderPlacedNodes();
      redrawConnections();
      saveState();
    }
  });

  // 정답 검사
  $('#btnVerify').addEventListener('click', verifyCurrentMission);

  // 결과 화면 이동
  $('#btnNextScreen').addEventListener('click', showResultScreen);

  // 다시 도전
  $('#btnRetry').addEventListener('click', () => {
    [1, 2, 3].forEach(mode => mcs[mode].reset()); // onChange → missionsCompleted 초기화·저장
    showScreen('screenExplore');
    switchMode(1);
  });
  $('#btnBackToHub').addEventListener('click', () => {
    showScreen('screenExplore');
    switchMode(1);
  });

  // 시나리오 버튼 바인딩
  $$('.scenario-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      stopSimulation(); // 실험 도중 시나리오를 바꾸면 이전 실험을 멈춘다
      hideFeedback();
      selectScenario(btn.dataset.sc);
      renderScenarioVisual();
    });
  });

  // 예측 선택 버튼 바인딩
  $$('.prediction-row').forEach(row => {
    const sp = row.querySelector('.prediction-btns').dataset.sp;
    row.querySelectorAll('.pred-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        row.querySelectorAll('.pred-btn').forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        state.predictions[sp] = btn.dataset.val;
      });
    });
  });

  // 셸 공유 버튼 → 내 먹이그물 링크. 받는 쪽은 parseShareLink(cleanEdges·cleanPlacedNodes)
  SimKit.share.bind(() => (state.edges.length || Object.keys(state.placedNodes).length
    ? { v: 1, edges: state.edges, placedNodes: state.placedNodes } : null), {
    title: '생태계 탐험대 — 내가 만든 먹이그물',
    emptyMessage: '먹이그물 판에 생물 카드를 놓은 다음 공유해 보세요.'
  });
}

/* ── 토스트 (공용 SimKit.toast → VUI.toast, 어디서나 호출 가능) ── */
function showToast(msg, type) { SimKit.toast(msg, type === 'no' ? 'error' : type); } // 'no' = 빨간 오류 토스트

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}

})();
</script>



</AppLayout>
