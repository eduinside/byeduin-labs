<script is:inline="">
/* ================================================================
   생태계 탐험대 — eco-web
   순수 정적 SPA · localStorage만 사용 · 외부 의존성 0
   ================================================================ */
(function() {
'use strict';

/* ── 12종 생물 데이터베이스 ── */
const SPECIES = [
  { id: 'rice', name: '벼', emoji: '🌾', role: 'producer', level: 0 },
  { id: 'clover', name: '토끼풀', emoji: '☘️', role: 'producer', level: 0 },
  { id: 'grasshopper', name: '메뚜기', emoji: '🦗', role: 'consumer-1', level: 1 },
  { id: 'rabbit', name: '토끼', emoji: '🐇', role: 'consumer-1', level: 1 },
  { id: 'squirrel', name: '다람쥐', emoji: '🐿️', role: 'consumer-1', level: 1 },
  { id: 'frog', name: '개구리', emoji: '🐸', role: 'consumer-2', level: 2 },
  // 참새는 벼(생산자)도 먹고 메뚜기(1차 소비자)도 먹으므로 1차·2차 소비자 둘 다 될 수 있다
  { id: 'sparrow', name: '참새', emoji: '🐦', role: 'consumer-2', level: 2, altRoles: ['consumer-1'], altLevels: [1] },
  // 뱀은 2차 소비자(개구리·참새)를 먹는 3차 소비자지만, 매·여우에게 먹히므로 최종 소비자는 아니다
  { id: 'snake', name: '뱀', emoji: '🐍', role: 'consumer-3', level: 3, roleLabel: '3차 소비자' },
  // 매·여우는 1차 소비자(토끼·다람쥐)와 2차·3차 소비자를 모두 먹는 먹이그물 맨 위 생물 → '최종 소비자'로 부른다
  // (초등 과학 생태계 단원: 생산자 / 1차·2차·최종 소비자 / 분해자)
  { id: 'fox', name: '여우', emoji: '🦊', role: 'consumer-3', level: 3 },
  { id: 'hawk', name: '매', emoji: '🦅', role: 'consumer-3', level: 3 },
  { id: 'mushroom', name: '버섯', emoji: '🍄', role: 'decomposer', level: -1 },
  { id: 'mold', name: '곰팡이', emoji: '🦠', role: 'decomposer', level: -1 },
];
const SPECIES_BY_ID = Object.fromEntries(SPECIES.map(s => [s.id, s]));
const roleOk = (sp, role) => sp.role === role || (sp.altRoles || []).includes(role);
const ROLE_LABELS = { producer: '생산자', 'consumer-1': '1차 소비자', 'consumer-2': '2차 소비자', 'consumer-3': '최종 소비자', decomposer: '분해자' };
const roleLabelOf = sp => sp.roleLabel || ROLE_LABELS[sp.role] || '';
const levelOk = (sp, level) => sp.level === level || (sp.altLevels || []).includes(level);

/* 받침 유무에 따라 조사 선택: josa('뱀','과','와') → '뱀과' (SimKit.josa) */
function josa(word, withBatchim, withoutBatchim) {
  return SimKit.josa(word, withBatchim + '/' + withoutBatchim);
}

// 올바른 먹고 먹히는 방향성 간선 정의 (preyId ➔ predatorId)
const VALID_RELATIONS = [
  ['rice', 'grasshopper'],
  ['rice', 'sparrow'],
  ['rice', 'rabbit'],
  ['clover', 'grasshopper'],
  ['clover', 'rabbit'],
  ['clover', 'squirrel'],
  ['grasshopper', 'frog'],
  ['grasshopper', 'sparrow'],
  ['squirrel', 'fox'],
  ['squirrel', 'hawk'],
  ['rabbit', 'fox'],
  ['rabbit', 'hawk'],
  ['frog', 'snake'],
  ['frog', 'hawk'],
  ['sparrow', 'snake'],
  ['sparrow', 'hawk'],
  ['snake', 'hawk'],
  ['snake', 'fox'],
  // 분해자 연결 (모든 생물 ➔ 버섯 / 곰팡이)
  ['rice', 'mushroom'], ['rice', 'mold'],
  ['clover', 'mushroom'], ['clover', 'mold'],
  ['grasshopper', 'mushroom'], ['grasshopper', 'mold'],
  ['rabbit', 'mushroom'], ['rabbit', 'mold'],
  ['squirrel', 'mushroom'], ['squirrel', 'mold'],
  ['frog', 'mushroom'], ['frog', 'mold'],
  ['sparrow', 'mushroom'], ['sparrow', 'mold'],
  ['snake', 'mushroom'], ['snake', 'mold'],
  ['fox', 'mushroom'], ['fox', 'mold'],
  ['hawk', 'mushroom'], ['hawk', 'mold'],
];

// 관계 매핑 해시
const RELATION_MAP = new Set(VALID_RELATIONS.map(r => `${r[0]}->${r[1]}`));

/* ── 미션 리스트 정의 ── */
const MISSIONS = {
  // 모드 1 미션
  m1: [
    {
      id: 'm1_1', title: '먹이사슬 완성',
      desc: '풀(토끼풀)에서 시작해서 1차, 2차 소비자를 거쳐 최종 소비자(매)로 끝나는 일직선 먹이사슬 하나를 올바른 화살표 방향으로 완성하세요.',
      verify: (placed, edges) => {
        // 토끼풀(clover) -> (토끼/메뚜기/다람쥐) -> (여우/매/개구리/참새/뱀) -> 매(hawk) 형태의 올바른 체인이 있는지 확인
        // DFS로 clover에서 hawk까지 연결 유효성 탐색
        const adj = {};
        edges.forEach(([u, v]) => {
          if (!adj[u]) adj[u] = [];
          adj[u].push(v);
        });
        const visited = new Set();
        let found = false;
        function dfs(node, path) {
          if (node === 'hawk') {
            if (path.length >= 4) { // clover, 1차, 2차(또는 3차), hawk 형태 (길이 4 이상)
              found = true;
            }
            return;
          }
          if (visited.has(node)) return;
          visited.add(node);
          const nexts = adj[node] || [];
          nexts.forEach(nxt => {
            dfs(nxt, [...path, nxt]);
          });
          visited.delete(node);
        }
        dfs('clover', ['clover']);
        return found;
      }
    },
    {
      id: 'm1_2', title: '참새의 먹이그물',
      desc: '참새(🐦)를 중심으로 벼/메뚜기와 참새, 참새와 매/뱀 사이의 모든 먹고 먹히는 화살표 관계(벼➔참새, 메뚜기➔참새, 참새➔뱀, 참새➔매)를 완성하세요.',
      verify: (placed, edges) => {
        const edgeSet = new Set(edges.map(e => `${e[0]}->${e[1]}`));
        const required = ['rice->sparrow', 'grasshopper->sparrow', 'sparrow->snake', 'sparrow->hawk'];
        return required.every(r => edgeSet.has(r));
      }
    },
    {
      id: 'm1_3', title: '역할에 맞게 분류하기',
      desc: '무대의 생물 카드를 역할에 맞게 5개 분류 상자(생산자, 1차·2차·최종 소비자, 분해자)에 넣어 보세요. 상자마다 1종 이상 넣어야 해요.<span class="hint">카드를 상자로 끌어 놓거나, 카드를 누른 다음 상자를 눌러요. 잘못 넣은 카드는 다시 눌러 다른 상자로 옮겨요. (먹이그물 판은 그대로 남아 있어요)</span>',
      verify: (placed, edges) => {
        // 각 상자별 드롭된 노드 체크
        const boxes = document.querySelectorAll('.classify-box');
        let allCorrect = true;
        let count = 0;
        boxes.forEach(box => {
