        return allCorrect && count >= 5;
      }
    }
  ],
  // 모드 2 미션
  m2: [
    {
      id: 'm2_1', title: '생태 피라미드 완성',
      desc: '벼, 토끼, 개구리, 매를 생태 피라미드의 알맞은 단계(생산자 ➔ 1차 ➔ 2차 ➔ 최종 소비자)에 쌓아 완성하세요.<span class="hint">조작판의 카드를 층으로 끌어 놓거나, 카드를 누른 다음 층을 눌러요.</span>',
      verify: (placed, edges) => {
        // 벼·토끼·개구리·매가 모두 알맞은 층에 있고, 잘못 놓인 카드가 없어야 성공
