---
import AppLayout from '../../../layouts/AppLayout.astro';
---
<AppLayout 
  title="파일 최적화 도구 — eduin VIVES"
  description="스캔 이미지 자동 보정, 대용량 PPTX 이미지 최적화. 파일 크기를 획기적으로 줄이세요."
  image="https://eduin.info/og-images/file-tools.png"
  bodyShell="column"
  bodyWidth="medium"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="./styles.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js" is:inline=""></script>
  <script src="https://cdn.jsdelivr.net/npm/utif@3.1.0/UTIF.js" is:inline=""></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" is:inline=""></script>
  <script src="https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/dist/pdf-lib.min.js" is:inline=""></script>
  <script is:inline="">
    if (window['pdfjsLib']) {
      pdfjsLib.GlobalWorkerOptions.workerSrc =
        'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }
  </script>
  <link rel="canonical" href="https://eduin.info/apps/file-tools/">
  <script type="application/ld+json" is:inline="">{"@context":"https://schema.org","@type":"WebApplication","name":"파일 최적화 도구","description":"스캔 이미지 자동 보정, 대용량 PPTX 이미지 최적화. 파일 크기를 획기적으로 줄이세요.","url":"https://eduin.info/apps/file-tools/","applicationCategory":"EducationApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"KRW"},"isPartOf":{"@type":"WebSite","name":"eduin VIVES","url":"https://eduin.info"}}</script>
  </Fragment>




<div class="wrap">
  <div class="app-header">
    <div class="app-badge">◆ 업무경감</div>
    <h1 class="app-title">
  <div class="card-emoji sub-edu-work" style="margin-bottom: 0; transform: scale(1.0);">
        <i data-lucide="file-cog"></i>
      </div>
  <span>파일 <span>최적화 도구</span></span>
</h1>
    <p class="app-desc">스캔 이미지 및 대용량 PPTX 이미지 최적화 — 모두 브라우저 내에서 처리됩니다</p>
  </div>

  <div class="file-card">
    <div class="tabs">
      <button class="tab-btn active" data-tab="scan" onclick="switchTab('scan')">📄 이미지 최적화</button>
      <button class="tab-btn" data-tab="pptx" onclick="switchTab('pptx')">🗜️ PPTX 압축</button>
    </div>

    <div class="card-body">
      <!-- ─────────────── Tab 1: 스캔 최적화 ─────────────── -->
      <section class="panel active" id="panel-scan">
        <div class="dropzone" id="scanDrop">
          <div class="dropzone-icon">📥</div>
          <div class="dropzone-label">TIFF / PDF / JPG / PNG 파일을 끌어다 놓거나 클릭</div>
          <div class="dropzone-hint">.tif, .tiff, .pdf, .jpg, .jpeg, .png · 다중 선택 가능</div>
          <input type="file" id="scanInput" accept=".tif,.tiff,.pdf,.jpg,.jpeg,.png,application/pdf,image/tiff,image/jpeg,image/png" multiple="" style="display:none">
        </div>
        <div class="file-list" id="scanFileList"></div>

        <div class="options-grid" id="scanOptionsGrid" style="display:none">
          <div class="opt-field" style="grid-column: 1 / -1;">
            <label>출력 형식</label>
            <div class="toggle-group" id="scanFormatToggle">
              <button data-fmt="pdf" class="active">PDF</button>
              <button data-fmt="jpg">JPG</button>
              <button data-fmt="png">PNG</button>
            </div>
          </div>
          <div class="opt-field" style="grid-column: 1 / -1;">
            <label>목표 용량 (MB)</label>
            <div class="range-row">
              <input type="range" id="scanTargetMB" min="0.1" max="10" step="0.1" value="1.0">
              <span class="range-val" id="scanTargetMBVal">1.0</span>
            </div>
            <div style="font-size:0.75rem; color:var(--fg-muted); margin-top:0.4rem;">
              자동으로 품질과 가로폭이 조절됩니다
            </div>
          </div>
        </div>

        <div class="estimate" id="scanEstimate" style="display:none"></div>

        <div class="action-row">
          <button class="action-btn" id="scanRunBtn" onclick="runScan()" disabled="">변환 후 다운로드</button>
          <button class="action-btn secondary" onclick="clearScan()">초기화</button>
        </div>

        <div class="progress" id="scanProgress" style="display:none">
          <div class="progress-msg" id="scanProgressMsg">처리 중…</div>
          <div class="progress-bar"><div class="progress-bar-fill" id="scanProgressFill"></div></div>
        </div>

        <div class="result" id="scanResult" style="display:none"></div>
      </section>

      <!-- ─────────────── Tab 2: PPTX 압축 ─────────────── -->
      <section class="panel" id="panel-pptx">
        <div class="dropzone" id="pptxDrop">
          <div class="dropzone-icon">📥</div>
          <div class="dropzone-label">PPTX 파일을 끌어다 놓거나 클릭</div>
          <div class="dropzone-hint">.pptx · 단일 파일</div>
          <input type="file" id="pptxInput" accept=".pptx,application/vnd.openxmlformats-officedocument.presentationml.presentation" style="display:none">
        </div>
        <div class="file-list" id="pptxFileList"></div>

        <div class="options-grid" id="pptxOptionsGrid" style="display:none">
          <div class="opt-field" style="grid-column: 1 / -1;">
            <label>목표 용량 (MB)</label>
            <div class="range-row">
              <input type="range" id="pptxTargetMB" min="0.5" max="10" step="0.1" value="3">
              <span class="range-val" id="pptxTargetMBVal">3.0</span>
            </div>
            <div style="font-size:0.75rem; color:var(--fg-muted); margin-top:0.4rem;">
              <span id="pptxTargetMin">최소</span> ~ <span id="pptxTargetMax">최대</span>
            </div>
          </div>
        </div>

        <div class="estimate" id="pptxEstimate" style="display:none"></div>

        <div class="action-row">
          <button class="action-btn" id="pptxRunBtn" onclick="runPptx()" disabled="">압축 후 다운로드</button>
          <button class="action-btn secondary" onclick="clearPptx()">초기화</button>
        </div>

        <div class="progress" id="pptxProgress" style="display:none">
          <div class="progress-msg" id="pptxProgressMsg">처리 중…</div>
          <div class="progress-bar"><div class="progress-bar-fill" id="pptxProgressFill"></div></div>
        </div>

        <div class="result" id="pptxResult" style="display:none"></div>
      </section>
    </div>
  </div>
</div>

<div id="toast"></div>

<script src="./app.js" is:inline=""></script>



</AppLayout>
