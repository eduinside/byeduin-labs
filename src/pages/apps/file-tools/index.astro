---
import AppLayout from '../../../layouts/AppLayout.astro';
import Icon from '../../../components/Icon.astro';
---
<AppLayout
  title="파일 용량 줄이기 (File Tools) — eduin VIVES"
  description="스캔한 PDF·TIFF·JPG·PNG와 PPTX의 용량을 정한 크기에 맞게 줄여요. 그림 크기와 화질을 자동으로 조절하고, 모두 브라우저 안에서 처리합니다."
  image="https://eduin.info/og-images/file-tools.png"
  bodyShell="column"
  bodyWidth="medium"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="./styles.css">
    <style is:global>
      /* 접근성 보강: 누르는 영역 44px, 키보드 포커스 표시 */
      .file-list-item { align-items: center; }
      .file-list-remove { min-width: 44px; min-height: 44px; font-size: 1.1rem; border-radius: 0.5rem; display: inline-flex; align-items: center; justify-content: center; }
      .toggle-group button { min-height: 44px; }
      .action-btn { min-height: 44px; }
      .dropzone:focus-visible { outline: 3px solid var(--primary); outline-offset: 3px; border-color: var(--primary); }
      .tab-btn:focus-visible { outline: 2px solid var(--primary); outline-offset: -4px; }
      .opt-field .opt-label {
        font-size: 0.75rem; font-weight: 600; color: var(--fg-muted);
        text-transform: uppercase; letter-spacing: 0.04em;
      }
    </style>
  <!-- jszip·UTIF·pdf.js·pdf-lib는 app.js가 필요할 때 버전 고정 주소로 지연 로드 -->
  <script type="application/ld+json" is:inline="">{"@context":"https://schema.org","@type":"WebApplication","name":"파일 용량 줄이기 (File Tools)","description":"스캔한 PDF·TIFF·JPG·PNG와 PPTX의 용량을 정한 크기에 맞게 줄여요. 그림 크기와 화질을 자동으로 조절하고, 모두 브라우저 안에서 처리합니다.","url":"https://eduin.info/apps/file-tools/","applicationCategory":"EducationApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"KRW"},"isPartOf":{"@type":"WebSite","name":"eduin VIVES","url":"https://eduin.info"}}</script>
  </Fragment>




<main class="app-main wrap">
  <div class="app-header">
    <div class="app-badge">업무경감</div>
    <h1 class="app-title">파일 용량 줄이기 <span class="app-title-en">File Tools</span></h1>
    <p class="app-desc">스캔한 PDF·이미지와 PPTX를 정한 용량에 맞게 줄여요. 파일은 서버로 보내지 않고 이 브라우저 안에서 처리합니다.</p>
  </div>

  <div class="file-card">
    <div class="tabs" role="tablist" aria-label="도구 고르기">
      <button class="tab-btn active" id="tab-scan" data-tab="scan" role="tab" aria-selected="true" aria-controls="panel-scan" onclick="switchTab('scan')"><Icon name="file-image" /> PDF·이미지 줄이기</button>
      <button class="tab-btn" id="tab-pptx" data-tab="pptx" role="tab" aria-selected="false" aria-controls="panel-pptx" tabindex="-1" onclick="switchTab('pptx')"><Icon name="presentation" /> PPTX 줄이기</button>
    </div>

    <div class="card-body">
      <!-- ─────────────── Tab 1: 스캔 최적화 ─────────────── -->
      <section class="panel active" id="panel-scan" role="tabpanel" aria-labelledby="tab-scan">
        <div class="dropzone" id="scanDrop" role="button" tabindex="0" aria-label="이미지·PDF 파일 고르기" aria-describedby="scanDropHint">
          <div class="dropzone-icon" aria-hidden="true"><Icon name="upload" /></div>
          <div class="dropzone-label">PDF·TIFF·JPG·PNG 파일을 끌어다 놓거나 눌러서 고르기</div>
          <div class="dropzone-hint" id="scanDropHint">.pdf, .tif, .tiff, .jpg, .jpeg, .png · 여러 개 함께 고를 수 있어요</div>
          <input type="file" id="scanInput" accept=".tif,.tiff,.pdf,.jpg,.jpeg,.png,application/pdf,image/tiff,image/jpeg,image/png" multiple="" style="display:none">
        </div>
        <div class="file-list" id="scanFileList"></div>

        <div class="options-grid" id="scanOptionsGrid" style="display:none">
          <div class="opt-field" style="grid-column: 1 / -1;">
            <span class="opt-label" id="scanFormatLabel">출력 형식</span>
            <div class="toggle-group" id="scanFormatToggle" role="group" aria-labelledby="scanFormatLabel">
              <button type="button" data-fmt="pdf" class="active" aria-pressed="true">PDF</button>
              <button type="button" data-fmt="jpg" aria-pressed="false">JPG</button>
              <button type="button" data-fmt="png" aria-pressed="false">PNG</button>
            </div>
            <p class="opt-note" id="scanMergeNote"></p>
          </div>
          <div class="opt-field" style="grid-column: 1 / -1;">
            <label for="scanTargetMB">목표 용량 (결과 파일 전체, MB)</label>
            <div class="range-row">
              <input type="range" id="scanTargetMB" min="0.05" max="10" step="0.01" value="1.00">
              <span class="range-val" id="scanTargetMBVal" aria-hidden="true">1.00</span>
            </div>
            <div class="range-ends"><span id="scanTargetMin">최소</span><span id="scanTargetMax">최대</span></div>
            <div class="opt-note">넣은 파일을 모두 합친 결과가 이 용량 안에 들도록 화질과 그림 크기를 자동으로 조절해요.</div>
          </div>
        </div>

        <div class="estimate" id="scanEstimate" style="display:none" aria-live="polite"></div>

        <div class="action-row">
          <button class="action-btn" id="scanRunBtn" onclick="runScan()" disabled=""><Icon name="download" /> 줄여서 내려받기</button>
          <button class="action-btn secondary" onclick="clearScan()"><Icon name="x" /> 파일 모두 빼기</button>
        </div>

        <div class="progress" id="scanProgress" style="display:none">
          <div class="progress-msg" id="scanProgressMsg">처리 중…</div>
          <div class="progress-bar" id="scanProgressBar" role="progressbar" aria-labelledby="scanProgressMsg" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div class="progress-bar-fill" id="scanProgressFill"></div></div>
          <div class="visually-hidden" id="scanProgressLive" role="status" aria-live="polite"></div>
        </div>

        <div class="result" id="scanResult" style="display:none" role="status" aria-live="polite"></div>
      </section>

      <!-- ─────────────── Tab 2: PPTX 압축 ─────────────── -->
      <section class="panel" id="panel-pptx" role="tabpanel" aria-labelledby="tab-pptx">
        <div class="dropzone" id="pptxDrop" role="button" tabindex="0" aria-label="PPTX 파일 고르기" aria-describedby="pptxDropHint">
          <div class="dropzone-icon" aria-hidden="true"><Icon name="upload" /></div>
          <div class="dropzone-label">PPTX 파일을 끌어다 놓거나 눌러서 고르기</div>
          <div class="dropzone-hint" id="pptxDropHint">.pptx · 한 번에 한 파일 · 슬라이드 안의 그림을 줄여요</div>
          <input type="file" id="pptxInput" accept=".pptx,application/vnd.openxmlformats-officedocument.presentationml.presentation" style="display:none">
        </div>
        <div class="file-list" id="pptxFileList"></div>

        <div class="options-grid" id="pptxOptionsGrid" style="display:none">
          <div class="opt-field" style="grid-column: 1 / -1;">
            <label for="pptxTargetMB">목표 용량 (MB)</label>
            <div class="range-row">
              <input type="range" id="pptxTargetMB" min="0.05" max="10" step="0.01" value="3">
              <span class="range-val" id="pptxTargetMBVal" aria-hidden="true">3.00</span>
            </div>
            <div class="range-ends"><span id="pptxTargetMin">최소</span><span id="pptxTargetMax">최대</span></div>
          </div>
        </div>

        <div class="estimate" id="pptxEstimate" style="display:none" aria-live="polite"></div>

        <div class="action-row">
          <button class="action-btn" id="pptxRunBtn" onclick="runPptx()" disabled=""><Icon name="download" /> 줄여서 내려받기</button>
          <button class="action-btn secondary" onclick="clearPptx()"><Icon name="x" /> 파일 빼기</button>
        </div>

        <div class="progress" id="pptxProgress" style="display:none">
          <div class="progress-msg" id="pptxProgressMsg">처리 중…</div>
          <div class="progress-bar" id="pptxProgressBar" role="progressbar" aria-labelledby="pptxProgressMsg" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div class="progress-bar-fill" id="pptxProgressFill"></div></div>
          <div class="visually-hidden" id="pptxProgressLive" role="status" aria-live="polite"></div>
        </div>

        <div class="result" id="pptxResult" style="display:none" role="status" aria-live="polite"></div>
      </section>
    </div>
  </div>
</main>

<script src="./app.js" is:inline=""></script>



</AppLayout>
