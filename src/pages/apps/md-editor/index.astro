---
import AppLayout from '../../../layouts/AppLayout.astro';
import Icon from '../../../components/Icon.astro';
---
<AppLayout 
  sync
  title="마크다운 편집기 (MD Editor) — eduin VIVES"
  description="JSON, CSV, XML, HTML을 마크다운으로 자동 변환. 중첩 테이블 정리, 실시간 미리보기, 파일 공유까지."
  image="https://eduin.info/og-images/md-editor.png"
  bodyShell="split"
  bodyWidth="wide"
>
  <Fragment slot="head">
    <!-- 화면 그리기를 막지 않도록 defer. 준비되면 DOMContentLoaded에서 미리보기를 다시 그린다 -->
    <script src="https://cdn.jsdelivr.net/npm/marked@15.0.12/marked.min.js" defer is:inline=""></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@3.4.16/dist/purify.min.js" defer is:inline=""></script>
  <style is:global="">
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap');

    body {
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 48px 1rem 5rem;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(124,106,247,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(124,106,247,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 0;
    }

    .wrap {
      width: 100%;
      max-width: 1200px;
      position: relative;
      z-index: 1;
    }

    /* ── 툴바 ── */
    .md-toolbar {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.75rem;
      flex-wrap: wrap;
    }

    #filenameInput {
      flex: 1;
      min-width: 120px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
    }

    .toolbar-btn {
      padding: 0.45rem 0.875rem;
      border-radius: 0.5rem;
      border: 1px solid var(--border);
      background: var(--card-bg);
      color: var(--fg);
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      font-family: inherit;
      white-space: nowrap;
      transition: border-color 0.15s, color 0.15s;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.3rem;
      text-decoration: none;
      min-height: 44px;
    }
    .toolbar-btn:hover { border-color: var(--primary); color: var(--primary); }

    /* ── 보기 전용 배지 / 복제 버튼 ── */
    #view-badge {
      display: none;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      background: rgba(249,115,22,0.12);
      border: 1px solid rgba(249,115,22,0.4);
      border-radius: 20px;
      font-size: 0.72rem;
      font-weight: 700;
      color: #f97316;
      white-space: nowrap;
    }
    #btn-clone-content {
      display: none;
      min-height: 44px;
      padding: 0.45rem 0.875rem;
      border-radius: 0.5rem;
      border: 1px solid var(--primary);
      background: transparent;
      color: var(--primary);
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      font-family: inherit;
      white-space: nowrap;
    }

    body.is-view-only #view-badge { display: flex; }
    body.is-view-only #btn-clone-content { display: inline-flex; align-items: center; }
    body.is-view-only #editor { pointer-events: none; opacity: 0.7; background: var(--bg); }
    body.is-view-only .view-only-hide { opacity: 0.3; pointer-events: none; }

    /* ── 저장 드롭다운 ── */
    #save-dropdown {
      position: fixed;
      display: none;
      flex-direction: column;
      gap: 3px;
      padding: 6px;
      border-radius: 10px;
      background: var(--card-bg);
      border: 1px solid var(--border);
      z-index: 9500;
      min-width: 120px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }
    #save-dropdown.open { display: flex; }

    /* ── 열기 드롭다운 ── */
    #open-dropdown {
      position: fixed;
      display: none;
      flex-direction: column;
      gap: 3px;
      padding: 6px;
      border-radius: 10px;
      background: var(--card-bg);
      border: 1px solid var(--border);
      z-index: 9500;
      min-width: 140px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }
    #open-dropdown.open { display: flex; }

    /* ── 보기 드롭다운 ── */
    #view-dropdown {
      position: fixed;
      display: none;
      flex-direction: column;
      gap: 3px;
      padding: 6px;
      border-radius: 10px;
      background: var(--card-bg);
      border: 1px solid var(--border);
      z-index: 9500;
      min-width: 120px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }
    #view-dropdown.open { display: flex; }

    /* ── 공유 드롭다운 ── */
    #share-dropdown {
      position: fixed;
      display: none;
      flex-direction: column;
      gap: 3px;
      padding: 6px;
      border-radius: 10px;
      background: var(--card-bg);
      border: 1px solid var(--border);
      z-index: 9500;
      min-width: 150px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }
    #share-dropdown.open { display: flex; }
    .dropdown-opt, .share-opt {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: 7px;
      border: none;
      background: none;
      color: var(--fg);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      font-family: inherit;
      text-align: left;
      min-height: 44px;
    }
    .dropdown-opt:hover, .share-opt:hover { background: var(--bg); }
    .dropdown-opt svg,
    .share-opt svg,
    .toolbar-btn svg, #btn-clone-content svg {
      width: 14px;
      height: 14px;
      stroke-width: 2.2;
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .dropdown-opt:disabled {
      color: var(--fg-muted);
      cursor: not-allowed;
      opacity: 0.5;
    }

    /* 메뉴 항목 아래 작은 설명(배지 아님) */
    .opt-text { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .opt-hint {
      font-size: 0.72rem;
      font-weight: 500;
      color: var(--fg-muted);
      white-space: normal;
      line-height: 1.4;
    }
    #save-dropdown, #open-dropdown { max-width: min(300px, calc(100vw - 16px)); }
    /* 툴바 버튼의 펼침 표시(chevron) */
    .toolbar-btn .ic-caret { width: 12px; height: 12px; margin-left: -2px; opacity: 0.7; }

    /* ── 모바일 탭 (hidden on desktop) ── */
    .mobile-tabs {
      display: none;
      border-bottom: 1px solid var(--border);
      background: var(--card-bg);
      border-radius: 1rem 1rem 0 0;
      overflow: hidden;
    }
    .mobile-tab-btn {
      flex: 1;
      min-height: 44px;
      padding: 0.75rem;
      font-size: 0.85rem;
      font-weight: 600;
      background: none;
      border: none;
      border-bottom: 2px solid transparent;
      color: var(--fg-muted);
      cursor: pointer;
      transition: color 0.15s, border-color 0.15s;
      font-family: inherit;
    }
    .mobile-tab-btn.active { color: var(--primary); border-bottom-color: var(--primary); }

    /* ── 스플릿 에디터 ── */
    .md-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      border: 1px solid var(--border);
      border-radius: 1rem;
      overflow: hidden;
      background: var(--card-bg);
      height: calc(100vh - 240px);
      height: calc(100dvh - 240px);
      min-height: 400px;
    }

    .md-pane {
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .md-pane + .md-pane {
      border-left: 1px solid var(--border);
    }

    .pane-label {
      padding: 0.4rem 1rem;
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--fg-muted);
      border-bottom: 1px solid var(--border);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      background: var(--bg);
      flex-shrink: 0;
    }

    #editor {
      flex: 1;
      resize: none;
      border: none;
      outline: none;
      padding: 1.25rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.875rem;
      line-height: 1.75;
      background: var(--card-bg);
      color: var(--fg);
      tab-size: 2;
      overflow-y: auto;
    }
    #editor::placeholder { color: var(--fg-muted); }
    #editor.is-loading { opacity: 0.4; cursor: wait; }
    #editor::-webkit-scrollbar { width: 8px; }
    #editor::-webkit-scrollbar-track { background: transparent; }
    #editor::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
    #editor::-webkit-scrollbar-thumb:hover { background: var(--fg-muted); }

    #preview {
      flex: 1;
      overflow-y: auto;
      padding: 1.25rem 1.5rem;
      background: var(--card-bg);
    }
    #preview::-webkit-scrollbar { width: 8px; }
    #preview::-webkit-scrollbar-track { background: transparent; }
    #preview::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
    #preview::-webkit-scrollbar-thumb:hover { background: var(--fg-muted); }

    /* ── 마크다운 렌더링 스타일 ── */
    .markdown-body { line-height: 1.75; color: var(--fg); }
    .markdown-body h1, .markdown-body h2, .markdown-body h3,
    .markdown-body h4, .markdown-body h5, .markdown-body h6 {
      font-weight: 700;
      margin: 1.25em 0 0.5em;
      line-height: 1.3;
    }
    .markdown-body h1 {
      font-size: 1.8em;
      border-bottom: 2px solid var(--border);
      padding-bottom: 0.3em;
    }
    .markdown-body h2 {
      font-size: 1.4em;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.2em;
    }
    .markdown-body h3 { font-size: 1.15em; }
    .markdown-body p { margin: 0.75em 0; }
    .markdown-body a { color: var(--primary); text-decoration: underline; }
    .markdown-body code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.875em;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 0.15em 0.4em;
    }
    .markdown-body pre {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      padding: 1rem;
      overflow-x: auto;
      margin: 1em 0;
    }
    .markdown-body pre code { background: none; border: none; padding: 0; }
    .markdown-body blockquote {
      border-left: 4px solid var(--primary);
      margin: 0.75em 0;
      padding: 0.25em 1em;
      color: var(--fg-muted);
    }
    .markdown-body ul, .markdown-body ol { padding-left: 1.5em; margin: 0.75em 0; }
    .markdown-body li { margin: 0.25em 0; }
    .markdown-body table { border-collapse: collapse; width: 100%; margin: 1em 0; }
    .markdown-body th, .markdown-body td {
      border: 1px solid var(--border);
      padding: 0.4em 0.75em;
      text-align: left;
    }
    .markdown-body th { background: var(--bg); font-weight: 700; }
    .markdown-body hr { border: none; border-top: 1px solid var(--border); margin: 1.5em 0; }
    .markdown-body img { max-width: 100%; border-radius: 0.5rem; }
    .markdown-body input[type="checkbox"] { margin-right: 0.4em; }

    /* ── 복제 모달 ── */
    .md-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.45);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 10000;
    }
    .md-modal-overlay.open { display: flex; }
    .md-modal {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 1rem;
      padding: 1.75rem;
      max-width: 380px;
      width: 90%;
    }
    .md-modal-title { font-size: 1.1rem; font-weight: 700; margin: 0 0 0.5rem; }
    .md-modal-desc { font-size: 0.85rem; color: var(--fg-muted); margin-bottom: 1.25rem; }
    .share-import-choices { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem; }
    .share-import-choice {
      display: flex;
      flex-direction: column;
      gap: 3px;
      padding: 0.875rem 1rem;
      border-radius: 0.75rem;
      border: 1px solid var(--border);
      background: var(--bg);
      text-align: left;
      cursor: pointer;
      font-family: inherit;
      transition: border-color 0.15s;
    }
    .share-import-choice:hover { border-color: var(--primary); }
    .share-import-choice-title { font-size: 0.9rem; font-weight: 700; color: var(--fg); }
    .share-import-choice-desc { font-size: 0.75rem; color: var(--fg-muted); }
    .md-modal-cancel {
      width: 100%;
      min-height: 44px;
      padding: 0.6rem;
      background: none;
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      color: var(--fg-muted);
      font-size: 0.85rem;
      cursor: pointer;
      font-family: inherit;
    }
    .md-modal-cancel:hover { border-color: var(--fg-muted); }

    /* ── 로드 모달 리스트 ── */
    #docsList li {
      padding: 0.75rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    #docsList li:last-child { border-bottom: none; }
    /* 문서 열기 = 버튼(키보드로도 열림) */
    #docsList li button.doc-open, #serverDocsList li button.doc-open {
      flex: 1;
      min-width: 0;
      min-height: 44px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      gap: 0.2rem;
      padding: 0.25rem 0.5rem 0.25rem 0;
      border: none;
      background: none;
      color: var(--fg);
      font: inherit;
      text-align: left;
      cursor: pointer;
      white-space: normal;
    }
    #docsList li button.doc-open:hover .doc-name, #serverDocsList li button.doc-open:hover .doc-name { color: var(--primary); }
    .doc-name { font-weight: 500; overflow-wrap: anywhere; }
    .doc-meta { font-size: 0.85rem; color: var(--fg-muted); }
    #docsList li button.doc-del, #serverDocsList li button.doc-del {
      min-height: 44px;
      min-width: 52px;
      padding: 0.25rem 0.5rem;
      font-size: 0.85rem;
      background: none;
      border: 1px solid color-mix(in srgb, var(--danger, #f31260) 45%, transparent);
      border-radius: 0.375rem;
      color: var(--danger, #f31260);
      cursor: pointer;
      font-family: inherit;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.25rem;
    }
    #docsList li button {
      padding: 0.25rem 0.5rem;
      font-size: 0.8rem;
      border: 1px solid var(--border);
      background: var(--card-bg);
      border-radius: 0.375rem;
      color: var(--fg);
      cursor: pointer;
      font-family: inherit;
      white-space: nowrap;
    }
    #docsList li button:hover { border-color: var(--primary); color: var(--primary); }
    #docsList li button.doc-del:hover, #serverDocsList li button.doc-del:hover {
      border-color: var(--danger, #f31260);
      color: var(--danger, #f31260);
      background: color-mix(in srgb, var(--danger, #f31260) 10%, transparent);
    }
    .load-sec-title { display: flex; align-items: center; gap: 0.3rem; }

    /* ── 모달 열릴 때 상단 오버레이 어둡게 ── */
    body.modal-open .top-overlay-left,
    body.modal-open .top-overlay {
      opacity: 0.4;
      pointer-events: none;
    }

    /* ── 반응형 (모바일) ── */
    @media (max-width: 767px) {
      body { padding: 48px 0.5rem 4rem; }
      .mobile-tabs { display: flex; }
      .md-split {
        grid-template-columns: 1fr;
        height: calc(100vh - 260px);
        height: calc(100dvh - 260px);
        border-radius: 0 0 1rem 1rem;
      }
      .md-pane { display: none; }
      .md-pane.mobile-active { display: flex; }
      .md-pane + .md-pane { border-left: none; }
      .pane-label { display: none; }

      /* 제목줄 + 버튼줄 분리 */
      .md-toolbar {
        gap: 0.35rem;
        flex-wrap: wrap;
      }
      #filenameInput {
        flex-basis: 100%;
        min-width: 80px;
        font-size: 16px;   /* iOS: 16px 미만이면 입력할 때 화면이 확대됨 */
        margin-bottom: 0.25rem;
      }
      .toolbar-btn, #btn-clone-content {
        flex: 1 1 auto;
        min-width: fit-content;
        padding: 0.4rem 0.6rem;
        font-size: 0.7rem;
      }
      #editor { font-size: 16px; }   /* iOS 확대 방지 */
    }
  </style>
  <script type="application/ld+json" is:inline="">{"@context":"https://schema.org","@type":"WebApplication","name":"MD Editor","description":"JSON, CSV, XML, HTML을 마크다운으로 자동 변환. 중첩 테이블 정리, 실시간 미리보기, 파일 공유까지.","url":"https://eduin.info/apps/md-editor/","applicationCategory":"EducationApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"KRW"},"isPartOf":{"@type":"WebSite","name":"eduin VIVES","url":"https://eduin.info"}}</script>
  </Fragment>




<div class="wrap">
  <div class="app-header">
    <div class="app-badge">생활편의</div>
    <h1 class="app-title">마크다운 편집기 <span class="app-title-en">MD Editor</span></h1>
    <p class="app-desc">간편한 마크다운 문서 편집기 <button type="button" class="hero-btn hero-btn-ghost hero-btn-sm" onclick="openHelpModal()" style="margin-left:0.5rem;"><Icon name="circle-help" />마크다운 더 알아보기</button></p>
  </div>

  <!-- 툴바 -->
  <div class="md-toolbar">
    <input type="text" id="filenameInput" class="hero-input" value="untitled.md" placeholder="파일명.md" aria-label="파일 이름" maxlength="120" oninput="onFilenameInput(this)">
    <button class="toolbar-btn view-only-hide" onclick="newDocument()"><Icon name="file-plus" />새 문서</button>
    <button class="toolbar-btn view-only-hide" onclick="toggleOpenMenu(event)" aria-haspopup="true" aria-controls="open-dropdown"><Icon name="folder-open" />열기<Icon name="chevron-down" class="ic-caret" /></button>
    <input type="file" id="fileInput" accept=".md,.txt,.markdown" style="display:none" onchange="handleFileLoad(this)">
    <input type="file" id="multiFileInput" accept=".json,.csv,.xml,.html,.htm" style="display:none" onchange="handleMultiLoad(this)">
    <input type="file" id="docFileInput" accept=".hwp,.hwpx,.hwpml,.pdf,.docx,.pptx,.xlsx,.doc,.xls" style="display:none" onchange="handleDocLoad(this)">
    <button class="toolbar-btn view-only-hide" id="saveBtn" onclick="toggleSaveMenu(event)" aria-haspopup="true" aria-controls="save-dropdown"><Icon name="save" />저장<Icon name="chevron-down" class="ic-caret" /></button>
    <button class="toolbar-btn view-only-hide" id="viewBtn" onclick="toggleViewMenu(event)" aria-haspopup="true" aria-controls="view-dropdown"><Icon name="eye" />보기<Icon name="chevron-down" class="ic-caret" /></button>
    <div id="view-badge"><Icon name="eye-off" size={12} />보기 전용</div>
    <button id="btn-clone-content" onclick="cloneContent()"><Icon name="copy" />복제</button>
    <button class="toolbar-btn view-only-hide" onclick="toggleShareMenu(event)" aria-haspopup="true" aria-controls="share-dropdown">
      <Icon name="share-2" />
      공유<Icon name="chevron-down" class="ic-caret" />
    </button>
  </div>

  <!-- 모바일 탭 -->
  <div class="mobile-tabs">
    <button class="mobile-tab-btn active" id="mTabEdit" onclick="switchMobileTab('edit')">편집</button>
    <button class="mobile-tab-btn" id="mTabPreview" onclick="switchMobileTab('preview')">미리보기</button>
  </div>

  <!-- 스플릿 에디터 -->
  <div class="md-split">
    <div class="md-pane mobile-active" id="paneEdit">
      <div class="pane-label">편집</div>
      <textarea id="editor" aria-label="마크다운 편집" placeholder="마크다운을 입력하세요...

# 제목
## 소제목
**굵게** / *기울기* / `코드`" oninput="onEditorInput(this)"></textarea>
    </div>
    <div class="md-pane" id="panePreview">
      <div class="pane-label">미리보기</div>
      <div id="preview" class="markdown-body"></div>
    </div>
  </div>
</div>

<!-- 저장 드롭다운 -->
<div id="save-dropdown">
  <button class="dropdown-opt" id="saveMdOpt" onclick="downloadMd()">
    <Icon name="file-text" />
    Markdown 저장
  </button>
  <button class="dropdown-opt" id="saveHtmlOpt" onclick="downloadHtml()">
    <Icon name="file-code" />
    HTML 저장
  </button>
  <button class="dropdown-opt" id="saveLsOpt" onclick="saveToLocalStorage()">
    <Icon name="save" />
    <span class="opt-text">브라우저에 저장<small class="opt-hint">열어 둔 문서는 덮어써요</small></span>
  </button>
  <button class="dropdown-opt" id="saveLsAsOpt" onclick="saveToLocalStorage(true)">
