  async function handleMultiLoad(input) {
    const file = input.files[0];
    if (!file) return;
    if (!(await confirmReplaceDoc())) { input.value = ''; return; }
    const ext = file.name.split('.').pop().toLowerCase();
    const reader = new FileReader();
    reader.onerror = () => { showError('파일을 읽을 수 없어요.'); input.value = ''; };
    reader.onload = (e) => {
      const text = e.target.result;
      let md = '', toast = '';
      if (ext === 'json') {
        md = convertJsonToMd(text, file.name);
        toast = 'JSON을 표로 바꿨어요.';
      } else if (ext === 'csv') {
        md = convertCsvToMd(text, file.name);
        toast = 'CSV를 마크다운 표로 바꿨어요.';
      } else if (ext === 'xml') {
        md = convertXmlToMd(text, file.name);
        toast = md && md.includes('<table')
          ? 'XML을 표로 바꿨어요.'
          : 'XML 형식이 맞지 않아 원문 그대로 열었어요.';
      } else if (ext === 'html' || ext === 'htm') {
        md = convertHtmlDomToMd(text, file.name);
        toast = 'HTML을 마크다운으로 바꿨어요.';
      }
      if (md === null) { input.value = ''; return; }
      mdContent = normalizeTableHeaders(md);
      currentFilename = file.name.replace(/\.[^.]+$/, '.md');
      currentLocalId = null;
      document.getElementById('filenameInput').value = currentFilename;
      document.getElementById('editor').value = mdContent;
      renderPreview();
      markLoaded();
      showToast(toast);
    };
    reader.readAsText(file, 'UTF-8');
    input.value = '';
  }

  // ── JSON → HTML 중첩 테이블 ──
  function convertJsonToMd(text, filename) {
    let data;
    try { data = JSON.parse(text); } catch {
      showError('JSON 형식이 올바르지 않아요. 파일 내용을 확인해 주세요.');
      return null;
    }
    const html = jsonToHtmlTable(data);
    return `## ${filename}\n\n${html}`;
  }

  function esc(s) {
    if (window.VSafe) return VSafe.esc(s);
    return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  function jsonToHtmlTable(data) {
    // 원시값
    if (data === null || typeof data !== 'object') return esc(data);

    // 배열 of 객체 → 열이 있는 표
    if (Array.isArray(data) && data.length > 0 && data.some(r => r && typeof r === 'object' && !Array.isArray(r))) {
      const keys = [...new Set(data.flatMap(r => (r && typeof r === 'object' && !Array.isArray(r)) ? Object.keys(r) : []))];
      const thead = '<thead><tr>' + keys.map(k => `<th style="padding:4px 8px;border:1px solid var(--border);background:var(--card-bg);white-space:nowrap">${esc(k)}</th>`).join('') + '</tr></thead>';
      const tbody = '<tbody>' + data.map(row => {
        if (!row || typeof row !== 'object' || Array.isArray(row)) {
          return `<tr><td colspan="${keys.length}" style="padding:4px 8px;border:1px solid var(--border)">${jsonToHtmlTable(row)}</td></tr>`;
        }
        return '<tr>' + keys.map(k => {
          const v = row[k];
          const inner = (v !== null && typeof v === 'object') ? jsonToHtmlTable(v) : esc(v ?? '');
          return `<td style="padding:4px 8px;border:1px solid var(--border);vertical-align:top">${inner}</td>`;
        }).join('') + '</tr>';
      }).join('') + '</tbody>';
      return `<table style="border-collapse:collapse;font-size:0.85em">${thead}${tbody}</table>`;
    }

    // 배열 of 원시값 → 단일 열 표
    if (Array.isArray(data)) {
      const rows = data.map(v => `<tr><td style="padding:4px 8px;border:1px solid var(--border);vertical-align:top">${jsonToHtmlTable(v)}</td></tr>`).join('');
      return `<table style="border-collapse:collapse;font-size:0.85em"><tbody>${rows}</tbody></table>`;
    }

    // 일반 객체 → 키/값 표
    const rows = Object.entries(data).map(([k, v]) => {
      const inner = (v !== null && typeof v === 'object') ? jsonToHtmlTable(v) : esc(v ?? '');
      return `<tr><td style="padding:4px 8px;border:1px solid var(--border);background:var(--card-bg);white-space:nowrap;vertical-align:top"><strong>${esc(k)}</strong></td><td style="padding:4px 8px;border:1px solid var(--border);vertical-align:top">${inner}</td></tr>`;
    }).join('');
    return `<table style="border-collapse:collapse;font-size:0.85em"><tbody>${rows}</tbody></table>`;
  }

  // ── CSV → Markdown 테이블 ──
  function convertCsvToMd(text, filename) {
    const lines = text.trim().split(/\r?\n/).filter(l => l.trim());
    if (lines.length === 0) { showError('CSV 파일이 비어 있어요.'); return null; }
    const parseRow = line => {
      const cells = [];
      let cur = '', inQ = false;
      for (let i = 0; i < line.length; i++) {
        const c = line[i];
        if (c === '"' && !inQ) { inQ = true; continue; }
        if (c === '"' && inQ && line[i+1] === '"') { cur += '"'; i++; continue; }
        if (c === '"' && inQ) { inQ = false; continue; }
        if (c === ',' && !inQ) { cells.push(cur); cur = ''; continue; }
        cur += c;
      }
      cells.push(cur);
      return cells.map(c => c.replace(/\|/g, '\\|').replace(/\n/g, ' ').trim());
    };
    const rows = lines.map(parseRow);
    const colCount = Math.max(...rows.map(r => r.length));
    const pad = row => { while (row.length < colCount) row.push(''); return row; };
    const header = '| ' + pad(rows[0]).join(' | ') + ' |';
    const sep    = '| ' + Array(colCount).fill('---').join(' | ') + ' |';
    const body   = rows.slice(1).map(r => '| ' + pad(r).join(' | ') + ' |').join('\n');
    return `## ${filename}\n\n${header}\n${sep}\n${body}`;
  }

  // ── XML → HTML 중첩 테이블 ──
  function convertXmlToMd(text, filename) {
    const doc = new DOMParser().parseFromString(text, 'application/xml');
    const err = doc.querySelector('parsererror');
    if (err) return `## ${filename}\n\n\`\`\`xml\n${text.trim()}\n\`\`\``;
    const root = doc.documentElement;
    const html = xmlNodeToHtmlTable(root);
    return `## ${filename} <small style="color:var(--fg-muted);font-weight:400">&lt;${esc(root.tagName)}&gt;</small>\n\n${html}`;
  }

  function xmlNodeToHtmlTable(node) {
    const elChildren = Array.from(node.childNodes).filter(n => n.nodeType === 1);
    const text = node.textContent.trim();

    // 자식 엘리먼트 없음 → 텍스트 또는 빈 값
    if (elChildren.length === 0) return esc(text);

    // 자식이 모두 같은 태그이고 2개 이상 → 배열형 → 행(row) 테이블
    const childTags = [...new Set(elChildren.map(c => c.tagName))];
    if (childTags.length === 1 && elChildren.length > 1) {
      return xmlArrayToTable(elChildren);
    }

    // 자식 태그가 다양하거나 1개 → 객체형 → 키/값 테이블
    return xmlObjectToTable(node, elChildren);
  }

  // 반복 엘리먼트 → 열이 있는 표
  function xmlArrayToTable(items) {
    // 모든 속성 + 자식 엘리먼트 이름 수집
    const attrKeys = new Set(), elKeys = new Set();
    items.forEach(item => {
      Array.from(item.attributes).forEach(a => attrKeys.add(a.name));
      Array.from(item.childNodes).filter(n => n.nodeType === 1).forEach(c => elKeys.add(c.tagName));
    });
    const cols = [...attrKeys].map(k => '@' + k).concat([...elKeys]);

    // 헤더가 없고 텍스트만 있는 경우 (단순 배열)
    if (cols.length === 0) {
      const rows = items.map(item =>
        `<tr><td style="${TD}">${esc(item.textContent.trim())}</td></tr>`
      ).join('');
      return `<table style="${TBL}"><tbody>${rows}</tbody></table>`;
    }

    const TH_S = `padding:4px 8px;border:1px solid var(--border);background:var(--card-bg);white-space:nowrap`;
    const thead = '<thead><tr>' +
      cols.map(k => `<th style="${TH_S}">${esc(k)}</th>`).join('') +
      '</tr></thead>';
    const tbody = '<tbody>' + items.map(item => {
      return '<tr>' + cols.map(col => {
        let inner = '';
        if (col.startsWith('@')) {
          inner = esc(item.getAttribute(col.slice(1)) ?? '');
        } else {
          const child = Array.from(item.childNodes).find(n => n.nodeType === 1 && n.tagName === col);
          inner = child ? xmlNodeToHtmlTable(child) : '';
        }
        return `<td style="${TD}">${inner}</td>`;
      }).join('') + '</tr>';
    }).join('') + '</tbody>';
    return `<table style="${TBL}">${thead}${tbody}</table>`;
  }

  // 객체형 → 키/값 표
  function xmlObjectToTable(node, elChildren) {
    const rows = [];
    Array.from(node.attributes).forEach(a => {
      rows.push(`<tr><td style="${TH_KV}"><strong>@${esc(a.name)}</strong></td><td style="${TD}">${esc(a.value)}</td></tr>`);
    });
    elChildren.forEach(child => {
      const val = xmlNodeToHtmlTable(child);
      rows.push(`<tr><td style="${TH_KV}"><strong>${esc(child.tagName)}</strong></td><td style="${TD}">${val}</td></tr>`);
    });
    return `<table style="${TBL}"><tbody>${rows.join('')}</tbody></table>`;
  }

  const TBL = 'border-collapse:collapse;font-size:0.85em';
  const TD  = 'padding:4px 8px;border:1px solid var(--border);vertical-align:top';
  const TH_KV = 'padding:4px 8px;border:1px solid var(--border);background:var(--card-bg);white-space:nowrap;vertical-align:top';

  // ── HTML → Markdown (DOMParser, 순수 JS) ──
  function convertHtmlDomToMd(html, filename) {
    const doc = new DOMParser().parseFromString(html, 'text/html');
    const title = doc.title || filename;

    function nodeToMd(node, depth) {
      if (node.nodeType === Node.TEXT_NODE) {
        return node.textContent.replace(/\n+/g, ' ');
      }
      if (node.nodeType !== Node.ELEMENT_NODE) return '';
      const tag = node.tagName.toLowerCase();
      const children = () => Array.from(node.childNodes).map(n => nodeToMd(n, depth)).join('');

      if (tag === 'script' || tag === 'style' || tag === 'head') return '';
      if (/^h([1-6])$/.test(tag)) return '\n\n' + '#'.repeat(+tag[1]) + ' ' + node.textContent.trim() + '\n\n';
      if (tag === 'p') { const t = children().trim(); return t ? '\n\n' + t + '\n\n' : ''; }
      if (tag === 'br') return '  \n';
      if (tag === 'strong' || tag === 'b') return '**' + node.textContent.replace(/\n/g, ' ').trim() + '**';
      if (tag === 'em' || tag === 'i') return '*' + node.textContent.replace(/\n/g, ' ').trim() + '*';
      if (tag === 'code') return '`' + node.textContent + '`';
      if (tag === 'pre') return '\n\n```\n' + node.textContent.trim() + '\n```\n\n';
      if (tag === 'a') {
        const href = node.getAttribute('href') || '';
        const t = node.textContent.trim();
        return href ? `[${t}](${href})` : t;
      }
      if (tag === 'img') {
        const alt = node.getAttribute('alt') || '';
        const src = node.getAttribute('src') || '';
        return src ? `![${alt}](${src})` : '';
      }
      if (tag === 'ul') {
        return '\n\n' + Array.from(node.children).map(li => '- ' + li.textContent.replace(/\n+/g, ' ').trim()).join('\n') + '\n\n';
      }
      if (tag === 'ol') {
        return '\n\n' + Array.from(node.children).map((li, i) => (i+1) + '. ' + li.textContent.replace(/\n+/g, ' ').trim()).join('\n') + '\n\n';
      }
      if (tag === 'table') return '\n\n' + tableToMd(node) + '\n\n';
      if (tag === 'hr') return '\n\n---\n\n';
      if (tag === 'blockquote') return '\n\n> ' + node.textContent.replace(/\n+/g, '\n> ').trim() + '\n\n';
      return children();
    }

    function tableToMd(table) {
      const rows = Array.from(table.querySelectorAll('tr'));
      if (rows.length === 0) return '';
      const parseRow = tr => Array.from(tr.querySelectorAll('th,td')).map(td => td.textContent.replace(/\|/g, '\\|').replace(/\n+/g, ' ').trim());
      const data = rows.map(parseRow);
      const colCount = Math.max(...data.map(r => r.length));
      const pad = r => { while (r.length < colCount) r.push(''); return r; };
      const header = '| ' + pad(data[0]).join(' | ') + ' |';
      const sep    = '| ' + Array(colCount).fill('---').join(' | ') + ' |';
      const body   = data.slice(1).map(r => '| ' + pad(r).join(' | ') + ' |').join('\n');
      return header + '\n' + sep + (body ? '\n' + body : '');
    }

    const body = doc.body || doc.documentElement;
    const md = nodeToMd(body, 0)
      .replace(/\n{3,}/g, '\n\n')
      .trim();

    return `# ${title}\n\n${md}`;
  }

  // ── 보기 모드 드롭다운 ──
  function toggleViewMenu(e) {
    e.stopPropagation();
    closeAllMenus();  // 다른 메뉴 먼저 닫기
    const dd = document.getElementById('view-dropdown');
    const rect = e.currentTarget.getBoundingClientRect();
    dd.style.top = (rect.bottom + 6) + 'px';
    dd.style.left = rect.left + 'px';
    _viewMenuOpen = !_viewMenuOpen;
    dd.classList.toggle('open', _viewMenuOpen);
    if (_viewMenuOpen) {
      setTimeout(() => document.addEventListener('click', _closeViewMenu, { once: true }), 0);
    }
  }

  function _closeViewMenu() {
    document.getElementById('view-dropdown').classList.remove('open');
    _viewMenuOpen = false;
  }

  function setViewMode(mode) {
    _closeViewMenu();
    if (mode === viewMode) return;  // 같은 모드면 무시

    viewMode = mode;
    const paneEdit = document.getElementById('paneEdit');
    const panePreview = document.getElementById('panePreview');
    const mTabEdit = document.getElementById('mTabEdit');
    const mTabPreview = document.getElementById('mTabPreview');
    const mdSplit = document.querySelector('.md-split');

    if (mode === 'edit-only') {
      paneEdit.style.display = 'flex';
      panePreview.style.display = 'none';
      mTabEdit.style.display = 'block';
      mTabPreview.style.display = 'none';
      paneEdit.classList.add('mobile-active');
      mTabEdit.classList.add('active');
      mdSplit.style.gridTemplateColumns = '1fr';  // 전체 폭
    } else if (mode === 'preview-only') {
      paneEdit.style.display = 'none';
      panePreview.style.display = 'flex';
      mTabEdit.style.display = 'none';
      mTabPreview.style.display = 'block';
      panePreview.classList.add('mobile-active');
      mTabPreview.classList.add('active');
      mdSplit.style.gridTemplateColumns = '1fr';  // 전체 폭
    } else {  // 'both'
      paneEdit.style.display = 'flex';
      panePreview.style.display = 'flex';
      mTabEdit.style.display = 'block';
      mTabPreview.style.display = 'block';
      paneEdit.classList.add('mobile-active');
      mTabEdit.classList.add('active');
      panePreview.classList.remove('mobile-active');
      mTabPreview.classList.remove('active');
      mdSplit.style.gridTemplateColumns = '1fr 1fr';  // 원래 너비로 복구
    }
    showToast(`보기: ${mode === 'edit-only' ? '편집만' : mode === 'preview-only' ? '미리보기만' : '둘 다'}`);
  }

  // ── 브라우저 저장 / 불러오기 ──
  const LS_ALL_DOCS_KEY = 'md-editor-all-docs';

  function readAllDocs() {
    let allDocs = [];
    try {
      const raw = localStorage.getItem(LS_ALL_DOCS_KEY);
      if (raw) allDocs = JSON.parse(raw);
      if (!Array.isArray(allDocs)) allDocs = [];
    } catch { allDocs = []; }
    return allDocs;
  }

  // 같은 이름이 있으면 이름(1).md, 이름(2).md …
  function uniqueDocName(allDocs, filename) {
    const existingNames = allDocs.map(doc => doc.filename);
    if (!existingNames.includes(filename)) return filename;
    const nameParts = filename.split('.');
    const baseName = nameParts.length > 1 ? nameParts.slice(0, -1).join('.') : filename;
    const ext = nameParts.length > 1 ? '.' + nameParts[nameParts.length - 1] : '';
    let counter = 1;
    while (existingNames.includes(`${baseName}(${counter})${ext}`)) counter++;
    return `${baseName}(${counter})${ext}`;
  }

  // 브라우저에 저장: 이 브라우저에서 열었거나 저장한 문서면 그 문서를 덮어쓴다.
  // asNew(다른 이름으로 저장): 이름을 받아 사본을 하나 더 만들고, 이후 저장은 그 사본에 한다.
  async function saveToLocalStorage(asNew) {
    _closeSaveMenu();
    if (!mdContent.trim()) { showToast('저장할 내용이 없어요'); return; }

    let filename = document.getElementById('filenameInput').value.trim().slice(0, 120) || 'untitled.md';
    if (asNew) {
      const name = await VUI.prompt('새 이름을 정해 주세요. 지금 문서는 그대로 두고 사본을 하나 더 저장해요.', {
        title: '다른 이름으로 저장', value: filename, placeholder: '파일명.md', ok: '저장',
      });
      if (name === null) return;
      filename = name.trim().slice(0, 120) || filename;
    }

    const allDocs = readAllDocs();
    const existing = (!asNew && currentLocalId) ? allDocs.find(d => d.id === currentLocalId) : null;
    let savedId;
    if (existing) {
      existing.content = mdContent;
      existing.filename = filename;
      existing.savedAt = new Date().toISOString();
      savedId = existing.id;
    } else {
      filename = uniqueDocName(allDocs, filename);
      savedId = Date.now().toString();
      allDocs.push({ id: savedId, content: mdContent, filename: filename, savedAt: new Date().toISOString() });
    }
    if (!lsSet(LS_ALL_DOCS_KEY, JSON.stringify(allDocs))) return;

    currentLocalId = savedId;
    currentFilename = filename;
    document.getElementById('filenameInput').value = filename;
    isDirty = false;
    scheduleDraftSave();   // 새로고침 뒤에도 같은 문서에 이어서 저장되도록

    showToast(existing ? `"${filename}" 문서를 새 내용으로 저장했어요` : `"${filename}" 이름으로 브라우저에 저장했어요`);
  }

  function openLoadModal() {
    _closeOpenMenu();

    const allDocs = readAllDocs();

    const docsList = document.getElementById('docsList');
    docsList.innerHTML = allDocs.length ? allDocs
      .sort((a, b) => new Date(b.savedAt) - new Date(a.savedAt))
      .map(doc => `
        <li style="padding:0.5rem 0.25rem; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; gap:0.5rem;">
          <button type="button" class="doc-open" data-act="load-local" data-id="${esc(doc.id)}">
            <span class="doc-name">${esc(doc.filename)}</span>
            <span class="doc-meta">${esc(new Date(doc.savedAt).toLocaleString('ko-KR'))}</span>
          </button>
          <button type="button" class="doc-del" data-act="del-local" data-id="${esc(doc.id)}" aria-label="${esc(doc.filename)} 삭제">${VUI.icon('trash-2')}삭제</button>
        </li>
      `).join('') : '<li style="padding:0.75rem 0; color:var(--fg-muted); font-size:0.85rem;">이 기기에 저장된 파일이 없어요.</li>';

    renderMdServerDocs();   // 코드 연결 시에만 서버 목록 표시(미연결이면 로컬만)

    document.getElementById('loadModalBackdrop').style.display = 'block';
    document.getElementById('loadModal').style.display = 'block';
    document.body.classList.add('modal-open');
    loadM.open();   // 접근성(포커스 가두기·ESC·포커스 복귀). 이미 열려 있으면(삭제 후 다시 그리기) 그대로
  }

  function closeLoadModal() {
    document.getElementById('loadModalBackdrop').style.display = 'none';
    document.getElementById('loadModal').style.display = 'none';
    document.body.classList.remove('modal-open');
    loadM.close();
  }
  // 열기 모달: 보이기·숨기기는 위 함수가 하고(배경이 따로 있는 구조), VUI는 접근성만. ESC → closeLoadModal
  const loadM = VUI.modal.bind('#loadModal', { manual: true, label: '저장된 파일 열기', onClose: () => closeLoadModal() });
  // 목록을 다시 그리면 누른 삭제 버튼이 사라지므로 포커스를 목록의 첫 버튼(없으면 닫기)으로
  function focusLoadList(listId) {
    const t = document.getElementById(listId).querySelector('button') || document.getElementById('loadModalClose');
    if (t) t.focus();
  }

  function loadDocById(id) {
    const doc = readAllDocs().find(d => d.id === id);
    if (!doc) {
      showError('문서를 찾을 수 없어요');
      return;
    }
    applyMdDoc(doc, doc.id);
  }

  // localId: 브라우저 저장 목록에서 연 문서면 그 id(다음 '브라우저에 저장'이 이 문서를 덮어씀)
  async function applyMdDoc(doc, localId) {
    if (mdContent.trim() && !(await confirmReplaceDoc())) return;
    mdContent = typeof doc.content === 'string' ? doc.content : '';
    currentFilename = (typeof doc.filename === 'string' && doc.filename) ? doc.filename : 'untitled.md';
    currentLocalId = localId || null;
    document.getElementById('filenameInput').value = currentFilename;
    document.getElementById('editor').value = mdContent;
    renderPreview();
    markLoaded();
    updateSaveButtonState();
    closeLoadModal();
    showToast(`"${currentFilename}" 문서를 열었어요`);
  }

  async function deleteDocById(id) {
    const target = readAllDocs().find(d => d.id === id);
    const label = target && target.filename ? `"${target.filename}" 문서를` : '이 문서를';
    if (!(await VUI.confirm(`${label} 이 브라우저에서 지울까요? 지운 문서는 되살릴 수 없어요.`, { title: '문서 지우기', ok: '지우기', danger: true }))) return;

    const allDocs = readAllDocs().filter(d => d.id !== id);
    if (!lsSet(LS_ALL_DOCS_KEY, JSON.stringify(allDocs))) return;
    if (currentLocalId === id) { currentLocalId = null; scheduleDraftSave(); }   // 다음 저장은 새 문서로
    showToast('문서를 지웠어요');

    openLoadModal(); // 모달 새로고침
    focusLoadList('docsList');
  }

  // ── 코드(서버) 저장/열기 — VivesSync set 모드 라이브러리 ──
  const mdLib = window.VivesSync ? VivesSync.docStore({ apiUrl: '/api/md-editor' }) : null;
  let serverDocs = [];

  async function saveDocToServer() {
    _closeSaveMenu();
    if (!mdContent.trim()) { showToast('저장할 내용이 없어요'); return; }
    if (!mdLib) { showError('동기화를 사용할 수 없어요'); return; }
    const hadCode = VivesSync.getCode();
    const code = hadCode || VivesSync.ensureCode();
    const filename = document.getElementById('filenameInput').value.trim() || 'untitled.md';
    const id = Date.now().toString();
    const ok = await mdLib.save(code, id, { id, content: mdContent, filename, savedAt: new Date().toISOString() });
    if (!hadCode && mdCodeBtn) mdCodeBtn.refresh();   // 자동 발급 코드를 상단 버튼에 반영
    if (ok) isDirty = false;
    if (ok) showToast(`코드 ${code}에 저장했어요. 오른쪽 위 동기화 버튼의 코드를 다른 기기에 넣으면 열 수 있어요`);
    else showToast('서버에 저장하지 못했어요. 연결을 확인하고 다시 해 주세요.', 'error');
  }

  async function renderMdServerDocs() {
    const sec = document.getElementById('mdServerSection'), list = document.getElementById('serverDocsList');
    const code = window.VivesSync && VivesSync.getCode();
    if (!code || !mdLib) { sec.hidden = true; return; }
    sec.hidden = false; document.getElementById('mdCodeTag').textContent = code;
    list.innerHTML = '<li style="padding:0.6rem 0; color:var(--fg-muted); font-size:0.85rem;">불러오는 중…</li>';
    serverDocs = await mdLib.list(code);
    list.innerHTML = serverDocs.length ? serverDocs.map(s => {
      const v = s.value || {};
      const when = v.savedAt ? new Date(v.savedAt).toLocaleString('ko-KR') : '';
      return `<li style="padding:0.5rem 0.25rem; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; gap:0.5rem;">
        <button type="button" class="doc-open" data-act="load-server" data-id="${esc(s.id)}">
          <span class="doc-name">${esc(v.filename || '제목 없음')}</span>
          <span class="doc-meta">${esc(when)}</span>
        </button>
        <button type="button" class="doc-del" data-act="del-server" data-id="${esc(s.id)}" aria-label="${esc(v.filename || '제목 없음')} 삭제">${VUI.icon('trash-2')}삭제</button>
      </li>`;
    }).join('') : '<li style="padding:0.6rem 0; color:var(--fg-muted); font-size:0.85rem;">이 코드로 저장한 문서가 없어요. <b>저장</b> 메뉴의 <b>코드로 저장</b>으로 저장해 보세요.</li>';
  }
  window.loadServerDoc = function (id) {
    const s = serverDocs.find(x => String(x.id) === String(id));
    if (s && s.value && typeof s.value.content === 'string') applyMdDoc(s.value);
    else showError('문서를 불러올 수 없어요');
  };
  window.deleteServerDoc = async function (id) {
    const s = serverDocs.find(x => String(x.id) === String(id));
    const fname = s && s.value && s.value.filename;
    const label = fname ? `"${fname}" 문서를` : '이 문서를';
    if (!(await VUI.confirm(`${label} 코드 저장소에서 지울까요? 이 코드를 쓰는 모든 기기에서 사라지고 되살릴 수 없어요.`, { title: '문서 지우기', ok: '지우기', danger: true }))) return;
    const code = VivesSync.getCode(); if (!code) return;
    // remove()는 실패해도 예외 없이 false를 반환한다 — 알리지 않으면 목록만 그대로라 사용자는 이유를 알 수 없다.
    const ok = await mdLib.remove(code, id);
    showToast(ok ? '문서를 삭제했어요' : '삭제하지 못했어요. 연결을 확인하고 다시 시도해 주세요', ok ? undefined : 'error');
    await renderMdServerDocs();
    focusLoadList('serverDocsList');
  };
  window.saveDocToServer = saveDocToServer;

  // 목록 클릭은 data-* + 이벤트 위임(문서 이름·id를 인라인 onclick에 넣지 않음)
  document.getElementById('loadModal').addEventListener('click', (e) => {
    const el = e.target.closest('[data-act]');
    if (!el) return;
    const id = el.dataset.id;
    const act = el.dataset.act;
    if (act === 'load-local') loadDocById(id);
    else if (act === 'del-local') deleteDocById(id);
    else if (act === 'load-server') window.loadServerDoc(id);
    else if (act === 'del-server') window.deleteServerDoc(id);
  });

  // 우상단 통합 '동기화' 버튼으로 코드 관리. 연결/해제 시 열기 모달이 떠 있으면 서버 목록 갱신.
  const mdCodeBtn = window.VivesSync ? VivesSync.mountCodeButton({
    appName: '문서',
    onChange: () => { if (loadM.isOpen()) renderMdServerDocs(); },
  }) : null;

  // ── Markdown 저장 ──
  function downloadMd() {
    _closeSaveMenu();
    const filename = document.getElementById('filenameInput').value.trim() || 'untitled.md';
    const fname = /\.(md|txt|markdown)$/i.test(filename) ? filename : filename + '.md';
    const blob = new Blob([mdContent], { type: 'text/markdown;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = fname;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    isDirty = false;
  }

  // ── HTML 저장 ──
  function downloadHtml() {
    _closeSaveMenu();
    const filename = document.getElementById('filenameInput').value.trim() || 'untitled';
    // untitled.md → untitled.html (확장자 .md를 떼고 붙임)
    const base = filename.replace(/\.(md|markdown|txt)$/i, '') || 'untitled';
    const fname = /\.html?$/i.test(base) ? base : base + '.html';
    const htmlContent = `<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${esc(base)}</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', sans-serif; max-width: 900px; margin: 0 auto; padding: 2rem; line-height: 1.75; color: #333; }
    h1 { border-bottom: 2px solid #e4e4e7; padding-bottom: 0.3em; }
    h2 { border-bottom: 1px solid #e4e4e7; padding-bottom: 0.2em; }
    code { background: #f4f4f5; padding: 0.15em 0.4em; border-radius: 4px; font-family: monospace; }
    pre { background: #f4f4f5; padding: 1rem; border-radius: 0.5rem; overflow-x: auto; }
    a { color: #006fee; text-decoration: underline; }
    blockquote { border-left: 4px solid #006fee; margin: 0.75em 0; padding: 0.25em 1em; color: #666; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #e4e4e7; padding: 0.4em 0.75em; text-align: left; }
    th { background: #f4f4f5; }
  </style>
</head>
<body>
  ${renderMarkdown(mdContent)}
  <hr style="margin-top: 3rem; border: none; border-top: 1px solid #e4e4e7;">
  <p style="font-size: 0.85rem; color: #888;">eduin VIVES 마크다운 편집기로 만든 문서</p>
</body>
</html>`;
    const blob = new Blob([htmlContent], { type: 'text/html;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = fname;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    isDirty = false;
  }

  // ── 공유 인코딩/디코딩 ──
  function buildShareURL(permission) {
    // 새 인코딩: UTF-8 base64url(VUI.share.encode) — 한글이 옛 btoa(encodeURIComponent()) 방식보다 약 3배 짧다.
    // 그래도 링크가 너무 길면 단축·메신저에서 잘리므로, 실제 링크 길이로 상한을 건다.
    const encoded = VUI.share.encode({
      data: { content: mdContent, filename: currentFilename },
      permission,
    });
    const url = `${location.origin}/apps/md-editor/#share=${encoded}`;
    if (url.length > SHARE_URL_MAX) return { url: null, tooLarge: true };
    return { url, tooLarge: false };
  }
  const SHARE_URL_MAX = 8000;

  // 새 형식·옛 형식(btoa(encodeURIComponent(json))) 모두 읽는다(VUI.share.decode)
  function decodeSharePayload(encoded) {
    const p = VUI.share.decode(encoded, o => o && o.data && typeof o.data.content === 'string');
    if (!p) return null;
    // 받은 값은 필요한 필드만, 형식을 맞춰서 쓴다
    const fn = typeof p.data.filename === 'string' ? p.data.filename.trim().slice(0, 120) : '';
    return {
      data: { content: p.data.content, filename: fn || 'shared.md' },
      permission: p.permission === 'view' ? 'view' : 'clone',
    };
  }

  // ── 공유 드롭다운 ──
  function toggleShareMenu(e) {
    if (!mdContent.trim()) { showToast('내용이 없어 공유할 수 없어요.'); return; }
    e.stopPropagation();
    closeAllMenus();  // 다른 메뉴 먼저 닫기
    const dd = document.getElementById('share-dropdown');
    const rect = e.currentTarget.getBoundingClientRect();
    dd.style.top = (rect.bottom + 6) + 'px';
    dd.style.right = (window.innerWidth - rect.right) + 'px';
    _shareMenuOpen = !_shareMenuOpen;
    dd.classList.toggle('open', _shareMenuOpen);
    if (_shareMenuOpen) {
      setTimeout(() => document.addEventListener('click', _closeShareMenu, { once: true }), 0);
    }
  }

  function _closeShareMenu() {
    document.getElementById('share-dropdown').classList.remove('open');
    _shareMenuOpen = false;
  }

  // ── 공유 실행 ──
  async function doShare(permission) {
    _closeShareMenu();
    const result = buildShareURL(permission);
    if (result.tooLarge) {
      showToast('글이 길어서 링크로 공유할 수 없어요. 파일로 저장해서 전달해 주세요.', 5000);
      return;
    }
    // 단축(실패하면 원래 링크) → 복사. 복사가 안 되면 링크 창(입력칸 + 복사 버튼)
    await VUI.share.link(result.url, permission === 'view'
      ? { title: '보기 전용 링크', desc: '링크를 연 사람은 이 문서를 읽기만 할 수 있어요.' }
      : { title: '복제 허용 링크', desc: '링크를 연 사람은 이 문서를 자기 편집기로 가져갈 수 있어요.' });
  }

  // ── 보기 전용 진입 ──
  function enterViewOnly() {
    isViewOnly = true;
    document.body.classList.add('is-view-only');
    document.getElementById('editor').setAttribute('readonly', '');
    closeCloneModal();
    showToast('보기 전용으로 열었어요');
  }

  // ── 복제 (편집 가능으로 전환) ──
  // 이 기기에 임시 저장된 다른 글이 있으면 먼저 묻는다(가져온 글을 고치는 순간 임시 저장본이 바뀌므로)
  async function cloneContent() {
    const fromModal = cloneM.isOpen();
    closeCloneModal();
    const draft = readDraft();
    if (draft && draft.content !== mdContent) {
      const dname = typeof draft.filename === 'string' && draft.filename.trim() ? draft.filename.trim() : '제목 없음';
      const ok = await VUI.confirm(`이 기기에 쓰던 글 "${dname}"이(가) 있어요. 공유받은 글을 가져와 고치면 쓰던 글은 사라져요. 필요하면 먼저 그 글을 열어 저장해 두세요.`, {
        title: '쓰던 글이 있어요', ok: '공유받은 글 가져오기', cancel: '취소', danger: true,
      });
      if (!ok) {
        if (fromModal) openCloneModal(currentFilename);
        else showToast('쓰던 글은 그대로 두었어요. 이 창을 새로 고치면 다시 열려요.');
        return;
      }
    }
    isViewOnly = false;
    isDirty = true;   // 가져온 글은 아직 어디에도 저장되지 않음
    currentLocalId = null;
    document.body.classList.remove('is-view-only');
    document.getElementById('editor').removeAttribute('readonly');
    showToast('편집할 수 있게 가져왔어요');
  }

  // ── 복제 모달 (접근성: VUI.modal — ESC = 취소) ──
  const cloneM = VUI.modal.bind('#clone-modal', { className: 'open', dialog: '.md-modal' });
  function openCloneModal(filename) {
    document.getElementById('clone-modal-desc').textContent = `"${filename}"을 어떻게 열까요?`;
    cloneM.open();
  }

  function closeCloneModal() {
    cloneM.close();
  }

  // ── 도움말 모달 (배경 클릭·ESC·닫기 버튼으로 닫힘) ──
  const helpM = VUI.modal.bind('#help-modal', { className: 'open', dialog: '.md-modal', backdropClose: true });
  function openHelpModal() {
    helpM.open();
  }

  // ── 드롭다운 메뉴: ESC로 닫기 ──
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && (_shareMenuOpen || _saveMenuOpen || _viewMenuOpen || _openMenuOpen)) closeAllMenus();
  });

  // ── 토스트 (공용 VUI) ──
  // opts: 숫자(ms) 또는 'error' 또는 {type, duration}. duration 0이면 hideToast()를 부를 때까지(문서 변환 중 안내)
  function showToast(msg, opts) {
    if (typeof opts === 'number') opts = { duration: opts };
    else if (typeof opts === 'string') opts = { type: opts };
    opts = opts || {};
    VUI.toast(msg, { type: opts.type, duration: opts.duration === 0 ? 120000 : opts.duration });
  }
  function showError(msg, duration) {
    showToast(msg, { type: 'error', duration });
  }
  function hideToast() {
    VUI.toast.hide();
  }

  // ── 초기화 (URL 해시 처리) ──
  (function init() {
    const hash = location.hash;
    if (hash.startsWith('#share=')) {
      const payload = decodeSharePayload(hash.slice(7));
      history.replaceState(null, '', location.pathname);
      if (payload && payload.data) {
        mdContent = payload.data.content || '';
        currentFilename = payload.data.filename || 'shared.md';
        currentLocalId = null;
        document.getElementById('filenameInput').value = currentFilename;
        document.getElementById('editor').value = mdContent;
        updateSaveButtonState();
        renderPreview();
        if (payload.permission === 'view') {
          enterViewOnly();
          switchMobileTab('preview');
        } else {
          openCloneModal(currentFilename);
          switchMobileTab('preview');
        }
        return;
      }
      showError('공유 링크를 읽을 수 없어요. 링크가 잘리지 않았는지 확인해 주세요.');
    } else {
      restoreDraft();   // 공유 링크가 아닐 때만 이 기기의 임시 저장본을 복원
    }
    updateSaveButtonState();
  })();
</script>



</AppLayout>
