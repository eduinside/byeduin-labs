<!-- 토스트·링크 창은 공용 VUI (/common/ui.js) -->

<script is:inline="">
  // @icons trash-2
  // marked·DOMPurify는 defer로 불러온다 → 이 스크립트보다 늦게, DOMContentLoaded 전에 준비된다.
  // 그 전에 그린 미리보기(원문 표시)는 준비된 뒤 다시 그린다.
  // breaks:true — 엔터 한 번이 그대로 줄바꿈(도움말 문구도 이 기준)
  function setupMarked() {
    if (window.marked) marked.setOptions({ breaks: true, gfm: true });
  }
  setupMarked();
  document.addEventListener('DOMContentLoaded', () => { setupMarked(); renderPreview(); });

  let mdContent = '';
  let currentFilename = 'untitled.md';
  let isViewOnly = false;
  let viewMode = 'both';  // 'edit-only', 'preview-only', 'both'
  let _shareMenuOpen = false;
  let _saveMenuOpen = false;
  let _viewMenuOpen = false;
  let _openMenuOpen = false;
  let isDirty = false;   // 마지막 저장·불러오기 이후 고친 내용이 있는지(이탈 경고용)
  let currentLocalId = null;   // 지금 문서가 '브라우저에 저장'된 문서라면 그 id(다시 저장하면 덮어씀)

  // ── localStorage 쓰기: 용량 초과 등 실패를 알린다 ──
  function lsSet(key, value) {
    try {
      localStorage.setItem(key, value);
      return true;
    } catch (e) {
      showError('브라우저 저장 공간이 꽉 찼어요. 안 쓰는 문서를 지우거나 파일로 저장해 주세요.', 6000);
      return false;
    }
  }

  // ── 자동 임시 저장(이 기기) ──
  const LS_DRAFT_KEY = 'md-editor-draft';
  let _draftTimer = null;
  function saveDraftNow() {
    clearTimeout(_draftTimer);
    _draftTimer = null;
    if (isViewOnly) return;
    try {
      if (mdContent.trim()) {
        // localId: 브라우저에 저장한 문서를 이어 쓰는 중이면 새로고침 뒤에도 같은 문서에 덮어쓰도록
        localStorage.setItem(LS_DRAFT_KEY, JSON.stringify({ content: mdContent, filename: currentFilename, savedAt: Date.now(), localId: currentLocalId || undefined }));
      } else {
        localStorage.removeItem(LS_DRAFT_KEY);
      }
    } catch (e) { /* 용량 초과 시 임시 저장만 건너뜀(이탈 경고는 그대로 동작) */ }
  }
  function scheduleDraftSave() {
    if (isViewOnly) return;
    clearTimeout(_draftTimer);
    _draftTimer = setTimeout(saveDraftNow, 800);
  }
  function clearDraft() {
    clearTimeout(_draftTimer);
    _draftTimer = null;
    try { localStorage.removeItem(LS_DRAFT_KEY); } catch (e) {}
  }
  function readDraft() {
    let d = null;
    try { d = JSON.parse(localStorage.getItem(LS_DRAFT_KEY) || 'null'); } catch (e) { d = null; }
    return (d && typeof d.content === 'string' && d.content.trim()) ? d : null;
  }
  function restoreDraft() {
    const d = readDraft();
    if (!d) return false;
    mdContent = d.content;
    currentFilename = (typeof d.filename === 'string' && d.filename.trim()) ? d.filename.slice(0, 120) : 'untitled.md';
    currentLocalId = typeof d.localId === 'string' ? d.localId : null;
    document.getElementById('filenameInput').value = currentFilename;
    document.getElementById('editor').value = mdContent;
    renderPreview();
    showToast('쓰던 글을 다시 불러왔어요');
    return true;
  }
  window.addEventListener('beforeunload', (e) => {
    if (_draftTimer) saveDraftNow();
    if (isDirty && !isViewOnly && mdContent.trim()) {
      e.preventDefault();
      e.returnValue = '';
    }
  });

  // 현재 문서를 덮어쓰기 전에 확인(Promise<boolean>)
  function confirmReplaceDoc() {
    if (!mdContent.trim()) return Promise.resolve(true);
    return VUI.confirm('지금 쓰던 문서를 새 내용으로 바꿀까요? 저장하지 않은 내용은 사라져요.', { title: '문서 바꾸기', ok: '바꾸기', danger: true });
  }

  // ── 모바일 탭 ──
  function switchMobileTab(tab) {
    document.getElementById('paneEdit').classList.toggle('mobile-active', tab === 'edit');
    document.getElementById('panePreview').classList.toggle('mobile-active', tab === 'preview');
    document.getElementById('mTabEdit').classList.toggle('active', tab === 'edit');
    document.getElementById('mTabPreview').classList.toggle('active', tab === 'preview');
  }

  // ── 새 문서 ──
  async function newDocument() {
    if (mdContent && !(await VUI.confirm('지금 문서를 닫고 새 문서를 만들까요? 저장하지 않은 내용은 사라져요.', { title: '새 문서', ok: '새 문서 만들기', danger: true }))) return;
    mdContent = '';
    currentFilename = 'untitled.md';
    currentLocalId = null;
    document.getElementById('filenameInput').value = currentFilename;
    document.getElementById('editor').value = '';
    isDirty = false;
    clearDraft();
    renderPreview();
    updateSaveButtonState();
    showToast('새 문서를 만들었습니다');
  }

  // ── 파일 이름 입력: 상태(공유 링크·임시 저장)에 바로 반영 ──
  function onFilenameInput(el) {
    if (isViewOnly) return;
    currentFilename = el.value.trim().slice(0, 120) || 'untitled.md';
    scheduleDraftSave();
  }

  // ── 에디터 입력 ──
  function onEditorInput(el) {
    if (isViewOnly) return;
    mdContent = el.value;
    isDirty = true;
    scheduleDraftSave();
    updateSaveButtonState();
    renderPreview();
  }

  // 파일·저장본을 불러온 직후: 깨끗한 상태로 보고 임시 저장도 갱신
  function markLoaded() {
    isDirty = false;
    scheduleDraftSave();
  }

  // ── 저장 버튼 상태 업데이트 ──
  function updateSaveButtonState() {
    // 저장 버튼은 항상 활성화 (클릭 시 내용 확인)
    const saveMdOpt = document.getElementById('saveMdOpt');
    const saveHtmlOpt = document.getElementById('saveHtmlOpt');
    const saveLsOpt = document.getElementById('saveLsOpt');
    saveMdOpt.disabled = false;
    saveHtmlOpt.disabled = false;
    saveLsOpt.disabled = false;
  }

  // marked가 단일 물결표(~)를 (범위 표기인데도) 취소선으로 오인하는 문제 방지.
  // 단일 ~만 보호 문자로 치환해 파싱 후 복원(~~…~~ 이중 물결표 취소선은 유지).
  const TILDE_SENTINEL = '@@TILDE_RANGE@@';
  // 공유 링크·불러온 파일의 HTML이 그대로 실행되지 않도록 DOMPurify로 정제한다.
  // marked/DOMPurify를 못 불러오면(학교망 차단 등) 이스케이프한 원문을 그대로 보여 준다.
  function renderMarkdown(text) {
    const raw = String(text == null ? '' : text);
    if (!window.marked || !window.DOMPurify) {
      return '<pre style="white-space:pre-wrap;word-break:break-word;">' + esc(raw) + '</pre>';
    }
    // 앞뒤에 ~가 없는 단일 ~만 치환(구형 Safari가 못 읽는 lookbehind 대신 ~ 묶음 길이로 판단)
    const src = raw.replace(/~+/g, m => (m.length === 1 ? TILDE_SENTINEL : m));
    const html = marked.parse(src).split(TILDE_SENTINEL).join('~');
    return DOMPurify.sanitize(html, { FORBID_TAGS: ['style', 'form'] });
  }

  // 변환된 마크다운 표의 머리글 행이 통째로 비어 있을 때(변환 과정에서 제목 줄이 본문으로 밀린 경우)
  // 첫 본문 행을 머리글로 끌어올린다. 라이브 편집을 방해하지 않도록 파일/변환 로드 시에만 호출.
  function normalizeTableHeaders(md) {
    if (!md || md.indexOf('|') === -1) return md;

    const splitCells = (line) => {
      let s = line.trim();
      if (s.startsWith('|')) s = s.slice(1);
      if (s.endsWith('|')) s = s.slice(0, -1);
      return s.split('|').map(c => c.trim());
    };
    const isRow = (line) => line != null && line.indexOf('|') !== -1;
    const isSeparator = (line) => {
      if (!isRow(line)) return false;
      const cells = splitCells(line);
      return cells.length > 0 && cells.every(c => /^:?-{1,}:?$/.test(c));
    };

    const lines = md.split('\n');
    const out = [];
    let fence = null;  // 코드펜스 마커(``` 또는 ~~~) 안에서는 표 처리를 건너뜀

    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];
      const fenceM = line.trim().match(/^(`{3,}|~{3,})/);
      if (fenceM) {
        if (!fence) fence = fenceM[1][0];
        else if (fenceM[1][0] === fence) fence = null;
        out.push(line);
        continue;
      }
      if (fence) { out.push(line); continue; }

      // 표 시작 패턴: 현재 줄=행, 다음 줄=구분선
      if (isRow(line) && !isSeparator(line) && isSeparator(lines[i + 1])) {
        const sep = lines[i + 1];
        const body = [];
        let j = i + 2;
        while (j < lines.length && isRow(lines[j]) && !isSeparator(lines[j])) {
          body.push(lines[j]);
          j++;
        }
        const headerCells = splitCells(line);
        const headerEmpty = headerCells.length > 0 && headerCells.every(c => c === '');
        const firstBodyHasText = body.length > 0 && splitCells(body[0]).some(c => c !== '');

        if (headerEmpty && firstBodyHasText) {
          out.push(body[0]);                 // 첫 본문 행 → 머리글로 승격
          out.push(sep);
          for (let k = 1; k < body.length; k++) out.push(body[k]);
        } else {
          out.push(line);
          out.push(sep);
          for (const b of body) out.push(b);
        }
        i = j - 1;
        continue;
      }

      out.push(line);
    }
    return out.join('\n');
  }

  function renderPreview() {
    document.getElementById('preview').innerHTML = renderMarkdown(mdContent);
  }

  // ── 파일 열기 ──
  async function handleFileLoad(input) {
    const file = input.files[0];
    if (!file) return;
    if (!(await confirmReplaceDoc())) { input.value = ''; return; }
    currentFilename = file.name;
    currentLocalId = null;
    document.getElementById('filenameInput').value = file.name;
    const reader = new FileReader();
    reader.onload = (e) => {
      mdContent = normalizeTableHeaders(e.target.result);
      document.getElementById('editor').value = mdContent;
      renderPreview();
      markLoaded();
      showToast('파일을 열었어요.');
    };
    reader.onerror = () => {
      showError('파일을 열 수 없어요.');
      input.value = '';
    };
    reader.readAsText(file, 'UTF-8');
    input.value = '';
  }

  // ── 모든 드롭다운 닫기 헬퍼 ──
  function closeAllMenus() {
    _closeSaveMenu();
    _closeOpenMenu();
    _closeViewMenu();
    _closeShareMenu();
  }

  // ── 문서 파일 변환(서버) — 파일을 /api/doc-parse(Corepin)로 보내 마크다운으로 바꾼다 ──
  function openDocFileInput() {
    document.getElementById('docFileInput').value = '';
    document.getElementById('docFileInput').click();
  }

  // 사용자가 손쓸 수 있는 경우(파일 크기·형식·손상)만 따로 알리고, 나머지(키·잔액·서버 사정)는 한 문구로
  const DOC_PARSE_BUSY = '지금은 변환할 수 없어요. 잠시 뒤 다시 해 보세요.';
  function _docParseErrorMsg(data, status) {
    if (status === 413) return '파일이 너무 커요. 50MB 이하 파일만 변환할 수 있어요.';
    if (status === 415) return '이 형식의 파일은 변환할 수 없어요.';
    if (status === 422) return '파일을 열 수 없어요. 손상되었거나 암호가 걸린 파일인지 확인해 주세요.';
    return DOC_PARSE_BUSY;
  }

  async function handleDocLoad(input) {
    const file = input.files[0];
    if (!file) return;
    if (!(await confirmReplaceDoc())) { input.value = ''; return; }

    const sizeMB = (file.size / 1024 / 1024).toFixed(1);
    if (file.size > 50 * 1024 * 1024) {
      showError(`파일이 너무 커요(${sizeMB}MB). 50MB 이하 파일만 변환할 수 있어요.`, 5000);
      input.value = '';
      return;
    }

    showToast(`변환 서버로 보내 바꾸는 중… ${file.name} (${sizeMB}MB) — 20초쯤 걸릴 수 있어요`, 0);
    const editor = document.getElementById('editor');
    editor.disabled = true;
    editor.classList.add('is-loading');

    try {
      const form = new FormData();
      form.append('file', file);
      form.append('output_format', 'markdown');

      let data;
      try {
        // 변환은 최대 20초 + 업로드 시간 — 시간 제한을 넉넉히
        data = await VUI.apiFetch('/api/doc-parse', { method: 'POST', body: form, timeout: 90000 });
      } catch (err) {
        // HTTP 오류는 상태별 안내(_docParseErrorMsg), 연결·시간 초과 등은 VUI의 한국어 문구
        throw new Error(err.status ? _docParseErrorMsg(err.data || {}, err.status) : (err.message || DOC_PARSE_BUSY));
      }
      if (!data || (!data.markdown && data.markdown !== '')) {
        throw new Error('변환된 내용이 없어요. 글자가 들어 있는 파일인지 확인해 주세요.');
      }

      mdContent = normalizeTableHeaders(data.markdown);
      currentFilename = file.name.replace(/\.[^.]+$/, '') + '.md';
      currentLocalId = null;
      document.getElementById('filenameInput').value = currentFilename;
      editor.value = mdContent;
      renderPreview();
      markLoaded();
      hideToast();
      const pages = data.meta?.page_count ? ` (${data.meta.page_count}쪽)` : '';
      showToast(`변환을 마쳤어요${pages}`);
    } catch (e) {
      hideToast();
      showError(e.message || DOC_PARSE_BUSY, 8000);
    } finally {
      editor.disabled = false;
      editor.classList.remove('is-loading');
      input.value = '';
    }
  }

  // ── 저장 드롭다운 ──
  function toggleSaveMenu(e) {
    if (!mdContent.trim()) { showToast('저장할 내용이 없습니다'); return; }
