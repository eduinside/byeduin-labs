---
import AppLayout from '../../../layouts/AppLayout.astro';
---
<AppLayout
  title="받아쓰기 도우미 — eduin VIVES"
  description="단원·난이도별 받아쓰기 급수표를 만들어 A4로 인쇄하고, 정확한 발음 표기와 함께 불러주며, 음운규칙별로 어디서 틀렸는지 분석해 지도 방향을 제안합니다."
  image="https://eduin.info/og-images/dictation.png"
  bodyShell="column"
  bodyWidth="medium"
  bodyPrint={true}
>
  <Fragment slot="head">
  <style is:global="">
    * { box-sizing: border-box; }
    [hidden] { display: none !important; }

    body {
      min-height: 100vh;
      padding: 54px 1rem 5rem;
      font-family: -apple-system, BlinkMacSystemFont, 'Pretendard', 'Inter', 'Segoe UI', sans-serif;
    }
    body::before {
      content: '';
      position: fixed; inset: 0;
      background-image:
        linear-gradient(rgba(0,111,238,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,111,238,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none; z-index: 0;
    }

    .dt-root { position: relative; z-index: 1; max-width: 720px; margin: 0 auto; }
    .app-header { margin-bottom: 18px; }

    /* ── 스텝 내비 ── */
    .dt-steps {
      display: flex; align-items: center; gap: 4px; flex-wrap: wrap;
      margin-bottom: 22px; padding: 8px; border: 1px solid var(--border);
      border-radius: 13px; background: var(--card-bg);
    }
    .dt-step {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 7px 12px; border-radius: 9px; border: none; background: none;
      font-size: 12px; font-weight: 600; color: var(--fg-muted);
      cursor: pointer; font-family: inherit; transition: all 0.15s; white-space: nowrap;
    }
    .dt-step .dt-step-num {
      display: inline-flex; align-items: center; justify-content: center;
      width: 18px; height: 18px; border-radius: 50%;
      background: var(--border); color: var(--fg-muted);
      font-size: 10px; font-weight: 700;
    }
    .dt-step.active { background: rgba(0,111,238,0.1); color: var(--primary); }
    .dt-step.active .dt-step-num { background: var(--primary); color: #fff; }
    .dt-step.done .dt-step-num { background: var(--success); color: #fff; }
    .dt-step:disabled { opacity: 0.45; cursor: not-allowed; }
    .dt-step-sep { color: var(--border); font-size: 11px; user-select: none; }

    /* ── 카드 · 섹션 ── */
    .dt-card {
      background: var(--card-bg); border: 1px solid var(--border);
      border-radius: 16px; padding: 20px; margin-bottom: 16px;
      animation: fadeUp 0.22s ease both;
    }
    .dt-section-title {
      font-size: 11px; font-weight: 700; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--fg-muted); margin: 0 0 14px;
      display: flex; align-items: center; gap: 8px;
    }
    .dt-section-title::after { content: ''; flex: 1; height: 1px; background: var(--border); }
    .dt-label { display: block; font-size: 12px; font-weight: 600; color: var(--fg-muted); margin-bottom: 8px; }
    .dt-field { margin-bottom: 18px; }
    .dt-field:last-child { margin-bottom: 0; }

    /* ── 버튼 ── */
    .dt-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      padding: 9px 16px; border-radius: 10px; border: 1px solid var(--border);
      background: var(--card-bg); color: var(--fg);
      font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit;
      white-space: nowrap; transition: all 0.15s; min-height: 40px; text-decoration: none;
    }
    .dt-btn:hover { border-color: var(--primary); color: var(--primary); }
    .dt-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .dt-btn.primary { background: var(--primary); border-color: var(--primary); color: #fff; }
    .dt-btn.primary:hover { background: var(--primary-h); color: #fff; }
    .dt-btn.ghost { background: none; }
    .dt-btn.success { background: rgba(23,201,100,0.10); border-color: transparent; color: var(--success); }
    .dt-btn.success:hover { background: rgba(23,201,100,0.20); }
    .dt-btn-row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 4px; }
    .dt-btn-row .grow { flex: 1; }

    /* ── 선택 칩 (유형·난이도) ── */
    .dt-chips { display: flex; gap: 8px; flex-wrap: wrap; }
    .dt-chip {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 9px 14px; border-radius: 99px; border: 1px solid var(--border);
      background: var(--bg); color: var(--fg-muted);
      font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit;
      transition: all 0.15s; user-select: none;
    }
    .dt-chip input { display: none; }
    .dt-chip.on { background: rgba(0,111,238,0.1); border-color: var(--primary); color: var(--primary); }

    /* ── 셀렉트 · 숫자 입력 ── */
    .dt-select, .dt-number {
      width: 100%; background: var(--bg); border: 1px solid var(--border);
      border-radius: 10px; padding: 10px 12px; font-size: 14px;
      color: var(--fg); outline: none; font-family: inherit; transition: border-color 0.2s;
    }
    .dt-select:focus, .dt-number:focus { border-color: var(--primary); }
    .dt-count-wrap { display: flex; align-items: center; gap: 8px; }
    .dt-count-wrap .dt-number { width: 84px; text-align: center; }
    .dt-count-btn {
      width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--border);
      background: var(--bg); color: var(--fg); font-size: 17px; font-weight: 700;
      cursor: pointer; font-family: inherit; transition: all 0.15s;
    }
    .dt-count-btn:hover { border-color: var(--primary); color: var(--primary); }

    /* ── 태그 · 난이도 배지 ── */
    .dt-tag {
      display: inline-flex; align-items: center;
      padding: 2px 8px; border-radius: 99px;
      background: rgba(0,111,238,0.08); color: var(--primary);
      font-size: 10.5px; font-weight: 700; letter-spacing: 0.02em; white-space: nowrap;
    }
    .dt-tag.none { background: var(--bg-sec); color: var(--fg-muted); }
    .dt-diff { font-size: 10.5px; font-weight: 700; padding: 2px 8px; border-radius: 99px; white-space: nowrap; }
    .dt-diff.d1 { background: rgba(23,201,100,0.10); color: var(--success); }
    .dt-diff.d2 { background: rgba(245,165,36,0.12); color: #f5a524; }
    .dt-diff.d3 { background: rgba(243,18,96,0.10); color: var(--danger); }

    /* ── 급수표 리스트 ── */
    .dt-toolbar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 14px; }
    .dt-toolbar .spacer { flex: 1; }
    .dt-list { display: flex; flex-direction: column; gap: 6px; }
    .dt-item {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 12px; border: 1px solid var(--border); border-radius: 11px;
      background: var(--bg); animation: fadeUp 0.2s ease both;
    }
    .dt-item-num {
      flex: none; width: 26px; height: 26px; border-radius: 8px;
      display: inline-flex; align-items: center; justify-content: center;
      background: var(--bg-sec); color: var(--fg-muted);
      font-size: 12px; font-weight: 700;
    }
    .dt-item-text { flex: 1; font-size: 14px; font-weight: 600; min-width: 0; overflow-wrap: anywhere; }
    .dt-item-text.masked { color: var(--fg-muted); letter-spacing: 0.2em; }
    .dt-item-meta { display: flex; gap: 4px; flex-wrap: wrap; justify-content: flex-end; }

    /* ── 불러주기(교사 낭독) ── */
    .dt-read-note {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 14px; border-radius: 11px; margin-bottom: 14px;
      background: rgba(245,165,36,0.10); color: #b45309;
      font-size: 12.5px; font-weight: 600; line-height: 1.5;
    }
    [data-theme="dark"] .dt-read-note { color: #fbbf24; }
    .dt-read-card {
      text-align: center; padding: 34px 20px 28px;
      border: 1px solid var(--border); border-radius: 16px; background: var(--bg);
    }
    .dt-read-kind { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--fg-muted); margin-bottom: 14px; }
    .dt-read-text { font-size: 30px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.4; overflow-wrap: anywhere; }
    .dt-read-pron { margin-top: 10px; font-size: 16px; font-weight: 600; color: var(--primary); }
    .dt-read-pron .lbl { font-size: 11px; font-weight: 700; color: var(--fg-muted); margin-right: 6px; letter-spacing: 0.08em; }
    .dt-read-tags { margin-top: 16px; display: flex; gap: 5px; justify-content: center; flex-wrap: wrap; }
    .dt-read-progress { margin: 18px 0 10px; }
    .dt-progress-bar { height: 5px; background: var(--border); border-radius: 99px; overflow: hidden; }
    .dt-progress-fill { height: 100%; width: 0%; background: var(--primary); border-radius: 99px; transition: width 0.3s ease; }
    .dt-read-counter { text-align: center; font-size: 12px; font-weight: 700; color: var(--fg-muted); margin-top: 8px; }
    .dt-read-ctrl { display: flex; gap: 8px; justify-content: center; margin-top: 14px; flex-wrap: wrap; }

    /* ── 채점 입력 그리드 ── */
    .dt-grade-grid { display: flex; flex-direction: column; gap: 8px; }
    .dt-grade-row { display: flex; align-items: center; gap: 10px; }
    .dt-grade-row .dt-input {
      flex: 1; background: var(--bg); border: 1px solid var(--border);
      border-radius: 10px; padding: 10px 12px; font-size: 15px;
      color: var(--fg); outline: none; font-family: inherit; transition: border-color 0.2s; min-width: 0;
    }
    .dt-grade-row .dt-input:focus { border-color: var(--primary); }
    .dt-grade-row .dt-input.ok { border-color: var(--success); background: rgba(23,201,100,0.06); }
    .dt-grade-row .dt-input.bad { border-color: var(--danger); background: rgba(243,18,96,0.05); }
    .dt-grade-mark { flex: none; width: 22px; text-align: center; font-size: 15px; font-weight: 700; }
    .dt-grade-mark.ok { color: var(--success); }
    .dt-grade-mark.bad { color: var(--danger); }

    /* ── 결과 ── */
    .dt-score-band { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 4px; }
    .dt-score-tile {
      flex: 1; min-width: 130px; text-align: center;
      padding: 16px 10px; border: 1px solid var(--border); border-radius: 13px; background: var(--bg);
    }
    .dt-score-tile .v { font-size: 26px; font-weight: 700; letter-spacing: -0.02em; }
    .dt-score-tile .v.good { color: var(--success); }
    .dt-score-tile .v.warn { color: var(--danger); }
    .dt-score-tile .k { font-size: 11px; font-weight: 700; color: var(--fg-muted); margin-top: 4px; letter-spacing: 0.06em; }
    .dt-rule-rows { display: flex; flex-direction: column; gap: 10px; }
    .dt-rule-row { display: grid; grid-template-columns: 110px 1fr 52px; align-items: center; gap: 10px; }
    .dt-rule-row .name { font-size: 12.5px; font-weight: 700; }
    .dt-rule-row .bar { height: 10px; background: var(--border); border-radius: 99px; overflow: hidden; }
    .dt-rule-row .bar > i { display: block; height: 100%; background: var(--danger); border-radius: 99px; transition: width 0.4s ease; }
    .dt-rule-row .bar > i.low { background: var(--success); }
    .dt-rule-row .pct { font-size: 12px; font-weight: 700; color: var(--fg-muted); text-align: right; }
    .dt-guide {
      border: 1px solid var(--border); border-radius: 13px; background: var(--bg);
      padding: 14px 16px; margin-bottom: 10px;
    }
    .dt-guide .g-rule { font-size: 12px; font-weight: 700; color: var(--primary); margin-bottom: 6px; }
    .dt-guide .g-text { font-size: 13.5px; line-height: 1.65; }
    .dt-guide .g-text .ex { color: var(--fg-muted); }
    .dt-empty { text-align: center; color: var(--fg-muted); font-size: 13px; padding: 26px 0; }

    /* ── 토스트 ── */
    #fd-toast {
      position: fixed; bottom: 2rem; left: 50%;
      transform: translateX(-50%) translateY(1rem);
      background: var(--fg); color: var(--bg);
      padding: 10px 18px; border-radius: 10px;
      font-size: 13px; font-weight: 600;
      opacity: 0; pointer-events: none;
      transition: opacity 0.2s, transform 0.2s; z-index: 9999;
    }
    #fd-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── 인쇄 (급수표 / 답안지) ── */
    .dt-print-area { display: none; }
    @media print {
      body { padding: 0; background: #fff; }
      body::before { display: none; }
      .dt-root, .top-overlay, .top-overlay-left, #fd-toast { display: none !important; }
      .dt-print-area.printing { display: block; }
      .dt-print-sheet { font-family: 'Pretendard', sans-serif; color: #111; padding: 10mm 6mm; }
      .dt-print-title { font-size: 18pt; font-weight: 700; margin-bottom: 2mm; }
      .dt-print-sub { font-size: 10pt; color: #555; margin-bottom: 8mm; }
      .dt-print-row { display: flex; align-items: baseline; gap: 5mm; padding: 3.2mm 0; border-bottom: 1px solid #ddd; break-inside: avoid; }
      .dt-print-row .n { flex: none; width: 9mm; font-size: 12pt; font-weight: 700; }
      .dt-print-row .t { font-size: 13pt; letter-spacing: 0.03em; }
      .dt-print-row .blank { flex: 1; border-bottom: 1.2pt solid #999; min-height: 11mm; }
      .dt-print-meta { display: flex; gap: 10mm; font-size: 10pt; margin-bottom: 6mm; }
      .dt-print-meta .slot { border-bottom: 1pt solid #999; min-width: 34mm; display: inline-block; }
    }

    @media (max-width: 540px) {
      .dt-read-text { font-size: 24px; }
      .dt-rule-row { grid-template-columns: 88px 1fr 44px; }
    }
  </style>
  </Fragment>

  <!-- 플로팅 크롬(홈·테마·공유)은 app-shell.js가 주입합니다 -->
  <main class="app-main">
    <div class="dt-root">
      <div class="app-header">
        <div class="app-badge">◆ 학습지원</div>
        <h1 class="app-title">✏️ 받아쓰기 도우미</h1>
        <p class="app-desc">급수표를 만들어 인쇄하고, 정확한 발음으로 불러주고, 음운규칙별로 오류를 분석합니다.</p>
      </div>

      <!-- ── 스텝 내비 ── -->
      <nav class="dt-steps" aria-label="진행 단계">
        <button class="dt-step active" data-goto="setup"><span class="dt-step-num">1</span>출제</button>
        <span class="dt-step-sep">›</span>
        <button class="dt-step" data-goto="sheet" disabled><span class="dt-step-num">2</span>급수표</button>
        <span class="dt-step-sep">›</span>
        <button class="dt-step" data-goto="read" disabled><span class="dt-step-num">3</span>불러주기</button>
        <span class="dt-step-sep">›</span>
        <button class="dt-step" data-goto="grade" disabled><span class="dt-step-num">4</span>채점</button>
        <span class="dt-step-sep">›</span>
        <button class="dt-step" data-goto="result" disabled><span class="dt-step-num">5</span>결과</button>
      </nav>

      <!-- ══ VIEW 1 · 출제 ══ -->
      <section id="view-setup" class="dt-view">
        <div class="dt-card">
          <h2 class="dt-section-title">출제 조건</h2>

          <div class="dt-field">
            <label class="dt-label" for="unitSelect">단원</label>
            <select id="unitSelect" class="dt-select">
              <optgroup label="1학년 1학기">
                <option value="1-1-01">1학년 1학기 1단원 — 글자를 만들어요</option>
                <option value="1-1-02">1학년 1학기 2단원 — 받침이 있는 글자를 읽어요</option>
                <option value="1-1-03">1학년 1학기 3단원 — 낱말과 친해져요</option>
                <option value="1-1-04">1학년 1학기 4단원 — 생각을 나타내요</option>
                <option value="1-1-05">1학년 1학기 5단원 — 반갑게 인사해요</option>
                <option value="1-1-06">1학년 1학기 6단원 — 받침이 있는 글자</option>
                <option value="1-1-07">1학년 1학기 7단원 — 알맞은 낱말을 써요</option>
              </optgroup>
              <optgroup label="1학년 2학기">
                <option value="1-2-01">1학년 2학기 1단원 — 소리 내어 또박또박 읽어요</option>
                <option value="1-2-02">1학년 2학기 2단원 — 생각을 나타내요</option>
                <option value="1-2-03">1학년 2학기 3단원 — 그림일기를 써요</option>
                <option value="1-2-04">1학년 2학기 4단원 — 겪은 일을 말해요</option>
                <option value="1-2-05">1학년 2학기 5단원 — 다정하게 인사해요</option>
                <option value="1-2-06">1학년 2학기 6단원 — 받침이 있는 글자</option>
                <option value="1-2-07">1학년 2학기 7단원 — 무엇이 중요할까요</option>
                <option value="1-2-08">1학년 2학기 8단원 — 인물의 모습을 상상해요</option>
              </optgroup>
              <optgroup label="2학년 1학기">
                <option value="2-1-01" selected>2학년 1학기 1단원 — 만나서 반가워요!</option>
                <option value="2-1-02">2학년 1학기 2단원 — 말의 재미가 솔솔</option>
                <option value="2-1-03">2학년 1학기 3단원 — 겪은 일을 나타내요</option>
                <option value="2-1-04">2학년 1학기 4단원 — 분위기를 살려 읽어요</option>
                <option value="2-1-05">2학년 1학기 5단원 — 마음을 짐작해요</option>
                <option value="2-1-06">2학년 1학기 6단원 — 자신의 생각을 표현해요</option>
                <option value="2-1-07">2학년 1학기 7단원 — 마음을 담아서 말해요</option>
                <option value="2-1-08">2학년 1학기 8단원 — 다양한 작품을 감상해요</option>
              </optgroup>
              <optgroup label="2학년 2학기">
                <option value="2-2-01">2학년 2학기 1단원 — 장면을 상상하며</option>
                <option value="2-2-02">2학년 2학기 2단원 — 서로 존중해요</option>
                <option value="2-2-03">2학년 2학기 3단원 — 내용을 살펴요</option>
                <option value="2-2-04">2학년 2학기 4단원 — 마음을 전해요</option>
                <option value="2-2-05">2학년 2학기 5단원 — 바른 말로</option>
                <option value="2-2-06">2학년 2학기 6단원 — 자세히 설명해요</option>
                <option value="2-2-07">2학년 2학기 7단원 — 일이 일어난 차례대로</option>
                <option value="2-2-08">2학년 2학기 8단원 — 자랑스러운 우리 한글</option>
              </optgroup>
            </select>
          </div>

          <div class="dt-field">
            <span class="dt-label">유형</span>
            <div class="dt-chips" id="kindChips">
              <label class="dt-chip on"><input type="checkbox" value="낱말" checked>낱말</label>
              <label class="dt-chip on"><input type="checkbox" value="구절" checked>구절</label>
              <label class="dt-chip on"><input type="checkbox" value="문장" checked>문장</label>
            </div>
          </div>

          <div class="dt-field">
            <span class="dt-label">난이도</span>
            <div class="dt-chips" id="diffChips">
              <label class="dt-chip on"><input type="checkbox" value="하" checked>하</label>
              <label class="dt-chip on"><input type="checkbox" value="중" checked>중</label>
              <label class="dt-chip on"><input type="checkbox" value="상" checked>상</label>
            </div>
          </div>

          <div class="dt-field">
            <label class="dt-label" for="countInput">문항 수</label>
            <div class="dt-count-wrap">
              <button type="button" class="dt-count-btn" data-count="-1" aria-label="문항 수 줄이기">−</button>
              <input id="countInput" class="dt-number" type="number" min="1" max="40" value="10" inputmode="numeric">
              <button type="button" class="dt-count-btn" data-count="1" aria-label="문항 수 늘리기">＋</button>
            </div>
          </div>

          <div class="dt-field">
            <span class="dt-label">순서</span>
            <div class="dt-chips" id="orderChips">
              <label class="dt-chip on"><input type="radio" name="order" value="shuffle" checked>섞기</label>
