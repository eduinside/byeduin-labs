        if (mode === 'textbook') {
          textbookSections.forEach(el => { if (el) el.style.display = ''; });
          aiView.hidden = true;
          goto('setup');
        } else {
          textbookSections.forEach(el => { if (el) el.style.display = 'none'; });
          aiView.hidden = false;
          renderAiMode();
        }
      });
    });

    /* ── 칩 토글 ── */
    $$('.dt-chip input').forEach((input) => {
      input.addEventListener('change', () => {
        if (input.type === 'radio') {
          input.closest('.dt-chips').querySelectorAll('.dt-chip').forEach((c) => c.classList.remove('on'));
        }
        input.closest('.dt-chip').classList.toggle('on', input.checked);
      });
    });

    /* ── 문항 수 ± ── */
    $$('.dt-count-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const el = $('#countInput');
        el.value = Math.min(40, Math.max(1, (parseInt(el.value, 10) || 10) + parseInt(btn.dataset.count, 10)));
      });
    });

    /* ── 데이터 로더 (단일 단원) ── */
    function loadUnit(unitCode) {
      fetch('/apps/dictation/data/unit-' + unitCode + '.json')
        .then(r => {
          if (!r.ok) throw new Error('데이터를 불러오지 못했습니다.');
          return r.json();
        })
        .then(bank => {
          state.bank = bank;
          state.unit = unitCode;
          showToast(bank.unit + ' 데이터를 로드했습니다.');
        })
        .catch(err => {
          showToast('오류: ' + err.message);
        });
    }

    /* ── 전체 단원 병합 로더 (규칙별 연습용) ── */
    function loadAllUnits() {
      if (state.allBanks) return Promise.resolve(state.allBanks);

      const promises = ALL_UNIT_CODES.map(code =>
        fetch('/apps/dictation/data/unit-' + code + '.json')
          .then(r => r.ok ? r.json() : null)
          .catch(() => null)
      );

      return Promise.all(promises).then(results => {
        const merged = { '낱말': [], '구절': [], '문장': [] };
        results.forEach((bank, idx) => {
          if (!bank) return;
          const code = ALL_UNIT_CODES[idx];
          ['낱말', '구절', '문장'].forEach(k => {
            (bank[k] || []).forEach(item => {
              merged[k].push(Object.assign({}, item, { _unit: code }));
            });
          });
        });
        state.allBanks = merged;
        renderHelpStats(); // 통계 모달 업데이트
        return merged;
      });
    }

    // Select box change handler
    $('#unitSelect').addEventListener('change', (e) => {
      const val = e.target.value;
      if (val.startsWith('rule-')) {
        // 규칙별 모드: 전체 데이터 로드
        loadAllUnits().then(() => {
          state.unit = val;
          state.bank = { unit: val === 'rule-전체' ? '전체 규칙 종합 연습' : val.replace('rule-', '') + ' 집중 연습' };
          showToast(state.bank.unit + ' 모드 준비 완료.');
        });
      } else {
        loadUnit(val);
      }
    });

    // Helper for shuffling
    function shuffleArray(array) {
      const arr = array.slice();
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    /* ── 급수표 생성 ── */
    function generateItems() {
      const unitVal = $('#unitSelect').value;
      const isRuleMode = unitVal.startsWith('rule-');

      if (isRuleMode && !state.allBanks) {
        showToast('전체 단원 데이터 로딩 중입니다. 잠시만 기다려 주세요.');
        return;
      }
      if (!isRuleMode && !state.bank) {
        showToast('단원 데이터 로딩 중입니다. 잠시만 기다려 주세요.');
        return;
      }

      // Read filter options
      const kinds = $$('#kindChips .dt-chip.on input').map(el => el.value);
      const diffs = $$('#diffChips .dt-chip.on input').map(el => el.value);
      const count = parseInt($('#countInput').value, 10) || 10;
      const order = $('#orderChips .dt-chip.on input').value;

      if (kinds.length === 0) { showToast('최소 하나의 유형을 선택해 주세요.'); return; }
      if (diffs.length === 0) { showToast('최소 하나의 난이도를 선택해 주세요.'); return; }

      // Build pool
      let pool = [];
      const ruleFilter = isRuleMode ? unitVal.replace('rule-', '') : null;

      if (isRuleMode) {
        // Rule-based mode: pull from allBanks
        kinds.forEach(k => {
          (state.allBanks[k] || []).forEach(item => {
            if (!diffs.includes(item.difficulty)) return;
            if (ruleFilter !== '전체' && !item.tags.includes(ruleFilter)) return;
            pool.push(Object.assign({}, item, { kind: k }));
          });
        });
        state.bank = { unit: ruleFilter === '전체' ? '전체 규칙 종합 연습' : ruleFilter + ' 집중 연습' };
      } else {
        // Textbook mode: use loaded bank
        kinds.forEach(k => {
          const arr = state.bank[k] || [];
          arr.forEach(item => {
            if (diffs.includes(item.difficulty)) {
              pool.push(Object.assign({}, item, { kind: k }));
            }
          });
        });
      }

      if (pool.length === 0) {
        showToast('조건에 맞는 문항이 없습니다. 조건을 넓혀 주세요.');
        return;
      }

      let selected = order === 'shuffle' ? shuffleArray(pool) : pool;
      selected = selected.slice(0, count);

      state.items = selected;
      state.inputs = selected.map(() => '');
      state.results = null;
      state.readIndex = 0;

      renderSheet();
      renderGradeGrid();
      renderReadCard();
      unlockSteps('grade');
      goto('sheet');
      showToast('급수표 ' + state.items.length + '문항 생성 완료.');
    }

    $('#btnGenerate').addEventListener('click', generateItems);
    $('#btnReshuffle').addEventListener('click', () => {
      generateItems();
      showToast('다시 뽑기 완료.');
    });

    /* ── 급수표 렌더링 ── */
    function renderSheet() {
      if (!state.bank) return;
      $('#sheetUnitLabel').textContent = '· ' + state.bank.unit + ' · ' + state.items.length + '문항';
      $('#sheetList').innerHTML = state.items.map((it, i) =>
        '<div class="dt-item" style="animation-delay:' + (i * 0.03) + 's">' +
          '<span class="dt-item-num">' + (i + 1) + '</span>' +
          '<span class="dt-item-text' + (state.showAnswers ? '' : ' masked') + '">' +
            (state.showAnswers ? esc(it.text) : '●●●●●') + '</span>' +
          '<span class="dt-item-meta">' +
            it.tags.map((t) => '<span class="dt-tag' + (t.indexOf('없음') >= 0 ? ' none' : '') + '">' + esc(t) + '</span>').join('') +
            '<span class="dt-diff ' + DIFF_CLASS[it.difficulty] + '">' + it.difficulty + '</span>' +
          '</span>' +
        '</div>'
      ).join('');
    }
    $('#btnToggleAnswer').addEventListener('click', (e) => {
      state.showAnswers = !state.showAnswers;
      e.currentTarget.textContent = state.showAnswers ? '정답 숨기기' : '정답 보이기';
      e.currentTarget.setAttribute('aria-pressed', String(state.showAnswers));
      renderSheet();
    });

    /* ── 인쇄 ── */
    function printArea(id, rowsHtml) {
      // 다른 인쇄 영역의 printing 클래스를 모두 제거
      $$('.dt-print-area').forEach(el => el.classList.remove('printing'));
      const area = $('#' + id);
      area.querySelector('[id$="Rows"]').innerHTML = rowsHtml;
      area.classList.add('printing');
      window.print();
      area.classList.remove('printing');
    }
    $('#btnPrintSheet').addEventListener('click', () => {
      if (!state.bank) return;
      $('#printSheetUnit').textContent = state.bank.unit;
      printArea('printSheet', state.items.map((it, i) =>
        '<div class="dt-print-row"><span class="n">' + (i + 1) + '</span><span class="t">' + esc(it.text) + '</span></div>'
      ).join(''));
    });
    $('#btnPrintAnswer').addEventListener('click', () => {
      printArea('printAnswer', state.items.map((_, i) =>
        '<div class="dt-print-row"><span class="n">' + (i + 1) + '</span><span class="blank"></span></div>'
      ).join(''));
    });

    /* ── 불러주기(교사 낭독) 카드 ── */
    function renderReadCard() {
      const n = state.items.length;
      if (!n) return;
      const it = state.items[state.readIndex];
      $('#readKind').textContent = it.kind + ' · 난이도 ' + it.difficulty;
      $('#readText').textContent = it.text;
      $('#readPron').innerHTML = '<span class="lbl">발음</span>' + esc(it.pron || '[' + it.text.replace(/[.,!?…"""\\'()·]/g, '') + ']');
      $('#readTags').innerHTML = it.tags.map((t) =>
        '<span class="dt-tag' + (t.indexOf('없음') >= 0 ? ' none' : '') + '">' + esc(t) + '</span>').join('');
      $('#readProgress').style.width = ((state.readIndex + 1) / n * 100) + '%';
      $('#readCounter').textContent = (state.readIndex + 1) + ' / ' + n;
      $('#btnReadPrev').disabled = state.readIndex === 0;
      $('#btnReadNext').disabled = state.readIndex === n - 1;
    }
    $('#btnReadPrev').addEventListener('click', () => { state.readIndex = Math.max(0, state.readIndex - 1); renderReadCard(); });
    $('#btnReadNext').addEventListener('click', () => { state.readIndex = Math.min(state.items.length - 1, state.readIndex + 1); renderReadCard(); });
    $('#btnReadRestart').addEventListener('click', () => { state.readIndex = 0; renderReadCard(); });

    /* ── 채점 입력 그리드 ── */
    function renderGradeGrid() {
      $('#gradeGrid').innerHTML = state.items.map((_, i) =>
        '<div class="dt-grade-row">' +
          '<span class="dt-item-num">' + (i + 1) + '</span>' +
          '<input class="dt-input" data-idx="' + i + '" placeholder="학생이 쓴 그대로" autocomplete="off">' +
          '<span class="dt-grade-mark" data-mark="' + i + '"></span>' +
        '</div>'
      ).join('');
    }

    // Clean text for comparative grading (exclude spacing and punctuation)
    function cleanKoreanString(s) {
      return s.replace(/[.,!?…"""\\'()·\-\s]/g, '');
    }

    $('#btnGrade').addEventListener('click', () => {
      let correct = 0;
      const corrects = [];
      
      $$('#gradeGrid .dt-input').forEach((input) => {
        const i = parseInt(input.dataset.idx, 10);
        const userVal = input.value.trim();
        state.inputs[i] = userVal;
        
        const ok = cleanKoreanString(userVal) === cleanKoreanString(state.items[i].text);
        corrects.push(ok);
        
        input.classList.toggle('ok', ok);
        input.classList.toggle('bad', !ok);
        const mark = document.querySelector('[data-mark="' + i + '"]');
        mark.textContent = ok ? '○' : '✕';
        mark.className = 'dt-grade-mark ' + (ok ? 'ok' : 'bad');
        if (ok) correct++;
      });
      
      const n = state.items.length;
      $('#resScore').textContent = Math.round(correct / n * 100) + '점';
      $('#resCorrect').textContent = correct;
      $('#resWrong').textContent = n - correct;

      // Aggregate phonological rules mistakes
      const ruleErrors = {};
      RULE_TAGS.forEach(t => { ruleErrors[t] = { wrong: 0, asked: 0 }; });

      state.items.forEach((it, i) => {
        const isWrong = !corrects[i];
        it.tags.forEach(t => {
          if (ruleErrors[t] !== undefined) {
            ruleErrors[t].asked++;
            if (isWrong) ruleErrors[t].wrong++;
          }
        });
      });

      state.results = {
        score: Math.round(correct / n * 100),
        corrects: corrects,
        wrongCount: n - correct,
        byRule: ruleErrors
      };

      renderResult(ruleErrors);
      saveAttempt();
      unlockSteps('result');
      goto('result');
    });

    /* ── 결과 분석 및 지도안 렌더링 ── */
    const GUIDE_TEMPLATES = {
      '연음화': {
        title: '연음화 — 오답률 최다',
        text: '받침이 뒤 글자로 넘어가 소리 나는 낱말을 어려워해요. \'꽃잎[꼰닙]\'이나 \'무릎이[무르피]\'처럼 소리와 표기가 다름을 인지하고, 글자의 원형을 살려 적는 연습을 해 주세요.'
      },
      '경음화': {
        title: '경음화 — 오답률 최다',
        text: '된소리로 발음되지만 예사소리로 적는 문항에서 실수합니다. \'학교[학꾜]\'나 \'신발 끈[신발 끈]\'처럼 발음과 적는 법이 어떻게 다른지 소리 내어 확인하는 활동이 좋습니다.'
      },
      '격음화': {
        title: '격음화 — 오답률 최다',
        text: '거센소리로 축약되어 발음되는 단어에서 표기가 혼동될 수 있습니다. ‘축하[추카]’나 ‘따뜻해[따뜨태]’처럼 원형의 받침(ㅎ, ㄷ 등)을 의식해서 바르게 적도록 지도해 주세요.'
      },
      '비음화': {
        title: '비음화 — 오답률 최다',
        text: '받침이 자음 동화되어 ㄴ이나 ㅁ 등으로 발음되는 현상입니다. ‘낱말[난말]’이나 ‘입니다[임니다]’처럼 소리 나는 대로 받아적지 않도록 받침을 짚어 설명해 주세요.'
      },
      '겹받침_단순화': {
        title: '겹받침 단순화 — 오답률 최다',
        text: '두 개의 받침 중 하나만 소리 나는 낱말에서 받침 중 하나를 빠뜨리기 쉽습니다. ‘넓고[널고]’나 ‘앉아[안자]’처럼 겹받침의 표기를 소리 내어 읽으며 암기하도록 지도해 주세요.'
      },
      '받침없음/규칙없음': {
        title: '기초 낱말 쓰기 — 오답률 최다',
        text: '기본적인 받침이나 표기에서 실수하고 있습니다. 틀린 낱말을 소리 내어 천천히 읽어보고 한 글자씩 또박또박 써 보며 글자의 모양을 익히도록 도와주세요.'
      }
    };

    function renderResult(ruleErrors) {
      const listHtml = Object.keys(ruleErrors).map(name => {
        const stats = ruleErrors[name];
        const pct = stats.asked > 0 ? Math.round((stats.wrong / stats.asked) * 100) : 0;
        return { name, pct, asked: stats.asked };
      })
      .filter(row => row.asked > 0)
      .map(row => {
        return '<div class="dt-rule-row">' +
          '<span class="name">' + esc(row.name) + '</span>' +
          '<span class="bar"><i class="' + (row.pct < 34 ? 'low' : '') + '" style="width:' + row.pct + '%"></i></span>' +
          '<span class="pct">' + row.pct + '%</span>' +
        '</div>';
      }).join('');

      $('#ruleRows').innerHTML = listHtml || '<div class="dt-empty">충분한 음운 규칙 데이터가 없습니다.</div>';

      // Find worst rule tag (highest error percentage)
      let worstTag = '받침없음/규칙없음';
      let maxPct = -1;
      Object.keys(ruleErrors).forEach(name => {
        const stats = ruleErrors[name];
        const pct = stats.asked > 0 ? (stats.wrong / stats.asked) : 0;
        if (stats.asked > 0 && pct > maxPct) {
          maxPct = pct;
          worstTag = name;
        }
      });

      const guide = GUIDE_TEMPLATES[worstTag] || GUIDE_TEMPLATES['받침없음/규칙없음'];
      $('#guideBox').innerHTML =
        '<div class="dt-guide">' +
          '<div class="g-rule">' + esc(guide.title) + '</div>' +
          '<div class="g-text">' + esc(guide.text) + '</div>' +
        '</div>';
    }

    /* ── localStorage 회차 저장 ── */
    function saveAttempt() {
      if (!state.results) return;
      try {
        const saved = localStorage.getItem('dictation:attempts');
        const list = saved ? jsonParseSafe(saved) || [] : [];
        
        const attempt = {
          at: new Date().toISOString(),
          unit: state.unit,
          items: state.items.map((it, idx) => ({
            id: it.id,
            correct: state.results.corrects[idx],
            input: state.inputs[idx],
            wrongTags: state.results.corrects[idx] ? [] : it.tags
          })),
          byRule: state.results.byRule
        };
        
        list.push(attempt);
        localStorage.setItem('dictation:attempts', JSON.stringify(list));
      } catch (err) {
        console.error('LocalStorage 저장 오류:', err);
      }
    }

    function jsonParseSafe(s) {
      try { return JSON.parse(s); } catch (e) { return null; }
    }

    /* ── 복습 급수표 재출제 ── */
    $('#btnReviewSheet').addEventListener('click', () => {
      if (!state.results || state.results.wrongCount === 0) {
        showToast('틀린 문항이 없습니다. 축하합니다!');
        return;
      }

      const wrongItems = state.items.filter((_, idx) => !state.results.corrects[idx]);
      state.items = wrongItems.map(it => Object.assign({}, it));
      state.inputs = state.items.map(() => '');
      state.results = null;
      state.readIndex = 0;

      renderSheet();
      renderGradeGrid();
      renderReadCard();
      unlockSteps('grade');
      goto('sheet');
      showToast('틀린 문항 ' + state.items.length + '개로 복습 급수표를 만들었습니다.');
    });

    /* ══════════════════════════════════════════════
       도움말 모달
    ══════════════════════════════════════════════ */
    const helpModal = $('#helpModal');
    $('#btnHelp').addEventListener('click', () => {
      helpModal.classList.add('open');
      if (!state.allBanks) {
        loadAllUnits();
      } else {
        renderHelpStats();
      }
    });
    $('#btnHelpClose').addEventListener('click', () => helpModal.classList.remove('open'));
    helpModal.addEventListener('click', (e) => { if (e.target === helpModal) helpModal.classList.remove('open'); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && helpModal.classList.contains('open')) helpModal.classList.remove('open'); });

    function renderHelpStats() {
      if (!state.allBanks) return;
      const tagCounts = {};
      RULE_TAGS.forEach(t => { tagCounts[t] = 0; });
      ['낱말', '구절', '문장'].forEach(k => {
        (state.allBanks[k] || []).forEach(item => {
          (item.tags || []).forEach(t => { if (tagCounts[t] !== undefined) tagCounts[t]++; });
        });
      });
      const maxCount = Math.max(...Object.values(tagCounts), 1);
      const totalItems = Object.values(tagCounts).reduce((a, b) => a + b, 0);

      let html = '<p style="font-size:12.5px; margin-bottom:10px; color:var(--fg-muted);">31개 단원 · 총 ' + totalItems + '개 태그 (문항당 복수 태그 포함)</p>';
      RULE_TAGS.forEach(tag => {
        const c = tagCounts[tag];
        const pct = Math.round(c / maxCount * 100);
        html += '<div class="stat-bar-row">' +
          '<span class="label">' + esc(tag) + '</span>' +
          '<span class="bar"><i style="width:' + pct + '%"></i></span>' +
          '<span class="val">' + c + '</span>' +
        '</div>';
      });
      $('#helpStats').innerHTML = html;
    }

    /* ══════════════════════════════════════════════
       AI 맞춤 학습 모드
    ══════════════════════════════════════════════ */
    function analyzeAttempts() {
      const saved = localStorage.getItem('dictation:attempts');
      const attempts = saved ? jsonParseSafe(saved) || [] : [];
      if (!attempts.length) return null;

      const ruleTotals = {};
      const ruleWrong = {};
      const wrongItems = [];
      RULE_TAGS.forEach(t => { ruleTotals[t] = 0; ruleWrong[t] = 0; });

      attempts.forEach(attempt => {
        (attempt.items || []).forEach(item => {
          (item.tags || []).forEach(t => {
            if (ruleTotals[t] !== undefined) {
              ruleTotals[t]++;
              if (!item.correct) ruleWrong[t]++;
            }
          });
          if (!item.correct) {
            wrongItems.push({ text: item.text || item.id, tags: item.wrongTags || item.tags || [] });
          }
        });
      });

      const weakRules = RULE_TAGS
        .filter(t => ruleTotals[t] > 0)
        .map(t => ({
          rule: t,
          errorRate: Math.round((ruleWrong[t] / ruleTotals[t]) * 100),
          count: ruleTotals[t],
          wrong: ruleWrong[t]
        }))
        .sort((a, b) => b.errorRate - a.errorRate);

      return { weakRules, wrongItems, totalAttempts: attempts.length };
    }

    function renderAiMode() {
      const analysis = analyzeAttempts();

      if (!analysis || analysis.weakRules.length === 0) {
        $('#aiWeakSummary').innerHTML = '<div class="dt-ai-empty">📊 채점 기록이 없습니다.<br>교과서 모드에서 먼저 받아쓰기를 연습해 보세요!</div>';
        $('#aiAskCard').hidden = true;
        $('#aiRecommendCard').hidden = true;
        return;
      }

      const rankClasses = ['r1', 'r2', 'r3'];
      let summaryHtml = '<div class="dt-ai-summary">';
      analysis.weakRules.slice(0, 5).forEach((r, i) => {
        summaryHtml += '<div class="dt-ai-summary-row">' +
          '<span class="rank ' + (rankClasses[i] || 'r3') + '">' + (i + 1) + '</span>' +
          '<span class="info">' +
            '<div class="name">' + esc(r.rule) + '</div>' +
            '<div class="detail">오답률 ' + r.errorRate + '% · ' + r.wrong + '/' + r.count + '회 틀림</div>' +
          '</span>' +
        '</div>';
      });
      summaryHtml += '</div>';
      summaryHtml += '<p style="font-size:12px; color:var(--fg-muted);">총 ' + analysis.totalAttempts + '회 채점 기록 기반</p>';
      $('#aiWeakSummary').innerHTML = summaryHtml;

      $('#aiAskCard').hidden = false;
      $('#aiResponseArea').innerHTML = '<div class="dt-ai-empty">아래 버튼을 눌러 AI 선생님께 약점 분석과 학습 조언을 받아보세요.</div>';
      $('#aiRecommendCard').hidden = true;
    }

    // AI에게 물어보기
    $('#btnAskAI').addEventListener('click', () => {
      const analysis = analyzeAttempts();
      if (!analysis) return;

      const btn = $('#btnAskAI');
      btn.disabled = true;
      btn.textContent = '⏳ AI 분석 중...';
      $('#aiResponseArea').innerHTML = '<div class="dt-ai-loading"><div class="spinner"></div><div>AI 선생님이 분석 중입니다...</div></div>';

      fetch('/api/dictation-ai', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          weakRules: analysis.weakRules.slice(0, 5),
          recentWrong: analysis.wrongItems.slice(-10),
          grade: state.unit || ''
        })
      })
      .then(r => r.json())
      .then(data => {
        btn.disabled = false;
        btn.textContent = '🤖 AI에게 다시 물어보기';

        if (data.error) {
          $('#aiResponseArea').innerHTML = '<div class="dt-ai-empty">⚠️ ' + esc(data.error) + '</div>';
          return;
        }

        let html = '<div class="dt-ai-response">';
        html += '<div class="ai-text">' + esc(data.explanation || '') + '</div>';

        if (data.tips && data.tips.length) {
          html += '<div class="ai-tips">';
          data.tips.forEach(tip => {
            html += '<div class="ai-tip"><span class="icon">💡</span><span>' + esc(tip) + '</span></div>';
          });
          html += '</div>';
        }
        html += '</div>';
        $('#aiResponseArea').innerHTML = html;

        if (data.recommendedRules && data.recommendedRules.length) {
          state.aiRecommendedRules = data.recommendedRules;
          $('#aiRecommendCard').hidden = false;
          let rulesHtml = '<div style="display:flex; gap:6px; flex-wrap:wrap;">';
          data.recommendedRules.forEach(r => {
            rulesHtml += '<span class="dt-tag">' + esc(r) + '</span>';
          });
          rulesHtml += '</div>';
          $('#aiRecommendRules').innerHTML = rulesHtml;
        }
      })
      .catch(err => {
        btn.disabled = false;
        btn.textContent = '🤖 AI에게 물어보기';
        $('#aiResponseArea').innerHTML = '<div class="dt-ai-empty">⚠️ 연결 오류: ' + esc(err.message) + '</div>';
      });
    });

    // 추천 규칙으로 급수표 만들기
    $('#btnAiToSheet').addEventListener('click', () => {
      if (!state.aiRecommendedRules.length) return;

      $$('.dt-mode-tab').forEach(t => t.classList.toggle('active', t.dataset.mode === 'textbook'));
      state.currentMode = 'textbook';
      textbookSections.forEach(el => { if (el) el.style.display = ''; });
      aiView.hidden = true;

      const firstRule = state.aiRecommendedRules[0];
      const ruleVal = 'rule-' + firstRule;
      const unitSelect = $('#unitSelect');
      const opt = unitSelect.querySelector('option[value="' + ruleVal + '"]');
      if (opt) {
        unitSelect.value = ruleVal;
      } else {
        unitSelect.value = 'rule-전체';
      }

      loadAllUnits().then(() => {
        state.unit = unitSelect.value;
        state.bank = { unit: firstRule + ' 집중 연습 (AI 추천)' };
        generateItems();
      });
    });

    // 교과서 모드로 돌아가기
    $('#btnAiBackToTextbook').addEventListener('click', () => {
      $$('.dt-mode-tab').forEach(t => t.classList.toggle('active', t.dataset.mode === 'textbook'));
      state.currentMode = 'textbook';
      textbookSections.forEach(el => { if (el) el.style.display = ''; });
      aiView.hidden = true;
      goto('setup');
    });

    // 백그라운드로 전체 데이터 미리 로드 (도움말 통계용)
    setTimeout(() => loadAllUnits(), 1500);

    /* ── 스텝/이동 버튼 공통 바인딩 ── */
    $$('[data-goto]').forEach((btn) => {
      btn.addEventListener('click', () => { if (!btn.disabled) goto(btn.dataset.goto); });
    });

    // Initial data load on startup
    loadUnit('2-1-01');

    /* 하위 기능 구현 편의를 위한 진입점 노출 */
    window.DT = { state, goto, renderSheet, renderReadCard, renderGradeGrid, showToast, loadUnit };
  })();
  </script>
</AppLayout>
