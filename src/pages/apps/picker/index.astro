  <!-- 자리 배치에서 가져오기 -->
  <div id="m-seating" class="pk-modal">
    <div class="pk-mbox">
      <h2>자리 배치에서 가져오기</h2>
      <p class="mdesc" id="ms-desc">이 기기의 자리 배치 앱에 저장된 학급이에요. 이름·성별·떨어뜨릴 짝을 복사해 와요(자리 배치 데이터는 바뀌지 않아요).</p>
      <div class="pk-list" id="ms-list"></div>
      <div class="mfoot"><button type="button" class="pk-btn" data-vui-close>닫기</button></div>
    </div>
  </div>

  <!-- 떨어뜨릴 짝 -->
  <div id="m-pairs" class="pk-modal">
    <div class="pk-mbox">
      <h2>떨어뜨릴 짝</h2>
      <p class="mdesc">모둠을 나눌 때 같은 모둠에 넣지 않을 두 학생이에요.</p>
      <div class="pk-mrow">
        <select id="mp-a" aria-label="첫째 학생"></select>
        <select id="mp-b" aria-label="둘째 학생"></select>
        <button type="button" class="pk-btn primary" id="mp-add">짝 추가</button>
      </div>
      <div class="pk-list" id="mp-list"></div>
      <div class="mfoot"><button type="button" class="pk-btn" data-vui-close>닫기</button></div>
    </div>
  </div>

  <!-- 확인·입력 -->
  <div id="m-dialog" class="pk-modal">
    <div class="pk-mbox" style="width:min(420px,100%)">
      <h2 id="dlg-title"></h2>
      <p class="mdesc" id="dlg-msg"></p>
      <input class="pk-inp" id="dlg-input" type="text" maxlength="30" autocomplete="off" aria-labelledby="dlg-title">
      <div class="mfoot">
        <button type="button" class="pk-btn" id="dlg-cancel">취소</button>
        <button type="button" class="pk-btn primary" id="dlg-ok">확인</button>
      </div>
    </div>
  </div>

  <script is:inline src="/apps/picker/app.js"></script>
</AppLayout>
