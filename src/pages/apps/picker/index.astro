---
import AppLayout from '../../../layouts/AppLayout.astro';
import Icon from '../../../components/Icon.astro';

// 아이콘(lucide 경로, 빌드 때 인라인)
const I = {
  back: '<path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>',
  dice: '<rect width="12" height="12" x="2" y="10" rx="2" ry="2"/><path d="m17.92 14 3.5-3.5a2.24 2.24 0 0 0 0-3l-5-4.92a2.24 2.24 0 0 0-3 0L10 6"/><path d="M6 18h.01"/><path d="M10 14h.01"/><path d="M15 6h.01"/><path d="M18 9h.01"/>',
  undo: '<path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11"/>',
  max: '<path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/>',
  x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
  plus: '<path d="M5 12h14"/><path d="M12 5v14"/>',
  upload: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/>',
  more: '<circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  printer: '<path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6"/><rect x="6" y="14" width="12" height="8" rx="1"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  next: '<path d="m9 18 6-6-6-6"/>',
  prev: '<path d="m15 18-6-6 6-6"/>',
  shuffle: '<path d="m18 14 4 4-4 4"/><path d="m18 2 4 4-4 4"/><path d="M2 18h1.973a4 4 0 0 0 3.3-1.7l5.454-7.6a4 4 0 0 1 3.3-1.7H22"/><path d="M2 6h1.972a4 4 0 0 1 3.6 2.2"/><path d="M22 18h-6.041a4 4 0 0 1-3.3-1.8l-.359-.45"/>',
  pin: '<path d="M12 17v5"/><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"/>',
};
const svg = (d: string, w = 2) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${w}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
---
<AppLayout
  title="뽑기·모둠 — eduin VIVES"
  description="학급 명단으로 발표자를 공평하게 뽑고, 발표 순서를 정하고, 조건을 지켜 모둠을 나눠요. 전자칠판에 크게 띄우고 모둠 결과는 A4로 인쇄해요. 명단은 이 기기 브라우저에만 저장돼요."
  image="https://eduin.info/og-images/picker.png"
  bodyShell="column"
  bodyWidth="wide"
  bodyPrint={true}
>
  <Fragment slot="head">
    <script is:inline src="/common/sim-kit.js"></script>
    <style is:global="">
    /* ───────── 앱 토큰 ───────── */
    :root {
      --pk-paper: #ffffff;
      --pk-stage: #f6f7fb;
      --pk-m: #3b82f6;
      --pk-f: #ec4899;
      --pk-n: #a1a1aa;
      --pk-soft: rgba(0,111,238,0.10);
      --pk-ok: #16a34a;
      --pk-ok-soft: rgba(22,163,74,0.14);
      --pk-warn: #d97706;
      --pk-warn-soft: rgba(245,158,11,0.14);
      --pk-off: #e4e4e7;
      --pk-card-back: linear-gradient(135deg, #3b82f6, #6366f1);
      --pk-shadow: 0 10px 30px rgba(0,0,0,0.12);
      --pk-accent: #0058c4;
    }
    [data-theme="dark"] {
      --pk-paper: #141416;
      --pk-stage: #0f1014;
      --pk-m: #60a5fa;
      --pk-f: #f472b6;
      --pk-n: #71717a;
      --pk-soft: rgba(51,142,247,0.16);
      --pk-ok: #22c55e;
      --pk-ok-soft: rgba(34,197,94,0.16);
      --pk-warn: #f59e0b;
      --pk-warn-soft: rgba(245,158,11,0.16);
      --pk-off: #2a2a2e;
      --pk-card-back: linear-gradient(135deg, #2563eb, #4f46e5);
      --pk-shadow: 0 10px 30px rgba(0,0,0,0.5);
      --pk-accent: #8ec5ff;
    }

    /* ───────── 공통 버튼 (터치 48px) ───────── */
    .pk-btn {
      min-height: 44px; padding: 0 16px; border-radius: 10px;
      border: 1px solid var(--border); background: var(--bg); color: var(--fg);
      font-weight: 700; font-size: 14px; font-family: inherit; cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center; gap: 7px;
      white-space: nowrap; transition: background .15s, border-color .15s, color .15s, transform .08s;
      -webkit-tap-highlight-color: transparent; touch-action: manipulation;
    }
    .pk-btn:hover { border-color: var(--primary); color: var(--primary); }
    .pk-btn:active { transform: scale(.97); }
    .pk-btn:disabled { opacity: .4; cursor: not-allowed; transform: none; }
    .pk-btn:disabled:hover { border-color: var(--border); color: var(--fg); }
    .pk-btn.primary { background: var(--primary); border-color: var(--primary); color: var(--primary-fg); }
    .pk-btn.primary:hover { background: var(--primary-h); color: var(--primary-fg); }
    .pk-btn.danger { color: var(--danger); }
    .pk-btn.danger:hover { border-color: var(--danger); background: rgba(243,18,96,0.08); }
    .pk-btn.big { min-height: 56px; padding: 0 28px; font-size: 18px; border-radius: 14px; }
    .pk-btn.icon { width: 44px; padding: 0; }
    .pk-btn.sm { min-height: 36px; padding: 0 12px; font-size: 13px; border-radius: 8px; }
    .pk-btn svg { width: 18px; height: 18px; flex-shrink: 0; }
    .pk-btn.big svg { width: 22px; height: 22px; }

    .pk-seg { display: inline-flex; background: var(--bg-sec); border: 1px solid var(--border); border-radius: 10px; padding: 3px; gap: 2px; }
    .pk-seg button {
      border: 0; background: transparent; color: var(--fg-muted); font-weight: 700; font-size: 13.5px; font-family: inherit;
      padding: 0 12px; min-height: 38px; border-radius: 8px; cursor: pointer; white-space: nowrap; touch-action: manipulation;
    }
    .pk-seg button[aria-pressed="true"] { background: var(--bg); color: var(--primary); box-shadow: 0 1px 3px rgba(0,0,0,.12); }
    .pk-stepper { display: inline-flex; align-items: center; background: var(--bg-sec); border: 1px solid var(--border); border-radius: 10px; padding: 3px; }
    .pk-stepper button {
      border: 0; background: var(--bg); color: var(--fg); width: 38px; height: 38px; border-radius: 8px;
      font-size: 20px; cursor: pointer; display: grid; place-items: center; line-height: 1; box-shadow: 0 1px 2px rgba(0,0,0,.08);
      touch-action: manipulation;
    }
    .pk-stepper button:disabled { opacity: .35; cursor: not-allowed; }
    .pk-stepper output { min-width: 34px; text-align: center; font-size: 16px; font-weight: 800; font-variant-numeric: tabular-nums; }
    .pk-opt { display: inline-flex; align-items: center; gap: 8px; }
    .pk-opt > .lbl { font-size: 13px; font-weight: 700; color: var(--fg-muted); }
    .pk-opt[hidden] { display: none; }
    .pk-check {
      display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 12px; border-radius: 10px;
      border: 1px solid var(--border); background: var(--bg); font-size: 13.5px; font-weight: 600; cursor: pointer; user-select: none;
    }
    .pk-check input { width: 20px; height: 20px; accent-color: var(--primary); margin: 0; }
    .pk-check:has(input:checked) { border-color: var(--primary); background: var(--pk-soft); }

    /* ───────── 목록 화면 ───────── */
    .pk-top { display: flex; align-items: center; gap: 8px; margin: 4px 0 8px; flex-wrap: wrap; }
    .pk-h2 {
      font-size: 12px; font-weight: 800; letter-spacing: .12em; color: var(--fg-muted);
      display: flex; align-items: center; gap: 8px; flex: 1; margin: 0; min-width: 120px;
    }
    .pk-h2::after { content: ''; flex: 1; height: 1px; background: var(--border); }
    .pk-note { font-size: 13px; color: var(--fg-muted); margin: 0 0 16px; line-height: 1.6; }
    .pk-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
    .pk-card {
      position: relative; background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px;
      transition: border-color .2s, transform .15s, box-shadow .2s;
    }
    .pk-card:hover { border-color: var(--primary); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,111,238,0.1); }
    .pk-card-open {
      display: block; width: 100%; padding: 18px 56px 18px 18px; border: 0; margin: 0; min-height: 96px;
      background: none; color: inherit; font: inherit; text-align: left; cursor: pointer;
    }
    .pk-card-name { font-size: 17px; font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pk-card-meta { font-size: 13px; color: var(--fg-muted); margin-top: 6px; line-height: 1.5; }
    /* 메뉴 버튼은 카드 오른쪽 띠 전체(위~아래)를 차지 — 메뉴 주변을 잘못 눌러 카드가 열리지 않게 */
    .pk-card-menu {
      position: absolute; right: 0; top: 0; bottom: 0; width: 52px; border-radius: 0 16px 16px 0;
      border: 0; border-left: 1px solid transparent; background: transparent; color: var(--fg-muted); cursor: pointer;
      display: flex; align-items: center; justify-content: center;
    }
    .pk-card-menu:hover { background: var(--bg); border-left-color: var(--border); color: var(--fg); }
    .pk-card-menu svg { width: 20px; height: 20px; }
    .pk-empty {
      grid-column: 1 / -1; text-align: center; padding: 40px 16px; border: 1px dashed var(--border); border-radius: 16px;
      color: var(--fg-muted); font-size: 14px; line-height: 1.7;
    }
    .pk-empty b { color: var(--fg); }

    /* ───────── 학급 화면 ───────── */
    #view-class[hidden], #view-list[hidden],
    #view-list [hidden], #view-class [hidden], .pk-modal [hidden] { display: none !important; }
    body.pk-in-class .app-header { display: none !important; }
    .pk-bar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
    #pk-name {
      background: transparent; color: var(--fg); border: 1px solid transparent; border-radius: 8px;
      font-weight: 800; font-size: 18px; font-family: inherit; padding: 6px 10px; min-width: 80px; width: 200px; min-height: 44px;
    }
    #pk-name:hover { border-color: var(--border); }
    #pk-name:focus { outline: none; border-color: var(--primary); }
    .pk-tabs { display: inline-flex; gap: 4px; background: var(--bg-sec); border: 1px solid var(--border); border-radius: 12px; padding: 4px; margin-left: auto; }
    .pk-tabs button {
      border: 0; background: transparent; color: var(--fg-muted); font-weight: 800; font-size: 15px; font-family: inherit;
      padding: 0 16px; min-height: 44px; border-radius: 9px; cursor: pointer; white-space: nowrap; touch-action: manipulation;
    }
    .pk-tabs button[aria-selected="true"] { background: var(--bg); color: var(--primary); box-shadow: 0 1px 4px rgba(0,0,0,.12); }
    .pk-absent-chip {
      border: 1px solid var(--border); background: var(--bg); color: var(--fg-muted); border-radius: 999px;
      font: inherit; font-size: 13px; font-weight: 700; min-height: 36px; padding: 0 12px; cursor: pointer;
    }
    .pk-absent-chip.has { color: var(--pk-warn); border-color: var(--pk-warn); background: var(--pk-warn-soft); }

    .pk-panel[hidden] { display: none !important; }
    .pk-opts { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin-bottom: 12px; }

    /* 무대(크게 보기 대상) */
    .pk-display {
      position: relative; background: var(--pk-paper); border: 1px solid var(--border); border-radius: 18px;
      min-height: clamp(340px, 52vh, 620px); display: flex; flex-direction: column; overflow: hidden;
      box-shadow: 0 4px 18px rgba(0,0,0,.04);
    }
    .pk-view { flex: 1; min-height: 0; position: relative; display: flex; align-items: center; justify-content: center; padding: 16px; }
    .pk-dock {
      display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap;
      padding: 12px 14px 14px; border-top: 1px solid var(--border); background: var(--bg);
    }
    .pk-dock .grow { flex: 1; }
    .pk-present-only { display: none !important; }
    .pk-info { font-size: 13.5px; color: var(--fg-muted); display: flex; gap: 8px 14px; flex-wrap: wrap; align-items: center; margin-top: 12px; }
    .pk-info b { color: var(--fg); }
    .pk-hint { font-size: 13px; color: var(--fg-muted); text-align: center; line-height: 1.6; }

    /* 크게 보기(발표) */
    body.pk-present { overflow: hidden; }
    body.pk-present .top-overlay, body.pk-present .top-overlay-left { display: none !important; }
    body.pk-present .pk-display.is-present {
      position: fixed; inset: 0; z-index: 600; border-radius: 0; border: 0; min-height: 0;
    }
    body.pk-present .pk-display.is-present .pk-present-only { display: inline-flex !important; }
    body.pk-present .pk-display.is-present .pk-hide-present { display: none !important; }
    body.pk-present .pk-display.is-present .pk-dock { padding: 14px 20px 18px; }
    /* 크게 보기는 스크롤할 일이 없으니 어느 방향으로든 끌기 */
    body.pk-present .pk-display.is-present .pk-mem { touch-action: none; }

    /* 뽑기 — 이름 */
    .pk-names { width: 100%; height: 100%; display: grid; gap: 12px; align-content: center; justify-content: center; }
    .pk-name {
      display: flex; align-items: center; justify-content: center; text-align: center; padding: 6px 12px; border-radius: 16px;
      font-weight: 900; letter-spacing: -0.02em; line-height: 1.1; white-space: nowrap; color: var(--fg);
      background: var(--bg-sec); min-width: 0;
    }
    .pk-name.rolling { color: var(--fg-muted); }
    .pk-name.final { background: var(--pk-soft); color: var(--pk-accent); animation: pkPop .35s cubic-bezier(.2,1.4,.4,1) both; }
    .pk-placeholder { color: var(--fg-muted); font-size: 18px; font-weight: 700; text-align: center; line-height: 1.6; }
    @keyframes pkPop { from { transform: scale(.7); opacity: .3; } to { transform: none; opacity: 1; } }

    /* 뽑기 — 카드 */
    .pk-cards { width: 100%; height: 100%; display: grid; gap: 10px; align-content: center; justify-content: center; }
    .pk-flip {
      position: relative; border: 0; padding: 0; background: none; cursor: pointer; perspective: 800px; font: inherit;
      touch-action: manipulation;
    }
    .pk-flip .in { position: absolute; inset: 0; transition: transform .45s cubic-bezier(.3,.9,.4,1); transform-style: preserve-3d; }
    .pk-flip .fc, .pk-flip .bc {
      position: absolute; inset: 0; border-radius: 12px; display: flex; align-items: center; justify-content: center;
      backface-visibility: hidden; -webkit-backface-visibility: hidden; font-weight: 900; padding: 4px; text-align: center; line-height: 1.1;
    }
    .pk-flip .bc { background: var(--pk-card-back); color: rgba(255,255,255,.85); box-shadow: 0 3px 10px rgba(0,0,0,.15); }
    .pk-flip .fc { background: var(--pk-soft); color: var(--pk-accent); border: 2px solid var(--primary); transform: rotateY(180deg); word-break: keep-all; }
    .pk-flip.open .in { transform: rotateY(180deg); }
    .pk-flip:disabled { cursor: default; }
    .pk-flip:not(.open):disabled .bc { opacity: .35; }

    /* 뽑기 — 룰렛 */
    .pk-wheel-wrap { position: relative; height: 100%; aspect-ratio: 1; max-width: 100%; display: flex; align-items: center; justify-content: center; }
    .pk-wheel-wrap svg.wheel { width: 100%; height: 100%; transition: transform 3.6s cubic-bezier(.12,.7,.15,1); }
    .pk-wheel-wrap .pointer { position: absolute; top: -2px; left: 50%; transform: translateX(-50%); width: 0; height: 0;
      border-left: 16px solid transparent; border-right: 16px solid transparent; border-top: 30px solid var(--danger); filter: drop-shadow(0 2px 3px rgba(0,0,0,.3)); z-index: 2; }
    .pk-wheel-result {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 3; padding: 10px 22px; border-radius: 16px;
      background: var(--bg); color: var(--pk-accent); font-weight: 900; box-shadow: var(--pk-shadow); white-space: nowrap;
    }

    .pk-history { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
    .pk-history .h { font-size: 13px; padding: 5px 10px; border-radius: 999px; background: var(--bg-sec); border: 1px solid var(--border); }
    .pk-history .h small { color: var(--fg-muted); margin-right: 4px; }

    /* 순서 */
    .pk-order-now { text-align: center; width: 100%; }
    .pk-order-now .no { font-weight: 800; color: var(--fg-muted); }
    .pk-order-now .nm { font-weight: 900; color: var(--pk-accent); line-height: 1.1; white-space: nowrap; }
    .pk-order-now .nx { color: var(--fg-muted); font-weight: 700; margin-top: .4em; }
    .pk-olist { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; margin-top: 14px; }
    .pk-ochip {
      display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 12px; border-radius: 12px;
      border: 1px solid var(--border); background: var(--card-bg); color: var(--fg); font: inherit; font-weight: 700; font-size: 15px;
      cursor: pointer; text-align: left; touch-action: manipulation;
    }
    .pk-ochip .n { min-width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; background: var(--bg); font-size: 13px; color: var(--fg-muted); font-variant-numeric: tabular-nums; }
    .pk-ochip.done { opacity: .5; text-decoration: line-through; }
    .pk-ochip.cur { border-color: var(--primary); background: var(--pk-soft); color: var(--primary); }
    .pk-ochip.cur .n { background: var(--primary); color: #fff; }

    /* 모둠 */
    .pk-groups { width: 100%; align-self: stretch; display: grid; gap: 12px; align-content: start; overflow: auto; }
    .pk-group {
      border: 2px solid var(--border); border-radius: 14px; background: var(--card-bg); padding: 10px; min-width: 0;
      display: flex; flex-direction: column; gap: 6px; transition: border-color .15s, background .15s;
    }
    .pk-group.drop { border-color: var(--primary); background: var(--pk-soft); }
    .pk-group.target { border-style: dashed; border-color: var(--primary); cursor: pointer; }
    .pk-ghead { display: flex; align-items: center; gap: 8px; font-weight: 900; font-size: 15px; padding: 2px 4px 4px; }
    .pk-ghead .dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }
    .pk-ghead .cnt { margin-left: auto; font-size: 12.5px; color: var(--fg-muted); font-weight: 700; }
    .pk-mem {
      display: flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 10px; border-radius: 10px;
      border: 1px solid var(--border); background: var(--bg); color: var(--fg); font: inherit; font-weight: 700; font-size: 15px;
      cursor: grab; text-align: left; touch-action: pan-y; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;
    }
    .pk-mem .g { width: 8px; height: 8px; border-radius: 50%; background: var(--pk-n); flex-shrink: 0; }
    .pk-mem .g.M { background: var(--pk-m); } .pk-mem .g.F { background: var(--pk-f); }
    .pk-mem .nm { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pk-mem .tag { font-size: 11.5px; font-weight: 800; padding: 2px 6px; border-radius: 6px; }
    .pk-mem .tag.lead { background: var(--pk-warn-soft); color: var(--pk-warn); }
    .pk-mem .tag.pin { color: var(--fg-muted); }
    .pk-mem.sel { border-color: var(--primary); box-shadow: 0 0 0 3px var(--pk-soft); }
    .pk-mem.bad { border-color: var(--danger); }
    .pk-mem.dragging { opacity: .35; }
    .pk-ghost {
      position: fixed; z-index: 10020; pointer-events: none; padding: 10px 16px; border-radius: 12px;
      background: var(--primary); color: #fff; font-weight: 800; font-size: 15px; box-shadow: 0 8px 24px rgba(0,0,0,.25);
      transform: translate(-50%, -140%); white-space: nowrap;
    }
    .pk-selbar {
      display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 8px 12px; margin-top: 10px;
      border-radius: 12px; background: var(--pk-soft); font-size: 14px; font-weight: 700;
    }
    .pk-selbar[hidden] { display: none; }
    .pk-warnline { color: var(--danger); font-weight: 700; }
    .pk-okline { color: var(--pk-ok); font-weight: 700; }
    #groups-print-title { display: none; }

    /* 명단 */
    .pk-roster { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; margin-top: 12px; }
    .pk-stu {
      display: flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 12px; border-radius: 12px;
      border: 1px solid var(--border); background: var(--card-bg); color: var(--fg); font: inherit; font-weight: 700; font-size: 15px;
      cursor: pointer; text-align: left; touch-action: manipulation;
    }
    .pk-stu .g { width: 10px; height: 10px; border-radius: 50%; background: var(--pk-n); flex-shrink: 0; }
    .pk-stu .g.M { background: var(--pk-m); } .pk-stu .g.F { background: var(--pk-f); }
    .pk-stu .nm { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pk-stu .st { font-size: 12px; font-weight: 800; color: var(--fg-muted); }
    .pk-stu[aria-pressed="true"] { background: var(--pk-warn-soft); border-color: var(--pk-warn); }
    .pk-stu[aria-pressed="true"] .nm { text-decoration: line-through; color: var(--fg-muted); }
    .pk-stu[aria-pressed="true"] .st { color: var(--pk-warn); }

    /* 팝업 메뉴 */
    .pk-pop {
      position: fixed; z-index: 10010; background: var(--dialog-bg); color: var(--dialog-fg); border: 1px solid var(--dialog-border);
      border-radius: 12px; box-shadow: var(--pk-shadow); padding: 6px; min-width: 200px; font-size: 14px;
    }
    .pk-pop[hidden] { display: none; }
    .pk-pop button {
      display: flex; align-items: center; gap: 8px; width: 100%; text-align: left; border: 0; background: transparent;
      padding: 0 12px; min-height: 44px; border-radius: 8px; font-weight: 600; font-size: 14px; font-family: inherit; color: inherit; cursor: pointer;
    }
    .pk-pop button:hover, .pk-pop button:focus-visible { background: var(--pk-soft); color: var(--primary); outline: none; }
    .pk-pop button.danger { color: var(--danger); }
    .pk-pop .pdiv { height: 1px; background: var(--border); margin: 4px 0; }

    /* 모달 */
    .pk-modal {
      position: fixed; inset: 0; z-index: 10000; background: rgba(0,0,0,0.45); backdrop-filter: blur(3px);
      display: none; align-items: center; justify-content: center; padding: 16px;
    }
    .pk-modal.open { display: flex; }
    .pk-mbox {
      background: var(--dialog-bg); color: var(--dialog-fg); border: 1px solid var(--dialog-border);
      border-radius: 18px; width: min(540px, 100%); max-height: calc(100vh - 32px); max-height: calc(100dvh - 32px); overflow: auto; padding: 22px;
      box-shadow: 0 20px 50px rgba(0,0,0,.25);
    }
    .pk-mbox h2 { margin: 0 0 6px; font-size: 18px; }
    .pk-mbox .mdesc { margin: 0 0 12px; font-size: 13.5px; color: var(--fg-muted); line-height: 1.6; }
    .pk-mbox textarea {
      width: 100%; height: 260px; border: 1px solid var(--border); border-radius: 12px; padding: 12px; background: var(--input-bg);
      color: var(--fg); font-family: inherit; font-size: 15px; line-height: 1.7; resize: vertical;
    }
    .pk-mbox textarea:focus, .pk-mbox .pk-inp:focus, .pk-mbox select:focus { outline: none; border-color: var(--primary); }
    .pk-inp, .pk-mbox select {
      width: 100%; min-height: 44px; border: 1px solid var(--border); border-radius: 10px; padding: 0 12px;
      background: var(--input-bg); color: var(--fg); font-family: inherit; font-size: 15px;
    }
    .mfoot { display: flex; gap: 8px; justify-content: flex-end; margin-top: 16px; flex-wrap: wrap; }
    .mfoot .left { margin-right: auto; }
    .pk-mrow { display: flex; gap: 8px; align-items: center; margin: 8px 0; flex-wrap: wrap; }
    .pk-list { display: flex; flex-direction: column; gap: 6px; margin-top: 10px; max-height: 260px; overflow: auto; }
    .pk-list .it { display: flex; align-items: center; gap: 8px; padding: 6px 6px 6px 12px; border: 1px solid var(--border); border-radius: 10px; font-weight: 700; }
    .pk-list .it span { flex: 1; }
    .pk-list .src { width: 100%; justify-content: flex-start; text-align: left; min-height: 52px; }
    .pk-list .src small { color: var(--fg-muted); font-weight: 600; margin-left: auto; }

    /* 아이콘(lucide 스프라이트) */
    .pk-btn .ic { width: 18px; height: 18px; }
    .pk-tabs button { display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
    .pk-tabs button .ic { width: 16px; height: 16px; flex-shrink: 0; }
    .pk-mem .tag.pin .ic { width: 13px; height: 13px; vertical-align: -2px; }
    .pk-sub { font-size: 12.5px; color: var(--fg-muted); line-height: 1.6; margin: -4px 0 12px; }
    /* 위험(지우기) 확인 버튼: 빨간 바탕 흰 글자 */
    .pk-btn.danger-solid { background: var(--danger); border-color: var(--danger); color: #fff; }
    .pk-btn.danger-solid:hover { background: color-mix(in srgb, var(--danger) 85%, #000); color: #fff; border-color: var(--danger); }

    /* 터치 기기: 누르는 곳 44px 이상 */
    @media (pointer: coarse) {
      .pk-btn.sm { min-height: 44px; }
      .pk-stepper button { width: 44px; height: 44px; }
      .pk-seg button { min-height: 44px; }
      .pk-absent-chip { min-height: 44px; }
    }
    /* iOS는 16px 미만 입력칸에서 화면을 확대한다 */
    @media (max-width: 768px), (pointer: coarse) {
      .pk-inp, .pk-mbox select, .pk-mbox textarea { font-size: 16px; }
    }

    @media (max-width: 760px) {
      .pk-tabs { margin-left: 0; width: 100%; }
      .pk-tabs button { flex: 1; padding: 0 6px; font-size: 14px; }
      #pk-name { width: 140px; }
      .pk-display { min-height: 300px; }
    }
    @media (max-width: 420px) {
      .pk-tabs button { font-size: 13px; }
      .pk-btn.big { padding: 0 18px; font-size: 16px; }
    }

    /* 인쇄: 모둠 결과 한 장 */
    @media print {
      @page { size: A4 portrait; margin: 12mm; }
      body.pk-printing > *:not(.app-main) { display: none !important; }
      body.pk-printing #view-class > *:not(#panel-groups),
      body.pk-printing #panel-groups > *:not(#groups-display) { display: none !important; }
      body.pk-printing #groups-display { border: 0; box-shadow: none; background: #fff; min-height: 0; }
      body.pk-printing #groups-display .pk-dock { display: none !important; }
      body.pk-printing #groups-print-title { display: block; font-size: 20px; font-weight: 900; text-align: center; margin: 0 0 6mm; color: #000; }
      body.pk-printing .pk-groups { overflow: visible; grid-template-columns: repeat(2, 1fr) !important; }
      body.pk-printing .pk-group { background: #fff !important; border: 1.5px solid #555 !important; break-inside: avoid; }
      body.pk-printing .pk-mem { background: #fff !important; color: #000 !important; border: 1px solid #aaa !important; font-size: 16px; box-shadow: none !important; }
      body.pk-printing .pk-mem .g, body.pk-printing .pk-mem .tag.pin { display: none !important; }
      body.pk-printing .pk-ghead { color: #000; }
    }
    </style>
  </Fragment>

  <!-- 플로팅 크롬(홈·테마·공유)은 app-shell.js가 주입합니다 -->
  <main class="app-main">
    <div class="app-header">
      <div class="app-badge">업무경감</div>
      <h1 class="app-title">뽑기·모둠 <span class="app-title-en">Picker</span></h1>
      <p class="app-desc">발표자를 공평하게 뽑고, 발표 순서를 정하고, 조건을 지켜 모둠을 나눠요. 전자칠판에 크게 띄울 수 있어요.</p>
    </div>

    <!-- ───── 학급 목록 ───── -->
    <section id="view-list" aria-label="학급 목록">
      <div class="pk-top">
        <h2 class="pk-h2">내 학급</h2>
        <button type="button" class="pk-btn sm" id="pl-seating" hidden><Icon name="armchair" />자리 배치에서 가져오기</button>
        <button type="button" class="pk-btn sm" id="pl-import"><Fragment set:html={svg(I.upload)} />파일 불러오기</button>
        <button type="button" class="pk-btn sm" id="pl-numbers"><Icon name="hash" />번호로 시작</button>
        <button type="button" class="pk-btn primary sm" id="pl-new"><Fragment set:html={svg(I.plus, 2.5)} />새 학급</button>
      </div>
      <p class="pk-note">명단은 이 기기의 브라우저에만 저장돼요. 이름을 남기고 싶지 않으면 <b>번호로 시작</b>을 쓰세요. 다른 기기로 옮길 땐 학급 메뉴의 <b>파일로 저장</b>을 쓰세요.</p>
      <div id="pl-grid" class="pk-grid"></div>
      <input type="file" id="pl-file" accept="application/json,.json" hidden>
    </section>

    <!-- ───── 학급 화면 ───── -->
    <section id="view-class" aria-label="학급" hidden>
      <div class="pk-bar">
        <button type="button" class="pk-btn icon" id="pc-back" title="학급 목록으로" aria-label="학급 목록으로"><Fragment set:html={svg(I.back, 2.5)} /></button>
        <input id="pk-name" type="text" maxlength="30" spellcheck="false" autocomplete="off" aria-label="학급 이름" placeholder="학급 이름">
        <button type="button" class="pk-absent-chip" id="pc-absent">결석 0명</button>
        <div class="pk-tabs" role="tablist" aria-label="도구">
          <button type="button" role="tab" id="tab-draw" data-tab="draw" aria-controls="panel-draw"><Icon name="target" />뽑기</button>
          <button type="button" role="tab" id="tab-order" data-tab="order" aria-controls="panel-order"><Icon name="list-ordered" />순서</button>
          <button type="button" role="tab" id="tab-groups" data-tab="groups" aria-controls="panel-groups"><Icon name="users" />모둠</button>
          <button type="button" role="tab" id="tab-roster" data-tab="roster" aria-controls="panel-roster"><Icon name="clipboard-list" />명단</button>
        </div>
      </div>

      <!-- 뽑기 -->
      <div class="pk-panel" id="panel-draw" role="tabpanel" aria-labelledby="tab-draw">
        <div class="pk-opts">
          <div class="pk-opt"><span class="lbl" id="lbl-count">인원</span>
            <div class="pk-stepper" role="group" aria-labelledby="lbl-count"><button type="button" id="dr-dec" aria-label="한 명 줄이기"><Icon name="minus" /></button><output id="dr-count" aria-live="polite">1</output><button type="button" id="dr-inc" aria-label="한 명 늘리기"><Icon name="plus" /></button></div>
          </div>
          <div class="pk-opt"><span class="lbl">방식</span>
            <div class="pk-seg" id="seg-fair" role="group" aria-label="뽑는 방식" aria-describedby="dr-fair-hint"><button type="button" data-v="fair">공평하게</button><button type="button" data-v="free">매번 새로</button></div>
          </div>
          <div class="pk-opt"><span class="lbl">연출</span>
            <div class="pk-seg" id="seg-effect" role="group" aria-label="뽑기 연출"><button type="button" data-v="slot">슬롯</button><button type="button" data-v="card">카드</button><button type="button" data-v="wheel">룰렛</button></div>
          </div>
          <button type="button" class="pk-btn icon" id="dr-sound" aria-pressed="false" aria-label="소리 끄기"><Icon name="volume-2" /></button>
        </div>
        <p class="pk-sub" id="dr-fair-hint"><b>공평하게</b>: 모두 한 번씩 뽑힐 때까지 다시 뽑히지 않아요 · <b>매번 새로</b>: 매번 모든 학생 중에서 뽑아요</p>

        <div class="pk-display" id="draw-display">
          <div class="pk-view" id="draw-view" aria-live="polite"></div>
          <div class="pk-dock">
            <button type="button" class="pk-btn pk-present-only" data-present-close><Fragment set:html={svg(I.x, 2.5)} />닫기</button>
            <span class="grow pk-hide-present"></span>
            <button type="button" class="pk-btn primary big" id="dr-go" aria-keyshortcuts="Space Enter"><Fragment set:html={svg(I.dice)} /><span>뽑기</span></button>
            <span class="grow pk-hide-present"></span>
            <button type="button" class="pk-btn icon pk-hide-present" data-present="draw-display" title="크게 보기" aria-label="크게 보기"><Fragment set:html={svg(I.max)} /></button>
          </div>
        </div>
        <div class="pk-info">
          <span id="dr-left"></span>
          <button type="button" class="pk-btn sm" id="dr-undo"><Fragment set:html={svg(I.undo)} />방금 뽑기 되돌리기</button>
          <button type="button" class="pk-btn sm" id="dr-reset">새 바퀴 시작</button>
        </div>
        <div class="pk-history" id="dr-history" aria-label="오늘 뽑힌 사람"></div>
      </div>

      <!-- 순서 -->
      <div class="pk-panel" id="panel-order" role="tabpanel" aria-labelledby="tab-order" hidden>
        <div class="pk-display" id="order-display">
          <div class="pk-view" id="order-view" aria-live="polite"></div>
          <div class="pk-dock">
            <button type="button" class="pk-btn pk-present-only" data-present-close><Fragment set:html={svg(I.x, 2.5)} />닫기</button>
            <button type="button" class="pk-btn big" id="or-prev" aria-label="이전 사람"><Fragment set:html={svg(I.prev, 2.5)} /></button>
            <button type="button" class="pk-btn primary big" id="or-next"><span>다음</span><Fragment set:html={svg(I.next, 2.5)} /></button>
            <button type="button" class="pk-btn pk-hide-present" id="or-shuffle"><Fragment set:html={svg(I.shuffle)} /><span>순서 섞기</span></button>
            <button type="button" class="pk-btn icon pk-hide-present" data-present="order-display" title="크게 보기" aria-label="크게 보기"><Fragment set:html={svg(I.max)} /></button>
          </div>
        </div>
        <div class="pk-olist" id="or-list" aria-label="발표 순서"></div>
      </div>

      <!-- 모둠 -->
      <div class="pk-panel" id="panel-groups" role="tabpanel" aria-labelledby="tab-groups" hidden>
        <div class="pk-opts">
          <div class="pk-opt">
            <div class="pk-seg" id="seg-gmode" role="group" aria-label="나누는 기준"><button type="button" data-v="count">모둠 수</button><button type="button" data-v="size">모둠당 인원</button></div>
            <div class="pk-stepper" role="group" aria-label="값"><button type="button" id="gr-dec" aria-label="줄이기"><Icon name="minus" /></button><output id="gr-val" aria-live="polite">4</output><button type="button" id="gr-inc" aria-label="늘리기"><Icon name="plus" /></button></div>
          </div>
          <div class="pk-opt" id="gr-rem-wrap"><span class="lbl">남는 학생</span>
            <div class="pk-seg" id="seg-grem" role="group" aria-label="남는 학생"><button type="button" data-v="add">모둠에 더하기</button><button type="button" data-v="new">작은 모둠</button></div>
          </div>
          <label class="pk-check"><input type="checkbox" id="gr-gender">성별 섞기</label>
          <label class="pk-check"><input type="checkbox" id="gr-prev">지난 모둠과 덜 겹치게</label>
          <label class="pk-check"><input type="checkbox" id="gr-lead">모둠장 뽑기</label>
          <button type="button" class="pk-btn sm" id="gr-pairs">떨어뜨릴 짝 0쌍</button>
        </div>
        <div class="pk-display" id="groups-display">
          <div id="groups-print-title"></div>
          <div class="pk-view" id="groups-view" style="align-items:stretch"></div>
          <div class="pk-dock">
            <button type="button" class="pk-btn pk-present-only" data-present-close><Fragment set:html={svg(I.x, 2.5)} />닫기</button>
            <button type="button" class="pk-btn primary big" id="gr-go"><Fragment set:html={svg(I.users)} /><span>모둠 나누기</span></button>
            <button type="button" class="pk-btn icon" id="gr-undo" title="되돌리기" aria-label="되돌리기"><Fragment set:html={svg(I.undo)} /></button>
            <button type="button" class="pk-btn pk-hide-present" id="gr-keep" aria-describedby="gr-hint"><Fragment set:html={svg(I.check, 2.5)} />이대로 쓰기</button>
            <button type="button" class="pk-btn icon pk-hide-present" id="gr-print" title="모둠 결과 A4 인쇄" aria-label="모둠 결과 A4 인쇄"><Fragment set:html={svg(I.printer)} /></button>
            <button type="button" class="pk-btn icon pk-hide-present" data-present="groups-display" title="크게 보기" aria-label="크게 보기"><Fragment set:html={svg(I.max)} /></button>
          </div>
        </div>
        <div class="pk-selbar" id="gr-selbar" hidden>
          <span id="gr-seltext"></span>
          <button type="button" class="pk-btn sm" id="gr-pin"><Fragment set:html={svg(I.pin)} /><span>이 모둠에 고정</span></button>
          <button type="button" class="pk-btn sm" id="gr-unsel">선택 취소</button>
        </div>
        <div class="pk-info" id="gr-status"></div>
        <p class="pk-hint" id="gr-hint" style="text-align:left;margin-top:6px">학생을 끌어 다른 학생과 바꾸거나 다른 모둠에 놓으세요. 누르기만 해도 돼요: 한 명을 누르고 → 바꿀 학생이나 모둠을 누르기.<br><b>이대로 쓰기</b>를 누르면 이 모둠을 기억해 두고, 다음에 ‘지난 모둠과 덜 겹치게’가 이 모둠을 피해요.</p>
      </div>

      <!-- 명단 -->
      <div class="pk-panel" id="panel-roster" role="tabpanel" aria-labelledby="tab-roster" hidden>
        <div class="pk-opts">
          <button type="button" class="pk-btn primary" id="ro-edit"><Icon name="notebook-pen" />명단 편집</button>
          <button type="button" class="pk-btn" id="ro-seating" hidden><Icon name="armchair" />자리 배치에서 가져오기</button>
          <button type="button" class="pk-btn" id="ro-pairs">떨어뜨릴 짝</button>
          <button type="button" class="pk-btn" id="ro-clear-absent">결석 표시 모두 풀기</button>
        </div>
        <p class="pk-note" id="ro-sum" style="margin:0"></p>
        <div class="pk-roster" id="ro-list" aria-label="학생 명단 — 누르면 오늘 결석으로 표시"></div>
      </div>
    </section>
  </main>

  <div id="pk-live" class="visually-hidden" role="status" aria-live="polite"></div>

