---
import AppLayout from '../../../layouts/AppLayout.astro';
---
<AppLayout
  title="노션 수식 꾸미기 (Notion Styler) — eduin VIVES"
  description="노션 수식에 붙여넣는 꾸밈 코드를 만들어요. 글자색·배경색·크기·글꼴을 고르고 복사해 노션 /수식 블록에 붙여넣기."
  image="https://eduin.info/og-images/notion-styler.png"
  bodyShell="split"
  bodyWidth="wide"
>
  <Fragment slot="head">
    <!-- 외부 런타임은 정확한 버전으로 고정(2026-10 기준). 자체 호스팅(public/vendor/)은 별도 과제 -->
    <script src="https://cdn.tailwindcss.com/3.4.17" is:inline=""></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
  <script crossorigin="" src="https://unpkg.com/react@18.3.1/umd/react.production.min.js" is:inline=""></script>
  <script crossorigin="" src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js" is:inline=""></script>
  <script src="https://unpkg.com/@babel/standalone@7.29.9/babel.min.js" is:inline=""></script>
  <script src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js" is:inline=""></script>
  <style is:global="">
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap');

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", sans-serif;
            background: var(--bg);
            min-height: 100vh;
            min-height: 100dvh;
        }
        body::before {
            content: '';
            position: fixed; inset: 0;
            background-image:
                linear-gradient(rgba(0,111,238,0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0,111,238,0.03) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none; z-index: 0;
        }
        #root { position: relative; z-index: 1; }

        /* ── Notion Styler 전용 클래스 ── */
        .ns-wrap {
            width: 100%; max-width: 1080px;
            margin: 0 auto; padding: 64px 20px 80px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: auto auto;
            gap: 16px 20px;
            align-items: stretch;
        }
        .ns-wrap > * { min-width: 0; }
        .ns-full {
            grid-column: 1 / -1;
        }
        .ns-col-left {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .ns-col-right {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 16px;
        }
        /* 텍스트 입력 카드 — 컨텐츠 높이에 맞춤 */
        .ns-col-left > .ns-card:first-child {
            display: flex;
            flex-direction: column;
        }
        .ns-col-left > .ns-card:first-child .ns-textarea {
            height: 160px;
            min-height: unset;
            flex: none;
            resize: none;
        }
        /* 미리보기 카드 — 내용이 커지면 같이 커지고(최소 160px), 아주 크면 안에서 스크롤 */
        .ns-col-right > .ns-card:first-child {
            display: flex;
            flex-direction: column;
        }
        .ns-col-right > .ns-card:first-child .ns-preview {
            min-height: 160px;
            max-height: 420px;
            flex: none;
        }
        /* 생성된 코드 카드 — 남은 공간 채우기 */
        .ns-col-right > .ns-card:nth-child(2) {
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        .ns-col-right > .ns-card:nth-child(2) .ns-code-wrap {
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        .ns-col-right > .ns-card:nth-child(2) .ns-code {
            flex: 1;
        }
        @media (max-width: 760px) {
            .ns-wrap { grid-template-columns: 1fr; gap: 16px; }
            .ns-full { grid-column: 1; }
            .ns-col-right { justify-content: flex-start; }
        }
        @media (max-width: 480px) {
            .ns-wrap { padding: 56px 12px 64px; }
            .ns-card { padding: 16px !important; }
        }
        .ns-card {
            background: var(--card-bg); border: 1px solid var(--border);
            border-radius: 12px; padding: 24px;
        }
        .ns-card-title {
            font-size: 11px; font-weight: 700; letter-spacing: 0.12em;
            text-transform: uppercase; color: var(--fg-muted); margin-bottom: 16px;
            display: flex; align-items: center; gap: 8px;
        }
        .ns-card-title::after { content: ''; flex: 1; height: 1px; background: var(--border); }
        .ns-label { display: block; font-size: 13px; font-weight: 500; color: var(--fg-muted); margin-bottom: 8px; }
        .ns-label-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
        .ns-align-btns { display: flex; gap: 3px; background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 3px; }
        .ns-align-btn { min-width: 44px; min-height: 44px; padding: 0; border: none; background: none; cursor: pointer; color: var(--fg-muted); border-radius: 8px; display: flex; align-items: center; justify-content: center; transition: all 0.15s; font-size: 18px; }
        .ns-align-btn.active { background: var(--primary); color: #fff; }
        .ns-textarea {
            width: 100%; background: var(--bg); border: 1px solid var(--border);
            border-radius: 8px; padding: 12px 14px; font-size: 16px;
            color: var(--fg); outline: none; transition: border-color 0.2s; resize: vertical;
            min-height: 100px; font-family: inherit;
        }
        .ns-textarea:focus { border-color: var(--primary); }
        .ns-tab-group { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 4px; }
        .ns-tab {
            flex: 1; padding: 8px 10px; background: var(--bg);
            border: 1px solid var(--border); border-radius: 8px;
            color: var(--fg-muted); font-size: 13px; font-family: inherit;
            cursor: pointer; transition: all 0.15s; text-align: center;
            display: flex; align-items: center; justify-content: center; gap: 5px; white-space: nowrap;
        }
        .ns-tab.active { background: rgba(0,111,238,0.1); border-color: var(--primary); color: var(--primary); font-weight: 700; }
        /* 색 칸: 화면 폭에 맞춰 줄 수가 바뀐다(360px에서도 넘치지 않게) */
        .ns-color-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(40px, 1fr)); justify-items: center; gap: 6px; padding: 6px 0; }
        .ns-swatch {
            width: 34px; height: 34px; border-radius: 50%; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: transform 0.15s; border: 2px solid transparent; outline: none;
            flex-shrink: 0;
        }
        .ns-swatch:hover { transform: scale(1.15); }
        .ns-swatch.selected { outline: 2px solid var(--primary); outline-offset: 2px; transform: scale(1.15); }
        .ns-swatch-transparent { background: white; border: 1px solid var(--border); position: relative; overflow: hidden; }
        .ns-swatch-transparent::before { content: ''; position: absolute; width: 140%; height: 2px; background: #f31260; transform: rotate(-45deg); }
        .ns-custom-color { position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; border-radius: 50%; overflow: hidden; }
        .ns-color-input { position: absolute; width: 200%; height: 200%; opacity: 0; cursor: pointer; }
        .ns-color-preview { width: 16px; height: 16px; border-radius: 50%; border: 1px solid rgba(0,0,0,0.1); }
        .ns-color-name { margin: 2px 0 0; font-size: 12px; color: var(--fg-muted); min-height: 1.4em; }
        .ns-font-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 6px; }
        .ns-font-btn {
            min-height: 44px; padding: 6px 6px; font-size: 13px; line-height: 1.3; background: var(--bg);
            border: 1px solid var(--border); border-radius: 8px;
            color: var(--fg-muted); cursor: pointer; font-family: inherit;
            transition: all 0.15s; text-align: center;
            display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px;
        }
        .ns-font-note { font-size: 11px; font-weight: 500; color: var(--fg-muted); }
        .ns-font-btn.active { background: rgba(0,111,238,0.1); border-color: var(--primary); color: var(--primary); font-weight: 700; }
        .ns-preview {
            background: var(--bg); border: 1px solid var(--border); border-radius: 8px;
            padding: 24px; min-height: 100px; display: flex; align-items: center; justify-content: center; overflow: auto;
        }
        .ns-code-wrap { position: relative; margin-bottom: 10px; }
        .ns-code {
            width: 100%; padding: 14px;
            background: #242b3d; color: #c9d8f0;
            border-radius: 10px; font-family: 'JetBrains Mono', monospace; font-size: 12px;
            overflow-x: auto; white-space: pre-wrap; word-break: break-all;
            border: 1px solid #3a4460; margin: 0;
            box-shadow: inset 0 0 0 1px rgba(255,255,255,0.04);
        }
        .ns-copy-main { width: 100%; margin-bottom: 10px; }
        .ns-hint { font-size: 13px; line-height: 1.5; color: var(--fg-muted); display: flex; align-items: flex-start; gap: 6px; margin: 0; }
        .ns-hint .ic { margin-top: 0.2em; }
        .ns-hint code { font-family: 'JetBrains Mono', monospace; font-size: 12px; background: var(--border); padding: 1px 5px; border-radius: 4px; color: var(--fg); }
        .ns-actions { display: flex; gap: 8px; }
        .ns-action-btn {
            flex: 1; min-height: 44px; padding: 10px 13px; background: var(--card-bg);
            border: 1px solid var(--border); border-radius: 10px;
            color: var(--fg-muted); font-size: 13px; font-weight: 600;
            cursor: pointer; transition: all 0.15s;
            display: flex; align-items: center; justify-content: center; gap: 6px; font-family: inherit;
        }
        .ns-action-btn:hover { border-color: var(--primary); color: var(--primary); background: rgba(0,111,238,0.06); }
        .ns-action-btn.ns-action-danger { color: var(--danger); border-color: color-mix(in srgb, var(--danger) 45%, transparent); }
        .ns-action-btn.ns-action-danger:hover { background: color-mix(in srgb, var(--danger) 8%, transparent); color: var(--danger); border-color: var(--danger); }

        /* ── 색상 스와치 Tailwind 다크모드 보정 ── */
        [data-theme="dark"] .ns-swatch.bg-gray-200  { background-color: #3f3f46 !important; }
        [data-theme="dark"] .ns-swatch.bg-white     { background-color: #27272a !important; border-color: #3f3f46 !important; }
        [data-theme="dark"] .ns-swatch-transparent  { background-color: #27272a !important; border-color: #3f3f46 !important; }

        /* ── 색상 탭 (글자색/배경색) 토글 ── */
        .ns-tab-group .ns-tab { min-height: 44px; }

        /* ── 크기 탭 균등 배분 ── */
        .ns-tab-group.size-tabs .ns-tab { flex: 1; }

        /* ── 글꼴 스타일 그리드 호버 ── */
        .ns-font-btn:hover:not(.active) {
            background: rgba(0,111,238,0.06);
            border-color: var(--primary);
            color: var(--primary);
        }

        /* ── 정렬 버튼 호버 ── */
        .ns-align-btn:hover:not(.active) {
            background: var(--bg-sec);
            color: var(--fg);
        }

        /* ── 미리보기 영역 다크모드 배경 ── */
        [data-theme="dark"] .ns-preview { background: #18181b; }

        /* ── 코드 블록 다크모드 ── */
        [data-theme="dark"] .ns-code { background: #0d0d1a; border-color: #1e1e30; }
    </style>
  <script type="application/ld+json" is:inline="">{"@context":"https://schema.org","@type":"WebApplication","name":"노션 수식 꾸미기 (Notion Styler)","description":"노션 수식에 붙여넣는 꾸밈 코드를 만들어요. 글자색·배경색·크기·글꼴을 고르고 복사해 노션 /수식 블록에 붙여넣기.","url":"https://eduin.info/apps/notion-styler/","applicationCategory":"EducationApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"KRW"},"isPartOf":{"@type":"WebSite","name":"eduin VIVES","url":"https://eduin.info"}}</script>
  </Fragment>


    <div id="root"></div>

    <script type="text/babel" is:inline="">
        const { useState, useEffect, useRef } = React;

        // --- 아이콘: 공용 lucide 스프라이트(/common/icons.svg). 크기는 글자 크기(1em) 또는 size(px) ---
        const Icon = ({ name, size, style }) => (
            <svg className="ic" aria-hidden="true" focusable="false"
                style={Object.assign({}, size ? { width: size, height: size } : null, style)}>
                <use href={'/common/icons.svg#' + name} />
            </svg>
        );

        // --- LaTeX 특수문자 이스케이프 (노션 수식 = KaTeX) ---
        // 입력 글자 중 %(주석), &(열 구분), _(아래첨자), #, $, {, }, \, ^, ~ 는 LaTeX 명령으로 해석돼
        // 결과가 깨지므로 글자 그대로 보이도록 바꾼다. '수식 (Math)' 스타일은 사용자가 LaTeX를 직접
        // 쓰는 모드라 이스케이프하지 않는다. (KaTeX 0.16.8에서 \text·\textbf·\mathbb 등 렌더 확인)
        const LATEX_TEXT_ESC = {
            '\\': '\\textbackslash{}', '{': '\\{', '}': '\\}', '%': '\\%', '&': '\\&', '_': '\\_',
            '#': '\\#', '$': '\\$', '^': '\\textasciicircum{}', '~': '\\textasciitilde{}',
        };
        const LATEX_MATH_ESC = {
            '\\': '\\backslash{}', '{': '\\{', '}': '\\}', '%': '\\%', '&': '\\&', '_': '\\_',
            '#': '\\#', '$': '\\$', '^': '\\hat{~}', '~': '\\sim{}',
        };
        const escapeLatexText = (s) => s.replace(/[\\{}%&_#$^~]/g, (c) => LATEX_TEXT_ESC[c]);
        const escapeLatexMath = (s) => s.replace(/[\\{}%&_#$^~]/g, (c) => LATEX_MATH_ESC[c]);

        // --- Main App ---

        const NotionFormulaGenerator = () => {
            const DEFAULT_TEXT = "안녕하세요!";
            const [text, setText] = useState(DEFAULT_TEXT);

            // Text Color State
            const [textColor, setTextColor] = useState("default");
            const [customTextColor, setCustomTextColor] = useState("#000000");

            // Background Color State
            const [bgColor, setBgColor] = useState("transparent");
            const [customBgColor, setCustomBgColor] = useState("#f0f0f0");
            const [colorMode, setColorMode] = useState("text"); // 'text' or 'background'

            const [size, setSize] = useState("normalsize");
            const [fontStyle, setFontStyle] = useState("text");
            const [alignment, setAlignment] = useState("c");
            const [isCopied, setIsCopied] = useState(false);
            const previewRef = useRef(null);

            // Colors
            const colors = [
                { name: '기본', value: 'default', class: 'bg-gray-200 text-black', bgClass: 'bg-white border border-gray-200' },
                { name: '회색', value: 'gray', class: 'bg-gray-400 text-white', bgClass: 'bg-gray-400' },
                { name: '갈색', value: 'brown', class: 'bg-amber-700 text-white', bgClass: 'bg-amber-700' },
                { name: '주황', value: 'orange', class: 'bg-orange-500 text-white', bgClass: 'bg-orange-500' },
                { name: '노랑', value: 'gold', class: 'bg-yellow-400 text-black', bgClass: 'bg-yellow-400' },
                { name: '초록', value: 'green', class: 'bg-green-500 text-white', bgClass: 'bg-green-500' },
                { name: '파랑', value: 'blue', class: 'bg-blue-500 text-white', bgClass: 'bg-blue-500' },
                { name: '보라', value: 'purple', class: 'bg-purple-500 text-white', bgClass: 'bg-purple-500' },
                { name: '분홍', value: 'magenta', class: 'bg-pink-500 text-white', bgClass: 'bg-pink-500' },
                { name: '빨강', value: 'red', class: 'bg-red-500 text-white', bgClass: 'bg-red-500' },
                { name: '직접 고르기', value: 'custom', class: 'bg-white border border-gray-300', bgClass: 'bg-white border border-dashed border-gray-400' },
            ];

            // Sizes
            const sizes = [
                { name: '아주 작게', value: 'tiny' },
                { name: '작게', value: 'small' },
                { name: '보통', value: 'normalsize' },
                { name: '크게', value: 'large' },
                { name: '아주 크게', value: 'huge' },
            ];

            // Styles
            const fontStyles = [
                { name: '기본', value: 'text', cmd: '\\text' },
                { name: '굵게', value: 'textbf', cmd: '\\textbf' },
                { name: '기울임', value: 'textit', cmd: '\\textit', note: '영문만 기울어요', tip: '한글은 기울지 않고 영문만 기울어요.' },
                { name: '고딕', value: 'textsf', cmd: '\\textsf' },
                { name: '타자기', value: 'texttt', cmd: '\\texttt' },
                { name: '수식 그대로', value: 'math', cmd: '', note: 'LaTeX 직접 입력', tip: '입력한 글을 LaTeX 수식 그대로 씁니다. 띄어쓰기는 무시돼요.' },
                { name: '칠판', value: 'mathbb', cmd: '\\mathbb', note: '영문 대문자만', tip: '영문 대문자만 칠판 글꼴로 바뀌어요. 한글·소문자는 제대로 안 보일 수 있어요.' },
                { name: '필기체', value: 'mathcal', cmd: '\\mathcal', note: '영문 대문자만', tip: '영문 대문자만 필기체로 바뀌어요. 한글·소문자는 제대로 안 보일 수 있어요.' },
                { name: '프락투어', value: 'mathfrak', cmd: '\\mathfrak', note: '영문만', tip: '영문만 프락투어 글꼴로 바뀌어요. 한글은 제대로 안 보일 수 있어요.' },
                { name: '명조(세리프)', value: 'mathrm', cmd: '\\textrm' },
            ];

            useEffect(() => {
                renderMath();
            }, [text, textColor, customTextColor, bgColor, customBgColor, size, fontStyle, alignment]);

            const generateLatex = () => {
                if (!text) return "";

                const currentStyle = fontStyles.find(s => s.value === fontStyle);
                const cmd = currentStyle ? currentStyle.cmd : '\\text';

                // Process Lines
                const lines = text.split('\n');
                const styledLines = lines.map(line => {
                    if (fontStyle === 'math') return line;

                    // 빈 줄 처리 (빈 줄이 array를 깨지 않도록 ~ 추가)
                    if (!line.trim()) return `${cmd}{~}`;

                    // Special handling for math fonts that ignore spaces (Bb, Cal, Frak)
                    if (['mathbb', 'mathcal', 'mathfrak'].includes(fontStyle)) {
                        const processedLine = escapeLatexMath(line).split(' ').join('~');
                        return `${cmd}{${processedLine}}`;
                    }

                    return `${cmd}{${escapeLatexText(line)}}`;
                });
                const innerContent = styledLines.join(' \\\\ ');
                const alignedContent = `\\begin{array}{${alignment}}${innerContent}\\end{array}`;

                // Apply Text Color
                let colorCmd = "";
                if (textColor !== 'default') {
                    const c = textColor === 'custom' ? customTextColor : textColor;
                    colorCmd = `\\color{${c}} `;
                }

                // Apply Size
                let sizeCmd = "";
                if (size !== 'normalsize') {
                    sizeCmd = `\\${size} `;
                }

                // Combine inner content with size and text color
                let contentBlock = `{ ${colorCmd}${sizeCmd}${alignedContent} }`;

                // Apply Background Color (Wrap everything in colorbox)
                if (bgColor !== 'transparent') {
                    const bg = bgColor === 'custom' ? customBgColor : bgColor;
                    return `\\colorbox{${bg}}{$\\displaystyle ${contentBlock}$}`;
                }

                return contentBlock;
            };

            const renderMath = () => {
                if (window.katex && previewRef.current) {
                    const latex = generateLatex();
                    try {
                        window.katex.render(latex, previewRef.current, {
                            throwOnError: false,
                            displayMode: true,
                        });
                    } catch (e) {
                        // console.error(e);
                    }
                }
            };

            const handleCopy = () => {
                const latex = generateLatex();
                // 공용 VUI.copy(클립보드 → execCommand). 실패하면 코드 영역을 선택해 직접 복사하게 안내
                if (window.VUI && VUI.copy) {
                    VUI.copy(latex, '코드를 복사했어요. 노션 /수식 블록에 붙여넣으세요.').then((ok) => {
                        if (ok) { setIsCopied(true); setTimeout(() => setIsCopied(false), 2000); return; }
                        VUI.toast('자동 복사가 안 돼요. 코드를 길게 눌러 직접 복사해 주세요.', 'error');
                    });
                    return;
                }
                try {
                    const textArea = document.createElement("textarea");
                    textArea.value = latex;
                    textArea.style.position = "fixed";
                    textArea.style.left = "-9999px";
                    textArea.style.top = "0";
                    document.body.appendChild(textArea);
                    textArea.focus();
                    textArea.select();
                    const successful = document.execCommand('copy');
                    document.body.removeChild(textArea);
                    if (successful) {
                        setIsCopied(true);
                        setTimeout(() => setIsCopied(false), 2000);
                        return;
                    }
                } catch (err) {
                    console.warn("Fallback copy failed", err);
                }

                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(latex)
                        .then(() => {
                            setIsCopied(true);
                            setTimeout(() => setIsCopied(false), 2000);
                        })
                        .catch(err => {
                            if (window.VUI) VUI.toast('복사하지 못했어요. 코드를 길게 눌러 직접 복사해 주세요.', 'error');
                        });
                } else if (window.VUI) {
                    VUI.toast('이 브라우저에서는 자동 복사가 안 돼요. 코드를 길게 눌러 직접 복사해 주세요.', 'error');
                }
            };

            const handleRandomize = () => {
                const validColors = colors.filter(c => c.value !== 'custom');
                const randomTextColor = validColors[Math.floor(Math.random() * validColors.length)];
                setTextColor(randomTextColor.value);

                if (Math.random() < 0.15) {
                    const randomBg = validColors[Math.floor(Math.random() * validColors.length)];
                    setBgColor(randomBg.value);
                } else {
                    setBgColor('transparent');
                }

                const randomSize = sizes[Math.floor(Math.random() * sizes.length)];
                setSize(randomSize.value);

                const randomStyle = fontStyles[Math.floor(Math.random() * fontStyles.length)];
                setFontStyle(randomStyle.value);

                setColorMode('text');
            };

            // 처음부터: 글과 스타일을 처음 상태로. 되돌리기 토스트로 바로 복구할 수 있다
            const handleReset = () => {
                const prev = { text, textColor, customTextColor, bgColor, customBgColor, size, fontStyle, alignment, colorMode };
                setText(DEFAULT_TEXT); setTextColor("default"); setBgColor("transparent"); setSize("normalsize"); setFontStyle("text"); setAlignment("c"); setColorMode("text");
                if (window.VUI) VUI.toast('처음 상태로 돌렸어요.', { action: { label: '되돌리기', onClick: () => {
                    setText(prev.text); setTextColor(prev.textColor); setCustomTextColor(prev.customTextColor);
                    setBgColor(prev.bgColor); setCustomBgColor(prev.customBgColor); setSize(prev.size);
                    setFontStyle(prev.fontStyle); setAlignment(prev.alignment); setColorMode(prev.colorMode);
                } } });
            };

            const currentLatex = generateLatex();
            const currentStyleInfo = fontStyles.find(s => s.value === fontStyle);
            const activeColorName = (() => {
                if (colorMode === 'background' && bgColor === 'transparent') return '배경 없음';
                const v = colorMode === 'text' ? textColor : bgColor;
                const c = colors.find(x => x.value === v);
                return c ? (colorMode === 'text' ? '글자색: ' : '배경색: ') + c.name : '';
            })();

            return (
                <div className="ns-wrap">

                    {/* 헤더 — 전체 너비 */}
                    <div className="app-header ns-full" style={{marginBottom:'8px'}}>
                        <div className="app-badge">노션도구</div>
                        <h1 className="app-title">노션 수식 꾸미기 <span className="app-title-en">Notion Styler</span></h1>
                        <p className="app-desc">노션 수식에 붙여넣는 꾸밈 코드를 만들어요. 색·크기·글꼴을 고른 뒤 ‘코드 복사’를 누르세요.</p>
                    </div>

                    {/* 왼쪽 열 — 설정 */}
                    <div className="ns-col-left">

                        {/* 텍스트 입력 카드 */}
                        <div className="ns-card">
                            <div className="ns-card-title">꾸밀 글</div>
                            <textarea
                                value={text}
                                onChange={(e) => setText(e.target.value)}
                                placeholder="여기에 꾸밀 글을 입력하세요"
                                aria-label="꾸밀 글"
                                className="ns-textarea"
                            />
                        </div>

                        {/* 스타일 설정 카드 */}
                        <div className="ns-card">
                            <div className="ns-card-title">스타일 설정</div>

                            {/* 정렬 */}
                            <div className="ns-label-row" style={{marginBottom:'16px'}}>
                                <label className="ns-label" style={{margin:0}}>정렬</label>
                                <div className="ns-align-btns">
                                    <button type="button" onClick={() => setAlignment('l')} className={`ns-align-btn ${alignment === 'l' ? 'active' : ''}`} title="왼쪽 정렬" aria-label="왼쪽 정렬" aria-pressed={alignment === 'l'}><Icon name="align-left"/></button>
                                    <button type="button" onClick={() => setAlignment('c')} className={`ns-align-btn ${alignment === 'c' ? 'active' : ''}`} title="가운데 정렬" aria-label="가운데 정렬" aria-pressed={alignment === 'c'}><Icon name="align-center"/></button>
                                    <button type="button" onClick={() => setAlignment('r')} className={`ns-align-btn ${alignment === 'r' ? 'active' : ''}`} title="오른쪽 정렬" aria-label="오른쪽 정렬" aria-pressed={alignment === 'r'}><Icon name="align-right"/></button>
                                </div>
                            </div>

                            {/* 색상 */}
                            <label className="ns-label">색상</label>
                            <div className="ns-tab-group" style={{marginBottom:'10px'}}>
                                <button type="button" onClick={() => setColorMode('text')} className={`ns-tab ${colorMode === 'text' ? 'active' : ''}`} aria-pressed={colorMode === 'text'}>
                                    <Icon name="type"/> 글자색
                                </button>
                                <button type="button" onClick={() => setColorMode('background')} className={`ns-tab ${colorMode === 'background' ? 'active' : ''}`} aria-pressed={colorMode === 'background'}>
                                    <Icon name="paint-bucket"/> 배경색
                                </button>
                            </div>
                            <div className="ns-color-grid">
                                {colorMode === 'background' && (
                                    <button type="button" onClick={() => setBgColor('transparent')} className={`ns-swatch ns-swatch-transparent ${bgColor === 'transparent' ? 'selected' : ''}`} title="배경 없음" aria-label="배경 없음" aria-pressed={bgColor === 'transparent'}/>
                                )}
                                {colors.map((c) => {
                                    const isActive = colorMode === 'text' ? textColor === c.value : bgColor === c.value;
                                    const setFn = colorMode === 'text' ? setTextColor : setBgColor;
                                    const displayClass = colorMode === 'text' ? c.class : c.bgClass;
                                    if (colorMode === 'background' && c.value === 'default') return null;
                                    return (
                                        <button type="button" key={c.value} onClick={() => setFn(c.value)}
                                            className={`ns-swatch ${displayClass} ${isActive ? 'selected' : ''}`} title={c.name}
                                            aria-label={(colorMode === 'text' ? '글자색 ' : '배경색 ') + c.name} aria-pressed={isActive}>
                                            {c.value === 'custom' && (
                                                <div className="ns-custom-color">
                                                    <input type="color" className="ns-color-input"
                                                        value={colorMode === 'text' ? customTextColor : customBgColor}
                                                        onChange={(e) => {
                                                            if (colorMode === 'text') { setCustomTextColor(e.target.value); setTextColor('custom'); }
                                                            else { setCustomBgColor(e.target.value); setBgColor('custom'); }
                                                        }}
                                                    />
                                                    <span className="ns-color-preview" style={{backgroundColor: colorMode === 'text' ? customTextColor : customBgColor}}/>
                                                </div>
                                            )}
                                            {isActive && c.value !== 'custom' && (
                                                <Icon name="check" size={16} style={{color: ['default','gold'].includes(c.value) ? '#000' : '#fff'}}/>
                                            )}
                                        </button>
                                    );
                                })}
                            </div>
                            <p className="ns-color-name" aria-live="polite">{activeColorName}</p>

                            {/* 크기 */}
                            <label className="ns-label" style={{marginTop:'16px'}}>크기</label>
                            <div className="ns-tab-group">
                                {sizes.map(s => (
                                    <button type="button" key={s.value} onClick={() => setSize(s.value)} className={`ns-tab ${size === s.value ? 'active' : ''}`} aria-pressed={size === s.value}>{s.name}</button>
                                ))}
                            </div>

                            {/* 글꼴 스타일 */}
                            <label className="ns-label" style={{marginTop:'16px'}}>글꼴 스타일</label>
                            <div className="ns-font-grid">
                                {fontStyles.map(style => (
                                    <button type="button" key={style.value} onClick={() => setFontStyle(style.value)} aria-pressed={fontStyle === style.value}
                                        className={`ns-font-btn ${fontStyle === style.value ? 'active' : ''}`}>
                                        <span>{style.name}</span>
                                        {style.note && <span className="ns-font-note">{style.note}</span>}
                                    </button>
                                ))}
                            </div>
                            <p className="ns-color-name" aria-live="polite">{currentStyleInfo && currentStyleInfo.tip ? currentStyleInfo.tip : ''}</p>
                        </div>

                    </div>{/* /ns-col-left */}

                    {/* 오른쪽 열 — 미리보기 & 코드 */}
                    <div className="ns-col-right">

                        {/* 미리보기 카드 */}
                        <div className="ns-card">
                            <div className="ns-card-title">미리보기</div>
                            <div className="ns-preview" style={{
                                justifyContent: alignment === 'l' ? 'flex-start' : alignment === 'r' ? 'flex-end' : 'center'
                            }}>
                                <div ref={previewRef}></div>
                            </div>
                        </div>

                        {/* 코드 출력 카드 */}
                        <div className="ns-card">
                            <div className="ns-card-title">노션에 붙여넣을 코드</div>
                            <div className="ns-code-wrap">
                                <pre className="ns-code">{currentLatex}</pre>
                            </div>
                            <button type="button" onClick={handleCopy} className="hero-btn ns-copy-main">
                                {isCopied ? <Icon name="check"/> : <Icon name="copy"/>} {isCopied ? '복사했어요' : '코드 복사'}
                            </button>
                            <p className="ns-hint"><Icon name="info"/> <span>노션에서 <code>/수식</code>(또는 <code>/math</code>)을 입력해 수식 블록을 만든 뒤 붙여넣으세요.</span></p>
                        </div>

                        {/* 액션 버튼 */}
                        <div className="ns-actions">
                            <button type="button" onClick={handleRandomize} className="ns-action-btn"><Icon name="shuffle"/> 아무 스타일이나</button>
                            <button type="button" onClick={handleReset}
                                className="ns-action-btn ns-action-danger"><Icon name="refresh-ccw"/> 처음부터</button>
                        </div>

                    </div>{/* /ns-col-right */}

                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<NotionFormulaGenerator />);
    </script>

    <script is:inline="">
        // 외부 CDN(React·Babel 등) 중 하나라도 막히면 빈 화면만 남으므로 안내를 보여준다
        window.addEventListener('load', function () {
            setTimeout(function () {
                var r = document.getElementById('root');
                if (!r || r.childElementCount) return;
                var missing = [];
                if (!window.React || !window.ReactDOM) missing.push('React');
                if (!window.Babel) missing.push('Babel');
                if (!window.katex) missing.push('KaTeX');
                r.innerHTML = '<div style="max-width:560px;margin:4rem auto;padding:1.25rem 1.5rem;border:1px solid var(--border);border-radius:12px;background:var(--card-bg);color:var(--fg);line-height:1.6">' +
                    '<b>화면을 불러오지 못했습니다.</b><br>필요한 외부 도구' + (missing.length ? '(' + missing.join(', ') + ')' : '') +
                    '를 받지 못했어요. 학교망에서 외부 사이트(unpkg.com, cdn.jsdelivr.net, cdn.tailwindcss.com)가 막혀 있을 수 있습니다. 새로고침하거나 다른 네트워크에서 열어 주세요.</div>';
            }, 2500);
        });
    </script>



</AppLayout>
