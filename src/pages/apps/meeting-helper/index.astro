---
import AppLayout from '../../../layouts/AppLayout.astro';
import Icon from '../../../components/Icon.astro';
// 협의 도우미(옛 주소 /apps/meet-date/ → _redirects) — 일정 정하기·활동 날짜와 확인서·실시간 등록부 (docs/meet-date-plan.md §11)
// 서버: /api/meet-date(D1 meet_events·meet_responses·meet_signs). 등록부·확인서 HWPX는 hwpx.js가 브라우저에서 만든다.
// 화면: #new(만들기) · #m=CODE(응답) · #s=CODE(출석 서명) · #m=CODE&k=KEY / #manage=CODE(관리)
//       #edit=CODE(설정 고치기) · #share=…(양식 복제)
---
<AppLayout bodyShell="column" bodyWidth="medium" sync>
  <Fragment slot="head">
    <link rel="stylesheet" href="./styles.css?v=20261127g">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" is:inline></script>
  </Fragment>

  <main class="app-main">
    <div class="app-header">
      <div class="app-badge">업무경감</div>
      <h1 class="app-title">협의 도우미</h1>
      <p class="app-desc">링크 하나로 일정을 정하고, 활동 확인서와 서명 등록부까지 모아요.</p>
    </div>

    <div class="md-layout">
    <!-- 담당자 사이드바(만들기·관리 화면). 좁은 화면에서는 맨 위 접힌 메뉴 상자. 내용은 app.js renderSide() -->
    <aside id="md-side" class="md-side" hidden>
      <details id="md-side-box" class="md-side-box">
        <summary class="md-side-sum"><Icon name="menu" /> 협의 도우미 메뉴</summary>
        <nav class="md-side-nav" aria-label="협의 도우미 메뉴">
          <a class="md-side-link" href="#" data-nav="home"><Icon name="house" /> 처음 화면</a>
          <p class="md-side-h">새로 만들기</p>
          <a class="md-side-link" href="#new=schedule" data-nav="new-schedule"><Icon name="calendar-clock" /> 일정 정하기</a>
          <a class="md-side-link" href="#new=activity" data-nav="new-activity"><Icon name="file-check" /> 활동 날짜 + 확인서</a>
          <a class="md-side-link" href="#new=live" data-nav="new-live"><Icon name="pen-line" /> 실시간 등록부</a>
          <div id="md-side-steps" hidden>
            <p id="md-side-steps-h" class="md-side-h">단계</p>
            <ol id="md-side-steps-list" class="md-steps"></ol>
          </div>
          <div id="md-side-mine" hidden>
            <p class="md-side-h">내가 만든 협의</p>
            <ul id="md-side-mine-list" class="md-side-mine"></ul>
          </div>
          <div id="md-side-joined" hidden>
            <p class="md-side-h">내가 참여한 협의</p>
            <ul id="md-side-joined-list" class="md-side-mine"></ul>
          </div>
          <p id="md-side-sync" class="md-side-sync"></p>
        </nav>
      </details>
    </aside>
    <div class="md-body">

    <!-- 받은 사람 화면(응답·서명)에서 앱 처음 화면(종류 고르기·내 목록)으로 -->
    <a id="md-to-home" class="hero-btn hero-btn-ghost hero-btn-sm md-to-home" href="#" hidden><Icon name="arrow-left" /> 협의 도우미 처음 화면</a>

    <p id="loading" class="md-status" aria-live="polite">불러오는 중...</p>

    <!-- 시작 -->
    <section id="view-home" class="md-view" hidden>
      <!-- 내가 참여한 협의·내가 만든 협의(이 기기 + VIVES 동기화). 상태는 열 때 협의마다 불러옴(§13) -->
      <div id="home-joined" class="md-card" hidden>
        <h2 class="md-h2"><Icon name="inbox" /> 내가 참여한 협의 <span id="home-joined-n" class="md-pill"></span></h2>
        <ul id="joined-list" class="md-evs"></ul>
      </div>
      <div id="home-mine" class="md-card" hidden>
        <h2 class="md-h2"><Icon name="clipboard-list" /> 내가 만든 협의 <span id="home-mine-n" class="md-pill"></span></h2>
        <ul id="mine-list" class="md-evs"></ul>
      </div>

      <h2 class="md-h2 md-home-h">새로 만들기</h2>
      <div class="md-kinds">
        <a class="md-kind-card" href="#new=schedule">
          <span class="md-kind-ic"><Icon name="calendar-clock" /></span>
          <b>일정 정하기</b>
          <span>후보 시간 중 되는 시간을 받아 확정하고 안내해요.</span>
        </a>
        <a class="md-kind-card" href="#new=activity">
          <span class="md-kind-ic"><Icon name="file-text" /></span>
          <b>활동 날짜 받기 + 확인서</b>
          <span>정한 횟수만큼 날짜를 고르고 활동 확인서를 받아 내요.</span>
        </a>
        <a class="md-kind-card" href="#new=live">
          <span class="md-kind-ic"><Icon name="pen-line" /></span>
          <b>실시간 등록부</b>
          <span>협의 시간에 QR을 띄우면 들어온 사람이 손글씨로 서명해요.</span>
        </a>
      </div>
      <div id="home-sync" class="md-card md-sync-card">
        <h2 class="md-h2"><Icon name="refresh-cw" /> 동기화 코드</h2>
        <p id="home-sync-note" class="md-note md-mt0"></p>
        <div class="md-actions md-actions-left">
          <button id="btn-home-code" class="hero-btn hero-btn-ghost hero-btn-sm" type="button"><Icon name="refresh-cw" /> <span>코드 넣기·만들기</span></button>
        </div>
      </div>
      <div class="md-card">
        <h2 class="md-h2"><Icon name="link" /> 관리 링크로 열기</h2>
        <form id="form-open" class="md-row">
          <input id="in-open" class="hero-input" type="text" spellcheck="false" placeholder="관리 링크를 붙여 넣으세요" aria-label="관리 링크">
          <button class="hero-btn hero-btn-ghost" type="submit">열기</button>
        </form>
      </div>
    </section>

    <!-- 만들기·고치기 -->
    <section id="view-new" class="md-view" hidden>
      <form id="form-new" novalidate>
        <!-- 내 협의 묶기: VIVES 동기화 코드(만들 때 필수, §13). 고치기 화면에서는 숨김 -->
        <div id="f-card-code" class="md-card md-code-card">
          <h2 class="md-h2"><Icon name="refresh-cw" /> 내 협의 묶기 - VIVES 동기화 코드</h2>
          <div id="code-on" hidden>
            <p class="md-note md-mt0">동기화 코드 <b id="code-mask" class="md-code"></b> <button id="btn-code-reveal" class="hero-btn hero-btn-ghost hero-btn-sm" type="button">코드 보기</button></p>
            <p class="md-note">이 코드를 넣은 기기라면 어디서든 협의 도우미 처음 화면의 '내가 만든 협의'에서 바로 열 수 있어요. 참석자 이름과 서명이 들어 있으니 <b>코드는 남에게 보여 주지 마세요.</b></p>
          </div>
          <div id="code-off" hidden>
            <p class="md-note md-mt0">협의를 만들려면 동기화 코드가 필요해요. 코드가 있는 기기에서는 관리 링크 없이도 내가 만든 협의를 열 수 있어요. 로그인과 개인정보는 없어요.</p>
            <div class="md-actions md-actions-left">
              <button id="btn-code-new" class="hero-btn hero-btn-sm" type="button"><Icon name="plus" /> 새 코드 만들기</button>
            </div>
            <div class="md-row md-mt">
              <input id="code-in" class="hero-input md-code-in" maxlength="6" autocomplete="off" spellcheck="false" placeholder="가진 코드 6자리" aria-label="가진 동기화 코드">
              <button id="btn-code-connect" class="hero-btn hero-btn-ghost" type="button">연결</button>
            </div>
          </div>
        </div>
        <div id="f-card-kind" class="md-card">
          <h2 class="md-h2">무엇을 할까요?</h2>
          <div class="md-seg md-seg3" role="radiogroup" aria-label="종류">
            <label><input type="radio" name="f-kind" value="schedule" checked> <span><b>일정 정하기</b><small>모일 시간을 받아 확정</small></span></label>
            <label><input type="radio" name="f-kind" value="activity"> <span><b>활동 날짜 + 확인서</b><small>날짜를 골라 확인서 내기</small></span></label>
            <label><input type="radio" name="f-kind" value="live"> <span><b>실시간 등록부</b><small>그 자리에서 손글씨 서명</small></span></label>
          </div>
        </div>

        <div id="f-card-content" class="md-card">
          <h2 class="md-h2"><span class="md-num">1</span> 내용</h2>
          <label class="md-field"><span class="md-label">제목 <em>필수</em></span>
            <input id="f-title" class="hero-input" maxlength="60" placeholder="예) 2학년 교육과정 협의회" required></label>
          <label class="md-field"><span class="md-label">내용</span>
            <textarea id="f-desc" class="hero-input md-textarea" maxlength="1000" placeholder="협의할 내용이나 활동 내용을 짧게 적어 주세요."></textarea></label>
          <div class="md-grid2">
            <label class="md-field"><span class="md-label">장소</span>
              <input id="f-place" class="hero-input" maxlength="60" placeholder="예) 2학년 연구실"></label>
            <label class="md-field"><span class="md-label">담당자 이름</span>
              <input id="f-owner" class="hero-input" maxlength="20" placeholder="등록부·확인서 아래에 들어가요(선택)"></label>
          </div>
        </div>

        <div id="f-card-time" class="md-card">
          <h2 class="md-h2"><span class="md-num">2</span> 날짜와 시간</h2>

          <div id="live-opts" hidden>
            <div class="md-grid3">
              <label class="md-field"><span class="md-label">날짜</span><input id="f-live-d" class="hero-input" type="date"></label>
              <label class="md-field"><span class="md-label">시작</span><input id="f-live-s" class="hero-input" type="time" step="300" value="15:00"></label>
              <label class="md-field"><span class="md-label">끝</span><input id="f-live-e" class="hero-input" type="time" step="300" value="16:00"></label>
            </div>
            <label class="md-check-line"><input type="checkbox" id="f-live-open" checked> 만들자마자 출석 받기 시작</label>
          </div>

          <div id="range-opts">
            <div class="md-seg" role="radiogroup" aria-label="시간 받는 방식">
              <label><input type="radio" name="f-mode" value="pick" checked> <span><b>후보 중에서 고르기</b><small>내가 정한 시간 가운데 골라요</small></span></label>
              <label><input type="radio" name="f-mode" value="free"> <span><b>직접 적기</b><small>기간 안에서 각자 날짜와 시간을 적어요</small></span></label>
            </div>
            <div class="md-grid2">
              <label class="md-field"><span class="md-label">시작 날짜</span><input id="f-from" class="hero-input" type="date" required></label>
              <label class="md-field"><span class="md-label">끝 날짜</span><input id="f-to" class="hero-input" type="date" required></label>
            </div>

            <div id="pick-opts">
              <div class="md-field"><span class="md-label">요일</span>
                <div id="f-dows" class="md-chips" role="group" aria-label="요일"></div></div>
              <div class="md-field"><span class="md-label">시간대</span>
                <div id="f-times" class="md-times"></div>
                <button id="btn-add-time" class="hero-btn hero-btn-ghost hero-btn-sm" type="button"><Icon name="plus" /> 시간대 더하기</button>
              </div>
              <div class="md-field">
                <div class="md-label-row"><span class="md-label">후보 시간 <span id="slot-count" class="md-pill"></span></span>
                  <span class="md-note md-inline">누르면 빼거나 다시 넣어요</span></div>
                <div id="slot-grid" class="md-grid-wrap"></div>
              </div>
            </div>

            <div class="md-grid2">
              <label class="md-field"><span class="md-label" id="rule-label">몇 개 고르게 할까요?</span>
                <select id="f-rule" class="hero-input">
                  <option value="any">되는 시간 모두(1개 이상)</option>
                  <option value="exact">정확히 정한 횟수</option>
                  <option value="min">정한 횟수 이상</option>
                </select></label>
              <label class="md-field" id="rule-n-wrap" hidden><span class="md-label">횟수</span>
                <input id="f-rule-n" class="hero-input" type="number" min="1" max="50" value="1"></label>
            </div>
          </div>
        </div>

        <div id="f-card-fields" class="md-card">
          <h2 class="md-h2"><span class="md-num">3</span> 받을 정보</h2>
          <p class="md-note md-mt0">이름은 늘 받아요. 더 받을 정보는 꼭 필요할 때 고르세요.</p>
          <div class="md-checks">
            <label><input type="checkbox" name="f-field" value="org"> 소속(학교·부서)</label>
            <label><input type="checkbox" name="f-field" value="pos"> 직위</label>
            <label><input type="checkbox" name="f-field" value="cls"> 학년반·과목</label>
            <label class="not-live"><input type="checkbox" id="f-memo"> 의견 한 줄</label>
          </div>
          <label class="md-check-line not-live"><input type="checkbox" id="f-others"> 응답한 사람끼리 누가 어느 시간을 골랐는지 보여 주기</label>
        </div>

        <div id="f-card-form" class="md-card">
          <h2 class="md-h2"><span class="md-num">4</span> <span id="form-h">등록부 양식</span></h2>
          <label class="md-field"><span class="md-label">문서 제목</span>
            <input id="f-form-title" class="hero-input" maxlength="40"></label>
          <label class="md-field not-activity"><span class="md-label">머리말(표 위 문장, 선택)</span>
            <input id="f-form-head" class="hero-input" maxlength="300" placeholder="예) 2027학년도 교육과정 편성을 위한 협의회 참석자 명단"></label>
          <label class="md-field"><span class="md-label">확인 문구</span>
            <input id="f-form-foot" class="hero-input" maxlength="200"></label>
          <div class="md-grid2 only-schedule">
            <label class="md-field"><span class="md-label">서명란</span>
              <select id="f-sign" class="hero-input">
                <option value="name">이름을 넣어 두기</option>
                <option value="blank">비워 두기(출력해서 서명)</option>
              </select></label>
            <label class="md-check-line md-self-end"><input type="checkbox" id="f-when" checked> '참석 일시' 열 넣기</label>
          </div>
          <div class="only-activity">
            <span class="md-label">확인서 내는 방법</span>
            <div class="md-checks">
              <label><input type="checkbox" id="f-sub-file" checked> 파일로 받아 보내기(메신저 등)</label>
              <label><input type="checkbox" id="f-sub-direct" checked> 화면에서 서명해 바로 내기</label>
            </div>
          </div>
        </div>

        <div id="f-card-close" class="md-card">
          <h2 class="md-h2"><span class="md-num">5</span> 마감</h2>
          <label class="md-field"><span class="md-label" id="close-label">응답 마감 일시</span>
            <input id="f-close" class="hero-input" type="datetime-local" required></label>
          <p class="md-note md-mt0">받은 내용과 서명은 마감 30일 뒤에 자동으로 지워져요. 등록부는 그 전에 받아 두세요.</p>
        </div>

        <p id="new-error" class="md-error" role="alert" hidden></p>
        <div class="md-actions">
          <button id="btn-cancel-new" class="hero-btn hero-btn-ghost" type="button">취소</button>
          <button id="btn-save-new" class="hero-btn" type="submit"><Icon name="check" /> <span>만들고 링크 받기</span></button>
        </div>
      </form>
    </section>

    <!-- 응답 -->
    <section id="view-respond" class="md-view" hidden>
      <div id="r-head" class="md-card"></div>
      <div id="r-done" class="md-card md-done" hidden></div>
      <div id="r-cert" class="md-card" hidden>
        <h2 class="md-h2"><Icon name="file-text" /> 내 활동 확인서</h2>
        <p id="r-cert-state" class="md-note md-mt0"></p>
        <div class="md-field">
          <div class="md-label-row"><span class="md-label">서명(선택)</span>
            <button id="btn-cert-clear" class="hero-btn hero-btn-ghost hero-btn-sm" type="button"><Icon name="eraser" /> 지우기</button></div>
          <div id="cert-pad" class="md-pad"></div>
          <p class="md-note">비워 두면 확인서를 받아 한글에서 서명해도 돼요.</p>
        </div>
        <div class="md-actions md-actions-left">
          <button id="btn-cert-file" class="hero-btn hero-btn-ghost" type="button"><Icon name="download" /> 확인서 받기(HWPX)</button>
          <button id="btn-cert-direct" class="hero-btn" type="button"><Icon name="send" /> 담당자에게 바로 내기</button>
        </div>
        <p id="r-cert-file-note" class="md-note">받은 파일은 메신저 등으로 담당자에게 보내 주세요.</p>
      </div>
      <form id="form-resp" novalidate>
        <div class="md-card">
          <div class="md-label-row">
            <h2 class="md-h2 md-mb0"><Icon name="calendar-clock" /> <span id="r-pick-h">되는 시간 고르기</span></h2>
            <span id="r-pick-count" class="md-pill"></span>
          </div>
          <p id="r-rule" class="md-note"></p>
          <div id="r-slots"></div>
          <div id="r-free" hidden>
            <div id="r-free-rows" class="md-times"></div>
            <button id="btn-add-free" class="hero-btn hero-btn-ghost hero-btn-sm" type="button"><Icon name="plus" /> 날짜 더하기</button>
          </div>
        </div>
        <div class="md-card">
          <h2 class="md-h2"><Icon name="pen-line" /> 내 정보</h2>
          <label class="md-field"><span class="md-label">이름 <em>필수</em></span>
            <input id="r-name" class="hero-input" maxlength="20" autocomplete="name" required></label>
          <div id="r-fields" class="md-grid2"></div>
          <label id="r-memo-wrap" class="md-field" hidden><span class="md-label">의견 한 줄(선택)</span>
            <input id="r-memo" class="hero-input" maxlength="200"></label>
          <p id="r-privacy" class="md-note"></p>
        </div>
        <p id="resp-error" class="md-error" role="alert" hidden></p>
        <div class="md-actions">
          <button id="btn-resp-cancel" class="hero-btn hero-btn-ghost" type="button" hidden>고치기 취소</button>
          <button id="btn-resp" class="hero-btn" type="submit"><Icon name="send" /> <span>제출하기</span></button>
        </div>
      </form>
    </section>

    <!-- 출석 서명(실시간 등록부) -->
    <section id="view-sign" class="md-view" hidden>
      <div id="s-head" class="md-card"></div>
      <div id="s-done" class="md-card md-done" hidden></div>
      <form id="form-sign" class="md-card" novalidate>
        <h2 class="md-h2"><Icon name="pen-line" /> 출석 서명</h2>
        <label class="md-field"><span class="md-label">이름 <em>필수</em></span>
          <input id="s-name" class="hero-input" maxlength="20" autocomplete="name" required></label>
        <div id="s-fields" class="md-grid2"></div>
        <div class="md-field">
          <div class="md-label-row"><span class="md-label">서명 <em>필수</em></span>
            <button id="btn-sign-clear" class="hero-btn hero-btn-ghost hero-btn-sm" type="button"><Icon name="eraser" /> 지우기</button></div>
          <div id="sign-pad" class="md-pad"></div>
        </div>
        <p id="s-privacy" class="md-note"></p>
        <p id="sign-error" class="md-error" role="alert" hidden></p>
        <div class="md-actions md-mb0">
          <button id="btn-sign-cancel" class="hero-btn hero-btn-ghost" type="button" hidden>취소</button>
          <button id="btn-sign" class="hero-btn" type="submit"><Icon name="check" /> <span>출석하기</span></button>
        </div>
      </form>
