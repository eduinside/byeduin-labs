        </div>
        <div id="m-summary"></div>
        <div id="m-confirm-bar" class="md-confirm-bar" hidden>
          <span id="m-confirm-msg"></span>
          <button id="btn-confirm" class="hero-btn hero-btn-sm" type="button"><Icon name="check" /> 확정 저장</button>
        </div>
      </div>

