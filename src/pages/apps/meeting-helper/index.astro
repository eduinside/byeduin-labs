          <p id="m-expect-out" class="md-note"></p>
        </details>
      </div>

      <div id="m-admin-card" class="md-card">
        <h2 class="md-h2"><Icon name="settings" /> 관리</h2>
        <div class="md-actions md-actions-left">
          <button id="btn-edit" class="hero-btn hero-btn-ghost hero-btn-sm" type="button"><Icon name="pencil" /> 설정 고치기</button>
          <button id="btn-close-now" class="hero-btn hero-btn-ghost hero-btn-sm" type="button"><Icon name="calendar-x" /> 마감 바꾸기</button>
          <button id="btn-clone" class="hero-btn hero-btn-ghost hero-btn-sm" type="button"><Icon name="copy-plus" /> 이 설정으로 새로 만들기</button>
          <button id="btn-clone-link" class="hero-btn hero-btn-ghost hero-btn-sm" type="button"><Icon name="link" /> 양식 링크 보내기</button>
          <button id="btn-delete" class="hero-btn hero-btn-danger hero-btn-sm" type="button"><Icon name="trash-2" /> 지우기</button>
        </div>
      </div>
    </section>

    <!-- 큰 화면 출석 -->
    <div id="live-big" class="md-live-big" hidden>
