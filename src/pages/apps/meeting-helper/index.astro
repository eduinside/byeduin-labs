          <p class="md-live-count"><b id="lb-count">0</b>명 출석</p>
          <ul id="lb-list" class="md-live-list"></ul>
        </div>
      </div>
      <button id="btn-live-big-close" class="hero-btn hero-btn-ghost md-live-close" type="button"><Icon name="x" /> 닫기</button>
