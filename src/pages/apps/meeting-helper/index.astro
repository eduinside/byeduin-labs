          <button id="btn-msg-remind" class="hero-btn hero-btn-ghost hero-btn-sm" type="button"><Icon name="bell" /> 독촉 문구</button>
          <button id="btn-gcal" class="hero-btn hero-btn-ghost hero-btn-sm" type="button"><Icon name="calendar-plus" /> 구글 캘린더 링크</button>
