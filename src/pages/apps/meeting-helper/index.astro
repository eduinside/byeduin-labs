          <div class="md-row">
            <input id="m-resp-link" class="hero-input" readonly aria-label="응답 링크">
            <button id="btn-share-resp" class="hero-btn" type="button"><Icon name="copy" /> 복사·QR</button>
          </div>
        </div>
        <details id="m-admin-more" class="md-details">
          <summary>다른 방법으로 열기 - 관리 링크</summary>
          <p id="m-admin-note" class="md-note md-mt0"></p>
          <div class="md-row">
            <input id="m-admin-link" class="hero-input" readonly aria-label="관리 링크" type="password">
            <button id="btn-show-admin" class="hero-btn hero-btn-ghost hero-btn-icon" type="button" aria-label="관리 링크 보기"><Icon name="eye" /></button>
            <button id="btn-copy-admin" class="hero-btn hero-btn-ghost" type="button"><Icon name="copy" /> 복사</button>
          </div>
        </details>
      </div>

      <div id="m-tally-card" class="md-card">
