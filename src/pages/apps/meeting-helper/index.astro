      <div id="m-live" class="md-card" hidden>
        <div class="md-label-row">
          <h2 class="md-h2 md-mb0"><Icon name="pen-line" /> 실시간 출석 <span id="m-live-pill" class="md-pill"></span></h2>
          <span id="m-sign-count" class="md-pill"></span>
        </div>
        <p id="m-live-note" class="md-note md-mt0"></p>
        <div class="md-actions md-actions-left md-mt">
          <button id="btn-live-toggle" class="hero-btn hero-btn-sm" type="button"><Icon name="play" /> <span>출석 받기 시작</span></button>
          <button id="btn-live-big" class="hero-btn hero-btn-ghost hero-btn-sm" type="button"><Icon name="qr-code" /> 큰 화면으로 QR</button>
          <button id="btn-live-link" class="hero-btn hero-btn-ghost hero-btn-sm" type="button"><Icon name="copy" /> 출석 링크</button>
        </div>
        <div id="m-signs" class="md-signs"></div>
        <div class="md-actions md-actions-left md-mt">
