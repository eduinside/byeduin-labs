/* ===== 여행 모드 ===== */
let travelPlaying = !reducedMotion(); // 움직임 줄이기 설정이면 멈춘 채로 시작(재생 버튼으로 재생)
let travelSpeed = 1;
let travelAngle = PLANETS.map((p,i) => (i * 0.7)); // 시작 각도 분산
const ORBIT_BASE = 68, ORBIT_STEP = 36;
const TRAVEL_VB = { x:20, y:20, w:760, h:760 }; // 해왕성 궤도(반지름 320)+행성+이름표까지

function planetSpeed(i){
  // 초당 각도(rad/s). 실제 케플러 비율 대신, "안쪽이 빠르다"는 정성적 순서만 단조 감소로 보장
  // (예전: 프레임마다 0.018/(i+1)^0.6 → 60Hz 기준 초당 값으로 바꿔 120Hz에서도 같은 빠르기)
  return 1.08 / Math.pow(i+1, 0.6);
}
// 프레임 수가 아니라 경과 시간(dt초) 기준. 탭이 숨겨지면 SimKit.loop가 알아서 멈춘다
const travelLoop = SimKit.loop(dt => {
  PLANETS.forEach((p,i) => { travelAngle[i] += planetSpeed(i)*travelSpeed*dt; });
  drawTravelFrame();
});

function renderTravel(){
  const cx = 400, cy = 400;
  const orbits = PLANETS.map((p,i) => {
    const r = ORBIT_BASE + i*ORBIT_STEP;
    return `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="var(--ss-orbit)" stroke-width="1.5"/>`;
  }).join('');

  app.innerHTML = `
  <div class="stage-screen travel">
    <div class="ss-topbar">
      <button class="sk-btn sk-btn--sm" onclick="go('hub')">${icon('arrow-left')} 허브로</button>
      <span class="ss-caption">궤도 간격은 보기 편하게 줄였어요 · 실제 거리는 '거리 비교'에서</span>
    </div>
    <div class="stage-main travel-stage">
      <svg id="travelSvg" viewBox="${TRAVEL_VB.x} ${TRAVEL_VB.y} ${TRAVEL_VB.w} ${TRAVEL_VB.h}" preserveAspectRatio="xMidYMid meet">
        ${orbits}
        <g id="sunHolder"></g>
        <g id="planetHolder"></g>
      </svg>
    </div>
    <div class="travel-controls">
      <button class="sk-btn sk-btn--sm" id="playBtn" onclick="toggleTravelPlay()"></button>
      <input type="range" id="speedRange" min="0.25" max="3" step="0.25" value="${travelSpeed}" aria-label="공전 빠르기" oninput="travelSpeed=parseFloat(this.value)">
      <label for="speedRange">배속</label>
    </div>
    <div class="info-sheet" id="travelSheet" role="dialog" aria-label="행성 설명"></div>
  </div>`;

  const sunHolder = document.getElementById('sunHolder');
  sunHolder.innerHTML = `<g transform="translate(${cx-40},${cy-40})">${sunSVG(40)}</g>`;

  updatePlayBtn();
  drawTravelFrame();
  fitTravelLabels();
  syncTravelLoop();
}
function travelTokenSize(p){ return 10 + Math.min(p.diameterEarth, 6)*1.6; }
// 행성 요소는 화면에 들어올 때 한 번만 만들고, 프레임마다 transform 속성만 바꾼다(P8)
function drawTravelFrame(){
  const cx = 400, cy = 400;
  const holder = document.getElementById('planetHolder');
  if(!holder) return;
  if(holder.childElementCount !== PLANETS.length){
    holder.innerHTML = PLANETS.map((p,i) => {
      const size = travelTokenSize(p);
      return `<g class="planet-token" tabindex="0" role="button" aria-label="${p.name}"
                onclick="openTravelInfo('${p.id}')"
                onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openTravelInfo('${p.id}')}">
                ${planetSVG(p, size)}
                <text class="planet-label" x="${size}" y="${size*2 + 11}" text-anchor="middle" font-size="11" font-weight="700">${p.name}</text>
              </g>`;
    }).join('');
  }
  const tokens = holder.children;
  PLANETS.forEach((p,i) => {
    const r = ORBIT_BASE + i*ORBIT_STEP;
    const a = travelAngle[i];
    const size = travelTokenSize(p);
    const x = cx + r*Math.cos(a), y = cy + r*Math.sin(a);
    tokens[i].setAttribute('transform', `translate(${(x-size).toFixed(2)},${(y-size).toFixed(2)})`);
  });
}
// 무대가 작아져도(360px 폰) 행성 이름이 화면에서 12px 이상이 되게 글자 크기를 viewBox 단위로 맞춘다
function fitTravelLabels(){
  const svg = document.getElementById('travelSvg');
  if(!svg) return;
  const rect = svg.getBoundingClientRect();
  if(!rect.width || !rect.height) return;
  const scale = Math.min(rect.width / TRAVEL_VB.w, rect.height / TRAVEL_VB.h);
  const fs = Math.max(12, Math.min(34, 13 / scale));
  svg.querySelectorAll('#planetHolder .planet-token').forEach((g, i) => {
    const t = g.querySelector('.planet-label');
    if(!t) return;
    const size = travelTokenSize(PLANETS[i]);
    t.setAttribute('font-size', fs.toFixed(1));
    t.setAttribute('y', (size*2 + fs*0.95).toFixed(1));
    t.style.strokeWidth = Math.max(2, fs*0.18).toFixed(1) + 'px';
  });
}
window.addEventListener('resize', () => { if(state.screen === 'travel') fitTravelLabels(); });

function travelSheetOpen(){
  const sheet = document.getElementById('travelSheet');
  return !!(sheet && sheet.classList.contains('open'));
}
// 재생 중이고 설명 창이 닫혀 있을 때만 공전(설명 창을 열면 행성을 누르기 쉽게 잠시 멈춤)
function syncTravelLoop(){
  if(state.screen === 'travel' && travelPlaying && !travelSheetOpen()) travelLoop.start();
  else travelLoop.stop();
}
// @icons play pause
function updatePlayBtn(){
  const pb = document.getElementById('playBtn');
  if(!pb) return;
  pb.innerHTML = travelPlaying ? `${icon('pause')} ${L.pause}` : `${icon('play')} ${L.play}`;
  pb.setAttribute('aria-pressed', travelPlaying ? 'false' : 'true');
  pb.setAttribute('aria-label', travelPlaying ? '공전 멈추기' : '공전 재생');
}
function toggleTravelPlay(){
  travelPlaying = !travelPlaying;
  updatePlayBtn();
  syncTravelLoop();
}
