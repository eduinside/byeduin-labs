/* ===== 크기 비교 모드 ===== */
const SIZE_SCALE = 13; // px per Earth-diameter unit
function sizeLayout(){
  const items = [ Object.assign({},SUN,{isSun:true}), ...PLANETS ];
  let cursor = 50;
  const laid = items.map(it => {
    // 최소 반지름은 렌더 안전장치일 뿐 — 현재 데이터(수성 0.38)는 이 값 아래로 내려가지 않아 비율 왜곡이 없음
    const r = Math.max(1.5, it.diameterEarth * SIZE_SCALE / 2);
    cursor += r;
    const cx = cursor;
    cursor += r + 46;
    return Object.assign({}, it, { r, cx });
  });
  return { laid, width: cursor + 60 };
}
function renderSize(){
  const { laid, width } = sizeLayout();
  const earth = laid.find(x=>x.id==='earth');
  app.innerHTML = `
  <div class="stage-screen size">
    <div class="ss-topbar">
      <button class="sk-btn sk-btn--sm" onclick="go('hub')">${icon('arrow-left')} 허브로</button>
      <span class="ss-caption">지름을 실제 비율로 나란히 · 거리는 무시했어요</span>
    </div>
    <div class="cmp-hint">${icon('hand')} 지구를 끌어 다른 행성 옆에 놓거나, 아래 버튼을 눌러 보세요</div>
    <div class="stage-main cmp-scroll" id="sizeScroll">
      <div class="cmp-track" id="sizeTrack" style="width:${width}px">
        ${laid.map(it => `
          <div class="cmp-label" style="left:${it.cx}px">${it.isSun?'☀️ 태양':it.name}</div>
          <div data-body="${it.id}" style="position:absolute;left:${it.cx-it.r}px;top:calc(50% - ${it.r}px)">${it.isSun?sunSVG(it.r):planetSVG(it,it.r)}</div>
        `).join('')}
        <div class="earth-ghost" id="earthGhost" data-home="${earth.cx}"
             style="position:absolute;left:${earth.cx-earth.r}px;top:calc(50% - ${earth.r}px);z-index:3">
          ${planetSVG(earth, earth.r)}
        </div>
      </div>
    </div>
    <div id="sizeCompareLabel" aria-live="polite"></div>
    <div class="dist-chipbar" role="group" aria-label="지구와 크기를 비교할 천체 고르기">
      ${laid.filter(it => it.id !== 'earth').map(it => `<button class="dist-chip" onclick="compareEarthWith('${it.id}')" aria-label="지구와 ${it.isSun?'태양':it.name} 크기 비교">지구 ${icon('arrow-left-right')} ${it.isSun?'☀️ 태양':it.name}</button>`).join('')}
    </div>
  </div>`;
  setupEarthDrag(laid);
}
// 끌어 놓기와 버튼이 같은 결과 카드를 쓴다
function showSizeCompare(near){
  const ratio = (near.diameterEarth/1);
  const label = near.isSun ? '태양' : near.name;
  const cmp = ratio >= 1 ? `${label}${eunNeun(label)} 지름이 지구의 약 <b>${round1(ratio)}배</b>예요. 지구보다 커요!`
                          : `${label}${eunNeun(label)} 지름이 지구의 <b>${round1(ratio)}배</b>예요. 지구보다 <b>작아요</b>.`;
  const box = document.getElementById('sizeCompareLabel');
  if(box) box.innerHTML = `<div class="ss-card size-result">${cmp}</div>`;
}
// 끌기 대신 버튼(키보드·터치): 지구를 고른 천체 옆에 놓고 결과를 보여 준다
function compareEarthWith(id){
  const { laid } = sizeLayout();
  const it = laid.find(x => x.id === id);
  const earth = laid.find(x => x.id === 'earth');
  const ghost = document.getElementById('earthGhost');
  if(!it || !earth || !ghost) return;
  ghost.style.left = (it.cx + it.r + 8) + 'px';
  showSizeCompare(it);
  const target = document.querySelector(`#sizeTrack [data-body="${id}"]`);
  try{ (it.isSun ? ghost : (target || ghost)).scrollIntoView({behavior: reducedMotion() ? 'auto' : 'smooth', inline:'center', block:'nearest'}); }catch(e){}
}
let earthDragOff = null;
function cleanupEarthDrag(){ if(earthDragOff){ earthDragOff(); earthDragOff = null; } }
function setupEarthDrag(laid){
  const ghost = document.getElementById('earthGhost');
  const track = document.getElementById('sizeTrack');
  if(!ghost) return;
  let dragging = false, startClientX = 0, startLeft = 0;
  const home = parseFloat(ghost.dataset.home);
  const earth = laid.find(x=>x.id==='earth');

  function onDown(e){
    dragging = true; ghost.classList.add('dragging');
    startClientX = (e.touches? e.touches[0].clientX : e.clientX);
    startLeft = parseFloat(ghost.style.left);
    e.preventDefault();
  }
  function onMove(e){
    if(!dragging) return;
    const clientX = (e.touches? e.touches[0].clientX : e.clientX);
    const delta = clientX - startClientX;
    ghost.style.left = (startLeft + delta) + 'px';
    checkNear();
  }
  function onUp(){
    if(!dragging) return;
    dragging = false; ghost.classList.remove('dragging');
    const near = findNear();
    if(near) showSizeCompare(near);
    ghost.style.left = (home - earth.r) + 'px';
  }
  function findNear(){
    const gx = parseFloat(ghost.style.left) + earth.r;
    let best = null, bestD = 9999;
    laid.forEach(it => {
      if(it.id==='earth') return;
      const d = Math.abs(it.cx - gx);
      if(d < it.r + earth.r + 30 && d < bestD){ best = it; bestD = d; }
    });
    return best;
  }
  function checkNear(){ /* 실시간 하이라이트는 생략(단순화) */ }
  cleanupEarthDrag(); // 크기 화면을 다시 그릴 때 창에 걸린 옛 리스너가 쌓이지 않게
  ghost.addEventListener('mousedown', onDown);
  ghost.addEventListener('touchstart', onDown, {passive:false});
  window.addEventListener('mousemove', onMove);
  window.addEventListener('touchmove', onMove, {passive:false});
  window.addEventListener('mouseup', onUp);
  window.addEventListener('touchend', onUp);
  earthDragOff = () => {
    window.removeEventListener('mousemove', onMove);
    window.removeEventListener('touchmove', onMove);
    window.removeEventListener('mouseup', onUp);
    window.removeEventListener('touchend', onUp);
  };
}
function round1(n){ return Math.round(n*10)/10; }
function eunNeun(word){ return SimKit.josa.pick(word, '은/는'); }

