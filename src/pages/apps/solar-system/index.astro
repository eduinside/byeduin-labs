---
import AppLayout from '../../../layouts/AppLayout.astro';
---
<AppLayout 
  title="태양계 여행 — eduin VIVES"
  description="여덟 행성을 공전시키고 크기와 거리를 실제 비율로 비교해 보세요. 행성 도감과 퀴즈까지, 초등 5~6학년 태양계와 별을 체험하는 무료 학습 시뮬레이션."
  image="https://eduin.info/og-images/solar-system.png"
  bodyShell="immersive"
  theme="light"
  toast="top"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/common/sim-kit.css">
    <script is:inline src="/common/sim-kit.js"></script>
    <style is:global="">
    /* 규약 v2: 조작판·글자는 밝은 화면. 우주 무대(여행·크기·거리)의 어두운 배경과 무대 글자만 그림 내용으로 어둡게 둔다 */
    :root{
      --ss-space-1:#05060f; --ss-space-2:#0b0f24; --ss-space-3:#141b3c;
      --ss-stage-fg:#e8ecff; --ss-stage-muted:#b8c0ea; --ss-orbit:rgba(150,165,255,.32);
      --ss-stage-accent:#ffd166;
      --ss-fg:var(--fg,#11181c); --ss-fg-muted:var(--fg-muted,#71717a);
      --ss-card:var(--bg,#fff); --ss-panel:rgba(255,255,255,.94); --ss-border:var(--border,#e4e4e7);
      --ss-accent:#f5a524; --ss-accent-text:#9a5b00;
      --ss-good:#17c964; --ss-bad:#f31260;
    }
    *{box-sizing:border-box}
    html,body{margin:0;padding:0;height:100%}
    body{
      font-family:-apple-system,BlinkMacSystemFont,'Pretendard','Segoe UI',sans-serif;
      color:var(--ss-fg); background:var(--bg-sec,#f4f4f5); overflow:hidden;
    }
    button, a { -webkit-tap-highlight-color:transparent; }
    button:focus-visible, a:focus-visible, [tabindex]:focus-visible {
      outline:3px solid var(--sk-accent); outline-offset:2px;
    }

    /* 우주 배경은 무대 화면(여행·크기·거리)에서만 — body.ss-space */
    .ss-bg{
      position:fixed; inset:0; z-index:0; display:none;
      background:
        radial-gradient(1.5px 1.5px at 10% 20%, #fff, transparent),
        radial-gradient(1px 1px at 25% 65%, #fff, transparent),
        radial-gradient(1.5px 1.5px at 40% 15%, #cfe0ff, transparent),
        radial-gradient(1px 1px at 60% 80%, #fff, transparent),
        radial-gradient(1.5px 1.5px at 75% 35%, #fff, transparent),
        radial-gradient(1px 1px at 88% 60%, #cfe0ff, transparent),
        radial-gradient(1.5px 1.5px at 92% 12%, #fff, transparent),
        radial-gradient(1px 1px at 15% 90%, #fff, transparent),
        radial-gradient(1200px 800px at 50% -10%, var(--ss-space-3), transparent 60%),
        linear-gradient(180deg, var(--ss-space-1), var(--ss-space-2));
      background-repeat:no-repeat;
    }
    body.ss-space .ss-bg{ display:block; }
    #app{ position:fixed; inset:0; z-index:1; overflow:hidden; }
    .ss-scroll{ position:absolute; inset:0; overflow-y:auto; -webkit-overflow-scrolling:touch; }

    /* ===== 공용 ===== */
    .ss-wrap{ max-width:560px; margin:0 auto; padding:var(--sk-stage-top) 16px 40px; }
    .sk-screen .ss-wrap{ width:100%; max-width:560px; padding:0; }
    .ss-card{
      background:var(--ss-card); border:1px solid var(--ss-border); border-radius:20px;
      padding:22px 20px; box-shadow:var(--shadow,0 4px 24px rgba(0,0,0,.08));
    }

    .ss-topbar{
      display:flex; align-items:center; justify-content:space-between; gap:8px;
      flex-wrap:wrap; margin:0 0 8px;
    }
    .ss-caption{
      background:var(--ss-panel); border:1px solid var(--ss-border); border-radius:999px;
      padding:7px 14px; font-size:14px; color:var(--ss-fg-muted); line-height:1.4;
    }

    /* ===== 무대 화면(여행·크기·거리): 위 이름표 줄·아래 도구줄이 그림을 가리지 않게 흐름 배치 ===== */
    .stage-screen{
      position:absolute; inset:0; display:flex; flex-direction:column;
      padding-top:var(--sk-stage-top);
    }
    .stage-screen > .ss-topbar{ flex:none; margin:0 12px 6px; }
    .stage-main{ flex:1 1 auto; min-height:0; position:relative; }

    /* ===== 인트로 ===== */
    .intro{ text-align:center; animation:fadeUp .5s ease both; }
    .intro .art{ font-size:70px; line-height:1; margin-bottom:10px; animation:float 3s ease-in-out infinite; }
    .intro h1{ font-size:30px; margin:0 0 8px; }
    .intro .tag{
      display:inline-block; background:rgba(245,165,36,.14); color:var(--ss-accent-text);
      border:1px solid rgba(245,165,36,.45); font-size:14px; padding:5px 14px;
      border-radius:999px; margin-bottom:16px;
    }
    .intro p.sub{ color:var(--ss-fg-muted); line-height:1.7; margin-bottom:22px; }
    .intro .ss-card{ text-align:left; margin-bottom:24px; }
    .intro .ss-card h3{ margin:0 0 8px; font-size:16px; color:var(--ss-accent-text); display:flex; align-items:center; gap:6px; }
    .intro .ss-card ul{ margin:0; padding-left:20px; line-height:1.7; font-size:14.5px; }

    /* ===== 허브 ===== */
    .hub-head{ text-align:center; margin-bottom:18px; }
    .hub-head h2{ margin:0 0 4px; font-size:22px; display:flex; align-items:center; justify-content:center; gap:8px; }
    .hub-head p{ margin:0; color:var(--ss-fg-muted); font-size:14.5px; }
    .hub-progress{
      display:flex; align-items:center; justify-content:center; gap:6px;
      font-size:14px; color:var(--ss-fg-muted); margin-bottom:20px;
    }
    .hub-grid{ display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:14px; }
    .hub-tile{
      background:var(--ss-card); border:1px solid var(--ss-border); border-radius:18px;
      padding:18px 14px; text-align:center; cursor:pointer; transition:transform .12s, border-color .12s;
      color:inherit; font-family:inherit;
    }
    .hub-tile:hover{ border-color:var(--sk-accent); }
    .hub-tile:active{ transform:scale(.97); }
    .hub-tile .ico{ font-size:30px; margin-bottom:8px; color:var(--sk-accent); line-height:1; }
    .hub-tile .ico .ic{ width:1em; height:1em; }
    .hub-tile .lbl{ font-size:15px; font-weight:700; margin-bottom:3px; }
    .hub-tile .sub{ font-size:14px; color:var(--ss-fg-muted); line-height:1.5; }
    .hub-actions{ display:flex; flex-direction:column; gap:10px; }

    /* ===== 여행 모드 ===== */
    .travel-stage{ touch-action:pan-x pan-y; }
    .travel-stage svg{ position:absolute; inset:0; width:100%; height:100%; display:block; }
    .travel-controls{
      flex:none; align-self:center; margin:6px 12px calc(12px + env(safe-area-inset-bottom,0px));
      background:var(--ss-panel); border:1px solid var(--ss-border); border-radius:16px;
      padding:8px 14px; display:flex; align-items:center; gap:12px; flex-wrap:wrap; justify-content:center;
      max-width:calc(100% - 24px); color:var(--ss-fg);
    }
    .travel-controls label{ font-size:14px; color:var(--ss-fg-muted); }
    .travel-controls input[type=range]{ width:110px; accent-color:var(--sk-accent); }
    .planet-token{ cursor:pointer; }
    .planet-token:focus-visible circle, .planet-token:focus-visible ellipse{ outline:2px solid var(--ss-stage-accent); }

    /* 폰 가로(낮은 화면): 이름표 줄·조작줄을 옆으로 빼서 무대 높이를 확보 */
    @media (max-height:500px) and (min-width:640px){
      .stage-screen.travel{
        display:grid; grid-template-columns:minmax(200px,250px) 1fr; grid-template-rows:auto 1fr auto;
        padding-top:12px;
      }
      .stage-screen.travel > .ss-topbar{ grid-column:1; grid-row:1; flex-direction:column; align-items:stretch; margin:0 0 6px 12px; }
      .stage-screen.travel > .travel-controls{ grid-column:1; grid-row:3; margin:6px 0 12px 12px; max-width:none; }
      .stage-screen.travel > .stage-main{ grid-column:2; grid-row:1 / 4; margin-top:var(--sk-stage-top); }
    }

    .info-sheet{
      position:absolute; left:0; right:0; bottom:0; z-index:8;
      background:var(--ss-card); border-top:1px solid var(--ss-border); box-shadow:0 -8px 30px rgba(0,0,0,.25);
      border-radius:22px 22px 0 0; padding:18px 20px 22px; max-height:60%; overflow-y:auto;
      transform:translateY(100%); transition:transform .28s cubic-bezier(.3,0,.2,1), visibility .28s; visibility:hidden;
      color:var(--ss-fg);
    }
    .info-sheet.open{ transform:translateY(0); visibility:visible; }
    .info-sheet .row{ display:flex; align-items:center; gap:12px; margin-bottom:10px; padding-right:40px; }
    .info-sheet h3{ margin:0; font-size:19px; }
    .info-sheet .facts{ display:flex; gap:6px 14px; flex-wrap:wrap; font-size:14px; color:var(--ss-fg-muted); margin-bottom:10px; }
    .info-sheet .facts b{ color:var(--ss-fg); }
    .info-sheet p.desc{ font-size:14.5px; line-height:1.65; margin:0 0 14px; }
    .sheet-close{ position:absolute; top:6px; right:8px; background:none; border:none; color:var(--ss-fg-muted); font-size:20px; cursor:pointer; width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; }
    .star-btn{ background:none; border:none; font-size:20px; cursor:pointer; padding:0; min-width:44px; min-height:44px; border-radius:50%; color:var(--ss-fg-muted); display:inline-flex; align-items:center; justify-content:center; }
    .star-btn[aria-pressed="true"]{ color:var(--ss-accent); }
    .star-btn[aria-pressed="true"] .ic, .fav-mark .ic{ fill:currentColor; }
    .fav-mark{ color:var(--ss-accent); }

    /* ===== 크기/거리 비교: 가로 스크롤 무대 ===== */
    .cmp-hint{
      flex:none; align-self:center; margin:0 12px 4px;
      font-size:14px; color:var(--ss-fg-muted); text-align:center; max-width:calc(100% - 24px);
      background:var(--ss-panel); border:1px solid var(--ss-border); border-radius:16px; padding:6px 14px;
      display:flex; align-items:center; gap:6px; line-height:1.4;
    }
    .cmp-scroll{
      overflow-x:auto; overflow-y:hidden; -webkit-overflow-scrolling:touch; padding-top:44px;
    }
    .cmp-scroll.dist{ padding-top:96px; overflow-y:auto; }
    .cmp-track{ position:relative; height:100%; min-height:160px; }
    .cmp-label{
      position:absolute; top:-28px; transform:translateX(-50%); font-size:14px; font-weight:700;
      color:var(--ss-stage-fg); white-space:nowrap; text-align:center;
    }
    .cmp-ratio{
      position:absolute; transform:translateX(-50%); font-size:14px;
      color:var(--ss-stage-accent); white-space:nowrap; text-align:center; font-weight:700; line-height:1.25;
    }
    .cmp-ratio small{ display:block; font-size:12px; font-weight:600; color:var(--ss-stage-muted); }
    .earth-ghost{ cursor:grab; touch-action:none; }
    .earth-ghost.dragging{ cursor:grabbing; }
    .size-result{
      position:fixed; left:50%; bottom:calc(var(--sk-stage-bottom) + 24px); transform:translateX(-50%); z-index:9;
      width:max-content; max-width:min(86vw,420px); text-align:center; padding:12px 16px; font-size:15px; line-height:1.5;
    }
    .dist-chipbar{
      flex:none; z-index:6;
      background:var(--ss-panel); border-top:1px solid var(--ss-border);
      display:flex; gap:8px; padding:10px 12px calc(10px + env(safe-area-inset-bottom,0px)); overflow-x:auto;
    }
    .dist-chip{
      flex:0 0 auto; background:var(--card-bg,#f4f4f5); border:1px solid var(--ss-border);
      color:var(--ss-fg); border-radius:999px; padding:8px 14px; font-size:14px; cursor:pointer;
      min-height:44px; font-family:inherit; display:inline-flex; align-items:center; gap:4px;
    }
    .dist-chip:hover{ border-color:var(--sk-accent); }
    .zoom-bar{ display:flex; gap:6px; }

    /* ===== 도감 ===== */
    .codex-grid{ display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:10px; }
    .codex-card{
      background:var(--ss-card); border:1px solid var(--ss-border); border-radius:16px;
      padding:14px; text-align:center; cursor:pointer; color:inherit; font-family:inherit;
    }
    .codex-card:hover{ border-color:var(--sk-accent); }
    .codex-card:active{ transform:scale(.97); }
    .codex-card > svg{ display:block; margin:0 auto 6px; }
    .codex-card .lbl{ font-size:15px; font-weight:700; display:flex; align-items:center; justify-content:center; gap:4px; }
    .codex-detail{ animation:fadeUp .3s ease both; }
    .codex-detail-hero{ text-align:center; margin-bottom:14px; }
    .codex-detail-facts{
      display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:14px;
    }
    .fact-box{
      background:var(--ss-card); border:1px solid var(--ss-border); border-radius:12px;
      padding:10px 12px; text-align:center;
    }
    .fact-box .k{ font-size:13px; color:var(--ss-fg-muted); }
    .fact-box .v{ font-size:14.5px; font-weight:700; margin-top:2px; }

    /* ===== 미션 ===== */
    .mission-progress{ text-align:center; font-size:14px; color:var(--ss-fg-muted); margin-bottom:14px; }
    .mission-q{ font-size:18px; font-weight:700; text-align:center; margin-bottom:18px; line-height:1.5; }
    .choice-list{ display:flex; flex-direction:column; gap:10px; margin-bottom:18px; }
    .choice-btn{
      font-family:inherit; font-size:15px; text-align:left; padding:12px 16px; border-radius:14px;
      border:2px solid var(--ss-border); background:var(--ss-card); color:var(--ss-fg);
      cursor:pointer; display:flex; align-items:center; gap:10px; min-height:44px;
    }
    .choice-btn:disabled{ cursor:default; }
    .choice-btn.selected{ border-color:var(--sk-accent); background:var(--sk-info-bg); }
    .choice-btn.correct{ border-color:var(--ss-good); background:var(--sk-ok-bg); }
    .choice-btn.wrong{ border-color:var(--ss-bad); background:var(--sk-no-bg); }

    .order-pool, .order-slots{ display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin-bottom:14px; }
    .order-slot{
      width:60px; height:60px; border-radius:14px; border:2px dashed #b4b4bb;
      display:flex; align-items:center; justify-content:center; position:relative;
      background:var(--ss-card); cursor:pointer; color:inherit; font:inherit; padding:0;
    }
    .order-slot .idx{ position:absolute; top:2px; left:5px; font-size:13px; color:var(--ss-fg-muted); }
    .order-slot.filled{ border-style:solid; border-color:var(--ss-border); }
    .order-slot.correct{ border-color:var(--ss-good); border-style:solid; }
    .order-slot.wrong{ border-color:var(--ss-bad); border-style:solid; }
    .order-slot.wrong::after{ content:'✗'; position:absolute; bottom:1px; right:5px; font-size:13px; color:var(--sk-no-fg); }
    .order-slot.correct::after{ content:'✓'; position:absolute; bottom:1px; right:5px; font-size:13px; color:var(--sk-ok-fg); }
    .order-chip{
      width:52px; height:52px; border-radius:12px; border:1px solid var(--ss-border); background:var(--ss-card);
      cursor:pointer; display:flex; align-items:center; justify-content:center;
    }
    .order-chip:disabled{ opacity:.25; cursor:default; }

    .feedback-box{
      border-radius:14px; padding:12px 14px; margin-bottom:14px; font-size:15px; line-height:1.6;
      animation:popIn .3s ease both; color:var(--ss-fg);
    }
    .feedback-box .fb-ic{ vertical-align:-0.2em; margin-right:2px; }
    .feedback-box.ok{ background:var(--sk-ok-bg); border:1px solid var(--ss-good); }
    .feedback-box.ok .fb-ic{ color:var(--sk-ok-fg); }
    .feedback-box.no{ background:var(--sk-no-bg); border:1px solid var(--ss-bad); }
    .feedback-box.no .fb-ic{ color:var(--sk-no-fg); }
    .mission-actions{ justify-content:center; margin-top:10px; }
    .mission-actions > .sk-btn{ flex:0 1 auto; }

    /* ===== 결과 ===== */
    .result-score{ text-align:center; font-size:16px; margin-bottom:16px; }
    .result-score b{ color:var(--ss-accent-text); font-size:26px; }
    .summary-box{
      background:var(--ss-card); border:1px solid var(--ss-border); border-radius:16px;
      padding:16px 18px; margin-bottom:20px; font-size:14.5px; line-height:1.75;
    }
    .summary-box b{ color:var(--ss-accent-text); }
    .summary-box .sum-title{ display:flex; align-items:center; gap:6px; font-weight:800; }
    .result-actions{ justify-content:center; }
    .result-actions > .sk-btn{ flex:0 1 auto; }

    @keyframes fadeUp{ from{opacity:0; transform:translateY(14px)} to{opacity:1; transform:none} }
    @keyframes float{ 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
    @keyframes popIn{ from{opacity:0; transform:scale(.9)} to{opacity:1; transform:scale(1)} }
    @media (prefers-reduced-motion: reduce){
      .info-sheet{ transition:none; }
      .intro, .codex-detail, .feedback-box{ animation:none; }
    }

    .planet-label {
      pointer-events: none;
      font-family: inherit;
      fill: var(--ss-stage-fg);
      paint-order: stroke;
      stroke: rgba(5,6,15,.85);
      stroke-width: 3px;
      stroke-linejoin: round;
      transition: fill 0.15s;
    }
    .planet-token:hover .planet-label, .planet-token:focus-visible .planet-label {
      fill: var(--ss-stage-accent);
    }
  </style>
  <script type="application/ld+json" is:inline="">{"@context":"https://schema.org","@type":"WebApplication","name":"태양계 여행","description":"여덟 행성을 공전시키고 크기와 거리를 실제 비율로 비교해 보세요. 행성 도감과 퀴즈까지, 초등 5~6학년 태양계와 별을 체험하는 무료 학습 시뮬레이션.","url":"https://eduin.info/apps/solar-system/","applicationCategory":"EducationApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"KRW"},"isPartOf":{"@type":"WebSite","name":"eduin VIVES","url":"https://eduin.info"}}</script>
  </Fragment>


<!-- 플로팅 크롬(홈·공유)은 app-shell.js가 주입. 테마 버튼은 immersive에서 자동 숨김 -->
<div class="ss-bg"></div>
<div id="app"></div>
<div id="ssLive" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>

<script is:inline="">
/* ============================================================
   데이터 — 지구=1 기준 상대값(반올림). 출처: NASA Planetary Fact Sheet 근사.
   diameterEarth: 지름(지구=1) · distanceAU: 태양 평균거리(지구=1AU=1)
   rotDays/orbitDays: 자전/공전 주기(지구일 기준, 초등 학습용 반올림)
   ============================================================ */
const PLANETS = [
  { id:'mercury', name:'수성', diameterEarth:0.38, distanceAU:0.39, rotDays:59, orbitDays:88,
    color:'#b7ab9e', hi:'#d9cfc3', dark:'#5c5148',
    fact:'태양에 가장 가까운 행성이에요. 대기가 거의 없어 낮과 밤의 온도차가 태양계에서 가장 커요.' },
  { id:'venus', name:'금성', diameterEarth:0.95, distanceAU:0.72, rotDays:243, orbitDays:225,
    color:'#e6cf9c', hi:'#f5e6c0', dark:'#a68a54',
    fact:'두꺼운 구름에 덮여 있고, 표면 온도가 태양계 행성 중 가장 뜨거워요.' },
  { id:'earth', name:'지구', diameterEarth:1, distanceAU:1, rotDays:1, orbitDays:365,
    color:'#3f7fd0', hi:'#7fb4f0', dark:'#1c3d6b', land:true,
    fact:'우리가 살고 있는 행성이에요. 표면의 넓은 바다 때문에 파랗게 보여요.' },
  { id:'mars', name:'화성', diameterEarth:0.53, distanceAU:1.52, rotDays:1.03, orbitDays:687,
    color:'#c1552e', hi:'#e08159', dark:'#6b2b13',
    fact:'붉은 흙 때문에 \'붉은 행성\'이라 불려요. 계절의 변화가 지구와 비슷해요.' },
  { id:'jupiter', name:'목성', diameterEarth:11.2, distanceAU:5.20, rotDays:0.41, orbitDays:4333,
    color:'#d9b48a', hi:'#f0d6ae', dark:'#8a6a45', bands:['#c99a68','#e8cba0','#b8875a'], spot:'#b5432c',
    fact:'태양계에서 가장 큰 행성이에요. \'대적점\'이라는 거대한 소용돌이가 있어요.' },
  { id:'saturn', name:'토성', diameterEarth:9.45, distanceAU:9.58, rotDays:0.45, orbitDays:10759,
