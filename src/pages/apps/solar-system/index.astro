   ============================================================ */
let missionStep = 0;
let missionDraft = {}; // 진행 중 임시 상태(다시 그려도 유지)

// 미션 이동·자동 넘김은 SimKit 미션 컨트롤러(docs/sim-kit.md). 저장 모양 { order: true, … } 그대로
const mc = SimKit.missions({
  ids: MISSION_IDS,
  format: 'flags',
  progress: store.missions,
  onEnter: i => {
    missionStep = i;
    missionDraft = {};
    render();
    // 자동으로 넘어와 초점을 잃었으면 새 문제로
    const ae = document.activeElement;
    if(!ae || ae === document.body){
      const q = app.querySelector('.mission-q');
      if(q){ q.tabIndex = -1; q.focus({preventScroll:true}); }
    }
  },
  onFinish: () => go('result'),
  onChange: p => { store = saveStore({ missions: p }); },
});

function startMissions(){
  leaveScreen('missions');
  state.screen = 'missions';
  state.focusPlanet = null;
  syncHash();
  window.scrollTo(0,0);
  mc.start(0);
}
function renderMissions(){
  const id = MISSION_IDS[missionStep];
  if(id === 'order') return renderMissionOrder();
  if(id === 'size') return renderMissionSize();
  if(id === 'distance') return renderMissionDistance();
  if(id === 'concept') return renderMissionConcept();
  go('result');
}
// 다시 그릴 때 키보드 초점을 같은 버튼(data-fk)에 돌려놓는다. 없어졌으면 다음 자연스러운 곳으로
function missionShell(inner){
  const ae = document.activeElement;
  const fk = ae && app.contains(ae) ? ae.getAttribute('data-fk') : null;
  app.innerHTML = `
  <div class="ss-scroll"><div class="ss-wrap">
    <div class="ss-topbar">
      <button class="sk-btn sk-btn--sm" onclick="go('hub')">${icon('arrow-left')} ${L.exit}</button>
    </div>
    <div class="mission-progress">미션 ${missionStep+1} / ${MISSION_IDS.length}</div>
    ${inner}
  </div></div>`;
  // 결과 문구가 화면 밖이면 보이는 곳으로(규약 v2)
  const fb = app.querySelector('.feedback-box');
  if(fb) SimKit.reveal(fb);
  if(!fk) return;
  let t = app.querySelector(`[data-fk="${fk}"]:not(:disabled)`);
  if(!t && fk.indexOf('chip-') === 0) t = app.querySelector('.order-chip:not(:disabled)');
  if(!t) t = app.querySelector('.feedback-box') || app.querySelector('.mission-q');
  if(t){
    if(!/^(BUTTON|A|INPUT)$/.test(t.tagName) && !t.hasAttribute('tabindex')) t.tabIndex = -1;
    t.focus({preventScroll:true});
  }
}
// 정답 뒤 자동 이동: 미션을 옮기거나 화면을 떠나면 예약이 취소된다(토큰 방식)
function advanceAfter(ms){
  mc.complete({ advance: ms });
}
// 틀렸을 때: 다시 풀기 + 다음 미션으로
function retryRow(retryCall){
  return `<div class="sk-actions mission-actions">
    <button class="sk-btn sk-btn--sm" data-fk="retry" onclick="${retryCall}">${icon('rotate-ccw')} ${L.retry}</button>
    <button class="sk-btn sk-btn--sm" data-fk="nextm" onclick="nextMission()">${L.next} ${icon('arrow-right')}</button>
  </div>`;
}
const OK_IC = SimKit.icon('party-popper', { cls: 'fb-ic' });
const NO_IC = SimKit.icon('circle-alert', { cls: 'fb-ic' });
function nextMission(){
  mc.next();
}

/* --- 미션 1: 순서 배열 --- */
let orderPool = [], orderSlots = [];
function renderMissionOrder(){
  if(!missionDraft.orderInit){
    orderPool = shuffle(PLANETS.map(p=>p.id));
    orderSlots = new Array(PLANETS.length).fill(null);
    missionDraft.orderInit = true;
    missionDraft.orderDone = false;
  }
  const poolHtml = orderPool.map(id => {
    const p = PLANETS.find(x=>x.id===id);
    return `<button class="order-chip" data-fk="chip-${id}" aria-label="${p.name} 놓기" onclick="placeOrderChip('${id}')">${planetSVG(p,20)}</button>`;
  }).join('');
  const slotsHtml = orderSlots.map((id,i) => {
    const p = id ? PLANETS.find(x=>x.id===id) : null;
    const cls = missionDraft.orderResult ? (missionDraft.orderResult[i] ? 'correct' : 'wrong') : (id?'filled':'');
    const state2 = missionDraft.orderResult ? (missionDraft.orderResult[i] ? ', 맞아요' : ', 틀렸어요') : '';
    return `<button type="button" class="order-slot ${cls}" data-fk="slot-${i}" onclick="removeOrderChip(${i})" aria-label="${i+1}번째 칸: ${p ? p.name + state2 + ' (누르면 빼기)' : '비어 있음'}"><span class="idx" aria-hidden="true">${i+1}</span>${p?planetSVG(p,20):''}</button>`;
  }).join('');
  missionShell(`
    <div class="mission-q">태양에서 <b>가까운 순서</b>대로<br>행성을 배열해 보세요</div>
    <div class="order-slots">${slotsHtml}</div>
    <div class="order-pool">${poolHtml}</div>
    ${missionDraft.orderFeedback || ''}
    <div class="sk-actions mission-actions">
      <button class="sk-btn sk-btn--primary" id="orderSubmit" data-fk="submit" ${orderSlots.includes(null)?'disabled':''} onclick="checkOrder()">${icon('circle-check')} ${L.check}</button>
    </div>`);
}
function placeOrderChip(id){
  const empty = orderSlots.indexOf(null);
  if(empty === -1) return;
  orderSlots[empty] = id;
  orderPool = orderPool.filter(x=>x!==id);
  missionDraft.orderResult = null;
  renderMissionOrder();
}
function removeOrderChip(i){
  if(!orderSlots[i]) return;
  orderPool.push(orderSlots[i]);
  orderSlots[i] = null;
  missionDraft.orderResult = null;
  renderMissionOrder();
}
function checkOrder(){
  const answer = PLANETS.map(p=>p.id);
  const result = orderSlots.map((id,i) => id === answer[i]);
  missionDraft.orderResult = result;
  const allCorrect = result.every(Boolean);
  missionDraft.orderFeedback = `<div class="feedback-box ${allCorrect?'ok':'no'}">
    ${allCorrect ? OK_IC+'정확해요! 수성부터 해왕성까지, 태양에서 멀어질수록 순서가 커져요.'
                 : NO_IC+'빨간 칸을 다시 살펴보세요. 틀린 칸을 눌러 빼고 다시 놓을 수 있어요.'}
  </div>`;
  renderMissionOrder();
  announce(allCorrect ? '정확해요! 수성부터 해왕성까지 순서가 맞아요.' : '빨간 칸을 다시 살펴보세요. 틀린 칸을 눌러 빼고 다시 놓을 수 있어요.');
  if(allCorrect) advanceAfter(1600);
}

/* --- 미션 2: 크기 (2단계) --- */
function renderMissionSize(){
  if(missionDraft.sizePart === undefined) missionDraft.sizePart = 'a';
  if(missionDraft.sizePart === 'a') return renderMissionSizeA();
  return renderMissionSizeB();
}
function renderMissionSizeA(){
  const options = ['jupiter','saturn','earth','mars'];
  const biggest = options.reduce((a,b) => PLANETS.find(p=>p.id===a).diameterEarth > PLANETS.find(p=>p.id===b).diameterEarth ? a : b);
  const selected = missionDraft.sizeASel;
  const answered = missionDraft.sizeAResult !== undefined;
  missionShell(`
    <div class="mission-q">가장 <b>큰</b> 행성은 무엇일까요?</div>
    <div class="choice-list">
      ${options.map(id => {
        const p = PLANETS.find(x=>x.id===id);
        let cls = selected===id ? 'selected' : '';
        if(answered){ if(id===biggest) cls='correct'; else if(id===selected) cls='wrong'; }
        return `<button class="choice-btn ${cls}" data-fk="ch-${id}" ${answered?'disabled':''} onclick="answerSizeA('${id}','${biggest}')">${planetSVG(p,18)} ${p.name}</button>`;
      }).join('')}
    </div>
    ${answered ? `<div class="feedback-box ${missionDraft.sizeAResult?'ok':'no'}">
      ${missionDraft.sizeAResult?OK_IC+'맞아요!':NO_IC+'아쉬워요.'} <b>목성</b>은 지름이 지구의 11.2배로, 태양계에서 가장 큰 행성이에요.
      <div class="sk-actions mission-actions"><button class="sk-btn sk-btn--sm sk-btn--primary" data-fk="nextq" onclick="missionDraft.sizePart='b';renderMissionSize();const q=app.querySelector('.mission-q');if(q){q.tabIndex=-1;q.focus({preventScroll:true});}">다음 질문 ${icon('arrow-right')}</button></div>
    </div>` : ''}`);
}
function answerSizeA(id, biggest){
  missionDraft.sizeASel = id;
  missionDraft.sizeAResult = (id === biggest);
  renderMissionSizeA();
  announce((missionDraft.sizeAResult ? '맞아요! ' : '아쉬워요. ') + '목성은 지름이 지구의 11.2배로, 태양계에서 가장 큰 행성이에요.');
}
function renderMissionSizeB(){
  const correctSet = new Set(PLANETS.filter(p=>p.diameterEarth<1).map(p=>p.id));
  const sel = new Set(missionDraft.sizeBSel || []);
  const answered = missionDraft.sizeBResult !== undefined;
  missionShell(`
    <div class="mission-q">지구보다 <b>작은</b> 행성을<br>모두 골라 보세요</div>
    <div class="choice-list">
      ${PLANETS.map(p => {
        let cls = sel.has(p.id) ? 'selected' : '';
        if(answered){ if(correctSet.has(p.id)) cls='correct'; else if(sel.has(p.id)) cls='wrong'; }
        return `<button class="choice-btn ${cls}" data-fk="ch-${p.id}" aria-pressed="${sel.has(p.id)}" ${answered?'disabled':''} onclick="toggleSizeB('${p.id}')">${planetSVG(p,18)} ${p.name}</button>`;
      }).join('')}
    </div>
    ${answered ? `<div class="feedback-box ${missionDraft.sizeBResult?'ok':'no'}">
        ${missionDraft.sizeBResult?OK_IC+'정확해요!':NO_IC+'다시 확인해 보세요.'} 지구보다 작은 행성은 <b>수성·금성·화성</b>이에요.
        ${missionDraft.sizeBResult ? '' : retryRow("missionDraft.sizeBResult=undefined;missionDraft.sizeBSel=[];renderMissionSizeB()")}
      </div>`
      : `<div class="sk-actions mission-actions"><button class="sk-btn sk-btn--primary" data-fk="submit" ${sel.size===0?'disabled':''} onclick="checkSizeB()">${icon('circle-check')} ${L.check}</button></div>`}`);
}
function toggleSizeB(id){
  const sel = new Set(missionDraft.sizeBSel || []);
  if(sel.has(id)) sel.delete(id); else sel.add(id);
  missionDraft.sizeBSel = [...sel];
  renderMissionSizeB();
}
function checkSizeB(){
  const correctSet = new Set(PLANETS.filter(p=>p.diameterEarth<1).map(p=>p.id));
  const sel = new Set(missionDraft.sizeBSel || []);
  const ok = sel.size === correctSet.size && [...sel].every(x=>correctSet.has(x));
  missionDraft.sizeBResult = ok;
  renderMissionSizeB();
  announce((ok ? '정확해요! ' : '다시 확인해 보세요. ') + '지구보다 작은 행성은 수성, 금성, 화성이에요.');
  if(ok) advanceAfter(1800);
}

/* --- 미션 3: 거리 (다중 선택) --- */
function renderMissionDistance(){
  const correctSet = new Set(PLANETS.filter(p=>p.distanceAU>1).map(p=>p.id));
  const sel = new Set(missionDraft.distSel || []);
  const answered = missionDraft.distResult !== undefined;
  missionShell(`
    <div class="mission-q">지구보다 태양에서 <b>더 먼</b> 행성을<br>모두 골라 보세요</div>
    <div class="choice-list">
      ${PLANETS.map(p => {
        let cls = sel.has(p.id) ? 'selected' : '';
        if(answered){ if(correctSet.has(p.id)) cls='correct'; else if(sel.has(p.id)) cls='wrong'; }
        return `<button class="choice-btn ${cls}" data-fk="ch-${p.id}" aria-pressed="${sel.has(p.id)}" ${answered?'disabled':''} onclick="toggleDist('${p.id}')">${planetSVG(p,18)} ${p.name}</button>`;
      }).join('')}
    </div>
    ${answered ? `<div class="feedback-box ${missionDraft.distResult?'ok':'no'}">
        ${missionDraft.distResult?OK_IC+'정확해요!':NO_IC+'다시 확인해 보세요.'} 화성·목성·토성·천왕성·해왕성이 지구보다 멀어요.
        ${missionDraft.distResult ? '' : retryRow("missionDraft.distResult=undefined;missionDraft.distSel=[];renderMissionDistance()")}
      </div>`
      : `<div class="sk-actions mission-actions"><button class="sk-btn sk-btn--primary" data-fk="submit" ${sel.size===0?'disabled':''} onclick="checkDist()">${icon('circle-check')} ${L.check}</button></div>`}`);
}
function toggleDist(id){
  const sel = new Set(missionDraft.distSel || []);
  if(sel.has(id)) sel.delete(id); else sel.add(id);
  missionDraft.distSel = [...sel];
  renderMissionDistance();
}
function checkDist(){
  const correctSet = new Set(PLANETS.filter(p=>p.distanceAU>1).map(p=>p.id));
  const sel = new Set(missionDraft.distSel || []);
  const ok = sel.size === correctSet.size && [...sel].every(x=>correctSet.has(x));
  missionDraft.distResult = ok;
  renderMissionDistance();
  announce((ok ? '정확해요! ' : '다시 확인해 보세요. ') + '화성, 목성, 토성, 천왕성, 해왕성이 지구보다 멀어요.');
  if(ok) advanceAfter(1800);
}

/* --- 미션 4: 개념 --- */
function renderMissionConcept(){
  const options = [
    { id:'selfLight', label:'스스로 빛을 내요' },
    { id:'reflect', label:'태양빛을 반사해요' },
    { id:'heat', label:'뜨거운 열 때문에 빛나요' },
  ];
  const answered = missionDraft.conceptSel !== undefined;
  missionShell(`
    <div class="mission-q">행성은 왜 밤하늘에서<br>빛나 보일까요?</div>
    <div class="choice-list">
      ${options.map(o => {
        let cls = missionDraft.conceptSel===o.id ? 'selected' : '';
        if(answered){ if(o.id==='reflect') cls='correct'; else if(o.id===missionDraft.conceptSel) cls='wrong'; }
        return `<button class="choice-btn ${cls}" data-fk="ch-${o.id}" ${answered?'disabled':''} onclick="answerConcept('${o.id}')">${o.label}</button>`;
      }).join('')}
    </div>
    ${answered ? `<div class="feedback-box ${missionDraft.conceptSel==='reflect'?'ok':'no'}">
      ${missionDraft.conceptSel==='reflect'?OK_IC+'맞아요!':NO_IC+'아쉬워요.'} 행성은 스스로 빛을 내지 못하고, <b>태양빛을 반사</b>해서 빛나 보여요.
      ${missionDraft.conceptSel==='reflect' ? '' : retryRow("missionDraft.conceptSel=undefined;renderMissionConcept()")}
    </div>` : ''}`);
}
function answerConcept(id){
  missionDraft.conceptSel = id;
  const ok = id === 'reflect';
  renderMissionConcept();
  announce((ok ? '맞아요! ' : '아쉬워요. ') + '행성은 스스로 빛을 내지 못하고, 태양빛을 반사해서 빛나 보여요.');
  if(ok) advanceAfter(1800);
}

function shuffle(arr){
  const a = arr.slice();
  for(let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; }
  return a;
}

/* ===== 결과 ===== */
function renderResult(){
  const score = missionScore();
  app.innerHTML = `
  <div class="sk-screen"><div class="ss-wrap">
    <div class="hub-head"><h2>${icon('award')} 여행 완료!</h2></div>
    <div class="result-score">${MISSION_IDS.length}개 미션 중 <b>${score}</b>개 성공</div>
    <div class="summary-box">
      <span class="sum-title">${icon('book-open')} 오늘의 배움 정리</span>
      태양계엔 여덟 행성이 있어요. <b>크기와 거리는 함께 그릴 수 없을 만큼</b> 차이가 커요.
      행성은 스스로 빛나지 않고, <b>태양빛을 반사</b>해서 빛나 보여요.
    </div>
    <div class="sk-actions result-actions">
      <button class="sk-btn sk-btn--primary" onclick="startMissions()">${icon('rotate-ccw')} 미션 다시 도전</button>
      <button class="sk-btn" onclick="go('hub')">${icon('arrow-left')} ${L.exit}</button>
    </div>
  </div></div>`;
}

/* ============================================================
   시작
   ============================================================ */
restoreFromHash();
render();
</script>



