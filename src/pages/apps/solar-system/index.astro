const state = { screen:'intro', focusPlanet:null };
// 공유 가능한 화면만 해시에 반영(허브/인트로/미션/결과는 "특정 뷰 공유"의 의미가 없어 제외)
const RESTORABLE_SCREENS = ['travel','size','distance','codex','codexDetail'];

function syncHash(){
  if(!RESTORABLE_SCREENS.includes(state.screen)){
    if(location.hash) history.replaceState(null, '', location.pathname + location.search);
    return;
  }
  try{
    const payload = { v:1, screen: state.screen, focusPlanet: state.focusPlanet || null };
    const encoded = btoa(encodeURIComponent(JSON.stringify(payload)));
    history.replaceState(null, '', '#' + encoded);
  }catch(e){}
}
function restoreFromHash(){
  const h = location.hash.slice(1);
  if(!h) return;
  try{
    const payload = JSON.parse(decodeURIComponent(atob(h)));
    if(payload && payload.v === 1 && RESTORABLE_SCREENS.includes(payload.screen)){
      state.screen = payload.screen;
      state.focusPlanet = payload.focusPlanet || null;
    }
  }catch(e){}
}

/* ============================================================
   행성 SVG 렌더
   ============================================================ */
let __uid = 0;
function planetSVG(p, r, opts){
  opts = opts || {};
  const uid = 'ps' + (__uid++);
  const gid = 'g' + uid, cid = 'c' + uid;
  const cx = r, cy = r;
  const size = r*2;

  let ringBehind = '', ringFront = '', clipDef = '';
  if(p.ring){
    const ringHtml = `<ellipse cx="${cx}" cy="${cy}" rx="${r*p.ring.rx}" ry="${r*p.ring.ry}" transform="rotate(${p.ring.rot} ${cx} ${cy})" fill="none" stroke="${p.ring.color}" stroke-width="${Math.max(1.4, r*0.16)}" opacity="0.85"/>`;
    ringBehind = ringHtml;
    
    // 3D 고리 오버랩 구현: 가로 고리는 하반신(앞), 세로 고리는 우반신(앞)만 클리핑해서 앞에 렌더링
    const clipId = 'fc' + uid;
    if (p.ring.rx > p.ring.ry) {
      clipDef = `<clipPath id="${clipId}"><rect x="${cx - r*p.ring.rx}" y="${cy}" width="${r*p.ring.rx*2}" height="${size}" transform="rotate(${p.ring.rot} ${cx} ${cy})"/></clipPath>`;
    } else {
      clipDef = `<clipPath id="${clipId}"><rect x="${cx}" y="${cy - r*p.ring.ry}" width="${size}" height="${r*p.ring.ry*2}" transform="rotate(${p.ring.rot} ${cx} ${cy})"/></clipPath>`;
    }
    ringFront = `<g clip-path="url(#${clipId})">${ringHtml}</g>`;
  }

  let extra = '';
  if(p.bands){
    extra += p.bands.map((b,i)=>`<ellipse cx="${cx}" cy="${cy+(i-1)*r*0.42}" rx="${r*1.05}" ry="${r*0.2}" fill="${b}" opacity="0.55"/>`).join('');
  }
  if(p.spot){
    extra += `<ellipse cx="${cx+r*0.28}" cy="${cy+r*0.08}" rx="${r*0.2}" ry="${r*0.13}" fill="${p.spot}" opacity="0.85"/>`;
  }
  if(p.land){
    extra += `<ellipse cx="${cx-r*0.25}" cy="${cy-r*0.2}" rx="${r*0.32}" ry="${r*0.22}" fill="#4d9e5a" opacity="0.8"/>`;
    extra += `<ellipse cx="${cx+r*0.3}" cy="${cy+r*0.3}" rx="${r*0.26}" ry="${r*0.18}" fill="#4d9e5a" opacity="0.7"/>`;
    extra += `<ellipse cx="${cx+r*0.1}" cy="${cy-r*0.35}" rx="${r*0.4}" ry="${r*0.12}" fill="#fff" opacity="0.35"/>`;
  }

  // [대표 무늬 추가: 수성 크레이터, 금성 황산 구름 사선, 화성 극관 & 화산대, 해왕성 대흑점]
  if(p.id === 'mercury') {
    extra += `<circle cx="${cx - r*0.3}" cy="${cy - r*0.2}" r="${r*0.15}" fill="#000" opacity="0.15"/>`;
    extra += `<circle cx="${cx + r*0.2}" cy="${cy + r*0.3}" r="${r*0.2}" fill="#000" opacity="0.12"/>`;
    extra += `<circle cx="${cx - r*0.1}" cy="${cy + r*0.4}" r="${r*0.1}" fill="#000" opacity="0.15"/>`;
  }
  if(p.id === 'venus') {
    extra += `<ellipse cx="${cx}" cy="${cy - r*0.3}" rx="${r*0.9}" ry="${r*0.12}" transform="rotate(-15 ${cx} ${cy - r*0.3})" fill="#fff" opacity="0.15"/>`;
    extra += `<ellipse cx="${cx}" cy="${cy + r*0.3}" rx="${r*0.9}" ry="${r*0.12}" transform="rotate(-15 ${cx} ${cy + r*0.3})" fill="#fff" opacity="0.15"/>`;
  }
  if(p.id === 'mars') {
    extra += `<ellipse cx="${cx}" cy="${cy - r*0.85}" rx="${r*0.3}" ry="${r*0.12}" fill="#fff" opacity="0.9"/>`;
    extra += `<path d="M ${cx - r*0.4} ${cy} Q ${cx} ${cy - r*0.2} ${cx + r*0.2} ${cy + r*0.2} Q ${cx - r*0.1} ${cy + r*0.5} ${cx - r*0.4} ${cy} Z" fill="#2c1a11" opacity="0.35"/>`;
  }
  if(p.id === 'neptune') {
    extra += `<ellipse cx="${cx + r*0.3}" cy="${cy + r*0.1}" rx="${r*0.22}" ry="${r*0.14}" fill="#0d1b3e" opacity="0.75"/>`;
    extra += `<ellipse cx="${cx - r*0.2}" cy="${cy - r*0.2}" rx="${r*0.6}" ry="${r*0.06}" transform="rotate(-5 ${cx - r*0.2} ${cy - r*0.2})" fill="#fff" opacity="0.25"/>`;
  }

  const label = opts.noSun ? p.name : p.name;
  return `<svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}" aria-label="${label}" role="img">
    <defs>
      <radialGradient id="${gid}" cx="35%" cy="32%" r="75%">
        <stop offset="0%" stop-color="${p.hi||p.color}"/>
        <stop offset="55%" stop-color="${p.color}"/>
        <stop offset="100%" stop-color="${p.dark||p.color}"/>
      </radialGradient>
      <clipPath id="${cid}"><circle cx="${cx}" cy="${cy}" r="${r}"/></clipPath>
      ${clipDef}
    </defs>
    ${ringBehind}
    <g clip-path="url(#${cid})">
      <circle cx="${cx}" cy="${cy}" r="${r}" fill="url(#${gid})"/>
      ${extra}
    </g>
    ${ringFront}
  </svg>`;
}

function sunSVG(r){
  const uid = 'sun' + (__uid++);
  const size = r*2;
  return `<svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}" aria-label="태양" role="img">
    <defs><radialGradient id="${uid}" cx="35%" cy="32%" r="75%">
      <stop offset="0%" stop-color="${SUN.hi}"/><stop offset="60%" stop-color="${SUN.color}"/><stop offset="100%" stop-color="${SUN.dark}"/>
    </radialGradient></defs>
    <circle cx="${r}" cy="${r}" r="${r*0.94}" fill="url(#${uid})"/>
  </svg>`;
}

