---
import AppLayout from '../../../layouts/AppLayout.astro';
import Icon from '../../../components/Icon.astro';
---
<AppLayout
  title="패들렛 일괄 업로더 (Padlet Bulk Uploader) — eduin VIVES"
  description="패들렛 API 키만 있으면 텍스트를 줄바꿈 또는 구분자로 붙여넣어 내 보드에 게시물을 한 번에 업로드합니다. 명렬·단어 목록·링크 모음을 수작업 없이 일괄 등록."
  image="https://eduin.info/og-images/padlet-bulk-uploader.png"
  bodyShell="column"
  bodyWidth="wide"
>
  <Fragment slot="head">
    <style is:global="">
    /* --- 앱 전용 로컬 토큰 (hero-theme.css 변수 위에 추가) --- */
    :root, [data-theme="light"] { --warn: #f5a524; --warn-bg: rgba(245,165,36,0.1); --warn-border: rgba(245,165,36,0.3); }
    [data-theme="dark"]         { --warn: #f5a524; --warn-bg: rgba(245,165,36,0.12); --warn-border: rgba(245,165,36,0.35); }

    .panel { background: var(--card-bg); border: 1px solid var(--border); border-radius: 1rem; padding: 20px; margin-bottom: 16px; }
    .panel-title {
      font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--fg-muted); margin-bottom: 14px; display: flex; align-items: center; gap: 8px;
    }
    .panel-title::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    .field-label { display: block; font-size: 13px; font-weight: 500; color: var(--fg-muted); margin-bottom: 6px; }
    .hero-input { margin-bottom: 14px; font-family: 'JetBrains Mono', 'Consolas', monospace; }
    .hero-input.no-mb { margin-bottom: 0; }
    select.hero-input { font-family: inherit; }

    .hint { font-size: 12.5px; color: var(--fg-muted); line-height: 1.6; margin-top: -10px; margin-bottom: 14px; }
    .hint a { color: var(--primary); text-decoration: none; }
    .hint a:hover { text-decoration: underline; }

    .security-note {
      display: flex; align-items: flex-start; gap: 10px;
      background: rgba(0,111,238,0.06); border: 1px solid rgba(0,111,238,0.2);
      border-radius: 0.75rem; padding: 12px 14px; margin-bottom: 14px;
      font-size: 12px; color: var(--fg-muted); line-height: 1.6;
    }
    .security-note .icon { flex-shrink: 0; margin-top: 1px; }

    /* 전제조건 경고 배너 — 가이드보다 위, 가장 먼저 눈에 띄는 위치 */
    .warn-banner {
      display: flex; align-items: flex-start; gap: 10px;
      background: var(--warn-bg); border: 1px solid var(--warn-border);
      border-radius: 1rem; padding: 14px 16px; margin-bottom: 16px;
      font-size: 13px; color: var(--fg); line-height: 1.7;
    }
    .warn-banner .icon { flex-shrink: 0; font-size: 18px; margin-top: 2px; color: var(--warn); }
    .warn-banner b { color: var(--warn); }

    .guide {
      background: var(--bg-sec); border: 1px solid var(--border);
      border-left: 3px solid var(--primary); border-radius: 1rem;
      padding: 16px 20px; margin-bottom: 16px;
    }
    .guide-header {
      display: flex; align-items: center; gap: 8px; width: 100%; min-height: 44px;
      background: none; border: none; padding: 0; cursor: pointer;
      font-size: 14px; font-weight: 700; color: var(--primary); text-align: left; font-family: inherit;
    }
    .guide-header .chevron { margin-left: auto; font-size: 16px; color: var(--fg-muted); transition: transform 0.2s; display: inline-flex; }
    .guide.is-open .guide-header .chevron { transform: rotate(180deg); }
    .guide-body { max-height: 0; overflow: hidden; transition: max-height 0.25s ease, margin-top 0.25s ease; }
    .guide.is-open .guide-body { max-height: 420px; margin-top: 10px; }
    .guide ol { padding-left: 18px; }
    .guide li { font-size: 13px; color: var(--fg-muted); line-height: 1.7; margin-bottom: 4px; }
    .guide li code { font-family: 'JetBrains Mono', monospace; font-size: 11.5px; background: var(--border); padding: 1px 5px; border-radius: 4px; color: var(--fg); }
    .guide a { color: var(--primary); text-decoration: none; }
    .guide a:hover { text-decoration: underline; }

    .verify-row { display: flex; gap: 8px; margin-bottom: 14px; }
    .verify-row .hero-input { margin-bottom: 0; flex: 1; min-width: 0; }
    .verify-row .hero-btn { min-height: 44px; white-space: nowrap; }
    .verify-result { font-size: 13px; margin-bottom: 4px; min-height: 18px; display: flex; gap: 6px; align-items: flex-start; }
    .verify-result .ic { margin-top: 0.2em; }
    .verify-result.ok { color: var(--success); }
    .verify-result.err { color: var(--danger); }

    .options { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
    .opt-btn {
      flex: 1 1 140px; padding: 9px; min-height: 44px; background: var(--bg);
      border: 1px solid var(--border); border-radius: 0.75rem;
      color: var(--fg-muted); font-size: 13px; font-family: inherit; cursor: pointer;
      transition: all 0.15s; text-align: center;
    }
    .opt-btn.active { background: rgba(0,111,238,0.08); border-color: var(--primary); color: var(--primary); font-weight: 700; }

    .textarea-wrap { position: relative; }
    .fd-textarea {
      width: 100%; min-height: 220px; resize: vertical;
      background: var(--input-bg); border: 1px solid var(--border); border-radius: 0.75rem;
      padding: 14px; font-size: 13.5px; line-height: 1.7;
      font-family: 'JetBrains Mono', 'Consolas', monospace; color: var(--fg);
      outline: none; transition: border-color 0.2s;
    }
    .fd-textarea:focus { border-color: var(--primary); }
    .fd-textarea::placeholder { color: var(--fg-muted); }
    @media (pointer: coarse), (max-width: 768px) { .fd-textarea { font-size: 16px; } }
    .parse-count { font-size: 13px; color: var(--fg-muted); margin-top: 8px; }
    .parse-count b { color: var(--primary); }
    /* 입력 형식 안내 — placeholder와 달리 글을 쓰기 시작해도 사라지지 않는다 */
    .format-help { margin-top: 10px; padding: 10px 12px; border-radius: 0.75rem; background: var(--bg); border: 1px dashed var(--border); font-size: 13px; color: var(--fg-muted); line-height: 1.7; }
    .format-help b { color: var(--fg); }
    .format-help code { font-family: 'JetBrains Mono', monospace; font-size: 12px; background: var(--border); padding: 1px 5px; border-radius: 4px; color: var(--fg); }
    .format-help [hidden] { display: none; }

    .btn-run { width: 100%; padding: 14px; font-size: 16px; font-weight: 700; min-height: 48px; border-radius: 0.75rem; }

    .progress-wrap { margin-bottom: 16px; display: none; }
    .progress-bar-bg { height: 4px; background: var(--border); border-radius: 99px; overflow: hidden; margin-bottom: 10px; }
    .progress-bar { height: 100%; background: linear-gradient(90deg, var(--primary), var(--primary-h)); border-radius: 99px; width: 0%; transition: width 0.3s ease; }
    .progress-text { font-size: 12px; color: var(--fg-muted); font-family: 'JetBrains Mono', monospace; }

    .log-wrap { display: none; }
    .log-header { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--fg-muted); margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
    .log-header::after { content: ''; flex: 1; height: 1px; background: var(--border); }
    .log {
      background: var(--bg); border: 1px solid var(--border);
      border-radius: 0.75rem; padding: 12px 14px;
      font-family: 'JetBrains Mono', monospace; font-size: 12px;
      color: var(--fg-muted); max-height: 260px; overflow-y: auto; line-height: 1.8;
    }
    .log-item { display: flex; gap: 8px; }
    .log-icon { flex: none; display: inline-flex; padding-top: 0.35em; }
    .log-item.ok .log-icon { color: var(--success); }
    .log-item.skip .log-icon { color: var(--warn); }
    .log-item.err .log-icon { color: var(--danger); }
    .log-item.info .log-icon { color: var(--primary); }

    /* 결과 요약 — 다 올림(초록)·일부/멈춤(주황)·실패(빨강). 실패를 초록으로 그리지 않는다 */
    .summary {
      display: none; background: rgba(23,201,100,0.08);
      border: 1px solid rgba(23,201,100,0.3); border-radius: 1rem;
      padding: 14px 18px; font-size: 14px; color: #0e8a43; line-height: 1.5;
      text-align: center; font-weight: 600; margin-bottom: 16px;
    }
    .summary.warn { background: var(--warn-bg); border-color: var(--warn-border); color: #a15c00; }
    .summary.err  { background: rgba(243,18,96,0.08); border-color: rgba(243,18,96,0.35); color: #c20e4d; }
    [data-theme="dark"] .summary { color: #4ade80; }
    [data-theme="dark"] .summary.warn { color: #fbbf24; }
    [data-theme="dark"] .summary.err { color: #fb7185; }

    /* ── notion styler 스타일의 2열 레이아웃 ── */
    .pbu-grid {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: 20px;
      align-items: start;
      margin-top: 16px;
    }
    .pbu-col-left, .pbu-col-right {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .pbu-col-right .panel {
      margin-bottom: 0;
    }
    .pbu-col-right .btn-run {
      margin-top: 8px;
    }
    @media (max-width: 768px) {
      .pbu-grid {
        grid-template-columns: 1fr;
        gap: 16px;
      }
    }
  </style>
  <script type="application/ld+json" is:inline="">{"@context":"https://schema.org","@type":"WebApplication","name":"패들렛 일괄 업로더","description":"패들렛 API 키만 있으면 텍스트를 줄바꿈 또는 구분자로 붙여넣어 내 보드에 게시물을 한 번에 업로드합니다. 명렬·단어 목록·링크 모음을 수작업 없이 일괄 등록.","url":"https://eduin.info/apps/padlet-bulk-uploader/","applicationCategory":"EducationApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"KRW"},"isPartOf":{"@type":"WebSite","name":"eduin VIVES","url":"https://eduin.info"}}</script>
  </Fragment>


<!-- 플로팅 크롬(홈·테마·공유)은 app-shell.js가 주입합니다 -->
<main class="app-main">

  <div class="app-header">
    <div class="app-badge">크리에이티브</div>
    <h1 class="app-title">패들렛 일괄 업로더 <span class="app-title-en">Padlet Bulk Uploader</span></h1>
    <p class="app-desc">텍스트를 붙여넣으면 내 패들렛 보드에 게시물을 한 번에 올립니다.</p>
  </div>

  <div class="warn-banner">
    <span class="icon" aria-hidden="true"><Icon name="triangle-alert" /></span>
    <span>이 기능은 <b>패들렛 유료 구독 계정</b>에서만 동작합니다. 무료 계정과 <b>그룹(조직) 계정은 지원되지 않습니다.</b> 반드시 업로드하려는 보드의 <b>관리자 권한</b>이 있는 개인 계정으로 진행하세요.</span>
  </div>

  <div class="guide is-open" id="guide">
    <button type="button" class="guide-header" onclick="toggleGuide()" aria-expanded="true" aria-controls="guideBody">
      <Icon name="clipboard-list" /><span>API 키 · 보드 ID 받는 방법 (처음 한 번)</span>
      <span class="chevron" aria-hidden="true"><Icon name="chevron-down" /></span>
    </button>
    <div class="guide-body" id="guideBody">
      <ol>
        <li><a href="https://padlet.com/dashboard" target="_blank" rel="noopener">패들렛 대시보드</a>에 로그인 → 업로드할 보드를 엽니다.</li>
        <li>보드 화면 오른쪽 위 <code>···</code>(더보기) 메뉴 → <code>Developer</code>를 클릭합니다.</li>
        <li>열린 패널에서 <code>Generate</code>(또는 <code>Copy</code>) 버튼으로 API 키를 발급/복사합니다. 계정당 키는 1개이며, 이 계정이 관리자인 모든 보드에 재사용할 수 있습니다.</li>
        <li>같은 패널이나 보드 URL 끝부분에서 <b>Board ID</b>(16자리 영숫자)를 복사합니다. 이 앱에는 보드 URL을 그대로 붙여넣어도 자동으로 인식합니다.</li>
        <li>API 키를 계정 설정에서 바로 발급하려면 <a href="https://padlet.com/dashboard/settings/developers" target="_blank" rel="noopener">Settings → Developer</a> 페이지를 이용하세요.</li>
      </ol>
    </div>
  </div>

  <div class="pbu-grid">
    <!-- Left Column: 연결 및 옵션 설정 -->
    <div class="pbu-col-left">
      <div class="panel">
        <div class="panel-title">연결 설정</div>

        <label class="field-label" for="apiKey">패들렛 API 키</label>
        <input type="password" id="apiKey" class="hero-input" placeholder="Developer 패널에서 발급한 키" autocomplete="off" aria-describedby="apiKeyNote">

        <div class="security-note" id="apiKeyNote">
          <span class="icon" aria-hidden="true"><Icon name="lock" /></span>
          <span>API 키는 이 사이트의 중계 서버를 거쳐 패들렛에만 전달되며, 서버에 저장되거나 기록되지 않습니다. 올리기가 끝나면 입력칸도 비웁니다.</span>
        </div>

        <label class="field-label" for="boardId">보드 ID (또는 보드 주소)</label>
        <div class="verify-row">
          <input type="text" id="boardId" class="hero-input" placeholder="abcd1234efgh5678 또는 https://padlet.com/.../제목-abcd1234efgh5678">
          <button type="button" class="hero-btn hero-btn-ghost" id="verifyBtn" onclick="verifyBoard()">연결 확인</button>
        </div>
        <div class="verify-result" id="verifyResult" role="status" aria-live="polite"></div>
      </div>

      <div class="panel">
        <div class="panel-title">입력 방식</div>

        <div class="field-label" id="modeLabel">텍스트 구분 방식</div>
        <div class="options" role="group" aria-labelledby="modeLabel">
          <button type="button" class="opt-btn active" id="modeSimpleBtn" onclick="setMode('simple')" aria-pressed="true">간단 모드 (줄바꿈=1개)</button>
          <button type="button" class="opt-btn" id="modeDelimBtn" onclick="setMode('delim')" aria-pressed="false">구분자 모드 (제목+본문+링크)</button>
        </div>

        <label class="field-label" for="color">전체 항목 공통 색상</label>
        <select id="color" class="hero-input no-mb">
          <option value="">지정 안 함</option>
          <option value="red">빨강</option>
          <option value="orange">주황</option>
          <option value="green">초록</option>
          <option value="blue">파랑</option>
          <option value="purple">보라</option>
        </select>
      </div>
    </div>

    <!-- Right Column: 데이터 입력 및 실행 결과 -->
    <div class="pbu-col-right">
      <div class="panel">
        <div class="panel-title" id="bulkLabel">붙여넣기</div>
        <div class="textarea-wrap">
          <textarea id="bulkText" class="fd-textarea" placeholder="" oninput="updateParseCount()" aria-labelledby="bulkLabel" aria-describedby="parseCount"></textarea>
        </div>
        <div class="parse-count" id="parseCount">0개 항목으로 인식됨</div>
        <div class="format-help" id="formatHelp">
          <div id="helpSimple"><b>간단 모드</b> — 한 줄이 게시물 1개가 돼요(줄 내용이 제목). 빈 줄은 건너뜁니다.</div>
          <div id="helpDelim" hidden><b>구분자 모드</b> — <code>---</code>만 있는 줄로 게시물을 나눠요. 각 묶음의 첫 줄은 제목, 나머지 줄은 본문이 되고, <code>link: 주소</code>로 시작하는 줄은 링크로 붙어요.</div>
        </div>
      </div>

      <div class="progress-wrap" id="progressWrap">
        <div class="progress-bar-bg"><div class="progress-bar" id="progressBar"></div></div>
        <div class="progress-text" id="progressText" role="status" aria-live="polite">준비 중...</div>
      </div>

      <div class="summary" id="summary" role="status" aria-live="polite"></div>

      <div class="log-wrap" id="logWrap">
        <div class="log-header" id="logLabel">진행 기록</div>
        <div class="log" id="log" role="log" aria-labelledby="logLabel" tabindex="0"></div>
      </div>

      <button type="button" class="hero-btn btn-run" id="runBtn" onclick="onRunClick()"><Icon name="upload" /> <span id="runLabel">패들렛에 올리기</span></button>
    </div>
  </div>

</main>
<script is:inline="">
function toggleGuide() {
  const guide = document.getElementById('guide');
  const isOpen = guide.classList.toggle('is-open');
  guide.querySelector('.guide-header').setAttribute('aria-expanded', String(isOpen));
}

// @icons check x info triangle-alert upload square rotate-ccw
let mode = 'simple';
const posted = new Map();   // 업로드 성공 기록: 보드+내용 key → 성공 횟수
let running = false;
let cancelRequested = false;

const PLACEHOLDERS = {
  simple: '김철수\n이영희\n박민준\n최수아\n...',
  delim: '오늘의 발표 주제\n환경 보호 실천 방법을 소개합니다.\nlink: https://example.com/참고자료\n---\n두 번째 항목 제목\n본문도 여러 줄로 적을 수 있어요.\n---\n제목만 있는 항목도 가능',
};

function setMode(m) {
  mode = m;
  document.getElementById('modeSimpleBtn').classList.toggle('active', m === 'simple');
  document.getElementById('modeDelimBtn').classList.toggle('active', m === 'delim');
  document.getElementById('modeSimpleBtn').setAttribute('aria-pressed', String(m === 'simple'));
  document.getElementById('modeDelimBtn').setAttribute('aria-pressed', String(m === 'delim'));
  document.getElementById('bulkText').placeholder = PLACEHOLDERS[m];
  document.getElementById('helpSimple').hidden = m !== 'simple';
  document.getElementById('helpDelim').hidden = m !== 'delim';
  updateParseCount();
}
setMode('simple');
document.getElementById('boardId').addEventListener('input', updateParseCount);
document.getElementById('color').addEventListener('change', updateParseCount);

// 보드 URL을 붙여넣어도 끝의 16자리 영숫자 코드를 추출
function extractBoardId(raw) {
  const t = (raw || '').trim();
  if (/^[A-Za-z0-9]{16}$/.test(t)) return t;
  const m = t.match(/([A-Za-z0-9]{16})(?:[/?#]|$)/);
  return m ? m[1] : t;
}

function parseItems(text, m) {
  if (m === 'simple') {
    return text.split('\n')
      .map(l => l.trim())
      .filter(Boolean)
      .map(subject => ({ subject, body: '', linkUrl: '' }));
  }
  return text.split(/\n\s*---\s*\n/)
    .map(block => block.trim())
    .filter(Boolean)
    .map(block => {
      const lines = block.split('\n').map(l => l.trim());
      const subject = lines.shift() || '';
      let linkUrl = '';
      const rest = [];
      for (const line of lines) {
        const lm = line.match(/^link:\s*(.+)$/i);
        if (lm && !linkUrl) linkUrl = lm[1].trim();
        else rest.push(line);
      }
      return { subject, body: rest.join('\n'), linkUrl };
    })
    .filter(item => item.subject || item.body || item.linkUrl);
}

function updateParseCount() {
  const items = parseItems(document.getElementById('bulkText').value, mode);
  const boardId = extractBoardId(document.getElementById('boardId').value);
  const color = document.getElementById('color').value;
  const { todo, skip } = planUpload(items, boardId, color);
  document.getElementById('parseCount').innerHTML = `<b>${items.length}</b>개 항목으로 인식됨` +
    (skip ? ` · 이미 올린 ${skip}개는 건너뜀` : '');
  updateRunBtn(items.length, todo.length, skip);
}

/* ── 항목별 업로드 기록 (이 탭이 열려 있는 동안만) ──
   보드+내용이 같은 게시물을 몇 번 성공했는지 센다. 다시 실행하면 성공분은 건너뛰고
   실패·취소된 항목만 올린다. 같은 줄이 여러 번 있으면 그 수만큼 따로 센다.
   (posted·running·cancelRequested는 setMode() 첫 호출 전에 선언돼야 하므로 위쪽에 둠) */
function itemPayload(item, color) {
  const payload = { subject: item.subject, body: item.body, linkUrl: item.linkUrl };
  if (color) payload.color = color;
  return payload;
}
function itemKey(boardId, payload) { return boardId + '|' + JSON.stringify(payload); }

// items 중 이미 올린 것은 skip, 나머지는 todo(원래 순번 유지)
function planUpload(items, boardId, color) {
  const used = new Map();
  const todo = [];
  let skip = 0;
  items.forEach((item, i) => {
    const payload = itemPayload(item, color);
    const key = itemKey(boardId, payload);
    const u = used.get(key) || 0;
    if (u < (posted.get(key) || 0)) { used.set(key, u + 1); skip++; }
    else todo.push({ i, item, payload, key });
  });
  return { todo, skip };
}

// 버튼 이름은 지금 입력한 글 기준: 처음이면 'N개 올리기', 일부를 이미 올렸으면 '남은 N개 올리기'
function setRunBtn(icon, label) {
  const btn = document.getElementById('runBtn');
  btn.innerHTML = VUI.icon(icon) + ' <span id="runLabel"></span>';
  btn.querySelector('#runLabel').textContent = label;
}
function updateRunBtn(total, todoCount, skip) {
  if (running) return;
  const btn = document.getElementById('runBtn');
  btn.classList.remove('hero-btn-ghost');
  if (!total) setRunBtn('upload', '패들렛에 올리기');
  else if (!todoCount) setRunBtn('check', `${total}개 모두 올렸어요`);
  else if (skip) setRunBtn('rotate-ccw', `남은 ${todoCount}개 올리기`);
  else setRunBtn('upload', `패들렛에 ${todoCount}개 올리기`);
}

function onRunClick() {
  if (running) {
    cancelRequested = true;
    const btn = document.getElementById('runBtn');
    btn.disabled = true;
    setRunBtn('square', '멈추는 중…');
    return;
  }
  run();
}

function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

// 공용 VUI.apiFetch: 시간 제한·네트워크 오류·5xx를 한국어 문구로. 패들렛 고유 상태만 따로 안내
async function padletCall(apiKey, boardId, action, item) {
  try {
    return await VUI.apiFetch('/api/padlet', { json: { apiKey, boardId, action, item }, timeout: 30000 });
  } catch (e) {
    if (e.status === 401) e.message = 'API 키가 맞지 않아요. 키를 다시 확인해 주세요.';
    else if (e.status === 403) e.message = '이 보드의 관리자 권한이 없거나, 무료·그룹(조직) 계정이라 올릴 수 없어요.';
    else if (e.status === 404) e.message = '보드를 찾지 못했어요. 보드 ID(또는 주소)를 다시 확인해 주세요.';
    else if (e.status === 429) e.message = '요청이 너무 잦아요. 잠시 뒤 다시 해 주세요.';
    throw e;
  }
}

async function verifyBoard() {
  const apiKey = document.getElementById('apiKey').value.trim();
  const boardId = extractBoardId(document.getElementById('boardId').value);
  const resultEl = document.getElementById('verifyResult');
  resultEl.className = 'verify-result';
  resultEl.textContent = '';

  if (!apiKey || !boardId) {
    resultEl.className = 'verify-result err';
    resultEl.textContent = 'API 키와 보드 ID를 모두 입력해 주세요.';
    return;
  }

  const btn = document.getElementById('verifyBtn');
  btn.disabled = true;
  btn.textContent = '확인 중…';
  const show = (kind, icon, msg) => {
    resultEl.className = 'verify-result ' + kind;
    resultEl.innerHTML = VUI.icon(icon) + '<span></span>';
    resultEl.querySelector('span').textContent = msg;   // 보드 제목은 외부 데이터 — 글자로만
  };
  try {
    const data = await padletCall(apiKey, boardId, 'verifyBoard');
    show('ok', 'check', `연결됨 — "${data.title || boardId}"`);
  } catch (e) {
    show('err', 'triangle-alert', e.message);
  }
  btn.disabled = false;
  btn.textContent = '연결 확인';
}

function addLog(type, icon, msg) {
  const log = document.getElementById('log');
  const item = document.createElement('div');
  item.className = `log-item ${type}`;
  item.innerHTML = `<span class="log-icon">${VUI.icon(icon)}</span><span></span>`;
  item.querySelector('span:last-child').textContent = msg;
  log.appendChild(item);
  log.scrollTop = log.scrollHeight;
}

function setProgress(cur, total, msg) {
  const pct = total > 0 ? Math.round((cur / total) * 100) : 0;
  document.getElementById('progressBar').style.width = pct + '%';
  document.getElementById('progressText').textContent = msg;
}

async function run() {
  const apiKey = document.getElementById('apiKey').value.trim();
  const boardId = extractBoardId(document.getElementById('boardId').value);
  const color = document.getElementById('color').value;
  const items = parseItems(document.getElementById('bulkText').value, mode);

  if (!apiKey || !boardId) {
    VUI.toast('API 키와 보드 ID를 모두 입력해 주세요.', 'error');
    document.getElementById(apiKey ? 'boardId' : 'apiKey').focus();
    return;
  }
  if (!items.length) { VUI.toast('올릴 항목이 없어요. 글을 붙여넣어 주세요.', 'error'); return; }

  const { todo, skip } = planUpload(items, boardId, color);
  if (!todo.length) {
    await VUI.alert(`${items.length}개 항목을 모두 이미 올렸어요.\n같은 내용을 한 번 더 올리려면 페이지를 새로고침한 뒤 해 주세요.`, { title: '이미 올렸어요' });
    return;
  }
  if (skip > 0) {
    if (!(await VUI.confirm(`이미 올린 ${skip}개는 건너뛰고, 남은 ${todo.length}개만 올릴까요?`, { title: '남은 항목 올리기', ok: `${todo.length}개 올리기` }))) return;
  } else if (todo.length > 20 && !(await VUI.confirm(`${todo.length}개 항목을 패들렛 보드에 올릴까요?`, { title: '한꺼번에 올리기', ok: `${todo.length}개 올리기` }))) return;

  const btn = document.getElementById('runBtn');
  running = true;
  cancelRequested = false;
  btn.disabled = false;   // 올리는 중에는 '멈추기' 버튼으로 동작(보조 버튼 모양)
  btn.classList.add('hero-btn-ghost');
  setRunBtn('square', '올리기 멈추기');

  document.getElementById('progressWrap').style.display = 'block';
  document.getElementById('logWrap').style.display = 'block';
  document.getElementById('summary').style.display = 'none';
  document.getElementById('log').innerHTML = '';

  if (skip > 0) addLog('info', 'info', `이미 올린 ${skip}개는 건너뜁니다.`);

  let ok = 0, failed = 0, cancelled = 0;

  try {
    for (let n = 0; n < todo.length; n++) {
      if (cancelRequested) {
        cancelled = todo.length - n;
        addLog('info', 'info', `멈춤 — 남은 ${cancelled}개는 올리지 않았습니다.`);
        break;
      }
      const { i, item, payload, key } = todo[n];
      setProgress(n + 1, todo.length, `올리는 중… ${n + 1} / ${todo.length}`);

      let attempt = 0;
      let stopAll = false;
      while (true) {
        try {
          await padletCall(apiKey, boardId, 'createPost', payload);
          posted.set(key, (posted.get(key) || 0) + 1);   // 성공 기록 → 다시 실행해도 중복 게시 안 함
          addLog('ok', 'check', item.subject || item.body.slice(0, 30) || item.linkUrl);
          ok++;
          break;
        } catch (e) {
          if (e.status === 429 && attempt === 0) {
            attempt++;
            addLog('info', 'info', '요청이 많아 잠시 기다렸다가 다시 시도합니다…');
            await sleep(1500);
            continue;
          }
          if (e.status === 401) {
            addLog('err', 'x', e.message);
            failed += todo.length - n;
            stopAll = true; // 전체 중단
          } else {
            addLog('err', 'x', `[${item.subject || i + 1}] ${e.message}`);
            failed++;
          }
          break;
        }
      }
      if (stopAll) break;
      await sleep(500);
    }
  } finally {
    const sumEl = document.getElementById('summary');
    sumEl.style.display = 'block';
    const left = todo.length - ok;
    const head = cancelled ? '중간에 멈췄어요.' : !ok && failed ? '올리지 못했어요.' : failed ? '일부만 올렸어요.' : '다 올렸어요!';
    sumEl.className = 'summary ' + (cancelled ? 'warn' : !ok && failed ? 'err' : failed ? 'warn' : 'ok');
    sumEl.textContent = `${head} 성공 ${ok}개 · 실패 ${failed}개` +
      (cancelled ? ` · 멈춰서 안 올린 것 ${cancelled}개` : '') + (skip ? ` · 건너뜀 ${skip}개` : '') +
      (left ? ` — API 키를 다시 입력하고 아래 버튼을 누르면 남은 ${left}개만 다시 올립니다.` : ' (보안을 위해 API 키 입력칸을 비웠어요.)');

    // 실행 완료 후 API 키 초기화 (메모리에서 제거) — 요약에 안내가 들어 있다
    document.getElementById('apiKey').value = '';
    running = false;
    btn.disabled = false;
    updateParseCount();
  }
}
</script>



</AppLayout>
