---
import AppLayout from '../../../layouts/AppLayout.astro';
import Icon from '../../../components/Icon.astro';
---
<AppLayout
  title="유튜브 썸네일 (YT Thumbnail) — eduin VIVES"
  description="유튜브 영상 주소로 썸네일 이미지를 저장하고, 재생목록은 영상 목록과 썸네일을 ZIP으로 모아 받아요."
  image="https://eduin.info/og-images/yt-thumb.png"
  bodyShell="column"
  bodyWidth="narrow"
>
  <Fragment slot="head">
    <!-- JSZip은 재생목록 ZIP 받기를 누를 때만 불러온다(downloadZip) -->
  <style is:global="">
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap');

    body { min-height: 100vh; min-height: 100dvh; }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(0,111,238,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,111,238,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 0;
    }

    /* 폭은 공용 셸(bodyWidth="narrow" → .app-main)이 정한다 */
    .wrap {
      position: relative;
      z-index: 1;
    }

    .app-card {
      background: transparent;
      border: none;
      border-radius: 0;
      padding: 0;
      min-height: auto;
    }

    /* ── 탭 (숨김) ── */
    .tab-row { display: none; }
    .tab-btn { display: none; }
    .tab-pane { display: none; }

    .btn-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.625rem; margin-top: 0.75rem; }

    /* ── 듀얼 모드 탭 ── */
    .dual-tab-btn {
      transition: all 0.2s;
    }
    .dual-tab-btn:hover {
      border-color: var(--primary);
      opacity: 0.9;
    }
    .dual-tab-active {
      background: var(--primary) !important;
      color: #fff !important;
      border-color: var(--primary) !important;
    }

    /* ── 단일/재생목록 UI ── */
    #single-ui,
    #playlist-ui {
      margin-top: 1.5rem;
    }

    /* ── 결과 영역 (단일) ── */
    #result { margin-top: 1.25rem; display: none; }

    .thumb-item { margin-bottom: 1rem; }
    .thumb-label { font-size: 0.85rem; font-weight: 600; color: var(--fg-muted); margin-bottom: 0.375rem; }
    .thumb-title { font-size: 0.95rem; font-weight: 700; margin: 0 0 0.75rem; line-height: 1.4; word-break: break-word; }
    .thumb-title.loading { color: var(--fg-muted); font-weight: 500; }
    .thumb-save { width: 100%; margin-bottom: 1rem; }
    .thumb-save-sm { margin-top: 0.5rem; width: 100%; }
    .thumb-missing { color: #ccc; font-size: 0.85rem; padding: 1rem; text-align: center; line-height: 1.5; }

    .thumb-preview {
      width: 100%;
      border-radius: 0.625rem;
      border: 1px solid var(--border);
      overflow: hidden;
      background: #000;
      margin-bottom: 0.5rem;
      aspect-ratio: 16/9;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .thumb-preview img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .thumb-url-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 0.625rem;
      padding: 0.5rem 0.75rem;
    }

    .thumb-url {
      flex: 1;
      font-size: 0.72rem;
      font-family: monospace;
      color: var(--primary);
      word-break: break-all;
      text-decoration: none;
    }

    .thumb-url:hover { text-decoration: underline; }

    .btn-copy {
      background: none; border: none; cursor: pointer;
      color: var(--fg-muted); padding: 4px; border-radius: 0.375rem;
      transition: color 0.15s, background 0.15s; flex-shrink: 0;
      min-width: 44px; min-height: 44px;
      display: flex; align-items: center; justify-content: center;
    }

    .btn-copy:hover { color: var(--primary); background: var(--border); }

    /* ── 에러 ── */
    .error-box {
      background: rgba(243,18,96,0.08);
      border: 1px solid rgba(243,18,96,0.3);
      border-radius: 0.625rem;
      padding: 0.75rem 1rem;
      font-size: 0.85rem;
      color: var(--danger);
    }

    /* ── 히스토리 ── */
    .history-section {
      margin-top: 1.25rem;
      padding-top: 0;
      display: block;
    }

    .history-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
    }

    .history-header span { font-size: 0.9rem; font-weight: 700; }
    .btn-clear-h { font-size: 0.875rem; color: var(--danger); background: none; border: 1px solid color-mix(in srgb, var(--danger) 45%, transparent); border-radius: 0.5rem; cursor: pointer; font-family: inherit; min-height: 44px; padding: 0 10px; display: inline-flex; align-items: center; gap: 4px; }
    .btn-clear-h:hover { background: color-mix(in srgb, var(--danger) 10%, transparent); }

    .history-list {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .history-item {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      padding: 0.25rem 0.25rem 0.25rem 0.375rem;
      transition: border-color 0.15s, background 0.15s;
    }

    .history-item:hover { border-color: var(--primary); background: var(--bg-hover); }
    /* 기록 열기 = 버튼(키보드 Tab·Enter), 지우기 버튼은 그 옆 */
    .history-open {
      flex: 1; min-width: 0; min-height: 44px;
      display: flex; align-items: center; gap: 0.625rem;
      padding: 0.25rem; border: 0; border-radius: 0.5rem; background: none;
      font: inherit; color: inherit; text-align: left; cursor: pointer;
    }

    .history-thumb {
      width: 64px; height: 40px;
      object-fit: cover; border-radius: 0.375rem;
      flex-shrink: 0; background: #000;
    }

    .history-info { flex: 1; min-width: 0; }
    .history-title { font-size: 0.85rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .history-time { font-size: 0.75rem; color: var(--fg-muted); margin-top: 2px; }
    .history-links { display: flex; gap: 0.625rem; margin-top: 2px; }
    .history-links a { font-size: 0.7rem; color: var(--fg-muted); text-decoration: none; }
    .history-links a:hover { color: var(--primary); text-decoration: underline; }

    /* 히스토리 펄스 애니메이션 */
    @keyframes pulse-subtle {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.7; }
    }
    .history-section.pulse {
      animation: pulse-subtle 0.6s ease-in-out 2;
    }

    .btn-del-h {
      background: none; border: none; color: var(--fg-muted);
      cursor: pointer; padding: 4px; font-size: 0.875rem;
      min-width: 44px; min-height: 44px; border-radius: 0.5rem;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .btn-del-h:hover { color: var(--danger); }

    /* ── 플레이리스트 탭 ── */
    .pl-label {
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--fg-muted);
      margin-bottom: 0.375rem;
      display: block;
    }

    #plResult { margin-top: 1.25rem; }

    /* ── 플레이리스트 결과 확장 ── */
    #playlist-ui {
      display: flex;
      flex-direction: column;
    }
    #plResult {
      max-width: 800px;
      align-self: center;
      width: 100%;
    }

    .pl-header {
      margin-bottom: 1rem;
    }

    .pl-title {
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 0.25rem;
      word-break: break-word;
    }

    .pl-meta {
      font-size: 0.78rem;
      color: var(--fg-muted);
    }

    .pl-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .pl-list {
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
      max-height: 420px;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    .pl-item {
      display: flex;
      gap: 0.75rem;
      align-items: flex-start;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      padding: 0.625rem 0.75rem;
    }

    .pl-num {
      font-size: 0.7rem;
      font-family: monospace;
      font-weight: 700;
      color: var(--fg-muted);
      flex-shrink: 0;
      min-width: 24px;
      padding-top: 2px;
    }

    .pl-thumb {
      width: 96px;
      height: 60px;
      object-fit: cover;
      border-radius: 0.375rem;
      flex-shrink: 0;
      background: #000;
    }

    .pl-info { flex: 1; min-width: 0; }

    .pl-vtitle {
      font-size: 0.82rem;
      font-weight: 600;
      line-height: 1.3;
      margin-bottom: 0.25rem;
      word-break: break-word;
    }

    .pl-vdesc {
      font-size: 0.72rem;
      color: var(--fg-muted);
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .pl-vlink {
      font-size: 0.7rem;
      color: var(--primary);
      text-decoration: none;
      margin-top: 0.25rem;
      display: inline-block;
    }

    .pl-vlink:hover { text-decoration: underline; }

    /* 로딩 */
    .loading-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      padding: 2rem 1rem;
      color: var(--fg-muted);
      font-size: 0.85rem;
    }

    .spinner {
      width: 28px; height: 28px;
      border: 3px solid var(--border);
      border-top-color: var(--primary);
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── 통합 URL 입력 ── */
    .url-input-row {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      margin-bottom: 1rem;
    }
    .url-input-row .hero-input { flex: 1; min-width: 0; }
    .dual-tab-btn { min-height: 44px; font-family: inherit; }
    .btn-analyze {
      min-width: 44px; height: 48px;
      padding: 0 1rem;
      border-radius: 0.75rem;
      border: none;
      background: var(--primary);
      color: #fff;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
      flex-shrink: 0;
      font: inherit;
      font-weight: 700;
      transition: opacity 0.15s;
    }
    .btn-analyze:hover { opacity: 0.85; }

    /* 프로그레스 */
    .progress-wrap {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 0.625rem;
      padding: 0.75rem 1rem;
      margin-top: 0.75rem;
      font-size: 0.8rem;
    }

    .progress-bar-bg {
      height: 6px;
      background: var(--border);
      border-radius: 3px;
      overflow: hidden;
      margin-top: 0.5rem;
    }

    .progress-bar-fill {
      height: 100%;
      background: var(--primary);
      border-radius: 3px;
      transition: width 0.3s;
    }
  </style>
  <script type="application/ld+json" is:inline="">{"@context":"https://schema.org","@type":"WebApplication","name":"유튜브 썸네일 (YT Thumbnail)","description":"유튜브 영상 주소로 썸네일 이미지를 저장하고, 재생목록은 영상 목록과 썸네일을 ZIP으로 모아 받아요.","url":"https://eduin.info/apps/yt-thumb/","applicationCategory":"EducationApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"KRW"},"isPartOf":{"@type":"WebSite","name":"eduin VIVES","url":"https://eduin.info"}}</script>
  </Fragment>


<!-- 플로팅 크롬(홈·테마·공유)은 app-shell.js가 주입 -->
<div class="wrap app-main">

  <div class="app-header">
    <div class="app-badge">크리에이티브</div>
    <h1 class="app-title">유튜브 썸네일 <span class="app-title-en">YT Thumbnail</span></h1>
    <p class="app-desc">영상 주소를 넣으면 썸네일 이미지를 저장할 수 있고, 재생목록 주소를 넣으면 모든 영상의 제목과 썸네일을 모아 받을 수 있어요.</p>
  </div>

  <div class="app-card">

    <!-- 통합 URL 입력 -->
    <div class="url-input-row">
      <input type="url" id="youtubeUrl" class="hero-input" placeholder="유튜브 영상 또는 재생목록 주소" aria-label="유튜브 영상 또는 재생목록 주소" onkeyup="if(event.key==='Enter')analyzeUrl()">
      <button type="button" class="btn-analyze" onclick="analyzeUrl()">
        <Icon name="search" /> 찾기
      </button>
    </div>

    <!-- 듀얼 모드 탭 (영상+재생목록 동시) -->
    <div id="dual-mode-tabs" style="display:none; margin-top:1rem; margin-bottom:1rem;">
      <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:0.5rem;" role="group" aria-label="보기 선택">
        <button type="button" aria-pressed="true" onclick="switchDualModeTab('thumbnail')" id="tab-thumbnail" class="dual-tab-btn dual-tab-active" style="padding:0.5rem; border-radius:0.5rem; border:1px solid var(--border); background:var(--primary); color:#fff; cursor:pointer; font-weight:600; font-size:0.875rem; transition:all 0.2s;">썸네일</button>
        <button type="button" aria-pressed="false" onclick="switchDualModeTab('playlist')" id="tab-playlist" class="dual-tab-btn" style="padding:0.5rem; border-radius:0.5rem; border:1px solid var(--border); background:transparent; color:var(--fg); cursor:pointer; font-weight:600; font-size:0.875rem; transition:all 0.2s;">재생목록</button>
        <button type="button" aria-pressed="false" onclick="switchDualModeTab('history')" id="tab-history" class="dual-tab-btn" style="padding:0.5rem; border-radius:0.5rem; border:1px solid var(--border); background:transparent; color:var(--fg); cursor:pointer; font-weight:600; font-size:0.875rem; transition:all 0.2s;">최근 기록</button>
      </div>
    </div>

    <!-- 단일영상 UI -->
    <div id="single-ui" style="display:none; margin-top:1rem;">
      <div id="result" aria-live="polite"></div>
    </div>

    <!-- 재생목록 UI -->
    <div id="playlist-ui" style="display:none; margin-top:1rem;">
      <button type="button" onclick="showApiKeyModal()" class="hero-btn hero-btn-ghost" id="plApiKeyBtn" style="display:none;width:100%;margin-top:0.5rem;font-size:0.875rem;min-height:44px;"><Icon name="key-round" /> API 키 설정</button>
      <div id="plResult" class="pl-result-wide" aria-live="polite"></div>
    </div>

    <!-- 통합 히스토리 -->
    <div class="history-section" id="historySection" style="margin-top:1.5rem;">
      <div class="history-header">
        <span id="historyHeading">최근 기록</span>
        <button type="button" class="btn-clear-h" onclick="clearAllHistory()"><Icon name="trash-2" /> 기록 모두 지우기</button>
      </div>
      <div class="history-list" id="historyList" role="list" aria-labelledby="historyHeading"></div>
    </div>

  </div>
</div>

<!-- 플로팅 크롬은 app-shell.js가 주입 -->

<script is:inline="">
  // ── 초기화 ──
  // @icons copy check x download triangle-alert file-text key-round
  let currentMode = null; // 'video', 'playlist', 'dual'
  let currentVideo = null; // { videoId, title } — '이미지 저장' 파일 이름용

  document.addEventListener('DOMContentLoaded', () => {
    renderUnifiedHistory();
  });

  /* ─────────────────────── URL 분석 + 모드 전환 ─────────────────────── */
  function analyzeUrl() {
    const url = document.getElementById('youtubeUrl').value.trim();
    if (!url) { showError('유튜브 주소를 입력해 주세요.'); return; }
    const isVideo = YT_REGEX.test(url);
    const isList = PL_REGEX.test(url);

    if (!isVideo && !isList) {
      showError('유튜브 영상이나 재생목록 주소가 아니에요. 주소를 다시 확인해 주세요.');
      document.getElementById('dual-mode-tabs').style.display = 'none';
      return;
    }

    // 모든 탭 활성화 상태 초기화
    const playlistBtn = document.getElementById('tab-playlist');
    const thumbnailBtn = document.getElementById('tab-thumbnail');

    // 듀얼 URL 처리: 영상과 재생목록 ID가 모두 있는 경우 (탭 모드)
    if (isVideo && isList) {
      currentMode = 'dual';
      document.getElementById('dual-mode-tabs').style.display = 'block';
      playlistBtn.disabled = false;
      playlistBtn.style.opacity = '1';
      playlistBtn.style.cursor = 'pointer';
      thumbnailBtn.disabled = false;
      thumbnailBtn.style.opacity = '1';
      thumbnailBtn.style.cursor = 'pointer';
      switchDualModeTab('thumbnail');
      renderUnifiedHistory();
    } else if (isVideo) {
      currentMode = 'video';
      document.getElementById('dual-mode-tabs').style.display = 'block';
      thumbnailBtn.disabled = false;
      thumbnailBtn.style.opacity = '1';
      thumbnailBtn.style.cursor = 'pointer';
      playlistBtn.disabled = true;
      playlistBtn.style.opacity = '0.5';
      playlistBtn.style.cursor = 'not-allowed';
      switchDualModeTab('thumbnail');
      renderUnifiedHistory();
    } else if (isList) {
      currentMode = 'playlist';
      document.getElementById('dual-mode-tabs').style.display = 'block';
      playlistBtn.disabled = false;
      playlistBtn.style.opacity = '1';
      playlistBtn.style.cursor = 'pointer';
      thumbnailBtn.disabled = true;
      thumbnailBtn.style.opacity = '0.5';
      thumbnailBtn.style.cursor = 'not-allowed';
      // 플레이리스트 탭을 약간 지연시켜서 활성화 (DOM 업데이트 이후)
      setTimeout(() => switchDualModeTab('playlist'), 50);
      renderUnifiedHistory();
    }
  }

  // 듀얼 모드 탭 전환
  function switchDualModeTab(tab) {
    const thumbnailBtn = document.getElementById('tab-thumbnail');
    const playlistBtn = document.getElementById('tab-playlist');
    const historyBtn = document.getElementById('tab-history');
    const singleUi = document.getElementById('single-ui');
    const playlistUi = document.getElementById('playlist-ui');
    const historySection = document.getElementById('historySection');

    // 모든 탭 버튼 비활성화 상태 초기화 (disabled 상태는 유지)
    thumbnailBtn.classList.remove('dual-tab-active');
    playlistBtn.classList.remove('dual-tab-active');
    historyBtn.classList.remove('dual-tab-active');
    if (!thumbnailBtn.disabled) {
      thumbnailBtn.style.background = 'transparent';
      thumbnailBtn.style.color = 'var(--fg)';
      thumbnailBtn.style.borderColor = 'var(--border)';
    }
    if (!playlistBtn.disabled) {
      playlistBtn.style.background = 'transparent';
      playlistBtn.style.color = 'var(--fg)';
      playlistBtn.style.borderColor = 'var(--border)';
    }
    historyBtn.style.background = 'transparent';
    historyBtn.style.color = 'var(--fg)';
    historyBtn.style.borderColor = 'var(--border)';

    // 모든 콘텐츠 숨김
    singleUi.style.display = 'none';
    playlistUi.style.display = 'none';
    historySection.style.display = 'none';

    [thumbnailBtn, playlistBtn, historyBtn].forEach(b => b.setAttribute('aria-pressed', 'false'));
    const pressed = tab === 'thumbnail' ? thumbnailBtn : tab === 'playlist' ? playlistBtn : historyBtn;
    if (!pressed.disabled) pressed.setAttribute('aria-pressed', 'true');

    // 선택된 탭 활성화
    if (tab === 'thumbnail' && !thumbnailBtn.disabled) {
      thumbnailBtn.classList.add('dual-tab-active');
      thumbnailBtn.style.background = 'var(--primary)';
      thumbnailBtn.style.color = '#fff';
      thumbnailBtn.style.borderColor = 'var(--primary)';
      singleUi.style.display = 'block';
      extractThumbnail();
    } else if (tab === 'playlist' && !playlistBtn.disabled) {
      playlistBtn.classList.add('dual-tab-active');
      playlistBtn.style.background = 'var(--primary)';
      playlistBtn.style.color = '#fff';
      playlistBtn.style.borderColor = 'var(--primary)';
      playlistUi.style.display = 'block';
      fetchPlaylist();
    } else if (tab === 'history') {
      historyBtn.classList.add('dual-tab-active');
      historyBtn.style.background = 'var(--primary)';
      historyBtn.style.color = '#fff';
      historyBtn.style.borderColor = 'var(--primary)';
      historySection.style.display = 'block';
    }
  }

  /* ───────────────────────── 단일 영상 ───────────────────────── */
  const YT_REGEX = /(?:https?:\/\/)?(?:www\.)?(?:youtube\.com\/(?:[^\/\n\s]+\/\S+\/|(?:v|e(?:mbed)?|shorts|live)\/|\S*?[?&]v=)|youtu\.be\/)([a-zA-Z0-9_-]{11})/;

  // 썸네일은 바로 보여 주고, 제목(기록·파일 이름용)은 그 뒤에 따로 가져온다(최대 10초 기다리지 않게)
  async function extractThumbnail() {
    const url = document.getElementById('youtubeUrl').value.trim();
    if (!url) { showError('유튜브 주소를 입력해 주세요.'); return; }
    const match = url.match(YT_REGEX);
    if (match && match[1]) {
      const videoId = match[1];
      displayResult(videoId, '');

      // 영상 제목 조회(기록 표시용 — 실패해도 썸네일은 그대로 보여 준다)
      let title = '', author = '';
      try {
        const data = await VUI.apiFetch('/api/yt-video-info', { json: { videoId }, timeout: 10000 });
        title = (data && typeof data.title === 'string' && data.title) || '';
        author = (data && typeof data.author === 'string' && data.author) || '';
      } catch (e) { /* 실패 시 ID만 저장 */ }
      saveToUnifiedHistory('video', { videoId, title, author });
      if (currentVideo && currentVideo.videoId === videoId) setVideoTitle(videoId, title);
      renderUnifiedHistory();
    } else {
      showError('유튜브 영상 주소가 아니에요. 주소를 다시 확인해 주세요.');
    }
  }

  function setVideoTitle(videoId, title) {
    currentVideo = { videoId, title: title || '' };
    const el = document.getElementById('thumbTitle');
    if (!el) return;
    el.classList.remove('loading');
    el.textContent = title || '(영상 제목을 가져오지 못했어요)';
  }

  const COPY_SVG = () => VUI.icon('copy');
  function displayResult(videoId, title) {
    const result = document.getElementById('result');
    const maxRes = `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`;
    const hq     = `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`;
    currentVideo = { videoId, title: title || '' };

    result.style.display = 'block';
    result.innerHTML = `
      <p class="thumb-title${title ? '' : ' loading'}" id="thumbTitle">${title ? escHtml(title) : '영상 제목을 가져오는 중…'}</p>
      <button type="button" class="hero-btn thumb-save" onclick="saveThumb('maxres')">${VUI.icon('download')} 이미지 저장</button>
      <div class="thumb-item">
        <div class="thumb-label">가장 큰 크기 (1280×720)</div>
        <div class="thumb-preview">
          <img src="${maxRes}" alt="가장 큰 크기 썸네일"
               onerror="this.parentElement.innerHTML='<span class=&quot;thumb-missing&quot;>이 영상에는 가장 큰 크기(1280×720) 썸네일이 없어요.<br>아래 기본 크기로 저장돼요.</span>'">
        </div>
        <div class="thumb-url-row">
          <a href="${maxRes}" target="_blank" class="thumb-url" rel="noopener">${maxRes}</a>
          <button type="button" class="btn-copy" onclick="copyUrl(this,'${maxRes}')" title="주소 복사" aria-label="가장 큰 크기 썸네일 주소 복사">${COPY_SVG()}</button>
        </div>
      </div>
      <div class="thumb-item">
        <div class="thumb-label">기본 크기 (480×360)</div>
        <div class="thumb-preview">
          <img src="${hq}" alt="기본 크기 썸네일">
        </div>
        <div class="thumb-url-row">
          <a href="${hq}" target="_blank" class="thumb-url" rel="noopener">${hq}</a>
          <button type="button" class="btn-copy" onclick="copyUrl(this,'${hq}')" title="주소 복사" aria-label="기본 크기 썸네일 주소 복사">${COPY_SVG()}</button>
        </div>
        <button type="button" class="hero-btn hero-btn-ghost hero-btn-sm thumb-save-sm" onclick="saveThumb('hq')">${VUI.icon('download')} 기본 크기로 저장</button>
      </div>
    `;
  }

  // 이미지 저장: 같은 출처 프록시(/api/yt-thumb-img)로 받아 파일로 저장(유튜브 이미지는 바로 내려받기가 안 됨)
  // 가장 큰 크기가 없는 영상은 기본 크기로 대신 저장한다.
  async function saveThumb(q) {
    if (!currentVideo) return;
    const { videoId, title } = currentVideo;
    const tryGet = async (qq) => {
      const res = await fetch(`/api/yt-thumb-img?id=${encodeURIComponent(videoId)}&q=${qq}`);
      return res.ok ? res.blob() : null;
    };
    try {
      let used = q;
      let blob = await tryGet(q);
      if (!blob && q === 'maxres') { used = 'hq'; blob = await tryGet('hq'); }
      if (!blob) throw new Error('no image');
      const size = used === 'maxres' ? '1280x720' : '480x360';
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${sanitizeFilename(title || videoId)}_${size}.jpg`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
      VUI.toast(used !== q ? '가장 큰 크기가 없어서 기본 크기(480×360)로 저장했어요.' : '썸네일 이미지를 저장했어요.');
    } catch {
      VUI.toast('이미지를 저장하지 못했어요. 썸네일을 길게 누르거나 오른쪽 클릭해서 저장해 보세요.', 'error');
    }
  }

  function showError(msg) {
    const result = document.getElementById('result');
    result.style.display = 'block';
    result.innerHTML = `<div class="error-box" role="alert">${escHtml(String(msg))}</div>`;
  }

  // 복사는 공용 VUI.copy(성공 토스트), 실패하면 링크 창(VUI.share.show)으로 주소를 보여 준다
  function copyUrl(btn, url) {
    VUI.copy(url, '주소를 복사했어요').then((ok) => {
      if (!ok) { VUI.share.show(url, { title: '썸네일 주소', qr: false, note: '자동 복사가 안 돼서 주소를 보여 드려요.' }); return; }
      btn.innerHTML = VUI.icon('check');
      btn.style.color = 'var(--success)';
      setTimeout(() => { btn.innerHTML = VUI.icon('copy'); btn.style.color = ''; }, 1500);
    });
  }

  // ── 통합 히스토리 ──
  const UNIFIED_HISTORY_KEY = 'youtube_unified_history';

  // 저장값이 깨져 있어도 앱이 멈추지 않도록 형식 검사
  function loadUnifiedHistory() {
    try {
      const v = JSON.parse(localStorage.getItem(UNIFIED_HISTORY_KEY) || '[]');
      return Array.isArray(v) ? v.filter(h => h && (h.type === 'video' || h.type === 'playlist') && h.data) : [];
    } catch { return []; }
  }
  // 기록 항목의 키(영상 ID 또는 재생목록 URL)
  function historyKey(h) {
    if (h.type === 'video') return String(typeof h.data === 'object' ? h.data.videoId : h.data);
    return String(typeof h.data === 'object' ? h.data.url : h.data);
  }
  // 인라인 onclick에는 순번만 넣고 값은 저장소에서 다시 읽는다(따옴표·역슬래시가 든 URL로 깨지지 않게)
  function openHistoryAt(idx) {
    const h = loadUnifiedHistory()[idx];
    if (h) applyFromUnifiedHistory(h.type, historyKey(h));
  }
  function deleteHistoryAt(idx) {
    const h = loadUnifiedHistory()[idx];
    if (h) deleteFromUnifiedHistory(h.type, historyKey(h));
  }

  function saveToUnifiedHistory(type, data) {
    let hist = loadUnifiedHistory();
    const item = { type, data, timestamp: new Date().toISOString() };
    // 중복 제거
    hist = hist.filter(h => {
      if (h.type !== type) return true;
      if (type === 'video') {
        const hId = typeof h.data === 'object' ? h.data.videoId : h.data;
        const newId = typeof data === 'object' ? data.videoId : data;
        return hId !== newId;
      }
      if (type === 'playlist') {
        const hUrl = typeof h.data === 'object' ? h.data.url : h.data;
        const newUrl = typeof data === 'object' ? data.url : data;
        return hUrl !== newUrl;
      }
      return true;
    });
    hist.unshift(item);
    try { localStorage.setItem(UNIFIED_HISTORY_KEY, JSON.stringify(hist.slice(0, 30))); } catch {}
  }

  function renderUnifiedHistory() {
    const list = document.getElementById('historyList');
    const hist = loadUnifiedHistory();
    if (!hist.length) {
      list.innerHTML = '<p style="text-align:center;color:var(--fg-muted);font-size:0.85rem;padding:1rem">아직 기록이 없어요.</p>';
      return;
    }
    list.innerHTML = hist.map((item, idx) => {
      if (item.type === 'video') {
        const dateStr = new Date(item.timestamp).toLocaleDateString('ko-KR', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });

        // item.data가 객체일 수도 있고 문자열(ID)일 수도 있음 (하위호환성)
        const isNewFormat = typeof item.data === 'object' && item.data.videoId;
        const videoId = isNewFormat ? item.data.videoId : item.data;
        const rawTitle = isNewFormat ? item.data.title : '';
        // 예전 기록의 'Unknown Title'(제목 조회 실패)도 같은 문구로
        const videoTitle = rawTitle && rawTitle !== 'Unknown Title' ? rawTitle : `영상 ${videoId}`;

        return `
          <div class="history-item" role="listitem">
            <button type="button" class="history-open" onclick="openHistoryAt(${idx})">
              <img class="history-thumb" src="https://img.youtube.com/vi/${encodeURIComponent(videoId)}/mqdefault.jpg" alt="">
              <span class="history-info">
                <span class="history-title" style="display:block">${escHtml(String(videoTitle || ''))}</span>
                <span class="history-time" style="display:block">${dateStr} · 영상</span>
              </span>
            </button>
            <button type="button" class="btn-del-h" onclick="deleteHistoryAt(${idx})" aria-label="${escHtml(String(videoTitle || '영상'))} 기록 지우기" title="기록 지우기">${VUI.icon('x')}</button>
          </div>
        `;
      } else if (item.type === 'playlist') {
        const dateStr = new Date(item.timestamp).toLocaleDateString('ko-KR', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });

        // item.data가 객체일 수도 있고 문자열(URL)일 수도 있음 (하위호환성)
        const isNewFormat = typeof item.data === 'object' && item.data.url;
        const playlistUrl = isNewFormat ? item.data.url : item.data;
        const firstVideoId = isNewFormat ? item.data.firstVideoId : null;
        const firstVideoTitle = isNewFormat ? item.data.firstVideoTitle : null;
        const playlistTitle = isNewFormat ? item.data.title : null;

        const thumbUrl = firstVideoId
          ? `https://img.youtube.com/vi/${encodeURIComponent(firstVideoId)}/mqdefault.jpg`
          : 'https://img.youtube.com/vi/dQw4w9WgXcQ/mqdefault.jpg';

        const displayTitle = playlistTitle || '재생목록';

        return `
          <div class="history-item" role="listitem">
            <button type="button" class="history-open" onclick="openHistoryAt(${idx})">
              <img class="history-thumb" src="${thumbUrl}" alt="">
              <span class="history-info">
                <span class="history-title" style="display:block">${escHtml(String(displayTitle))}</span>
                <span class="history-time" style="display:block">${dateStr} · 재생목록</span>
              </span>
            </button>
            <button type="button" class="btn-del-h" onclick="deleteHistoryAt(${idx})" aria-label="${escHtml(String(displayTitle))} 기록 지우기" title="기록 지우기">${VUI.icon('x')}</button>
          </div>
        `;
      }
    }).join('');
  }

  function applyFromUnifiedHistory(type, data) {
    if (type === 'video') {
      // data가 객체일 수도 있고 문자열(ID)일 수도 있음 (하위호환성)
      const videoId = typeof data === 'object' ? data.videoId : data;
      document.getElementById('youtubeUrl').value = `https://www.youtube.com/watch?v=${videoId}`;

      // 썸네일 탭으로 전환
      currentMode = 'video';
      document.getElementById('dual-mode-tabs').style.display = 'block';
      const thumbnailBtn = document.getElementById('tab-thumbnail');
      const playlistBtn = document.getElementById('tab-playlist');
      thumbnailBtn.disabled = false;
      thumbnailBtn.style.opacity = '1';
      thumbnailBtn.style.cursor = 'pointer';
      playlistBtn.disabled = true;
      playlistBtn.style.opacity = '0.5';
      playlistBtn.style.cursor = 'not-allowed';
      switchDualModeTab('thumbnail');
    } else if (type === 'playlist') {
      // data가 객체일 수도 있고 문자열(URL)일 수도 있음 (하위호환성)
      const playlistUrl = typeof data === 'object' ? data.url : data;
      document.getElementById('youtubeUrl').value = playlistUrl;
      analyzeUrl();
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function deleteFromUnifiedHistory(type, data) {
    let hist = loadUnifiedHistory();
    hist = hist.filter(h => {
      if (h.type !== type) return true;
      // video는 ID를 비교 (객체든 문자열이든)
      if (type === 'video') {
        const hId = typeof h.data === 'object' ? h.data.videoId : h.data;
        return hId !== data;
      }
      // playlist는 URL을 비교 (객체든 문자열이든)
      if (type === 'playlist') {
        const hUrl = typeof h.data === 'object' ? h.data.url : h.data;
        return hUrl !== data;
      }
      return true;
    });
    try { localStorage.setItem(UNIFIED_HISTORY_KEY, JSON.stringify(hist)); } catch {}
    renderUnifiedHistory();
    // 지운 줄의 버튼이 사라졌으므로 키보드 포커스를 목록의 다음 지우기 버튼(없으면 '전체 삭제')으로
    const btns = document.querySelectorAll('#historyList .btn-del-h');
    (btns[0] || document.querySelector('.btn-clear-h')).focus();
    VUI.toast('기록을 지웠어요', 1800);
  }

  async function clearAllHistory() {
    const prev = loadUnifiedHistory();
    if (!prev.length) return;
    const ok = await VUI.confirm('최근 기록을 모두 지울까요?', { title: '기록 모두 지우기', ok: '모두 지우기', danger: true });
    if (!ok) return;
    try { localStorage.removeItem(UNIFIED_HISTORY_KEY); } catch {}
    renderUnifiedHistory();
    VUI.toast('최근 기록을 지웠어요.', { action: { label: '되돌리기', onClick: () => {
      try { localStorage.setItem(UNIFIED_HISTORY_KEY, JSON.stringify(prev)); } catch {}
      renderUnifiedHistory();
    } } });
  }

  /* ───────────────────────── 플레이리스트 ───────────────────────── */
  const PL_REGEX = /[?&]list=([A-Za-z0-9_-]+)/;
  const API_KEY_STORAGE = 'yt_api_key_custom';

  let plItems = [];       // 전체 영상 목록
  let plTitle = '';       // 플레이리스트 제목
  let plUrl = '';         // 원본 URL

  async function fetchPlaylist() {
    const url = document.getElementById('youtubeUrl').value.trim();
    if (!url) { showPlError('유튜브 주소를 입력해 주세요.'); return; }

    const match = url.match(PL_REGEX);
    if (!match) { showPlError('재생목록 주소가 아니에요. 주소를 다시 확인해 주세요.'); return; }

    const playlistId = match[1];
    plUrl = url;
    plItems = [];
    plTitle = '';

    const plFetchBtn = document.getElementById('plFetchBtn');
    if (plFetchBtn) plFetchBtn.disabled = true;
    showPlLoading('재생목록 불러오는 중…');
    document.getElementById('plApiKeyBtn').style.display = 'none';

    try {
      let pageToken = null;
      let isFirst = true;
      let totalFetched = 0;
      let usingCustomKey = false;

      // 먼저 Netlify Function으로 시도
      let useCustomKey = false;
      do {
        const body = { playlistId };
        if (pageToken) body.pageToken = pageToken;

        let res, data;

        if (useCustomKey) {
          // 사용자 정의 API 키 사용
          const customKey = localStorage.getItem(API_KEY_STORAGE);
          if (!customKey) { showApiKeyNeeded('재생목록을 불러오려면 YouTube API 키가 필요해요. 아래 ‘API 키 설정’ 버튼을 눌러 주세요.'); return; }
          try {
            res = await fetchWithCustomKey(playlistId, pageToken, customKey);
          } catch (e) {
            if (e && e.keyError) { showApiKeyNeeded(e.message); return; }
            throw e;
          }
          data = res;
          usingCustomKey = true;
        } else {
          // 서버 함수(/api/yt-playlist) — VUI.apiFetch: 시간 제한·한국어 오류. 실패해도 상태·본문을 보고 분기
          try {
            data = await VUI.apiFetch('/api/yt-playlist', { json: body, timeout: 30000 });
            res = { ok: true, status: 200 };
          } catch (e) {
            if (!e.status) { showPlError(e.message); return; }   // 오프라인·시간 초과 등
            data = e.data || { error: e.message };
            if (typeof data.error !== 'string' || !/[가-힣]/.test(data.error)) data = Object.assign({}, data, { error: e.message, rawError: data.error });
            res = { ok: false, status: e.status };
          }
        }

        // 서버 함수 실패(리퍼러 제한) 시 API 키 설정 안내
        const refErr = String((data && (data.rawError || data.error)) || '');
        if (!useCustomKey && (res?.status === 403 || res?.status === 400) && refErr.includes('referer')) {
          const saved = localStorage.getItem(API_KEY_STORAGE);
          if (saved) {
            useCustomKey = true;
            continue;
          } else {
            showApiKeyNeeded('재생목록을 불러오려면 YouTube API 키가 필요해요. 아래 ‘API 키 설정’ 버튼을 눌러 주세요.');
            return;
          }
        }

        if (!useCustomKey && !res?.ok) {
          showPlError(data?.error ?? '재생목록을 불러오지 못했어요.');
          return;
        }

        if (isFirst && data.playlistTitle) plTitle = data.playlistTitle;
        plItems = plItems.concat(data.items ?? []);
        totalFetched = plItems.length;
        pageToken = data.nextPageToken;
        isFirst = false;

        if (pageToken) {
          showPlLoading(`불러오는 중… (${totalFetched}개 받음)`);
        }
      } while (pageToken);

      renderPlaylist();
      // 첫 영상 정보를 포함하여 히스토리에 저장
      const firstVideo = plItems[0];
      const playlistData = {
        url: plUrl,
        title: plTitle,
        firstVideoId: firstVideo?.videoId,
        firstVideoTitle: firstVideo?.title
      };
      saveToUnifiedHistory('playlist', playlistData);
      renderUnifiedHistory();
    } catch (e) {
      showPlError('재생목록을 불러오지 못했어요. 인터넷 연결을 확인하고 다시 해 주세요.');
    } finally {
      if (plFetchBtn) plFetchBtn.disabled = false;
    }
  }

  async function fetchWithCustomKey(playlistId, pageToken, apiKey) {
    const BASE = 'https://www.googleapis.com/youtube/v3';

    // Google API 오류(키 틀림·사용 설정 안 됨·한도 초과)를 알아보고 한국어로 알린다.
    // (예전에는 오류여도 빈 목록으로 처리돼 '영상이 없는 재생목록'으로 잘못 안내했다)
    const checkApiError = (res, data) => {
      const err = data && data.error;
      if (res.ok && !err) return;
      const reasons = ((err && err.errors) || []).map(x => x.reason).concat(
        ((err && err.details) || []).map(x => x.reason)).join(' ');
      const msg = String((err && err.message) || '');
      let text, keyError = false;
      if (/keyInvalid|API_KEY_INVALID|badRequest/i.test(reasons) || /API key not valid/i.test(msg)) {
        text = 'API 키가 맞지 않아요. 키를 다시 복사해 ‘API 키 설정’에 넣어 주세요.'; keyError = true;
      } else if (/accessNotConfigured|SERVICE_DISABLED/i.test(reasons) || /has not been used|is disabled/i.test(msg)) {
        text = '이 API 키에서 YouTube Data API v3가 꺼져 있어요. Google Cloud Console에서 사용 설정해 주세요.'; keyError = true;
      } else if (/quotaExceeded|dailyLimitExceeded|rateLimitExceeded/i.test(reasons)) {
        text = '오늘 쓸 수 있는 API 사용량을 다 썼어요. 내일 다시 하거나 다른 키를 넣어 주세요.'; keyError = true;
      } else if (/ipRefererBlocked|API_KEY_HTTP_REFERRER_BLOCKED|forbidden/i.test(reasons) || res.status === 403) {
        text = '이 API 키는 이 사이트에서 쓸 수 없게 막혀 있어요. 키의 웹사이트 제한을 확인해 주세요.'; keyError = true;
      } else if (/playlistNotFound/i.test(reasons) || res.status === 404) {
        text = '재생목록을 찾지 못했어요. 비공개 재생목록이거나 주소가 틀렸을 수 있어요.';
      } else {
        text = `재생목록을 불러오지 못했어요(오류 ${res.status}).`;
      }
      throw Object.assign(new Error(text), { keyError });
    };

    let playlistTitle = null;
    if (!pageToken) {
      const plRes = await fetch(
        `${BASE}/playlists?part=snippet&id=${encodeURIComponent(playlistId)}&key=${encodeURIComponent(apiKey)}`
      );
      const plData = await plRes.json().catch(() => ({}));
      checkApiError(plRes, plData);
      playlistTitle = plData.items?.[0]?.snippet?.title ?? '재생목록';
    }

    let itemsUrl = `${BASE}/playlistItems?part=snippet&playlistId=${encodeURIComponent(playlistId)}&maxResults=50&key=${encodeURIComponent(apiKey)}`;
    if (pageToken) itemsUrl += `&pageToken=${encodeURIComponent(pageToken)}`;

    const itemsRes = await fetch(itemsUrl);
    const itemsData = await itemsRes.json().catch(() => ({}));
    checkApiError(itemsRes, itemsData);

    return {
      playlistTitle,
      items: (itemsData.items ?? [])
        .filter(it => it.snippet?.resourceId?.videoId)
        .map(it => ({
          videoId: it.snippet.resourceId.videoId,
          title: it.snippet.title ?? '',
          description: it.snippet.description ?? '',
          thumbnailUrl: it.snippet.thumbnails?.high?.url ??
            it.snippet.thumbnails?.medium?.url ??
            `https://img.youtube.com/vi/${it.snippet.resourceId.videoId}/hqdefault.jpg`,
        })),
      nextPageToken: itemsData.nextPageToken ?? null,
    };
  }

  // 키가 필요하거나 틀렸을 때: 이유를 보여 주고 'API 키 설정' 버튼을 꺼낸다
  function showApiKeyNeeded(msg) {
    showPlError(msg);
    const b = document.getElementById('plApiKeyBtn');
    b.style.display = 'inline-flex';
    b.focus();
  }

  async function showApiKeyModal() {
    let saved = '';
    try { saved = localStorage.getItem(API_KEY_STORAGE) || ''; } catch {}
    const key = await VUI.prompt(
      'YouTube API 키 만드는 방법\n' +
      '① console.cloud.google.com에 로그인해 프로젝트를 하나 만듭니다.\n' +
      '② ‘API 및 서비스 → 라이브러리’에서 YouTube Data API v3를 찾아 ‘사용’을 누릅니다.\n' +
      '③ ‘사용자 인증 정보 → 사용자 인증 정보 만들기 → API 키’로 키를 만들어 아래에 붙여넣습니다.\n' +
      '키는 이 브라우저에만 저장돼요. 비우고 저장하면 지워집니다.',
      { title: 'API 키 설정', value: saved, placeholder: 'AIza…로 시작하는 키', ok: '저장하고 다시 불러오기' });
    if (key === null) return;
    const k = key.trim();
    try {
      if (k) localStorage.setItem(API_KEY_STORAGE, k);
      else localStorage.removeItem(API_KEY_STORAGE);
    } catch {}
    if (!k) { VUI.toast('API 키를 지웠어요.'); return; }
    VUI.toast('API 키를 저장했어요. 재생목록을 다시 불러올게요.');
    fetchPlaylist();
  }

  function renderPlaylist() {
    if (!plItems.length) {
      showPlError('이 재생목록에는 볼 수 있는 영상이 없어요.');
      return;
    }

    const container = document.getElementById('plResult');
    container.innerHTML = `
      <div class="pl-header">
        <div class="pl-title">${escHtml(plTitle)}</div>
        <div class="pl-meta">영상 ${plItems.length}개</div>
      </div>
      <div class="pl-actions">
        <button type="button" class="hero-btn" id="zipBtn" onclick="downloadZip()">${VUI.icon('download')} 썸네일 모두 받기(ZIP)</button>
        <button type="button" class="hero-btn hero-btn-ghost" onclick="openInMdEditor()">${VUI.icon('file-text')} 문서로 정리하기</button>
      </div>
      <div class="pl-list">
        ${plItems.map((item, i) => `
          <div class="pl-item">
            <div class="pl-num">${String(i + 1).padStart(2, '0')}</div>
            <img class="pl-thumb"
                 src="/api/yt-thumb-img?id=${item.videoId}&q=mq"
                 onerror="this.src='https://img.youtube.com/vi/${item.videoId}/mqdefault.jpg'"
                 alt="">
            <div class="pl-info">
              <div class="pl-vtitle">${escHtml(item.title)}</div>
              ${item.description ? `<div class="pl-vdesc">${escHtml(item.description)}</div>` : ''}
              <a class="pl-vlink" href="https://youtu.be/${item.videoId}" target="_blank" rel="noopener">youtu.be/${item.videoId}</a>
            </div>
          </div>
        `).join('')}
      </div>
    `;
  }

  function openInMdEditor() {
    const md = buildMarkdown();
    const payload = JSON.stringify({
      data: { content: md, filename: `${plTitle || 'playlist'}.md` },
      permission: 'clone',
    });
    const encoded = btoa(encodeURIComponent(payload))
      .replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
    window.open(`/apps/md-editor/#share=${encoded}`, '_blank');
  }

  // JSZip은 ZIP 받기를 누를 때만 불러온다(file-tools와 같은 주소·버전)
  let jszipPromise = null;
  function loadJSZip() {
    if (window.JSZip) return Promise.resolve(window.JSZip);
    if (!jszipPromise) {
      jszipPromise = new Promise((res, rej) => {
        const s = document.createElement('script');
        s.src = 'https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js';
        s.onload = () => window.JSZip ? res(window.JSZip) : rej(new Error('JSZip'));
        s.onerror = () => { jszipPromise = null; rej(new Error('JSZip')); };
        document.head.appendChild(s);
      });
    }
    return jszipPromise;
  }

  async function downloadZip() {
    const btn = document.getElementById('zipBtn');
    btn.disabled = true;
    try { await loadJSZip(); } catch {
      btn.disabled = false;
      VUI.alert('압축 도구를 불러오지 못했어요. 인터넷 연결을 확인하고 새로고침해 주세요.', { title: 'ZIP을 만들 수 없어요' });
      return;
    }

    const zip = new JSZip();
    const folder = zip.folder(sanitizeFilename(plTitle || 'playlist'));

    // MD 파일 포함
    folder.file('playlist.md', buildMarkdown());

    // 썸네일 이미지 다운로드
    const progress = document.createElement('div');
    progress.className = 'progress-wrap';
    progress.innerHTML = `
      <div id="zipProgressText" role="status" aria-live="polite">썸네일 받는 중 (0 / ${plItems.length})</div>
      <div class="progress-bar-bg">
        <div class="progress-bar-fill" id="zipProgressBar" style="width:0%"></div>
      </div>
    `;
    document.getElementById('plResult').appendChild(progress);

    let done = 0, saved = 0;
    try {
      // 동시 요청은 6개로 제한(긴 재생목록에서 한꺼번에 수백 개 요청하지 않도록)
      let next = 0;
      const worker = async () => {
        while (next < plItems.length) {
          const i = next++;
          const item = plItems[i];
          try {
            const res = await fetch(`/api/yt-thumb-img?id=${encodeURIComponent(item.videoId)}&q=hq`);
            if (res.ok) {
              const blob = await res.blob();
              const num = String(i + 1).padStart(2, '0');
              folder.file(`${num}_${item.videoId}.jpg`, blob);
              saved++;
            }
          } catch { /* 개별 실패는 개수로만 집계 */ }
          done++;
          const pct = Math.round((done / plItems.length) * 100);
          const el = document.getElementById('zipProgressText');
          const bar = document.getElementById('zipProgressBar');
          if (el) el.textContent = `썸네일 받는 중 (${done} / ${plItems.length})`;
          if (bar) bar.style.width = `${pct}%`;
        }
      };
      await Promise.all(Array.from({ length: Math.min(6, plItems.length) }, worker));

      // 한 장도 받지 못했으면 빈 ZIP을 내려받지 않고 오류 안내
      if (saved === 0) {
        VUI.toast('썸네일을 한 장도 받지 못했어요. 잠시 뒤 다시 해 주세요.', 'error');
        return;
      }

      const blob = await zip.generateAsync({ type: 'blob' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${sanitizeFilename(plTitle || 'playlist')}.zip`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);

      if (saved < plItems.length) {
        VUI.toast(`썸네일 ${plItems.length}장 중 ${saved}장만 받았어요. 나머지 ${plItems.length - saved}장은 ZIP에 빠져 있어요.`, 'error');
      } else {
        VUI.toast(`썸네일 ${saved}장을 ZIP으로 저장했어요.`);
      }
    } catch {
      VUI.toast('ZIP 파일을 만들지 못했어요. 다시 해 주세요.', 'error');
    } finally {
      progress.remove();
      btn.disabled = false;
    }
  }

  function buildMarkdown() {
    const lines = [
      `# ${plTitle || '재생목록'}`,
      `> 영상 ${plItems.length}개 | [재생목록 열기](${plUrl})`,
      '',
      '---',
      '',
    ];

    plItems.forEach((item, i) => {
      lines.push(`## ${i + 1}. ${item.title}`);
      lines.push('');
      lines.push(`[![thumbnail](https://img.youtube.com/vi/${item.videoId}/hqdefault.jpg)](https://youtu.be/${item.videoId})`);
      lines.push('');
      if (item.description && item.description.trim()) {
        lines.push(item.description.trim());
        lines.push('');
      }
      lines.push('---');
      lines.push('');
    });

    return lines.join('\n');
  }

  function showPlLoading(msg) {
    document.getElementById('plResult').innerHTML = `
      <div class="loading-box" role="status">
        <div class="spinner" aria-hidden="true"></div>
        <span>${escHtml(String(msg))}</span>
      </div>
    `;
  }

  function showPlError(msg) {
    document.getElementById('plResult').innerHTML = `<div class="error-box" role="alert">${escHtml(String(msg))}</div>`;
  }

  /* ───────────────────────── 유틸 ───────────────────────── */
  function escHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function sanitizeFilename(name) {
    return name.replace(/[\\/:*?"<>|]/g, '_').trim().slice(0, 60) || 'playlist';
  }
</script>



</AppLayout>
