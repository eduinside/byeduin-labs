---
import AppLayout from '../../../layouts/AppLayout.astro';
import Icon from '../../../components/Icon.astro';

const DESC = "대구광역시교육청이 학교에 보낸 업무 매뉴얼·지침을 AI에게 묻고, 답변과 근거 문서(쪽)를 함께 확인해요. AI 답변은 틀릴 수 있으니 원문으로 확인하세요.";
---
<AppLayout 
  sync
  title="에듀서치 — eduin VIVES"
  description={DESC}
  image="https://eduin.info/og-images/search.png"
  bodyShell="sidebar"
>
  <Fragment slot="head">
    <script src="https://cdn.jsdelivr.net/npm/marked@15.0.12/marked.min.js" is:inline=""></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@3.4.16/dist/purify.min.js" is:inline=""></script>
  <style is:global="">
    * { box-sizing: border-box; }

    html, body {
      height: 100%;
      margin: 0;
      overflow: hidden;
      font-family: -apple-system, BlinkMacSystemFont, "Pretendard", "Segoe UI", sans-serif;
    }

    /* ── 전체 레이아웃 ── */
    .app-layout {
      display: flex;
      height: 100vh;
      height: 100dvh; /* 모바일 주소창 높이를 빼고 — 입력창이 주소창 밑으로 밀리지 않게 */
      background: var(--bg);
      overflow: hidden;
    }

    /* ══════════════════════════════════════
       사이드바
    ══════════════════════════════════════ */
    .app-sidebar {
      width: 260px;
      min-width: 220px;
      height: 100%;
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      background: var(--bg);
      background-color: rgba(0, 0, 0, 0.02);
      flex-shrink: 0;
      position: relative;
    }

    /* 다크: 화면 모드 버튼(data-theme)을 따른다 — OS 설정(prefers-color-scheme)이 아니라 */
    @media all {
      [data-theme="dark"] .app-sidebar {
        background-color: rgba(255, 255, 255, 0.02);
      }
    }

    /* 좌상단 오버레이(Home 버튼) 영역 확보 */
    .sidebar-top-pad { height: 56px; flex-shrink: 0; position: relative; }

    /* 사이드바 헤더: 에듀서치 + 새 대화 */
    .sidebar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      flex-shrink: 0;
      gap: 8px;
    }

    .sidebar-brand {
      position: static;
      padding: 0;
      font-size: 16px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--fg);
      opacity: 1;
      z-index: 10;
      flex: 1;
    }

    .new-chat-btn-icon {
      width: 40px;
      height: 40px;
      min-width: 40px;
      border-radius: 8px;
      border: 1.5px solid var(--primary);
      background: rgba(0, 111, 238, 0.1);
      color: var(--primary);
      cursor: pointer;
      font-family: inherit;
      transition: all 0.15s;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      flex-shrink: 0;
    }
    .new-chat-btn-icon:hover {
      background: rgba(0, 111, 238, 0.15);
      border-color: var(--primary);
      color: var(--primary);
    }

    .new-chat-btn {
      margin: 0 10px 10px;
      padding: 9px 14px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: none;
      font-size: 13px;
      font-weight: 600;
      color: var(--fg-muted);
      cursor: pointer;
      text-align: left;
      font-family: inherit;
      transition: all 0.15s;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .new-chat-btn:hover {
      background: var(--card-bg);
      border-color: var(--primary);
      color: var(--primary);
    }

    /* 사이드바 탭 */
    .sidebar-tabs {
      display: flex;
      gap: 8px;
      padding: 8px 10px;
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
    }

    .sidebar-tab {
      flex: 1;
      padding: 6px 8px;
      background: rgba(0, 0, 0, 0.04);
      border: 1px solid var(--border);
      border-radius: 6px;
      font-size: 11px;
      cursor: pointer;
      color: var(--fg-muted);
      font-family: inherit;
      font-weight: 600;
      transition: all 0.12s;
    }

    .sidebar-tab.active {
      background: rgba(0, 0, 0, 0.08);
      border-color: var(--border);
      color: var(--fg);
    }

    .sidebar-tab:hover {
      background: rgba(0, 0, 0, 0.06);
      border-color: var(--border);
    }

    /* 다크: 화면 모드 버튼(data-theme)을 따른다 — OS 설정(prefers-color-scheme)이 아니라 */
    @media all {
      [data-theme="dark"] .sidebar-tab {
        background: rgba(255, 255, 255, 0.04);
      }

      [data-theme="dark"] .sidebar-tab.active {
        background: rgba(255, 255, 255, 0.1);
        color: var(--fg);
      }

      [data-theme="dark"] .sidebar-tab:hover {
        background: rgba(255, 255, 255, 0.07);
      }
    }

    .sidebar-tab-content {
      display: none;
    }

    .sidebar-tab-content.active {
      display: block;
    }

    .sidebar-scrollable {
      flex: 1;
      overflow-y: auto;
      padding-bottom: 16px;
    }

    .sidebar-section-label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 16px 4px;
      font-size: 10px;
      font-weight: 700;
      color: var(--fg-muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .sidebar-label-btn {
      font-size: 10px;
      color: var(--fg-muted);
      background: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      padding: 2px 6px;
      border-radius: 4px;
      transition: color 0.12s;
    }
    .sidebar-label-btn:hover { color: var(--danger); }
    .sidebar-label-btn.refresh:hover { color: var(--primary); }
    .sidebar-label-btn:disabled { opacity: 0.5; cursor: default; }

    /* 대화 목록 */
    .conv-item {
      padding: 7px 14px;
      font-size: 12px;
      color: var(--fg);
      cursor: pointer;
      border-radius: 8px;
      margin: 1px 8px;
      transition: background 0.12s;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.5;
    }
    .conv-item:hover { background: var(--card-bg); }
    .conv-item.active {
      background: rgba(0,111,238,0.1);
      color: var(--primary);
      font-weight: 600;
    }
    .conv-item-empty {
      padding: 8px 16px;
      font-size: 11px;
      color: var(--fg-muted);
      font-style: italic;
    }

    .sidebar-divider {
      height: 1px;
      background: var(--border);
      margin: 10px 12px;
    }

    /* 문서 트리 */
    .tree-category { margin-bottom: 2px; }
    .tree-cat-header {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 700;
      color: var(--fg-muted);
      border-radius: 6px;
      margin: 0 6px;
      transition: background 0.12s;
      user-select: none;
    }
    .tree-cat-header:hover { background: var(--card-bg); }
    .tree-cat-header .arrow {
      font-size: 9px;
      transition: transform 0.15s;
      display: inline-block;
    }
    .tree-cat-header.open .arrow { transform: rotate(90deg); }

    .tree-files { display: none; }
    .tree-files.open { display: block; }

    .tree-file {
      display: flex;
      align-items: flex-start;   /* 멀티라인 시 아이콘을 첫 줄에 정렬 */
      gap: 6px;
      padding: 5px 14px 5px 22px;
      font-size: 12px;
      line-height: 1.45;
      cursor: pointer;
      color: var(--fg);
      border-radius: 6px;
      margin: 1px 6px;
      transition: background 0.12s;
      white-space: normal;       /* 줄바꿈 허용 → 전체 이름 표시 */
      overflow-wrap: anywhere;
      word-break: break-word;
    }
    .tree-file:hover { background: var(--card-bg); }
    .tree-file.active {
      background: rgba(0,111,238,0.1);
      color: var(--primary);
      font-weight: 600;
    }

    .tree-loading {
      padding: 16px;
      text-align: center;
    }
    .tree-loading::after {
      content: '';
      display: inline-block;
      width: 14px;
      height: 14px;
      border: 2px solid var(--border);
      border-top-color: var(--primary);
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
    }
    .tree-empty {
      padding: 12px 16px;
      font-size: 11px;
      color: var(--fg-muted);
      text-align: center;
      line-height: 1.6;
    }

    /* ══════════════════════════════════════
       메인 영역
    ══════════════════════════════════════ */
    .app-main {
      flex: 1;
      height: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      position: relative;
    }

    .main-view {
      display: none;
      flex-direction: column;
      height: 100%;
      overflow: hidden;
    }
    .main-view.active { display: flex; }

    /* ── 환영 화면 ── */
    .welcome-wrap {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 60px 40px 40px;
      overflow-y: auto;
      background-image:
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 39px,
          rgba(0, 0, 0, 0.03) 39px,
          rgba(0, 0, 0, 0.03) 40px
        ),
        repeating-linear-gradient(
          90deg,
          transparent,
          transparent 39px,
          rgba(0, 0, 0, 0.03) 39px,
          rgba(0, 0, 0, 0.03) 40px
        );
      background-size: 40px 40px;
      background-position: 0 0, 0 0;
    }

    /* 다크: 화면 모드 버튼(data-theme)을 따른다 — OS 설정(prefers-color-scheme)이 아니라 */
    @media all {
      [data-theme="dark"] .welcome-wrap {
        background-image:
          repeating-linear-gradient(
            0deg,
            transparent,
            transparent 39px,
            rgba(255, 255, 255, 0.03) 39px,
            rgba(255, 255, 255, 0.03) 40px
          ),
          repeating-linear-gradient(
            90deg,
            transparent,
            transparent 39px,
            rgba(255, 255, 255, 0.03) 39px,
            rgba(255, 255, 255, 0.03) 40px
          );
      }
    }

    .welcome-icon { font-size: 52px; margin-bottom: 16px; }

    .welcome-title {
      font-size: 26px;
      font-weight: 800;
      color: var(--fg);
      margin: 0 0 8px;
      letter-spacing: -0.02em;
      text-align: center;
    }

    .welcome-desc {
      font-size: 14px;
      color: var(--fg-muted);
      text-align: center;
      line-height: 1.7;
      margin: 0 0 32px;
      max-width: 460px;
    }

    .welcome-input-box {
      width: 100%;
      max-width: 600px;
      display: flex;
      gap: 8px;
      margin-bottom: 20px;
    }
    .welcome-input {
      flex: 1;
      padding: 13px 18px;
      border-radius: 14px;
      border: 2px solid var(--border);
      background: var(--card-bg);
      font-size: 15px;
      color: var(--fg);
      font-family: inherit;
      outline: none;
      transition: border-color 0.15s;
    }
    .welcome-input:focus { border-color: var(--primary); }
    .welcome-input::placeholder { color: var(--fg-muted); }

    .welcome-submit {
      padding: 13px 24px;
      border-radius: 14px;
      border: none;
      background: var(--primary);
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.15s;
      white-space: nowrap;
    }
    .welcome-submit:hover { background: var(--primary-h); }

    .welcome-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
      max-width: 600px;
    }
    .welcome-chip {
      padding: 7px 14px;
      border-radius: 20px;
      border: 1px solid var(--border);
      background: var(--card-bg);
      font-size: 12px;
      color: var(--fg-muted);
      cursor: pointer;
      font-family: inherit;
      transition: all 0.12s;
    }
    .welcome-chip:hover { border-color: var(--primary); color: var(--primary); }

    /* 최근 문서 */
    .recent-docs-wrap {
      width: 100%;
      max-width: 600px;
      margin-top: 24px;
    }
    .recent-docs-label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11px;
      font-weight: 700;
      color: var(--fg-muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 8px;
    }
    .recent-doc-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--card-bg);
      margin-bottom: 6px;
      cursor: pointer;
      transition: border-color 0.15s, background 0.15s;
    }
    .recent-doc-item:hover { border-color: var(--primary); background: rgba(0,111,238,0.04); }
    .recent-doc-icon { font-size: 14px; flex-shrink: 0; }
    .recent-doc-info { flex: 1; min-width: 0; }
    .recent-doc-name {
      font-size: 13px;
      font-weight: 600;
      color: var(--fg);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .recent-doc-meta {
      font-size: 11px;
      color: var(--fg-muted);
      margin-top: 1px;
    }

    /* ── 채팅 화면 ── */
    .chat-filter-bar {
      flex-shrink: 0;
      padding: 16px 24px;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      border-bottom: 1px solid var(--border);
      align-items: center;
      height: 58px;
    }

    .chat-messages {
      flex: 1;
      overflow-y: auto;
      padding: 20px 32px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      min-height: 0; /* flexbox에서 overflow 작동 위해 필수 */
      background-image:
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 39px,
          rgba(0, 0, 0, 0.03) 39px,
          rgba(0, 0, 0, 0.03) 40px
        ),
        repeating-linear-gradient(
          90deg,
          transparent,
          transparent 39px,
          rgba(0, 0, 0, 0.03) 39px,
          rgba(0, 0, 0, 0.03) 40px
        );
      background-size: 40px 40px;
      background-position: 0 0, 0 0;
    }

    /* 다크: 화면 모드 버튼(data-theme)을 따른다 — OS 설정(prefers-color-scheme)이 아니라 */
    @media all {
      [data-theme="dark"] .chat-messages {
        background-image:
          repeating-linear-gradient(
            0deg,
            transparent,
            transparent 39px,
            rgba(255, 255, 255, 0.03) 39px,
            rgba(255, 255, 255, 0.03) 40px
          ),
          repeating-linear-gradient(
            90deg,
            transparent,
            transparent 39px,
            rgba(255, 255, 255, 0.03) 39px,
            rgba(255, 255, 255, 0.03) 40px
          );
      }
    }

    /* 채팅 메시지 */
    .chat-turn { display: flex; flex-direction: column; gap: 8px; }

    .chat-user {
      align-self: flex-end;
      background: var(--primary);
      color: #fff;
      border-radius: 16px 16px 4px 16px;
      padding: 10px 15px;
      font-size: 14px;
      max-width: 75%;
      line-height: 1.5;
    }

    .chat-ai { align-self: flex-start; max-width: 90%; }
    .chat-ai-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 4px 16px 16px 16px;
      padding: 14px 16px;
    }
    .chat-ai-body { font-size: 13px; line-height: 1.8; color: var(--fg); }
    .chat-ai-body h1, .chat-ai-body h2, .chat-ai-body h3 { font-weight: 700; margin: 0.8em 0 0.3em; font-size: 1.05em; }
    .chat-ai-body p { margin: 0.4em 0; }
    .chat-ai-body ul, .chat-ai-body ol { padding-left: 1.4em; margin: 0.4em 0; }
    .chat-ai-body li { margin: 0.2em 0; }
    .chat-ai-body strong { font-weight: 700; }
    .chat-ai-body code { background: rgba(0,111,238,0.08); padding: 1px 5px; border-radius: 4px; font-size: 0.87em; }
    .chat-ai-body table { border-collapse: collapse; width: 100%; margin: 0.8em 0; font-size: 12px; }
    .chat-ai-body th, .chat-ai-body td { border: 1px solid var(--border); padding: 5px 8px; }
    .chat-ai-body th { background: rgba(0,0,0,0.04); font-weight: 700; }

    .chat-sources {
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px solid var(--border);
      font-size: 11px;
      color: var(--fg-muted);
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 8px;
    }
    .chat-sources-label {
      font-weight: 700;
      width: 100%;
      margin-bottom: 4px;
    }
    .source-chip {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 12px;
      background: var(--primary);
      color: #fff;
      font-size: 11px;
      font-weight: 600;
      margin: 0;
      transition: all 0.15s;
      cursor: pointer;
      border: 1px solid var(--primary);
      text-decoration: none;
      user-select: none;
    }
    .source-chip:hover {
      background: var(--primary-h);
      border-color: var(--primary-h);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(0, 111, 238, 0.35);
      text-decoration: underline;
    }
    .source-chip:active {
      transform: translateY(0);
    }

    .chat-actions {
      display: flex;
      gap: 6px;
      margin-top: 8px;
      flex-wrap: wrap;
    }
    .chat-action-btn {
      padding: 5px 10px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: none;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      color: var(--fg-muted);
      font-family: inherit;
      transition: all 0.12s;
    }
    .chat-action-btn:hover { border-color: var(--primary); color: var(--primary); }

    /* 로딩 점 */
    .chat-thinking {
      align-self: flex-start;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 14px;
      border-radius: 12px;
      background: var(--card-bg);
      border: 1px solid var(--border);
      font-size: 12px;
      color: var(--fg-muted);
    }
    .thinking-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--primary);
      opacity: 0.4;
      animation: pulse 1.2s ease-in-out infinite;
    }
    .thinking-dot:nth-child(2) { animation-delay: 0.2s; }
    .thinking-dot:nth-child(3) { animation-delay: 0.4s; }

    /* 채팅 입력창 */
    .chat-input-bar {
      flex-shrink: 0;
      padding: 12px 20px 16px;
      border-top: 1px solid var(--border);
      background: var(--bg);
      display: flex;
      gap: 8px;
      align-items: center;
    }
    .chat-input-bar input {
      flex: 1;
      padding: 11px 16px;
      border-radius: 12px;
      border: 1.5px solid var(--border);
      background: var(--card-bg);
      font-size: 14px;
      color: var(--fg);
      font-family: inherit;
      outline: none;
      transition: border-color 0.15s;
    }
    .chat-input-bar input:focus { border-color: var(--primary); }
    .chat-input-bar input::placeholder { color: var(--fg-muted); }
    .chat-send-btn {
      padding: 11px 20px;
      border-radius: 12px;
      border: none;
      background: var(--primary);
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.15s;
      white-space: nowrap;
    }
    .chat-send-btn:hover { background: var(--primary-h); }
    .chat-send-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    /* ── 문서 화면 ── */
    .doc-header {
      flex-shrink: 0;
      padding: 74px 28px 14px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 12px;
      background: var(--bg);
      position: relative;
      z-index: 10;
    }
    .doc-meta { flex: 1; min-width: 0; }
    .doc-filename {
      font-size: 15px;
      font-weight: 700;
      color: var(--fg);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .doc-path { font-size: 11px; color: var(--fg-muted); }
    .doc-action-btn {
      padding: 6px 14px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: none;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      color: var(--fg-muted);
      font-family: inherit;
      transition: all 0.12s;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .doc-action-btn:hover { border-color: var(--primary); color: var(--primary); }

    /* 문서 뷰 */
    .doc-view {
      flex-direction: column;
    }
