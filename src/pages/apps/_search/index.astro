          <div class="question-modal-footer">
            <button type="button" class="question-btn-cancel" onclick="closeQuestionModal()">취소</button>
            <button type="button" class="question-btn-submit" id="questionSubmitBtn" onclick="submitQuestion()">질문하기</button>
          </div>
        </div>
      </div>

    </main>
  </div>

  <script is:inline="">
    /* ─────────────────────────────────────────
       설정
    ───────────────────────────────────────── */
    // 문서는 D1에 적재된 교육청 매뉴얼(scripts/manual-ingest.mjs) — /api/manual 목록·본문, /api/search 질의응답
    const MANUAL_API   = '/api/manual';
    const LS_HISTORY   = 'edu-search-history';
    let manualDocs     = [];   // [{ id, title, category, dept, year, fileType, pages, updatedAt }]
    const docTitle = id => manualDocs.find(d => d.id === id)?.title || id;

    let currentChatTitle = '새 대화';

    // 현재 대화의 멀티턴 맥락 버퍼 (서버에 history로 전달 → 후속 질문 해석용)
    // { role: 'user' | 'ai', content: string }
    let activeMessages = [];

    /* ─────────────────────────────────────────
       대화 제목 관리
    ───────────────────────────────────────── */
    function updateChatTitle(query) {
      // 첫 검색어를 기반으로 제목 생성 (최대 20자, 말줄임표 제거)
      let title = query.trim().substring(0, 20);
      currentChatTitle = title || '새 대화';
      document.getElementById('chatTitleText').textContent = currentChatTitle;
    }

    /* ─────────────────────────────────────────
       사이드바 토글 (모바일)
    ───────────────────────────────────────── */
    // @icons menu x refresh-cw paperclip file-text download circle-help
    // @icons wallet shield stethoscope book users folder chevron-right
    const ic = (n) => VUI.icon(n);
    const isDrawerMode = () => window.matchMedia('(max-width: 640px)').matches;
    function setSidebar(open) {
      const sidebar = document.querySelector('.app-sidebar');
      sidebar.classList.toggle('sidebar-open', open);
      const btn = document.getElementById('sidebarToggleBtn');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.innerHTML = ic(open ? 'x' : 'menu');
      btn.setAttribute('aria-label', open ? '최근 질문·문서 목록 닫기' : '최근 질문·문서 목록 열기');
      document.getElementById('drawerBackdrop').hidden = !open;
    }
    function toggleSidebar() {
      setSidebar(!document.querySelector('.app-sidebar').classList.contains('sidebar-open'));
    }
    function closeSidebar() {
      if (document.querySelector('.app-sidebar').classList.contains('sidebar-open')) setSidebar(false);
    }
    // 모바일 드로어: 항목(질문·문서·새 대화)을 고르거나 Esc를 누르면 닫힘
    document.querySelector('.app-sidebar').addEventListener('click', (e) => {
      if (!isDrawerMode()) return;
      if (e.target.closest('.conv-item, .tree-file, .new-chat-btn-icon')) closeSidebar();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && document.querySelector('.app-sidebar').classList.contains('sidebar-open')
          && !document.getElementById('questionModal').classList.contains('active')) {
        closeSidebar();
        document.getElementById('sidebarToggleBtn').focus();
      }
    });
    window.addEventListener('resize', () => { if (!isDrawerMode()) closeSidebar(); });

    /* ─────────────────────────────────────────
       사이드바 탭 전환
    ───────────────────────────────────────── */
    function switchTab(tabName) {
      // 탭 버튼 상태 업데이트
      document.querySelectorAll('.sidebar-tab').forEach(tab => {
        const on = tab.dataset.tab === tabName;
        tab.classList.toggle('active', on);
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
      });

      // 콘텐츠 표시/숨김
      document.querySelectorAll('.sidebar-tab-content').forEach(content => {
        if (content.id === tabName + '-tab') {
          content.classList.add('active');
        } else {
          content.classList.remove('active');
        }
      });
    }
    // 탭 키보드: ←/→/Home/End로 탭 옮기기(선택된 탭만 Tab 순서에 들어감)
    document.querySelector('.sidebar-tabs').addEventListener('keydown', (e) => {
      const tabs = [...document.querySelectorAll('.sidebar-tab')];
      const i = tabs.indexOf(document.activeElement);
      if (i < 0) return;
      let n = -1;
      if (e.key === 'ArrowRight') n = (i + 1) % tabs.length;
      else if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') n = 0;
      else if (e.key === 'End') n = tabs.length - 1;
      if (n < 0) return;
      e.preventDefault();
      switchTab(tabs[n].dataset.tab);
      tabs[n].focus();
    });

    /* ─────────────────────────────────────────
       문서 질문 모달
    ───────────────────────────────────────── */
    let pendingQuestionData = null;
    // 접근성(포커스 가두기·ESC·포커스 복귀)은 VUI.modal. ESC로 닫히면 대기 중인 질문도 버린다
    const questionM = VUI.modal.bind('#questionModal', {
      className: 'active',
      dialog: '.question-modal-content',
      initialFocus: '#questionInput',
      onClose: () => { pendingQuestionData = null; },
    });

    function showQuestionModal(type = 'question', docPath = '', docContent = '', selection = '') {
      pendingQuestionData = { type, docPath, docContent, selection };
      const modal = document.getElementById('questionModal');
      const title = document.getElementById('questionModalTitle');
      const input = document.getElementById('questionInput');

      if (selection) {
        // 문서에서 드래그한 키워드 — 무엇이 궁금한지 먼저 묻기
        const kw = selection.length > 24 ? selection.slice(0, 24) + '…' : selection;
        title.textContent = `「${kw}」 — 무엇이 궁금하세요?`;
        input.placeholder = '예: 무슨 뜻인가요? / 왜 중요한가요? (비우면 설명)';
      } else if (type === 'summarize') {
        title.textContent = '문서 요약';
        input.placeholder = '추가로 알고 싶은 내용이 있으신가요? (선택)';
      } else {
        title.textContent = '이 문서에 대해 질문';
        input.placeholder = '무엇이 궁금하신가요?';
      }

      // 요약 창에서는 제출 버튼도 "요약하기"
      document.getElementById('questionSubmitBtn').textContent = (type === 'summarize' && !selection) ? '요약하기' : '질문하기';
      input.value = '';
      questionM.open();
    }

    function closeQuestionModal() {
      questionM.close();
      pendingQuestionData = null;
    }

    function submitQuestion() {
      if (!pendingQuestionData) return;

      const input = document.getElementById('questionInput');
      const question = input.value.trim();

      const { type, docPath, docContent, selection } = pendingQuestionData;

      // 일반 문서 질문은 질문 필수. 선택(키워드) 질문은 비워도 됨(설명 기본).
      if (!question && type === 'question' && !selection) {
        input.focus();
        return;
      }

      closeQuestionModal();

      const docName = docTitle(docPath);

      // 채팅 화면으로 전환
      const chatView = document.getElementById('chatView');
      if (!chatView.classList.contains('active')) {
        showView('chat');
      }

      // LLM 전달용 질문 / 화면 표시용 질문 구성
      let llmQuestion, displayQuestion;
      if (selection) {
        // 선택한 키워드를 현재 문서 맥락으로 질문 (서버가 해당 문서를 먼저 읽고 답변)
        llmQuestion = question
          ? `이 문서에서 선택한 부분 "${selection}"에 대한 질문입니다.\n\n질문: ${question}`
          : `이 문서에서 선택한 부분 "${selection}"이(가) 어떤 의미인지, 이 문서 맥락에서 왜 중요한지 설명해 주세요.`;
        const kw = selection.length > 20 ? selection.slice(0, 20) + '…' : selection;
        displayQuestion = question ? `「${kw}」 ${question}` : `「${kw}」 설명`;
        document.getElementById('chatTitleText').textContent = `「${kw}」`;
      } else {
        llmQuestion = question || undefined;
        displayQuestion = question;
        if (type === 'question' && question) {
          document.getElementById('chatTitleText').textContent =
            question.length > 20 ? question.slice(0, 20) : question;
        }
      }

      // 문서 카드 추가
      appendDocumentQueryCard(docName, type, displayQuestion);

      // 로딩 표시
      const thinkingEl = appendThinking();

      // API 요청 (documentPath 기반 → 서버가 해당 문서를 맥락으로 답변)
      sendDocumentRequest(type, docPath, thinkingEl, llmQuestion);
    }

    function appendDocumentQueryCard(docName, type, question) {
      const area = document.getElementById('chatArea');
      const el = document.createElement('div');
      el.className = 'chat-turn';

      const typeLabel = type === 'summarize' ? ic('file-text') + '요약' : ic('circle-help') + '질문';

      el.innerHTML = `
        <div class="chat-document-card">
          <div class="chat-document-card-header">
            <span class="chat-document-card-type">${typeLabel}</span>
            ${escHtml(docName)}
          </div>
          <div class="chat-document-card-content">
            ${question ? escHtml(question) : type === 'summarize' ? '이 문서를 요약해 주세요.' : ''}
          </div>
        </div>
      `;

      area.appendChild(el);
      el.scrollIntoView({ behavior: 'smooth', block: 'end' });
      return el;
    }

    /* ─────────────────────────────────────────
       뷰 전환
    ───────────────────────────────────────── */
    function showView(name) {
      document.querySelectorAll('.main-view').forEach(v => v.classList.remove('active'));
      document.getElementById(name + 'View').classList.add('active');
    }

    /* ─────────────────────────────────────────
       환영 화면
    ───────────────────────────────────────── */
    function startFromWelcome() {
      const q = document.getElementById('welcomeInput').value.trim();
      if (!q) return;
      document.getElementById('searchInput').value = q;
      document.getElementById('welcomeInput').value = '';
      showView('chat');
      doSearch();
    }

    function welcomeChip(btn) {
      document.getElementById('welcomeInput').value = btn.textContent;
      startFromWelcome();
    }

    /* ─────────────────────────────────────────
       새 대화
    ───────────────────────────────────────── */
    function newChat() {
      document.getElementById('chatArea').innerHTML = '';
      document.getElementById('searchInput').value = '';
      activeMessages = [];  // 대화 맥락 초기화
      document.querySelectorAll('.conv-item').forEach(i => { i.classList.remove('active'); i.removeAttribute('aria-current'); });
      showView('welcome');
      setTimeout(() => document.getElementById('welcomeInput')?.focus(), 50);
    }

    /* ─────────────────────────────────────────
       매뉴얼 목록 (D1 → /api/manual)
    ───────────────────────────────────────── */
    async function loadDocs(force = false) {
      try {
        const d = await VUI.apiFetch(force ? `${MANUAL_API}?_=${Date.now()}` : MANUAL_API);
        manualDocs = (d && Array.isArray(d.docs)) ? d.docs : [];
        renderTree();
        renderRecentDocs();
        return true;
      } catch (err) {
        console.error('[search] 문서 목록 로드 실패:', err);
        if (!manualDocs.length) {
          document.getElementById('treePanel').innerHTML = '<div class="tree-empty">문서 목록을 불러오지<br>못했습니다.</div>';
          document.getElementById('recentDocsList').innerHTML = '<div style="padding: 12px 16px; font-size: 12px; color: var(--fg-muted); text-align: center;">문서 목록을 불러올 수 없습니다</div>';
        }
        return false;
      }
    }

    function renderRecentDocs() {
      const list = document.getElementById('recentDocsList');
      const recent = [...manualDocs].sort((a, b) => String(b.updatedAt).localeCompare(String(a.updatedAt))).slice(0, 5);
      if (!recent.length) {
        list.innerHTML = '<div style="padding: 12px 16px; font-size: 12px; color: var(--fg-muted); text-align: center;">등록된 문서가 없습니다</div>';
        return;
      }
      list.innerHTML = recent.map(d => {
        const date = new Date(d.updatedAt);
        const dateStr = `${date.getFullYear()}.${String(date.getMonth()+1).padStart(2,'0')}.${String(date.getDate()).padStart(2,'0')}`;
        return `
          <div class="recent-doc-item" role="button" tabindex="0" data-path="${escHtml(d.id)}" onclick="openFile(this)">
            <span class="recent-doc-icon" aria-hidden="true">${catIcon(d.category)}</span>
            <div class="recent-doc-info">
              <div class="recent-doc-name">${escHtml(d.title)}</div>
              <div class="recent-doc-meta">${escHtml(d.dept || d.category)} · ${dateStr} 등록</div>
            </div>
          </div>`;
      }).join('');
    }

    async function refreshAll(btn) {
      const orig = btn ? btn.innerHTML : '';
      if (btn) { btn.disabled = true; btn.textContent = '새로고침 중…'; }
      try {
        const ok = await loadDocs(true);
        showToast(ok ? '문서 목록을 새로고침했어요' : '새로고침하지 못했어요. 기존 목록을 그대로 둘게요.', ok ? undefined : 'error');
      } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = orig || (ic('refresh-cw') + '새로고침'); }
      }
    }

    // 카테고리 열림 상태 영속화 (리로드·새로고침·탭 전환에도 고정)
    const LS_OPEN_CATS = 'edu-search-open-cats';
    function getOpenCats() {
      const raw = localStorage.getItem(LS_OPEN_CATS);
      if (raw === null) return null;  // 미설정 → 모두 열기
      try { return new Set(JSON.parse(raw)); } catch { return new Set(); }
    }
    function saveOpenCats(set) { try { localStorage.setItem(LS_OPEN_CATS, JSON.stringify([...set])); } catch {} }

    function renderTree() {
      const panel = document.getElementById('treePanel');
      const cats = {};
      manualDocs.forEach(d => (cats[d.category] ||= []).push(d));
      const names = Object.keys(cats);

      if (names.length === 0) {
        panel.innerHTML = '<div class="tree-empty">등록된 문서가 없습니다.</div>';
        return;
      }

      panel.innerHTML = names.map(cat => `
        <div class="tree-category">
          <div class="tree-cat-header" role="button" tabindex="0" aria-expanded="false" data-cat="${escHtml(cat)}" onclick="toggleCatTree(this)">
            <span class="arrow" aria-hidden="true">${ic('chevron-right')}</span>
            <span>${catIcon(cat)}${escHtml(cat)}</span>
            <span style="margin-left:auto;font-size:10px;opacity:.4">${cats[cat].length}</span>
          </div>
          <div class="tree-files">
            ${cats[cat].map(d => `
              <div class="tree-file" role="button" tabindex="0" data-path="${escHtml(d.id)}" onclick="openFile(this)" title="${escHtml(d.title)}">
                <span style="flex-shrink:0;margin-top:1px;color:var(--fg-muted)" aria-hidden="true">${ic('file-text')}</span>
                <span style="flex:1;overflow-wrap:anywhere">${escHtml(d.title)}</span>
              </div>
            `).join('')}
          </div>
        </div>
      `).join('');

      const open = getOpenCats() || new Set(names);
      panel.querySelectorAll('.tree-cat-header').forEach(h => {
        if (open.has(h.dataset.cat)) {
          h.classList.add('open');
          h.setAttribute('aria-expanded', 'true');
          if (h.nextElementSibling) h.nextElementSibling.classList.add('open');
        }
      });
    }

    function catIcon(name) {
      return ic({ '학교회계': 'wallet', '안전': 'shield', '보건': 'stethoscope', '학사': 'book', '인사': 'users' }[name] || 'folder');
    }

    function toggleCatTree(header) {
      header.setAttribute('aria-expanded', header.classList.toggle('open') ? 'true' : 'false');
      const files = header.nextElementSibling;
      if (files) files.classList.toggle('open');
      const open = getOpenCats() || new Set([...document.querySelectorAll('.tree-cat-header')].map(h => h.dataset.cat));
      if (header.classList.contains('open')) open.add(header.dataset.cat);
      else open.delete(header.dataset.cat);
      saveOpenCats(open);
    }

    /* ─────────────────────────────────────────
       문서 열기 (문서 화면) — 적재된 본문을 쪽 표시와 함께 보여 준다
    ───────────────────────────────────────── */
    let currentPath = null;

    // el: 목록 요소 또는 문서 id. page를 주면 해당 쪽 위치로 스크롤
    async function openFile(el, page = null) {
      const id = typeof el === 'string' ? el : el.dataset.path;
      const already = currentPath === id && document.getElementById('docView').classList.contains('active');
      currentPath = id;
      showView('doc');
      if (already) { scrollToPage(page); return; }

      document.querySelectorAll('.tree-file').forEach(f => f.classList.toggle('active', f.dataset.path === id));
      document.getElementById('docTitleText').textContent = docTitle(id);
      document.getElementById('docContent').innerHTML = `
        <div style="text-align:center;padding:40px 0;color:var(--fg-muted)">
          <div style="width:18px;height:18px;border:2px solid var(--border);border-top-color:var(--primary);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 8px"></div>
          불러오는 중...
        </div>`;

      try {
        const d = await VUI.apiFetch(`${MANUAL_API}?doc=${encodeURIComponent(id)}`);
        const doc = d && d.doc, chunks = (d && Array.isArray(d.chunks)) ? d.chunks : null;
        if (!doc || !chunks) throw new Error('문서를 불러오지 못했습니다.');
        if (currentPath !== id) return;  // 그사이 다른 문서를 열었음
        document.getElementById('docTitleText').textContent = doc.title;

        // 쪽이 바뀌는 곳마다 표시(출처 칩의 "N쪽"으로 이동할 수 있게)
        let lastPage = null;
        const html = chunks.map(c => {
          const mark = c.pageFrom && c.pageFrom !== lastPage
            ? `<div class="doc-page-mark" data-page="${escHtml(c.pageFrom)}" style="font-size:11px;color:var(--fg-muted);border-top:1px dashed var(--border);margin:18px 0 8px;padding-top:4px">p.${escHtml(c.pageFrom)}</div>` : '';
          if (c.pageTo) lastPage = c.pageTo;
          return mark + renderMarkdown(c.text);
        }).join('');
        currentDocContent = chunks.map(c => c.text).join('\n\n');
        document.getElementById('docContent').innerHTML =
          `<p style="font-size:12px;color:var(--fg-muted)">${escHtml([doc.dept, doc.pages && `${doc.pages}쪽`].filter(Boolean).join(' · '))} · 원본에서 자동 추출한 본문이라 표·서식이 원문과 다를 수 있습니다.</p>` + html;
        const openBtn = document.getElementById('docOpenBtn');
        openBtn.style.display = doc.hasFile ? '' : 'none';
        openBtn.innerHTML = doc.fileType === 'pdf' ? ic('file-text') + '원문 PDF' : ic('download') + '원문 내려받기';
        openBtn.onclick = () => window.open(`${MANUAL_API}?file=${encodeURIComponent(id)}`, '_blank');
        scrollToPage(page);
      } catch (err) {
        if (currentPath !== id) return;
        const p = document.createElement('p');
        p.style.color = 'var(--fg-muted)';
        p.textContent = '문서를 불러오지 못했습니다. ' + ((err && err.code) ? err.message : '');
        const box = document.getElementById('docContent');
        box.innerHTML = '';
        box.appendChild(p);
      }
    }

    function scrollToPage(page) {
      if (!page) return;
      const marks = [...document.querySelectorAll('.doc-page-mark')];
      const target = marks.filter(m => +m.dataset.page <= page).pop() || marks[0];
      if (target) target.scrollIntoView({ block: 'start' });
    }

    // 문서 본문 텍스트 선택 → "선택 부분에 대해 질문" 팝업
    // 마우스는 mouseup, 터치(길게 눌러 선택·손잡이 조절)는 selectionchange가 끝난 뒤에 띄운다
    function checkDocSelection() {
      const sel = window.getSelection();
      const selected = sel ? sel.toString().trim() : '';
      const body = document.getElementById('docBody');
      if (selected.length > 0 && sel.rangeCount && body.contains(sel.anchorNode)) {
        const rect = sel.getRangeAt(0).getBoundingClientRect();
        showSelectionPopup(rect.left + window.scrollX, rect.bottom + window.scrollY);
      } else {
        hideSelectionPopup();
      }
    }
    document.getElementById('docBody').addEventListener('mouseup', checkDocSelection);
    let selTimer = 0;
    document.addEventListener('selectionchange', () => {
      if (!document.getElementById('docView').classList.contains('active')) return;
      clearTimeout(selTimer);
      selTimer = setTimeout(checkDocSelection, 450);
    });

    /* ─────────────────────────────────────────
       키보드: role="button" 목록 항목(문서·대화·출처 칩)을 Enter/Space로 누르기
    ───────────────────────────────────────── */
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const t = e.target;
      if (!t || t.tagName === 'BUTTON' || t.getAttribute('role') !== 'button') return;
      e.preventDefault();
      t.click();
    });

    /* ─────────────────────────────────────────
       검색 (RAG)
    ───────────────────────────────────────── */
    let isSearching = false;

    async function doSearch() {
      if (isSearching) return;
      const input = document.getElementById('searchInput');
      const query = input.value.trim();
      if (!query) return;

      showView('chat');
      updateChatTitle(query);  // 대화 제목 업데이트
      isSearching = true;
      const btn = document.getElementById('searchBtn');
      btn.disabled = true;

      appendUserMsg(query);
      const ctrl = window.AbortController ? new AbortController() : null;
      const thinkingEl = appendThinking(ctrl);
      input.value = '';

      try {
        // history: 직전까지의 대화 맥락(최근 8턴)을 함께 전달. AI 답변은 오래 걸릴 수 있어 90초까지 기다린다
        const data = await VUI.apiFetch('/api/search', {
          json: { query, history: activeMessages.slice(-8) },
          timeout: SEARCH_TIMEOUT,
          signal: ctrl ? ctrl.signal : undefined,
        });
        if (!data || typeof data.answer !== 'string') throw new Error('답변을 받지 못했어요. 잠시 후 다시 시도해 주세요.');

        thinkingEl.remove();
        appendAiMsg(query, data.answer, data.sources || [], data.allProvided);
        // 멀티턴 맥락 버퍼 갱신
        activeMessages.push({ role: 'user', content: query });
        activeMessages.push({ role: 'ai', content: data.answer });
        saveHistory(query, data.answer, data.sources || []);
      } catch (err) {
        thinkingEl.remove();
        if (err && err.code === 'abort') {
          // 사용자가 취소함 — 질문을 입력창에 돌려놓아 고쳐 다시 물을 수 있게
          input.value = query;
          showToast('검색을 취소했어요');
        } else {
          console.error('[search]', err && err.code, err && err.message);
          appendAiMsg(query, fetchErrorMessage(err), []);
        }
      } finally {
        isSearching = false;
        btn.disabled = false;
      }
    }

    function appendUserMsg(text) {
      const area = document.getElementById('chatArea');
      const el = document.createElement('div');
      el.className = 'chat-turn';
      el.innerHTML = `<div class="chat-user">${escHtml(text)}</div>`;
      area.appendChild(el);
      el.scrollIntoView({ behavior: 'smooth', block: 'end' });
      return el;
    }

    // ctrl(AbortController)을 주면 15초가 지나도 답이 없을 때 "길어지고 있어요" 안내와 [취소] 버튼을 보여 준다
    const SLOW_AFTER_MS = 15000;
    function appendThinking(ctrl) {
      const area = document.getElementById('chatArea');
      const el = document.createElement('div');
      el.className = 'chat-thinking';
      if (!ctrl && window.AbortController) ctrl = new AbortController();
      el.ctrl = ctrl;
      el.innerHTML = `<div class="thinking-dot" aria-hidden="true"></div><div class="thinking-dot" aria-hidden="true"></div><div class="thinking-dot" aria-hidden="true"></div><span class="thinking-text">검색 중...</span>`;
      area.appendChild(el);
      el.scrollIntoView({ behavior: 'smooth', block: 'end' });
      const timer = setTimeout(() => {
        if (!el.isConnected) return;
        el.querySelector('.thinking-text').textContent = '답변이 길어지고 있어요. 조금만 더 기다려 주세요…';
        if (ctrl) {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'cancel-btn';
          b.textContent = '취소';
          b.addEventListener('click', () => ctrl.abort());
          el.appendChild(b);
        }
      }, SLOW_AFTER_MS);
      const origRemove = el.remove.bind(el);
      el.remove = () => { clearTimeout(timer); origRemove(); };
      return el;
    }

    function appendAiMsg(query, answer, sources, allProvided = false) {
      // 동기화로 들어온 기록일 수 있으므로 형식을 맞춘다
      query = String(query == null ? '' : query);
      answer = String(answer == null ? '' : answer);
      sources = Array.isArray(sources) ? sources.filter(s => typeof s === 'string' || (s && typeof s === 'object')) : [];
      const area = document.getElementById('chatArea');
      const el = document.createElement('div');
      el.className = 'chat-ai';

      // 모든 문서를 참조했으면 참조 섹션 표시 안 함
      const showSources = sources.length > 0 && !allProvided;
      const sourceHtml = showSources ? `
        <div class="chat-sources">
          <div class="chat-sources-label">${ic('paperclip')}근거</div>
          ${sources.map(s => sourceChip(s)).join('')}
        </div>` : '';

      // 답변·질문은 인라인 onclick에 넣지 않고 클로저로 넘긴다(작은따옴표·스크립트 주입 방지)
      el.innerHTML = `
        <div class="chat-ai-card">
          <div class="chat-ai-body"></div>
          ${sourceHtml}
        </div>
        <div class="chat-actions">
          <button type="button" class="chat-action-btn" data-act="copy" aria-label="답변 복사">복사</button>
          <button type="button" class="chat-action-btn" data-act="share">편집기에서 열기</button>
        </div>`;

      el.querySelector('[data-act="copy"]').addEventListener('click', (e) => copyAnswer(e.currentTarget, answer));
      el.querySelector('[data-act="share"]').addEventListener('click', () => shareAnswer(query, answer, sources));
      el.querySelector('.chat-ai-body').innerHTML = renderMarkdown(answer);
      area.appendChild(el);
      el.scrollIntoView({ behavior: 'smooth', block: 'end' });
      return el;
    }

    // 출처: { n, doc, title, page, pageLabel, path }. 예전 기록(GitHub md 경로 문자열)은 이름만 표시
    function sourceLabel(s) {
      if (typeof s === 'string') return s.split('/').pop().replace(/\.md$/, '');
      return `${s.n ? `[${s.n}] ` : ''}${s.title}${s.pageLabel ? ` · ${s.pageLabel}` : ''}`;
    }
    function sourceChip(s) {
      if (typeof s === 'string') return `<span class="source-chip" style="opacity:.6" title="이전 문서 저장소 — 더 이상 열 수 없음">${escHtml(sourceLabel(s))}</span>`;
      const page = window.VSafe ? VSafe.int(s.page, 1, 100000, 0) : (parseInt(s.page, 10) || 0);
      return `<span class="source-chip" role="button" tabindex="0" style="cursor: pointer;" title="${escHtml(s.path || '')}" data-doc="${escHtml(s.doc == null ? '' : s.doc)}" data-page="${page}">${escHtml(sourceLabel(s))}</span>`;
    }
    // 출처 칩 클릭: 이벤트 위임
    document.getElementById('chatArea').addEventListener('click', (e) => {
      const chip = e.target.closest('.source-chip[data-doc]');
      if (!chip || !chip.dataset.doc) return;
      openFile(chip.dataset.doc, +chip.dataset.page || null);
    });

    /* ─────────────────────────────────────────
       액션
    ───────────────────────────────────────── */
    function copyAnswer(btn, answer) {
      VUI.copy(answer, '답변을 복사했어요').then(ok => {
        if (!ok) { showToast('복사하지 못했어요. 답변을 직접 선택해 복사해 주세요.', 'error'); return; }
        const orig = btn.textContent;
        btn.textContent = '복사됨!';
        setTimeout(() => btn.textContent = orig, 1500);
      });
    }

    function shareAnswer(query, answer, sources) {
      const md = `# 검색 결과\n\n**질문:** ${query}\n\n${answer}${
        sources.length ? `\n\n---\n**근거**\n${sources.map(s => `- ${sourceLabel(s)}`).join('\n')}` : ''}`;
      openMdEditor(md, '검색결과.md');
    }

    function openMdEditor(content, filename) {
      let safeContent = content;
      if (new Blob([content]).size > 7500) {
        safeContent = content.slice(0, 7000) + '\n\n*(내용이 잘렸습니다.)*';
        // 말없이 잘리지 않게 알린다
        showToast('답변이 길어 앞부분만 편집기로 보냈어요. 전체는 [복사]로 옮겨 주세요.');
      }
      // md-editor 공유 형식({data, permission}) — UTF-8 base64url(VUI.share.encode, md-editor는 옛 형식도 읽음)
      const encoded = VUI.share.encode({ data: { content: safeContent, filename }, permission: 'clone' });
      window.open(`/apps/md-editor/#share=${encoded}`, '_blank');
    }

    /* ─────────────────────────────────────────
       localStorage 이력
    ───────────────────────────────────────── */
    function saveHistory(query, answer, sources) {
      const list = getHistory();
      list.unshift({ id: Date.now(), query, answer, sources, ts: Date.now() });
      if (list.length > 50) list.length = 50;
      try {
        localStorage.setItem(LS_HISTORY, JSON.stringify(list));
      } catch {
        showToast('저장 공간이 부족해 최근 질문을 저장하지 못했어요', 'error');
      }
      renderConvList();
    }

    function getHistory() {
      try {
        const v = JSON.parse(localStorage.getItem(LS_HISTORY) || '[]');
        return Array.isArray(v) ? v.filter(i => i && typeof i === 'object') : [];
      } catch { return []; }
    }

    function renderConvList() {
      const list = getHistory().slice(0, 20);
      const container = document.getElementById('convList');
      if (list.length === 0) {
        container.innerHTML = '<div class="conv-item-empty">아직 질문이 없어요</div>';
        return;
      }
      container.innerHTML = list.map(item =>
        `<div class="conv-item" role="button" tabindex="0" data-id="${escHtml(item.id)}">${escHtml(item.query)}</div>`
      ).join('');
    }
    // 대화 목록 클릭: 이벤트 위임(기록 id를 인라인 onclick에 넣지 않음)
    document.getElementById('convList').addEventListener('click', (e) => {
      const it = e.target.closest('.conv-item[data-id]');
      if (it) loadConv(it.dataset.id);
    });

    function loadConv(id) {
      id = String(id);
      const list = getHistory();
      const item = list.find(i => String(i.id) === id);
      if (!item) return;

      document.querySelectorAll('.conv-item').forEach(i => {
        const on = i.dataset.id === id;
        i.classList.toggle('active', on);
        if (on) i.setAttribute('aria-current', 'true'); else i.removeAttribute('aria-current');
      });

      document.getElementById('chatArea').innerHTML = '';
      appendUserMsg(item.query);
      appendAiMsg(item.query, item.answer, item.sources || []);
      // 저장된 단일 Q&A를 맥락 버퍼로 복원 → 이어서 후속 질문 가능
      activeMessages = [
        { role: 'user', content: item.query },
        { role: 'ai', content: item.answer }
      ];
      showView('chat');
    }

    async function clearHistory() {
      if (!getHistory().length) { showToast('지울 질문이 없어요'); return; }
      const ok = await VUI.confirm('이 기기에 저장된 최근 질문과 답변을 모두 지울까요?', { title: '최근 질문 지우기', ok: '모두 지우기', danger: true });
      if (!ok) return;
      let backup = null;
      try { backup = localStorage.getItem(LS_HISTORY); localStorage.removeItem(LS_HISTORY); } catch {}
      renderConvList();
      newChat();
      if (backup) VUI.toast('최근 질문을 지웠어요', { action: { label: '되돌리기', onClick: () => {
        try { localStorage.setItem(LS_HISTORY, backup); } catch {}
        renderConvList();
      } } });
    }

    /* ─────────────────────────────────────────
       공유
    ───────────────────────────────────────── */
    function shareCurrentPage() {
      // 복사가 안 되면 링크·QR 창(공용 VUI)
      VUI.share.copyOrShow(window.location.href, { title: '에듀서치 공유' });
    }

    /* ─────────────────────────────────────────
       문서 AI 질문/요약 (토큰 절약 버전)
    ───────────────────────────────────────── */
    let currentDocContent = '';

    function summarizeDoc() {
      if (!currentDocContent || !currentPath) return;
      showQuestionModal('summarize', currentPath, currentDocContent);
    }

    function askAboutDoc() {
      if (!currentDocContent || !currentPath) return;
      showQuestionModal('question', currentPath, currentDocContent);
    }

    function askAboutSelection() {
      const selected = window.getSelection().toString().trim().slice(0, 2000);
      if (!selected) return;
      hideSelectionPopup();
      if (!currentPath) return;  // 문서 뷰가 아니면 무시(맥락이 될 문서가 없음)
      // 현재 문서를 맥락으로, 선택한 키워드에 대해 무엇이 궁금한지 먼저 묻기
      showQuestionModal('question', currentPath, currentDocContent, selected);
    }

    async function sendDocumentRequest(type, docPath, thinkingEl, question = null) {
      try {
        const payload = {
          type: type,  // 'summarize' or 'question'
          documentPath: docPath,
          query: question || '문서를 분석하고 요약해 주세요.',
          history: activeMessages.slice(-8)
        };

        const data = await VUI.apiFetch('/api/search', { json: payload, timeout: SEARCH_TIMEOUT, signal: thinkingEl.ctrl || undefined });
        if (!data || typeof data.answer !== 'string') throw new Error('답변을 받지 못했어요. 잠시 후 다시 시도해 주세요.');

        thinkingEl.remove();
        const label = type === 'summarize' ? `[요약] ${docTitle(docPath)}` : `[질문] ${docTitle(docPath)}`;
        appendAiMsg(label, data.answer, data.sources || []);
        // 문서 질문/요약도 맥락 버퍼에 반영 → 이어지는 자유 질문이 맥락 유지
        activeMessages.push({ role: 'user', content: `${label}${question ? ' — ' + question : ''}` });
        activeMessages.push({ role: 'ai', content: data.answer });
        saveHistory(label, data.answer, data.sources || []);
      } catch (err) {
        thinkingEl.remove();
        if (err && err.code === 'abort') { showToast('요청을 취소했어요'); return; }
        console.error('[doc-request]', err && err.code, err && err.message);
        appendAiMsg('문서 요청', `오류 발생: ${fetchErrorMessage(err)}`, []);
      }
    }

    function askDocQuestion(query, label) {
      // 이전 호환성 유지 (선택 부분 설명 등)
      showView('chat');
      appendUserMsg(label);
      const thinkingEl = appendThinking();
      document.getElementById('searchInput').value = query;
      setTimeout(() => { thinkingEl.remove(); doSearch(); }, 100);
    }

    function showSelectionPopup(x, y) {
      const popup = document.getElementById('selectionPopup');
      popup.classList.add('active');
      popup.style.left = (x + 5) + 'px';
      popup.style.top = (y + 5) + 'px';
    }

    function hideSelectionPopup() {
      document.getElementById('selectionPopup').classList.remove('active');
    }

    /* ─────────────────────────────────────────
       유틸
    ───────────────────────────────────────── */
    /* 마크다운 렌더링 — marked가 단일 물결표(~)를 (범위 표기인데도) 취소선으로
       오인하는 문제 방지. 단일 ~만 보호 문자로 치환해 파싱한 뒤 복원한다.
       이중 물결표(~~…~~)는 그대로 둬서 의도된 취소선은 유지. */
    const TILDE_SENTINEL = '@@TILDE_RANGE@@';
    // AI 답변·동기화된 기록이 HTML로 실행되지 않도록 DOMPurify로 정제.
    // marked/DOMPurify를 못 불러오면 이스케이프한 원문을 그대로 보여 준다(빈 화면 방지).
    function renderMarkdown(text) {
      const raw = String(text == null ? '' : text);
      if (!window.marked || !window.DOMPurify) {
        return `<div style="white-space:pre-wrap;overflow-wrap:anywhere">${escHtml(raw)}</div>`;
      }
      // 연속되지 않은 ~ 하나만 바꾼다(lookbehind는 iOS 16.4 미만 Safari에서 문법 오류라 쓰지 않음)
      const src = raw.replace(/~+/g, (m) => (m.length === 1 ? TILDE_SENTINEL : m));
      const html = marked.parse(src).split(TILDE_SENTINEL).join('~');
      return DOMPurify.sanitize(html, { FORBID_TAGS: ['style', 'form'] });
    }

    function escHtml(s) {
      if (window.VSafe) return VSafe.esc(s);
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // /api/search 호출 제한 시간(AI 답변은 길게 걸릴 수 있어 넉넉히 90초)
    const SEARCH_TIMEOUT = 90000;
    // VUI.apiFetch 오류는 이미 한국어 문구(err.message). 시간 초과만 더 친절하게
    function fetchErrorMessage(err) {
      if (err && err.code === 'timeout') return '응답이 너무 오래 걸려요. 잠시 후 다시 시도해 주세요.';
      return (err && err.message) || '요청에 실패했어요.';
    }

    function showToast(msg, type) { VUI.toast(msg, type); }

    /* ─────────────────────────────────────────
       초기화
    ───────────────────────────────────────── */
    loadDocs();
    renderConvList();

    // 선택 동기화: 헤더 '동기화' 버튼 (최근 질문을 코드 하나로 기기 간 이어쓰기)
    if (window.VivesSync) VivesSync.mountDocSync({
      apiUrl: '/api/search-sync',
      keys: [LS_HISTORY],
      appName: '최근 질문',
      onApplied: renderConvList,
    });
  </script>



</AppLayout>
