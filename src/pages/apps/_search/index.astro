    /* iOS는 16px 미만 입력칸에서 화면을 확대한다 → 휴대폰·태블릿에서는 16px */
    @media (max-width: 768px), (pointer: coarse) {
      .welcome-input, .chat-input-bar input, .question-input { font-size: 16px; }
    }

    /* 제목 영문 병기 */
