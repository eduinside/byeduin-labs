        <circle data-part="hand" r="3.6" fill="${SKIN}" stroke="${SKIN_DARK}" stroke-width="1"></circle>
      </g>
      <!-- 내린 라이더(앞바퀴 바람이 빠졌을 때): 바퀴를 내려다보며 머리를 긁적인다 -->
      <g class="fb-stand" hidden>${standMarkup()}</g>
      <g class="fb-bell">
        <rect x="222" y="0" width="52" height="22" rx="11" fill="#fff" stroke="var(--fg)" stroke-width="2"></rect>
        <text x="248" y="12" font-size="13" font-weight="800" text-anchor="middle" dominant-baseline="central" fill="var(--fg)">따릉!</text>
      </g>
    </g>`;
}

/* 2관절 계산: a에서 b로 길이 l1·l2. side 1 = 진행 방향 왼쪽(다리면 무릎이 앞), -1 = 반대(팔꿈치 아래)
   b가 너무 멀면 닿는 데까지 편다. { j: 관절, e: 끝 } */
function joint(a, b, l1, l2, side) {
  let dx = b.x - a.x, dy = b.y - a.y, d = Math.hypot(dx, dy) || 0.01;
  const max = l1 + l2 - 0.01;
  if (d > max) { dx *= max / d; dy *= max / d; d = max; }
  const along = (l1 * l1 - l2 * l2 + d * d) / (2 * d);
  const h = Math.sqrt(Math.max(0, l1 * l1 - along * along));
  return {
    j: { x: a.x + dx * along / d + side * h * dy / d, y: a.y + dy * along / d - side * h * dx / d },
    e: { x: a.x + dx, y: a.y + dy }
  };
}
const pt = p => `${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
const seg = (a, b) => `M ${pt(a)} L ${pt(b)}`;
/* 몸통: 엉덩이→어깨, 등이 살짝 둥글게 */
function torsoPath(h, s) {
  const mx = (h.x + s.x) / 2, my = (h.y + s.y) / 2;
  const dx = s.x - h.x, dy = s.y - h.y, d = Math.hypot(dx, dy) || 1;
  return `M ${pt(h)} Q ${(mx + 4 * dy / d).toFixed(1)} ${(my - 4 * dx / d).toFixed(1)} ${pt(s)}`;
}
/* 발목에서 앞쪽으로 신발(페달 위에 수평) */
const shoePath = a => `M ${(a.x - 2).toFixed(1)} ${(a.y + 3).toFixed(1)} L ${(a.x + 9).toFixed(1)} ${(a.y + 3).toFixed(1)}`;
function rotAround(p, c, deg) {
  const r = deg * Math.PI / 180, cs = Math.cos(r), sn = Math.sin(r), x = p.x - c.x, y = p.y - c.y;
  return { x: c.x + x * cs - y * sn, y: c.y + x * sn + y * cs };
}

/* 머리(중심 0,0, 오른쪽을 봄): 헬멧·머리카락·귀·표정 4가지(smile·happy·worried·tired) */
function headMarkup() {
  const eye = 'fill="#2b1d14"', line = 'fill="none" stroke="#2b1d14" stroke-width="1.3" stroke-linecap="round"';
  const cheek = '<circle cx="3" cy="4.5" r="2.1" fill="#ff8a80" opacity="0.45"></circle>';
  return `
    <path d="M -12 -1 Q -15 8 -7 11 L -6 3 Z" fill="${HAIR}"></path>
    <circle r="12" fill="${SKIN}" stroke="${SKIN_DARK}" stroke-width="1"></circle>
    <circle cx="-3" cy="2" r="2.6" fill="${SKIN}" stroke="${SKIN_DARK}" stroke-width="1"></circle>
    <g class="fb-face" data-face="smile">${cheek}
      <g class="fb-eyes" ${eye}><circle cx="4.5" cy="0.5" r="1.5"></circle><circle cx="9.8" cy="0" r="1.4"></circle></g>
      <path d="M 4 5.5 Q 7.5 8.8 11 5" ${line}></path>
    </g>
    <g class="fb-face" data-face="happy" display="none">${cheek}
      <g class="fb-eyes" ${line}><path d="M 3 1 Q 4.5 -1.2 6 1"></path><path d="M 8.4 0.5 Q 9.9 -1.7 11.4 0.5"></path></g>
      <path d="M 3.5 4.5 Q 7.5 11 11.5 4 Z" fill="#8d2f2f"></path>
    </g>
    <g class="fb-face" data-face="worried" display="none">
      <path d="M 2.8 -2.4 L 5.8 -3.3 M 8.6 -3.6 L 11.3 -2.6" ${line}></path>
      <g class="fb-eyes" ${eye}><circle cx="4.5" cy="0.7" r="1.7"></circle><circle cx="9.8" cy="0.2" r="1.6"></circle></g>
      <ellipse cx="7.8" cy="6.6" rx="1.7" ry="2.1" ${eye}></ellipse>
    </g>
    <g class="fb-face" data-face="tired" display="none">${cheek}
      <g class="fb-eyes" ${line}><path d="M 3 0.6 L 6 0.9"></path><path d="M 8.4 0.4 L 11.3 0.6"></path></g>
      <path d="M 4.2 6.8 Q 5.9 5.6 7.6 6.8 T 11 6.5" ${line}></path>
      <path d="M 13.5 -3 q 2.2 3.2 0 4.8 q -2.2 -1.6 0 -4.8 z" fill="#4fc3f7"></path>
    </g>
    <path d="M -13 -1 C -14 -11, -2 -17, 10 -11 C 13 -9, 14.5 -6, 14.5 -4 C 6 -5.5, -4 -3.5, -13 -1 Z" fill="#ff7043" stroke="#d84315" stroke-width="1.2"></path>
    <path d="M -6 -11 L -2 -12.6 M 1.5 -12.6 L 5.5 -11.2" stroke="#fff" stroke-opacity="0.8" stroke-width="1.5" stroke-linecap="round"></path>`;
}

/* 내린 라이더: 오른쪽을 보는 모습으로 그린 뒤 좌우를 뒤집어 앞바퀴 쪽을 보게 한다 */
function standMarkup() {
  const hip = { x: 0, y: 105 }, sh = { x: 2, y: 61 }, shFar = { x: -1, y: 60 };
  const nearAnk = { x: 3, y: 193 }, farAnk = { x: -5, y: 193 };
  const kn = joint(hip, nearAnk, THIGH, SHIN, 1).j, kf = joint(hip, farAnk, THIGH, SHIN, 1).j;
  const nearHand = { x: 8, y: 101 }, farHand = { x: -9, y: 35 }; // 먼 손은 머리 뒤를 긁적
  const en = joint(sh, nearHand, UPPER_ARM, FOREARM, -1).j, ef = joint(shFar, farHand, UPPER_ARM, FOREARM, 1).j;
  const sleeve = (s, e) => seg(s, { x: s.x + (e.x - s.x) * 0.45, y: s.y + (e.y - s.y) * 0.45 });
  const st = 'fill="none" stroke-linecap="round" stroke-linejoin="round"';
  return `<g transform="translate(318 0) scale(-1 1)" ${st}>
      <path d="${seg(shFar, ef)} L ${pt(farHand)}" stroke="${SKIN_DARK}" stroke-width="5.5"></path>
      <path d="${seg(kf, farAnk)}" stroke="${SKIN_DARK}" stroke-width="6.5"></path>
      <path d="${seg(hip, kf)}" stroke="${SHORTS_FAR}" stroke-width="10"></path>
      <path d="${shoePath(farAnk)}" stroke="#263238" stroke-width="6"></path>
      <path d="${seg(kn, nearAnk)}" stroke="${SKIN}" stroke-width="6.5"></path>
      <path d="${seg(hip, kn)}" stroke="${SHORTS}" stroke-width="10"></path>
      <path d="${shoePath(nearAnk)}" stroke="${SHOE}" stroke-width="6"></path>
      <path d="${torsoPath(hip, sh)}" stroke="var(--fb-accent)" stroke-width="16"></path>
      <path d="${seg(sh, { x: 4, y: 50 })}" stroke="${SKIN}" stroke-width="6"></path>
      <g transform="translate(6 41) rotate(14)">${headMarkup()}</g>
      <circle cx="${farHand.x}" cy="${farHand.y}" r="3.6" fill="${SKIN_DARK}"></circle>
      <path d="${seg(sh, en)}" stroke="${SKIN}" stroke-width="6"></path>
      <path d="${sleeve(sh, en)}" stroke="var(--fb-accent)" stroke-width="9"></path>
      <path d="${seg(en, nearHand)}" stroke="${SKIN}" stroke-width="5.5"></path>
      <circle cx="${nearHand.x}" cy="${nearHand.y}" r="3.6" fill="${SKIN}" stroke="${SKIN_DARK}" stroke-width="1"></circle>
    </g>`;
}

/* 주행 무대 하나(도로·배경·자전거). opts: { tag, finish, onFinish } */
const rides = [];
function createRide(box, opts) {
  opts = opts || {};
  box.innerHTML = `
    <div class="ride-sky"></div><div class="ride-trees"></div>
    <div class="road-bg"><div class="road-lines"></div></div>
    ${opts.tag ? `<div class="ride-tag">${opts.tag}</div><div class="ride-progress" aria-hidden="true"><span></span></div><div class="ride-flag" aria-hidden="true">🏁</div>` : ''}
    <div class="bike-rider-stage"><svg class="bike-body-svg" viewBox="0 0 340 220" role="img" aria-label="식품구성자전거">${bikeSvgMarkup()}</svg></div>`;
  const q = s => box.querySelector(s);
  const el = {
    svg: q('svg'), sky: q('.ride-sky'), trees: q('.ride-trees'), lines: q('.road-lines'),
    speed: q('.fb-speed'), body: q('.fb-body'), rearSpin: box.querySelectorAll('.fb-rear-spin'),
    front: q('.fb-front'), frontSpin: q('.fb-front-spin'), water: q('.fb-water'), crank: q('.fb-crank'),
    rider: q('.fb-rider'), riderBack: q('.fb-rider-back'), stand: q('.fb-stand'),
    luggage: q('.fb-luggage'), bell: q('.fb-bell'),
    tag: q('.ride-tag'), progress: q('.ride-progress span'), fills: {}, icons: {}, part: {}
  };
  box.querySelectorAll('.fb-fill').forEach(p => { el.fills[p.dataset.g] = p; });
  box.querySelectorAll('.fb-icon').forEach(t => { el.icons[t.dataset.g] = t; });
  box.querySelectorAll('[data-part]').forEach(p => { el.part[p.dataset.part] = p; });
  // 표정: 머리 안의 4가지 중 하나만 보인다. 눈 깜빡임은 무대마다 조금씩 어긋나게
  const setFace = (head, face) => head.querySelectorAll('.fb-face').forEach(g => g.setAttribute('display', g.dataset.face === face ? 'inline' : 'none'));
  setFace(el.stand, 'worried');
  const blinkDelay = (-Math.random() * 4).toFixed(2) + 's';
  box.querySelectorAll('.fb-eyes').forEach(g => { g.style.animationDelay = blinkDelay; });

  const GROUPS = [1, 2, 3, 4, 5, 6];
  const r = {}, rTo = {}, rWait = {};       // 그린 채움 반지름 / 목표 / 이 시각까지 미룸(날아가는 이모지)
  GROUPS.forEach(g => { r[g] = 0; rTo[g] = 0; rWait[g] = 0; });
  const cur = { speed: 0, wobble: 0, flat: 0, water: 0, heavy: 0 };
  const to = { speed: 0, wobble: 0, flat: 0, water: 0, heavy: 0 };
  let waterWait = 0, clock = 0, dist = 0, scale = 1, run = null, finished = false, dirty = true;

  function fit() {
    const w = box.clientWidth, h = box.clientHeight;
    if (!w || !h) return;
    scale = Math.max(0.25, Math.min(1.6, w / 340, (h - 6) / 220));
    box.style.setProperty('--bike-s', scale.toFixed(3));
    dirty = true;
    render();
  }
  if (window.ResizeObserver) new ResizeObserver(fit).observe(box);
  else window.addEventListener('resize', fit);

  /* 접시 상태 반영. a = assessPlate 결과(또는 { run, speed }). o: { reset, ring } */
  function set(counts, a, o) {
    o = o || {};
    GROUPS.forEach(g => { rTo[g] = SECTOR_R * fillOf(counts, g); });
    GROUPS.forEach(g => el.icons[g].setAttribute('opacity', counts[g] ? '1' : '0.5'));
    to.water = counts.water ? 1 : 0;
    to.flat = a.run === 'stop' ? 1 : 0;
    to.wobble = a.run === 'wobble' ? 1 : 0;
    to.heavy = a.run === 'heavy' ? 1 : 0;
    to.speed = a.speed;
    if (o.reset) {
      dist = 0; finished = false;
      if (el.tag) el.tag.textContent = opts.tag;
    }
    const prev = run;
    run = a.run;
    setFace(el.part.head, FACE_OF[a.run] || 'smile');
    el.rider.toggleAttribute('hidden', a.run === 'stop');
    el.riderBack.toggleAttribute('hidden', a.run === 'stop');
    el.stand.toggleAttribute('hidden', a.run !== 'stop');
    // 짐칸 짐: 유지·당류가 OIL_LIMIT을 넘은 만큼(최대 3). 새로 생긴 상자만 튀어나온다
    const want = counts[6] > OIL_LIMIT ? Math.min(3, counts[6] - OIL_LIMIT) : 0;
    while (el.luggage.children.length > want) el.luggage.lastChild.remove();
    while (el.luggage.children.length < want) {
      const i = el.luggage.children.length, y = 84 - 18 * (i + 1) + 2;
      el.luggage.insertAdjacentHTML('beforeend', `<g class="fb-luggage-box"><rect x="80" y="${y}" width="44" height="16" rx="3" fill="#d35400" stroke="var(--fg)" stroke-width="2"></rect><text x="102" y="${y + 8.5}" font-size="11" font-weight="800" fill="#fff" text-anchor="middle" dominant-baseline="central">짐</text></g>`);
    }
    el.svg.setAttribute('aria-label', wheelLabel(counts));
    if (o.ring && prev && prev !== 'go' && run === 'go') setTimeout(ring, (o.ringDelay || 0) * 1000);
    dirty = true;
    if (reduceMotion.matches) snap(); else kick();
  }

  /* 날아가는 이모지가 닿을 때까지 그 자리 채움을 미룬다 */
  function wait(group, sec) {
    if (group === 'water') waterWait = clock + sec;
    else rWait[group] = clock + sec;
  }

  function ring() {
    if (reduceMotion.matches) return;
    el.bell.classList.remove('ring');
    el.bell.getBoundingClientRect();
    el.bell.classList.add('ring');
  }

  /* 움직임 줄이기: 목표 상태로 바로(멈춘 자세) */
  function snap() {
    Object.assign(cur, to);
    GROUPS.forEach(g => { r[g] = rTo[g]; });
    dirty = true;
    render();
  }

  /* 한 프레임 진행. 아직 움직일 것이 있으면 true */
  function step(dt) {
    clock += dt;
    const ks = 1 - Math.exp(-dt * 2.2), kf = 1 - Math.exp(-dt * 6), kr = 1 - Math.exp(-dt * 7);
    cur.speed += (to.speed - cur.speed) * ks;
    cur.wobble += (to.wobble - cur.wobble) * kf;
    cur.flat += (to.flat - cur.flat) * kf;
    cur.heavy += (to.heavy - cur.heavy) * kf;
    if (clock >= waterWait) cur.water += (to.water - cur.water) * kf;
    let settling = ['speed', 'flat', 'water', 'heavy'].some(k => Math.abs(to[k] - cur[k]) > 0.002);
    GROUPS.forEach(g => {
      if (clock < rWait[g]) { settling = true; return; }
      const d = rTo[g] - r[g];
      if (Math.abs(d) > 0.05) { r[g] += d * kr; settling = true; dirty = true; }
      else if (d) { r[g] = rTo[g]; dirty = true; }
    });
    dist += cur.speed * MAX_SPEED * dt;
    if (opts.finish && !finished && dist >= opts.finish) {
      finished = true;
      to.speed = 0;
      if (el.tag) el.tag.textContent = opts.tag + ' · 도착!';
      if (opts.onFinish) opts.onFinish();
    }
    const moving = cur.speed > 0.001 || cur.wobble > 0.002 || settling;
    if (moving) render();
    return moving;
  }

  function render() {
    const s = scale;
    const rearRad = dist / REAR.r;
    el.rearSpin.forEach(g => g.setAttribute('transform', `rotate(${(rearRad * 180 / Math.PI % 360).toFixed(2)} ${REAR.x} ${REAR.y})`));
    el.frontSpin.setAttribute('transform', `rotate(${(dist / FRONT.r * 180 / Math.PI % 360).toFixed(2)} ${FRONT.x} ${FRONT.y})`);
    // 앞바퀴 바람: 바닥(GROUND)을 기준으로 납작하게
    const fy = 1 - 0.24 * cur.flat, fx = 1 + 0.08 * cur.flat;
    el.front.setAttribute('transform', `translate(${FRONT.x} ${GROUND}) scale(${fx.toFixed(3)} ${fy.toFixed(3)}) translate(${-FRONT.x} ${-GROUND})`);
    el.water.setAttribute('fill-opacity', (0.6 * cur.water).toFixed(2));
    // 페달: 뒷바퀴와 같은 각도로 돈다
    const p1 = { x: CRANK.x + CRANK.len * Math.cos(rearRad), y: CRANK.y + CRANK.len * Math.sin(rearRad) };
    const p2 = { x: 2 * CRANK.x - p1.x, y: 2 * CRANK.y - p1.y };
    const f = n => n.toFixed(1);
    el.crank.setAttribute('d', `M ${f(p1.x)} ${f(p1.y)} L ${CRANK.x} ${CRANK.y} L ${f(p2.x)} ${f(p2.y)} M ${f(p1.x - 5)} ${f(p1.y)} L ${f(p1.x + 5)} ${f(p1.y)} M ${f(p2.x - 5)} ${f(p2.y)} L ${f(p2.x + 5)} ${f(p2.y)}`);
    poseRider(p1, p2, rearRad);
    // 몸 흔들림: 비틀비틀은 앞뒤로 기우뚱·덜컹, 달릴 때는 페달에 맞춰 살짝 들썩
    const tilt = cur.wobble * 4 * Math.sin(clock * 6.5);
    const bounce = -cur.wobble * 3 * Math.abs(Math.sin(clock * 9)) - 0.8 * Math.min(1, cur.speed) * Math.abs(Math.sin(rearRad));
    el.body.setAttribute('transform', `translate(0 ${bounce.toFixed(2)}) rotate(${tilt.toFixed(2)} 178 ${GROUND})`);
    // 빠르게 달릴 때만 속도선
    el.speed.setAttribute('opacity', (Math.max(0, Math.min(1, (cur.speed - 0.75) / 0.25)) * 0.6).toFixed(2));
    el.speed.setAttribute('stroke-dashoffset', (dist * 1.3).toFixed(1));
    // 도로·배경(시차): 화면 px = 그림 단위 × 배율
    const px = dist * s;
    el.lines.style.backgroundPosition = `${(-(px % 60)).toFixed(1)}px 0`;
    el.trees.style.backgroundPosition = `${(-((px * 0.45) % (180 * s))).toFixed(1)}px 0`;
    el.sky.style.backgroundPosition = `${(-((px * 0.12) % (320 * s))).toFixed(1)}px 0`;
    if (el.progress) el.progress.style.width = (Math.min(1, dist / opts.finish) * 100).toFixed(1) + '%';
    if (dirty) {
      Object.keys(el.fills).forEach(g => {
        const [a0, a1] = SECTOR_ANGLES[g];
        el.fills[g].setAttribute('d', r[g] < 0.3 ? 'M0 0' : getSectorPath(REAR.x, REAR.y, +r[g].toFixed(2), a0, a1));
      });
      dirty = false;
    }
  }

  /* 라이더 자세: 빠를수록·짐이 무거울수록 앞으로 숙이고, 페달에 맞춰 상체가 살짝 들썩인다.
     비틀비틀이면 자전거가 기우는 반대쪽으로 몸을 기울여 균형을 잡고 고개가 흔들린다 */
  function poseRider(p1, p2, rearRad) {
    const P = el.part, sp = Math.min(1, cur.speed);
    const sway = Math.sin(clock * 6.5);
    const lean = 5 * sp + 6 * cur.heavy + 1.2 * sp * Math.sin(rearRad * 2) - 4 * cur.wobble * sway;
    const sh = rotAround(SHOULDER, HIP, lean);
    const off = rotAround(HEAD_OFF, { x: 0, y: 0 }, lean * 1.2);
    const head = { x: sh.x + off.x, y: sh.y + off.y };
    const nod = lean * 0.4 + 7 * cur.wobble * Math.sin(clock * 5) + 4 * cur.heavy;
    // 다리: 엉덩이 → 무릎 → 발목(페달 위 신발)
    [['near', p1], ['far', p2]].forEach(([k, p]) => {
      const ank = { x: p.x - 2, y: p.y - 5 };
      const lg = joint(HIP, ank, THIGH, SHIN, 1);
      P[k + 'Thigh'].setAttribute('d', seg(HIP, lg.j));
      P[k + 'Shin'].setAttribute('d', seg(lg.j, lg.e));
      P[k + 'Shoe'].setAttribute('d', shoePath(lg.e));
    });
    P.torso.setAttribute('d', torsoPath(HIP, sh));
    P.neck.setAttribute('d', seg(sh, { x: sh.x + off.x * 0.5, y: sh.y + off.y * 0.5 }));
    P.head.setAttribute('transform', `translate(${pt(head)}) rotate(${nod.toFixed(1)})`);
    // 팔: 어깨 → 팔꿈치(아래로 굽힘) → 손잡이
    const arm = joint(sh, GRIP, UPPER_ARM, FOREARM, -1);
    P.upperArm.setAttribute('d', seg(sh, arm.j));
    P.sleeve.setAttribute('d', seg(sh, { x: sh.x + (arm.j.x - sh.x) * 0.45, y: sh.y + (arm.j.y - sh.y) * 0.45 }));
    P.forearm.setAttribute('d', seg(arm.j, arm.e));
    P.hand.setAttribute('cx', arm.e.x.toFixed(1));
    P.hand.setAttribute('cy', arm.e.y.toFixed(1));
  }

  /* 움직임 줄이기용: 결승선까지 frac만큼 간 모습으로 바로 */
  function jump(frac) {
    dist = (opts.finish || 0) * frac;
    finished = frac >= 1;
    if (el.tag) el.tag.textContent = finished ? opts.tag + ' · 도착!' : opts.tag;
    render();
  }

  const ride = { box, el, fit, set, wait, snap, step, render, jump };
  rides.push(ride);
  render();
  return ride;
}

/* 루프: 보이는 주행 무대만 움직이고, 모두 멈추면 쉰다 */
let rafId = 0, lastT = 0;
function kick() {
  if (rafId || reduceMotion.matches) return;
  lastT = 0;
  rafId = requestAnimationFrame(tick);
}
function tick(now) {
  const dt = lastT ? Math.min(0.05, (now - lastT) / 1000) : 1 / 60;
  lastT = now;
  let busy = false;
  rides.forEach(rd => {
    if (rd.box.getClientRects().length && rd.step(dt)) busy = true;
  });
  rafId = busy ? requestAnimationFrame(tick) : 0;
}
if (reduceMotion.addEventListener) {
  reduceMotion.addEventListener('change', () => { rides.forEach(rd => rd.snap()); kick(); });
}

/* 담은 음식이 접시 카드에서 바퀴 자리로 날아간다. 닿는 데 걸리는 시간(초)을 돌려준다 */
function flyFood(fromEl, food) {
  if (reduceMotion.matches || !fromEl || !mainRide) return 0;
  const target = food.group === 'water' ? mainRide.el.water : mainRide.el.icons[food.group];
  if (!target || !target.getClientRects().length) return 0;
  const a = fromEl.getBoundingClientRect(), b = target.getBoundingClientRect();
  const fly = document.createElement('span');
  fly.className = 'fb-fly';
  fly.setAttribute('aria-hidden', 'true');
  fly.textContent = food.emoji;
  document.body.appendChild(fly);
  if (!fly.animate) { fly.remove(); return 0; }
  const x0 = a.left + a.width / 2 - 12, y0 = a.top + a.height / 2 - 12;
  const x1 = b.left + b.width / 2 - 12, y1 = b.top + b.height / 2 - 12;
  const mx = (x0 + x1) / 2, my = Math.min(y0, y1) - 60;
  const DUR = 520;
  fly.animate([
    { transform: `translate(${x0}px, ${y0}px) scale(1)`, opacity: 1 },
    { transform: `translate(${mx}px, ${my}px) scale(1.15)`, opacity: 1, offset: 0.5 },
    { transform: `translate(${x1}px, ${y1}px) scale(0.6)`, opacity: 0.3 }
  ], { duration: DUR, easing: 'ease-in-out' }).onfinish = () => fly.remove();
  return DUR / 1000;
}

let mainRide = null, rideA = null, rideB = null;

/* 무대 자전거를 지금 접시로. o: { ring, food, wait } (음식을 담을 때만) */
function updateBikeSimulation(o) {
  o = o || {};
  const counts = getPlateCounts();
  const a = assessPlate(counts);
  mainRide.set(counts, a, { ring: o.ring, ringDelay: o.wait });
  if (o.food && o.wait) mainRide.wait(o.food.group, o.wait * 0.85);
  setBanner(a.run, a.msg);
}

function setBanner(runState, statusMsg) {
  const ICONS = { stop: 'circle-x', wobble: 'triangle-alert', heavy: 'package', run: 'bike', go: 'sparkles', idle: 'circle-pause' };
  const banner = $('#runStatusBanner');
  banner.dataset.state = runState;
  banner.innerHTML = SimKit.icon(ICONS[runState] || 'info') + '<span></span>';
  banner.lastChild.textContent = statusMsg;
}

/* 미션 1처럼 접시와 상관없이 쉬는 모습 */
function showIdleBike(msg) {
  mainRide.set(getPlateCounts([]), { run: 'idle', speed: 0 });
  setBanner('idle', msg);
}

/* 미션 4: 두 자전거를 나란히 세워 두고(예측), [확인]을 누르면 달린다(확인) */
function showRace(on) {
  $('#mainRide').hidden = on;
  $('#raceBox').hidden = !on;
}
function setupRace() {
  const m = MISSIONS[state.missionIdx];
  showRace(true);
  rideA.set(getPlateCounts(m.plateA), { run: 'idle', speed: 0 }, { reset: true });
  rideB.set(getPlateCounts(m.plateB), { run: 'idle', speed: 0 }, { reset: true });
  setBanner('idle', '두 자전거의 뒷바퀴를 비교하고 결론을 골라 보세요.');
}
function startRace() {
  const m = MISSIONS[state.missionIdx];
  const speeds = [[rideA, m.plateA], [rideB, m.plateB]].map(([rd, plate]) => {
    const counts = getPlateCounts(plate);
    const a = assessPlate(counts);
    rd.set(counts, a, { reset: true });
    return a.speed;
  });
  if (reduceMotion.matches) {
    // 움직임 줄이기: 달리지 않고 결과(간 거리 비율)를 바로 보여 준다
    const top = Math.max(...speeds) || 1;
    rideA.jump(speeds[0] / top);
    rideB.jump(speeds[1] / top);
    const win = speeds[0] === speeds[1] ? '' : speeds[0] > speeds[1] ? 'A' : 'B';
    setBanner('go', win ? `식단 ${win} 자전거가 먼저 도착했어요!` : '두 자전거가 함께 도착했어요.');
    return;
  }
  setBanner('run', '두 자전거가 출발했어요! 어느 자전거가 먼저 도착할까요?');
}

/* ══════════════════════════════════════
   모드 2 미션 1: 분류 바구니 인터랙션 셋업
   ══════════════════════════════════════ */
function setupClassificationBaskets() {
  const container = $('#classifyBaskets');
  container.innerHTML = '';

  // 분류 바구니 6종 생성 (유지당류 포함 6개군)
  const list = [
    { group: '1', name: '🌾 곡류', label: '곡류' },
    { group: '2', name: '🥩 고기·생선·달걀·콩류', label: '고기·생선·달걀·콩류' },
    { group: '3', name: '🥬 채소류', label: '채소류' },
    { group: '4', name: '🍎 과일류', label: '과일류' },
    { group: '5', name: '🥛 우유·유제품류', label: '우유·유제품류' },
    { group: '6', name: '🧈 유지·당류', label: '유지·당류' }
  ];

  list.forEach(b => {
    const basket = document.createElement('div');
    basket.className = 'classify-basket';
    basket.dataset.group = b.group;
    basket.setAttribute('role', 'group');
    basket.setAttribute('aria-label', b.label + ' 바구니');
    // 제목 버튼: 키보드·화면 읽기용 "넣기" 버튼(바구니 아무 곳이나 눌러도 같음)
    basket.innerHTML = `<button type="button" class="classify-basket-title" aria-label="고른 음식을 ${b.label} 바구니에 넣기">${b.name}</button>`;

    // 탭 대체 조작: 팔레트에서 고른 음식을 이 바구니에 넣기
    basket.addEventListener('click', () => {
      if (!state.pendingFoodId) {
        if (!isClassifiedAll()) showToast('먼저 음식 카드를 하나 누른 다음 바구니를 눌러 주세요.');
        return;
      }
      const id = state.pendingFoodId;
      state.pendingFoodId = null;
      dropFoodToBasket(id, basket);
    });

    // HTML5 dragover/drop 수신
    basket.addEventListener('dragover', (e) => {
      e.preventDefault();
      basket.classList.add('drag-over');
    });
    basket.addEventListener('dragleave', () => {
      basket.classList.remove('drag-over');
    });
    basket.addEventListener('drop', (e) => {
      e.preventDefault();
      basket.classList.remove('drag-over');
      const id = e.dataTransfer.getData('text/plain');
      if (id && FOOD_BY_ID[id]) {
        dropFoodToBasket(id, basket);
      }
    });

    container.appendChild(basket);
  });
}

function dropFoodToBasket(foodId, basketEl) {
  const f = FOOD_BY_ID[foodId];
  
  // 이미 존재하는지 확인
  const existing = basketEl.querySelector(`.food-card[data-id="${foodId}"]`);
  if (existing) return;

  // 다른 바구니에 있다면 삭제
  $$('.classify-basket .food-card').forEach(card => {
    if (card.dataset.id === foodId) card.remove();
  });

  const card = document.createElement('button');
  card.type = 'button';
  card.className = 'food-card active';
  card.dataset.id = foodId;
  card.setAttribute('aria-label', `${f.name} 바구니에서 꺼내기`);
  card.innerHTML = `<span aria-hidden="true">${f.emoji}</span><span>${f.name}</span>`;

  // 탭 클릭하여 제거 (접근성). 바구니 클릭(넣기)으로 번지지 않게 막는다
  card.addEventListener('click', (e) => {
    if (state.pendingFoodId) return; // 다른 음식을 넣는 중이면 바구니 클릭으로 처리
    e.stopPropagation();
    card.remove();
    renderPalette();
    showToast(`${josa(f.name, '을', '를')} 꺼냈어요.`);
  });

  basketEl.appendChild(card);
  renderPalette();
  showToast(`${josa(f.name, '을', '를')} ${basketEl.getAttribute('aria-label') || '바구니'}에 넣었어요.`);
  // 키보드 사용자: 아직 남은 음식이 있으면 팔레트의 다음 음식으로 초점
  const nextItem = document.querySelector('#paletteGrid .palette-item:not(.placed)');
  if (nextItem && document.activeElement && document.activeElement.closest && document.activeElement.closest('.classify-basket')) nextItem.focus({ preventScroll: true });
}

/* ══════════════════════════════════════
   피드백 및 결과 검증
   ══════════════════════════════════════ */
/* 문구는 앱이 직접 쓴 고정 문구만(html). 표시·aria-live는 SimKit.feedback */
function showFeedback(text, type = 'ok') { fb.show(type, text); }
function hideFeedback() { fb.hide(); }

function verifyCurrentMission() {
  const m = MISSIONS[state.missionIdx];
  if (state.mode === 1) {
    // 자유 빌더 모드에서의 자전거 주행 평가(상태 줄과 같은 assessPlate 기준)
    const a = assessPlate(getPlateCounts());
    const names = gs => gs.map(g => GROUP_LABELS[g]).join(', ');

    const no = SimKit.icon('circle-x') + ' ';
    if (a.run === 'stop') {
      showFeedback(no + '앞바퀴가 비어 자전거가 움직일 수 없어요! 물을 접시에 꼭 한 잔 담아 보세요.', 'no');
    } else if (a.run === 'wobble') {
      showFeedback(`${no}아직 비어 있는 바퀴 영역이 있어요. <strong>${names(a.missing)}</strong>에 해당하는 음식을 접시에 더 담아 골고루 균형을 맞춰 보세요.`, 'no');
    } else if (a.run === 'heavy') {
      showFeedback(SimKit.icon('package') + ` 유지·당류는 요리할 때 조금만 써야 해요. ${OIL_LIMIT}개보다 많이 담으면 자전거 짐칸이 무거워져요. 몇 개 빼 볼까요?`, 'no');
    } else if (a.run === 'run') {
      showFeedback(`${SimKit.icon('bike')} 자전거가 달려요! <strong>${josa(names(a.short), '을', '를')}</strong> 하나씩 더 담으면 뒷바퀴가 꽉 차서 쌩쌩 달려요.`, 'ok');
    } else {
      showFeedback(SimKit.icon('party-popper') + ' 완벽해요! 여러 식품군이 골고루 조화를 이루고 물까지 마셔서 자전거가 쌩쌩 달리고 있어요!', 'ok');
    }
  } else if (state.mode === 2) {
    // 도전 미션 검증. 미션 4는 결론을 고른 뒤 두 자전거를 달려 확인한다(예측→확인)
    if (m.id === 'm4') startRace();
    const isOk = m.verify();
    if (isOk) {
      // 완료 기록·번호 갱신·저장은 컨트롤러가(onChange). setupMissionUI는 부르지 않음(접시 초기화 방지)
      const next = MISSIONS.findIndex((ms, i) => i !== state.missionIdx && !mc.isDone(i));
      const tail = next === -1 ? ' 미션을 모두 마쳤어요! [결과 보기] 버튼을 눌러 보세요.' : ` [다음 미션] 버튼을 눌러 ${next + 1}번 미션에 도전해 보세요.`;
      mc.complete({ message: SimKit.icon('party-popper') + ' 미션 성공! 식단을 멋지게 완성했어요.' + tail });
      nextMissionIdx = next;
      $('#btnNextMission').style.display = next === -1 ? 'none' : '';
    } else {
      const no = SimKit.icon('circle-x') + ' ';
      if (m.id === 'm1') {
        mc.fail(no + '분류가 맞지 않은 음식이 있거나 5가지를 다 넣지 않았어요. 헷갈리기 쉬운 음식의 특징을 떠올리며 다시 끌어 놓거나 눌러 넣어 보세요.');
      } else if (m.id === 'm2') {
        mc.fail(no + '아직 빈 식품군이 남아 있어요. 고기·생선·달걀·콩류, 채소류, 과일류, 우유·유제품류, 물을 각각 1개 이상 미션 접시에 더 담아 보세요.');
      } else if (m.id === 'm3') {
        mc.fail(no + '6가지 식품군과 물이 모두 1개 이상씩 담겨야 해요. 뒷바퀴에서 비어 있는 자리를 더 채워 보세요.');
      } else if (m.id === 'm4') {
        mc.fail(no + '다시 생각해 봐요. 두 자전거가 달리는 모습과 뒷바퀴의 빈 자리를 비교한 다음 결론을 다시 골라 보세요.');
      }
    }
  }
}

let nextMissionIdx = -1;

function showResultScreen() {
  showScreen('screenResult');
  SimKit.stars.render('#resultStars', SimKit.stars.grade(mc.doneCount(), [1, 2, 4]));
  let summary = `<strong>식품구성자전거 탐험 완료 보고서</strong><br><br>`;
  const done = (id) => state.missionsCompleted[id] ? '완료 ' + SimKit.icon('check') : '아직';
  summary += `① 식품군 바구니 분류: ${done('m1')}<br>`;
  summary += `② 부족한 식단 보완하기: ${done('m2')}<br>`;
  summary += `③ 아침 한 끼 균형 식단: ${done('m3')}<br>`;
  summary += `④ 식단 비교와 평가: ${done('m4')}<br><br>`;
  summary += `어떤 음식도 그 자체로 나쁜 음식은 없어요! 곡류, 고기·생선·달걀·콩류, 채소류, 과일류, 우유·유제품류를 <strong>골고루 알맞은 비율로</strong> 채우고, 물을 충분히 마시면 건강한 자전거가 힘차게 굴러가요!`;

  $('#resultSummary').innerHTML = summary;
}

/* ── 화면 전환 ── */
function showScreen(id) {
  if (id !== 'screenExplore' && mc) mc.stop();
  screens.show(id);
}

/* ══════════════════════════════════════
   초기화 및 이벤트 리스너 바인딩
   ══════════════════════════════════════ */
function init() {
  loadState();
  parseShareLink();

  // 주행 무대: 기본 하나 + 미션 4의 두 자전거(그림 배율은 각 무대가 크기에 맞춰 정함)
  mainRide = createRide($('#mainRide'));
  const onArrive = (k) => () => {
    const other = k === 'A' ? 'B' : 'A';
    if ($('#runStatusBanner').dataset.state !== 'go') setBanner('go', `식단 ${k} 자전거가 먼저 도착했어요!`);
    else setBanner('go', `식단 ${other} 자전거에 이어 식단 ${k} 자전거도 도착했어요.`);
  };
  rideA = createRide($('#rideA'), { tag: '식단 A', finish: FINISH, onFinish: onArrive('A') });
  rideB = createRide($('#rideB'), { tag: '식단 B', finish: FINISH, onFinish: onArrive('B') });

  // 미션 컨트롤러: 번호 버튼(44px)·이동·문구·완료 기록. 성공해도 자동 이동 없음(지금 동작 유지)
  mc = SimKit.missions({
    ids: MISSION_IDS,
    format: 'flags',
    progress: state.missionsCompleted,
    nav: '#missionNav',
    feedback: fb,
    onEnter: (i) => { state.missionIdx = i; setupMissionUI(); },
    onChange: (p) => { state.missionsCompleted = p; saveState(); updateVerifyButtonText(); }
  });

  // 시작 버튼
  $('#btnStart').addEventListener('click', () => {
    showScreen('screenExplore');
    switchMode(1);
    mainRide.fit();
  });

  // 모드 탭 클릭
  modeTabs = SimKit.tabs('.mode-tab', { attr: 'mode', initial: '1', onSelect: (v) => switchMode(v) });

  // 카테고리 필터 탭
  $$('.palette-tab').forEach(tab => {
    tab.setAttribute('aria-pressed', tab.classList.contains('active') ? 'true' : 'false');
    tab.addEventListener('click', () => {
      $$('.palette-tab').forEach(t => { t.classList.remove('active'); t.setAttribute('aria-pressed', 'false'); });
      tab.classList.add('active');
      tab.setAttribute('aria-pressed', 'true');
      state.activeCategory = tab.dataset.cat;
      renderPalette();
    });
  });

  // 정답 및 균형 검사
  $('#btnVerify').addEventListener('click', verifyCurrentMission);

  // 최종 결과 이동
  $('#btnNextScreen').addEventListener('click', showResultScreen);

  // 미션 중에도 언제나 자유 탐험으로(진행 기록 유지)
  $('#btnExitMission').addEventListener('click', () => switchMode(1));
  // 성공 뒤 다음 미션으로(자동 이동 없음은 그대로)
  $('#btnNextMission').addEventListener('click', () => {
    if (nextMissionIdx >= 0) mc.go(nextMissionIdx);
  });

  // 결과 화면 액션
  $('#btnRetry').addEventListener('click', async () => {
    const ok = await VUI.confirm('미션 기록과 식단 접시를 모두 지우고 처음부터 할까요?', { title: L.reset, ok: L.reset, danger: true });
    if (!ok) return;
    mc.reset(); // onChange → missionsCompleted 초기화·저장
    state.missionIdx = 0;
    state.plate = [];
    saveState();
    showScreen('screenExplore');
    switchMode(1);
  });
  $('#btnBackToHub').addEventListener('click', () => {
    showScreen('screenExplore');
    switchMode(1);
  });

  // 셸 공유 버튼 → 내 식단 접시 링크(기기 공유 → 복사/링크 창). 받는 쪽은 parseShareLink
  SimKit.share.bind(() => (state.plate.length ? { v: 1, plate: state.plate } : null), {
    title: '식품구성자전거 — 내가 만든 식단 접시',
    emptyMessage: '접시에 음식을 담은 다음 공유해 보세요.'
  });
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}

})();
</script>



</AppLayout>
