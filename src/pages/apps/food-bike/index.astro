  const fg = 'stroke="var(--fg)" fill="none" stroke-linejoin="round" stroke-linecap="round"';
  let ghosts = '', fills = '', icons = '';
  WHEEL_SECTORS.forEach(({ group: g }) => {
    const [a0, a1] = SECTOR_ANGLES[g];
    const mid = (a0 + a1) / 2 * Math.PI / 180;
    // 목표 모양(점선 윤곽): 비어 있어도 어디를 채울지 보인다
    ghosts += `<path d="${getSectorPath(REAR.x, REAR.y, SECTOR_R, a0, a1)}" fill="${GROUP_COLORS[g]}" fill-opacity="0.14" stroke="${GROUP_COLORS[g]}" stroke-width="1" stroke-dasharray="3 2.5"></path>`;
    fills += `<path class="fb-fill" data-g="${g}" d="M0 0" fill="${GROUP_COLORS[g]}" stroke="#fff" stroke-width="1.5"></path>`;
    icons += `<text class="fb-icon" data-g="${g}" x="${(REAR.x + 37 * Math.cos(mid)).toFixed(1)}" y="${(REAR.y + 37 * Math.sin(mid)).toFixed(1)}">${GROUP_ICONS[g]}</text>`;
