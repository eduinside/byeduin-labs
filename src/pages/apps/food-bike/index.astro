      <path class="fb-crank" d="M0 0" ${fg} stroke-width="4"></path>
      <!-- 라이더(자세는 render()가 매 프레임 계산) -->
      <g class="fb-rider" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path data-part="nearShin" d="M0 0" stroke="${SKIN}" stroke-width="6.5"></path>
