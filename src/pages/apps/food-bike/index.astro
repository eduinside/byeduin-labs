      </g>
      <!-- 프레임 (뒷바퀴 중심 95,145 / BB 165,155 / 시트포스트 145,95 / 헤드튜브 235,75 / 앞바퀴 중심 262,162) -->
      <path d="M 95 145 L 165 155 L 145 95 Z" ${fg} stroke-width="6"></path>
      <path d="M 165 155 L 235 75 L 145 95" ${fg} stroke-width="6"></path>
      <path d="M 235 75 L 262 162" ${fg} stroke-width="6"></path>
      <path d="M 235 75 L 230 50 L 215 50" ${fg} stroke-width="5"></path>
      <path d="M 145 95 L 142 85 M 130 85 L 155 85" ${fg} stroke-width="5"></path>
      <path d="M 95 145 L 78 86 L 128 86 L 144 92" ${fg} stroke-width="4"></path>
      <!-- 뒷바퀴: 식품군 자리는 고정, 바퀴살·타이어 무늬만 돈다 -->
      <g class="fb-rear">
        <circle cx="${REAR.x}" cy="${REAR.y}" r="50" fill="var(--bg-sec)"></circle>
        ${ghosts}${fills}
        <g class="fb-rear-spin" stroke="var(--fg)" stroke-opacity="0.22" stroke-width="1">${rearSpokes}</g>
        ${icons}
        <g class="fb-rear-spin">
          <circle cx="${REAR.x}" cy="${REAR.y}" r="52" fill="none" stroke="var(--fg)" stroke-width="6"></circle>
          <circle cx="${REAR.x}" cy="${REAR.y}" r="52" fill="none" stroke="#fff" stroke-opacity="0.55" stroke-width="2" stroke-dasharray="${treadDash(52, 24)}"></circle>
