  { group: 6, angle: 18 }   // 유지·당류 (5%) -> 18도
];

/* ── 미션 리스트 ── */
const MISSIONS = [
  {
    id: 'm1', title: '식품군 분류하기',
    desc: '헷갈리기 쉬운 음식 5가지를 알맞은 식품군 바구니에 넣어 보세요. 음식 카드를 누른 다음 바구니를 누르거나, 바구니로 끌어 놓아요.<br><strong>(감자, 두부, 토마토, 참기름, 두유)</strong>',
    verify: () => {
      const baskets = $$('.classify-basket');
      let score = 0;
      let totalAssigned = 0;
      baskets.forEach(b => {
        const group = b.dataset.group;
        const items = b.querySelectorAll('.food-card');
        items.forEach(it => {
          totalAssigned++;
          const food = FOOD_BY_ID[it.dataset.id];
          // group 비교
          if (String(food.group) === group) {
            score++;
          }
        });
      });
      return totalAssigned === 5 && score === 5;
    }
  },
  {
    id: 'm2', title: '부족한 식단 보완하기',
    desc: '미션 접시에는 <strong>곡류(식빵)와 유지·당류(버터)</strong>만 있어서 균형이 맞지 않아요. 이 접시에 <strong>고기·생선·달걀·콩류, 채소류, 과일류, 우유·유제품류, 물</strong>을 각각 1개 이상 더해 자전거를 쌩쌩 달리게 만들어 보세요.',
    verify: () => {
      // 버터와 식빵은 기본으로 셋업됨. 
      // 추가해야할 것: 2(고기/콩), 3(채소), 4(과일), 5(유제품), 물
      const counts = getPlateCounts();
      return counts[2] >= 1 && counts[3] >= 1 && counts[4] >= 1 && counts[5] >= 1 && counts['water'] >= 1;
    }
  },
