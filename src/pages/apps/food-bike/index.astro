/* ── 권장 식품군 섭취 1일 비율(뒷바퀴 6분할 각도) ── */
// 한국영양학회 식품구성자전거 뒷바퀴 배분 비중 상수화
const WHEEL_SECTORS = [
  { group: 1, angle: 108 }, // 곡류 (30%) -> 108도
  { group: 2, angle: 72 },  // 고기·생선·달걀·콩류 (20%) -> 72도
