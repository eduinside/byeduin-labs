<!-- ============ 인트로 ============ -->
<div id="screenIntro" class="screen active intro-screen sk-screen">
  <div class="intro-emoji" aria-hidden="true">🚲</div>
  <h1>식품구성자전거</h1>
  <p class="intro-sub">균형 잡힌 식단 만들기 시뮬레이션</p>

  <div class="intro-card">
    <h3>자전거 바퀴를 골고루 채워 출발해요!</h3>
    <p>음식을 접시에 골고루 담아 뒷바퀴의 6개 식품군 비율을 맞춰보세요. 6가지 식품군을 골고루 알맞게 먹고, 앞바퀴인 물을 마셔야 자전거가 쌩쌩 달릴 수 있답니다!</p>
  </div>

  <button type="button" class="sk-btn sk-btn--primary big-btn" id="btnStart"><Icon name="play" />시작하기</button>
</div>

<!-- ============ 메인 탐험 스크린 ============ -->
<div id="screenExplore" class="screen explore-screen">
  <div class="explore-layout">
    <!-- 무대 -->
    <div class="canvas-zone" id="canvasZone">
      <div class="canvas-viewport" id="canvasViewport">
        <div class="canvas-header">
