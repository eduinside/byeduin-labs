  4: 'var(--group-fruit)',
  5: 'var(--group-dairy)',
  6: 'var(--group-oil)'
};

// 6대 식품군 라벨명
const GROUP_LABELS = {
  1: '곡류',
  2: '고기·생선·달걀·콩류',
  3: '채소류',
  4: '과일류',
