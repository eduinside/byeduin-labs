---
import AppLayout from '../../../layouts/AppLayout.astro';
import Icon from '../../../components/Icon.astro';
---
<AppLayout
  title="도서 정보 나눔 — eduin VIVES"
  description="ISBN을 붙여넣으면 도서 정보를 자동으로 조회해 표로 정리합니다. 엑셀로 내려받거나 링크로 공유할 수 있습니다."
  image="https://eduin.info/og-images/book-share.png"
  bodyShell="column"
  bodyWidth="narrow"
>
  <Fragment slot="head">
    <style is:global="">
    *, *::before, *::after { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, 'Pretendard', 'Inter', sans-serif;
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 64px 16px 80px;
    }

    body::before {
      content: '';
      position: fixed; inset: 0;
      background-image:
        linear-gradient(rgba(0,111,238,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,111,238,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none; z-index: 0;
    }

    .page-wrap {
      max-width: 440px;
      width: 100%;
      position: relative;
      z-index: 1;
    }

    /* 표 영역은 별도로 확대 */
    #tableSection {
      margin: 0 auto;
      max-width: 800px;
      width: 100%;
      padding: 0 16px;
    }

    /* ISBN 입력 영역 */
    .section-label {
      display: block;
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--fg-muted);
      letter-spacing: 0.03em;
      margin-bottom: 0.4rem;
    }

    textarea.hero-input {
      resize: vertical;
      min-height: 150px;
      font-size: 0.875rem;
      line-height: 1.7;
      scrollbar-color: var(--border) transparent;
      scrollbar-width: thin;
    }
    textarea.hero-input::-webkit-scrollbar {
      width: 8px;
    }
    textarea.hero-input::-webkit-scrollbar-track {
      background: transparent;
    }
    textarea.hero-input::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 4px;
    }
    textarea.hero-input::-webkit-scrollbar-thumb:hover {
      background: var(--fg-muted);
    }

    /* ISBN → 버튼 사이 화살표 */
    .fetch-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0.4rem 0;
      color: var(--border);
    }
    .fetch-arrow svg {
      opacity: 0.5;
    }

    /* 진행 상태 바 */
    .progress-wrap {
      margin-top: 0.75rem;
      display: none;
    }
    .progress-wrap.visible { display: block; }

    .progress-bar-bg {
      height: 4px;
      background: var(--border);
      border-radius: 99px;
      overflow: hidden;
      margin-bottom: 0.35rem;
    }

    .progress-bar-fill {
      height: 100%;
      background: var(--primary);
      border-radius: 99px;
      transition: width 0.3s ease;
      width: 0%;
    }

    .progress-text {
      font-size: 0.75rem;
      color: var(--fg-muted);
    }

    /* 테이블 */
    .table-wrap {
      overflow: auto;
      margin-top: 1.5rem;
      border-radius: 1rem;
      border: 1px solid var(--border);
      scrollbar-color: var(--border) transparent;
      scrollbar-width: thin;
    }
    .table-wrap::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    .table-wrap::-webkit-scrollbar-track {
      background: transparent;
    }
    .table-wrap::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 4px;
    }
    .table-wrap::-webkit-scrollbar-thumb:hover {
      background: var(--fg-muted);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.875rem;
      min-width: 560px;
    }

    thead th {
      background: var(--card-bg);
      color: var(--fg-muted);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      padding: 0.7rem 1rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }

    tbody tr {
      border-bottom: 1px solid var(--border);
    }
    tbody tr:last-child { border-bottom: none; }

    tbody tr:hover { background: var(--bg-sec); }

    tbody tr.error-row td { color: var(--danger); }

    td {
      padding: 0.7rem 1rem;
      vertical-align: middle;
      color: var(--fg);
    }

    td.num { color: var(--fg-muted); font-size: 0.75rem; width: 36px; text-align: center; }
    td.title { font-weight: 500; }
    td.title .isbn { display: block; margin-top: 2px; font-size: 0.72rem; font-weight: 400; color: var(--fg-muted); font-variant-numeric: tabular-nums; }
    tbody tr.error-row td.title .isbn { color: var(--danger); }
    td.price { white-space: nowrap; }
    td.qty { width: 90px; }
    td.del { width: 52px; text-align: center; }

    .qty-input {
      width: 64px;
      padding: 0.3rem 0.5rem;
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      background: var(--input-bg);
      color: var(--fg);
      font-size: 0.875rem;
      font-family: inherit;
      text-align: center;
    }
    .qty-input:focus { outline: none; border-color: var(--primary); }

    .del-btn {
      background: none;
      border: none;
      color: var(--fg-muted);
      cursor: pointer;
      min-width: 44px;
      min-height: 44px;
      padding: 4px;
      border-radius: 6px;
      line-height: 1;
      font-size: 1rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .del-btn:hover { color: var(--danger); background: rgba(243,18,96,0.07); }

    /* 하단 액션 버튼 */
    .action-row {
      display: flex;
      gap: 0.75rem;
      margin-top: 1.5rem;
      flex-wrap: wrap;
    }

    .action-row .hero-btn,
    .action-row .hero-btn-ghost { flex: 1; min-width: 0; }

    /* 공유 버튼 로딩 상태 */
    .share-btn.loading { opacity: 0.6; pointer-events: none; }

    /* 빈 상태 */
    .empty-state {
      text-align: center;
      padding: 2.5rem 1rem;
      color: var(--fg-muted);
      font-size: 0.875rem;
      line-height: 1.7;
    }

    /* 통계 */
    .stats-row {
      display: flex;
      gap: 1rem;
      margin-top: 0.75rem;
      font-size: 0.78rem;
      color: var(--fg-muted);
      flex-wrap: wrap;
    }

    .stats-row span { white-space: nowrap; }
    .stats-row strong { color: var(--fg); }

    /* API 출처 표기 */
    .api-credit {
      font-size: 0.72rem;
      color: var(--fg-muted);
      opacity: 0.55;
      text-align: right;
      margin-top: 0.5rem;
    }

    .action-row .hero-btn-danger { flex: 0 1 auto; }
    .stats-row .fail-stat, .stats-row .fail-stat strong { color: var(--danger); }
    .gather-hint { margin: 0.5rem 0 0; font-size: 0.8rem; color: var(--fg-muted); line-height: 1.6; }
    .gather-hint a { color: var(--primary); font-weight: 600; }

    @media (pointer: coarse) {
      .qty-input { min-height: 44px; }
    }

    @media (max-width: 540px) {
      .page-wrap { padding-top: 56px; }
      .overlay-btn span { display: none; }
      /* iOS 확대 방지: 입력칸 16px */
      textarea.hero-input, .qty-input { font-size: 16px; }
      #tableSection { padding: 0; }

      /* 휴대폰: 표를 줄마다 카드처럼(수량·삭제가 화면 안에 보이도록) */
      .table-wrap table { min-width: 0; }
      .table-wrap thead { display: none; }
      .table-wrap tbody tr {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto;
        align-items: center;
        column-gap: 0.5rem;
        padding: 0.6rem 0.25rem 0.6rem 0.85rem;
      }
      .table-wrap td { padding: 0; }
      .table-wrap td.num { display: none; }
      .table-wrap td.title { grid-column: 1; grid-row: 1; }
      .table-wrap td.author, .table-wrap td.publisher, .table-wrap td.price { grid-column: 1; font-size: 0.78rem; color: var(--fg-muted); }
      .table-wrap td.author { grid-row: 2; }
      .table-wrap td.publisher { grid-row: 3; }
      .table-wrap td.price { grid-row: 4; }
      .table-wrap td.author:empty, .table-wrap td.publisher:empty { display: none; }
      .table-wrap td.qty { grid-column: 2; grid-row: 1 / span 4; width: auto; }
      .table-wrap td.del { grid-column: 3; grid-row: 1 / span 4; width: auto; }
      .table-wrap .qty-input { width: 56px; }
      tbody tr.error-row td.author, tbody tr.error-row td.publisher, tbody tr.error-row td.price { display: none; }
    }
  </style>
  <script type="application/ld+json" is:inline="">{"@context":"https://schema.org","@type":"WebApplication","name":"도서 정보 나눔","description":"ISBN을 붙여넣으면 도서 정보를 자동으로 조회해 표로 정리합니다. 엑셀로 내려받거나 링크로 공유할 수 있습니다.","url":"https://eduin.info/apps/book-share/","applicationCategory":"EducationApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"KRW"},"isPartOf":{"@type":"WebSite","name":"eduin VIVES","url":"https://eduin.info"}}</script>
  </Fragment>



  <div class="app-actions">
    <a href="./gather.html" class="overlay-btn" title="여러 사람의 공유 링크를 모아 한 표로 합치기" aria-label="링크 모아 수집하기">
      <Icon name="link" />
      <span>수집</span>
    </a>
  </div>

  <div class="page-wrap">

    <!-- 앱 헤더 -->
    <div class="app-header">
      <div class="app-badge">소셜</div>
      <h1 class="app-title">도서 정보 나눔 <span class="app-title-en">Book Share</span></h1>
      <p class="app-desc">ISBN 목록을 붙여넣으면 카카오 책 검색으로 도서 정보를 가져와 표로 정리하고, 엑셀 파일로 내려받거나 링크로 다른 사람에게 쉽게 전달할 수 있습니다. <span style="opacity:0.45;font-size:0.85em">(카카오 책 검색 API)</span></p>
      <p class="gather-hint">여러 사람에게 받은 공유 링크를 한 표로 모으려면 <a href="./gather.html">도서 정보 수집</a>으로 가세요.</p>
    </div>

    <!-- ISBN 입력 -->
    <div style="margin-bottom:1rem">
      <label class="section-label" for="isbnInput">ISBN 목록</label>
      <textarea class="hero-input" id="isbnInput" placeholder="13자리 ISBN을 붙여넣으세요. 줄바꿈·공백·쉼표 모두 OK.

예)
9791173325878
9788936434267"></textarea>
    </div>

    <!-- 조회 버튼 + 진행 상태 -->
    <button class="hero-btn" id="fetchBtn" onclick="startFetch()" style="width:100%">
      <Icon name="plus" /> 목록에 추가
    </button>

    <div class="progress-wrap" id="progressWrap">
      <div class="progress-bar-bg">
        <div class="progress-bar-fill" id="progressFill"></div>
      </div>
      <div class="progress-text" id="progressText" role="status" aria-live="polite"></div>
    </div>

    <!-- 화살표 (조회 후 표시) -->
    <div class="fetch-arrow" id="fetchArrow" style="display:none">
      <Icon name="arrow-down" size={18} />
    </div>

    <div id="emptyState" class="empty-state" style="display:none">
      아직 목록이 비어 있어요.<br>
      책 뒤표지 바코드 아래의 <strong>13자리 ISBN</strong>(978·979로 시작)을 위 칸에 붙여넣고 <strong>목록에 추가</strong>를 눌러 보세요.
    </div>

  </div>

  <!-- 결과 테이블 (page-wrap 밖으로 분리 - 독립적인 폭 설정) -->
  <div id="tableSection" style="display:none">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th class="num">#</th>
            <th>도서명 · ISBN</th>
            <th>저자</th>
            <th>출판사</th>
            <th>정가</th>
            <th>주문수량</th>
            <th aria-label="삭제"></th>
          </tr>
        </thead>
        <tbody id="tableBody"></tbody>
      </table>
    </div>

    <div class="stats-row" id="statsRow"></div>

    <div class="action-row">
      <button type="button" class="hero-btn" id="excelBtn" onclick="exportExcel()">
        <Icon name="download" />
        엑셀 내려받기
      </button>
      <button type="button" class="hero-btn hero-btn-ghost share-btn" id="shareBtn" onclick="shareList()">
        <Icon name="share-2" />
        <span class="btn-label">링크로 공유</span>
      </button>
      <button type="button" class="hero-btn hero-btn-danger" onclick="confirmReset()">
        <Icon name="trash-2" />
        전체 초기화
      </button>
    </div>
  </div>

  <!-- 토스트·공유 창은 공용 VUI (public/common/ui.js) -->
  <!-- SheetJS는 엑셀 내려받기를 누를 때만 불러온다(loadXLSX) -->

  <script is:inline="">
    /* ── 상태 ── */
    let list = [];          // { isbn13, title, author, publisher, priceStandard, qty, error? }
    let fetching = false;

    const LS_ITEMS = 'bookwishlist_items';

    /* ── 공유 데이터 디코딩 ──
       VUI.share.decode: 새 형식(UTF-8 base64url) → 옛 형식 btoa(encodeURIComponent()) → btoa(json).
       표준 base64(+ / =)·%2B 같은 URL 인코딩도 받아 준다(예전 링크 그대로 열림). */
    function decodeShareData(encoded) {
      return VUI.share.decode(encoded, d => Array.isArray(d));
    }

    /* ── 목록 검증: 공유 링크·저장본은 디코드 직후 형식을 맞춘다 ── */
    function toInt(v, min, max, def) {
      if (window.VSafe) return VSafe.int(v, min, max, def);
      const n = Math.trunc(Number(v));
      return isFinite(n) ? Math.min(max, Math.max(min, n)) : def;
    }
    function cleanStr(v, max) {
      return (typeof v === 'string' || typeof v === 'number') ? String(v).slice(0, max) : '';
    }
    function sanitizeBooks(arr, allowError) {
      if (!Array.isArray(arr)) return [];
      return arr.slice(0, 1000).filter(b => b && typeof b === 'object').map(b => {
        const book = {
          isbn13: cleanStr(b.isbn13, 20).replace(/[^0-9Xx]/g, ''),
          title: cleanStr(b.title, 300) || '(제목 없음)',
          author: cleanStr(b.author, 200),
          publisher: cleanStr(b.publisher, 200),
          priceStandard: toInt(b.priceStandard, 0, 10000000, 0),
          qty: toInt(b.qty, 0, 99999, 1),
        };
        if (allowError && b.error) book.error = true;
        return book;
      });
    }

    /* ── 초기화 ── */
    (async function init() {
      // 일반 접근: localStorage 복원
      let saved = [];
      try { saved = sanitizeBooks(JSON.parse(localStorage.getItem(LS_ITEMS) || '[]'), true); } catch { saved = []; }
      list = saved;

      // 공유 링크로 접근한 경우 해시에서 목록 로드 — 내 목록이 있으면 바꾸기 전에 확인
      const hash = location.hash;
      if (hash.startsWith('#share=')) {
        const shared = sanitizeBooks(decodeShareData(hash.slice(7)), false);
        history.replaceState(null, '', location.pathname);
        if (shared.length > 0) {
          let ok = saved.length === 0;
          if (!ok) {
            renderTable(); // 확인 창 뒤에 내 목록이 보이도록
            ok = await VUI.confirm(
              `지금 이 기기에 저장된 내 목록(${saved.length}권)은 지워지고 공유받은 목록(${shared.length}권)으로 바뀌어요.`,
              { title: '공유받은 목록을 열까요?', ok: '공유받은 목록 열기', cancel: '내 목록 유지' });
          }
          if (ok) {
            list = shared;
            saveList();
            renderTable();
            showToast(`공유받은 목록 ${shared.length}권을 불러왔어요.`);
            return;
          }
          renderTable();
          showToast('내 목록을 그대로 두었어요.');
          return;
        }
        showToast('공유 링크를 읽을 수 없어요. 링크가 잘리지 않았는지 확인해 주세요.', 'error');
      }
      renderTable();
    })();

    /* ── ISBN 파싱 ──
       줄바꿈·공백·쉼표·세미콜론으로 나누고 하이픈 등 숫자 아닌 글자는 지운다.
       숫자가 들어 있지만 13자리가 아닌 토막(ISBN-10, 잘린 번호)은 invalid로 세어 알린다. */
    function parseISBNs(text) {
      const all = [];
      let invalid = 0;
      text.split(/[\s,;]+/).forEach(tok => {
        const digits = tok.replace(/\D/g, '');
        if (!digits) return;            // 숫자 없는 낱말(예: "예)")은 무시
        if (digits.length === 13) all.push(digits);
        else invalid++;
      });
      return { isbns: [...new Set(all)], invalid };
    }

    /* ── ISBN 조회 (서버 함수 경유 — 키는 서버 env, 배포본에서도 동작) ──
       429는 카카오 책 검색 호출량 제한에 의한 일시 차단. 이 경우 blocked 표시를 달아
       호출부가 남은 조회를 멈출 수 있게 한다(차단 중 계속 두드리면 해제가 늦어짐). */
    async function lookupISBN(isbn) {
      let data;
      try {
        data = await VUI.apiFetch('/api/book-lookup?isbn=' + encodeURIComponent(isbn));
      } catch (e) {
        // 표의 '(오류)' 칸에 들어가므로 짧게: 연결 문제는 '연결 실패', 그 밖에는 서버 문구
        const conn = ['network', 'offline', 'timeout'].includes(e.code);
        const err = new Error(conn ? '연결 실패' : (e.serverMessage || e.message || '도서를 찾을 수 없습니다'));
        err.blocked = e.status === 429 || !!(e.data && e.data.blocked);
        throw err;
      }
      if (data && data.item) return data.item;
      const err = new Error((data && data.error) || '도서를 찾을 수 없습니다');
      err.blocked = !!(data && data.blocked);
      throw err;
    }

    /* ── 전체 조회 ── */
    async function startFetch() {
      if (fetching) return;

      const text = document.getElementById('isbnInput').value;
      const { isbns, invalid } = parseISBNs(text);
      const invalidMsg = invalid ? `13자리가 아닌 번호 ${invalid}건 건너뜀` : '';

      if (isbns.length === 0) {
        showToast(invalid
          ? `13자리 ISBN이 없어요(${invalidMsg}). ISBN-10은 978·979로 시작하는 13자리 번호로 넣어 주세요.`
          : '13자리 ISBN을 붙여넣어 주세요.', 'error');
        return;
      }

      // 중복 제거 (이미 목록에 있는 ISBN). 조회 실패 행은 빼고 센다 — 같은 ISBN을 다시 넣으면 재조회
      const existing = new Set(list.filter(b => !b.error).map(b => b.isbn13));
      const toFetch = isbns.filter(isbn => !existing.has(isbn));
      const skipped = isbns.length - toFetch.length;

      if (toFetch.length === 0) {
        showToast(`${skipped}건 모두 이미 목록에 있어요.` + (invalidMsg ? ` · ${invalidMsg}` : ''));
        return;
      }

      fetching = true;
      document.getElementById('fetchBtn').disabled = true;
      const pw = document.getElementById('progressWrap');
      pw.classList.add('visible');
      setProgress(0, toFetch.length);

      let added = 0, errors = 0, remaining = 0;

      // 같은 ISBN의 조회 실패 행이 있으면 그 자리를 새 결과로 바꾼다(재시도)
      const putRow = (isbn, row) => {
        const at = list.findIndex(b => b.error && b.isbn13 === isbn);
        if (at >= 0) list[at] = row; else list.push(row);
      };

      for (let i = 0; i < toFetch.length; i++) {
        setProgress(i + 1, toFetch.length);
        try {
          const book = await lookupISBN(toFetch[i]);
          putRow(toFetch[i], {
            isbn13: book.isbn13 || toFetch[i],
            title: book.title || '(제목 없음)',
            author: book.author || '',
            publisher: book.publisher || '',
            priceStandard: book.priceStandard || 0,
            qty: 1,
          });
          added++;
        } catch (e) {
          // 조회가 일시 차단되면 남은 ISBN은 시도하지 않고 중단. 빈 오류 행으로 목록을
          // 오염시키지 않고, 몇 건이 남았는지만 알린다.
          if (e && e.blocked) {
            remaining = toFetch.length - i;
            renderTable();
            saveList();
            break;
          }
          putRow(toFetch[i], {
            isbn13: toFetch[i],
            title: '(' + ((e && e.message) || e) + ')',
            publisher: '-', priceStandard: 0, qty: 0, error: true,
          });
          errors++;
        }
        renderTable();
        saveList();
        if (i < toFetch.length - 1) {
          await sleep(300);
        }
      }

      fetching = false;
      document.getElementById('fetchBtn').disabled = false;
      pw.classList.remove('visible');

      if (remaining) {
        showToast(`도서 조회가 잠시 제한되었어요. 10분 뒤 남은 ${remaining}건을 다시 시도해 주세요.`
          + (invalidMsg ? ` · ${invalidMsg}` : ''), 'error');
        return;
      }

      const parts = [`${added}권 추가`];
      if (skipped) parts.push(`이미 있는 책 ${skipped}건 제외`);
      if (invalidMsg) parts.push(invalidMsg);
      if (errors) parts.push(`조회 실패 ${errors}건(표의 빨간 줄)`);
      // 실패가 섞이면 성공색을 쓰지 않는다. 하나도 넣지 못했으면 오류색
      showToast(parts.join(' · '), (errors || invalid) && !added ? 'error' : undefined);
    }

    /* ── 진행 상태 ── */
    function setProgress(cur, total) {
      document.getElementById('progressFill').style.width = (cur / total * 100) + '%';
      document.getElementById('progressText').textContent = `조회 중… ${cur} / ${total}`;
    }

    /* ── 테이블 렌더 ── */
    function renderTable() {
      const tbody = document.getElementById('tableBody');
      const section = document.getElementById('tableSection');
      const empty = document.getElementById('emptyState');

      const validList = list.filter(b => !b.error);
      const errorList = list.filter(b => b.error);

      const arrow = document.getElementById('fetchArrow');

      if (list.length === 0) {
        section.style.display = 'none';
        empty.style.display = '';
        arrow.style.display = 'none';
        return;
      }

      section.style.display = '';
      empty.style.display = 'none';
      arrow.style.display = '';

      // 행 렌더링
      let num = 0;
      tbody.innerHTML = list.map((b, idx) => {
        if (!b.error) num++;
        return `<tr class="${b.error ? 'error-row' : ''}">
          <td class="num">${b.error ? '–' : num}</td>
          <td class="title">${escHtml(b.title)}${b.isbn13 ? `<span class="isbn">ISBN ${escHtml(b.isbn13)}</span>` : ''}</td>
          <td class="author">${escHtml(b.author || '')}</td>
          <td class="publisher">${escHtml(b.publisher)}</td>
          <td class="price">${b.priceStandard ? b.priceStandard.toLocaleString() + '원' : '–'}</td>
          <td class="qty">${b.error ? '' : `<input class="qty-input" type="number" min="0" max="999" value="${b.qty}" data-idx="${idx}" aria-label="${escHtml(b.title)} 주문수량" onchange="updateQty(this)">`}</td>
          <td class="del"><button type="button" class="del-btn" title="삭제" aria-label="${escHtml(b.title)} 삭제" onclick="deleteRow(${idx})">${VUI.icon('x')}</button></td>
        </tr>`;
      }).join('');

      // 통계 (표 아래)
      const totalQty = validList.reduce((s, b) => s + (b.qty || 0), 0);
      const totalPrice = validList.reduce((s, b) => s + (b.priceStandard || 0) * (b.qty || 0), 0);
      document.getElementById('statsRow').innerHTML =
        `<span>총 <strong>${validList.length}종</strong></span>` +
        `<span>주문수량 <strong>${totalQty}권</strong></span>` +
        `<span>합계 <strong>${totalPrice.toLocaleString()}원</strong></span>` +
        (errorList.length ? `<span class="fail-stat">조회 실패 <strong>${errorList.length}건</strong> — 같은 ISBN을 다시 추가하면 재조회</span>` : '');
    }

    /* ── 수량 업데이트 ── */
    function updateQty(input) {
      const idx = parseInt(input.dataset.idx, 10);
      const val = Math.max(0, parseInt(input.value, 10) || 0);
      input.value = val;
      list[idx].qty = val;
      saveList();
      renderTable(); // 통계 갱신
    }

    /* ── 행 삭제 ── */
    function deleteRow(idx) {
      list.splice(idx, 1);
      saveList();
      renderTable();
      // 누른 버튼이 사라졌으니 같은 자리(없으면 위)의 삭제 버튼으로 포커스
      const btns = document.querySelectorAll('#tableBody .del-btn');
      const next = btns[Math.min(idx, btns.length - 1)] || document.getElementById('isbnInput');
      if (next) next.focus();
    }

    /* ── 전체 초기화 ── */
    async function confirmReset() {
      const ok = await VUI.confirm(
        `목록의 ${list.length}줄을 모두 지울까요? 되돌릴 수 없어요.\n도서 정보 수집 화면도 같은 목록을 쓰므로 함께 비워져요.`,
        { title: '전체 초기화', ok: '모두 지우기', danger: true });
      if (!ok) return;
      list = [];
      saveList();
      renderTable();
      showToast('목록을 모두 지웠어요.');
    }

    /* ── localStorage 저장 ── */
    function saveList() {
      try {
        localStorage.setItem(LS_ITEMS, JSON.stringify(list));
      } catch {
        showToast('브라우저 저장 공간이 부족해 목록을 저장하지 못했어요.', 'error');
      }
    }

    /* ── SheetJS: 엑셀 내려받기를 누를 때만 불러온다(첫 화면을 막지 않게) ── */
    const XLSX_SRC = 'https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js';
    let xlsxLoading = null;
    function loadXLSX() {
      if (window.XLSX) return Promise.resolve(window.XLSX);
      if (!xlsxLoading) {
        xlsxLoading = new Promise((resolve, reject) => {
          const s = document.createElement('script');
          s.src = XLSX_SRC;
          s.async = true;
          s.onload = () => window.XLSX ? resolve(window.XLSX) : reject(new Error('XLSX 없음'));
          s.onerror = () => { s.remove(); reject(new Error('불러오기 실패')); };
          document.head.appendChild(s);
        }).catch(e => { xlsxLoading = null; throw e; }); // 실패하면 다음 클릭 때 다시 시도
      }
      return xlsxLoading;
    }

    /* ── 엑셀 내보내기 ── */
    async function exportExcel() {
      const valid = list.filter(b => !b.error);
      if (valid.length === 0) { showToast('내려받을 책이 없어요.'); return; }

      const btn = document.getElementById('excelBtn');
      if (btn) btn.disabled = true;
      try {
        await loadXLSX();
      } catch {
        showToast('엑셀 도구를 불러오지 못했어요. 인터넷 연결을 확인하고 다시 눌러 주세요.', 'error');
        return;
      } finally {
        if (btn) btn.disabled = false;
      }

      const rows = valid.map((b, i) => ({
        '순번': i + 1,
        '도서명': b.title,
        '저자': b.author || '',
        '출판사': b.publisher,
        '정가': b.priceStandard,
        '주문수량': b.qty,
        'ISBN': b.isbn13,
      }));

      const ws = XLSX.utils.json_to_sheet(rows);

      // 열 너비 설정
      ws['!cols'] = [
        { wch: 5 },   // 순번
        { wch: 40 },  // 도서명
        { wch: 20 },  // 저자
        { wch: 16 },  // 출판사
        { wch: 10 },  // 정가
        { wch: 10 },  // 주문수량
        { wch: 16 },  // ISBN
      ];

      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, ws, '도서 정보');
      const today = new Date().toISOString().slice(0, 10);
      XLSX.writeFile(wb, `도서 정보_${today}.xlsx`);
      showToast('엑셀 파일을 내려받았어요.');
    }

    /* ── 유틸 ── */
    function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

    function escHtml(str) {
      if (window.VSafe) return VSafe.esc(str);
      return String(str == null ? '' : str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // 함수 선언이라 init()이 이 줄보다 먼저 불러도 된다
    function showToast(msg, type) { VUI.toast(msg, type); }

    /* ── 목록 공유 ── */
    function buildShareURL() {
      const valid = list.filter(b => !b.error);
      // UTF-8 base64url(한글 제목이 옛 btoa(encodeURIComponent()) 방식보다 약 3배 짧음)
      return `${location.origin}/apps/book-share/#share=${VUI.share.encode(valid)}`;
    }

    async function shareList() {
      const valid = list.filter(b => !b.error);
      if (valid.length === 0) { showToast('공유할 책이 없어요.'); return; }

      const btn = document.getElementById('shareBtn');
      const label = btn.querySelector('.btn-label');
      btn.classList.add('loading');
      btn.querySelector('svg').style.display = 'none';
      const origText = label.textContent;
      label.textContent = '링크 만드는 중…';

      const longURL = buildShareURL();

      try {
        // 단축(실패하면 원래 링크) → 복사. 복사가 안 되면 링크 창(입력칸 + 복사 버튼)
        await VUI.share.link(longURL, {
          title: '도서 목록 공유',
          desc: `링크를 연 사람은 이 목록(${valid.length}권)을 그대로 볼 수 있어요.`,
        });
      } finally {
        btn.classList.remove('loading');
        btn.querySelector('svg').style.display = '';
        label.textContent = origText;
      }
    }

    /* ── 페이지 공유 ── */
    function shareCurrentPage() {
      const url = location.href;
      const copy = () => VUI.share.copyOrShow(url, { title: '페이지 공유' });
      if (navigator.share) {
        navigator.share({ title: '도서 정보 나눔', url }).catch(copy);
      } else {
        copy();
      }
    }
  </script>



</AppLayout>
