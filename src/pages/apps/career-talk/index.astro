---
import AppLayout from '../../../layouts/AppLayout.astro';
---
<AppLayout
  theme="light"
  toast="top"
  title="진로 탐험대 - eduin VIVES"
  description="소방관·요리사·게임 기획자 등 104개 직업의 가상 직업인을 골라 선택지로 인터뷰하고, 대화를 돌아보며 더 알아볼 직업 추천과 10년 뒤 나의 하루 글·그림을 받는 초등 진로 교육 앱."
  image="https://eduin.info/og-images/career-talk.png"
  bodyShell="immersive"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/common/sim-kit.css">
    <script is:inline src="/common/sim-kit.js"></script>
    <style is:global>
/* ══════════════════════════════════════════════
   career-talk - 진로 탐험대 (docs/career-talk-plan.md)
   immersive 셸: 화면 하나씩(.screen) 전환. 인터뷰 화면은 위 막대 + 말풍선(스크롤) + 아래 조작판 고정.
   ══════════════════════════════════════════════ */
:root {
  --ct-accent: #7c3aed;
  --ct-accent-deep: #6d28d9;
  --ct-accent-soft: #f3e8ff;
  --ct-guide: #0f766e;           /* 돌아보기(길잡이) 색 */
  --ct-guide-soft: #ccfbf1;
  --ct-bg: #faf7ff;
  --ct-safe-bg: #fef9c3;         /* 안내 카드 연노랑 */
  --ct-safe-border: #eab308;
  --ct-vh: 100dvh;               /* 화면 키보드가 뜨면 app.js가 visualViewport 높이로 바꾼다 */
  --ct-fs: 18px;                 /* 눈높이별 말풍선 글자 */
  --sk-accent: var(--ct-accent);
  --sk-ring: rgba(124, 58, 237, 0.3);
}
body.lv-easy { --ct-fs: 20px; }
body.lv-high { --ct-fs: 16px; }
body.ct-reflect { --sk-accent: var(--ct-guide); --sk-ring: rgba(15, 118, 110, 0.3); }

* { box-sizing: border-box; }
[hidden] { display: none !important; }
body { margin: 0; background: var(--ct-bg); color: var(--fg, #11181c); -webkit-tap-highlight-color: transparent; }
body.ct-locked { overflow: hidden; }

.screen { display: none; }
.screen.active { display: flex; }
.sk-screen { width: 100%; }

.ct-wrap { width: 100%; max-width: 980px; margin: 0 auto; }
.ct-narrow { width: 100%; max-width: 560px; }
.ct-h1 { font-size: 30px; font-weight: 800; margin: 6px 0 4px; text-align: center; }
.ct-h2 { font-size: 22px; font-weight: 800; margin: 0 0 6px; }
.ct-sub { color: var(--fg-muted); font-size: 16px; line-height: 1.6; text-align: center; margin: 0 0 18px; word-break: keep-all; }
.ct-muted { color: var(--fg-muted); font-size: 14px; line-height: 1.6; word-break: keep-all; }
.ct-tag { display: inline-block; background: var(--ct-accent); color: #fff; font-size: 13px; font-weight: 800; padding: 4px 12px; border-radius: 99px; }

/* ── 인트로 ── */
.ct-intro-emoji { font-size: 84px; line-height: 1; text-align: center; margin-top: 10px; }
@keyframes ctFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
.ct-intro-emoji { animation: ctFloat 2.6s ease-in-out infinite; }
.ct-intro-actions { display: grid; gap: 10px; margin: 6px 0 16px; }
.ct-big { min-height: 56px; font-size: 18px; border-radius: 14px; }
.ct-guide-box { border: 1px solid var(--border); background: var(--card-bg); border-radius: 14px; margin-top: 10px; }
.ct-guide-box summary { cursor: pointer; padding: 14px 16px; font-weight: 800; min-height: 48px; display: flex; align-items: center; gap: 8px; list-style: none; }
.ct-guide-box summary::-webkit-details-marker { display: none; }
.ct-guide-box summary::after { content: '+'; margin-left: auto; font-size: 20px; color: var(--fg-muted); }
.ct-guide-box[open] summary::after { content: '-'; }
.ct-guide-box ul { margin: 0; padding: 0 18px 14px 34px; line-height: 1.7; font-size: 15px; word-break: keep-all; }

/* ── 눈높이 ── */
.ct-levels { display: grid; gap: 12px; width: 100%; }
.ct-level-btn { min-height: 76px; flex-direction: column; gap: 2px; font-size: 20px; }
.ct-level-btn small { font-size: 14px; font-weight: 600; color: var(--fg-muted); }

/* ── 직업 고르기 ── */
#scPick { flex-direction: column; min-height: 100dvh; padding: 64px 16px 40px; }
.ct-pick-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-bottom: 14px; }
.ct-pick-head .ct-h2 { margin: 0; flex: 1 1 260px; }
.ct-pick-tools { display: flex; gap: 8px; flex-wrap: wrap; }
.ct-search { display: flex; align-items: center; gap: 8px; background: var(--card-bg); border: 2px solid var(--border); border-radius: 14px; padding: 0 12px; margin-bottom: 14px; }
.ct-search:focus-within { border-color: var(--ct-accent); }
.ct-search input { flex: 1; min-height: 48px; border: 0; background: transparent; font: inherit; font-size: 17px; color: var(--fg); outline: none; min-width: 0; }
.ct-search .ic { width: 20px; height: 20px; color: var(--fg-muted); }
.ct-resume { display: flex; align-items: center; gap: 12px; background: var(--ct-accent-soft); border-radius: 14px; padding: 10px 14px; margin-bottom: 16px; }
.ct-resume span { flex: 1; font-weight: 700; word-break: keep-all; }
.ct-sec-title { font-size: 17px; font-weight: 800; margin: 18px 0 10px; display: flex; align-items: center; gap: 8px; }
.ct-jobs { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 12px; }
.ct-job { background: var(--card-bg); border: 2px solid var(--border); border-radius: 16px; padding: 14px; display: flex; flex-direction: column; gap: 6px; }
.ct-job-top { display: flex; align-items: center; gap: 10px; }
.ct-job-emoji { font-size: 38px; line-height: 1; }
.ct-job-name { font-size: 18px; font-weight: 800; word-break: keep-all; }
.ct-job-line { font-size: 15px; color: var(--fg-muted); line-height: 1.5; flex: 1; word-break: keep-all; margin: 0; }
.ct-job .sk-btn { margin-top: 4px; }
.ct-cnet { font-size: 13px; color: var(--fg-muted); text-decoration: underline; min-height: 32px; display: inline-flex; align-items: center; gap: 4px; align-self: flex-start; }
.ct-cnet .ic { width: 14px; height: 14px; }
.ct-cats { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
.ct-cat { min-height: 64px; justify-content: flex-start; font-size: 16px; }
.ct-cat .e { font-size: 26px; }
.ct-list-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 4px 0 12px; }
.ct-empty { padding: 24px; text-align: center; color: var(--fg-muted); }

/* ── 인터뷰 화면 ── */
#scTalk { flex-direction: column; height: var(--ct-vh); overflow: hidden; }
.ct-top { flex-shrink: 0; padding: 12px 116px 8px 96px; background: rgba(255, 255, 255, 0.92); border-bottom: 1px solid var(--border); }
.ct-top-row { display: flex; align-items: center; gap: 8px; max-width: 900px; margin: 0 auto; }
.ct-who { flex: 1; min-width: 0; display: flex; align-items: center; gap: 8px; font-weight: 800; font-size: 17px; }
.ct-who .e { font-size: 26px; }
.ct-who .n { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ct-ai { display: inline-block; font-size: 11px; font-weight: 800; color: #fff; background: #52525b; border-radius: 6px; padding: 1px 6px; vertical-align: middle; flex-shrink: 0; }
.ct-steps { display: flex; align-items: center; gap: 10px; max-width: 900px; margin: 6px auto 0; font-size: 13px; color: var(--fg-muted); }
.ct-dots { display: flex; gap: 6px; }
.ct-dot { width: 10px; height: 10px; border-radius: 99px; background: #d4d4d8; }
.ct-dot.done { background: var(--sk-accent); }
.ct-dot.now { background: var(--sk-accent); box-shadow: 0 0 0 3px var(--sk-ring); }
.ct-steps .lbl { font-weight: 700; color: var(--fg); }
.ct-steps .cnt { margin-left: auto; }

.ct-log { flex: 1; min-height: 0; overflow-y: auto; -webkit-overflow-scrolling: touch; padding: 16px 16px 8px; }
.ct-log-in { max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; gap: 10px; }
.ct-msg { display: flex; gap: 10px; align-items: flex-end; max-width: 92%; }
.ct-msg.me { align-self: flex-end; flex-direction: row-reverse; }
.ct-ava { width: 40px; height: 40px; border-radius: 50%; background: var(--ct-accent-soft); display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0; }
body.ct-reflect .ct-ava { background: var(--ct-guide-soft); }
.ct-bubble { background: #fff; border: 1px solid var(--border); border-radius: 18px 18px 18px 6px; padding: 10px 14px; font-size: calc(var(--ct-fs) - 2px); line-height: 1.6; word-break: keep-all; overflow-wrap: anywhere; }
.ct-msg.me .ct-bubble { background: var(--sk-accent); color: #fff; border-color: transparent; border-radius: 18px 18px 6px 18px; }
.ct-msg.me.redacted .ct-bubble { background: #e4e4e7; color: #52525b; font-style: italic; }
.ct-msg.latest .ct-ava { width: 64px; height: 64px; font-size: 36px; }
.ct-msg.latest .ct-bubble { font-size: var(--ct-fs); padding: 14px 18px; border-width: 2px; border-color: var(--sk-accent); }
.ct-msg.typing .ct-bubble { color: var(--fg-muted); }
@keyframes ctWiggle { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-8deg); } 75% { transform: rotate(8deg); } }
.ct-ava.talking { animation: ctWiggle 0.5s ease-in-out 3; }
.ct-dots3 span { display: inline-block; animation: ctBlink 1.2s infinite; }
.ct-dots3 span:nth-child(2) { animation-delay: .2s; }
.ct-dots3 span:nth-child(3) { animation-delay: .4s; }
@keyframes ctBlink { 0%, 80%, 100% { opacity: .2; } 40% { opacity: 1; } }
.ct-note { align-self: center; font-size: 14px; color: var(--fg-muted); background: #f4f4f5; border-radius: 99px; padding: 6px 14px; text-align: center; word-break: keep-all; display: inline-flex; gap: 6px; align-items: center; }
.ct-note .ic { width: 16px; height: 16px; }
.ct-safe { align-self: stretch; background: var(--ct-safe-bg); border: 2px solid var(--ct-safe-border); border-radius: 16px; padding: 14px 16px; font-size: calc(var(--ct-fs) - 2px); line-height: 1.6; word-break: keep-all; }
.ct-safe strong { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; }
.ct-safe .help { display: block; margin-top: 8px; font-size: 15px; color: #713f12; }
.ct-summary { align-self: stretch; background: #fff; border: 2px solid var(--ct-guide); border-radius: 16px; padding: 14px 16px; }
.ct-summary h3 { margin: 0 0 8px; font-size: 17px; color: var(--ct-guide); display: flex; align-items: center; gap: 6px; }
.ct-summary ol { margin: 0; padding-left: 0; list-style: none; display: grid; gap: 6px; }
.ct-summary li { font-size: calc(var(--ct-fs) - 2px); line-height: 1.5; word-break: keep-all; }
.ct-summary li b { color: var(--ct-guide); margin-right: 6px; }

.ct-panel { flex-shrink: 0; border-top: 2px solid var(--border); background: #fff; padding: 10px 16px max(12px, env(safe-area-inset-bottom, 0px)); max-height: 56%; overflow-y: auto; }
.ct-panel-in { max-width: 820px; margin: 0 auto; display: grid; gap: 8px; }
.ct-choices { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.ct-choices .sk-btn { min-height: 56px; font-size: calc(var(--ct-fs) - 2px); padding: 6px 12px; }
.ct-choices .sk-btn.mine { border-style: dashed; }
.ct-choices .sk-btn.act { background: var(--ct-guide-soft); border-color: var(--ct-guide); color: #134e4a; }
.ct-choices .sk-btn.act.back { background: var(--ct-accent-soft); border-color: var(--ct-accent); color: var(--ct-accent-deep); }
body.lv-easy .ct-choices .sk-btn { min-height: 64px; }
.ct-custom { display: flex; gap: 8px; align-items: stretch; }
.ct-custom input { flex: 1; min-width: 0; min-height: 52px; border: 2px solid var(--border); border-radius: 12px; padding: 0 12px; font: inherit; font-size: 17px; background: #fff; color: var(--fg); }
.ct-custom input:focus { outline: none; border-color: var(--sk-accent); }
.ct-custom-note { font-size: 13px; color: var(--fg-muted); display: flex; justify-content: space-between; gap: 8px; }
.ct-panel-row { display: flex; gap: 8px; flex-wrap: wrap; }
.ct-panel-row .sk-btn { flex: 1 1 200px; min-height: 52px; }
.ct-btns .sk-btn, .ct-intro-actions .sk-btn { min-height: 52px; }

/* ── 추천·스케치·카드·기록 ── */
.ct-page { flex-direction: column; align-items: center; min-height: 100dvh; padding: 64px 16px 40px; }
.ct-notice { background: var(--ct-guide-soft); color: #134e4a; border-radius: 14px; padding: 12px 16px; line-height: 1.6; word-break: keep-all; margin: 0 0 14px; display: flex; gap: 8px; }
.ct-notice .ic { flex-shrink: 0; width: 20px; height: 20px; margin-top: 3px; }
.ct-rec-list { display: grid; gap: 12px; margin-bottom: 16px; }
.ct-rec { display: grid; grid-template-columns: auto 1fr; gap: 4px 14px; align-items: center; background: #fff; border: 2px solid var(--border); border-radius: 16px; padding: 14px; text-align: left; font: inherit; color: inherit; cursor: pointer; min-height: 88px; width: 100%; }
.ct-rec:hover, .ct-rec:focus-visible { border-color: var(--ct-accent); }
.ct-rec:focus-visible { outline: 3px solid var(--ct-accent); outline-offset: 2px; }
.ct-rec .e { font-size: 44px; grid-row: span 2; }
.ct-rec .n { font-size: 19px; font-weight: 800; }
.ct-rec .r { font-size: 15px; color: var(--fg-muted); line-height: 1.5; word-break: keep-all; }
.ct-rec .go { grid-column: 2; font-size: 14px; font-weight: 800; color: var(--ct-accent-deep); display: inline-flex; align-items: center; gap: 4px; }
.ct-btns { display: grid; gap: 10px; width: 100%; }

.ct-story { background: #fff; border: 2px solid var(--ct-accent); border-radius: 18px; padding: 16px 18px; font-size: var(--ct-fs); line-height: 1.8; word-break: keep-all; margin-bottom: 14px; position: relative; }
.ct-story h3 { margin: 0 0 6px; font-size: 16px; color: var(--ct-accent-deep); display: flex; align-items: center; gap: 6px; }
.ct-art { width: min(100%, 360px); aspect-ratio: 1; margin: 0 auto 14px; border-radius: 18px; overflow: hidden; background: #fff; border: 2px solid var(--border); display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 8px; text-align: center; padding: 12px; }
.ct-art img { width: 100%; height: 100%; object-fit: cover; display: block; }
.ct-art.has-img { padding: 0; }
.ct-art .big { font-size: 96px; line-height: 1.1; }
.ct-art .msg { font-size: 15px; color: var(--fg-muted); word-break: keep-all; }
.ct-spin { width: 40px; height: 40px; border-radius: 50%; border: 4px solid var(--ct-accent-soft); border-top-color: var(--ct-accent); animation: ctSpin 1s linear infinite; }
@keyframes ctSpin { to { transform: rotate(360deg); } }

.ct-card { background: #fff; border: 3px solid var(--ct-accent); border-radius: 22px; padding: 20px; width: 100%; margin-bottom: 16px; }
.ct-card-head { display: flex; align-items: center; gap: 14px; border-bottom: 2px dashed var(--ct-accent-soft); padding-bottom: 12px; margin-bottom: 12px; }
.ct-card-head .e { font-size: 56px; line-height: 1; }
.ct-card-head .t { font-size: 13px; color: var(--ct-accent-deep); font-weight: 800; }
.ct-card-head .n { font-size: 24px; font-weight: 800; }
.ct-card-head .d { font-size: 13px; color: var(--fg-muted); }
.ct-card-art { width: 120px; height: 120px; border-radius: 14px; overflow: hidden; margin-left: auto; flex-shrink: 0; background: var(--ct-accent-soft); display: flex; align-items: center; justify-content: center; font-size: 48px; }
.ct-card-art img { width: 100%; height: 100%; object-fit: cover; }
.ct-card h4 { margin: 12px 0 6px; font-size: 15px; color: var(--ct-accent-deep); display: flex; align-items: center; gap: 6px; }
.ct-card ul { margin: 0; padding-left: 20px; line-height: 1.7; font-size: 16px; word-break: keep-all; }
.ct-card p { margin: 0; font-size: 16px; line-height: 1.8; word-break: keep-all; }
.ct-card-recs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.ct-card-recs div { background: var(--ct-accent-soft); border-radius: 12px; padding: 8px; text-align: center; font-size: 14px; word-break: keep-all; }
.ct-card-recs b { display: block; font-size: 28px; }
.ct-card-foot { margin-top: 12px; font-size: 12px; color: var(--fg-muted); text-align: right; }

.ct-records { display: grid; gap: 10px; width: 100%; margin-bottom: 16px; }
.ct-record { display: flex; align-items: center; gap: 12px; background: #fff; border: 2px solid var(--border); border-radius: 14px; padding: 10px 12px; flex-wrap: wrap; }
.ct-record .e { font-size: 34px; }
.ct-record .info { flex: 1 1 160px; min-width: 0; }
.ct-record .n { font-weight: 800; font-size: 17px; }
.ct-record .s { font-size: 13px; color: var(--fg-muted); }
.ct-record .acts { display: flex; gap: 6px; flex-wrap: wrap; }

/* ── 좁은 화면 ── */
@media (max-width: 640px) {
  .ct-top { padding: 58px 12px 8px; }
  .ct-top-row .sk-btn .t { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ct-top-row .sk-btn { min-width: 44px; padding: 0 10px; }
  .ct-choices { grid-template-columns: 1fr; }
  .ct-choices .sk-btn { min-height: 52px; }
  .ct-msg.latest .ct-ava { width: 48px; height: 48px; font-size: 28px; }
  .ct-card-art { width: 84px; height: 84px; }
  .ct-card-recs { grid-template-columns: 1fr; }
  .ct-h1 { font-size: 26px; }
}
/* 낮은 화면(태블릿 가로·폰 가로): 위 막대와 큰 아바타를 줄여 선택지가 잘리지 않게 */
@media (max-height: 560px) {
  .ct-msg.latest .ct-ava { width: 44px; height: 44px; font-size: 26px; }
  .ct-steps { margin-top: 2px; }
  .ct-choices .sk-btn { min-height: 48px; }
  .ct-panel { max-height: 62%; }
}
body.ct-typing .ct-msg:not(.latest):not(.me) { opacity: .6; }

@media (prefers-reduced-motion: reduce) {
  .ct-intro-emoji, .ct-ava.talking, .ct-dots3 span, .ct-spin { animation: none; }
}

/* ── 인쇄: 탐험 카드 한 장(A4) ── */
@media print {
  @page { size: A4; margin: 14mm; }
  body { background: #fff; }
  .top-overlay, .top-overlay-left, .sk-toast, .no-print { display: none !important; }
  .screen:not(#scCard) { display: none !important; }
  #scCard { display: block !important; padding: 0 !important; min-height: 0 !important; height: auto !important; overflow: visible !important; }
  .ct-card { border-width: 2px; break-inside: avoid; box-shadow: none; }
  .ct-card-recs div { background: #f4f4f5; }
}
    </style>
  </Fragment>

  <!-- 인트로 -->
  <section class="screen sk-screen active" id="scIntro" aria-labelledby="introTitle">
    <div class="ct-narrow">
      <div style="text-align:center"><span class="ct-tag">AI 진로 체험</span></div>
      <div class="ct-intro-emoji" aria-hidden="true">🎤</div>
      <h1 class="ct-h1" id="introTitle">진로 탐험대</h1>
      <p class="ct-sub">궁금한 직업인을 만나 이야기 나눠 보세요.<br>이야기를 돌아보며 나와 맞는 일도 찾아봐요.</p>
      <div class="ct-intro-actions">
        <button type="button" class="sk-btn sk-btn--primary ct-big" id="btnStart">탐험 시작하기</button>
        <button type="button" class="sk-btn" id="btnIntroRecords" hidden>내 기록 보기</button>
      </div>
      <details class="ct-guide-box">
        <summary>🧒 학생에게</summary>
        <ul>
          <li>여기서 만나는 직업인은 AI가 연기하는 가상 인물이에요.</li>
          <li>내 이름, 학교, 집, 전화번호는 쓰지 않아요.</li>
          <li>나눈 이야기는 이 기기에 저장돼요. 다른 곳으로 보내 저장하지 않아요.</li>
          <li>버튼에서 하고 싶은 말을 골라 이야기해요.</li>
        </ul>
      </details>
      <details class="ct-guide-box">
        <summary>🧑‍🏫 선생님께</summary>
        <ul>
          <li>AI가 하는 말은 사실과 다를 수 있어요. 교과서와 커리어넷(career.go.kr)을 함께 보며 확인해 주세요.</li>
          <li>마지막의 직업 추천은 대화에서 보인 관심으로 고른 것이고, 적성 검사가 아니에요.</li>
          <li>학생 말은 매번 서버에서 검열하고, 위험한 이야기에는 정해 둔 안내 문구를 보여 줘요.</li>
          <li>사이트 전체에 하루 사용 한도가 있어요. 한도에 닿으면 준비된 질문으로 이어 가요.</li>
          <li>대화 기록은 학생 기기(브라우저)에만 있고, 공유 링크에는 탐험 카드 내용만 들어가요.</li>
        </ul>
      </details>
    </div>
  </section>

  <!-- 눈높이 -->
  <section class="screen sk-screen" id="scLevel" aria-labelledby="levelTitle">
    <div class="ct-narrow">
      <h2 class="ct-h1" id="levelTitle">어떤 말로 이야기할까요?</h2>
      <p class="ct-sub">학년에 맞는 말을 골라요. 나중에 바꿀 수 있어요.</p>
      <div class="ct-levels">
        <button type="button" class="sk-btn ct-level-btn" data-level="easy">쉬운 말<small>1~2학년 · 짧은 말, 선택지 2개</small></button>
        <button type="button" class="sk-btn ct-level-btn" data-level="mid">보통<small>3~4학년</small></button>
        <button type="button" class="sk-btn ct-level-btn" data-level="high">자세히<small>5~6학년 · 진로·적성 낱말도 써요</small></button>
      </div>
    </div>
  </section>

  <!-- 직업 고르기 -->
  <section class="screen" id="scPick" aria-labelledby="pickTitle">
    <div class="ct-wrap">
      <div class="ct-pick-head">
        <h2 class="ct-h2" id="pickTitle">어떤 직업인을 만나 볼까요?</h2>
        <div class="ct-pick-tools">
          <button type="button" class="sk-btn sk-btn--sm" id="btnLevel"></button>
          <button type="button" class="sk-btn sk-btn--sm" id="btnRecords"></button>
        </div>
      </div>
      <label class="ct-search">
        <span id="searchIcon"></span>
        <input type="search" id="jobSearch" placeholder="직업 이름으로 찾기 (예: 요리)" autocomplete="off" aria-label="직업 이름으로 찾기">
      </label>
      <div class="ct-resume" id="resumeBox" hidden>
        <span id="resumeText"></span>
        <button type="button" class="sk-btn sk-btn--sm sk-btn--primary" id="btnResume">이어 하기</button>
      </div>
      <div id="pickHome">
        <h3 class="ct-sec-title">⭐ 이런 직업인을 만날 수 있어요</h3>
        <div class="ct-jobs" id="featuredList"></div>
        <h3 class="ct-sec-title">🗂️ 분류에서 고르기</h3>
        <div class="ct-cats" id="catList"></div>
      </div>
      <div id="pickList" hidden>
        <div class="ct-list-head">
          <button type="button" class="sk-btn sk-btn--sm" id="btnListBack"></button>
          <h3 class="ct-sec-title" id="listTitle" style="margin:0"></h3>
        </div>
        <div class="ct-jobs" id="jobList"></div>
      </div>
    </div>
  </section>

  <!-- 인터뷰·돌아보기 -->
  <section class="screen" id="scTalk" aria-label="직업인과 이야기하기">
    <div class="ct-top">
      <div class="ct-top-row">
        <button type="button" class="sk-btn sk-btn--sm" id="btnTalkBack"></button>
        <h2 class="ct-who" id="talkWho" data-sk-focus tabindex="-1" style="margin:0"></h2>
      </div>
      <div class="ct-steps" id="talkSteps"></div>
    </div>
    <div class="ct-log" id="talkLog" aria-live="polite"><div class="ct-log-in" id="talkLogIn"></div></div>
    <div class="ct-panel" id="talkPanel">
      <div class="ct-panel-in">
        <div class="ct-choices" id="choiceList" role="group" aria-label="고를 말"></div>
        <div id="customBox" hidden>
          <div class="ct-custom">
            <input type="text" id="customInput" maxlength="60" placeholder="궁금한 걸 써 보세요" aria-label="직접 쓰기">
            <button type="button" class="sk-btn sk-btn--primary" id="btnCustomSend">보내기</button>
          </div>
          <div class="ct-custom-note"><span>내 이름, 친구 이름, 학교는 쓰지 않아요.</span><span id="customCount"></span></div>
        </div>
        <div class="ct-panel-row" id="panelExtra"></div>
      </div>
    </div>
  </section>

  <!-- 추천 -->
  <section class="screen ct-page" id="scRec" aria-labelledby="recTitle">
    <div class="ct-narrow">
      <h2 class="ct-h2" id="recTitle">더 알아볼 만한 직업</h2>
      <p class="ct-notice"><span id="recIcon"></span><span>대화에서 보인 관심으로 골랐어요. 검사가 아니에요. 더 알아보고 싶은 직업을 눌러 보세요.</span></p>
      <div class="ct-rec-list" id="recList"></div>
      <div class="ct-btns">
        <button type="button" class="sk-btn sk-btn--primary ct-big" id="btnRecSketch">미래의 내 모습 그려 보기</button>
        <button type="button" class="sk-btn" id="btnRecCard">탐험 카드 완성하기</button>
        <button type="button" class="sk-btn" id="btnRecBack"></button>
      </div>
    </div>
  </section>

  <!-- 스케치 -->
  <section class="screen ct-page" id="scSketch" aria-labelledby="sketchTitle">
    <div class="ct-narrow">
      <h2 class="ct-h2" id="sketchTitle">10년 뒤 나의 하루</h2>
      <div class="ct-story" id="storyBox"></div>
      <div class="ct-art" id="artBox" aria-live="polite"></div>
      <div class="ct-btns">
        <button type="button" class="sk-btn" id="btnRedraw" hidden>그림 한 번 더 그려 보기</button>
        <button type="button" class="sk-btn sk-btn--primary ct-big" id="btnSketchCard">탐험 카드 완성하기</button>
        <button type="button" class="sk-btn" id="btnSketchBack"></button>
      </div>
    </div>
  </section>

  <!-- 탐험 카드 -->
  <section class="screen ct-page" id="scCard" aria-labelledby="cardTitle">
    <div class="ct-narrow">
      <h2 class="ct-h2 no-print" id="cardTitle">나의 탐험 카드</h2>
      <p class="ct-muted no-print" id="cardShared" hidden>친구가 보낸 탐험 카드예요.</p>
      <div class="ct-card" id="cardBox"></div>
      <div class="ct-btns no-print" id="cardBtns"></div>
    </div>
  </section>

  <!-- 내 기록 -->
  <section class="screen ct-page" id="scRecords" aria-labelledby="recordsTitle">
    <div class="ct-narrow">
      <h2 class="ct-h2" id="recordsTitle">내 기록</h2>
      <p class="ct-muted">이 기기에 저장된 탐험이에요(최대 20개). 그림은 저장하지 않아요.</p>
      <div class="ct-records" id="recordList"></div>
      <div class="ct-btns">
        <button type="button" class="sk-btn sk-btn--primary" id="btnRecordsPick">새 직업 고르기</button>
      </div>
    </div>
  </section>

  <script is:inline src="/apps/career-talk/app.js" defer></script>
</AppLayout>
