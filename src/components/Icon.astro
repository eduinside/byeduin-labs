---
/**
 * <Icon name="camera" /> — lucide 아이콘(공용 스프라이트 /common/icons.svg).
 * 이름은 lucide 이름(kebab-case). 빌드 때 scripts/build-icons.mjs가 쓰인 이름만 스프라이트에 모은다.
 * 크기는 글자 크기(1em)를 따른다. size로 px 지정 가능. 장식용이면 그대로, 뜻을 전하면 label을 준다.
 * 런타임(JS 문자열)에서는 같은 마크업을 VUI.icon('camera')로 만든다.
 */
interface Props { name: string; size?: number | string; class?: string; label?: string; }
const { name, size, class: cls, label } = Astro.props;
const style = size ? `width:${size}px;height:${size}px` : undefined;
---
<svg class={cls ? `ic ${cls}` : 'ic'} style={style} aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label} focusable="false"><use href={`/common/icons.svg#${name}`}></use></svg>
