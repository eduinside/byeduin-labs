---
import { matchApp, renderAppHeader, jsonLd, absUrl, SITE_NAME, site } from '../components/app-meta';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyShell?: string;
  bodyWidth?: string;
  bodyPrint?: boolean;
  bodyFocus?: boolean;
  icons?: boolean;
  sync?: boolean;
  /** 화면 모드 고정(시뮬레이션은 'light'). 저장된 선택을 무시하고 화면 모드 버튼을 숨긴다. */
  theme?: 'light' | 'dark';
  /** 공용 토스트를 화면 위쪽에(아래에 고정 조작줄이 있는 앱) */
  toast?: 'top' | 'bottom';
}

const {
  bodyShell = "column",
  bodyWidth,
  bodyPrint,
  bodyFocus,
  icons = false,
  sync = false,
  theme,
  toast
} = Astro.props;

// apps.json에서 현재 앱(/apps/<id>/)을 찾아 SEO 기본값·헤더·JSON-LD를 빌드 때 만든다.
// 페이지가 넘긴 title/description/image가 항상 우선.
const app = matchApp(Astro.url.pathname);
const title = Astro.props.title
  ?? (app?.seo?.title ? `${app.seo.title} | ${SITE_NAME}` : "eduin VIVES — 교육 미니앱 모음");
const description = Astro.props.description
  ?? app?.seo?.description ?? "교육 현장에서 바로 쓸 수 있는 미니 웹 앱 모음.";
const image = Astro.props.image
  ?? absUrl(app?.ogImage || site.ogImage || "/og-default.png");
const canonical = Astro.url.href; // astro.config의 site(https://eduin.info) 기준

const headHtml = Astro.slots.has("head") ? await Astro.slots.render("head") : "";
let bodyHtml = await Astro.slots.render("default");

// 앱 헤더: immersive(캔버스·지도 전용) 셸은 헤더를 그리지 않는다.
if (app && bodyShell !== "immersive") bodyHtml = renderAppHeader(bodyHtml, app);

// 페이지가 자체 JSON-LD를 두지 않았을 때만 기본 JSON-LD를 넣는다.
const hasLd = /type=["']?application\/ld\+json/i.test(headHtml + bodyHtml);
const ld = app && !hasLd ? jsonLd(app, app.seo?.description || description, canonical) : null;
---

<!DOCTYPE html>
<html lang="ko-KR" data-theme-lock={theme} data-theme={theme}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>

  <meta name="description" content={description}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={image}>
  <meta property="og:url" content={canonical}>
  <meta property="og:type" content="website">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={image}>

  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <link rel="stylesheet" href="/common/hero-theme.css">
  <link rel="stylesheet" href="/common/app-shell.css">

  <script is:inline src="/common/safe.js"></script>
  <script is:inline src="/common/ui.js"></script>
  <script is:inline src="/common/theme.js"></script>
  <script is:inline src="/common/init.js"></script>
  <script is:inline src="/common/app-shell.js" defer></script>
  {icons && (
    <Fragment>
      <script is:inline src="/vendor/lucide-1.52.0.min.js"></script>
      <script is:inline>
        // lucide UMD는 <i data-lucide>를 자동 치환하지 않는다. DOM 준비 후 한 번 호출해
        // 정적 아이콘을 렌더한다. 동적 아이콘을 쓰는 앱은 이후 직접 createIcons()를 부른다.
        document.addEventListener('DOMContentLoaded', function () {
          if (window.lucide) window.lucide.createIcons();
        });
      </script>
    </Fragment>
  )}
  {sync && <script is:inline src="/common/sync.js"></script>}
  {ld && <script is:inline type="application/ld+json" set:html={ld}></script>}

  <Fragment set:html={headHtml} />
</head>
<body data-shell={bodyShell} data-width={bodyWidth} data-print={bodyPrint ? "" : undefined} data-focus={bodyFocus ? "" : undefined} data-toast={toast === "top" ? "top" : undefined}>
  <Fragment set:html={bodyHtml} />
</body>
</html>
